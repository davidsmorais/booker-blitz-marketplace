{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidsmorais/booker-blitz-marketplace/raw/main/schema/meta.schema.json",
  "title": "Marketplace resource meta",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "author", "version", "tags", "gameVersion", "license"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 24 }
    },
    "gameVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "license": { "const": "CC-BY-4.0" },
    "imageSetUrl": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "verified": { "type": "boolean" }
  }
}
