{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidsmorais/booker-blitz-marketplace/raw/main/schema/meta.schema.json",
  "title": "Marketplace resource meta",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": { "imageSetUrl": ["imagePackTitle"] },
  "required": ["title", "author", "version", "releaseDate", "updateDate", "official", "legacy", "featured", "tags", "gameVersion", "license"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "releaseDate": { "type": "string", "format": "date" },
    "updateDate": { "type": "string", "format": "date" },
    "official": { "type": "boolean" },
    "legacy": { "type": "boolean" },
    "featured": { "type": "boolean" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 24 }
    },
    "gameVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "license": { "const": "CC-BY-4.0" },
    "downloadUrl": { "type": "string", "pattern": "^https://", "maxLength": 2000 },
    "imageSetUrl": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "imagePackTitle": { "type": "string", "minLength": 1, "maxLength": 120 }
  }
}
