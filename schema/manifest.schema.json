{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidsmorais/booker-blitz-marketplace/raw/main/schema/manifest.schema.json",
  "title": "Marketplace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "themes", "databases", "datastudio"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "themes": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "databases": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "datastudio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "assets"],
      "properties": {
        "version": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "size", "os"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" },
              "sha256": { "type": ["string", "null"] },
              "size": { "type": "integer", "minimum": 0 },
              "os": { "enum": ["windows", "mac", "linux"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "author",
        "slug",
        "version",
        "tags",
        "gameVersion",
        "license",
        "readme",
        "readmeExcerpt",
        "downloadUrl",
        "imageUrl",
        "sha256",
        "size"
      ],
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "slug": { "type": "string" },
        "version": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "gameVersion": { "type": "string" },
        "license": { "type": "string" },
        "readme": { "type": "string" },
        "readmeExcerpt": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sha256": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
