":"lower","masked":false,"retired":false,"dead":false,"story":"Austin Aries is an American wrestler who works in the USA, Canada, Mexico, the British Isles and Japan. He is a 5'9\", 202lb worker who is classed as using a Technician Flyer style. He uses the 450° Splash, the Brainbuster and the Last Chancery as his finishers. He is best known for his work with WWE, CMLL, TNA, NXT, ROH, NWA and MLW. He is currently the MLW National Openweight champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":68,"teams":[1026,1074,1270,2752],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":81,"productFit":100,"riskTaking":21,"matchLayout":82,"psychology":78,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":76,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":82,"brandBuilding":68,"socialMediaSavvy":71,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":73,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-109","wrestlerId":109,"promotionId":68,"startDate":"2025-04-05T00:00:00.000Z","endDate":"2027-04-05T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-04-05T00:00:00.000Z","wage":1000},{"id":110,"name":"Brian Hebner","realName":"Brian Hebner","picture":"Brian Hebner.jpg","ability":7,"currentAbility":0,"potentialAbility":0,"charisma":0,"micSkills":0,"popularity":4,"condition":100,"hardcoreAbility":15,"injuryProne":93,"type":"writer","style":"all rounder","gender":"M","weight":77,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1978-10-09T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Brian Hebner is an American man who tends to stay behind the scenes in the wrestling world.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":45,"technicalCoaching":0,"characterCoaching":35,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":35,"brandBuilding":8,"socialMediaSavvy":33,"ruleKnowledge":80,"positioning":64,"reactionSpeed":45,"consistency":55,"awareness":0,"judgement":0}},{"id":113,"name":"Brother Devon","realName":"Brother Devon","picture":"D-Von Dudley.jpg","ability":79,"currentAbility":87,"potentialAbility":87,"charisma":93,"micSkills":100,"popularity":34,"condition":62,"hardcoreAbility":100,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":122,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1972-08-01T00:00:00.000Z","debut":"1991-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Devon E. Hughes is an American professional wrestler, best known for his appearances with Extreme Championship Wrestling and World Wrestling Entertainment as D-Von Dudley. Hughes was trained by Johnny Rodz and began wrestling in 1992, competing in independent promotions in the Northeast as \"A-Train\". On April 13, 1996, at Massacre on Queens Blvd, Hughes debuted in Extreme Championship Wrestling as D-Von Dudley. His character was based on Jules Winnfield, the Bible-quoting hitman portrayed by Samuel L. Jackson in the 1994 film Pulp Fiction. Dudley feuded with the other members of the Dudley family (his kayfabe half-brothers), claiming that their comedic antics were not the way true Dudleys should act. In mid-1999, Bubba Ray and D-Von left ECW following a pay dispute and debuted in the World Wrestling Federation (WWF) in September.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1355,1418,3124,3125],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":74,"productFit":100,"riskTaking":25,"matchLayout":74,"psychology":73,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":28,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":63,"brandBuilding":54,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":67,"awareness":73,"judgement":84}},{"id":114,"name":"Bully Ray","realName":"Bully Ray","picture":"Bully Ray.jpg","ability":57,"currentAbility":57,"potentialAbility":57,"charisma":68,"micSkills":64,"popularity":36,"condition":53,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":127,"height":187,"base":"USA","birthplace":"United States","dateOfBirth":"1971-07-14T00:00:00.000Z","debut":"1991-01-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Bully Ray is one of the most accomplished professional wrestlers in the history of the sport. Having captured numerous titles in both singles and tag team competition around the globe, Bully made his long-awaited IMPACT return when he shocked the world at Bound For Glory and won the Call Your Shot Gauntlet. While Bully has a reputation of stabbing his allies in the back, he has promised that this time, things will be different. With a title shot of his choosing in his possession, Bully’s odds of yet another title run in IMPACT Wrestling are promising.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1355,1418,3124,3125],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":71,"productFit":100,"riskTaking":28,"matchLayout":72,"psychology":68,"workerManagement":100,"trainingIntensity":54,"technicalCoaching":28,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":82,"brandBuilding":54,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":20,"reactionSpeed":54,"consistency":63,"awareness":68,"judgement":81}},{"id":115,"name":"Chavo Guerrero Jr.","realName":"Chavo Guerrero Jr.","picture":"Chavo Guerrero.jpg","ability":62,"currentAbility":64,"potentialAbility":64,"charisma":56,"micSkills":51,"popularity":30,"condition":65,"hardcoreAbility":81,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":98,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1970-10-20T00:00:00.000Z","debut":"1994-05-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Salvador Guerrero IV also known as Chavo Guerrero and Chavo Guerrero, Jr., is a third generation American professional wrestler and member of the famed Guerrero wrestling family. He is the grandson of Gory Guerrero; the son of Chavo Guerrero, Sr.; the nephew of Eddie Guerrero, Hector Guerrero, Mando Guerrero, and Enrique Llanes; and the cousin of Javier Llanes and Hector Mejia. His grandfather, Gory Guerrero, was one of the most famous wrestlers in Mexican history. His father, Chavo Guerrero, Sr., was also a legendary wrestler in Mexico and worked in WWE as a part-time wrestler and full-time manager. One of his uncles, Eddie Guerrero, was one of WWE's biggest stars. Eddie performed for the SmackDown! brand, as did Chavo Sr. (aka Chavo Classic). Chavo Jr. has two other uncles (Mando and Hector) who have had successful careers in the business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[997,3165],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":75,"productFit":100,"riskTaking":20,"matchLayout":76,"psychology":70,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":64,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":55,"brandBuilding":53,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":66,"awareness":70,"judgement":82}},{"id":116,"name":"Chris Sabin","realName":"Chris Sabin","picture":"Chris Sabin.jpg","ability":71,"currentAbility":69,"potentialAbility":69,"charisma":73,"micSkills":78,"popularity":38,"condition":72,"hardcoreAbility":59,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":93,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1982-02-04T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Whether in singles or tag team competition, Chris Sabin has been dazzling fans and winning championships all over the world for more than 15 years. He and fellow Detroit native Alex Shelley, collectively known as Motor City Machine Guns, have formed one of the top tag teams of the past decade.\r\n \r\nSabin made his ROH debut in 2003 and created an immediate buzz with his flashy in-ring style. He joined forces with Shelley in ROH in 2007. After winning championships in various promotions in the U.S. and Japan, including the prestigious IWGP Junior Heavyweight Tag Team Titles, Motor City Machine Guns finally captured the ROH World Tag Team Titles in 2017, defeating The Young Bucks at Death Before Dishonor XV.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[49,1234,1235,2347,2662,3690,3792,3958,4040,4041],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":81,"productFit":100,"riskTaking":27,"matchLayout":82,"psychology":78,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":69,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":72,"brandBuilding":58,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":77,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-116","wrestlerId":116,"promotionId":76,"startDate":"2026-07-30T00:00:00.000Z","endDate":"2026-08-23T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-08-23T00:00:00.000Z","wage":1000},{"id":118,"name":"Christopher Daniels","realName":"Christopher Daniels","picture":"Christopher Daniels.jpg","ability":58,"currentAbility":63,"potentialAbility":63,"charisma":71,"micSkills":67,"popularity":30,"condition":64,"hardcoreAbility":53,"injuryProne":100,"type":"manager","style":"high flyer","gender":"M","weight":95,"height":177,"base":"USA","birthplace":"United States","dateOfBirth":"1970-03-24T00:00:00.000Z","debut":"1993-04-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"One of the “Founding Fathers” of Ring of Honor, “Almighty” Christopher Daniels has been a major player in ROH since Day One. He wrestled in the main event on the very first ROH show, The Era of Honor Begins, in 2002. A cunning ring general, as well as the self-proclaimed “Smartest Man in the Room,” Daniels reached the pinnacle of the sport when he won the ROH World Championship in 2017 after coming close on numerous occasions over the years.\r\n\r\nDaniels is also a former ROH World Television Champion and has held the ROH World Tag Team Titles with three different partners, including twice as The Addiction with longtime friend Frankie Kazarian. Toward the end of 2017, Daniels and Kazarian recruited Scorpio Sky to form the trouble-making trio SoCal Uncensored.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[941,1015,1339,1371,1446,1490,1573,1898,1899,2702],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":84,"productFit":100,"riskTaking":15,"matchLayout":85,"psychology":80,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":72,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":79,"brandBuilding":52,"socialMediaSavvy":82,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":80,"awareness":80,"judgement":88},"contract":{"id":"tew-contract-118","wrestlerId":118,"promotionId":76,"startDate":"2019-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":120,"name":"Dixie Carter","realName":"Dixie Carter","picture":"Dixie Carter.jpg","ability":0,"currentAbility":0,"potentialAbility":0,"charisma":15,"micSkills":0,"popularity":7,"condition":100,"hardcoreAbility":0,"injuryProne":50,"type":"writer","style":"all rounder","gender":"F","weight":59,"height":162,"base":"USA","birthplace":"United States","dateOfBirth":"1964-10-06T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Dixie Lee Carter-Salinas, is an American businesswoman, currently serving as president of the limited liability company TNA Entertainment. In 2002, the president of Monterey Peninsula Talent (a booking agency) contacted Carter and informed her that Total Nonstop Action Wrestling, a professional wrestling promotion, required a marketing and publicity outlet. Carter began working with TNA, but, two months later, was informed by Jeff Jarrett (a part-owner of TNA) that a key financial backer (HealthSouth Corporation, which was having financial problems due to its being investigated for accounting irregularities) had withdrawn support from TNA, and that the company was in dire straits as a result. Dixie contacted her parents, the owners of Panda Energy International, a Dallas-based energy company. In October 2002, Panda Energy purchased 71% of TNA from the HealthSouth Corporation for $250,000 USD.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":49,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":49,"brandBuilding":35,"socialMediaSavvy":41,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0}},{"id":121,"name":"D'Lo Brown","realName":"D'Lo Brown","picture":"D'Lo Brown.jpg","ability":38,"currentAbility":46,"potentialAbility":46,"charisma":34,"micSkills":56,"popularity":22,"condition":59,"hardcoreAbility":56,"injuryProne":100,"type":"commentator","style":"all rounder","gender":"M","weight":122,"height":187,"base":"USA","birthplace":"United States","dateOfBirth":"1970-10-22T00:00:00.000Z","debut":"1994-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"D'Lo Brown, a 1994 graduate of the The Monster Factory, is a retired American wrestler who works as a colour commentator and a road agent. He is best known for his work with WWE, IMPACT, NOAH, AJPW, ROH and CHIKARA. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1471,3257],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":26,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":50,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":63,"brandBuilding":59,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":56,"awareness":68,"judgement":81}},{"id":122,"name":"Doug Williams","realName":"Doug Williams","picture":"Doug Williams.jpg","ability":86,"currentAbility":89,"potentialAbility":89,"charisma":100,"micSkills":90,"popularity":15,"condition":77,"hardcoreAbility":97,"injuryProne":100,"type":"writer","style":"technical","gender":"M","weight":110,"height":180,"base":"UK","birthplace":"England","dateOfBirth":"1972-09-01T00:00:00.000Z","debut":"1993-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Doug Williams is an English wrestler who works in America, Canada, the British Isles, Japan and Europe. He is a Middleweight who is classed as using a Technician style. He is one half of British Invasion alongside Nick Aldis. He is best known for his work with NOAH, IMPACT, wXw, PWG, ROH, NWA, RevPro, GWF, PROGRESS, OTT, Defiant, ICW and SWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[965,2812,2817,3368,3369],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":81,"productFit":100,"riskTaking":18,"matchLayout":82,"psychology":78,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":75,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":54,"brandBuilding":50,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":74,"awareness":78,"judgement":87}},{"id":123,"name":"Doc Gallows","realName":"Doc Gallows","picture":"DOC.jpg","ability":59,"currentAbility":54,"potentialAbility":54,"charisma":68,"micSkills":67,"popularity":43,"condition":80,"hardcoreAbility":34,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":132,"height":200,"base":"USA","birthplace":"United States","dateOfBirth":"1983-12-22T00:00:00.000Z","debut":"2003-01-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Doc Gallows is an American wrestler who works in the USA, Canada, Japan and India. He is a 6'8\", 290lb worker who is classed as using a Brawler style. He uses the Bicycle Kick and the Inverted Full Nelson Bomb as his finishers. He is best known for his work with WWE, AEW, NJPW, NOAH, TNA, wXw, NWA, The Crash, RevPro, MLW and MLP. He is currently a The Crash Tag Team champion. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":68,"teams":[971,1408,2069,2102,3922,4208,4368],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":64,"productFit":100,"riskTaking":28,"matchLayout":65,"psychology":62,"workerManagement":100,"trainingIntensity":59,"technicalCoaching":31,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":67,"brandBuilding":55,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":59,"consistency":64,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-123","wrestlerId":123,"promotionId":68,"startDate":"2025-11-20T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":124,"name":"Earl Hebner","realName":"Earl Hebner","picture":"Earl Hebner.jpg","ability":88,"currentAbility":82,"potentialAbility":82,"charisma":82,"micSkills":74,"popularity":29,"condition":100,"hardcoreAbility":88,"injuryProne":100,"type":"referee","style":"all rounder","gender":"M","weight":73,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1949-05-17T00:00:00.000Z","debut":"1980-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Earl William Hebner is a professional wrestling referee, and the twin brother of Dave Hebner. He is perhaps the most famous professional wrestling referee today, best known from his time as the senior referee for the World Wrestling Federation/Entertainment and later on in the same role on their Raw brand from 2002-2005. As Senior Referee, Hebner officiated most main events during his time with the company from 1988-2005. He played an extremely prominent role in the inaugural The Main Event card in 1988, in which André the Giant controversially \"defeated\" Hulk Hogan for the WWF Championship, as well as the infamous \"Montreal Screwjob\" during the main event of the 1997 Survivor Series. He also participated in an on-screen angle in mid to late 2000 where he became biased against the McMahon-Helmsley Faction for constantly and deliberately defying his authority as a referee and attacking him.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":15,"storytelling":12,"productFit":0,"riskTaking":93,"matchLayout":11,"psychology":15,"workerManagement":0,"trainingIntensity":4,"technicalCoaching":0,"characterCoaching":20,"diagnosis":50,"rehabilitation":50,"prevention":7,"mediaHandling":20,"brandBuilding":7,"socialMediaSavvy":11,"ruleKnowledge":82,"positioning":66,"reactionSpeed":4,"consistency":2,"awareness":15,"judgement":9}},{"id":125,"name":"Elijah Burke","realName":"Elijah Burke","picture":"D'Angelo Dinero.jpg","ability":50,"currentAbility":57,"potentialAbility":57,"charisma":61,"micSkills":72,"popularity":10,"condition":68,"hardcoreAbility":60,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":100,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1978-04-11T00:00:00.000Z","debut":"2003-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Elijah Burke is an American wrestler who works in America and Canada. He is a Middleweight who is classed as using a Technician Striker style. He is best known for his work with WWE, IMPACT and NWA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":61,"productFit":100,"riskTaking":29,"matchLayout":62,"psychology":56,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":43,"characterCoaching":83,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":83,"brandBuilding":69,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":67,"awareness":56,"judgement":74}},{"id":126,"name":"Eric Bischoff","realName":"Eric Bischoff","picture":"Eric Bischoff.jpg","ability":67,"currentAbility":61,"potentialAbility":61,"charisma":56,"micSkills":51,"popularity":39,"condition":83,"hardcoreAbility":77,"injuryProne":50,"type":"manager","style":"all rounder","gender":"M","weight":88,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1955-05-27T00:00:00.000Z","debut":"1987-01-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Aaron Eric Bischoff is an American entrepreneur and former professional wrestling booker, producer, and on-screen personality, most known for serving as Executive Producer and later President of World Championship Wrestling (WCW) and later, the General Manager of World Wrestling Entertainment's Raw brand. With an amateur background in martial arts, Bischoff was also known to sporadically compete as an in-ring performer, and is a former WCW Hardcore Champion. Bischoff started in wrestling working for the American Wrestling Association under owner Verne Gagne and would eventually become an on-air interviewer and host until the AWA folded in 1991. In 1991, Bischoff joined World Championship Wrestling (WCW) as an announcer, debuting at The Great American Bash. In 1994, Bischoff was promoted from Executive Producer to Executive Vice President, effectively making him the boss of the entire company.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":39,"productFit":0,"riskTaking":97,"matchLayout":34,"psychology":54,"workerManagement":0,"trainingIntensity":14,"technicalCoaching":0,"characterCoaching":80,"diagnosis":50,"rehabilitation":50,"prevention":3,"mediaHandling":80,"brandBuilding":45,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":0,"reactionSpeed":14,"consistency":3,"awareness":54,"judgement":32}},{"id":127,"name":"Eric Young","realName":"Eric Young","picture":"Eric Young.jpg","ability":63,"currentAbility":69,"potentialAbility":69,"charisma":63,"micSkills":58,"popularity":26,"condition":78,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":105,"height":177,"base":"Canada","birthplace":"Canada","dateOfBirth":"1979-12-15T00:00:00.000Z","debut":"1998-10-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Eric Young, who graduated from Can-Am Wrestling School on 01 October 1998, is a Canadian wrestler who works in the USA, Canada and Japan. He is a 5'11\", 232lb worker who is classed as using a Entertainer style. He uses the Spiked Piledriver and the Wheelbarrow Neckbreaker as his finishers. He is best known for his work with WWE, TNA and NXT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1357],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":77,"productFit":100,"riskTaking":18,"matchLayout":78,"psychology":73,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":60,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":77,"brandBuilding":50,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":90,"awareness":73,"judgement":84}},{"id":128,"name":"Frankie Kazarian","realName":"Frankie Kazarian","picture":"Frankie Kazarian.jpg","ability":71,"currentAbility":66,"potentialAbility":66,"charisma":63,"micSkills":67,"popularity":29,"condition":75,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":95,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1977-08-04T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"“The Heavy Metal Rebel” Frankie Kazarian was already an accomplished veteran when he came to Ring of Honor in 2014 to join forces with longtime friend Christopher Daniels as The Addiction. Kazarian and Daniels proved to be master manipulators who sucked in ROH fans and competitors by releasing propaganda under the pseudonym “The Knights of the Rising Dawn.” Using the distraction of KRD, The Addiction captured the ROH World Tag Team Championships from ReDRagon. After losing the titles several months later, The Addiction became two-time champions when they defeated War Machine at War of the Worlds 2016.\r\n\r\nKazarian won the 2017 Honor Rumble by eliminating Jay Lethal, and toward the end of that year he and Daniels recruited Scorpio Sky to form the trouble-making trio SoCal Uncensored. Away from the ring, Kazarian plays bass guitar for the heavy metal band Vex Temper.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":28,"teams":[941,1056,1371,1864,1898,2665,3296],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":75,"productFit":100,"riskTaking":18,"matchLayout":76,"psychology":70,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":67,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":69,"brandBuilding":62,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":86,"awareness":70,"judgement":82},"contract":{"id":"tew-contract-128","wrestlerId":128,"promotionId":28,"startDate":"2023-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":129,"name":"Gail Kim","realName":"Gail Kim","picture":"Gail Kim.jpg","ability":81,"currentAbility":90,"potentialAbility":90,"charisma":93,"micSkills":95,"popularity":26,"condition":80,"hardcoreAbility":100,"injuryProne":100,"type":"writer","style":"technical","gender":"F","weight":54,"height":160,"base":"Canada","birthplace":"Canada","dateOfBirth":"1977-02-20T00:00:00.000Z","debut":"2000-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Gail Kim is a Canadian wrestler who works in America and Canada. She is a Small worker who is classed as using a Regular style. She is best known for her work with IMPACT. She is married to someone outside the wrestling business. She is part of the IMPACT Hall Of Fame.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":81,"productFit":100,"riskTaking":19,"matchLayout":82,"psychology":80,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":65,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":70,"brandBuilding":68,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":89,"awareness":80,"judgement":88}},{"id":131,"name":"Hector Guerrero","realName":"Hector Guerrero","picture":"Hector Guerrero.jpg","ability":31,"currentAbility":32,"potentialAbility":32,"charisma":30,"micSkills":17,"popularity":14,"condition":73,"hardcoreAbility":21,"injuryProne":74,"type":"commentator","style":"high flyer","gender":"M","weight":103,"height":175,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1954-10-01T00:00:00.000Z","debut":"1973-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Hector Manuel Guerrero Lleras is a Mexican-American professional wrestler, better known simply by his paternal name, Hector Guerrero. He is a member of the famous Guerrero family, brother to the late Eddie and uncle to Chavo Jr. In 1990, Guerrero appeared in the World Wrestling Federation at the Survivor Series, performing under the name Gobbledy Gooker and wearing a turkey costume. The Gobbledy Gooker \"hatched\" from an oversized egg, which had been on display at WWF events for months prior to the Survivor Series, and was heavily hyped on television. However, crowd reaction to the gimmick was extremely negative, with fans loudly booing as the costumed Guerrero danced in the ring with announcer \"Mean\" Gene Okerlund. Rated by many as the worst gimmick in wrestling history!","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":89,"storytelling":91,"productFit":100,"riskTaking":20,"matchLayout":92,"psychology":89,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":42,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":65,"brandBuilding":48,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":34,"awareness":89,"judgement":93}},{"id":132,"name":"Hulk Hogan","realName":"Hulk Hogan","picture":"Hulk Hogan.jpg","ability":48,"currentAbility":51,"potentialAbility":51,"charisma":66,"micSkills":50,"popularity":74,"condition":38,"hardcoreAbility":50,"injuryProne":47,"type":"wrestler","style":"powerhouse","gender":"M","weight":137,"height":198,"base":"USA","birthplace":"United States","dateOfBirth":"1953-08-11T00:00:00.000Z","debut":"1977-08-01T00:00:00.000Z","morale":"great","prestige":"high","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":true,"story":"Is there a name more synonymous with sports-entertainment than Hulk Hogan? The key figure in WWE’s rise from regional attraction to worldwide entertainment leader in the 1980s, The Hulkster’s superhuman size and undeniable charisma set the standard for what a Superstar should be. A larger-than-life icon, he packed 93,173 WWE fans into the Pontiac Silverdome, won six WWE Championships, starred in movies, television shows and his own animated series and became an idol to a vast legion of fans he dubbed his Hulkamaniacs.\r\n\r\nClad from head to toe in his trademark yellow and red, “The Real American” first established his unbridled patriotism when he legdropped his way through The Iron Sheik to win the WWE Championship in 1984. He became a household name from there, headlining the inaugural WrestleMania while brushing his 24-inch pythons against celebrities like Cyndi Lauper and Billy Crystal on MTV and “Saturday Night Live.”","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1220],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":92,"storytelling":94,"productFit":100,"riskTaking":56,"matchLayout":95,"psychology":92,"workerManagement":100,"trainingIntensity":21,"technicalCoaching":14,"characterCoaching":88,"diagnosis":50,"rehabilitation":50,"prevention":44,"mediaHandling":88,"brandBuilding":88,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":21,"consistency":30,"awareness":92,"judgement":95}},{"id":133,"name":"James Storm","realName":"James Storm","picture":"James Storm.jpg","ability":58,"currentAbility":68,"potentialAbility":68,"charisma":66,"micSkills":82,"popularity":25,"condition":62,"hardcoreAbility":77,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":104,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1977-06-01T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"James Storm is an American wrestler who works in America, Canada, Mexico, the British Isles, Japan, Europe and Oceania. He is a Middleweight who is classed as using a Brawler style. He is best known for his work with IMPACT and NWA. He is married to someone outside the wrestling business. He was one half of the Tag Team Of The Year in 2005.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":120,"teams":[945,1334,2001,2347],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":76,"storytelling":79,"productFit":100,"riskTaking":26,"matchLayout":80,"psychology":76,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":53,"characterCoaching":75,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":75,"brandBuilding":71,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":81,"awareness":76,"judgement":86},"contract":{"id":"tew-contract-133","wrestlerId":133,"promotionId":120,"startDate":"2024-05-03T00:00:00.000Z","endDate":"2026-05-03T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-05-03T00:00:00.000Z","wage":1000},{"id":134,"name":"Jeff Hardy","realName":"Jeff Hardy","picture":"Jeff Hardy.jpg","ability":66,"currentAbility":61,"potentialAbility":61,"charisma":59,"micSkills":62,"popularity":50,"condition":56,"hardcoreAbility":69,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":102,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1977-08-31T00:00:00.000Z","debut":"1994-05-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jeff Hardy dared the WWE Universe to dream big. Going from a scrawny teenager to one of the most popular WWE Champions in history, The Charismatic Enigma showed that anything was possible when you took a risk. \r\n\r\nWhen The Charismatic Enigma set his sights on the WWE Championship, doubts began to arise. He was unable to wrest the title away from Triple H and Randy Orton, leaving many wondering if he could reach the top of the mountain. He erased any suspicions at Armageddon 2008, when he defeated The Game and Edge in a Triple Threat Match to finally capture sports-entertainment’s richest prize.\r\n\r\nMaking a shocking return to WWE alongside his brother Matt at WrestleMania 33, he captured the Raw Tag Team Championship in a Fatal 4-Way Ladder Match and overcame Jinder Mahal during the 2018 Superstar Shake-up to lay claim to the United States Title and complete his Grand Slam.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":28,"teams":[164,1398,1434,1436,3454,3470],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":68,"productFit":100,"riskTaking":32,"matchLayout":69,"psychology":65,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":49,"characterCoaching":84,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":84,"brandBuilding":80,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":49,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-134","wrestlerId":134,"promotionId":28,"startDate":"2024-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":135,"name":"Jeff Jarrett","realName":"Jeff Jarrett","picture":"Jeff Jarrett.jpg","ability":68,"currentAbility":71,"potentialAbility":71,"charisma":81,"micSkills":74,"popularity":41,"condition":60,"hardcoreAbility":91,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":104,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1967-07-14T00:00:00.000Z","debut":"1986-04-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"“Ain’t I great?” If you think Jeff Jarrett expected to hear anything other than an affirmative every time he fired that question at the WWE Universe, then you didn’t understand the character of the Fargo strutting, Technicolor dreamcoated country crooner from Music City, USA. That grinning arrogance — matched with a predilection for smashing guys over the head with a guitar — made Jarrett a career villain in both WWE and WCW. He was a successful one, too, with four reigns as WCW World Heavyweight Champion and six as WWE Intercontinental Champion with the bulk of his runs coming during a particularly excellent stretch for that title.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1113,3015,3187],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":87,"storytelling":88,"productFit":100,"riskTaking":12,"matchLayout":88,"psychology":87,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":60,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":88,"mediaHandling":76,"brandBuilding":56,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":70,"awareness":87,"judgement":92},"contract":{"id":"tew-contract-135","wrestlerId":135,"promotionId":76,"startDate":"2022-11-02T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":136,"name":"Jeremy Borash","realName":"Jeremy Borash","picture":"Jeremy Borash.jpg","ability":91,"currentAbility":90,"potentialAbility":90,"charisma":100,"micSkills":79,"popularity":9,"condition":100,"hardcoreAbility":72,"injuryProne":95,"type":"writer","style":"all rounder","gender":"M","weight":82,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1977-05-28T00:00:00.000Z","debut":"1999-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jeremy Borash, is a former American professional wrestling play-by-play commentator, announcer, booker, producer and website designer. He was heavily involved in World Championship Wrestling, the now defunct World Wrestling All-Stars promotion, and has been a very influential staff member of Total Nonstop Action Wrestling since its inception in 2002. He is a former member of the TNA creative team and is the former host of TNA Today.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":65,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":59,"productFit":100,"riskTaking":93,"matchLayout":52,"psychology":80,"workerManagement":100,"trainingIntensity":18,"technicalCoaching":0,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":7,"mediaHandling":65,"brandBuilding":24,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":18,"consistency":2,"awareness":80,"judgement":88},"contract":{"id":"tew-contract-136","wrestlerId":136,"promotionId":65,"startDate":"2018-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000,"inDevelopment":true},{"id":138,"name":"Jessie Godderz","realName":"Jessie Godderz","picture":"Jesse Godderz.jpg","ability":54,"currentAbility":52,"potentialAbility":52,"charisma":57,"micSkills":39,"popularity":6,"condition":100,"hardcoreAbility":61,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":100,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1986-04-23T00:00:00.000Z","debut":"2010-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jessie Godderz is an American professional bodybuilder/Wrestler with the World Natural Body Building Federation from Rudd, Iowa and was a HouseGuest on Big Brother 10. In 2011, Godderz signed a contract with professional wrestling promotion Total Nonstop Action Wrestling (TNA) and was sent down to their developmental territory, Ohio Valley Wrestling for further training. On October 14, 2012, at Bound for Glory, Godderz made his TNA debut on the main roster as Tara's \"Hollywood boyfriend\". Godderz, billed simply as \"Jesse\", made his in-ring debut on the November 1 episode of Impact Wrestling, defeating ODB in an intergender match, following interference from Tara. Godderz’s goal is to inspire people who want to lose weight. He wants to be looked up to, as the figure promoting a drug-free, bodybuilding lifestyle. He states this as one of the reasons why he joined Big Brother.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1399],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":52,"productFit":50,"riskTaking":30,"matchLayout":53,"psychology":49,"workerManagement":50,"trainingIntensity":59,"technicalCoaching":38,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":66,"brandBuilding":69,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":10,"reactionSpeed":59,"consistency":68,"awareness":49,"judgement":49}},{"id":140,"name":"Kenny King","realName":"Kenny King","picture":"Kenny King.jpg","ability":67,"currentAbility":64,"potentialAbility":64,"charisma":69,"micSkills":68,"popularity":14,"condition":84,"hardcoreAbility":83,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":104,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1981-07-22T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kenny King has been part of a notable tag team and a faction during his career in Ring of Honor, but he has achieved his greatest success on his own. King, who made his ROH debut in 2007, scored the biggest victory of his career when he defeated New Japan Pro-Wrestling star KUSHIDA for the ROH World Television Title at Death Before Dishonor XV in 2017.\r\n\r\nBefore he began making opponents “bend the knee” in singles competition, King held the ROH World Tag Team Titles with Rhett Titus -- the duo was known as The All Night Express -- in 2012, and in 2016 he formed a faction called The Cabinet (which later became The Rebellion). In addition to his exploits in the ring, King appeared as a cast member on “The Bachelorette” in 2017.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[924],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":65,"productFit":100,"riskTaking":25,"matchLayout":67,"psychology":58,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":62,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":66,"brandBuilding":63,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":69,"awareness":58,"judgement":75}},{"id":141,"name":"Kurt Angle","realName":"Kurt Angle","picture":"Kurt Angle.jpg","ability":85,"currentAbility":92,"potentialAbility":92,"charisma":84,"micSkills":86,"popularity":58,"condition":51,"hardcoreAbility":80,"injuryProne":90,"type":"writer","style":"all rounder","gender":"M","weight":100,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1968-12-09T00:00:00.000Z","debut":"1998-08-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Kurt Angle’s intensity was unmatched, and his technical wrestling skills were unparalleled. Possessing an unprecedented competitive streak that fueled him to become a 1996 Olympic Gold Medalist, Angle dominated the amateur ranks before emerging as one of the most successful WWE Superstars of all time.\r\n\r\nStarting his athletic career as a football and wrestling star in his hometown of Pittsburgh, he soon became one of the top amateur wrestlers in the U.S., winning a pair of NCAA titles at Clarion University. But Angle truly captured national attention in 1996 when he won the 220-pound freestyle wrestling competition at the Olympic Games in Atlanta with a broken neck.\r\n\r\n","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1151],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":84,"storytelling":87,"productFit":100,"riskTaking":24,"matchLayout":88,"psychology":84,"workerManagement":100,"trainingIntensity":59,"technicalCoaching":70,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":82,"brandBuilding":67,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":20,"reactionSpeed":59,"consistency":60,"awareness":84,"judgement":90}},{"id":142,"name":"Victoria","realName":"Victoria","picture":"Tara.jpg","ability":79,"currentAbility":86,"potentialAbility":86,"charisma":82,"micSkills":100,"popularity":21,"condition":69,"hardcoreAbility":77,"injuryProne":96,"type":"writer","style":"technical","gender":"F","weight":70,"height":170,"base":"USA","birthplace":"United States","dateOfBirth":"1971-02-10T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Victoria was not a lady to mess with. A two-time Women’s Champion who stomped icons like Trish Stratus and Lita in brutal Hardcore Matches, the powerful beauty broke ground in the women's division and left a trail of woe behind her.\r\n\r\nVictoria debuted in July 2002 as an eager competitor against reigning Women’s Champion Trish Stratus on Sunday Night Heat, but the loss proved her much more demented. Victoria continued to target Stratus, claiming the champion double-crossed her during their respective fitness model days.\r\n\r\nHer twisted mind games and sneak attacks grew worse into the fall, baiting Stratus into a Women’s Championship Hardcore Match at Survivor Series 2002. The raven-haired Diva brutalized Stratus in Madison Square Garden with chairs and a garbage can before finishing the champ off with a suplex to claim her first Women’s Title.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":71,"storytelling":74,"productFit":100,"riskTaking":15,"matchLayout":75,"psychology":71,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":58,"characterCoaching":74,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":74,"brandBuilding":66,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":65,"awareness":71,"judgement":83}},{"id":143,"name":"Mark Haskins","realName":"Mark Haskins","picture":"Mark Haskins.jpg","ability":59,"currentAbility":65,"potentialAbility":65,"charisma":62,"micSkills":64,"popularity":9,"condition":85,"hardcoreAbility":46,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":84,"height":167,"base":"UK","birthplace":"England","dateOfBirth":"1988-06-25T00:00:00.000Z","debut":"2006-07-22T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Mark Haskins is an English wrestler who works in the British Isles and Europe. He is a 5'7\", 185lb worker who is classed as using a Technician Striker style. He uses the Sharpshooter as his finisher. He is best known for his work with TNA, Dragon Gate, PWG, ROH, wXw, RevPro, PROGRESS, AAW, OTT, FCP, Smash, Defiant, ICW and SWE. He is married to Vicky Haskins.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[27,449,1975,2308],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":69,"productFit":100,"riskTaking":19,"matchLayout":70,"psychology":65,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":68,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":61,"brandBuilding":54,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":70,"awareness":65,"judgement":79}},{"id":144,"name":"Matt Morgan","realName":"Matt Morgan","picture":"Matt Morgan.jpg","ability":71,"currentAbility":62,"potentialAbility":62,"charisma":72,"micSkills":68,"popularity":15,"condition":75,"hardcoreAbility":57,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":136,"height":210,"base":"USA","birthplace":"United States","dateOfBirth":"1976-09-10T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Matt Morgan was an American wrestler who has since left the business. He is best known for his work with WWE, NJPW, AJPW and IMPACT. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1233,3237],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":59,"storytelling":64,"productFit":60,"riskTaking":16,"matchLayout":66,"psychology":59,"workerManagement":60,"trainingIntensity":62,"technicalCoaching":43,"characterCoaching":74,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":74,"brandBuilding":74,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":12,"reactionSpeed":62,"consistency":65,"awareness":59,"judgement":59}},{"id":145,"name":"Mickie James","realName":"Mickie James","picture":"Mickie James.jpg","ability":73,"currentAbility":66,"potentialAbility":66,"charisma":79,"micSkills":66,"popularity":35,"condition":75,"hardcoreAbility":76,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":56,"height":160,"base":"USA","birthplace":"United States","dateOfBirth":"1979-08-31T00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Throughout much of Mickie James’ WWE career, there are some who considered her a peppy, energetic sweetheart. But she’s proven to be as dangerous in the ring as any that came before her.\r\n\r\nA lifelong Virginian, Mickie spent years honing her craft with the goal of becoming one of the greatest female Superstars in history. To this end, the athletic master of a ring-pounding Implant DDT has gone to war with the likes of Trish Stratus, Lita, Maryse, Gail Kim and Alicia Fox. She fought in legendary battles against Beth Phoenix and against simply “flawless” adversaries Team LayCool, Michelle McCool and Layla. And she did it all while amassing WWE gold and all the glory that came with it.\r\n\r\nMickie has captured six Women’s Championships, and at one point, became the second Superstar to hold both the Women’s and the Divas Titles simultaneously. She did this all while establishing herself as one of the alpha females of WWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1546],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":80,"productFit":100,"riskTaking":27,"matchLayout":80,"psychology":80,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":62,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":78,"brandBuilding":75,"socialMediaSavvy":76,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":82,"awareness":80,"judgement":88}},{"id":146,"name":"Mike Knox","realName":"Mike Knox","picture":"Mike Knox.jpg","ability":46,"currentAbility":46,"potentialAbility":46,"charisma":58,"micSkills":52,"popularity":7,"condition":67,"hardcoreAbility":63,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":133,"height":195,"base":"USA","birthplace":"United States","dateOfBirth":"1978-07-17T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Mike Knox is an American wrestler who works in America and Canada. He is a Heavyweight who is classed as using a Powerhouse style. He is best known for his work with WWE, IMPACT and NWA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":79,"teams":[3831],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":47,"storytelling":50,"productFit":100,"riskTaking":29,"matchLayout":51,"psychology":47,"workerManagement":100,"trainingIntensity":53,"technicalCoaching":24,"characterCoaching":50,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":50,"brandBuilding":45,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":53,"consistency":68,"awareness":47,"judgement":68},"contract":{"id":"tew-contract-146","wrestlerId":146,"promotionId":79,"startDate":"2021-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":147,"name":"Mike Tenay","realName":"Mike Tenay","picture":"Mike Tenay.jpg","ability":6,"currentAbility":6,"potentialAbility":6,"charisma":0,"micSkills":20,"popularity":18,"condition":100,"hardcoreAbility":1,"injuryProne":24,"type":"writer","style":"all rounder","gender":"M","weight":82,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1956-02-28T00:00:00.000Z","debut":"1994-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Mike Tenay is a professional wrestling play-by-play announcer. He is best known for his time working with World Championship Wrestling and Total Nonstop Action Wrestling. Mike Tenay made his WCW announcing debut during the WCW-co-promoted AAA When Worlds Collide pay-per-view in November 1994. He is considered one of the foremost wrestling historians which earned him the nickname \"The Professor.\" Current TNA Executive Producer and former WCW president Eric Bischoff has described Tenay as \"a walking encyclopedia of knowledge.\" In early 2002, Tenay was approached by Jeff Jarrett regarding the play-by-play announcer's slot with Total Nonstop Action Wrestling. Tenay became the voice of the upstart company when it launched in June 2002.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":11,"storytelling":8,"productFit":0,"riskTaking":99,"matchLayout":7,"psychology":11,"workerManagement":0,"trainingIntensity":6,"technicalCoaching":0,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":1,"mediaHandling":63,"brandBuilding":27,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":0,"reactionSpeed":6,"consistency":3,"awareness":11,"judgement":7}},{"id":148,"name":"Mr. Anderson","realName":"Mr. Anderson","picture":"Mr Anderson.jpg","ability":54,"currentAbility":59,"potentialAbility":59,"charisma":59,"micSkills":74,"popularity":27,"condition":70,"hardcoreAbility":60,"injuryProne":87,"type":"wrestler","style":"powerhouse","gender":"M","weight":88,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1976-03-06T00:00:00.000Z","debut":"1999-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kenneth C. Anderson is an American professional wrestler and actor better known by his ring name Mr. Kennedy. After signing with WWE, Anderson made his debut on the SmackDown! roster as Ken Kennedy in August 2005. In September 2006 he captured his first title with the company, the WWE United States Championship, and would hold onto it for a month. The following year, at WrestleMania 23, Anderson won the annual Money in the Bank ladder match, a contract, which guarantees a match for any of WWE's three top titles. He was released from his WWE contract on May 29, 2009. In January 2010 Anderson signed a one-year deal with Total Nonstop Action Wrestling. He would make his return to the company at the Genesis pay-per-view on January 17, 2010, working under the ring name Mr. Anderson.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":120,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":66,"productFit":100,"riskTaking":27,"matchLayout":67,"psychology":63,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":49,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":82,"brandBuilding":67,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":61,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-148","wrestlerId":148,"promotionId":120,"startDate":"2025-11-22T00:00:00.000Z","endDate":"2027-11-22T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-11-22T00:00:00.000Z","wage":1000},{"id":149,"name":"Nick Aldis","realName":"Nick Aldis","picture":"Nick Aldis_alt.jpg","ability":61,"currentAbility":66,"potentialAbility":66,"charisma":71,"micSkills":64,"popularity":38,"condition":87,"hardcoreAbility":64,"injur