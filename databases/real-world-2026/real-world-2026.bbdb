70,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1973-09-12T00:00:00.000Z","debut":"1992-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Mascara Jr. is a masked Mexican luchador who works exclusively in Mexico. He is a Lightweight who is classed as using a Luchador style.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":68,"productFit":100,"riskTaking":27,"matchLayout":71,"psychology":58,"workerManagement":100,"trainingIntensity":61,"technicalCoaching":62,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":53,"brandBuilding":73,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":61,"consistency":84,"awareness":58,"judgement":75}},{"id":2536,"name":"Punishment Martinez","realName":"Punishment Martinez","picture":"Damian Priest.jpg","ability":70,"currentAbility":67,"potentialAbility":67,"charisma":78,"micSkills":59,"popularity":57,"condition":82,"hardcoreAbility":68,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":110,"height":195,"base":"USA","birthplace":"United States","dateOfBirth":"1982-09-26T00:00:00.000Z","debut":"2012-12-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Damian Priest prowls NXT with one goal in mind: To carve a legacy so undeniable that his name will live forever.\r\n\r\nAs mysterious as he is imposing, the towering Superstar was introduced to the NXT Universe via a series of videos in 2019. The imagery gave clue to Priest’s active nightlife, as he was seen flanked by a harem as he hopped from one club to another in a stretch limousine. In stark contrast to the party atmosphere surrounding him, Priest maintained a stoic, if unsettling, presence.\r\n\r\nThat same eerie calmness is no less apparent when Priest takes to the ring. Armed with immense power and an extensive knowledge of martial arts, the New York slugger is an unbridled force to be reckoned with, but he exudes the quiet confidence of a man who knows he’s always in control of his situation, no matter the arena.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[2741,2769],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":17,"matchLayout":70,"psychology":68,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":51,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":70,"brandBuilding":79,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":78,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-2536","wrestlerId":2536,"promotionId":64,"startDate":"2018-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":2540,"name":"Dave Bradshaw","realName":"Dave Bradshaw","picture":"Dave Bradshaw.jpg","ability":46,"currentAbility":46,"potentialAbility":46,"charisma":60,"micSkills":57,"popularity":0,"condition":100,"hardcoreAbility":52,"injuryProne":60,"type":"commentator","style":"all rounder","gender":"M","weight":95,"height":170,"base":"UK","birthplace":"England","dateOfBirth":"1979-01-11T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Dave Bradshaw is an English man who works primarily as an announcer.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId