00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"She's a beautiful, blonde, happy-go-lucky. The flexible, high-flying McKenzie has been making a big impression on fans of the burgeoning Aussie women's wrestling scene. Seems that the fans down under can't get enough of the vivacious ring performer...and now North American and European fans are looking forward to seeing more of this lady in their own arenas. Shazza McKenzie: ready to breakout across wrestling rings world-wide!","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2098],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":56,"productFit":100,"riskTaking":33,"matchLayout":56,"psychology":55,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":49,"characterCoaching":50,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":50,"brandBuilding":40,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":63,"awareness":55,"judgement":73}},{"id":2769,"name":"Jake Lindo","realName":"Jake Lindo","picture":"Jake Lindo.jpg","ability":62,"currentAbility":55,"potentialAbility":55,"charisma":42,"micSkills":57,"popularity":1,"condition":100,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":88,"height":177,"base":"Australia","birthplace":"Australia","dateOfBirth":"1991-03-17T00:00:00.000Z","debut":"2009-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jake Lindo is an Australian wrestler who works exclusively in Australia. He is a Lightweight who is classed as using a Cruiserweight style.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0