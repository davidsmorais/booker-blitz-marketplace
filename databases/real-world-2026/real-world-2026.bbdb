,"matchLayout":62,"psychology":58,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":56,"characterCoaching":38,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":38,"brandBuilding":22,"socialMediaSavvy":31,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":63,"awareness":58,"judgement":75},"contract":{"id":"tew-contract-2085","wrestlerId":2085,"promotionId":12,"startDate":"2013-12-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":2086,"name":"Pete Dunne","realName":"Pete Dunne","picture":"Pete Dunne.jpg","ability":80,"currentAbility":74,"potentialAbility":74,"charisma":82,"micSkills":89,"popularity":38,"condition":91,"hardcoreAbility":87,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":93,"height":175,"base":"UK","birthplace":"England","dateOfBirth":"1993-11-09T00:00:00.000Z","debut":"2005-05-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"“The BruiserWeight” Pete Dunne has seen and done it all. He has survived Japanese dojos and the training regiments of Coventry, U.K., and lived and breathed wrestling to the point that he believes everything he does constitutes a portion of his training.\r\n\r\nWhile Dunne began as a “full of hope” high-flyer, he transformed into a vengeful brawler who will accept nothing less than complete success. After he held the UK Championship for an incredible 685 days — the longest title reign in modern history — few could dispute Dunne’s claim that he is the “standard-bearer” of NXT UK.\r\n\r\nWith a penchant for inflicting pain — not to mention, a habit of attacking anybody who stands between him and whatever prize is in his crosshairs — Dunne lives in such a perpetual state of intensity that people cross the street to avoid him. Across the ring, his opponents have no such option.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[728,966,967,1802,1966,3655,3885,4370],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":77,"storytelling":79,"productFit":100,"riskTaking":17,"matchLayout":80,"psychology":77,"workerManagement":100,"trainingIntensity":86,"technicalCoaching":78,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":68,"brandBuilding":69,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":86,"consistency":78,"awareness":77,"judgement":86},"contract":{"id":"tew-contract-2086","wrestlerId":2086,"promotionId":64,"startDate":"2017-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":2087,"name":"Mauro Ranallo","realName":"Mauro Ranallo","picture":"Mauro Ranallo.jpg","ability":75,"currentAbility":75,"potentialAbility":75,"charisma":66,"micSkills":80,"popularity":19,"condition":100,"hardcoreAbility":75,"injuryProne":93,"type":"commentator","style":"all rounder","gender":"M","weight":78,"height":172,"base":"Canada","birthplace":"Canada","dateOfBirth":"1969-12-21T00:00:00.000Z","debut":"1989-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ranallo began his career as an announcer and manager at the age of 16, when he was offered a job with All-Star Wrestling (in Vancouver), a nationally televised wrestling show throughout Canada. After that program ended production and the promotion folded in 1989, Ranallo became a disc jockey for Abbotsford, British Columbia radio station CFVR (now CKQC-FM). Later, he provided commentary announcing duties for Muay Thai/Kickboxing events and King of the Cage mixed martial arts shows on TSN. From 1999 to 2000, he served as the commentator for the Stampede Wrestling TV show in Calgary. His color-commentator was the late Bad News Allen. He became most prominently known among MMA fans as the voice of PRIDE Fighting Championships PPV broadcasts in North America from 2003 until October 2006.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":118,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":67,"brandBuilding":21,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"contract":{"id":"tew-contract-2087","wrestlerId":2087,"promotionId":118,"startDate":"2024-10-19T00:00:00.000Z","endDate":"2026-10-19T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-10-19T00:00:00.000Z","wage":1000},{"id":2088,"name":"Zeus","realName":"Zeus","picture":"Zeus.jpg","ability":61,"currentAbility":63,"potentialAbility":63,"charisma":71,"micSkills":68,"popularity":5,"condition":89,"hardcoreAbility":82,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":100,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-01-27T00:00:00.000Z","debut":"2006-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Shigemasa Kanaya is a Japanese professional wrestler, better known by the ring name Zeus. He is not to be confused with Tom Lister who also went by the name Zeus in the WWF. He has wrestled all over Japan for various promotions, including AJPW, Pro Wrestling Zero1 and Osaka Pro.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1390,2304,2459],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":70,"productFit":100,"riskTaking":27,"matchLayout":71,"psychology":67,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":49,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":58,"brandBuilding":79,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":79,"awareness":67,"judgement":80}},{"id":2089,"name":"Seiya Morohashi","realName":"Seiya Morohashi","picture":"Seiya Morohashi.jpg","ability":46,"currentAbility":51,"potentialAbility":51,"charisma":39,"micSkills":66,"popularity":2,"condition":85,"hardcoreAbility":60,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":85,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1977-08-24T00:00:00.000Z","debut":"1997-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Seiya Morohashi is a Japanese wrestler who works exclusively in Japan. He is a Lightweight who is classed as using a Regular style. He is best known for his work with DDT and NOAH.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":62,"productFit":50,"riskTaking":40,"matchLayout":64,"psychology":55,"workerManagement":50,"trainingIntensity":69,"technicalCoaching":57,"characterCoaching":34,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":34,"brandBuilding":33,"socialMediaSavvy":16,"ruleKnowledge":0,"positioning":10,"reactionSpeed":69,"cons