":84,"awareness":89,"judgement":93},"contract":{"id":"tew-contract-330","wrestlerId":330,"promotionId":38,"startDate":"1984-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":331,"name":"KUSHIDA","realName":"KUSHIDA","picture":"KUSHIDA.jpg","ability":71,"currentAbility":70,"potentialAbility":70,"charisma":61,"micSkills":85,"popularity":33,"condition":75,"hardcoreAbility":59,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":85,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1983-05-12T00:00:00.000Z","debut":"2006-09-07T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Before joining the black-and-gold brand in 2019, Kushida had reached dizzying heights in the rings of Japan. His foray into combat sports came via mixed-martial arts; after learning grappling techniques under UFC Hall of Famer Kazushi Sakuraba (the namesake of Kushida's signature submission hold), Kushida went undefeated in all eight of his pro fights. He then transitioned into sports-entertainment, and just as quickly earned a collection of accolades and championships. Upon his arrival to NXT, Kushida occasionally came off as a somewhat lighthearted competitor, but he has flashed a scary new mean streak during submission victories against the likes of Velveteen Dream, Timothy Thatcher and Tony Nese.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[1535,2811,3318,3668,3669,3671,3887,4207],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":77,"productFit":100,"riskTaking":24,"matchLayout":78,"psychology":73,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":80,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":61,"brandBuilding":67,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":67,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-331","wrestlerId":331,"promotionId":38,"startDate":"2022-07-03T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":332,"name":"Alex Shelley","realName":"Alex Shelley","picture":"Alex Shelley.jpg","ability":78,"currentAbility":70,"potentialAbility":70,"charisma":59,"micSkills":76,"popularity":38,"condition":69,"hardcoreAbility":55,"injuryProne":90,"type":"wrestler","style":"technical","gender":"M","weight":98,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1983-05-23T00:00:00.000Z","debut":"2002-03-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Alex Shelley has been entertaining fans in Ring of Honor with his unique offense for more than a decade. The enigmatic Detroit native initially made his mark in ROH in 2004 as part of the controversial Generation Next. Shelley later was a member of The Embassy, a group guided by Prince Nana.\r\n \r\nShelley found his greatest success after forming Motor City Machine Guns with Chris Sabin. They began teaming in ROH in 2007 and have established themselves as one of the best tag teams of the past decade. After winning championships in various promotions in the U.S. and Japan, including the prestigious IWGP Junior Heavyweight Tag Team Titles, Shelley and Sabin finally captured the ROH World Tag Team Titles in 2017, defeating The Young Bucks.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[49,1234,1235,1270,1420,1535,2811,3690,3792,3887,3958,4040,4041],"record