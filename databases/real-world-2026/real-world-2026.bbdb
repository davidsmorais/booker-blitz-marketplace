promotionId":14,"startDate":"2004-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1233,"name":"Takashi Yoshida","realName":"Takashi Yoshida","picture":"Takashi Yoshida.jpg","ability":51,"currentAbility":55,"potentialAbility":55,"charisma":70,"micSkills":66,"popularity":5,"condition":86,"hardcoreAbility":48,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":120,"height":175,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-07-03T00:00:00.000Z","debut":"2006-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Takashi Yoshida is a Japanese wrestler, previously and best known by the ring name Cyber Kong. Cyber Kong's career started in 2006. He competed as an arm wrestler and was part of the New Japan Dojo system. He trained in the Los Angeles-based Inoki Dojo, but his short stature prevented him from getting far in it, so he took a tryout at the Dragon Gate USA dojo and became its first graduate. His frightening power, wrestling abilities, and muscular build made him nearly unbeatable in NEX, and thus he was soon brought up to the main roster, where he continued to be a major threat (however, he has shown himself to be susceptible to flash pins). On May 5th, 2017, Kong failed to capture the Open the Dream Gate Championship from YAMATO in a Steel Cage 5-Way Survival match, being the last man eliminated. As a result of the stipulation, he was forced to unmask, which eventually prompted him to reveal his real name and place of birth, officially bringing the Cyber Kong character to an end.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[1575,2453,2949],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":26,"matchLayout":63,"psychology":58,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":40,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":44,"brandBuilding":58,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":67,"awareness":58,"judgement":75},"contract":{"id":"tew-contract-1233","wrestlerId":1233,"promotionId":14,"startDate":"2006-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1234,"name":"Masato Yoshino","realName":"Masato Yoshino","picture":"Masato Yoshino.jpg","ability":95,"currentAbility":87,"potentialAbility":87,"charisma":95,"micSkills":98,"popularity":7,"condition":78,"hardcoreAbility":80,"injuryProne":100,"type":"writer","style":"high flyer","gender":"M","weight":74,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1980-07-17T00:00:00.000Z","debut":"2000-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Masato Yoshino is a retired Japanese wrestler who works as an on-screen personality and a road agent. He was one half of DoiYoshi alongside Naruki Doi. He is best known for his work with AAA, IMPACT, Dragongate, PWG, ROH and GLEAT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":110,"teams":[932,1032,3629],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":74,"storytelling":78,"productFit":100,"riskTaking":19,"matchLayout":80,"psychology":74,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":75,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":58,"brandBuilding":71,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":75,"awareness":74,"judgement":84},"contract":{"id":"tew-contract-1234","wrestlerId":1234,"promotionId":110,"startDate":"2026-07-30T00:00:00.000Z","endDate":"2028-07-30T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-07-30T00:00:00.000Z","wage":1000},{"id":1235,"name":"Yasushi Kanda","realName":"Yasushi Kanda","picture":"Yasushi Kanda.jpg","ability":53,"currentAbility":61,"potentialAbility":61,"charisma":75,"micSkills":71,"popularity":4,"condition":62,"hardcoreAbility":52,"injuryProne":84,"type":"wrestler","style":"technical","gender":"M","weight":85,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-08-29T00:00:00.000Z","debut":"1996-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Hiroyuki Kanda, better known as Yasushi Kanda, born on August 29, 1978 in Inage-ku, Chiba, Japan, is a Japanese wrestler currently performing for the Dragon Gate wrestling promotion in Japan. He is considered one of Toryumon's greatest heel characters, and was a founding member of the M2K stable. In his pre-injury days, he was famous for his mohawk hairstyle. Kanda was trained by Ultimo Dragon as a 2nd Term student. Shortly after debuting, he allied with Susumu Mochizuki. He suffered a legitimate neck injury on October 10, 2001 after taking a back-to-belly piledriver from Genki Horiguchi that displaced his neck vertebrae. He shifted over to a referee job. In 2006, Don Fujii of heel stable Blood Generation began to harass Kanda during matches. Kanda was provoked into fighting back. His full return to the ring occurred in July 2006, when he signed a wrestler's contract.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[1116],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":69,"productFit":100,"riskTaking":41,"matchLayout":71,"psychology":63,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":60,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":59,"mediaHandling":44,"brandBuilding":36,"socialMediaSavvy":70,"ruleKnowledge":54,"positioning":63,"reactionSpeed":57,"consistency":55,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-1235","wrestlerId":1235,"promotionId":14,"startDate":"2005-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1236,"name":"KAGETORA","realName":"KAGETORA","picture":"Kagetora.jpg","ability":61,"currentAbility":54,"potentialAbility":54,"charisma":47,"micSkills":57,"popularity":5,"condition":78,"hardcoreAbility":54,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":81,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-04-21T00:00:00.000Z","debut":"2002-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Fumiyuki Hashimoto known by his stage name Kagetora (stylized as KAGETORA), is a Japanese professional wrestler who works for Dragon Gate. He wrestles in independent wrestling leagues all around Japan and has wrestled in the United States for Chikara and Pro Wrestling Guerrilla. He has wrestled many famous wrestlers including Jinsei Shinzaki. Hashimoto was part of Mini Crazy MAX as SUWAcito early in his career with Takuya Sugi (Mini CIMA) and Masaki Okimoto (Small Dandy Fuji). They were little version of the Japanese wrestlers CIMA, Suwa and Don Fujii. On December 19, 2008, KAGETORA debuted in Dragon Gate after it was announced that El Dorado would be closing, intruding after the opening match. He openly declared war on Dragon Gate, attacking m.c. KZ and criticizing fellow former El Dorado wrestler Naoki Tanisaki for abandoning the company months prior.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[1117,2945],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":30,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":58,"characterCoaching":47,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":47,"brandBuilding":45,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":67,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-1236","wrestlerId":1236,"promotionId":14,"startDate":"2009-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1237,"name":"Susumu Yokosuka","realName":"Susumu Yokosuka","picture":"Susumu Mochizuki.jpg","ability":73,"currentAbility":65,"potentialAbility":65,"charisma":60,"micSkills":67,"popularity":8,"condition":79,"hardcoreAbility":60,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":77,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-02-18T00:00:00.000Z","debut":"1998-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Susumu Mochizuki better known by his ring name Susumu Yokosuka (born August 18, 1978) is a Japanese professional wrestler currently performing for the Dragon Gate professional wrestling promotion. He is not related to fellow Dragon Gate wrestler and long term ally/rival Masaaki Mochizuki, who debuted much earlier for WAR. After a brief stay in the Michinoku Pro Wrestling dojo, he entered Ultimo Dragon's dojo in Mexico. He debuted in 1998 as a third term student. On Dragon Gate USA's first pay-per-view Enter the Dragon, first aired on September 4, 2009, Yokosuka teamed with CIMA in a losing effort against The Young Bucks.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[1116,1117,1145,2946],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":72,"productFit":100,"riskTaking":18,"matchLayout":73,"psychology":67,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":73,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":68,"brandBuilding":56,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":76,"awareness":67,"judgement":80},"contract":{"id":"tew-contract-1237","wrestlerId":1237,"promotionId":14,"startDate":"2004-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1238,"name":"Naoki Tanizaki","realName":"Naoki Tanizaki","picture":"Naoki Tanizaki.jpg","ability":45,"currentAbility":54,"potentialAbility":54,"charisma":57,"micSkills":46,"popularity":4,"condition":100,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":78,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-12-01T00:00:00.000Z","debut":"2002-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Naoki Tanizaki is a Japanese wrestler currently competing for Dragon Gate. Originally from the Toryumon X promotion, Naoki Tanizaki debuted in a Toryumon Mexico show in December 2002. When Toryumon X made their Japanese landing in August 2003, Naoki debuted as a surfer (similar to Genki Horiguchi) defeating Kenichi Hanai. Tanizaki quickly joined the El Dorado Wrestling roster, even though he continued to remain a freelance wrestler. He was out injured after his second match with the company, however. He joined up with Shuji Kondo upon returning. Parts of his freelancing included forays into Pro Wrestling ZERO1-MAX, Big Japan Pro Wrestling and Kaientai Dojo. In the latter, he joined the heel stable Omega. In 2008, he resigned from El Dorado.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":52,"storytelling":62,"productFit":100,"riskTaking":39,"matchLayout":65,"psychology":52,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":53,"characterCoaching":71,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":71,"brandBuilding":57,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":67,"awareness":52,"judgement":71}},{"id":1239,"name":"Ryo Saito","realName":"Ryo Saito","picture":"Ryo Saito.jpg","ability":72,"currentAbility":65,"potentialAbility":65,"charisma":69,"micSkills":77,"popularity":7,"condition":91,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1979-08-15T00:00:00.000Z","debut":"1999-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ryo Saito is a Japanese professional wrestler, also known by the ring name Ryo \"Jimmy\" Saito. He wrestles for Dragon Gate, where he is a member of the Jimmyz stable. His name is sometimes abbreviated as SaiRyo, so as not to confuse him with Toryumon/DG alumni SAITO.  Ryo Saito debuted in 1999 as a fourth term student. He fought in that year's Young Dragons Cup, but lost in the finals to the newly-heel Yasushi Kanda. In 2000, he would divide his time between Japan and Mexico, and in Japan he adopted the gimmick of a bicycling enthusiast, wearing a professional bicycler’s outfit, helmet, and glasses and coming to the ring on a bicycle. Saito turned heel on January 14, 2011, along with the rest of WARRIORS, when they attacked Masato Yoshino and World-1, and joined forces with Naruki Doi's group.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[618,1217,2946],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":74,"productFit":100,"riskTaking":23,"matchLayout":76,"psychology":69,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":65,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":68,"brandBuilding":55,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":67,"awareness":69,"judgement":81},"contract":{"id":"tew-contract-1239","wrestlerId":1239,"promotionId":14,"startDate":"2004-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1240,"name":"Don Fujii","realName":"Don Fujii","picture":"Don Fujii.jpg","ability":70,"currentAbility":61,"potentialAbility":61,"charisma":70,"micSkills":49,"popularity":4,"condition":76,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":100,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1970-07-06T00:00:00.000Z","debut":"1997-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Tatsuki Fuji is a Japanese wrestler for Dragon Gate, best known by his ring name Don Fujii. He was one-half of the inaugural Open the Owarai Twin Gate Champions and is also a former two-time Open the Twin Gate Champions with Masaaki Mochizuki. He was previously in the Crazy MAX and Blood Generation stables. He was one of the original graduates from the Toryumon dojo. He was also one of the founding members of the Crazy MAX & Blood Generation stables. He made a few appearances in World Championship Wrestling as Sumo Fuji. He has wrestled as Karaoke Machine #1 at times as well. From 1999 until 2002, he changed his name annually.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[618,1582],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":68,"productFit":100,"riskTaking":47,"matchLayout":71,"psychology":57,"workerManagement":100,"trainingIntensity":52,"technicalCoaching":52,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":53,"mediaHandling":67,"brandBuilding":53,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":52,"consistency":67,"awareness":57,"judgement":74},"contract":{"id":"tew-contract-1240","wrestlerId":1240,"promotionId":14,"startDate":"2004-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1241,"name":"Gamma","realName":"Gamma","picture":"GAMMA.jpg","ability":48,"currentAbility":57,"potentialAbility":57,"charisma":42,"micSkills":49,"popularity":5,"condition":69,"hardcoreAbility":42,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1973-05-16T00:00:00.000Z","debut":"1996-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Yoshito Sugamoto is a Japanese professional wrestler, better known by the ring name Gamma. He is currently working for the Dragon Gate promotion. Yoshito Sugamoto began his career in Michinoku Pro when he entered their dojo, where he often wrestled in dark matches. He then left for Osaka Pro, where he gained top heel status. When he left that promotion, he toured the Japanese independent circuit, appearing briefly in dragondoor and in the STONED stable in El Dorado. He eventually turned up in Dragon Gate on March 19, 2006, being brought in by his friend Magnitude Kishiwada to take over his position in Blood Generation while he recuperated from a severe shoulder injury. He and stable head CIMA took an instant dislike to each other, however, and he was soon kicked out of the faction.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":96,"teams":[1266],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":69,"productFit":100,"riskTaking":30,"matchLayout":71,"psychology":65,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":45,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":72,"brandBuilding":42,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":61,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-1241","wrestlerId":1241,"promotionId":96,"startDate":"2024-06-23T00:00:00.000Z","endDate":"2026-06-23T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-06-23T00:00:00.000Z","wage":1000},{"id":1242,"name":"Super Shisa","realName":"Super Shisa","picture":"Super Shisa.jpg","ability":49,"currentAbility":56,"potentialAbility":56,"charisma":61,"micSkills":57,"popularity":4,"condition":72,"hardcoreAbility":64,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":77,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1970-04-09T00:00:00.000Z","debut":"1996-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Yoshiyuki Saito is a Japanese professional wrestler best known by his ring name Super Shisa, currently wrestling for Dragon Gate. His gimmick is inspired by the Ryukyuan Shisa. He claimed to be a student of Toryumon alumni SAITO, but was outed as being SAITO himself in 2007. Saito got his start in wrestling with Último Dragón's upstart promotion Toryumon. He trained in Mexico with the rest of the Último Dragón students, and briefly used the Super Shisa gimmick while there. He wrestled January 31, 1999, on Toryumon's debut show. Wrestling under his real name, he teamed with Magnum Tokyo and Dragon Kid to take on Shima Nobunaga, Sumo Fuji and Judo Suwa in an elimination match on the main event of the card. Saito would be eliminated second following a Nodowa Elbow from Fuji, but his team would go on to win the match.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2948],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":71,"productFit":100,"riskTaking":21,"matchLayout":72,"psychology":67,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":68,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":66,"brandBuilding":66,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":54,"awareness":67,"judgement":80}},{"id":1243,"name":"Dragon Kid","realName":"Dragon Kid","picture":"Dragon Kid.jpg","ability":58,"currentAbility":61,"potentialAbility":61,"charisma":76,"micSkills":56,"popularity":7,"condition":75,"hardcoreAbility