-12-13T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1788,"name":"AZM","realName":"AZM","picture":"Azumi.jpg","ability":62,"currentAbility":61,"potentialAbility":61,"charisma":69,"micSkills":59,"popularity":19,"condition":89,"hardcoreAbility":73,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":55,"height":152,"base":"Japan","birthplace":"Japan","dateOfBirth":"2002-10-01T00:00:00.000Z","debut":"2014-07-06T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"AZM, who graduated from Stardom Dojo on 01 January 2011, is a Japanese wrestler who works exclusively in Japan. She is a 5'1\", 117lb worker who is classed as using a Technician Flyer style. She uses the Diving Crossbody and the Fast Brain Buster as her finishers. She is best known for her work with NJPW, Stardom and Marvelous. She is currently the NJPW STRONG Women's champion and an Artist of Stardom champion. She is the protege of Kagetsu.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":61,"teams":[2445,3616,4310],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":71,"productFit":100,"riskTaking":17,"matchLayout":72,"psychology":68,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":72,"characterCoaching":80,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":80,"brandBuilding":68,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":76,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-1788","wrestlerId":1788,"promotionId":61,"startDate":"2013-10-06T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":1789,"name":"KAIRI","realName":"KAIRI","picture":"Kairi Hojo.jpg","ability":63,"currentAbility":71,"potentialAbility":71,"charisma":75,"micSkills":77,"popularity":47,"condition":82,"hardcoreAbility":77,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":52,"height":152,"base":"Japan","birthplace":"Japan","dateOfBirth":"1988-09-23T00:00:00.000Z","debut":"2012-01-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Given her jet-setting and worldwide accomplishments, it’s no surprise that Kairi found her way to WWE, joining NXT in summer 2017 and immediately announcing her participation in the inaugural Mae Young Classic. Over the five rounds, The Pirate Princess outlasted the competition — a stiff field of 31 other global sensations — and notched a milestone by winning the tournament with a career-defining victory against former UFC fighter Shayna Baszler in the Finale. History repeated itself almost a year later, when Sane defeated Baszler to capture the NXT Women’s Championship at NXT TakeOver: Brooklyn IV. Shortly thereafter, Sane set sail for uncharted waters by joining the SmackDown LIVE roster in the 2019 Superstar Shake-up and immediately forming The Kabuki Warriors with Asuka. Sane and Asuka captured the WWE Women's Tag Team Titles from Alexa Bliss and Nikki Cross at WWE Hell in a Cell 2019 when The Empress of Tomorrow used the green mist against Cross.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1891,2508,2759,3514],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":82,"storytelling":83,"productFit":100,"riskTaking":39,"matchLayout":83,"psychology":82,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":79,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":76,"brandBuilding":78,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":68,"awareness":82,"judgement":89}},{"id":1790,"name":"Koguma","realName":"Koguma","picture":"Koguma.jpg","ability":46,"currentAbility":53,"potentialAbility":53,"charisma":57,"micSkills":55,"popularity":15,"condition":93,"hardcoreAbility":51,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":60,"height":147,"base":"Japan","birthplace":"Japan","dateOfBirth":"1998-01-20T00:00:00.000Z","debut":"2013-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Koguma, a 2013 graduate of the Stardom Dojo, is a Japanese wrestler who works exclusively in Japan. She is a Very Small worker who is classed as using a Technician Flyer style. She is best known for her work with Stardom, Sendai Girls and Ice Ribbon.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":61,"teams":[3071,3894],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":62,"productFit":75,"riskTaking":23,"matchLayout":63,"psychology":57,"workerManagement":75,"trainingIntensity":73,"technicalCoaching":60,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":61,"brandBuilding":46,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":15,"reactionSpeed":73,"consistency":68,"awareness":57,"judgement":64},"contract":{"id":"tew-contract-1790","wrestlerId":1790,"promotionId":61,"startDate":"2021-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":1791,"name":"Kris Wolf","realName":"Kris Wolf","picture":"Kris Wolf.jpg","ability":46,"