lay most WWE entrance themes by guitar.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":42,"storytelling":51,"productFit":30,"riskTaking":51,"matchLayout":54,"psychology":42,"workerManagement":30,"trainingIntensity":49,"technicalCoaching":42,"characterCoaching":38,"diagnosis":50,"rehabilitation":50,"prevention":49,"mediaHandling":38,"brandBuilding":38,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":6,"reactionSpeed":49,"consistency":40,"awareness":42,"judgement":37}},{"id":2521,"name":"Rick Rude","realName":"Rick Rude","picture":"Rick Rude.jpg","ability":47,"currentAbility":56,"potentialAbility":56,"charisma":46,"micSkills":64,"popularity":43,"condition":58,"hardcoreAbility":37,"injuryProne":68,"type":"wrestler","style":"powerhouse","gender":"M","weight":114,"height":187,"base":"USA","birthplace":"United States","dateOfBirth":"1958-12-07T00:00:00.000Z","debut":"1976-03-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"'Ravishing' Rick Rude is one of the greatest heels of all-time. A back injury has caused his retirement, although he is still greatly charismatic and a master on the mic. He is one of the workers who jumped ship to WCW for major money. Rude died at the age of 40 on April 20, 1999 after suffering heart failure. An autopsy report showed he died from an overdose of \"mixed medications.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":85,"storytelling":84,"productFit":0,"riskTaking":30,"matchLayout":83,"psychology":85,"workerManagement":0,"trainingIntensity":27,"technicalCoaching":34,"characterCoaching":83,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":83,"brandBuilding":75,"socialMediaSavvy":81,"ruleKnowledge":0,"positioning":0,"reactionSpeed":27,"consistency":85,"awareness":85,"judgement":51}},{"id":2522,"name":"Big Boss Man","realName":"Big Boss Man","picture":"Big Boss Man.jpg","ability":57,"currentAbility":50,"potentialAbility":50,"charisma":56,"micSkills":50,"popularity":44,"condition":59,"hardcoreAbility":59,"injuryProne":77,"type":"wrestler","style":"all rounder","gender":"M","weight":153,"height":195,"base":"USA","birthplace":"United States","dateOfBirth":"1963-05-02T00:00:00.000Z","debut":"1985-10-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"Ray Traylor, AKA \"The Big Boss Man\" entered wrestling after being a former prison guard. A big man who was surprisingly agile in his hey day Traylor has feuded with some of the biggest names in wrestling including Hulk Hogan. Now a grizzled veteran Boss Man still has the presence in ring to turn out a decent bout with the right opponent.  After a spell in WCW, Traylor returned to the WWF in late 1998, once again under his Big Bossman persona. However, his character was changed from a regular police officer to a bully-type personal security officer, or bodyguard-type character, willing to do anything for a price.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":68,"productFit":90,"riskTaking":17,"matchLayout":68,"psychology":69,"workerManagement":90,"trainingIntensity":51,"technicalCoaching":18,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":68,"brandBuilding":70,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":18,"reactionSpeed":51,"consistency":56,"awareness":69,"judgement":77}},{"id":2523,"name":"Ryan 