dition":94,"hardcoreAbility":60,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":85,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1984-01-03T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"El Hijo del Signo is a Mexican luchador enmascarado, or masked professional wrestler currently working for the Mexican professional wrestling promotion Consejo Mundial de Lucha Libre (CMLL) portraying a rudo (\"Bad guy\") wrestling character. Hijo del Signo's real name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans. His ring name is Spanish for \"Son of the Sign\", based on the ring name of his father El Signo.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":60,"productFit":100,"riskTaking":27,"matchLayout":62,"psychology":53,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":58,"characterCoaching":47,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":47,"brandBuilding":38,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":79,"awareness":53,"judgement":72}},{"id":2281,"name":"Atomic Star","realName":"Atomic Star","picture":"Atomic Star.jpg","ability":45,"currentAbility":49,"potentialAbility":49,"charisma":55,"micSkills":42,"popularity":1,"condition":92,"hardcoreAbility":35,"injuryProne":89,"type":"wrestler","style":"high flyer","gender":"M","weight":76,"height":162,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1995-05-02T00:00:00.000Z","debut":"2010-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Atomic Star is a Mexican luchador who works exclusively in Mexico. He is a Small worker who is classed as using a Luchador style. He is the cousin of fellow wrestler, Eterno.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":119,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":48,"storytelling":54,"productFit":30,"riskTaking":31,"matchLayout":56,"psychology":48,"workerManagement":30,"trainingIntensity":66,"technicalCoaching":51,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":51,"brandBuilding":27,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":6,"reactionSpeed":66,"consistency":80,"awareness":48,"judgement":41},"contract":{"id":"tew-contract-2281","wrestlerId":2281,"promotionId":119,"startDate":"2025-04-11T00:00:00.000Z","endDate":"2027-04-11T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-04-11T00:00:00.000Z","wage":1000},{"id":2282,"name":"Space Monkey","realName":"Space Monkey","picture":"Space Monkey.jpg","ability":54,"currentAbility":49,"potentialAbility":49,"charisma":54,"micSkills":50,"popularity":2,"condition":98,"hardcoreAbility":57,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":73,"height":172,"base":"Canada","birthplace":"Canada","dateOfBirth":"1993-03-06T00:00:00.000Z","debut":"2014-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Space Monkey is a masked Canadian wrestler who works in America, Canada, the British Isles and Japan. He is a Lightweight who is classed as using a High Flyer style. He is one half of Space Pirates alongside Shane Sabre. He is best known for his work with DDT, Beyond, BLP, AAW, AIW, Smash, C4, A1 and CHIKARA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1768,2167,2273,2422,2650,2865],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":46,"storytelling":53,"productFit":42,"riskTaking":33,"matchLayout":55,"psychology":46,"workerManagement":42,"trainingIntensity":69,"technicalCoaching":49,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":64,"brandBuilding":31,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":8,"reactionSpeed":69,"consistency":73,"awareness":46,"judgement":44}},{"id":2283,"name":"Jim Nye","realName":"Jim Nye","picture":"Jim Nye.jpg","ability":52,"currentAbility":47,"potentialAbility":47,"charisma":57,"micSkills":41,"popularity":0,"condition":96,"hardcoreAbility":32,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":89,"height":170,"base":"Canada","birthplace":"Canada","dateOfBirth":"1991-03-18T00:00:00.000Z","debut":"2013-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jim Nye The Science Guy is a Canadian wrestler who works exclusively in North America. He is a Lightweight who is classed as using a Cruiserweight style. He is also a high school teacher outside of wrestling and in fact didn't even start his career until he was 29. He trained in the CWF where he stayed for 1 year before heading to Battle Arts Academy to round out his training.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2865],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":43,"storytelling":50,"productFit":25,"riskTaking":26,"matchLayout":52,"psychology":43,"workerManagement":25,"trainingIntensity":73,"technicalCoaching":51,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":64,"brandBuilding":28,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":5,"reactionSpeed":73,"consistency":68,"awareness":43,"judgement":36}},{"id":2285,"name":"Reed Bentley","realName":"Reed Bentley","picture":"Reed Bentley.jpg","ability":54,"currentAbility":52,"potentialAbility":52,"charisma":41,"micSkills":56,"popularity":2,"condition":100,"hardcoreAbility":48,"injuryProne":100,"type":"wrestler","style":"hardcore","gender":"M","weight":85,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1991-03-30T00:00:00.000Z","debut":"2010-05-22T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Reed Bentley is an American wrestler who works in the USA and Canada. He is a 5'10\", 187lb worker who is classed as using a Hardcore style. He uses the Back Senton and the Italian Leatherface as his finishers. He is one half of The Rejects alongside John Wayne Murdoch. He is best known for his work with GCW, Beyond, AAW, IWA-MS, ICW NHB and CZW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2535,2998],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":56,"productFit":100,"riskTaking":33,"matchLayout":57,"psychology":54,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":33,"characterCoaching":59,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":59,"brandBuilding":29,"socialMediaSavvy":52,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":75,"awareness":54,"judgement":72}},{"id":2286,"name":"Black Terry","realName":"Black Terry","picture":"Black Terry.jpg","ability":64,"currentAbility":64,"potentialAbility":64,"charisma":71,"micSkills":65,"popularity":4,"condition":55,"hardcoreAbility":72,"injuryProne":100,"type":"referee","style":"high flyer","gender":"M","weight":80,"height":165,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1952-09-03T00:00:00.000Z","debut":"1975-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":true,"story":"Esteban Mares Castañeda is a Mexican luchador, or professional wrestler, better known by the ring name Black Terry. Wrestling since 1973, he was once part of a group called Los Temerarios alongside Jose Luis Feliciano and Shu El Guerrero. He has previously worked as the masked character Guerrero Maya (\"Mayan Warrior\") where he formed the group called Los Guerreros Del Futuro (\"The Warriors of the Future\") with Guerrero del Futuro (a masked Feliciano) and Damian El Guerrero. He is the father of wrestler Guerrero Maya, Jr. although the relationship is not officially recognized due to Guerrero Maya, Jr. being a masked wrestler.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":88,"storytelling":89,"productFit":100,"riskTaking":16,"matchLayout":89,"psychology":88,"workerManagement":100,"trainingIntensity":49,"technicalCoaching":65,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":78,"brandBuilding":48,"socialMediaSavvy":65,"ruleKnowledge":64,"positioning":71,"reactionSpeed":49,"consistency":52,"awareness":88,"judgement":93}},{"id":2287,"name":"Herzog","realName":"Herzog","picture":"American Viking.jpg","ability":41,"currentAbility":49,"potentialAbility":49,"charisma":63,"micSkills":38,"popularity":1,"condition":83,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":122,"height":193,"base":"USA","birthplace":"United States","dateOfBirth":"1989-01-02T00:00:00.000Z","debut":"2009-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Herzog is an American wrestler who works in America and Canada. He is a Light Heavyweight who is classed as using a Brawler style. He is one half of Viking War Party alongside Warhorse. He is best known for his work with ICW NHB, Beyond and IWA-MS.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[766,1558],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":55,"productFit":100,"riskTaking":31,"matchLayout":57,"psychology":49,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":14,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":64,"brandBuilding":48,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":64,"awareness":49,"judgement":69}},{"id":2290,"name":"Mecha Wolf","realName":"Mecha Wolf","picture":"Mr 450.jpg","ability":64,"currentAbility":58,"potentialAbility":58,"charisma":65,"micSkills":64,"popularity":17,"condition":90,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":84,"height":172,"base":"USA","birthplace":"Puerto Rico","dateOfBirth":"1987-06-21T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Mecha Wolf is a Puerto Rican wrestler who works in America, Mexico and the British Isles. He is a Lightweight who is classed as using a High Flyer style. He is best known for his work with CMLL, AAA, NXT, AJPW, NWA, ZERO1, The Crash, FCP, IWA-MS, TNT and NLL. He is currently a TNT Tag Team champion and a NWA World Tag Team champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[2177,3077,3564],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":62,"productFit":100,"riskTaking":32,"matchLayout":63,"psychology":57,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":55,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":63,"brandBuilding":55,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":52,"awareness":57,"judgement":74},"contract":{"id":"tew-contract-2290","wrestlerId":2290,"promotionId":5,"startDate":"2022-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":2291,"name":"Anthony Bennett","realName":"Anthony Bennett","picture":"Anthony Bennett.jpg","ability":50,"currentAbility":50,"potentialAbility":50,"charisma":47,"micSkills":61,"popularity":1,"condition":96,"hardcoreAbility":31,"injuryProne":99,"type":"wrestler","style":"high flyer","gender":"M","weight":75,"height":177,"base":"USA","birthplace":"United States","dateOfBirth":"1995-11-21T00:00:00.000Z","debut":"2012-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"The first thing you’ll notice about Anthony Bennett is the hair. A hightop fade that stops just short of the heavens themselves, it may be the single most majestic coiffure on display in the CWC. The second, and more pertinent thing, you’ll notice about him is that he’s really good. A product of “The World Famous Monster Factory” in South Jersey, Bennett boasts a growing resume to go with his look, including a defense of the promotion’s Supersonic Championship in its first Ladder Match earlier this year. In the CWC, he’ll have the chance to climb even higher, reaching rarified air that even his ’do can’t touch.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3111],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":54,"productFit":30,"riskTaking":27,"matchLayout":58,"psychology":44,"workerManagement":30,"trainingIntensity":67,"technicalCoaching":48,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":69,"brandBuilding":54,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":6,"reactionSpeed":67,"consistency":66,"awareness":44,"judgement":38}},{"id":2292,"name":"Mustafa Ali","realName":"Mustafa Ali","picture":"Mustafa Ali.jpg","ability":71,"currentAbility":61,"potentialAbility":61,"charisma":48,"micSkills":74,"popularity":37,"condition":87,"hardcoreAbility":52,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":83,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1986-03-28T00:00:00.000Z","debut":"2003-03-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"For more than a decade, Ali pursued his dream of making it as a WWE Superstar, competing on the independent scene while working as a police officer in Chicago and starting a family. Barely squeaking his way into the 2016 Cruiserweight Classic after being announced as an alternate, Ali displayed a dogged perseverance that eventually took him all the way to a bout for the WWE Cruiserweight Championship against Cedric Alexander at WrestleMania. Although he was narrowly edged by his friend, Ali had the capacity crowd in the palm of his hand from bell to bell.\r\n\r\nAli moved from 205 Live to SmackDown LIVE and wasted no time turning heads, as he scored an incredible pinfall victory against then-WWE Champion Daniel Bryan in a tag team match. No stranger to thrilling moments inside the squared circle, Ali puts his extensive in-ring ability on full display when he executes the jaw-dropping 054, a reverse 450 splash on the blue brand. But it wasn't enough to prevent the inevitable chaos that was","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":28,"teams":[2763],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":23,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":57,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":72,"brandBuilding":64,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":79,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-2292","wrestlerId":2292,"promotionId":28,"startDate":"2025-01-23T00:00:00.000Z","endDate":"2027-01-23T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-01-23T00:00:00.000Z","wage":1000},{"id":2293,"name":"Adrian Severe","realName":"Adrian Severe","picture":"Adrian Severe.jpg","ability":59,"currentAbility":68,"potentialAbility":68,"charisma":57,"micSkills":70,"popularity":34,"condition":89,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":100,"height":180,"base":"Europe","birthplace":"Italy","dateOfBirth":"1990-07-21T00:00:00.000Z","debut":"2011-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Intense. Fabian Aichner uses this word to describe himself, and it certainly fits. The elite competitor has come a long way since his humble beginnings in an Italian village of fewer than 2,000 people. Finding purpose in the squared circle, he made a name for himself in Europe thanks to his eye-popping combination of strength and speed. Only the second Italian-born Superstar ever in WWE — following legendary WWE Hall of Famer Bruno Sammartino — Aichner made his WWE debut in the historic Cruiserweight Classic. The chiseled workhouse turned heads with his high-flying arsenal and powerful stature, and that was before he showed up in NXT in September 2017 with even more muscle packed on to his sturdy frame. Now aligned with WALTER, Alexander Wolfe and Marcel Barthel in the dominant Imperium faction, this impressive Superstar has the force, velocity and confidence to dominate NXT UK and beyond.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":28,"teams":[1862,2151,2363],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":18,"matchLayout":68,"psychology":62,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":68,"characterCoaching":49,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":49,"brandBuilding":66,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":80,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-2293","wrestlerId":2293,"promotionId":28,"startDate":"2026-07-01T00:00:00.000Z","endDate":"2028-07-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-07-01T00:00:00.000Z","wage":1000},{"id":2294,"name":"Jason Lee","realName":"Jason Lee","picture":"Jason Lee.jpg","ability":69,"currentAbility":60,"potentialAbility":60,"charisma":61,"micSkills":64,"popularity":5,"condition":92,"hardcoreAbility":43,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":72,"height":165,"base":"Other","birthplace":"Unknown","dateOfBirth":"1992-10-18T00:00:00.000Z","debut":"2009-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jason Lee is a Hong Konger wrestler who works in the USA and Japan. He is a 5'6\", 159lb worker who is classed as using a Technician Flyer style. He uses the Sunset flip powerbomb as his finisher. He is best known for his work with Dragon Gate. He is the protege of Ho Ho Lun.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[4116],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":66,"productFit":100,"riskTaking":22,"matchLayout":67,"psychology":61,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":58,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":51,"brandBuilding":48,"socialMediaSavvy":41,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":67,"awareness":61,"judgement":77},"contract":{"id":"tew-contract-2294","wrestlerId":2294,"promotionId":14,"startDate":"2017-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":2295,"name":"Conor Claxton","realName":"Conor Claxton","picture":"Connor Claxton.jpg","ability":44,"currentAbility":48,"potentialAbility":48,"charisma":51,"micSkills":43,"popularity":1,"condition":92,"hardcoreAbility":41,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":98,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1993-06-28T00:00:00.000Z","debut":"2014-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"\"Wrench\" Conor Claxton is an American wrestler who works exclusively in North America. He is a Lightweight who is classed as using a Regular Wrestler style. He is a graduate from the CZW Wrestling Academy.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"tea