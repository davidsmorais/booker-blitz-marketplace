, 225lb worker who is classed as using a Entertainer style. He uses the One Percenter and The Purpose as his finishers. He is best known for his work with WWE, TNA, NXT, ROH, NWA and AIW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":120,"teams":[3699,4250],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":59,"storytelling":61,"productFit":100,"riskTaking":30,"matchLayout":62,"psychology":59,"workerManagement":100,"trainingIntensity":52,"technicalCoaching":47,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":78,"brandBuilding":72,"socialMediaSavvy":71,"ruleKnowledge":0,"positioning":20,"reactionSpeed":52,"consistency":63,"awareness":59,"judgement":75},"contract":{"id":"tew-contract-209","wrestlerId":209,"promotionId":120,"startDate":"2026-05-01T00:00:00.000Z","endDate":"2028-05-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-05-01T00:00:00.000Z","wage":1000},{"id":212,"name":"Norman Smiley","realName":"Norman Smiley","picture":"Norman Smiley.jpg","ability":82,"currentAbility":84,"potentialAbility":84,"charisma":93,"micSkills":94,"popularity":10,"condition":100,"hardcoreAbility":65,"injuryProne":93,"type":"writer","style":"all rounder","gender":"M","weight":109,"height":185,"base":"UK","birthplace":"England","dateOfBirth":"1965-02-28T00:00:00.000Z","debut":"1985-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Norman Anthony Smiley is a British-born professional wrestler best known for his appearances in World Championship Wrestling. Norman Smiley trained under Rusty Brooks and Boris and Dean Malenko before making his debut in 1985 on the Floridian independent circuit, originally known as Black Magic, then as the hated Lord Henry Norman. Smiley wrestled in the Japanese shootstyle group UWF International (UWFi) in 1988 and 1989. In 1990 Smiley competed at the National Wrestling Alliance/World Championship Wrestling Starrcade 1990 event teaming with Chris Adams against the team of Konnan and Rey Misterio, Sr. In 1992, he began wrestling for CMLL in Mexico as Black Magic, winning the CMLL World Heavyweight Championship and holding it until losing to Silver King in 1994. Smiley joined WCW in 1997 and remained there until 2001 when the WWE bought them out.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":65,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":78,"productFit":100,"riskTaking":22,"matchLayout":81,"psychology":68,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":25,"characterCoaching":75,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":55,"socialMediaSavvy":65,"ruleKnowledge":25,"positioning":40,"reactionSpeed":51,"consistency":65,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-212","wrestlerId":212,"promotionId":65,"startDate":"2012-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"inDevelopment":true},{"id":215,"name":"Ricky Steamboat","realName":"Ricky Steamboat","picture":"Ricky Steamboat.jpg","ability":97,"currentAbility":98,"potentialAbility":98,"charisma":100,"micSkills":100,"popularity":38,"condition":56,"hardcoreAbility":100,"injuryProne":93,"type":"writer","style":"all rounder","gender":"M","weight":108,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1953-02-28T00:00:00.000Z","debut":"1971-02-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Richard Henry Blood better known by his ring name Ricky \"The Dragon\" Steamboat, is a retired American professional wrestler. He is best known for his work with the American Wrestling Association (AWA), the National Wrestling Alliance (NWA), World Championship Wrestling (WCW), and the World Wrestling Federation (WWF). In the NWA and WCW, he was a one-time NWA World Heavyweight Champion, a four-time United States Heavyweight Champion, a four-time World Television Champion, a twelve-time World Tag Team Champion (eight-time under the WCW banner, one-time (though unofficial) under the NWA banner, and three-time under the Mid-Atlantic banner), and a two-time Mid-Atlantic Heavyweight Champion. In the WWF/E, Steamboat was a one-time Intercontinental Champion and was inducted into the WWE Hall of Fame in 2009.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1329,2715],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":95,"storytelling":97,"productFit":100,"riskTaking":12,"matchLayout":97,"psychology":95,"workerManagement":100,"trainingIntensity":50,"technicalCoaching":60,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":88,"mediaHandling":72,"brandBuilding":45,"socialMediaSavvy":68,"ruleKnowledge":68,"positioning":74,"reactionSpeed":50,"consistency":62,"awareness":95,"judgement":97}},{"id":216,"name":"Robbie Brookside","realName":"Robbie Brookside","picture":"Robbie Brookside.jpg","ability":84,"currentAbility":79,"potentialAbility":79,"charisma":90,"micSkills":76,"popularity":4,"condition":87,"hardcoreAbility":59,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":109,"height":187,"base":"UK","birthplace":"England","dateOfBirth":"1966-03-11T00:00:00.000Z","debut":"1984-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Ro