fessional wrestler trained by Meiko Satomura. He began his career wrestling under his (presumed) real name, Yukari Ishino in 2008 for the SENDAI promotion. Kagetsu has a background in judo, which can be seen in his style. In May 2022, he came out as transgender.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1261],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":80,"productFit":100,"riskTaking":19,"matchLayout":80,"psychology":78,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":69,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":79,"brandBuilding":72,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":68,"awareness":78,"judgement":87}},{"id":1770,"name":"Kaho Kobayashi","realName":"Kaho Kobayashi","picture":"Kaho Kobayashi.jpg","ability":52,"currentAbility":58,"potentialAbility":58,"charisma":63,"micSkills":62,"popularity":6,"condition":97,"hardcoreAbility":59,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":53,"height":149,"base":"Japan","birthplace":"Japan","dateOfBirth":"1992-05-12T00:00:00.000Z","debut":"2013-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kaho Kobayashi is a female Japanese wrestler who was trained by the WNC promotion, most notably under TAJIRI. She has a background in gymnastics and breakdance, which have helped in her performances.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":73,"teams":[1709,1712],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":65,"productFit":100,"riskTaking":25,"matchLayout":66,"psychology":61,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":62,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":73,"brandBuilding":63,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":67,"awareness":61,"judgement":77},"contract":{"id":"tew-contract-1770","wrestlerId":1770,"promotionId":73,"startDate":"2022-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1771,"name":"Makoto","realName":"Makoto","picture":"Makoto.jpg","ability":56,"currentAbility":61,"potentialAbility":61,"charisma":49,"micSkills":47,"popularity":3,"condition":93,"hardcoreAbility":68,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":60,"height":165,"base":"Japan","birthplace":"Japan","dateOfBirth":"1989-09-26T00:00:00.000Z","debut":"2006-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Makoto is a Japanese professional wrestler. Trained by Emi Sakura, Makoto made her debut for her Ice Ribbon promotion in July 2006. During the next five years, Makoto went on to win Ice Ribbon's top title, the ICE×60 Championship, once and the International Ribbon Tag Team Championship twice, before transferring over to the Smash promotion in August 2011. She remained with Smash until March 2012, when the promotion folded. The following month, Makoto was announced as part of the roster of the new Wrestling New Classic (WNC) promotion. In March 2013, Makoto became the second WNC Women's Champion. In January 2014, Makoto made Reina Joshi Puroresu her second home promotion in addition to WNC. Reina became her primary home promotion after WNC shut down in June 2014. She is a former two-time Reina World Tag Team Champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":82,"teams":[3423],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":72,"productFit":100,"riskTaking":26,"matchLayout":73,"psychology":67,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":71,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":67,"brandBuilding":54,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":87,"awareness":67,"judgement":80},"contract":{"id":"tew-contract-1771","wrestlerId":1771,"promotionId":82,"startDate":"2021-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1772,"name":"Mika Iida","realName":"Mika Iida","picture":"Mika Iida.jpg","ability":46,"currentAbility":48,"potentialAbility":48,"charisma":61,"micSkills":35,"popularity":0,"condition":93,"hardcoreAbility":54,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"F","weight":50,"height":152,"base":"Japan","birthplace":"Japan","dateOfBirth":"1992-03-23T00:00:00.000Z","debut":"2010-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Mika Iida was the last new wrestler to ever come out of NEO. In perhaps an odd bit of timing, she did not join the promotion until after it’s closing was announced on May 5, although it also coincided with her graduating from high school. She started training almost immediately for her debut, which came about 6 months after she began training in wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":50,"productFit":40,"riskT