:[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":43,"storytelling":47,"productFit":88,"riskTaking":42,"matchLayout":49,"psychology":43,"workerManagement":88,"trainingIntensity":69,"technicalCoaching":55,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":58,"mediaHandling":60,"brandBuilding":35,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":18,"reactionSpeed":69,"consistency":62,"awareness":43,"judgement":61}},{"id":1643,"name":"Gregory Iron","realName":"Gregory Iron","picture":"Gregory Iron.jpg","ability":50,"currentAbility":53,"potentialAbility":53,"charisma":68,"micSkills":60,"popularity":3,"condition":95,"hardcoreAbility":63,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":70,"height":162,"base":"USA","birthplace":"United States","dateOfBirth":"1986-10-12T00:00:00.000Z","debut":"2006-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Gregory Allen Smith better known by his ring name Gregory Iron, is an American professional wrestler, who performs regularly in Absolute Intense Wrestling, Pro Wrestling Ohio, AAW, Chikara, and Smash promotions. Smith was diagnosed with cerebral palsy, which has left his right arm withered and with extremely limited range of motion. Says Smith, \"the only time it bothers me is little stuff like if I need to open a bag of pretzels. I can't do it. At first, Iron pursued professional wrestling in the weight room, inventing his own regimen since his right hand would not allow him to execute most lifts in the traditional way. In this way he added 30 pounds of muscle to his frame. In early training with J. T. Lightning, Iron took a great deal of punishment, asking for no pity, and modifying wrestling holds so they could be applied using his one good arm.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2861,2862,2863,2864,3569],"reco