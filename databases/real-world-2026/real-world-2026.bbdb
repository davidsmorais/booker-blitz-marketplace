ormer one-time BJW Deathmatch Heavyweight, three-time DDT Extreme Division Champion and a one-time Union Max Champion. He is also known as one half of the tag team Yankii Ni Cho Kenju with Yuko Miyamoto. The two are former two-time BJW Tag Team Champions, one-time KO-D Tag Team Champions and one-time Wave Tag Team Champions and have also won the Dai Nihon Saikyo Tag League three times. Kodaka has also won both the BJW Tag Team Championship and the Dai Nihon Saikyo Tag League once with Masashi Takeda.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":104,"teams":[1576,2456,2457,2458],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":71,"storytelling":73,"productFit":100,"riskTaking":38,"matchLayout":74,"psychology":71,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":55,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":55,"brandBuilding":57,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":88,"awareness":71,"judgement":83},"contract":{"id":"tew-contract-1827","wrestlerId":1827,"promotionId":104,"startDate":"2023-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1829,"name":"Leviatham","realName":"Leviatham","picture":"Leviatham.jpg","ability":52,"currentAbility":49,"potentialAbility":49,"charisma":64,"micSkills":43,"popularity":1,"condition":97,"hardcoreAbility":35,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":87,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1982-12-18T00:00:00.000Z","debut":"2000-10-18T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Leviatham is a 