r","masked":false,"retired":false,"dead":false,"story":"Danshoku Dino is a Japanese professional wrestler. Dino plays an overly exaggerated homosexual character similar to the likes of Adrian Street. His ring name comes from the character Baron Dino from the manga series Sakigake!! Otokojuku. Dino was trained in shoot fighting prior to training to be a wrestler and he incorporated this training into his wrestling style. In addition to wrestling in Dramatic Dream Team (DDT), he has also competed in several independent wrestling promotions around Japan, including Dragon Gate, Ice Ribbon, Kaientai Dojo, Osaka Pro Wrestling and Pro Wrestling ZERO1-MAX. In February 2007, Dino made his first excursion overseas, as he debuted for a few American independent promotions such as Chikara, Combat Zone Wrestling (CZW) and International Wrestling Cartel (IWC).","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":12,"teams":[2688],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":73,"productFit":100,"riskTaking":17,"matchLayout":73,"psychology":73,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":55,"characterCoaching":80,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":80,"brandBuilding":20,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":70,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-1457","wrestlerId":1457,"promotionId":12,"startDate":"2003-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":1458,"name":"DJ Nira","realName":"DJ Nira","picture":"DJ Nira.jpg","ability":55,"currentAbility":55,"potentialAbility":55,"charisma":51,"micSkills":60,"popularity":3,"condition":74,"hardcoreAbility":54,"injuryProne":98,"type":"wrestler","style":"comedy",