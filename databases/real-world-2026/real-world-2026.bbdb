ge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0}},{"id":862,"name":"Daichi Murayama","realName":"Daichi Murayama","picture":"Daichi Murayama.jpg","ability":91,"currentAbility":89,"potentialAbility":89,"charisma":100,"micSkills":85,"popularity":1,"condition":100,"hardcoreAbility":77,"injuryProne":87,"type":"referee","style":"all rounder","gender":"M","weight":66,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1964-03-20T00:00:00.000Z","debut":"1982-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Daichi Murayama is a veteran referee who has 22 years’ experience. He debuted in All-Japan, then worked freely in a variety of promotions before returning to All-Japan in January 2005. He has a reputation within the industry for helping to make advances in referee technology. Currently working for Mutoh's Wrestle-1 promotion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":61,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":27,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":27,"brandBuilding":12,"socialMediaSavvy":16,"ruleKnowledge":89,"positioning":71,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"contract":{"id":"tew-contract-862","wrestlerId":862,"promotionId":61,"startDate":"2010-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":863,"name":"Masahiro Chono","realName":"Masahiro Chono","picture":"Masahiro Chono.jpg","ability":99,"currentAbility":95,"potentialAbility":95,"charisma":96,"micSkills":95,"popularity":19,"condition":67,"hardcoreAbility":94,"injuryProne":99,"type":"writer","style":"all rounder","gender":"M","weight":96,"height":182,"base":"Japan","birthplace":"Japan","dateOfBirth":"1963-09-17T00:00:00.000Z","debut":"1984-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Masahiro Chono, is a Japanese professional wrestler. He primarily wrestled for New Japan Pro Wrestling (NJPW), but has also made appearances for the now defunct World Championship Wrestling, as a member of the New World Order. Chono, called Mister Black Jack when he first started as a villain, is one of the top villains in Japanese wrestling history. He is a former NWA World Champion and IWGP Heavyweight Champion. In January 2013, Chono signed with All Japan Pro Wrestling as an advisor.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2977,3056,3240],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":89,"storytelling":92,"productFit":100,"riskTaking":13,"matchLayout":93,"psychology":89,"workerManagement":100,"trainingIntensity":47,"technicalCoaching":54,"characterCoaching":86,"diagnosis":50,"rehabilitation":50,"prevention":87,"mediaHandling":86,"brandBuilding":73,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":47,"consistency":62,"awareness":89,"judgement":93}},{"id":864,"name":"Akira Nogami","realName":"Akira Nogami","picture":"AKIRA Nogami_alt.jpg","ability":75,"currentAbility":65,"potentialAbility":65,"charisma":76,"micSkills":55,"popularity":5,"condition":70,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":90,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1966-03-13T00:00:00.000Z","debut":"1984-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Akira Nogami is a Japanese professional wrestler and actor, currently working as AKIRA. He is signed to Wrestling New Classic (WNC), where he was the inaugural WNC Champion. After graduating from high school in 1984, Nogami was initiated into the New Japan dojo. He debuted in October of that year against Keiji Mutoh, making him one of the youngest wrestlers in New Japan history, at the age of 16. After leaving NJPW, Nogami found a new home in Yoshihiro Tajiri's Smash promotion, where he worked as a member of the Smash Seikigun until the promotion folded on March 14, 2012.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2792,3035,3058],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":74,"productFit":100,"riskTaking":34,"matchLayout":76,"psychology":68,"workerManagement":100,"trainingIntensity":60,"technicalCoaching":63,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":64,"brandBuilding":33,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":60,"consistency":62,"awareness":68,"judgement":81}},{"id":865,"name":"Angelina Love","realName":"Angelina Love","picture":"Angelina Love.jpg","ability":53,"currentAbility":47,"potentialAbility":47,"charisma":35,"micSkills":32,"popularity":17,"condition":77,"hardcoreAbility":45,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"F","weight":55,"height":165,"base":"Canada","birthplace":"Canada","dateOfBirth":"1981-09-13T00:00:00.000Z","debut":"2000-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Angelina Love is a Canadian wrestler who works in America, Canada, the British Isles and India. She is a Small worker who is classed as using a Regular style. She is best known for her work with IMPACT, NWA and ROH.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1383,2521,2644,3700,3701],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":61,"productFit":100,"riskTaking":26,"matchLayout":62,"psychology":57,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":36,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":77,"brandBuilding":63,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":78,"awareness":57,"judgement":74}},{"id":867,"name":"Bobby Lashley","realName":"Bobby Lashley","picture":"Bobby Lashley.jpg","ability":72,"currentAbility":67,"potentialAbility":67,"charisma":60,"micSkills":68,"popularity":53,"condition":77,"hardcoreAbility":77,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":124,"height":187,"base":"USA","birthplace":"United States","dateOfBirth":"1976-07-16T00:00:00.000Z","debut":"2004-11-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Looking for credentials? The dominant Bobby Lashley is a three-time wrestling national champion and a four-time wrestling All-American. He's also a two-time Armed Forces Champion and took home the silver medal in the 2002 CISM World Championships, competing against the best of the rest of the world's military. \r\n\r\nYet, for Lashley, all that was a precursor to training for WWE. First coming to the squared circle through WWE's ECW brand, Lashley fought his way to becoming one of the final ECW Champions. He then joined Raw, where he continued to make an impact that included a hard-hitting reign as United States Champion and a key role in the legendary \"Battle of the Billionaires\" at WrestleMania 23 where he took on Mr. McMahon's representative Umaga and was chiefly responsible for the WWE Chairman being shaved bald.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[4281],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":71,"productFit":100,"riskTaking":22,"matchLayout":72,"psychology":69,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":57,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":65,"brandBuilding":84,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":76,"awareness":69,"judgement":81},"contract":{"id":"tew-contract-867","wrestlerId":867,"promotionId":76,"startDate":"2024-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":869,"name":"Ivelisse Vélez","realName":"Ivelisse Vélez","picture":"Ivelisse Velez.jpg","ability":59,"currentAbility":60,"potentialAbility":60,"charisma":49,"micSkills":71,"popularity":7,"condition":77,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":52,"height":160,"base":"USA","birthplace":"Puerto Rico","dateOfBirth":"1988-09-21T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ivelisse Milagro Vélez is an American professional wrestler In 2011, she was a stand-out contestant on WWE Tough Enough, but was eliminated from the competition due to injury. Puerto Rico (2004-2011) Vélez began her wrestling career at the age of fifteen Puerto Rico. Soon after, she debuted in the World Wrestling Council, and subsequently wrestled in the International Wrestling Association. WWE signed her in November 2011 and Vélez adopted the ring name Sofia Cortez as she appeared in WWE's developmental territory Florida Championship Wrestling as well as WWE NXT. Vélez was released from the WWE in August 2012. On July 7th 2013, Ivelisse faced fellow Perros del Mal member Taya Valkyrie in a singles match.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":121,"teams":[3338],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":63,"productFit":100,"riskTaking":27,"matchLayout":65,"psychology":57,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":58,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":66,"brandBuilding":61,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":66,"awareness":57,"judgement":74},"contract":{"id":"tew-contract-869","wrestlerId":869,"promotionId":121,"startDate":"2012-11-16T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":871,"name":"Justin Credible","realName":"Justin Credible","picture":"Justin Credible.jpg","ability":48,"currentAbility":49,"potentialAbility":49,"charisma":36,"micSkills":39,"popularity":2,"condition":95,"hardcoreAbility":65,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":109,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1973-10-16T00:00:00.000Z","debut":"1992-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Peter Joseph Polaco is an American professional wrestler. Polaco traveled to Canada in order to train at the famous Hart Dungeon in Calgary, Alberta with Stu Hart, Keith Hart, and his future tag team partner, Lance Storm. He is best known for his appearances with the World Wrestling Federation under the ring name Aldo Montoya and with Extreme Championship Wrestling under the ring name Justin Credible. Has recently wrestled as \"Justin Time\" and PJ Polaco, as WWE owns the Justin Credible name. In WWF/E, he was a 8 time WWF/E Hardcore Champion. In ECW, he was a 1 time World Heavyweight Champion and a 2 time Tag Team Champion with Lance Storm.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[282],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":51,"storytelling":57,"productFit":100,"riskTaking":33,"matchLayout":59,"psychology":51,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":27,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":67,"brandBuilding":31,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":51,"awareness":51,"judgement":71}},{"id":872,"name":"Jody Fleisch","realName":"Jody Fleisch","picture":"Jody Fleisch.jpg","ability":61,"currentAbility":58,"potentialAbility":58,"charisma":71,"micSkills":60,"popularity":6,"condition":73,"hardcoreAbility":70,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":70,"height":175,"base":"UK","birthplace":"England","dateOfBirth":"1980-04-02T00:00:00.000Z","debut":"1996-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Jerome Fleisch, better known by his ring name Jody Fleisch, is a British professional wrestler. He is best known for his work with the Frontier Wrestling Alliance, One Pro Wrestling and Real Quality Wrestling. He is currently working for independent promotions all over the world. Fleisch studied Taekwondo, Ninjitsu and jujutsu for three years before joining wrestling. When Fleisch finally made his wrestling debut for NWA UK Hammerlock at the age of 16, he formed a tag team with Jonny Storm. Fleisch continued wrestling in the UK for many years as well as in the Netherlands and other countries.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[860,2605],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":65,"productFit":100,"riskTaking":22,"matchLayout":67,"psychology":58,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":57,"characterCoaching":45,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":45,"brandBuilding":47,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":74,"awareness":58,"judgement":75}},{"id":873,"name":"RYUKYU-DOG Dingo","realName":"RYUKYU-DOG Dingo","picture":"Brian Cannon.jpg","ability":58,"currentAbility":53,"potentialAbility":53,"charisma":53,"micSkills":45,"popularity":4,"condition":79,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":75,"height":165,"base":"Australia","birthplace":"Australia","dateOfBirth":"1976-05-24T00:00:00.000Z","debut":"1995-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Brian Cannon is an Australian professional wrestler. He is probably most well known for his portrayal of Kijimuna, a mischievous character who has worked for Okinawa Pro where he was a former MWF World Tag Team Champion, among other Japanese promotions. He has also been active in Mexico and is the former tag team partner of Jushin Thunder Lyger.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1666],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":60,"productFit":100,"riskTaking":18,"matchLayout":62,"psycho