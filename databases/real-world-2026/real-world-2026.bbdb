":false,"story":"Josh Prohibition is an American professional wrestler who currently works on the independent scene. He formed a top indy tag team with Matt Cross (M-Dogg 20) who went by the tag name Youthanazia and Burning River Brigade, winning the XPW Tag Team Titles on 2 seperate occasions. He has wrestled for a number of promotions throughout his career including CZW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[473,1580,2881],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":58,"productFit":63,"riskTaking":42,"matchLayout":60,"psychology":54,"workerManagement":63,"trainingIntensity":67,"technicalCoaching":37,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":58,"mediaHandling":64,"brandBuilding":44,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":13,"reactionSpeed":67,"consistency":64,"awareness":54,"judgement":58}},{"id":1625,"name":"Super Caló","realName":"Super Caló","picture":"Super Calo.jpg","ability":50,"currentAbility":53,"potentialAbility":53,"charisma":41,"micSkills":57,"popularity":4,"condition":63,"hardcoreAbility":72,"injuryProne":95,"type":"wrestler","style":"high flyer","gender":"M","weight":87,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1971-02-22T00:00:00.000Z","debut":"1990-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Rafael García is a Mexican professional wrestler, better known under his ring name Super Caló. García is a long-time mainstay of Asistencia Asesoría y Administración (AAA), but is perhaps best known outside of Mexico for his stint in World Championship Wrestling (WCW) during the 1990s. García has two brothers name Alan and Chris Stone, who also wrestle in different promotions.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":63,"productFit":100,"riskTaking":30,"matchLayout":65,"psychology":57,"workerManagement":100,"trainingIntensity":52,"technicalCoaching":42,"characterCoaching":49,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":49,"brandBuilding":49,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":52,"consistency":58,"awareness":57,"judgement":74}},{"id":1627,"name":"Karlee Perez","realName":"Karlee Perez","picture":"Karlee Perez.jpg","ability":55,"currentAbility":58,"potentialAbility":58,"charisma":70,"micSkills":65,"popularity":11,"condition":94,"hardcoreAbility":57,"injuryProne":93,"type":"manager","style":"all rounder","gender":"F","weight":54,"height":160,"base":"USA","birthplace":"United States","dateOfBirth":"1986-04-19T00:00:00.000Z","debut":"2009-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Karlee Perez s an American model, professional wrestler, and valet. She is best known for her time with WWE under the ring name Maxine. Perez started her career as a model and professional wrestling in 2009, where Perez signed a developmental contract with World Wrestling Entertainment, and was assigned to Florida Championship Wrestling (FCW), WWE's developmental territory, where she later served as the general manager of the promotion. In September 2010, she competed in the third season of NXT, but was the second rookie diva eliminated.  In August 2011, she made her return on NXT Redemption as Derrick Bateman's girlfriend. She then left WWE in June 2012. In September 2014, Perez confirmed on her Twitter that she had signed with El Rey Network's new show Lucha Underground, that began airing on October 29. She made her debut under the ring name Catrina, working as the manager of Mil Muertes.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":48,"productFit":23,"riskTaking":36,"matchLayout":49,"psychology":44,"workerManagement":23,"trainingIntensity":62,"technicalCoaching":37,"characterCoaching":74,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":74,"brandBuilding":73,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":5,"reactionSpeed":62,"consistency":45,"awareness":44,"judgement":36}},{"id":1628,"name":"Luis Fernandez-Gil","realName":"Luis Fernandez-Gil","picture":"Dario Cueto.jpg","ability":68,"currentAbility":66,"potentialAbility":66,"charisma":73,"micSkills":60,"popularity":18,"condition":100,"hardcoreAbility":82,"injuryProne":100,"type":"manager","style":"all rounder","gender":"M","weight":73,"height":162,"base":"Europe","birthplace":"Spain","dateOfBirth":"1974-11-06T00:00:00.000Z","debut":"2014-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Luis Fernandez-Gil is a Spanish man who works primarily as an on-screen personality. He is married to someone outside the wrestling business. Outside of wrestling he is a regular TV actor. He is best known for his work in MLW and Lucha Underground.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":68,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":24,"technicalCoaching":0,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":82,"brandBuilding":56,"socialMediaSavvy":85,"ruleKnowledge":0,"positioning":0,"reactionSpeed":24,"consistency":0,"awareness