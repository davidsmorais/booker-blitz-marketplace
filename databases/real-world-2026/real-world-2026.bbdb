":"1987-04-22T00:00:00.000Z","debut":"2010-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Yusuke Kodama was trained by TAJIRI and was set to debut in Hustle in September 2009; unfortunately, HUSTLE was forced to cancel all the upcoming shows due to economic issues, so Kodama followed TAJIRI to the newborn Smash. Kodama made his professional wrestling debut on April 23, 2010, at SMASH 2, against Hajime Ohara and lost. As is customary for most professional wrestlers, Kodama spent most of his matches losing to other, more experienced wrestlers, which would help put over other wrestlers while at the same time give Kodama some in-ring, televised, experience. Kodama made his Wrestle-1 debut on June 27, 2014, defeating Hiroki Murase in a singles match.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":96,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":75,"riskTaking":27,"matchLayout":68,"psychology":62,"workerManagement":75,"trainingIntensity":74,"technicalCoaching":64,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":65,"brandBuilding":41,"socialMediaSavvy":52,"ruleKnowledge":0,"positioning":15,"reactionSpeed":74,"consistency":77,"awareness":62,"judgement":67},"contract":{"id":"tew-contract-2381","wrestlerId":2381,"promotionId":96,"startDate":"2023-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":2383,"name":"Isla Dawn","realName":"Isla Dawn","picture":"Isla Dawn.jpg","ability":45,"currentAbility":53,"potentialAbility":53,"charisma":65,"micSkills":58,"popularity":28,"condition":93,"hardcoreAbility":66,"injuryProne":93,"typ