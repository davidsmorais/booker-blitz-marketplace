m Olive Branch, Mississippi, Marko hopes to usher in a new era of mid south wrestler. Fearless and full of heart, Marko Stunt is a spectacular underdog at just 144 pounds.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":77,"teams":[1945,1946],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":42,"storytelling":48,"productFit":22,"riskTaking":38,"matchLayout":50,"psychology":42,"workerManagement":22,"trainingIntensity":69,"technicalCoaching":46,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":69,"brandBuilding":32,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":4,"reactionSpeed":69,"consistency":64,"awareness":42,"judgement":34},"contract":{"id":"tew-contract-3098","wrestlerId":3098,"promotionId":77,"startDate":"2026-07-01T00:00:00.000Z","endDate":"2028-07-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-07-01T00:00:00.000Z","wage":1000},{"id":3101,"name":"Sae Nomura","realName":"Sae Nomura","picture":"Sae.jpg","ability":49,"currentAbility":42,"potentialAbility":42,"charisma":42,"micSkills":43,"popularity":1,"condition":100,"hardcoreAbility":32,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":70,"height":165,"base":"Japan","birthplace":"Japan","dateOfBirth":"1995-08-21T00:00:00.000Z","debut":"2017-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Sae Nomura is a Japanese wrestler who works exclusively in Japan. She is a Very Small worker who is classed as using a Technician Flyer style. She is best known for her work with SEAdLINNNG and OZ Academy.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":43,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":40,"storytelling":45,"productFit":18,"riskTaking":34,"matchLayout":47,"psychology":40,"workerManagement":18,"trainingIntensity":76,"technicalCoaching":43,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":53,"brandBuilding":61,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":4,"reactionSpeed":76,"consistency":57,"awareness":40,"judgement":31},"contract":{"id":"tew-contract-3101","wrestlerId":3101,"promotionId":43,"startDate":"2025-04-01T00:00:00.000Z","endDate":"2027-04-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-04-01T00:00:00.000Z","wage":1000},{"id":3102,"name":"Aramis","realName":"Aramis","picture":"Aramis.jpg","ability":53,"currentAbility":50,"potentialAbility":50,"charisma":36,"micSkills":41,"popularity":20,"condition":95,"hardcoreAbility":61,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1998-11-29T00:00:00.000Z","debut":"2010-05-16T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"The masked mach-speed luchador Aramis is a once in a generation luchador.\r\n\r\nA fearless fighter for righteous causes, Aramis has become one of Mexico’s most talked about luchadores, due in part to his cutting-edge arsenal of aerial moves, reversals, and strikes. But don’t overlook Aramis’ tenacity for never giving up, often overcoming much bigger competitors to triumph as thousands of fans chant his name in sold out arenas in Mexico.\r\n\r\nAAA co-founder Konnan, who discovered the likes or Rey Mysterio Jr., the Lucha Bros., Psicosis and countless others, has flagged Aramis as the next breakout luchador in the sport.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[231