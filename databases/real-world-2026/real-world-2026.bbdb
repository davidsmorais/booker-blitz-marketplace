 an American wrestler. She is a Lightweight who is classed as using a Brawler style. Having trained at KYDApro Wrestling school under trainers such as John Kerman, C.A. Elliott, Christian York and Xander maddoX, Nyla Rose uses her vast Martial arts knowledge coupled with an aggressive, In your face style, to shock and Awe audiences. Be warned, this woman isn't afraid to take to the sky every now and again!","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[3565],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":61,"productFit":74,"riskTaking":46,"matchLayout":63,"psychology":57,"workerManagement":74,"trainingIntensity":66,"technicalCoaching":37,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":54,"mediaHandling":62,"brandBuilding":58,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":15,"reactionSpeed":66,"consistency":71,"awareness":57,"judgement":64},"contract":{"id":"tew-contract-3045","wrestlerId":3045,"promotionId":49,"startDate":"2023-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000,"inDevelopment":true},{"id":3046,"name":"Royce Isaacs","realName":"Royce Isaacs","picture":"Royce Isaacs.jpg","ability":59,"currentAbility":59,"potentialAbility":59,"charisma":49,"micSkills":65,"popularity":5,"condition":97,"hardcoreAbility":65,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":110,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1989-02-08T00:00:00.000Z","debut":"2016-04-10T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Royce Isaacs is an American wrestler who works in the USA and Japan. He is a 6'1\", 242lb worke