uleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":71,"awareness":72,"judgement":83},"contract":{"id":"tew-contract-408","wrestlerId":408,"promotionId":3,"startDate":"2024-03-10T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":409,"name":"Daisuke Kamihayashi","realName":"Daisuke Kamihayashi","picture":"Daisuke Kamihayashi.jpg","ability":49,"currentAbility":53,"potentialAbility":53,"charisma":41,"micSkills":50,"popularity":1,"condition":100,"hardcoreAbility":64,"injuryProne":100,"type":"referee","style":"all rounder","gender":"M","weight":62,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1979-11-10T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Daisuke Kamihayashi is the 4th & newest referee in All-Japan. Originally from Yokohama, he joined the promotion after graduating from college as a member of the sales division. After that, he began working towards becoming a referee by moving to the entertainment division of the promotion and became part of the ring staff. He participated in gymnastics in high school and is considered to be a “smart” referee. Kamihayashi made his referee debut on October 19, 2010 as the referee for a Hiroshi Yamato vs. Manabu Soya match.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":23,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":23,"brandBuilding":11,"socialMediaSavvy":12,"r