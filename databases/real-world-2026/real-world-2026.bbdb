e":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Javier Cortes Sánchez  is a Mexican Luchador, or professional wrestler who works for Consejo Mundial de Lucha Libre (CMLL) in their Mini-Estrella division. Cortés is better known under the ring name Shockercito, a mascota version of wrestler Shocker. Cortés was originally an enmascarado, (masked) character, but was forced to unmask after losing a Lucha de Apuesta, or bet match, on January 11, 2009. Working in the Mini division does not necessarily mean that Cortés has dwarfism as several short wrestlers work in the \"Mini\" division, which is what separates the Mexican Mini-Estrella from traditional Midget professional wrestling as practiced in the United States among other places.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":58,"productFit":100,"riskTaking":36,"matchLayout":60,"psychology":54,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":57,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":51,"brandBuilding":23,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":53,"awareness":54,"judgement":72},"contract":{"id":"tew-contract-1921","wrestlerId":1921,"promotionId":11,"startDate":"2002-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1922,"name":"Pierrothito","realName":"Pierrothito","picture":"Pierrothito.jpg","ability":59,"currentAbility":58,"potentialAbility":58,"charisma":45,"micSkills":57,"popularity":4,"condition":67,"hardcoreAbility":39,"injuryProne":100,"type":"wrestler","style":"high flyer","g