","realName":"Dump Matsumoto","picture":"Dump Matsumoto.jpg","ability":66,"currentAbility":57,"potentialAbility":57,"charisma":62,"micSkills":45,"popularity":5,"condition":68,"hardcoreAbility":39,"injuryProne":69,"type":"wrestler","style":"striker","gender":"F","weight":100,"height":160,"base":"Japan","birthplace":"Japan","dateOfBirth":"1960-11-11T00:00:00.000Z","debut":"1988-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kaoru Matsumoto  is a semi-retired Japanese professional wrestler, known by her ringname Dump Matsumoto, who competed in All Japan Women's Pro-Wrestling as one of the leading female wrestlers during the 1980s. The longtime leader of the stable Gokuaku Domei—which included Crane Yu, Condor Saito and Bull Nakano—she was one of the main rivals of the popular tag team Crush Gals. Their long running feud would become extremely popular in Japan during the 1980s, with their televised matches resulting in some of the highest rated in Japanese television as well as the promotion regularly selling out arenas.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3372,3373],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":77,"storytelling":79,"productFit":100,"riskTaking":30,"matchLayout":80,"psychology":77,"workerManagement":100,"trainingIntensity":46,"technicalCoaching":47,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":77,"brandBuilding":58,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":46,"consistency":56,"awareness":77,"judgement":86}},{"id":1768,"name":"Goya Kong","realName":"Goya Kong","picture":"Goya Kong.jpg","ability":40,"currentAbility":46,"potentialAbility":46,"charisma":39,"micSkills":38,"popularity":3,"condition":84,"hardcoreAbility":57,"injuryProne":100,"type":"wrestle