w":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1774,"name":"Rina Yamashita","realName":"Rina Yamashita","picture":"Rina Yamashita.jpg","ability":68,"currentAbility":64,"potentialAbility":64,"charisma":70,"micSkills":72,"popularity":13,"condition":83,"hardcoreAbility":61,"injuryProne":100,"type":"wrestler","style":"hardcore","gender":"F","weight":70,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1989-03-12T00:00:00.000Z","debut":"2013-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Beginning her career in Pro Wrestling WAVE, \"The Broken Dumptruck\" Rina Yamashita has gone on to become something of a young veteran in the joshi scene. Known for her trademark dreadlocks and love of violent deathmatches, she has even wrestled for men's promotions like AJPW, NOAH and FREEDOMS.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":73,"teams":[1794,1795,4378],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":36,"matchLayout":71,"psychology":68,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":55,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":79,"brandBuilding":69,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":83,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-1774","wrestlerId":1774,"promotionId":73,"startDate":"2015-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1775,"name":"Yumiko Hotta","realName":"Yumiko Hotta","picture":"Yumiko Hotta.jpg","ability":61,"currentAbility":58,"potentialAbility":58,"charisma":48,"micSkills":57,"popularity":3,"condition":67,"hardcoreAbility":75,"injuryProne":100,"type":"wrestler","style":"submission","gender":"F","weight":69,"height":165,"base":"Japan","birthplace":"Japan","dateOfBirth":"1967-01-10T00:00:00.000Z","debut":"1985-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Yumiko Hotta is a Japanese professional wrestler and mixed martial artist. Hotta was trained by and started her career in the All Japan Women's Pro-Wrestling (AJW) promotion in June 1985. She worked for the promotion until 2003, becoming a three-time WWWA World and WWWA World Tag Team Champion. In June 2003, Hotta took over the Hyper Visual Fighting Arsion promotion and renamed it Major Girl's Fighting AtoZ. Under Hotta's leadership, the promotion lasted only three years, before folding in 2006, after which Hotta became a freelancer. In January 2011, Hotta joined the new Universal Woman's Pro Wrestling Reina promotion, but just sixteen months later she announced that the promotion was folding. Afterwards, she affiliated herself with the World Woman Pro-Wrestling Diana promotion, becoming the leader of the villainous Bousou-gun stable.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":73,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":70,"productFit":100,"riskTaking":49,"matchLayout":72,"psychology":62,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":62,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":51,"mediaHandling":69,"brandBuilding":40,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":42,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-1775","wrestlerId":1775,"promotionId":73,"startDate":"2021-04-01T00:00:00.000Z","endDate":"2026-03-31T23: