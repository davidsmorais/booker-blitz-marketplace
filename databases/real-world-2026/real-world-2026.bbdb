ight Raw debut as Kevin Patrick. He quickly became a fixture every Monday night, not only on Raw, but as the regular co-host of Raw Talk, often times paired with on-again, off-again 24/7 Champion R-Truth.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":52,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":52,"brandBuilding":34,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0}},{"id":4293,"name":"Sudu Upadhyay","realName":"Sudu Upadhyay","picture":"Sudu Shah.jpg","ability":56,"currentAbility":49,"potentialAbility":49,"charisma":49,"micSkills":37,"popularity":3,"condition":100,"hardcoreAbility":53,"injuryProne":0,"type":"commentator","style":"all rounder","gender":"M","weight":68,"height":162,"base":"USA","birthplace":"United States","dateOfBirth":"1992-01-04T00:00:00.000Z","debut":"2022-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Sudu Upadhyay is an American man who works primarily as an announcer. He is best known for his work with NXT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":2,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":2,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":65,"brandBuilding":54,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":0,