is one half of Enfants Terribles alongside Shotaro Ashino. He is best known for his work with AJPW and WRESTLE-1.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[2100],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":66,"productFit":100,"riskTaking":29,"matchLayout":67,"psychology":62,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":52,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":62,"brandBuilding":41,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":84,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-2440","wrestlerId":2440,"promotionId":3,"startDate":"2020-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":2441,"name":"Tank Nagai","realName":"Tank Nagai","picture":"Tank Nagai.jpg","ability":45,"currentAbility":46,"potentialAbility":46,"charisma":51,"micSkills":49,"popularity":2,"condition":100,"hardcoreAbility":43,"injuryProne":100,"type":"manager","style":"striker","gender":"M","weight":100,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1984-04-28T00:00:00.000Z","debut":"2012-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Tank Nagai is a retired Japanese wrestler who works as an on-screen personality and a road agent. He is best known for his work with AJPW. He is married to Mio Shirai.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1214],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":75,"riskTa