 Page","picture":"Rickey Shane Page.jpg","ability":58,"currentAbility":52,"potentialAbility":52,"charisma":49,"micSkills":45,"popularity":12,"condition":71,"hardcoreAbility":64,"injuryProne":100,"type":"wrestler","style":"hardcore","gender":"M","weight":128,"height":193,"base":"USA","birthplace":"United States","dateOfBirth":"1984-03-01T00:00:00.000Z","debut":"2002-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Rickey Shane Page is an American wrestler who works in the USA, Canada, the British Isles and Japan. He is a 6'5\", 282lb worker who is classed as using a Hardcore style. He uses the Powerbomb as his finisher. He is one half of Faith In Nothing alongside Vincent Nothing. He is best known for his work with DDT, RevPro, BJW, GCW, Beyond, REVOLVER, PROGRESS, AAW, FCP, AIW, ATTACK!, IWA-MS, A1 and CZW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":92,"teams":[1051,2570,2571,2860,3806],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":51,"storytelling":55,"productFit":100,"riskTaking":39,"matchLayout":56,"psychology":51,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":33,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":67,"brandBuilding":42,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":76,"awareness":51,"judgement":71},"contract":{"id":"tew-contract-1646","wrestlerId":1646,"promotionId":92,"startDate":"2025-03-01T00:00:00.000Z","endDate":"2027-03-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-03-01T00:00:00.000Z","wage":1000},{"id":1649,"name":"Tracy Smothers","realName":"Tracy Smothers","picture":"Tracy Smothers.jpg","ability":70,"currentAbility":60,"potentialAbility":60,