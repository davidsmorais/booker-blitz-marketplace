ee","style":"all rounder","gender":"M","weight":76,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1967-02-16T00:00:00.000Z","debut":"1988-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Red Shoes Unno is a veteran referee who currently works for New Japan. His name came about because he wears red shoes when working. He has been a referee for over 20 years and has worked in a variety of promotions. Unno will celebrate his 25th anniversary in puroresu in 2010. He started out in All-Japan in 1985 working with the ring crew and at merchandise tables before becoming a referee.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":18,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":18,"brandBuilding":15,"socialMediaSavvy":10,"ruleKnowledge":85,"positioning":68,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"contract":{"id":"tew-contract-342","wrestlerId":342,"promotionId":38,"startDate":"2001-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":343,"name":"Takaaki Kidani","realName":"Takaaki Kidani","picture":"Takaaki Kidani.jpg","ability":8,"currentAbility":0,"potentialAbility":0,"charisma":7,"micSkills":0,"popularity":0,"condition":100,"hardcoreAbility":0,"injuryProne":0,"type":"writer","style":"all rounder","gender":"M","weight":75,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1960-06-06T00:00:00.000Z","debut":"2012-01-01T00:00:00.000Z","morale"