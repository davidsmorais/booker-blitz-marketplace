ng.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[1777],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":64,"storytelling":68,"productFit":100,"riskTaking":23,"matchLayout":69,"psychology":64,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":48,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":62,"brandBuilding":47,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":74,"awareness":64,"judgement":78},"contract":{"id":"tew-contract-2573","wrestlerId":2573,"promotionId":49,"startDate":"2023-06-16T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000,"inDevelopment":true},{"id":2574,"name":"Sangre Imperial","realName":"Sangre Imperial","picture":"Sangre Imperial.jpg","ability":46,"currentAbility":50,"potentialAbility":50,"charisma":40,"micSkills":47,"popularity":3,"condition":91,"hardcoreAbility":46,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":85,"height":175,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1993-12-24T00:00:00.000Z","debut":"2011-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Sangre Imperial is an independent wrestler around Mexico City. Took the Súper Ciudadano gimmick on June 15, 2013, wrestling his debut match against El Patán for Toryumon during the DragonMania VIII event. Patan and Ciudadano have since faced off just about every Toryumon Mexico show; both characters only appear on those shows. Súper Ciudadano is a wrestler who represents the Consejo Ciudadano de Seguridad Pública y Procuración de Justicia del Distrito Federal (Distrito Federal's Citizens Co