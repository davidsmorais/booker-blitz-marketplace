 The Year two times.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":69,"productFit":100,"riskTaking":38,"matchLayout":70,"psychology":65,"workerManagement":100,"trainingIntensity":40,"technicalCoaching":40,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":64,"brandBuilding":31,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":40,"consistency":71,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-651","wrestlerId":651,"promotionId":76,"startDate":"2019-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":652,"name":"Cheerleader Melissa","realName":"Cheerleader Melissa","picture":"Cheerleader Melissa.jpg","ability":64,"currentAbility":70,"potentialAbility":70,"charisma":61,"micSkills":58,"popularity":9,"condition":74,"hardcoreAbility":66,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":64,"height":170,"base":"USA","birthplace":"United States","dateOfBirth":"1982-08-17T00:00:00.000Z","debut":"1999-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Cheerleader Melissa is an American wrestler who works in America, Canada, the British Isles, Japan, Europe, Oceania and India. She is a Small worker who is classed as using a Technician style. She is best known for her work with AAA, IMPACT, Stardom, Lucha Ungrnd and SHIMMER. She is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":76,"storytelling":78,"productFit":100,"riskTaking":16,"matchLayout":79,"psychology":76,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":69,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":63,"brandBuilding":56,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":90,"awareness":76,"judgement":86}},{"id":653,"name":"Awesome Kong","realName":"Awesome Kong","picture":"Amazing Kong.jpg","ability":64,"currentAbility":57,"potentialAbility":57,"charisma":56,"micSkills":59,"popularity":31,"condition":46,"hardcoreAbility":68,"injuryProne":93,"type":"wrestler","style":"all rounder","gender":"F","weight":124,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1977-09-04T00:00:00.000Z","debut":"2002-10-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Kia Stevensbetter known by her ring names Amazing Kong, Awesome Kong and Kharma, is an American professional wrestler. She is best known for her time at WWE and TNA as Kharma and Awesome Kong respectively. She is a five-time Women's Champion, having won the WWWA World Championship, NWA World Women's Championship and AWA Superstars of Wrestling World Women's Championship and a two-time TNA Knockout Champion. Her success is not limited to singles wrestling, as she frequently teamed with Aja Kong to form the tag team Double Kong who held tag team championships in four different promotions, along with winning the TNA Knockouts Tag Team Championship with Hamada. She was also ranked first in the inaugural list of Pro Wrestling Illustrated's Top 50 Females.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2985,2986,3000],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":73,"productFit":100,"riskTaking":25,"matchLayout":74,"psychology":70,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":31,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":63,"brandBuilding":70,"socialMediaSavvy":71,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":59,"awareness":70,"judgement":82}},{"id":654,"name":"Ayako Hamada","realName":"Ayako Hamada","picture":"Ayako Hamada.jpg","ability":77,"currentAbility":69,"potentialAbility":69,"charisma":83,"micSkills":83,"popularity":13,"condition":71,"hardcoreAbility":86,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":61,"height":160,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1981-02-14T00:00:00.000Z","debut":"1998-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ayako Valentina Hamada Villareal is a female professional wrestler of mixed Japanese and Mexican descent, currently wrestling in the United States. She is best known for winning several notable titles in Japanese women's pro wrestling, including both the WWWA World Heavyweight Championship and AAAW Singles Championship in the early 2000s. She is a second generation wrestler, as her father is Gran Hamada. Her older sister Xóchitl Hamada is also a professional wrestler. Ayako Hamada, who was born and raised in Mexico, debuted at the age of seventeen against Candy Okutsu on August 9, 1998 for the Japanese Arsion promotion. On April 8, 2009, it was announced at a press conference that the April 19 Ito Dojo show would be Hamada's final match in Japan as she had signed with Total Nonstop Action Wrestling. On November 8, 2009, Hamada made her debut under her full name for Chicago based all female wrestling promotion Shimmer Women Athletes.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3000,3001],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":77,"storytelling":80,"productFit":100,"riskTaking":20,"matchLayout":81,"psychology":77,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":76,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":66,"brandBuilding":52,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":73,"awareness":77,"judgement":86}},{"id":655,"name":"Kana","realName":"Kana","picture":"Kana.jpg","ability":66,"currentAbility":72,"potentialAbility":72,"charisma":82,"micSkills":68,"popularity":56,"condition":78,"hardcoreAbility":85,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"F","weight":62,"height":157,"base":"Japan","birthplace":"Japan","dateOfBirth":"1981-09-26T00:00:00.000Z","debut":"2004-06-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Nobody is ready for Asuka. And The Empress of Tomorrow proved that by not being pinned or submitted from her debut in NXT in October 2015 until WrestleMania 34 in April 2018.\r\n\r\nMarching to the ring in a traditional noh mask and kaleidoscopic battle gear and looking every bit the victor before the opening bell even rings, Asuka has used her perfect technique and wicked intentions to take down everybody from Becky Lynch to Bayley (whom Asuka unseated as NXT Women’s Champion). All the while, the fierce Japanese Superstar has worn an intimidating smile on her face, seemingly finding joy in stretching out her overmatched opponents. She even displayed an ability to work well with others, melding with The Miz to win the first season of WWE's Mixed Match Challenge.\r\n\r\nHer undefeated streak came to an end at the hands of Charlotte Flair at WrestleMania 34, but Asuka persevered and finally captured the SmackDown Women’s Title at WWE TLC after defeating Flair and Becky Lynch.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[1128,1891,2760,3632],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":82,"productFit":100,"riskTaking":33,"matchLayout":84,"psychology":78,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":74,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":85,"brandBuilding":80,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":86,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-655","wrestlerId":655,"promotionId":64,"startDate":"2015-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":656,"name":"Madison Eagles","realName":"Madison Eagles","picture":"Madison Eagles.jpg","ability":88,"currentAbility":90,"potentialAbility":90,"charisma":81,"micSkills":90,"popularity":5,"condition":71,"hardcoreAbility":78,"injuryProne":100,"type":"writer","style":"technical","gender":"F","weight":70,"height":182,"base":"Australia","birthplace":"Australia","dateOfBirth":"1984-06-04T00:00:00.000Z","debut":"2001-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Madison Eagles is a retired Australian wrestler who works primarily as a road agent. She was one half of Green Nation alongside Mick Moretti. She is best known for her work with PWA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":83,"teams":[773,1276,2090],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":82,"productFit":100,"riskTaking":19,"matchLayout":82,"psychology":80,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":77,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":68,"brandBuilding":60,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":87,"awareness":80,"judgement":88},"contract":{"id":"tew-contract-656","wrestlerId":656,"promotionId":83,"startDate":"2008-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":657,"name":"Mercedes Martinez","realName":"Mercedes Martinez","picture":"Mercedes Martinez.jpg","ability":63,"currentAbility":71,"potentialAbility":71,"charisma":83,"micSkills":58,"popularity":24,"condition":87,"hardcoreAbility":88,"injuryProne":100,"type":"wrestler","style":"submission","gender":"F","weight":67,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1980-11-17T00:00:00.000Z","debut":"2000-11-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Like the automobile she shares a name with, Mercedes Martinez is known the world over as one of the very best. A grim-faced brawler with distinctive sleeves of tattoos, Martinez has been a fixture in the industry since 2004, serving as both the foundation and centerpieces of various women’s divisions across several independent promotions.\r\n\r\nMartinez first appeared on WWE fans’ radar as an entrant in the 2017 and 2018 Mae Young Classic tournaments, where she squared up against the likes of Shayna Baszler, Princesa Sugehit and Meiko Satomura. With towns and accomplishments beyond counting under her belt, Martinez has built the kind of career that is the envy and respect of anyone who wishes to call themselves a professional wrestler, and that’s before she got to NXT. Imagine what she’ll do now 