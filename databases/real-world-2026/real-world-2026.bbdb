ad":false,"story":"Guillermo Martinez Cid is a Mexican luchador, or professional wrestler known under a variety of ring names, primarily Bombero Infernal. He was the first person to wrestle under the name AK-47 but was Later replaced, he also worked as Matrix, Kraneo, Capitán Muerte and Temerario Infernal. He is a freelance wrestler on the Mexican independent circuit and has worked on a regular basis for International Wrestling Revolution Group (IWRG) over the years. His son is currently wrestling as Matrix, Jr.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":73,"productFit":100,"riskTaking":26,"matchLayout":74,"psychology":69,"workerManagement":100,"trainingIntensity":60,"technicalCoaching":52,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":73,"brandBuilding":30,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":60,"consistency":58,"awareness":69,"judgement":81}},{"id":1513,"name":"Keita Yano","realName":"Keita Yano","picture":"Keita Yano.jpg","ability":59,"currentAbility":64,"potentialAbility":64,"charisma":49,"micSkills":52,"popularity":2,"condition":88,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":72,"height":180,"base":"Japan","birthplace":"Japan","dateOfBirth":"1988-01-09T00:00:00.000Z","debut":"2007-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Keita Yano is a Japanese professional wrestler, currently working for Pro Wrestling Wallabee. He started his career with Battlarts in February 2007 and remained with the promotion for four years, winning the B-Rule Tournament in 2009. During the years, Yano also represented Battlarts in major Japanese promotions such as New Japan Pro Wrestling and Pro Wrestling Zero1 and American promotion Chikara, where he took part in the Young Lions Cup VIII tournament in August 2010. After the folding of Battlarts, Yano began working for Dramatic Dream Team (DDT), where, as a representative of the Crying Wolf stable, he became a one-time Ironman Heavymetalweight Champion, before parting ways with the promotion in July 2012.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":65,"productFit":100,"riskTaking":27,"matchLayout":68,"psychology":57,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":80,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":68,"brandBuilding":38,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":69,"awareness":57,"judgement":74}},{"id":1514,"name":"Daemon Ueda","realName":"Daemon Ueda","picture":"Daemon Ueda.jpg","ability":47,"currentAbility":53,"potentialAbility":53,"charisma":51,"micSkills":42,"popularity":2,"condition":88,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":105,"height":180,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-07-30T00:00:00.000Z","debut":"2007-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Naomiki Ueda is a Japanese professional wrestler, better known by his ring names Daemon Ueda, Shito Ueda and Naoki Ueda. He primarily works for the Pro Wrestling Zero-1 promotion, where he began his career, however he has made appearances elsewhere including NJPW & BJPW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],