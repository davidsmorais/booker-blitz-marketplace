ale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Yasufumi Nakanoue is a Japanese professional wrestler known for his work with AJPW. Yasufumi Nakanoue is a 2nd-year pro who is one of the newest members of All-Japan. He made his debut on January 2, 2010 against Shuji Kondo. He has mainly been used as a jobber, of course, but he did pick up his first career win on June 22 by beating Rene Dupree. He has been stuck in the jobber role thanks in large part to other young wrestlers missing major time due to injuries.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":7,"teams":[1830],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":62,"productFit":87,"riskTaking":28,"matchLayout":63,"psychology":57,"workerManagement":87,"trainingIntensity":75,"technicalCoaching":53,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":44,"brandBuilding":46,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":17,"reactionSpeed":75,"consistency":76,"awareness":57,"judgement":69},"contract":{"id":"tew-contract-412","wrestlerId":412,"promotionId":7,"startDate":"2017-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":414,"name":"Nobuo Shiraishi","realName":"Nobuo Shiraishi","picture":"Nobuo Shiraishi.jpg","ability":0,"currentAbility":0,"potentialAbility":0,"charisma":3,"micSkills":2,"popularity":0,"condition":100,"hardcoreAbility":10,"injuryProne":0,"type":"writer","style":"all rounder","gender":"M","weight":73,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-05-16T00:00:00.000Z","debut":"2013-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"On May 1, it was reported that negotiations had started between Speed Partners president Nobuo Shiraishi and All Japan president Masayuki Uchida, which would see Keiji Mutoh regain the promotion's presidency before the end of the month. However, on May 27, it was reported that Shiraishi himself would take over the presidency of All Japan effective June 1. This was later confirmed by All Japan, and led to Keiji Mutoh's resignation from the promotion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":29,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":29,"brandBuilding":0,"socialMediaSavvy":0,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0}},{"id":415,"name":"Aero Star","realName":"Aero Star","picture":"Aerostar.jpg","ability":48,"currentAbility":57,"potentialAbility":57,"charisma":67,"micSkills":57,"popularity":10,"condition":76,"hardcoreAbility":44,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":69,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1984-10-22T00:00:00.000Z","debut":"2003-08-15T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Aero Star is a Mexican Luchador enmascarado, or masked professional wrestler, best known for his work in the professional wrestling promotion Asistencia Asesoría y Administración (AAA) as a tecnico. He is a part of the group Real Fuerza Aérea along with Laredo Kid and Argenis. Aerostar won the 2008 Alas de Oro tournament and is known for his high risk moves off the top rope or off the arena's lighing structure. In July 2011, Aero Star and Jack Evans traveled to Japan to represent AAA in Pro Wrestling Noah's 2011 Nippon TV Cup Jr. Heavyweight Tag League. After two wins and two losses, the team finished third in their block, missing the finals of the tournament.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[1757,2523,2524],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":66,"storytelling":70,"productFit":100,"riskTaking":40,"matchLayout":72,"psychology":66,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":63,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":60,"brandBuilding":62,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":55,"awareness":66,"judgement":80},"contract":{"id":"tew-contract-415","wrestlerId":415,"promotionId":5,"startDate":"2003-08-15T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":418,"name":"Raptor","realName":"Raptor","picture":"Raptor.jpg","ability":50,"currentAbility":49,"potentialAbility":49,"charisma":39,"micSkills":46,"popularity":2,"condition":88,"hardcoreAbility":47,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":75,"height":162,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1991-09-11T00:00:00.000Z","debut":"2003-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Made his debut for AAA in 2006 as Mini Dizzy and began appearing on televised events in 2007. It really didn't make sense to have a mini version of a wrestler not on the roster so he was given the name Atomic Boy before competing in the tournament for the AAA World Minis Championship. Seemed just used as an extra body for the tournament as he hadn't made TV since and his appearances seem to be limited to AAA shows in very small towns. Brought back to TV in June 2009 as a tecnico in the regular size division. Usually stuck in openers or off TV entirely. After a long absence, he made his return to AAA television in 2011.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":42,"storytelling":52,"productFit":100,"riskTaking":44,"matchLayout":56,"psychology":42,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":53,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":53,"brandBuilding":20,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":64,"awareness":42,"judgement":65}},{"id":420,"name":"Blue Demon Jr.","realName":"Blue Demon Jr.","picture":"Blue demon Jr.jpg","ability":70,"currentAbility":68,"potentialAbility":68,"charisma":62,"micSkills":60,"popularity":17,"condition":61,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":94,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1966-07-16T00:00:00.000Z","debut":"1985-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Blue Demon, Jr. is a Mexican professional wrestler. He is the alleged adopted son of the legendary original Blue Demon and is the first Mexican and first masked luchador to win the NWA World Heavyweight Championship. Like most masked luchadors, Blue Demon, Jr.'s real name is unknown. Blue Demon Jr. won the UWA World Junior Heavyweight Championship in 1997 in Panama by defeating Black Demon. Between 1997 and 1999 (exact date unknown) he lost the title to Pablo Marquez. On October 25, 2008, Demon, Jr. became the first Mexican professional wrestler, as well as first masked luchador to win the NWA World Heavyweight Championship when he defeated champion Adam Pearce. His win was also the first time the title changed hands in Mexico. In 2007 he appeared in the film Mil Mascaras vs. the Aztec Mummy (also known as Mil Mascaras Resurrection).","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":80,"productFit":100,"riskTaking":22,"matchLayout":81,"psychology":78,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":61,"characterCoaching":75,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":86,"socialMediaSavvy":77,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":64,"awareness":78,"judgement":87}},{"id":421,"name":"Chessman","realName":"Chessman","picture":"Chessman.jpg","ability":69,"currentAbility":70,"potentialAbility":70,"charisma":67,"micSkills":72,"popularity":6,"condition":70,"hardcoreAbility":84,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":105,"height":180,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-06-02T00:00:00.000Z","debut":"1996-07-03T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kevin Citlali Zamora is a Mexican professional wrestler, better known under his ring name Chessman. hroughout his career, Chessman has been a part of several factions, such as The Black Family, Lucha Libre Latina (LLL), La Secta Cibernetica, La Secta del Mesías and Los Hell Brothers. Chessman has been associated with Cibernético and Charly Manson in one way or the other throughout most of his career, either teaming with them or wrestling against them. After training with Lucha Libre legend El Canek and the father of the Casas family Pepe Casas (father of Negro Casas, Heavy Metal and El Felino), Zamora made his debut on July 3, 1995 working as an Enmascarado using the name M-357. In 2001 Chessman made his debut AAA debut as part of a new stable called the Black Family.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[1188],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":82,"productFit":100,"riskTaking":19,"matchLayout":82,"psychology":80,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":53,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":78,"brandBuilding":63,"socialMediaSavvy":76,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":76,"awareness":80,"judgement":88},"contract":{"id":"tew-contract-421","wrestlerId":421,"promotionId":5,"startDate":"2001-01-21T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":422,"name":"Cibernetico","realName":"Cibernetico","picture":"Cibernetico_alt2.jpg","ability":65,"currentAbility":59,"potentialAbility":59,"charisma":49,"micSkills":70,"popularity":8,"condition":59,"hardcoreAbility":70,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":107,"height":180,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-04-25T00:00:00.000Z","debut":"1994-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Octavio López Arreola is a Mexican professional wrestler who is best known under the ring name Cibernético. During AAA's short partnership with the World Wrestling Federation, he participated in the 1997 Royal Rumble and wrestled on Raw is War and WWF Shotgun, often teaming with Pierroth, Jr. He is a former AAA World Heavyweight Champion as well as a former three time Campeón de Campeones, the predecessor to the AAA world championship. López started out as a body builder, developing the physique that would later on become one of his strong points. He began training for a professional wrestling career in the Universal Wrestling Association (UWA) Gym under Karloff Lagarde and Ray Mendoza as well as training with Ojo de Tigre and Ebano Ruiz. e made his professional wrestling debut in 1992 under the ring name Urko and later worked as Espiritu Negro for a brief period of time.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":73,"productFit":100,"riskTaking":29,"matchLayout":74,"psychology":70,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":43,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":78,"brandBuilding":77,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":58,"awareness":70,"judgement":82},"contract":{"id":"tew-contract-422","wrestlerId":422,"promotionId":5,"startDate":"2022-02-05T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":423,"name":"Daga","realName":"Daga","picture":"Daga.jpg","ability":63,"currentAbility":57,"potentialAbility":57,"charisma":43,"micSkills":62,"popularity":14,"condition":90,"hardcoreAbility":39,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":82,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1988-06-19T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Originally a Coliseo Coacalco trainee, gained attention with his first big feud with Eterno and became a popular Mexico City independent luchador in 2010. Won the 2011 AAA Quien Pinta Para La Corona men's contest in something less than a surprise since he'd already appeared on their television show under a different name. Started out as a tecnico, but turned rudo in summer 2012 to join up with Los Perros del Mal, and won the AAA World Cruiserweight Championship at Guerra de Titanes, 2012. Titular leader of the short lived Daga Dynamite Dojo. Style very influenced by 'strong style' wrestlers including US wrestler Davey Richards.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[4300],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":65,"productFit":100,"riskTaking":27,"matchLayout":66,"psychology":62,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":63,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":54,"brandBuilding":58,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":81,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-423","wrestlerId":423,"promotionId":5,"startDate":"2026-07-01T00:00:00.000Z","endDate":"2028-07-01T00:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-07-01T00:00:00.000Z","wage":4333},{"id":424,"name":"Espiritu","realName":"Espiritu","picture":"Espiritu.jpg","ability":52,"currentAbility":60,"potentialAbility":60,"charisma":67,"micSkills":64,"popularity":4,"condition":74,"hardcoreAbility":42,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":83,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-12-09T00:00:00.000Z","debut":"1993-05-10T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Espíritu / Dark Espíritu (Spanish for \"Spirit\") is a Mexican Luchador who’s most well known for working as a heel. Espíritu made his debt on May 10, 1993 after learning the trade from Bobby Lee and Herculés León. Espíritu worked for years on the Mexican independent circuit until he began working for Asistencia Asesoría y Administración (AAA) in the mid to late 90s. Espíritu was original a member of the stable Los Vatos Locos, replacing Charly Manson when he left to form The Black Family in mid-2001. In November 2005 the Black Family asked Espíritu to join their group as they became part of La Secta Cibernética. Espíritu switched to the Black Family but parted amicably with the other Vatos Locos and at times teams with his old team mates Picudo, Nygma and Silver Cat. When La Secta became La Secta del Mesías Espíritu adopted the darker more \"gothic\" look that came with the shift in name.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":59,"storytelling":65,"productFit":100,"riskTaking":31,"matchLayout":67,"psychology":59,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":54,"characterCoaching":57,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":57,"brandBuilding":45,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":80,"awareness":59,"judgement":75}},{"id":425,"name":"Dios del Inframundo","realName":"Dios del Inframundo","picture":"Drago.jpg","ability":59,"currentAbility":61,"potentialAbility":61,"charisma":49,"micSkills":47,"popularity":8,"condition":75,"hardcoreAbility":58,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":79,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-07-23T00:00:00.000Z","debut":"1998-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Víctor Manuel Soto Flores is a Mexican Luchador or professional wrestler currently working under the ring name Alan and also under a mask as Drago. Soto is best known by his previous ring name Gato Eveready or simply El Gato, under which he was an unofficial member of the wrestling group Real Fuerza Aérea. He is also known for his time working as \"Alan\", one third of a group called Los Barrio Boys. He has worked for the majority of his career for the Mexican professional wrestling promotion Asistencia Asesoría y Administración (AAA). Victor Soto made his professional wrestling debut in April, 1998 on an Asistencia Asesoría y Administración (AAA) show, under the name Morfo. Later on his ring name was changed to \"Jimmy Boy\" and he was teamed up with Billy and Vangelis to form a Boy band inspired group called Los Spice Boys. On April 20, 2011, Soto debuted under a new character Drago and was given a major push as a tecnico fighting for AAA in the war against La Sociedad and Los Bizarros.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1177,1619,1757,2523,2524],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":25,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":67,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":70,"brandBuilding":66,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":68,"awareness":62,"judgement":77}},{"id":426,"name":"Mr. Elektro","realName":"Mr. Elektro","picture":"Electro Shock.jpg","ability":66,"currentAbility":63,"potentialAbility":63,"charisma":49,"micSkills":75,"popularity":5,"condition":65,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":95,"height":185,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1970-04-22T00:00:00.000Z","debut":"1992-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Edgar Luna Pozos is a Mexican Luchador or professional wrestler best known under the ring name Electroshock, which he has used while working for the Mexican professional wrestling promotion Asistencia Asesoría y Administración (AAA) since 1997. After getting his license Pozos created the enmascarado character \"Ultimatum\" after seeing a band called \"Ultimatum\" and discovering that the term meant \"final warning\", a name he found appropriate for the showmanship of professional wrestling. As Ultimatum he earned a contract with Consejo Mundial de Lucha Libre (CMLL) and began working at their wrestling school to hone his skills under the tutelage of Arturo Beristain. Almost ready to quit wrestling Pozos friend José Mercado, who wrestles as Pentagón Black, convinced him to apply for a job with Asistencia Asesoría y Administración (AAA).","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":75,"productFit":100,"riskTaking":30,"matchLayout":75,"psychology":73,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":58,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":62,"brandBuilding":60,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":70,"awareness":73,"judgement":84}},{"id":427,"name":"Kenta Kobashi","realName":"Kenta Kobashi","picture":"Kenta Kobashi.jpg","ability":93,"currentAbility":98,"potentialAbility":98,"charisma":100,"micSkills":100,"popularity":17,"condition":40,"hardcoreAbility":100,"injuryProne":80,"type":"writer","style":"all rounder","gender":"M","weight":115,"height":182,"base":"Japan","birthplace":"Japan","dateOfBirth":"1967-03-27T00:00:00.000Z","debut":"1988-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Kenta Kobashi is a Japanese retired professional wrestler. e started his career in AJPW in 1988 and during the next twelve years become one of the promotion's top stars, before taking part in a mass exodus led by Mitsuharu Misawa, which led to the formation of Pro Wrestling Noah. Kobashi worked for Noah for thirteen years, though spent years sidelined by various injuries, before retiring from in-ring action in May 2013. On March 17, 2013, Kobashi made an appearance for All Japan Pro Wrestling to promote his retirement match. Before the main event, Hiroshi Hase announced that he would be resigning as Pacific Wrestling Federation (PWF) chairman to focus on the National Diet and that Kobashi would be replacing him, after his retirement on May 11. Kobashi thus became the first AJPW-trained wrestler to become chairman.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[917,973,3217,3301,3302,3311,3312],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":95,"storytelling":97,"productFit":100,"riskTaking":10,"matchLayout":97,"psychology":95,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":58,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":90,"mediaHandling":72,"brandBuilding":75,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":66,"awareness":95,"judgement":97}},{"id":428,"name":"El Elegido","realName":"El Elegido","picture":"El Elegido.jpg","ability":56,"currentAbility":46,"potentialAbility":46,"charisma":59,"micSkills":39,"popularity":4,"condition":70,"hardcoreAbility":55,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":118,"height":180,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-11-23T00:00:00.000Z","debut":"2005-04-22T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"The latest in the seemingly never ending line of AAA pretty boy characters, El Elegido was a Monterrey wrestler scooped up by Antonio Pena. Elegido's progress in AAA seemed to crater after Pena's passing, with the new management group preferring other wrestlers. Elegido's also run afoul of those in charge by pushing his stripping gimmick a bit too far. AAA tends to put Elegido on TV for a few weeks, starting or continuing a storyline with him, then just drops the whole idea for a few months before repeating the idea again. Elegido's considered a very unskilled luchador, but is still tremendously popular with female audience.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":45,"storytelling":48,"productFit":100,"riskTaking":32,"matchLayout":49,"psychology":45,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":34,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":66,"brandBuilding":65,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":65,"awareness":45,"judgement":67}},{"id":429,"name":"Escoria","realName":"Escoria","picture":"Dark Escoria.jpg","ability":59,"currentAbility":60,"potentialAbility":60,"charisma":68,"micSkills":53,"popularity":5,"condition":80,"hardcoreAbility":79,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":82,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1980-12-09T00:00:00.000Z","debut":"1998-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jose Ibarra is a Mexican Luchador who is best known as Escoria / Dark Escoria (Spanish for \"Dreg\"). Ibarra has been part of The Black Family since it was formed, but left the stable in October 2010. During his time in the Black Family, Escoria was also a member of Lucha Libre Latina (LLL) and La Secta del Mesias, its predecessor La Secta Cibernetica and La Legión Extranjera. Ibarra made his wrestling debut in 1998 after training with Blackman, Negro Sosa and Draco for over six months. In the early parts of 2001 Escoria teamed up with four other wrestlers that all used a similar gimmick, look and attitude as Cuervo to form the stable the Black Family. The other wrestlers were Charly Manson, Cuervo and Ozz. In 2005 Cibernético formed a new group called La Secta Cibernetica that included his friends Charly Manson and Chessman and through Chessman's membership the Black Family was also invited to join this new supergroup.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1159,1917,1918],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":69,"productFit":100,"riskTaking":28,"matchLayout":70,"psychology":65,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":61,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":62,"brandBuilding":49,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":80,"awareness":65,"judgement":79}},{"id":430,"name":"Halloween","realName":"Halloween","picture":"Halloween.jpg","ability":44,"currentAbility":53,"potentialAbility":53,"charisma":43,"micSkills":45,"popularity":5,"condition":79,"hardcoreAbility":69,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":94,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1971-05-22T00:00:00.000Z","debut":"1989-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Manuel Ortiz Partida is a professional wrestler who is currently wrestling the independent circuit in Mexico, particularly in the Tijuana area. He is better known by his stage name Halloween but is also known in the United States as Ciclope, a character he portrayed in World Championship Wrestling. Manuel Ortiz Partida, debut in the pros in 1990, spent his time in the Independent Circuit. He wrestled as \"Halloween\" for most of his career. In 1996, Ortiz joined WCW where he took the name \"Ciclope.\" On March 13, 2012, Halloween, Bestia 666, Damián 666, Super Nova and X-Fly announced that they were forming La Familia de Tijuana, a group of independent wrestlers, much like Los Perros del Mal, with the exception that they were not looking to form their own promotion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":119,"teams":[1153,1223,3176],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":60,"productFit":100,"riskTaking":44,"matchLayout":61,"psychology":57,"workerManagement":100,"trainingIntensity":61,"technicalCoaching":44,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":53,"brandBuilding":54,"socialMediaSavvy":50,"ruleKnowledge":2,"positioning":22,"reactionSpeed":61,"consistency":59,"awareness":57,"judgement":74},"contract":{"id":"tew-contract-430","wrestlerId":430,"promotionId":119,"startDate":"2025-12-05T00:00:00.000Z","endDate":"2027-12-05T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-12-05T00:00:00.000Z","wage":1000},{"id":431,"name":"Heavy Metal","realName":"Heavy Metal","picture":"Heavy Metal.jpg","ability":69,"currentAbility":60,"potentialAbility":60,"charisma":45,"micSkills":52,"popularity":4,"condition":64,"hardcoreAbility":41,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":88,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1970-10-04T00:00:00.000Z","debut":"1988-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Erick Francisco Casas Ruiz is a Mexican professional wrestler currently working under the ring name Heavy Metal.  He is the son of referee Pepe Casas and the brother of Negro Casas and Felino. Erick Casas started his professional wrestling career as Canelo Casas wrestling for Consejo Mundial de Lucha Libre (CMLL). Erick Casas left CMLL when he decided to go to the newly created promotion Asistencia Asesoría y Administración (AAA) in 1992. He changed his gimmick to Heavy Metal where he was a rudo and had a rock-star look which was based on heavy metal music. Heavy Metal went to Total Nonstop Action Wrestling (TNA) because AAA's working agreement. After TNA, Heavy Metal returned to Asistencia Asesoría y Administración. Since his return, he turned back into a tecnico. At AAA's show in Mexico City, an event competing directly against CMLL's major event Homenaje a Dos Leyendas, Heavy Metal made surprising return to AAA, attacking Konnan and joining forces with Cibernético.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3181],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":27,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":56,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":64,"brandBuilding":56,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":62,"awareness":63,"judgement":78}},{"id":433,"name":"Jack Evans","realName":"Jack Evans","picture":"Jack Evans.jpg","ability":42,"currentAbility":52,"potentialAbility":52,"charisma":57,"micSkills":42,"popularity":19,"condition":71,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":77,"height":170,"base":"USA","birthplace":"United States","dateOfBirth":"1982-04-02T00:00:00.000Z","debut":"2000-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jack Evans is an American wrestler who works in America, Canada, Mexico, the British Isles, Japan and Europe. He is a Lightweight who is classed as using a Daredevil style. He is one half of The Hybrid2 alongside Angélico. He is best known for his work with AEW. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":95,"teams":[1185,1897,2559],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":45,"storytelling":53,"productFit":100,"riskTaking":37,"matchLayout":56,"psychology":45,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":62,"brandBuilding":55,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":45,"awareness":45,"judgement":67},"contract":{"id":"tew-contract-433","wrestlerId":433,"promotionId":95,"startDate":"2025-10-24T00:00:00.000Z","endDate":"2027-10-24T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-10-24T00:00:00.000Z","wage":1000},{"id":434,"name":"Konnan","realName":"Konnan","picture":"Konnan.jpg","ability":63,"currentAbility":68,"potentialAbility":68,"charisma":78,"micSkills":65,"popularity":30,"condition":38,"hardcoreAbility":74,"injuryProne":50,"type":"manager","style":"all rounder","gender":"M","weight":109,"height":175,"base":"Other","birthplace":"Cuba","dateOfBirth":"1964-01-06T00:00:00.000Z","debut":"1987-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Considered one of the biggest stars in the history of lucha libre, Konnan is one of the most influential luchadores in the history of the sport.\r\n\r\nShattering box office records as a perennial main eventer in Mexico, Konnan co-founded AAA while acting as the guiding light of some of today and tomorrow’s emerging top luchadores.\r\n\r\nThese are just a few of the bullets on this Miami native’s resume, which is decorated with accomplishments. Konnan’s hustled and headlined both in the United States as well as blazed a hall of fame career in Mexico.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[910,911,1423],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":77,"productFit":100,"riskTaking":29,"matchLayout":77,"psychology":78,"workerManagement":100,"trainingIntensity":17,"technicalCoaching":27,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":82,"brandBuilding":62,"socialMediaSavvy":82,"ruleKnowledge":0,"positioning":20,"reactionSpeed":17,"consistency":50,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-434","wrestlerId":434,"promotionId":5,"startDate":"2018-06-04T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":435,"name":"El Mesias","realName":"El Mesias","picture":"El Mesias.jpg","ability":59,"currentAbility":60,"potentialAbility":60,"charisma":55,"micSkills":50,"popularity":15,"condition":83,"hardcoreAbility":74,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":111,"height":180,"base":"USA","birthplace":"Puerto Rico","dateOfBirth":"1975-05-25T00:00:00.000Z","debut":"1997-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Gilbert Cosme better known by his ring names El Mesías and Ricky Banderas, is a Puerto Rican professional wrestler. He began his career in the International Wrestling Association based on Puerto Rico. While performing in the company, he won the IWA World Heavyweight Championship on five instances and held minor championships on fifteen separate occasions, before leaving the company in 2006. Following the culmination of his contract with the International Wrestling Association, Cosme signed a contract with Asistencia Asesoría y Administración (AAA). He debuted on March 12, 2006, as \"Muerte Cibernética\" a rudo. As noted on the \"TNA Mobile\" service, Cosme signed a contract with Total Nonstop Action Wrestling (TNA). Cosme was billed as James Mitchell's kayfabe son and thus Abyss' brother. Beginning on July 1, 2007, vignettes began to air for this \"monster-like\" character. His name was eventually billed as Judas Mesias.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":71,"storytelling":74,"productFit":100,"riskTaking":27,"matchLayout":75,"psychology":71,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":38,"characterCoaching":80,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":80,"brandBuilding":76,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":65,"awareness":71,"judgement":83},"contract":{"id":"tew-contract-435","wrestlerId":435,"promotionId":5,"startDate":"2023-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":436,"name":"Octagón","realName":"Octagón","picture":"Octagon.jpg","ability":66,"currentAbility":62,"potentialAbility":62,"charisma":60,"micSkills":56,"popularity":25,"condition":58,"hardcoreAbility":46,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":86,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1961-03-27T00:00:00.000Z","debut":"1981-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Juan Escalera is a Mexican luchador enmascarado better known as Octagón. Octagón formed a Tag team with El Hijo Del Santo to take on Los Gringos Locos (Eddie Guerrero and Art Barr) in a double mask versus hair match on the first pay-per-view put on by a Mexican wrestling promotion. Over the years the Octagón gimmick has spawned a Mascot called Octagóncito and an \"Evil clone\" known as Pentagón. In late 1988 to early 1989, Octagón, along with CMLL booker Antonio Peña (the man in charge of writing the storylines that CMLL used), decided to create a new character that played off Octagón's martial arts background. The name was inspired by the movie The Octagon starring Chuck Norris.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":84,"storytelling":85,"productFit":100,"riskTaking":23,"matchLayout":86,"psychology":84,"workerManagement":100,"trainingIntensity":50,"technicalCoaching":70,"characterCoaching":42,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":42,"brandBuilding":65,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":50,"consistency":65,"awareness":84,"judgement":90},"contract":{"id":"tew-contract-436","wrestlerId":436,"promotionId":11,"startDate":"2022-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":437,"name":"Pimpinela Escarlata","realName":"Pimpinela Escarlata","picture":"Pimpinela Escarlata.jpg","ability":67,"currentAbility":61,"potentialAbility":61,"charisma":54,"micSkills":53,"popularity":5,"condition":62,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":87,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1969-04-18T00:00:00.000Z","debut":"1988-06-15T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Mario González Lozano is a Mexican Luchador, or professional wrestler who works as an Exotico. As Escarlata he is a former AAA Reina de Reinas Champion, Mexican National Middleweight Champion and AAA World Mixed Tag Team Champion. His ring name is Spanish for \"The Scarlet Pimpernel\" and is taken from the fictional character of the same name. The fact that González works as an Exotico, a transvestite, homosexual character, it does not necessarily mean that it reflects his personal preferences. Mario González began his professional wrestling career in 1988, initially working under the ring name Pantera Rosa (Spanish for \"the Pink Panther\") and later on briefly worked as Fly Boy. González was a fan of such Exotico wrestlers as Adorable Rubí and Sergio El Hermoso growing up and decided to become an Exotico himself.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":80,"productFit":100,"riskTaking":21,"matchLayout":80,"psychology":78,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":49,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":85,"brandBuilding":39,"socialMediaSavvy":82,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":49,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-437","wrestlerId":437,"promotionId":5,"startDate":"2001-03-30T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":438,"name":"Silver King","realName":"Silver King","picture":"Silver King.jpg","ability":46,"currentAbility":56,"potentialAbility":56,"charisma":47,"micSkills":71,"popularity":20,"condition":62,"hardcoreAbility":65,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":98,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1968-01-09T00:00:00.000Z","debut":"1985-11-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":true,"story":"César Cuauhtémoc González Barrón is a Luchador Enmascarado and actor known best as Silver King but has also had an extensive stint as Black Tiger III, the third incarnation of the Black Tiger gimmick. He is the son of luchador Dr. Wagner and the brother of Dr. Wagner, Jr. González worked for many years with El Texano under the Tag Team name \"Los Cowboys\" winning tag team titles both in Mexico and Japan. Silver King has worked for the Universal Wrestling Association (UWA), Consejo Mundial de Lucha Libre (CMLL), World Championship Wrestling (WCW), All Japan Pro Wrestling (AJPW), New Japan Pro Wrestling (NJPW) and various smaller federations all over the world. González also starred as the villain \"Ramses\" in the movie Nacho Libre, starring Jack Black. In June, 2010 González began using the ring name Silver Cain/Kain when wrestling in Mexico City as a way to be able to officially be allowed to wear his mask again.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1198,3154,3155,3156,3157,3158,3295],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":60,"storytelling":68,"productFit":100,"riskTaking":25,"matchLayout":71,"psychology":60,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":38,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":64,"brandBuilding":50,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":75,"awareness":60,"judgement":76}},{"id":439,"name":"El Texano Jr.","realName":"El Texano Jr.","picture":"Texano Jr.jpg","ability":60,"currentAbility":66,"potentialAbility":66,"charisma":53,"micSkills":74,"popularity":10,"condition":78,"hardcoreAbility":63,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":100,"height":182,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1984-07-31T00:00:00.000Z","debut":"1999-02-24T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Juan Aguilar Leos is a Mexican luchador, or professional wrestler, best known under the ring name El Texano, Jr. Aguilar is the son of Juan Conrado Aguilar Jáuregui, who wrestled under the name El Texano; Aguilar also has several uncles and cousins that are professional wrestlers. Aguilar has mainly worked for the Mexican professional wrestling promotion Consejo Mundial de Lucha Libre (CMLL) throughout his career, but has made several tours of Japan for New Japan Pro Wrestling (NJPW) from 2005 until 2007. In November 2011, Aguilar left CMLL to join Perros del Mal Producciones and Asistencia Asesoría y Administración (AAA). On December 2 2012 at Guerra de Titanes, El Texano, Jr. defeated El Mesías to become the youngest AAA World Heavyweight Champion in history.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":119,"teams":[3356,3648,4243],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":75,"storytelling":77,"productFit":100,"riskTaking":21,"matchLayout":77,"psychology":75,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":62,"characterCoaching":71,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":71,"brandBuilding":68,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":63,"awareness":75,"judgement":85},"contract":{"id":"tew-contract-439","wrestlerId":439,"promotionId":119,"startDate":"2025-03-21T00:00:00.000Z","endDate":"2027-03-21T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-03-21T00:00:00.000Z","wage":1000},{"id":440,"name":"Toscano","realName":"Toscano","picture":"Toscano.jpg","ability":49,"currentAbility":54,"potentialAbility":54,"charisma":62,"micSkills":54,"popularity":4,"condition":83,"hardcoreAbility":36,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":95,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1973-12-20T00:00:00.000Z","debut":"1993-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Oziel Toscano Jasso is a Mexican professional wrestler, or Luchador as they are known in Spanish, best known under the ring name Tarzan Boy and Toscano. He briefly worked for the World Wrestling Federation (WWF) as Armando Fernandez in 1998 and 1999 on their Lucha libre oriented WWF Super Astros television program. Tarzan Boy was initially trained as a \"técnico\" by Blue Fish and made his official debut on November 27, 1993 in Monterrey under the name Baby Toscano. He was turned rudo and aligned with Rey Bucanero and Último Guerrero to form Los Guerreros del Infierno. On December 8, 2011, Toscano appeared at a press conference, where it was announced that he was joining CMLL's rival promotion Asistencia Asesoría y Administración (AAA). With the announcement, in just 30 days, Toscano became the third CMLL worker, after Héctor Garza and El Texano, Jr., to leave the promotion for AAA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":37,"storytelling":51,"productFit":90,"riskTaking":27,"matchLayout":56,"psychology":37,"workerManagement":90,"trainingIntensity":72,"technicalCoaching":70,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":44,"brandBuilding":53,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":18,"reactionSpeed":72,"consistency":62,"awareness":37,"judgement":58}},{"id":441,"name":"Faby Apache","realName":"Faby Apache","picture":"Faby Apache.jpg","ability":61,"currentAbility":67,"potentialAbility":67,"charisma":53,"micSkills":79,"popularity":15,"condition":74,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":63,"height":157,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1980-12-26T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Born Fabiola Balbuena Torres, the daughter of Gran Apache soon shortened her name to Fabi Apache when she debuted in lucha libre. La India Bonita, Fabi split her time between Mexico and Japan, wrestling for ARSION. More agile than fast. Between 2005 and 2009 she was involved in a long running storyline that revolved around her relationship with Billy Boy (Billy el Malo), her real life husband as well as her father Gran Apache, sister Mari Apache and even saw Billy Boy and Faby Apache's son Marvin play a part in it. In August 2011, Faby and her sister worked a tour of Japan, working with Oz Academy and Pro Wrestling Wave. On April 6, 2012, Mari Apache turned ruda and started a rivalry with Faby.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[1376,2872,2873],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":77,"storytelling":80,"productFit":100,"riskTaking":20,"matchLayout":81,"psychology":77,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":68,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":73,"brandBuilding":67,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":73,"awareness":77,"judgement":86},"contract":{"id":"tew-contract-441","wrestlerId":441,"promotionId":5,"startDate":"2023-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":442,"name":"Mary Apache","realName":"Mary Apache","picture":"Mary Apache.jpg","ability":67,"currentAbility":62,"potentialAbility":62,"charisma":64,"micSkills":56,"popularity":6,"condition":79,"hardcoreAbility":82,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":70,"height":157,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1979-10-15T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Mariella Balbuena Torres is a Mexican Luchadora, best known under the ring name Mari Apache (sometimes written as \"Mary Apache\"). She is the daughter of Luchador Gran Apache and the sister of luchadora Faby Apache. She has wrestled for an extended period of time in Japan but is best known for working in Asistencia Asesoría y Administración along with her father and sister. She is a former holder of the AAA Reina de Reinas and AAA World Mixed Tag Team Championship, the latter of which she held along with her father. Torres has previously wrestled under the ring name Princesa Apache as well as the enmascarada (masked) characters Love and Lady Venum.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1376,2872,2873],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":72,"productFit":90,"riskTaking":23,"matchLayout":73,"psychology":67,"workerManagement":90,"trainingIntensity":65,"technicalCoaching":62,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":61,"brandBuilding":55,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":18,"reactionSpeed":65,"consistency":68,"awareness":67,"judgement":76}},{"id":443,"name":"Jennifer Blake","realName":"Jennifer Blake","picture":"Jennifer Blake.jpg","ability":43,"currentAbility":52,"potentialAbility":52,"charisma":40,"micSkills":48,"popularity":4,"condition":90,"hardcoreAbility":36,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":57,"height":167,"base":"Canada","birthplace":"Canada","dateOfBirth":"1983-09-16T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Jennifer Ykema is a Canadian professional wrestler, better known by her ring name Jennifer Blake. She is often referred to by her nickname Girl Dynamite. She is best known for her work in Asistencia Asesoría y Administración in Mexico, where she has been one half of the AAA World Mixed Tag Team Champions, and Shimmer Women Athletes in the United States as well as all-women's promotions in America and Canada. Blake made her first wrestling appearance in 2004 as a ring announcer. Following this, she transitioned into a managerial role and began acting as a valet for Derek Wylde and Cody Deaner while receiving training from Cody. Blake made her debut for Shimmer Women Athletes on April 26, 2008. In early 2009, Blake took part in the tapings of Jimmy Hart's Wrestlicious as Autumn Frost. In 2009, Blake branched out into Mexico.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":54,"productFit":50,"riskTaking":29,"matchLayout":57,"psychology":44,"workerManagement":50,"trainingIntensity":78,"technicalCoaching":49,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":58,"brandBuilding":50,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":10,"reactionSpeed":78,"consistency":73,"awareness":44,"judgement":46}},{"id":444,"name":"Lady Shani","realName":"Lady Shani","picture":"Lady Shani.jpg","ability":55,"currentAbility":54,"potentialAbility":54,"charisma":62,"micSkills":67,"popularity":8,"condition":93,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":85,"height":165,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1993-03-02T00:00:00.000Z","debut":"2009-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Sexy Lady is a female professional wrestler who made her debut alongside her cousin, Ludark Shaitan in 2009. They had many battles both as a team, and as opponents. Sexy Lady worked many Mexican independant shows before she was signed to AAA in June 2012 to compete in their womens division, teaming with El apache and his daughter Mary Apache. She is proving to be a tough opponent, and one to watch out for.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit":100,"riskTaking":32,"matchLayout":61,"psychology":56,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":56,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":65,"brandBuilding":69,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":58,"awareness":56,"judgement":74},"contract":{"id":"tew-contract-444","wrestlerId":444,"promotionId":5,"startDate":"2012-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":445,"name":"Kraneo","realName":"Kraneo","picture":"Kraneo.jpg","ability":61,"currentAbility":66,"potentialAbility":66,"charisma":52,"micSkills":74,"popularity":5,"condition":61,"hardcoreAbility":66,"injuryProne":87,"type":"wrestler","style":"high flyer","gender":"M","weight":110,"height":182,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1972-07-12T00:00:00.000Z","debut":"1988-07-12T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Kraneo is a masked Mexican luchador who works exclusively in Mexico. He is a Lightweight who is classed as using a Luchador style. He is best known for his work with both AAA (as the original El Alebrije as well as Mascara Sagrada II) and CMLL. He is married to luchadora Tiffany. In early April 2010, El Alebrije and Histeria sought legal action against AAA over the issues of name and ring character ownership as well as unfair termination by AAA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[1931],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":81,"productFit":100,"riskTaking":21,"matchLayout":81,"psychology":80,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":52,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":73,"brandBuilding":42,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":72,"awareness":80,"judgement":88},"contract":{"id":"tew-contract-445","wrestlerId":445,"promotionId":11,"startDate":"2010-04-26T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":447,"name":"Angélico","realName":"Angélico","picture":"Angelico.jpg","ability":53,"currentAbility":56,"potentialAbility":56,"charisma":56,"micSkills":69,"popularity":20,"condition":75,"hardcoreAbility":68,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":97,"height":187,"base":"Other","birthplace":"South Africa","dateOfBirth":"1987-05-07T00:00:00.000Z","debut":"2006-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Angélico is a South African wrestler who works in America, Mexico, the British Isles and Europe. He is a Lightweight who is classed as using a Daredevil style. He is one half of The Hybrid2 alongside Jack Evans. He is best known for his work with AEW, AAA, PWG, wXw, IWRG, RevPro, Lucha Ungrnd, The Crash, GWF, AAW, FCP, PROGRESS, OTT, Smash, ATTACK!, Riptide, Defiant, ICW, TNT and SWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[1185,1897,2559,3981,3982],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":48,"storytelling":55,"productFit":100,"riskTaking":35,"matchLayout":58,"psychology":48,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":60,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":51,"brandBuilding":55,"socialMediaSavvy":28,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":70,"awareness":48,"judgement":69},"contract":{"id":"tew-contract-447","wrestlerId":447,"promotionId":49,"startDate":"2023-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000,"inDevelopment":true},{"id":448,"name":"Argenis","realName":"Argenis","picture":"Argenis.jpg","ability":51,"currentAbility":60,"potentialAbility":60,"charisma":73,"micSkills":47,"popularity":6,"condition":84,"hardcoreAbility":43,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":81,"height":177,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1986-08-13T00:00:00.000Z","debut":"2006-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Argenis is a Mexican luchador enmascarado, or masked professional wrestler. Argenis made his professional wrestling debut in 2006, working as \"Dr. Karonte, Jr.\", named after his father. He would also work as \"Hijo del Dr. Karonte\", neither gimmick led to much success. By 2007 he began working for Consejo Mundial de Lucha Libre (CMLL) as a Rudo (Heel or \"Bad guy\") After he left CMLL he complained to several magazines that he felt that his brother Místico should have asked CMLL to give him more opportunities. In June 2011, Argenis' brother Astro Boy II joined AAA and Real Fuerza Aérea under the new ring name Argos. On February 10, 2012, Argos turned on Argenis and Real Fuerza Aérea to join rudo group El Consejo.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1028],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":25,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":61,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":51,"brandBuilding":48,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":73,"awareness":56,"judgement":74}},{"id":449,"name":"Argos","realName":"Argos","picture":"Argos.jpg","ability":68,"currentAbility":61,"potentialAbility":61,"charisma":67,"micSkills":66,"popularity":3,"condition":86,"hardcoreAbility":49,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":86,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1985-10-14T00:00:00.000Z","debut":"2002-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Early in his career, he and Mistico worked together as Los Astro Boys I y II. After Mistico left CMLL to join WWE, Astro Boy left CMLL five months later to join AAA (where his other, less famous, brother Argenis occasionally appears in the openers.) Astro Boy switched to the name Argos; it's possible he actually switched back to that name, as there was an Argos around CMLL briefly before Astro Boy's debut. Argos' new mask resembles his brother's Sin Cara's mask. Argos joined Real Fuerza Aérea AAA, taking the vacant spot in the trio after Super Fly betrayed the group. On February 10, 2012, Argos turned on Argenis and Real Fuerza Aérea to join rudo group El Consejo - he also changed his mask.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[1176],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":71,"storytelling":73,"productFit":70,"riskTaking":55,"matchLayout":73,"psychology":71,"workerManagement":70,"trainingIntensity":80,"technicalCoaching":67,"characterCoaching":39,"diagnosis":50,"rehabilitation":50,"prevention":45,"mediaHandling":39,"brandBuilding":52,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":14,"reactionSpeed":80,"consistency":73,"awareness":71,"judgement":71},"contract":{"id":"tew-contract-449","wrestlerId":449,"promotionId":11,"startDate":"2022-01-04T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":450,"name":"Billy Boy","realName":"Billy Boy","picture":"Billy El Malo.jpg","ability":58,"currentAbility":60,"potentialAbility":60,"charisma":49,"micSkills":47,"popularity":3,"condition":71,"hardcoreAbility":69,"injuryProne":81,"type":"wrestler","style":"high flyer","gender":"M","weight":74,"height":165,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1977-06-09T00:00:00.000Z","debut":"1997-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Billy Boy is the ring name of Mexican Luchador or professional wrestler José Roberto Islas García. José Islas began his professional wrestling career in 1997 under the ring name “Fighterman”, a stripper gimmick aimed primarily at female fans. In 2001 his gimmick was modified to Billy Boy and he was made part of a group called Los Barrio Boys along with Alan (formerly known as \"Spice Boy\" Jimmy Boy) and Decnnis. In 2004 AAA owner Antonio Peña decided to \"repackage\" Billy Boy, giving him a full-body suit and a mask, turning him into the enmascarado character \"Alfa\". Billy Boy's run as Alfa was very short lived and it was never publicly acknowledged at the time that it was Billy Boy under the mask. As Alfa he gained Gran Apache's respect, leading Apache to stating that Alfa would make a good husband for Faby Apache. Following the statement Billy Boy unmasked to the surprise of everyone, reuniting with Faby Apache and Marvin, though the ruse did not please Gran Apache.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1177],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":66,"storytelling":69,"productFit":100,"riskTaking":18,"matchLayout":70,"psychology":66,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":58,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":67,"brandBuilding":47,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":67,"awareness":66,"judgement":80}},{"id":451,"name":"Crazy Boy","realName":"Crazy Boy","picture":"Crazy Boy.jpg","ability":65,"currentAbility":57,"potentialAbility":57,"charisma":65,"micSkills":43,"popularity":4,"condition":82,"hardcoreAbility":57,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":92,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1978-03-30T00:00:00.000Z","debut":"1997-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Crazy Boy is a Mexican professional wrestler who is best known in Lucha Libre and is the cousin of Super Crazy. Around the turn of the millennium, Crazy Boy worked extensively in Naucalpan, Mexico State, for the then recently created International Wrestling Revolution Group (IWRG). In IWRG he formed a \"suicidal\" trio with Star Boy and Súper Boy who all used a high flying, high risk wrestling style. Crazy Boy's stint in CMLL ended in a messy way, with Crazy pulling himself out from an Arena Mexico show (which would have been his first CMLL one there), claiming an injury from a just completed Japanese tour, only to show up as surprise in AAA days later.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1199,1200,3313],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":60,"productFit":100,"riskTaking":51,"matchLayout":62,"psychology":54,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":58,"characterCoaching":48,"diagnosis":50,"rehabilitation":50,"prevention":49,"mediaHandling":48,"brandBuilding":45,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":63,"awareness":54,"judgement":72}},{"id":453,"name":"The Beast Mortos","realName":"The Beast Mortos","picture":"Black Taurus.jpg","ability":72,"currentAbility":67,"potentialAbility":67,"charisma":65,"micSkills":65,"popularity":26,"condition":85,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":90,"height":175,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1987-03-11T00:00:00.000Z","debut":"2005-11-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"The Beast Mortos is a masked Mexican luchador who works in the USA, Mexico, the British Isles and Europe. He is a 5'10\", 198lb worker who is classed as using a Luchador style. He uses the Infernal Suplex as his finisher. He is best known for his work with CMLL, AEW, TNA, AAA, ROH and The Crash.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1417],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":64,"storytelling":68,"productFit":100,"riskTaking":23,"matchLayout":70,"psychology":64,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":58,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":73,"brandBuilding":74,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":79,"awareness":64,"judgement":78},"contract":{"id":"tew-contract-453","wrestlerId":453,"promotionId":76,"startDate":"2024-01-18T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":454,"name":"Tito Santana","realName":"Tito Santana","picture":"Tito Santana.jpg","ability":66,"currentAbility":56,"potentialAbility":56,"charisma":44,"micSkills":48,"popularity":4,"condition":80,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":85,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1986-02-11T00:00:00.000Z","debut":"2000-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Not to be confused with the former WWF Tag Team Champion of the same name. Tito Santana is a young luchador who was seen mainly on the Monterrey indy scene. He made his debut in 2000 and is the son of former luchador Kendor. He is usually paired with high flying tecnicos but recently has taken on a new, more villianous persona, that of Soul Rocker, a member of Los Infernal Rockers in AAA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1278],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":60,"productFit":100,"riskTaking":27,"matchLayout":62,"psychology":54,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":56,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":64,"brandBuilding":38,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":78,"awareness":54,"judgement":72}},{"id":457,"name":"Rey Fénix","realName":"Rey Fénix","picture":"Fenix.jpg","ability":53,"currentAbility":61,"potentialAbility":61,"charisma":50,"micSkills":52,"popularity":40,"condition":75,"hardcoreAbility":65,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":83,"height":175,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1990-12-30T00:00:00.000Z","debut":"2006-04-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Rey Fénix is a masked Mexican luchador who works in the USA, Canada, Mexico and the British Isles. He is a 5'10\", 165lb worker who is classed as using a Luchador style. He uses the Meteora as his finisher. He is one half of Lucha Brothers alongside Penta El Zero M. He is best known for his work with WWE, CMLL, AEW, NOAH, TNA, AAA, PWG, wXw, IWRG, MLW, Lucha Ungrnd, The Crash, DEFY, AAW, FCP, DTU, Defiant, CHIKARA and SWE. He was one half of the Male Tag Team Of The Year in 2019.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[1207,1902,2386,2431,3711],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":64,"storytelling":70,"productFit":100,"riskTaking":27,"matchLayout":72,"psychology":64,"workerManagement":100,"trainingIntensity":86,"technicalCoaching":73,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":67,"brandBuilding":68,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":86,"consistency":87,"awareness":64,"judgement":78},"contract":{"id":"tew-contract-457","wrestlerId":457,"promotionId":64,"startDate":"2025-03-01T00:00:00.000Z","endDate":"2027-03-01T00:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-03-01T00:00:00.000Z","wage":4333},{"id":458,"name":"Flamita","realName":"Flamita","picture":"Flamita.jpg","ability":60,"currentAbility":56,"potentialAbility":56,"charisma":53,"micSkills":65,"popularity":19,"condition":85,"hardcoreAbility":38,"injuryProne":96,"type":"wrestler","style":"high flyer","gender":"M","weight":73,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1994-11-30T00:00:00.000Z","debut":"2005-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"A third-generation star from Mexico, Flamita has risen quickly into the upper-echelon of luchadors, drawing comparisons to lucha royalty. Before making his ROH debut on the Honor United 2019 tour, Flamita drew acclaim all over the globe, including representing the groups Millenials and Dia.Hearts in Dragon Gate and teaming with international mega star Bandido as Mexiblood.\r\n\r\nFlamita has excelled in singles competition, holding The Crash’s Cruiserweight Championship, but has made his mark in six-man tag action in Dragon Gate, holding their six-man tag team titles, as well as The Crash and Progress World Tag Team Titles with Bandido. In ROH, that success continued and continued quickly when the master of the FlamaFlame Spanish Fly won the ROH World Six-Man Tag Team Titles with Bandido and Rey Horus in Atlanta at Saturday Night at Center Stage 2020.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[1034,1793,1970,3094],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":51,"storytelling":59,"productFit":100,"riskTaking":25,"matchLayout":62,"psychology":51,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":62,"characterCoaching":49,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":49,"brandBuilding":58,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":68,"awareness":51,"judgement":71},"contract":{"id":"tew-contract-458","wrestlerId":458,"promotionId":14,"startDate":"2024-05-01T00:00:00.000Z","endDate":"2026-05-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-05-01T00:00:00.000Z","wage":1000},{"id":459,"name":"Gronda II","realName":"Gronda II","picture":"Gronda.jpg","ability":40,"currentAbility":46,"potentialAbility":46,"charisma":40,"micSkills":45,"popularity":3,"condition":61,"hardcoreAbility":51,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":100,"height":180,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1960-08-20T00:00:00.000Z","debut":"2002-06-23T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Gronda II took over the gimmick when the orignal Gronda walked out on AAA. Despite his menacing look, Gronda II hasn't had much success and is usually booked on the mid/undercard for AAA. He is better in the ring than the original Gronda (which isn't difficult), but still not good enough to be considered a top draw for the company after 7 years portraying the character.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":46,"storytelling":51,"productFit":100,"riskTaking":54,"matchLayout":53,"psychology":46,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":22,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":46,"mediaHandling":64,"brandBuilding":60,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":53,"awareness":46,"judgement":68}},{"id":460,"name":"Raul Mendoza","realName":"Raul Mendoza","picture":"Jinzo.jpg","ability":61,"currentAbility":55,"potentialAbility":55,"charisma":43,"micSkills":46,"popularity":25,"condition":91,"hardcoreAbility":61,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1991-11-25T00:00:00.000Z","debut":"2006-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"One of the world’s fastest Superstars and most spectacular aerial artists, Raul Mendoza keeps opponents on their toes by darting around the ring like a pinball bouncing off bumpers.\r\n\r\nFollowing in the footsteps of his idol, WWE Hall of Famer Eddie Guerrero, Mendoza established himself in Mexico’s tradition-rich lucha libre scene before attaining Superstardom under the WWE banner. He first gained the attention of the WWE Universe with an impressive showing during the 2016 Cruiserweight Classic. The performance opened eyes and earned Mendoza a spot on the NXT roster, where he now mixes it up with the black-and-yellow brand’s toughest competitors.\r\n\r\nCapable of stealing the show on any given night, Mendoza remains among the brightest young prospects in all of WWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[1831,2161],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":61,"productFit":100,"riskTaking":26,"matchLayout":62,"psychology":58,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":51,"characterCoaching":41,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":41,"brandBuilding":51,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":62,"awareness":58,"judgement":75},"contract":{"id":"tew-contract-460","wrestlerId":460,"promotionId":64,"startDate":"2016-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":461,"name":"Joe Lider","realName":"Joe Lider","picture":"Joe Lider.jpg","ability":51,"currentAbility":53,"potentialAbility":53,"charisma":66,"micSkills":63,"popularity":4,"condition":60,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":100,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1978-06-02T00:00:00.000Z","debut":"1993-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"José de Jesús Álvarez is a Mexican professional wrestler, better known by his ringname Joe Líder. He currently competes in Asistencia Asesoría y Administración. He is known for being a former member of the tag team La Hermandad Extrema with Nicho el Millonario who, like himself, is one of several wrestlers to emerge from the independent circuit during the 1990s. Álvarez is also the real-life brother of Demoledor and had faced him on several occasions during his career, most notably, defeating him in their hometown in a \"hair vs. hair\" match at the Arena Victoria in January 2005.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":108,"teams":[1155,1199,1200,1271,3197],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":64,"productFit":100,"riskTaking":33,"matchLayout":65,"psychology":61,"workerManagement":100,"trainingIntensity":61,"technicalCoaching":38,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":58,"brandBuilding":52,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":61,"consistency":64,"awareness":61,"judgement":77},"contract":{"id":"tew-contract-461","wrestlerId":461,"promotionId":108,"startDate":"2024-02-16T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":463,"name":"El Zorro","realName":"El Zorro","picture":"El Zorro.jpg","ability":59,"currentAbility":60,"potentialAbility":60,"charisma":53,"micSkills":45,"popularity":6,"condition":68,"hardcoreAbility":52,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":91,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-07-20T00:00:00.000Z","debut":"1993-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jesus Cristóbal Martínez Rodriguez is a Mexican Luchador (professional wrestler) who is best known as El Zorro. His gimmick started out very similar to the fictional character Zorro complete with mask, but in recent years it has evolved and the mask has been eliminated. He currently wrestlers for the Asistencia Asesoría y Administración (AAA) promotion in Mexico. In late September TNA founder Jeff Jarrett travelled to Mexico to hold talks with AAA, during which Martínez was offered a two–year non–exclusive contract with TNA. On December 2, 2012, at Guerra de Titanes, Martínez made his debut as the masked \"La Parka Negra\", the rudo counterpart of La Parka.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":71,"productFit":100,"riskTaking":21,"matchLayout":72,"psychology":69,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":53,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":67,"brandBuilding":58,"socialMediaSavvy":58,"ruleKnowledge":5,"positioning":24,"reactionSpeed":66,"consistency":62,"awareness":69,"judgement":81}},{"id":464,"name":"Máscara Año 2000 Jr.","realName":"Máscara Año 2000 Jr.","picture":"Mascara Ano 2000 Jr_alt.jpg","ability":53,"currentAbility":61,"potentialAbility":61,"charisma":52,"micSkills":50,"popularity":4,"condition":84,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":102,"height":180,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1977-01-16T00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Ángel Omar Reyes Franco is a Mexican luchador or professional wrestler, better known as Máscara Año 2000, Jr. Reyes made his professional wrestling debut at some point in 1999, under an undisclosed ring name. From 1999 until 2006 he wrestled without revealing his family relations to his father Jesús Reyes González, better known as Luchador Máscara Año 2000. This is a practice not uncommon in Lucha libre where sons often \"learn the trade\" before being given the \"family name\". On November 2, 2008 Máscara Año 2000, Jr. was one of 10 wrestlers who put their mask on the line under Lucha de Apuesta, or bet match, rules. On December 16, 2011, at AAA's Guerra de Titanes pay-per-view, Máscara Año 2000, Jr. formed the stable El Consejo (\"The Council\") with former CMLL workers El Texano, Jr. and Toscano. On August 5 in the main event of Triplemanía XX, Máscara Año 2000, Jr. was defeated by Dr. Wagner, Jr. in a Mask vs. Mask match. Following the loss, Reyes was forced to unmask.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1195,1743],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":29,"matchLayout":66,"psychology":58,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":62,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":56,"brandBuilding":54,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":69,"awareness":58,"judgement":75}},{"id":465,"name":"Monster Clown","realName":"Monster Clown","picture":"Monster Clown.jpg","ability":47,"currentAbility":52,"potentialAbility":52,"charisma":55,"micSkills":44,"popularity":5,"condition":68,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":105,"height":182,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1976-02-24T00:00:00.000Z","debut":"1997-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Monster Clown is the ring name of a Mexican Luchador enmascarado, or masked professional wrestler. He is best known as part of Los Psycho Circus in Asistencia Asesoría y Administración (AAA) along with Psycho Clown and Murder Clown where they portray a trio of \"evil clowns\". The wrestler who would later be known as Monster Clown began his professional wrestling career in 1997 as the enmascarado (masked wrestler) \"Highlander\" working primarily in and around the Tijuana, Baja California area. He some times worked on Asistencia Asesoría y Administración (AAA) shows when the promotion ran shows in Tijuana, but was not a full time member of the roster. In 200X he began working more for AAA as AAA owner Antonio Peña came up with a new ring character for him called \"Aliens\". The \"Aliens\" character was that of an actual alien from space who had come to earth to wrestle. He was even given a mascota (a Mini-Estrella companion) called \"Mungo\".","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1205],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":64,"storytelling":65,"productFit":100,"riskTaking":40,"matchLayout":65,"psychology":64,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":30,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":62,"brandBuilding":53,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":71,"awareness":64,"judgement":78}},{"id":466,"name":"Murder Clown","realName":"Murder Clown","picture":"Murder Clown.jpg","ability":47,"currentAbility":47,"potentialAbility":47,"charisma":35,"micSkills":34,"popularity":5,"condition":83,"hardcoreAbility":58,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":131,"height":190,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1986-03-01T00:00:00.000Z","debut":"2007-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"A member of the Psycho Circus. One of the largest men on the AAA roster, Also went by the name of Killer Clown until the threat of being sued made AAA change his name. Los Psycho Circus is a Lucha libre, or professional wrestling, trio. Asistencia Asesoría y Administración (AAA) has a long history of using clown based ring characters ever since the company was founded in 1992, most famously the group known as Los Payasos (Spanish for \"The Clowns\") that existed until 1999. AAA later tried to promote other clown trios such as Payasos del Mal (\"Evil Clowns\") in 2007. It was not until AAA took the wrestler who had worked as Aliens, Kronus (son of Brazo de Plata) and a third wrestler whose previous identity has not been revealed and turned them into Los Psycho Circus.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[1205],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":58,"productFit":100,"riskTaking":37,"matchLayout":58,"psychology":56,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":18,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":62,"brandBuilding":62,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":67,"awareness":56,"judgement":74},"contract":{"id":"tew-contract-466","wrestlerId":466,"promotionId":5,"startDate":"2007-12-14T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":467,"name":"Psycho Clown","realName":"Psycho Clown","picture":"Psycho Clown.jpg","ability":53,"currentAbility":61,"potentialAbility":61,"charisma":72,"micSkills":47,"popularity":26,"condition":79,"hardcoreAbility":46,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":107,"height":185,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1985-12-16T00:00:00.000Z","debut":"2000-04-20T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Psycho Clown is the ring name of a Mexican Luchador enmascarado and son of Luchador José Alvarado Nieves, better known under the ring names Brazo de Plata or Super Porky. He was not trained by his father or any of his uncles for his professional wrestling career, instead Memo Díaz was responsible for training the young Alvarado as well as his brother José Christian. He made his debut in 2000 working as Brazo de Plata, Jr. (\"Silver Arm, Jr.\"), taking his father's name and adopting the same style mask his father had worn. In 2003 he along with his brother (now working as Brazo de Platino, Jr.) and his cousin (working as Brazo de Oro, Jr. began working for Consejo Mundial de Lucha Libre (CMLL) the same company his father worked for. Brazo de Platino, Jr. became Máximo, Brazo de Oro, Jr. became La Máscara and Brazo de Plata, Jr. adopted the enmascarado identity \"Kronos\".","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":67,"productFit":100,"riskTaking":30,"matchLayout":68,"psychology":65,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":48,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":85,"brandBuilding":83,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":67,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-467","wrestlerId":467,"promotionId":5,"startDate":"2006-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":468,"name":"Niño Hamburguesa","realName":"Niño Hamburguesa","picture":"Nino Hamburguesa.jpg","ability":51,"currentAbility":48,"potentialAbility":48,"charisma":57,"micSkills":50,"popularity":4,"condition":89,"hardcoreAbility":43,"injuryProne":100,"type":"wrestler","style":"comedy","gender":"M","weight":101,"height":165,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1996-01-30T00:00:00.000Z","debut":"2011-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ivan Flores is a Mexican wrestler known by the ring name Niño Hamburguesa. He is a former DTU trainee who's become something of a cult favorite for his name and his agility despite his size.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":119,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":56,"productFit":100,"riskTaking":30,"matchLayout":56,"psychology":55,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":23,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":76,"brandBuilding":42,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":73,"awareness":55,"judgement":73},"contract":{"id":"tew-contract-468","wrestlerId":468,"promotionId":119,"startDate":"2026-04-01T00:00:00.000Z","endDate":"2028-04-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-04-01T00:00:00.000Z","wage":1000},{"id":470,"name":"Pasion Kristal","realName":"Pasion Kristal","picture":"Pasion Krystal.jpg","ability":76,"currentAbility":83,"potentialAbility":83,"charisma":89,"micSkills":82,"popularity":3,"condition":71,"hardcoreAbility":71,"injuryProne":100,"type":"writer","style":"powerhouse","gender":"M","weight":78,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1976-01-09T00:00:00.000Z","debut":"1994-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"Pasion Crystal is a Mexican wrestler whose real name is not public knowledge. Brought into AAA to complete an exotico trio with Cassandro and Pimpinela Escarlata to continue their feud with the Night Queens. While that feud was dropped from TV about five seconds later, he continues to wrestle on AAA spot shows, often teaming with Pimpi.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":69,"productFit":100,"riskTaking":22,"matchLayout":70,"psychology":65,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":45,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":72,"brandBuilding":40,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":53,"awareness":65,"judgement":79}},{"id":471,"name":"Penta El Zero M","realName":"Penta El Zero M","picture":"Penta El 0M.jpg","ability":75,"currentAbility":67,"potentialAbility":67,"charisma":70,"micSkills":75,"popularity":44,"condition":80,"hardcoreAbility":80,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":91,"height":177,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1985-02-05T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Penta El Zero M is a masked Mexican luchador who works in America, Canada, Mexico and the British Isles. He is a Lightweight who is classed as using a Luchador style. He is one half of Lucha Brothers alongside Rey Fénix. He is best known for his work with AEW, AAA, CMLL, IMPACT, PWG, wXw, MLW, RevPro, DEFY, Lucha Ungrnd, The Crash, IWRG, AAW, FCP, DTU and Defiant. He is currently an AEW World Trios champion. He was one half of the Tag Team Of The Year in 2019.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[1207,1902,2431,3711],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":71,"storytelling":75,"productFit":100,"riskTaking":22,"matchLayout":76,"psychology":71,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":62,"characterCoaching":86,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":86,"brandBuilding":73,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":58,"awareness":71,"judgement":83},"contract":{"id":"tew-contract-471","wrestlerId":471,"promotionId":64,"startDate":"2024-12-06T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":472,"name":"Polvo de Estrellas","realName":"Polvo de Estrellas","picture":"Polvo De Estrellas.jpg","ability":55,"currentAbility":55,"potentialAbility":55,"charisma":54,"micSkills":58,"popularity":4,"condition":59,"hardcoreAbility":61,"injuryProne":96,"type":"wrestler","style":"powerhouse","gender":"M","weight":94,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1966-05-26T00:00:00.000Z","debut":"1984-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Fidel (or Felipe) Alavarado is a Mexican wrestler, known primarily as Polvo de Estrellas (Stardust), an Exotico character. Debuting in 1987 as Adrian, he would go on to become one of the more bizarre characters in Mexico (and that says something). He is a tenacious and driven worker who has been \"walking with class and glamour\" in the AAA for 10+ years! He also had a short lived stint as a member of Los Bizaros in AAA under the name Amadeus.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":25,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":45,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":67,"brandBuilding":33,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":78,"awareness":63,"judgement":78}},{"id":474,"name":"Súper Fly","realName":"Súper Fly","picture":"Super Fly.jpg","ability":65,"currentAbility":60,"potentialAbility":60,"charisma":51,"micSkills":66,"popularity":4,"condition":86,"hardcoreAbility":79,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":82,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1987-02-24T00:00:00.000Z","debut":"2001-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Super Fly is the ring name of a Mexican Luchador enmascarado. Super Fly's real name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans. Through his fathers contacts the future Super Fly was trained by highly renowned Mexican wrestling trainer Skayde and by Psicosis before making his debut at just 14 years of age. He originally did not wrestle under the name \"Super Fly\" but employed an unknown ring name and for the first couple of years. In 2005 he signed a contract with Asistencia Asesoría y Administración (AAA), one of Mexico's two largest promotions. In 2006 he became one of the founding members of a group called Real Fuerza Aérea (Spanish for \"Royal Air Force\") alongside Laredo Kid and Nemesis. After over a year of on and off teasing, Super Fly finally turned rudo on November 28, 2010 but by 2012 he was once again a tecnico and rejoined Real Fuerza Aérea.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":65,"productFit":100,"riskTaking":29,"matchLayout":67,"psychology":57,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":62,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":51,"brandBuilding":48,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":77,"awareness":57,"judgement":74}},{"id":475,"name":"Ultimo Gladiador","realName":"Ultimo Gladiador","picture":"Ultimo Gladiador.jpg","ability":65,"currentAbility":56,"potentialAbility":56,"charisma":55,"micSkills":65,"popularity":4,"condition":81,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":96,"height":180,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1978-03-28T00:00:00.000Z","debut":"1997-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Gerardo Campos Poza, better known under his ring name Último Gladiador (Spanish for \"Last Gladiator\") is a Mexican Luchador enmascarado. Campos trained for his professional under Black Man and Rocky Santana as well as receiving additional training by his uncle Pantera later on. He made his debut on June 11, 1997 as a rúdo character called El Potro. Campos' relationship with wrestler Crazy Boy landed him a change to work for Asistencia Asesoría y Administración (AAA), one of Mexico's largest wrestling promotions, when Crazy Boy hurt his back and needed someone to replace him in tag team matches. Último Gladiador joined the Mexican Powers and teamed with Juventud Guerrera and Joe Líder to make his AAA debut on February 10, 2008.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1198,3295,3313],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":65,"productFit":100,"riskTaking":35,"matchLayout":68,"psychology":55,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":40,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":55,"brandBuilding":68,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":75,"awareness":55,"judgement":73}},{"id":476,"name":"Vampiro","realName":"Vampiro","picture":"Vampiro.jpg","ability":56,"currentAbility":52,"potentialAbility":52,"charisma":62,"micSkills":50,"popularity":24,"condition":48,"hardcoreAbility":69,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":113,"height":187,"base":"Canada","birthplace":"Canada","dateOfBirth":"1967-05-31T00:00:00.000Z","debut":"1984-07-29T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ian Richard Hodgkinson is a Canadian  professional wrestler better known by his ring name Vampiro. Hodgkinson has wrestled for various wrestling promotions, but is best known for his time in Consejo Mundial de Lucha Libre during the early 1990s. He later wrestled for World Championship Wrestling, where he held the WCW Tag Team Championship with The Great Muta. In his professional wrestling career, Hodgkinson is a six time World heavyweight champion having won the NWE World Heavyweight Championship once, WWC Universal Heavyweight Championship once, UWA World Heavyweight Championship once, WSX Championship once, and JCW Heavyweight Championship twice. He recently joined the Guardian Angels and will head the group's chapter in Mexico City.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":120,"teams":[1414],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":76,"storytelling":75,"productFit":100,"riskTaking":37,"matchLayout":74,"psychology":76,"workerManagement":100,"trainingIntensity":48,"technicalCoaching":34,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":78,"brandBuilding":63,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":48,"consistency":38,"awareness":76,"judgement":86},"contract":{"id":"tew-contract-476","wrestlerId":476,"promotionId":120,"startDate":"2026-01-08T00:00:00.000Z","endDate":"2028-01-08T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-01-08T00:00:00.000Z","wage":1000},{"id":477,"name":"Cynthia Moreno","realName":"Cynthia Moreno","picture":"Cynthia Moreno.jpg","ability":64,"currentAbility":61,"potentialAbility":61,"charisma":76,"micSkills":67,"popularity":5,"condition":76,"hardcoreAbility":54,"injuryProne":87,"type":"wrestler","style":"high flyer","gender":"F","weight":69,"height":162,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1970-07-23T00:00:00.000Z","debut":"1987-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Flavia Antonia Moreno León is a Mexican Luchadora, better known under the ring name Cynthia Moreno (sometimes spelled \"Cinthia Moreno\") She is currently working for Asistencia Asesoría y Administración (AAA). Moreno is a part of an extended wrestling family that includes her father Alfonso Moreno, her brother who wrestles as El Oriental and her sisters, Esther, Alda and Rossy Moreno. Flavia Antonia Moreno León is the daughter of Alfonso \"Acorazado\" (Spanish for \"Battleship\") Moreno and was trained by her father as well as by Pepe Casas for her professional wrestling career. She made her debut in 1987 in Arena Azteca Budoka in Nezahualcoyotl, Mexico State, the building her father promoted at the time, under the name Cynthia Moreno. In the early 1990s Cynthia and her sister Esther Moreno travelled to Japan to wrestle for All Japan Women's Pro-Wrestling. She is a former two times holder of the AAA World Mixed Tag Team Championship with her brother El Oriental.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3136,3137,3138,3139],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":71,"storytelling":76,"productFit":100,"riskTaking":22,"matchLayout":78,"psychology":71,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":61,"characterCoaching":71,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":71,"brandBuilding":53,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":78,"awareness":71,"judgement":83}},{"id":478,"name":"La Hechicera","realName":"La Hechicera","picture":"La Hechicera.jpg","ability":45,"currentAbility":47,"potentialAbility":47,"charisma":46,"micSkills":43,"popularity":2,"condition":87,"hardcoreAbility":47,"injuryProne":100,"type":"wrestler","style":"striker","gender":"F","weight":115,"height":182,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1972-12-28T00:00:00.000Z","debut":"1998-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Low ranked AAA ruda, who mostly has just made occasional appearances and participated in Reina de Reinas tournaments. She's been in AAA since 1998, though there are years where she doesn't appear to turn on TV. Seemed to be dropped for good in late 2008, but turned up on spot show lineups in 2009. Still doesn't make TV, but fills out relevos AAA and women's tag matches on non televised shows.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":57,"productFit":100,"riskTaking":36,"matchLayout":57,"psychology":58,"workerManagement":100,"trainingIntensity":36,"technicalCoaching":26,"characterCoaching":33,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":33,"brandBuilding":12,"socialMediaSavvy":27,"ruleKnowledge":0,"positioning":20,"reactionSpeed":36,"consistency":49,"awareness":58,"judgement":75}},{"id":479,"name":"La Magnífica","realName":"La Magnífica","picture":"La Magnifica.jpg","ability":40,"currentAbility":38,"potentialAbility":38,"charisma":23,"micSkills":41,"popularity":2,"condition":88,"hardcoreAbility":41,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":60,"height":157,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1989-03-30T00:00:00.000Z","debut":"2007-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Tamara Rubí Barrón García is a luchadora. Daugther of Gran Cochisse, briefly wrestled in Arena Coliseo Guadalajara before her father was fired as trainer at the gym. Occasionally appeared on Guadalajara independent shows. Won the 2011 AAA Quien Pinta Para La Corona championship for women, but strangely never appeared on television and stopped being mentioned as a winner. AAA never explained what happened. Resurfaced in a match at the Guadalajara stop on the 2012 QPPLC tryout tour. Again appeared at the 2012 Mexico City final and was acknowledged as last year's champion for the first time since she won. Her brother Saturno won the 2012 men's contest at the same show.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":35,"storytelling":39,"productFit":80,"riskTaking":43,"matchLayout":40,"psychology":35,"workerManagement":80,"trainingIntensity":65,"technicalCoaching":44,"characterCoaching":40,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":40,"brandBuilding":35,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":16,"reactionSpeed":65,"consistency":68,"awareness":35,"judgement":53}},{"id":480,"name":"Dr. Wagner Jr.","realName":"Dr. Wagner Jr.","picture":"Dr Wagner Jr_alt.jpg","ability":79,"currentAbility":69,"potentialAbility":69,"charisma":76,"micSkills":68,"popularity":30,"condition":67,"hardcoreAbility":49,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":98,"height":175,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1965-08-12T00:00:00.000Z","debut":"1986-04-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Juan Manuel González Barrón is a Mexican Luchador Enmascarado who is best known under the ring name Dr. Wagner, Jr.. On the day that Dr. Wagner, Jr. was to make his in-ring debut as his father's tag-team partner, Wagner, Sr. was involved in a car accident that killed his long-time partner Angel Blanco, leaving Wagner, Sr. disabled and unable to continue his wrestling career. As Dr. Wagner, Jr. he has worked mainly in Mexico for Consejo Mundial de Lucha Libre (CMLL) and Asistencia Asesoría y Administración (AAA), Mexico's two largest professional wrestling promotions as well as working for several Japanese promotions including New Japan Pro Wrestling (NJPW). Gonzalez is the son of professional wrestler Dr. Wagner, brother of Silver King and the father of recently debuted professional wrestler Dr. Wagner III.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":119,"teams":[1232,3154,3155,3156,3157,3158],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":85,"storytelling":87,"productFit":100,"riskTaking":21,"matchLayout":88,"psychology":85,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":67,"characterCoaching":84,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":84,"brandBuilding":82,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":65,"awareness":85,"judgement":91},"contract":{"id":"tew-contract-480","wrestlerId":480,"promotionId":119,"startDate":"2023-01-28T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":481,"name":"L.A. Park","realName":"L.A. Park","picture":"LA Park.jpg","ability":76,"currentAbility":70,"potentialAbility":70,"charisma":77,"micSkills":77,"popularity":25,"condition":65,"hardcoreAbility":58,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":136,"height":182,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1965-11-14T00:00:00.000Z","debut":"1982-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"The dead has risen.\r\n\r\nNo stranger to MLW, LA Park competed in the 2002 World Heavyweight Title Tournament as well as taking part in one of the most talked-about rivalries in the league’s history as he battled Sabu from 2002 through 2003.\r\n\r\nSince then, the man known originally as La Parka has continued his wickedness south of the border where he has ascended to legendary status with his wild, chaotic brawls. LA Park regularly performs in the main event in 20,000-seat arenas across Mexico.\r\n\r\nDonning his iconic skeleton mask, this rudo is virtually unstoppable. Swinging a chair, which he has wrapped around countless opponents, LA Park has always been one of the most unpredictable men in the sport. That makes an encounter with “The Chairman” one most men desperately try to avoid.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2003,2324,2325,2327],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":82,"storytelling":83,"productFit":100,"riskTaking":19,"matchLayout":83,"psychology":82,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":57,"characterCoaching":84,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":84,"brandBuilding":67,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":80,"awareness":82,"judgement":89}},{"id":483,"name":"Sexy Xtar","realName":"Sexy Xtar","picture":"Sexy Star.jpg","ability":36,"currentAbility":44,"potentialAbility":44,"charisma":46,"micSkills":39,"popularity":9,"condition":79,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":57,"height":157,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1982-09-20T00:00:00.000Z","debut":"2006-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Dulce Maria García Rivas is a Mexican Luchadora enmascarada, who performs under the ring name Sexy Star. She is a former two-time AAA Reina de Reinas Champion as a member of La Legión Extranjera. She previously wrestled under the name Dulce Poly and held the FILL Women's Championship that name. Dulce García was born on September 20, 1982 in Monterrey, Nuevo León. Growing up she had devoted herself to sports such as boxing, kickboxing and Muay Thai. García made her professional wrestling debut on August 29, 2006 under the ring name Dulce Poly, on a Federacion Internacional de Lucha Libre (FILL) show. In FILL she often teamed up with one of her trainers, Humberto Garza, Jr. and together the two won the FILL Mixed Tag Team Championship at one point.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":49,"productFit":100,"riskTaking":43,"matchLayout":51,"psychology":44,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":37,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":54,"brandBuilding":75,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":55,"awareness":44,"judgement":66}},{"id":485,"name":"Copetes Salazar","realName":"Copetes Salazar","picture":"Copetes Salazar.jpg","ability":67,"currentAbility":75,"potentialAbility":75,"charisma":62,"micSkills":79,"popularity":2,"condition":53,"hardcoreAbility":65,"injuryProne":83,"type":"referee","style":"all rounder","gender":"M","weight":82,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1961-09-27T00:00:00.000Z","debut":"1979-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Raul \"Copetes\" Salazar is a former luchador turned referee. He went by many different names during his time as an in ring competitor including; Mister Kamba, Super Sónico, Galático, Apolo (1990-1995) and Century 2000. Currently he is a referee with the AAA promotion in Mexico, which is also where he spent most of his career wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":45,"storytelling":54,"productFit":100,"riskTaking":27,"matchLayout":57,"psychology":45,"workerManagement":100,"trainingIntensity":20,"technicalCoaching":20,"characterCoaching":47,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":47,"brandBuilding":18,"socialMediaSavvy":36,"ruleKnowledge":75,"positioning":80,"reactionSpeed":20,"consistency":22,"awareness":45,"judgement":67}},{"id":486,"name":"Dorian Roldán","realName":"Dorian Roldán","picture":"Dorian Roldan.jpg","ability":53,"currentAbility":49,"potentialAbility":49,"charisma":63,"micSkills":56,"popularity":5,"condition":100,"hardcoreAbility":39,"injuryProne":100,"type":"manager","style":"all rounder","gender":"M","weight":81,"height":175,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1984-10-15T00:00:00.000Z","debut":"2002-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"After the death of uncle, Antonio Pena, young Dorian took control of AAA with his father Joaquin Roldan. In front of the cameras, Dorian is the rebelling rudo son of current AAA owners Joaquin and Marisela. Backstage, Dorian is in charge of the creative direction of the company and many of the new initiatives.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":60,"brandBuilding":47,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"contract":{"id":"tew-contract-486","wrestlerId":486,"promotionId":5,"startDate":"2009-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":488,"name":"El Hijo del Tirantes","realName":"El Hijo del Tirantes","picture":"El Hijo del Tirantes.jpg","ability":45,"currentAbility":42,"potentialAbility":42,"charisma":27,"micSkills":39,"popularity":4,"condition":93,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":90,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1977-03-04T00:00:00.000Z","debut":"1997-02-26T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Much like his father, started out as a wrestler but ended up becoming an AAA referee. Normally a tecnico, but can be bullied into going along with the rudos. Really loves to partially notice an offense worth disqualification, consider calling for the DQ, poll the crowd about the offense, and resolving the situation by doing nothing at all. Incongruously more muscular than many of the wrestlers in his matches, he wears outfits to show off his upper body. Hijo del Tirantes has become the top rudo referee in AAA. Whenever the AAA side wins a major battle against the Legion, Hijo del Tirantes will be forced to call matches fairly. This leads to a few weeks of tension, before the story is forgotten and Hijo del Tirantes returns to his usual activities.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":53,"productFit":45,"riskTaking":28,"matchLayout":52,"psychology":55,"workerManagement":45,"trainingIntensity":48,"technicalCoaching":18,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":73,"brandBuilding":28,"socialMediaSavvy":68,"ruleKnowledge":73,"positioning":67,"reactionSpeed":48,"consistency":65,"awareness":55,"judgement":51},"contract":{"id":"tew-contract-488","wrestlerId":488,"promotionId":5,"startDate":"1997-02-26T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":490,"name":"Andrade El Idolo","realName":"Andrade El Idolo","picture":"Andrade.jpg","ability":70,"currentAbility":72,"potentialAbility":72,"charisma":67,"micSkills":84,"popularity":52,"condition":86,"hardcoreAbility":88,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":95,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1989-11-03T00:00:00.000Z","debut":"2003-10-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"As a third-generation luchador, Andrade was born to be a Superstar, and he’s happy for it. The life suits him. Endlessly talented and even more confident, Andrade enjoys the perks that come with squared circle stardom. Andrade’s inherent skill for the family trade was unmistakable from the moment he debuted at age 13. He first established himself in his native Mexico and Japan, capturing championships in both countries. In WWE under the direction of Zelina Vega, Andrade used uncanny speed and ring awareness to ascend to the top of the black-and-gold brand when he captured the NXT Championship at NXT TakeOver: WarGames in 2017. After joining SmackDown in 2018, Andrade took every opportunity to catch the attention of the WWE Universe and put on several instant classics during an intense rivalry with Rey Mysterio. With multiple championship reigns and several show-stealing matches on his resume, Andrade's future looks as bright as ever.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[2060],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":75,"storytelling":78,"productFit":100,"riskTaking":19,"matchLayout":79,"psychology":75,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":75,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":79,"brandBuilding":82,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":63,"awareness":75,"judgement":85},"contract":{"id":"tew-contract-490","wrestlerId":490,"promotionId":38,"startDate":"2025-12-22T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":491,"name":"Low Ki","realName":"Low Ki","picture":"Low-Ki.jpg","ability":67,"currentAbility":66,"potentialAbility":66,"charisma":78,"micSkills":78,"popularity":21,"condition":77,"hardcoreAbility":76,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":79,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1979-09-06T00:00:00.000Z","debut":"1998-10-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Pound-for-pound, Low Ki is one of the most dangerous fighters in the sport. Employing knockout power with his quick, vicious strikes, Low Ki is capable of ending any match at any time. Not only does Low Ki utilize explosive kicks, he is also the master of an array of chops, submission holds and moves executed with precision second to none. A devout martial artist since childhood, Low Ki blends various martial arts techniques and disciplines, making him a challenge for adversaries of any size, regardless of their fighting system.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1573],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":63,"productFit":100,"riskTaking":33,"matchLayout":66,"psychology":55,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":73,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":56,"brandBuilding":63,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":87,"awareness":55,"judgement":73}},{"id":492,"name":"Kota Ibushi","realName":"Kota Ibushi","picture":"Kota Ibushi.jpg","ability":81,"currentAbility":71,"potentialAbility":71,"charisma":71,"micSkills":71,"popularity":43,"condition":66,"hardcoreAbility":79,"injuryProne":96,"type":"wrestler","style":"high flyer","gender":"M","weight":93,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-05-21T00:00:00.000Z","debut":"2004-07-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kota Ibushi is a Japanese wrestler who works in America, Mexico and Japan. He is a Middleweight who is classed as using a Technician Flyer style. He is best known for his work with WWE, NJPW, DDT, ROH and GCW. He was voted Independent Wrestler Of The Year in 2013.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1078,1079,1080,2085,2945],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":76,"productFit":100,"riskTaking":35,"matchLayout":77,"psychology":73,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":72,"characterCoaching":71,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":71,"brandBuilding":79,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":62,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-492","wrestlerId":492,"promotionId":76,"startDate":"2023-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000,"injury":{"type":"Broken Leg","daysToRecover":5},"returnDate":"2026-04-17T00:00:00.000Z"},{"id":493,"name":"Extreme Tiger","realName":"Extreme Tiger","picture":"Extreme Tiger.jpg","ability":62,"currentAbility":54,"potentialAbility":54,"charisma":65,"micSkills":44,"popularity":11,"condition":77,"hardcoreAbility":44,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":71,"height":157,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1981-04-04T00:00:00.000Z","debut":"1998-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Extreme Tiger is a masked Mexican luchador who works in America, Mexico, the British Isles and Japan. He is a Small worker who is classed as using a Luchador style. He is best known for his work with AAA, IMPACT, NOAH, MLW, The Crash, WRESTLE-1, IWRG, DTU and SWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":60,"productFit":100,"riskTaking":37,"matchLayout":62,"psychology":53,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":53,"characterCoaching":47,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":47,"brandBuilding":62,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":64,"awareness":53,"judgement":72}},{"id":494,"name":"Taiji Ishimori","realName":"Taiji Ishimori","picture":"Taiji Ishimori.jpg","ability":56,"currentAbility":60,"potentialAbility":60,"charisma":55,"micSkills":51,"popularity":25,"condition":70,"hardcoreAbility":69,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":75,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1983-02-10T00:00:00.000Z","debut":"2002-05-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Taiji Ishimori is a Japanese wrestler who works in Canada, Mexico and Japan. He is a Small worker who is classed as using a Technician Flyer style. He is best known for his work with NJPW, AAA, IMPACT, NOAH, wXw and AJPW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[1726,2044,3024,3034,4355],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":69,"productFit":100,"riskTaking":30,"matchLayout":71,"psychology":63,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":62,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":63,"brandBuilding":56,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":71,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-494","wrestlerId":494,"promotionId":38,"startDate":"2018-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":495,"name":"Takeshi Morishima","realName":"Takeshi Morishima","picture":"Takeshi Morishima.jpg","ability":73,"currentAbility":65,"potentialAbility":65,"charisma":56,"micSkills":78,"popularity":10,"condition":65,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":125,"height":187,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-10-15T00:00:00.000Z","debut":"1998-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Takeshi Morishima is a Japanese professional wrestler.  He's a former ROH World Heavyweight and GHC Heavyweight champion. Morishima currently holds a position on Pro Wrestling Noah's board of directors. Morshima has also wrestled in the United States and United Kingdom. He competed in Harley Race's World League Wrestling promotion in 2003, defending the WLW Heavyweight Championship, which he had won from Ron Harris while Harris toured Japan.  Morishima returned to the United States in February 2007, wrestling four matches with Ring of Honor. He lost to Samoa Joe on February 16, 2007 before defeating Homicide in a match for the ROH World Championship on the subsequent evening, thus becoming the first non-American to hold the title. On January 22, 2012, Morishima defeated Go Shiozaki to win the GHC Heavyweight Championship for the second time.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3060,3299],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":76,"productFit":100,"riskTaking":25,"matchLayout":77,"psychology":73,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":54,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":55,"brandBuilding":55,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":68,"awareness":73,"judgement":84}},{"id":496,"name":"Akuma","realName":"Akuma","picture":"Akuma_unmasked.jpg","ability":72,"currentAbility":63,"potentialAbility":63,"charisma":77,"micSkills":54,"popularity":4,"condition":92,"hardcoreAbility":57,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":88,"height":175,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1995-08-28T00:00:00.000Z","debut":"2012-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Akuma is the ring name of a Mexican luchador enmascarado. The wrestler known as Akuma is the younger brother of Consejo Mundial de Lucha Libre (CMLL) wrestler Demus 3:16 who works in CMLL's Mini-Estrella division. He is the brother-in-law of retired professional wrestler Hiroka Yaginuma who is married to Demus 3:16. Lucha libre has a tradition of keeping the real name and personal information of masked wrestlers private if they have never been officially unmasked, it makes it possible that Akuma has worked under a different ring name and masked identity before May 12, 2012 where he made his in ring debut under that name. His official CMLL debut came on September 16, 2012 on a show in Arena Mexico where he teamed up with Guerrero Negro, Jr. to defeat Oro, Jr. and Robin.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[3070],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":66,"productFit":100,"riskTaking":22,"matchLayout":67,"psychology":63,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":58,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":76,"brandBuilding":61,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":71,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-496","wrestlerId":496,"promotionId":11,"startDate":"2012-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":498,"name":"El Terrible","realName":"El Terrible","picture":"El Terrible.jpg","ability":67,"currentAbility":68,"potentialAbility":68,"charisma":57,"micSkills":78,"popularity":8,"condition":75,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":105,"height":182,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1976-04-17T00:00:00.000Z","debut":"1995-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Damián Gutiérrez Hernández is a Mexican professional wrestler known by the ring name El Terrible. Gutiérrez began wrestling in his native Monterrey and elsewhere for smaller independent promotions under a mask as El Engendro del Mal (The Bad Boy). In 2002, he debuted in Consejo Mundial de Lucha Libre without a mask as Damián El Terrible but later the \"Damián\" part of his name was dropped, possibly to alleviate any confusion with Damián 666. He was part of Shocker's first \"University of 1000% Guapos,\" a group of undercarders competing for a spot in Shocker's Los Guapos group. On May 11, 2008, he and Damian 666 lost to The Hell Warriors (Animal and Power) in Mexico City in a match for the then recently vacated UWA World Tag Team Championship. On August 31, El Terrible defeated New Japan Pro Wrestling representative Hiroshi Tanahashi to become the 2012 Universal Champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[1194,1367,1368,4245],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":77,"storytelling":79,"productFit":100,"riskTaking":28,"matchLayout":80,"psychology":77,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":59,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":76,"brandBuilding":62,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":73,"awareness":77,"judgement":86},"contract":{"id":"tew-contract-498","wrestlerId":498,"promotionId":11,"startDate":"2002-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":499,"name":"Rush","realName":"Rush","picture":"Rush.jpg","ability":76,"currentAbility":70,"potentialAbility":70,"charisma":83,"micSkills":56,"popularity":36,"condition":87,"hardcoreAbility":80,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":93,"height":180,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1988-09-29T00:00:00.000Z","debut":"2006-09-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"RUSH has the in-ring talent, the look, the charisma and the swagger of a superstar. The international sensation made his much-anticipated Ring of Honor debut at the end of 2018 and signed an exclusive contract with ROH shortly thereafter.\r\n\r\nRUSH is one of the biggest names in Mexico and the founder of the influential Los Ingobernables faction. Known as El Toro Blanco (The White Bull), RUSH is a former CMLL World Light Heavyweight Champion, two-time CMLL World Tag Team Champion and CMLL World Trios Champion. Rush also has made an impact in New Japan Pro-Wrestling. He has competed in the G1 Climax and World Tag League tournaments and scored victories over stars such as Tetsuya Naito and Shinsuke Nakamura.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1193],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":74,"productFit":100,"riskTaking":20,"matchLayout":75,"psychology":70,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":58,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":85,"brandBuilding":88,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":79,"awareness":70,"judgement":82},"contract":{"id":"tew-contract-499","wrestlerId":499,"promotionId":76,"startDate":"2022-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":500,"name":"Último Guerrero","realName":"Último Guerrero","picture":"Ultimo Guerrero.jpg","ability":70,"currentAbility":76,"potentialAbility":76,"charisma":74,"micSkills":65,"popularity":21,"condition":74,"hardcoreAbility":83,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":95,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1972-03-01T00:00:00.000Z","debut":"1990-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Último Guerrero  is a Mexican Luchador enmascarado. Último Guerrero was trained in \"Gimnasio El Ranchero\" by Tinito and Halcón Suriano and made his debut in 1990. Guerrero is a charter member of the stable of wrestlers known as Los Guerreros de Infierno / Los Guerreros de Atlantida and has made appearances for Total Nonstop Action Wrestling  where he as part of Team Mexico won the 2008 World X Cup. Último Guerrero is not related to Lucha libre legend Gory Guerrero or any of his children, \"Guerrero\" in this case is the Spanish word for warrior and not his surname. His name is literally translated to The Last Warrior in English. In early 2013 the long running feud between Atlantis and Último Guerrero came to the forefront of CMLL booking once more. The two were booked for the 2013 Torneo Nacional de Parejas Increibles tournament, forcing the two rivals to team up. Before their qualifying round both Atlantis and Gurrero stated that they would put their differences aside.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[1068,1187,1191,1232],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":86,"storytelling":88,"productFit":100,"riskTaking":14,"matchLayout":88,"psychology":86,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":73,"characterCoaching":84,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":84,"brandBuilding":77,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":80,"awareness":86,"judgement":92},"contract":{"id":"tew-contract-500","wrestlerId":500,"promotionId":11,"startDate":"1997-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":501,"name":"Atlantis","realName":"Atlantis","picture":"Atlantis.jpg","ability":65,"currentAbility":71,"potentialAbility":71,"charisma":77,"micSkills":84,"popularity":20,"condition":60,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":92,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1962-09-28T00:00:00.000Z","debut":"1983-06-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Atlantis made his professional wrestling debut on June 12, 1983 after training under world renowned Mexican wrestling trainer Diablo Velazco for just under a year. He adopted the masked ring persona of \"Atlantis\", a supposed warrior from the lost city of Atlantis, complete with a mask that had the image of two fish on it.[2] After working for various Mexican promotions for the first year of his career Atlantis became a regular for Empressa Mexicana de Lucha Libre (EMLL), Mexico's oldest professional wrestling promotion. After being a career tecnico, Atlantis was changed to a rudo in 2005. It did not appear to be his idea or even the promotion's idea, but the fans forcing a change. CMLL had been building up Atlantis, including weekly Seccion Azul features trumpeting his work with kids or focusing an award being given to Atlantis, to push him as the ultimate good guy.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":88,"storytelling":89,"productFit":100,"riskTaking":15,"matchLayout":89,"psychology":88,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":73,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":82,"brandBuilding":80,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":70,"awareness":88,"judgement":93},"contract":{"id":"tew-contract-501","wrestlerId":501,"promotionId":11,"startDate":"1983-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":502,"name":"Samuray del Sol","realName":"Samuray del Sol","picture":"Kalisto.jpg","ability":47,"currentAbility":56,"potentialAbility":56,"charisma":47,"micSkills":46,"popularity":26,"condition":86,"hardcoreAbility":52,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":77,"height":165,"base":"USA","birthplace":"United States","dateOfBirth":"1986-11-14T00:00:00.000Z","debut":"2006-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Samuray del Sol is a masked American wrestler who works in the USA, Canada, Mexico, the British Isles, Europe and India. He is a 5'6\", 169lb worker who is classed as using a Luchador style. He uses the Del Sol Driver and the Rising Sun as his finishers. He has regular tag teams with Cinta de Oro (The Latin Dragons) and Lince Dorado (Good Lucha Things). He is best known for his work with WWE, CMLL, TNA, AAA, NXT, PWG, EVOLVE, REVOLVER, AAW, AIW, DTU, CZW and WXM. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1584,1585,3513,3946,3961],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":34,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":53,"characterCoaching":45,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":45,"brandBuilding":64,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":56,"awareness":56,"judgement":74}},{"id":503,"name":"Averno","realName":"Averno","picture":"Averno.jpg","ability":68,"currentAbility":73,"potentialAbility":73,"charisma":88,"micSkills":58,"popularity":13,"condition":72,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":79,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1977-03-09T00:00:00.000Z","debut":"1995-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Renato Ruíz Cortes, is a Mexican professional wrestler. He is best known for his time in Consejo Mundial de Lucha Libre as Averno, where he is a former one–time World Middleweight Champion and a three–time World Tag Team Champion. His ring name is the Spanish rendering of Avernus, the crater where Aeneas descended into the underworld in Virgil's Aeneid and is most commonly translated as \"Hell\" in English. He began wrestling in 1995 under the name Rencor Latino (Latin Hostility) after being trained by his father, a former wrestler and referee named Rodolfo Ruiz. During a televised segment Satánico used his supposed \"satanic powers\" to turn técnico (good guy) Rencor Latino into one of his \"minions\", the rudo (bad guy) known as \"Averno\". On June 17 at Juicio Final, Averno was defeated by La Máscara two falls to one, forcing him to unmask himself.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[1186,1188,1189],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":82,"storytelling":83,"productFit":100,"riskTaking":17,"matchLayout":83,"psychology":82,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":74,"characterCoaching":81,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":81,"brandBuilding":58,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":75,"awareness":82,"judgement":89},"contract":{"id":"tew-contract-503","wrestlerId":503,"promotionId":11,"startDate":"2021-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":504,"name":"La Máscara","realName":"La Máscara","picture":"La Mascara.jpg","ability":62,"currentAbility":57,"potentialAbility":57,"charisma":65,"micSkills":42,"popularity":5,"condition":75,"hardcoreAbility":55,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":85,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1982-01-08T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Felipe de Jesús Alvarado Mendoza aka La Máscara is a Mexican professional wrestler. La Mascara is the son of Brazo de Oro, cousin of Psycho Clown and Máximo and nephew to Brazo de Plata and El Brazo. Making his professional debut on April 2, 2000, La Mascara spent much of his early career as a midcard tecnico in Consejo Mundial de Lucha Libre (CMLL). He debuted in CMLL as Brazo de Oro Jr. Like the other sons of Los Brazos, he took up a new gimmick in summer 2005 to create own identity. La Mascara has been pushed strongly since changing to that gimmick (from Brazo de Oro Jr.), with some thought that it might be due to his family connections. His work has appeared to catch up with his push. On January 22, 2011, La Máscara made his Japanese debut, when he took part in the Fantasticamania 2011 weekend, co-promoted by CMLL and New Japan Pro Wrestling in Tokyo.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1193],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":69,"productFit":100,"riskTaking":22,"matchLayout":71,"psychology":62,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":68,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":44,"brandBuilding":60,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":75,"awareness":62,"judgement":77}},{"id":505,"name":"Apocalipsis","realName":"Apocalipsis","picture":"Apocalipsis.jpg","ability":61,"currentAbility":56,"potentialAbility":56,"charisma":66,"micSkills":68,"popularity":3,"condition":68,"hardcoreAbility":51,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":90,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-01-16T00:00:00.000Z","debut":"1997-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Juan Carlos Contreras Uribe better known under the ring name Apocalipsis, is a Mexican luchador enmascarado. Juan Contreras made his in ring debut on February 11, 2000 after training under Consejo Mundial de Lucha Libre (CMLL) wrestling trainers Tony Salazar and Jose Luis Feliciano. He adopted the ring name El Koreano for his wrestling character, a martial arts inspired character that supposedly was from South Korea.  He made his Apocalisis debut as part of the 2005 Gran Alternativa tournament, where a Novato or rookie, teamed up with a veteran for a tag team tournament. As Apocalipsis he teamed up with Damian 666 for the tournament.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":74,"storytelling":76,"productFit":100,"riskTaking":20,"matchLayout":76,"psychology":74,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":56,"characterCoaching":32,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":32,"brandBuilding":29,"socialMediaSavvy":25,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":75,"awareness":74,"judgement":84},"contract":{"id":"tew-contract-505","wrestlerId":505,"promotionId":11,"startDate":"2000-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":507,"name":"Principe Odin Jr.","realName":"Principe Odin Jr.","picture":"Artillero.jpg","ability":53,"currentAbility":60,"potentialAbility":60,"charisma":70,"micSkills":57,"popularity":3,"condition":88,"hardcoreAbility":59,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":76,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1982-08-12T00:00:00.000Z","debut":"2001-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Artillero has been a constant opening match guy since his debut. He's always partnered with his (older) brother Super Comando. They've established themselves as a military themed tag team - and sometimes trio with Flecha - and have an ongoing rivalry with Los Rayos Tapatíos and Sombra de Plata (who's not publicly acknowledged as their brother.) At this point, they seem stuck in their card position. On at least one occasion after being reborn as Artillero, he's wrestled as Chamaco Torres for no apparent reason. His career underwent a transformation in 2018 after changing his name to Principe Odin Jr., adopting a name inherited from his father, a prominent independent luchador of the 1970s.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":63,"productFit":100,"riskTaking":33,"matchLayout":65,"psychology":56,"workerManagement":100,"trainingIntensity":53,"technicalCoaching":49,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":66,"brandBuilding":42,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":53,"consistency":73,"awareness":56,"judgement":74}},{"id":509,"name":"Andy Wild","realName":"Andy Wild","picture":"Andy Wild.jpg","ability":49,"currentAbility":42,"potentialAbility":42,"charisma":50,"micSkills":45,"popularity":3,"condition":90,"hardcoreAbility":35,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":125,"height":182,"base":"UK","birthplace":"England","dateOfBirth":"1988-09-05T00:00:00.000Z","debut":"2008-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Andrew Inch is a Scottish wrestler known by his ring name \"Unstoppable\" Andy Wild. He is one of the the fastest rising stars on the UK scene today. Having had huge matches in Scotland with some of the top Independent names in the world, including \"Prince\" Fergal Devitt and Zack Sabre Jr, Wild has firmly established himself as one of the premier wrestlers in Europe with appearances in Germany, Denmark and Spain to name a few. With his sights firmly set on becoming a World Champion, few can argue why Andy Wild is known as, \"Unstoppable\".","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":39,"storytelling":46,"productFit":40,"riskTaking":42,"matchLayout":49,"psychology":39,"workerManagement":40,"trainingIntensity":69,"technicalCoaching":40,"characterCoaching":47,"diagnosis":50,"rehabilitation":50,"prevention":58,"mediaHandling":47,"brandBuilding":44,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":8,"reactionSpeed":69,"consistency":69,"awareness":39,"judgement":39}},{"id":511,"name":"Dustin Rhodes","realName":"Dustin Rhodes","picture":"Dustin Rhodes_alt.jpg","ability":62,"currentAbility":69,"potentialAbility":69,"charisma":79,"micSkills":57,"popularity":34,"condition":74,"hardcoreAbility":59,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":107,"height":190,"base":"USA","birthplace":"United States","dateOfBirth":"1969-04-11T00:00:00.000Z","debut":"1988-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Dustin Patrick Runnels is an American professional wrestler. Runnels is best known as Goldust in WWE. He is also known for performing in various companies such as World Championship Wrestling and Total Nonstop Action Wrestling as Dustin Rhodes. Among the other names Runnels has performed under are Black Reign and Seven. Runnels is the son of \"The American Dream\" Dusty Rhodes and the half brother of Cody Rhodes. Rhodes debuted as a fan favorite in the World Wrestling Federation in late 1990, wrestling as Dustin Rhodes. In February 1991, Rhodes joined World Championship Wrestling, wrestling as \"The Natural\" Dustin Rhodes. In September 1995, Rhodes returned to the World Wrestling Federation, wrestling as a villain nicknamed \"the bizarre one\" because of his freaky, mysterious, very suggestive mannerisms and presence under the name Goldust.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1037,1081,1903,1989,2714,2715,3689,4045,4046],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":84,"storytelling":86,"productFit":100,"riskTaking":12,"matchLayout":87,"psychology":84,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":54,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":88,"mediaHandling":82,"brandBuilding":56,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":78,"awareness":84,"judgement":90},