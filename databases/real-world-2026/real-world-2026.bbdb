 All Japan Women's Dojo and was part of the \"class of 1987\" along with Manami Toyota, Toshiyo Yamada and Etsuko Mita. Shimoda was paired up with Toyota to form a tag team called The Sweethearts. In 2006 Shimoda moved to Mexico and began working regularly for Consejo Mundial de Lucha Libre (CMLL) as well as making frequent trips to Japan to work with a number of Japanese women's promotions, often touring with other CMLL wrestlers.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":73,"teams":[2989],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":82,"storytelling":85,"productFit":100,"riskTaking":24,"matchLayout":86,"psychology":82,"workerManagement":100,"trainingIntensity":60,"technicalCoaching":68,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":68,"brandBuilding":54,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":60,"consistency":62,"awareness":82,"judgement":89},"contract":{"id":"tew-contract-1778","wrestlerId":1778,"promotionId":73,"startDate":"2019-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1779,"name":"KAORU","realName":"KAORU","picture":"KAORU.jpg","ability":56,"currentAbility":61,"potentialAbility":61,"charisma":61,"micSkills":57,"popularity":4,"condition":67,"hardcoreAbility":47,"injuryProne":100,"type":"wrestler","style":"striker","gender":"F","weight":63,"height":165,"base":"Japan","birthplace":"Japan","dateOfBirth":"1969-02-09T00:00:00.000Z","debut":"1986-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Kaoru Maeda is a Japanese professional wrestler better known by the ring name Kaoru (stylized in all capital letters). Billed as the \"Original Hardcore Queen\", Kaoru is known for her wrestling style, which combines high-flying with hardcore wrestling. Trained by the All Japan Women's Pro-Wrestling (AJW) promotion, Maeda worked in both Japan and Mexico in the late 80s and early 90s, before making her breakthrough in the Gaea Japan promotion, where she most notably was a founding member of the D-Fix stable. After the folding of Gaea Japan in 2005, Maeda became a freelancer, though closely affiliating herself with the Oz Academy promotion. After returning from a three-year-long injury break in March 2014, Maeda resumed working as a freelancer, before signing with the new Marvelous promotion in January 2015.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1724,2482,2507,3007,3008,3348],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":77,"storytelling":80,"productFit":100,"riskTaking":28,"matchLayout":81,"psychology":77,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":62,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":76,"brandBuilding":55,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":67,"awareness":77,"judgement":86}},{"id":1781,"name":"Ronda Rousey","realName":"Ronda Rousey","picture":"Ronda Rousey.jpg","ability":48,"currentAbility":57,"potentialAbility":57,"charisma":70,"micSkills":55,"popularity":57,"condition":86,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"submission","gender":"F","weight":61,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1987-02-01T00:00:00.000Z","debut":"2018-01-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"There have been Superstars who tried fighting and fighters who tried their hand at being Superstars. But there is only one Ronda Rousey.\r\n\r\nThis record-setting modern legend has blazed a trail through mixed-martial arts, beginning with a bronze medal showing in judo during the 2008 Beijing Summer Olympics and, most notably, continuing with a record-setting tear through UFC as the first female competitor to ever sign with the company. Given her status as the Strikeforce Women’s Bantamweight Champion before that promotion was absorbed by the UFC, Rousey was named the first-ever UFC Women’s Bantamweight Champion upon her arrival. It's no surprise that she was destined to become the first woman to be inducted into the UFC Hall of Fame on July of 2018.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3739],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":45,"storytelling":51,"productFit":13,"riskTaking":51,"matchLayout":53,"psychology":45,"workerManagement":13,"trainingIntensity":73,"technicalCoaching":54,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":49,"mediaHandling":79,"brandBuilding":87,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":3,"reactionSpeed":73,"consistency":35,"awareness":45,"judgement":32}},{"id":1782,"name":"Hideki Suzuki","realName":"Hideki Suzuki","picture":"Hideki Suzuki.jpg","ability":69,"currentAbility":68,"potentialAbility":68,"charisma":71,"micSkills":57,"popularity":19,"condition":86,"hardcoreAbility":60,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":113,"height":187,"base":"Japan","birthplace":"Japan","dateOfBirth":"1980-02-18T00:00:00.000Z","debut":"2008-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Hideki Suzuki is a Japanese wrestler who works in America and Japan. He is a Middleweight who is classed as using a Technician style. He is best known for his work with NOAH, NXT, BJW, ZERO1 and WRESTLE-1.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":71,"productFit":100,"riskTaking":21,"matchLayout":73,"psychology":65,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":87,"characterCoaching":46,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":46,"brandBuilding":58,"socialMediaSavvy":19,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":76,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-1782","wrestlerId":1782,"promotionId":3,"startDate":"2023-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1783,"name":"Sylvain Grenier","realName":"Sylvain Grenier","picture":"Sylvain Grenier.jpg","ability":76,"currentAbility":80,"potentialAbility":80,"charisma":65,"micSkills":91,"popularity":5,"condition":88,"hardcoreAbility":63,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":107,"height":180,"base":"Canada","birthplace":"Canada","dateOfBirth":"1977-03-26T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Sylvain Grenier is a Canadian professional wrestler. He is best known for his appearances with World Wrestling Entertainment between 2003 and 2007 where he was part of La Résistance and became a four time World Tag Team Champion with René Duprée one time and Rob Conway three times. After his release from WWE, Grenier became a French language commentator for Total Nonstop Action Wrestling (TNA) Impact! for a number of years and continues to wrestle on the Québec independent circuit.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1157,1158],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":60,"storytelling":67,"productFit":100,"riskTaking":28,"matchLayout":69,"psychology":60,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":47,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":64,"brandBuilding":57,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":58,"awareness":60,"judgement":76}},{"id":1784,"name":"Nanae Takahashi","realName":"Nanae Takahashi","picture":"Nanae Takahashi.jpg","ability":70,"currentAbility":68,"potentialAbility":68,"charisma":65,"micSkills":83,"popularity":7,"condition":69,"hardcoreAbility":57,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":65,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-12-23T00:00:00.000Z","debut":"1996-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Nanae Takahashi, a 1996 graduate of the Animal Hamaguchi Gym, is a Japanese wrestler who works exclusively in Japan. She is a Small worker who is classed as using a Technician style. She is best known for her work with Stardom, Marigold, GLEAT, ZERO1, Ice Ribbon and SEAdLINNNG.","alterEgos":[],"managerId":0,"acceptsIndieBookings":true,"promotionId":null,"teams":[1796,2508,3617,4030],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":83,"storytelling":85,"productFit":100,"riskTaking":21,"matchLayout":86,"psychology":83,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":70,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":68,"brandBuilding":61,"socialMediaSavvy":55,"ruleKnowledge":0,"