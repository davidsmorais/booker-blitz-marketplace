quer all in their path by any means necessary!\r\n\r\nTrained in various forms of combat, when Josef Samael steps into the ring for a fight, it is best described as pure chaos.\r\n\r\nA very polished and successful entrepreneur out of the ring known for wearing nice suits and always smoking a cigar, Josef Samael is a ruthless and shadowy figure.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1858,1936,2176],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":65,"productFit":100,"riskTaking":40,"matchLayout":66,"psychology":62,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":45,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":77,"brandBuilding":38,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":62,"awareness":62,"judgement":77}},{"id":3094,"name":"Raj Singh","realName":"Raj Singh","picture":"Gama Singh Jr.jpg","ability":57,"currentAbility":55,"potentialAbility":55,"charisma":70,"micSkills":60,"popularity":6,"condition":90,"hardcoreAbility":41,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":97,"height":177,"base":"Canada","birthplace":"Canada","dateOfBirth":"1983-06-21T00:00:00.000Z","debut":"2005-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Raj Singh is a Canadian wrestler who works in America, Canada and Japan. He is a Lightweight who is classed as using a Regular style. He is best known for his work with IMPACT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":118,"teams":[2758],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":60,"productFit":100,"riskTaking":26,"matchLayout":62,"psychology":