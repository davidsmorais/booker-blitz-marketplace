mid","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"PAC is an English wrestler who works in America, Canada, Mexico, the British Isles, Japan, Europe and Oceania. He is a Lightweight who is classed as using a Technician Flyer style. He is best known for his work with WWE, NJPW, AEW, Dragongate, NXT, PWG, ROH, wXw, RevPro, OTT and Defiant. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[964,2386],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":75,"productFit":100,"riskTaking":24,"matchLayout":76,"psychology":70,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":72,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":68,"brandBuilding":69,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":82,"awareness":70,"judgement":82},"contract":{"id":"tew-contract-177","wrestlerId":177,"promotionId":76,"startDate":"2019-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":179,"name":"Vik","realName":"Vik","picture":"Viktor.jpg","ability":61,"currentAbility":63,"potentialAbility":63,"charisma":62,"micSkills":49,"popularity":10,"condition":89,"hardcoreAbility":83,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":99,"height":185,"base":"Canada","birthplace":"Canada","dateOfBirth":"1980-12-04T00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Apoc began his career in the Hart Dungeon under the teachings of Bruce and Ross Hart. He also received training under Tokyo Joe. He started working for Stampede Wrestling in 2001 as Bishop, later to be renamed \"Apocalypse\" which he continued to work as until 2008. In Stampede Wrestling, he won the North American Heavyweight Championship. He also held the International Tag Team Championship twice with partner Dave Swift. He did a tour with New Japan Pro Wrestling as \"The Shadow\" in November–December 2003. On January 16, 2008, APOC would debut under his new name Erik Doom and lost to Justin LaRouche. In February 2011, APOC signed a developmental contract with the WWE and was assigned to FCW under the ring name Rick Victor.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":79,"teams":[1377,1379,2395,4283],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":68,"productFit":100,"riskTaking":17,"matchLayout":70,"psychology":62,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":56,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":62,"brandBuilding":46,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":78,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-179","wrestlerId":179,"promotionId":79,"startDate":"2023-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":180,"name":"Charlotte Flair","realName":"Charlotte Flair","picture":"Charlotte.jpg","ability":68,"currentAbility":69,"potentialAbility":69,"charisma":64,"micSkills":71,"popularity":62,"condition":94,"hardcoreAbility":84,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":65,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1986-04-05T00:00:00.000Z","debut":"2012-10-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"She may be the daughter of 16-time World Champion Ric Flair, but Charlotte Flair is carving out a path of greatness all her own.\r\n\r\nDisplaying a level of athleticism that few Superstars in history can match, Charlotte first captured the attention of the WWE Universe with the type of statement victory that’s rarely been seen before or since. With her father watching on, Charlotte defeated Natalya at NXT TakeOver to win an eight-woman tournament on May 29, 2014, becoming the new NXT Women's Champion in the process. In the months that followed, the self-proclaimed “genetically superior athlete” turned back one challenger after another, helping cement the Women’s division as one of the most competitive in all of sports-entertainment.\r\n\r\nSoon, Charlotte made her long-awaited debut on Raw, helping to usher in a genuine women's evolution in WWE. Charlotte was the first of the new arrivals to win the Divas Title and the first athlete to win the Raw Women's Championship.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[995,4282],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":79,"storytelling":80,"productFit":100,"riskTaking":33,"matchLayout":81,"psychology":79,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":64,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":76,"brandBuilding":86,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":55,"awareness":79,"judgement":87},"contract":{"id":"tew-contract-180","wrestlerId":180,"promotionId":64,"startDate":"2012-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":183,"name":"Saraya","realName":"Saraya","picture":"Paige.jpg","ability":62,"currentAbility":54,"potentialAbility":54,"charisma":66,"micSkills":46,"popularity":51,"condition":68,"hardcoreAbility":39,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":54,"height":170,"base":"UK","birthplace":"England","dateOfBirth":"1992-08-17T00:00:00.000Z","debut":"2005-04-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Saraya is an English wrestler who works in America, Canada, the British Isles and Europe. She is a Very Small worker who is classed as using a Regular style. She is best known for her work with WWE, AEW, NXT, SHIMMER and EVE. She is dating someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[500,1146,4384],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":60,"storytelling":64,"productFit":100,"riskTaking":35,"matchLayout":65,"psychology":60,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":52,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":78,"brandBuilding":80,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":43,"awareness":60,"judgement":76},"contract":{"id":"tew-contract-183","wrestlerId":183,"promotionId":64,"startDate":"2026-05-01T00:00:00.000Z","endDate":"2028-05-01T00:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-05-01T00:00:00.000Z","wage":4333},{"id":184,"name":"Byron Saxton","realName":"Byron Saxton","picture":"Byron Saxon.jpg","ability":43,"currentAbility":52,"potentialAbility":52,"charisma":60,"micSkills":38,"popularity":14,"condition":90,"hardcoreAbility":41,"injuryProne":90,"type":"manager","style":"all rounder","gender":"M","weight":104,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1981-08-20T00:00:00.000Z","debut":"2003-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"From in-ring competitor to color commentator, Byron Saxton has done it all in WWE. After receiving a bachelor's degree from the University of Florida, Saxton worked as a reporter and anchor for WJXT Channel 4 News in Jacksonville, Fla. This on-camera experience proved to be very useful as he began his career in the ring, which was preceded by a stint as an ECW announcer. A rookie rooted in both the fourth and fifth seasons of NXT, Saxton worked with NXT Pros like Dolph Ziggler and Yoshi Tatsu. Byron honed his skills under some of the brightest stars in the WWE Universe, and now, this charismatic and camera-friendly Superstar uses his diverse abilities to make a lasting impression in WWE as a dynamic color commentator.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":50,"storytelling":55,"productFit":100,"riskTaking":40,"matchLayout":56,"psychology":50,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":41,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":70,"brandBuilding":65,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":55,"awareness":50,"judgement":70},"contract":{"id":"tew-contract-184","wrestlerId":184,"promotionId":64,"startDate":"2012-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":185,"name":"Chris Hero","realName":"Chris Hero","picture":"Chris Hero.jpg","ability":84,"currentAbility":93,"potentialAbility":93,"charisma":88,"micSkills":100,"popularity":23,"condition":70,"hardcoreAbility":77,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":122,"height":190,"base":"USA","birthplace":"United States","dateOfBirth":"1979-12-24T00:00:00.000Z","debut":"1998-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"When Kassius Ohno hits the ring, it can only mean one thing: Someone’s about to get their lights turned out.\r\n\r\nHero is a feared striker who’s traveled the world to make a name for himself in the ring while dishing out devastating blows, such as his patented Rolling Elbow. He arrived on the scene in NXT in 2012, cold-cocking everyone in his path while making it clear he was a top contender to the NXT Championship. However, Hero’s title dreams did not pan out before his departure in late 2013.\r\n\r\nThe Knockout Artist returned to the independent scene shortly thereafter and wasted no time establishing himself as one of the best competitors on the planet. Still, those unfulfilled championship dreams left Hero with unfinished business in NXT, as he made known upon his shocking comeback to the black-and-yellow brand in early 2017.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[702,1144,1347,2710,2748],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":86,"storytelling":86,"productFit":100,"riskTaking":20,"matchLayout":86,"psychology":86,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":75,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":70,"brandBuilding":61,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":80,"awareness":86,"judgement":92},"contract":{"id":"tew-contract-185","wrestlerId":185,"promotionId":76,"startDate":"2023-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":186,"name":"Big Bill","realName":"Big Bill","picture":"Colin Cassady.jpg","ability":46,"currentAbility":54,"potentialAbility":54,"charisma":66,"micSkills":64,"popularity":33,"condition":81,"hardcoreAbility":52,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":128,"height":205,"base":"USA","birthplace":"United States","dateOfBirth":"1986-08-16T00:00:00.000Z","debut":"2010-10-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Growing up on the mean streets of Queens, NY – Colin Cassady found out very quickly that he had to learn how to defend himself in order to survive. It was in that borough where Colin refined his trash-talking skills; developing into the brash and confident individual he is today.\r\nCassady is also a money-hungry capitalist who does not shy away from flaunting his wealth and business acumen. Business smart and street wise, this 6’10 athlete uses his considerable size and commanding presence to his advantage in the realm of sports entertainment.  This trash-talking titan is not afraid to go toe-to-toe with anyone and feels he is fated to be the “realist of them all”. Colin states: “Most people spend their whole lives trying to make it big… but I… well, I was BORN TO BE BIG!”","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[1045,1046,2071,3868,4184,4376],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":62,"productFit":100,"riskTaking":21,"matchLayout":63,"psychology":61,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":18,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":77,"brandBuilding":84,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":77,"awareness":61,"judgement":77},"contract":{"id":"tew-contract-186","wrestlerId":186,"promotionId":64,"startDate":"2026-07-13T00:00:00.000Z","endDate":"2026-08-06T00:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-08-06T00:00:00.000Z","wage":4333},{"id":191,"name":"Dusty Rhodes","realName":"Dusty Rhodes","picture":"Dusty Rhodes.jpg","ability":48,"currentAbility":48,"potentialAbility":48,"charisma":49,"micSkills":49,"popularity":42,"condition":29,"hardcoreAbility":31,"injuryProne":83,"type":"wrestler","style":"all rounder","gender":"M","weight":125,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1945-10-12T00:00:00.000Z","debut":"1964-10-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"Virgil Riley Runnels, Jr., better known as \"The American Dream\" Dusty Rhodes, is a semi-retired American professional wrestler. Rhodes is a three-time NWA World Heavyweight Champion and has also won the NWA Georgia Heavyweight Championship once, the NWA Florida Heavyweight Championship ten times, the NWA Southern Heavyweight Championship (Florida version) seven times and the NWA National Heavyweight Championship one time. He has also won many other championships during his wrestling career. He is one of six men inducted into each of the WWE Hall of Fame, the WCW Hall of Fame, the Professional Wrestling Hall of Fame and the Wrestling Observer Newsletter Hall of Fame. He is the father of professional wrestlers Dustin Rhodes and Cody Rhodes, both having at points worked for WWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":83,"productFit":100,"riskTaking":10,"matchLayout":84,"psychology":80,"workerManagement":100,"trainingIntensity":35,"technicalCoaching":0,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":90,"mediaHandling":85,"brandBuilding":70,"socialMediaSavvy":85,"ruleKnowledge":0,"positioning":20,"reactionSpeed":35,"consistency":55,"awareness":80,"judgement":88}},{"id":192,"name":"Sami Zayn","realName":"Sami Zayn","picture":"Sami Zayn.jpg","ability":68,"currentAbility":76,"potentialAbility":76,"charisma":64,"micSkills":78,"popularity":63,"condition":77,"hardcoreAbility":95,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":96,"height":182,"base":"Canada","birthplace":"Canada","dateOfBirth":"1984-07-12T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"A Canadian-born Superstar of Syrian descent, Sami Zayn brought with him an experience level matched by few when he arrived in WWE. After all, how many Superstars can say they have competed in a staggering 29 countries?\r\n\r\nKnown as an honorable competitor who approached situations with a lighthearted, fun-loving attitude, Zayn changed his tune at WWE Hell in Cell 2017 when he interfered in the main event and helped his old friend Kevin Owens overcome Shane McMahon.\r\n\r\nLike him of loathe him, no one could afford to underestimate Zayn’s intensity in the squared circle. His in-ring presence incorporates an eclectic blend of styles, from his explosive aerial moves to his hard-hitting strikes. Simply put, Zayn can take down any Superstar on the roster — an ability he has displayed in show-stealing matches against the likes of Owens, Cesaro and John Cena.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[976,1040,1330,1744,2516,2778],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":85,"storytelling":85,"productFit":100,"riskTaking":19,"matchLayout":85,"psychology":85,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":74,"characterCoaching":87,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":87,"brandBuilding":64,"socialMediaSavvy":89,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":83,"awareness":85,"judgement":91},"contract":{"id":"tew-contract-192","wrestlerId":192,"promotionId":64,"startDate":"2016-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":194,"name":"El Hijo de Dos Caras","realName":"El Hijo de Dos Caras","picture":"Hijo de Dos Caras.jpg","ability":42,"currentAbility":47,"potentialAbility":47,"charisma":35,"micSkills":32,"popularity":4,"condition":90,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":106,"height":182,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1988-06-26T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"The Brother of WWE superstar Alberto Del Rio and son of the legendary Dos Caras. Wrestled as Dark Phoenix before signing with WWE. Driven by ambition and the will to live up to the high expectations of his family, Memo Montenegro has arrived at NXT to prove he has what it takes to make a dent in the world of Sports Entertainment. This second generation superstar comes from a lofty Sports Entertainment family lineage, but is determined to make it on his own merits. He looks to do such by using his catlike quickness, uncanny agility and lucha libre style of Sports Entertainment. Memo is a perfect example of never judging a book by its cover. On the surface, this youthful competitor may appear distinguished and dignified, but Memo has recently exhibited a darker and more aggressive side in the squared circle of NXT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1195],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":57,"productFit":62,"riskTaking":30,"matchLayout":58,"psychology":53,"workerManagement":62,"trainingIntensity":75,"technicalCoaching":36,"characterCoaching":38,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":38,"brandBuilding":70,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":12,"reactionSpeed":75,"consistency":71,"awareness":53,"judgement":57}},{"id":195,"name":"James Gibson","realName":"James Gibson","picture":"Jamie Noble.jpg","ability":95,"currentAbility":91,"potentialAbility":91,"charisma":97,"micSkills":89,"popularity":20,"condition":70,"hardcoreAbility":98,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":92,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1976-12-23T00:00:00.000Z","debut":"1995-02-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"James Howard Gibson better known by his WWE ring name Jamie Noble, is an American former professional wrestler working for WWE as a producer. He is best known for his work from 2002 to 2009 when a severe back injury forced him to retire from competition. He is also known for his appearances in World Championship Wrestling in its cruiserweight division under the names Jamie-San and Jamie Knoble and is a one time Cruiserweight Champion. Gibson also wrestled in Ring of Honor as James Gibson and is a one time world champion, having won the ROH World Championship during his time in that organization.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[2756],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":82,"storytelling":84,"productFit":100,"riskTaking":16,"matchLayout":84,"psychology":82,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":64,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":64,"brandBuilding":48,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":51,"consistency":75,"awareness":82,"judgement":89},"contract":{"id":"tew-contract-195","wrestlerId":195,"promotionId":64,"startDate":"2009-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":196,"name":"Jason Ayers","realName":"Jason Ayers","picture":"Jason Ayers.jpg","ability":78,"currentAbility":82,"potentialAbility":82,"charisma":81,"micSkills":94,"popularity":3,"condition":100,"hardcoreAbility":73,"injuryProne":100,"type":"referee","style":"all rounder","gender":"M","weight":68,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1982-01-13T00:00:00.000Z","debut":"1998-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jason Ayers is an American man who works primarily as a referee. He is best known for his work with WWE, ROH, NXT and EVOLVE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":45,"technicalCoaching":0,"characterCoaching":17,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":17,"brandBuilding":9,"socialMediaSavvy":8,"ruleKnowledge":82,"positioning":66,"reactionSpeed":45,"consistency":47,"awareness":0,"judgement":0},"contract":{"id":"tew-contract-196","wrestlerId":196,"promotionId":64,"startDate":"2016-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":197,"name":"Jason Jordan","realName":"Jason Jordan","picture":"Jason Jordan.jpg","ability":100,"currentAbility":92,"potentialAbility":92,"charisma":84,"micSkills":96,"popularity":38,"condition":59,"hardcoreAbility":99,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":110,"height":187,"base":"USA","birthplace":"United States","dateOfBirth":"1988-09-28T00:00:00.000Z","debut":"2011-09-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"In high school, Jason Jordan was a three sport athlete playing football, wrestling, and baseball. He was drafted straight out of high school for professional baseball, but passed up the offer to go to college and wrestle. He attended Indiana University and amateur wrestled in the toughest wresting conference in the country: the Big Ten. Jason became a three-time national qualifier for NCAA at the Division I level. In addition to great wrestling, Jason Jordan is very intelligent. He received his Bachelor’s degree in biology with minors in chemistry, social science and medicine. He put attending dental school on hold to pursue his dreams in professional wrestling. Jordan uses his wits along with his never stop, never-quit, never-say-die attitude to top his opponents in the squared circle. While here at NXT, Jason Jordan has gained tons of experience and is constantly building an arsenal of attacks.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[927,928,2745],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":84,"storytelling":80,"productFit":100,"riskTaking":29,"matchLayout":79,"psychology":84,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":65,"characterCoaching":59,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":59,"brandBuilding":80,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":69,"awareness":84,"judgement":90},"contract":{"id":"tew-contract-197","wrestlerId":197,"promotionId":64,"startDate":"2016-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":199,"name":"Joel Redman","realName":"Joel Redman","picture":"Oliver Grey.jpg","ability":57,"currentAbility":51,"potentialAbility":51,"charisma":37,"micSkills":42,"popularity":3,"condition":89,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":99,"height":182,"base":"UK","birthplace":"England","dateOfBirth":"1987-02-21T00:00:00.000Z","debut":"2005-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Joel Redman is an English wrestler who works in America, Canada, the British Isles, Japan and Europe. He is a Middleweight who is classed as using a Technician style. He is best known for his work with NXT, wXw, AJPW and RevPro.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[27,459,964],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":46,"storytelling":52,"productFit":60,"riskTaking":28,"matchLayout":54,"psychology":46,"workerManagement":60,"trainingIntensity":77,"technicalCoaching":40,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":56,"brandBuilding":55,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":12,"reactionSpeed":77,"consistency":68,"awareness":46,"judgement":52}},{"id":200,"name":"Joey Mercury","realName":"Joey Mercury","picture":"Joey Matthews_alt.jpg","ability":87,"currentAbility":83,"potentialAbility":83,"charisma":97,"micSkills":93,"popularity":8,"condition":72,"hardcoreAbility":100,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":94,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1979-07-18T00:00:00.000Z","debut":"1996-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Flashy, arrogant and overconfident, Joey Mercury and his tag partner, Johnny Nitro, looked like the typical brash upstarts who would quickly be put in their place when they debuted on SmackDown in April 2005. Instead, they defeated Rey Mysterio & Eddie Guerrero to win the WWE Tag Team Championships in their very first match.\r\n\r\nStill, despite his three championship victories, Mercury's most memorable moment came during a losing effort. At Armageddon in 2006, MNM clashed with Paul London & Brian Kendrick, William Regal & Dave Taylor and The Hardys in a brutal Fatal 4-Way Ladder Match for the WWE Tag Team Titles. Devastating from the start, the bout took its toll on every competitor involved, but Mercury got the worst of it when he was blasted directly in the face with a ladder. The impact was so intense that it shattered the competitor's nose and caused him to be pulled from the ring and rushed directly to the emergency room.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1226,2756],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":71,"productFit":100,"riskTaking":33,"matchLayout":73,"psychology":65,"workerManagement":100,"trainingIntensity":64,"technicalCoa