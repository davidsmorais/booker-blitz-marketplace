active","autoRenew":false},"contractExpiryDate":"2028-07-01T00:00:00.000Z","wage":1000},{"id":2255,"name":"Big Mike","realName":"Big Mike","picture":"Alan Extreme.jpg","ability":46,"currentAbility":48,"potentialAbility":48,"charisma":35,"micSkills":53,"popularity":2,"condition":92,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":89,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1990-08-12T00:00:00.000Z","debut":"2007-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Big Mike is a Mexican luchador who works exclusively in Mexico. He is a 5'8\", 197lb worker who is classed as using a Luchador style. He is best known for his work with IWRG.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":30,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":51,"storytelling":57,"productFit":67,"riskTaking":38,"matchLayout":59,"psychology":51,"workerManagement":67,"trainingIntensity":72,"technicalCoaching":33,"characterCoaching":43,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":43,"brandBuilding":22,"socialMediaSavvy":41,"ruleKnowledge":0,"positioning":13,"reactionSpeed":72,"consistency":71,"awareness":51,"judgement":57},"contract":{"id":"tew-contract-2255","wrestlerId":2255,"promotionId":30,"startDate":"2009-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":2256,"name":"Apolo Estrada Jr.","realName":"Apolo Estrada Jr.","picture":"Apolo Estrada Jr.jpg","ability":58,"currentAbility":57,"potentialAbility":57,"charisma":63,"micSkills":67,"popularity":2,"condition":75,"hardcoreAbility":37,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":95,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1987-01-10T00:00:00.000Z","debut":"2000-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Apolo Estrada Jr., is the ring name of Roberto Guadalupe Estrada Zúñiga a Mexican Luchador or professional wrestler. He is the son of professional wrestler Apolo Estrada and has worked for Consejo Mundial de Lucha Libre (CMLL), International Wrestling Revolution Group (IWRG) as well as working for a large number of professional wrestling promotions on the Mexican independent circuit. From 2009 to 2015 he was a member of a wrestling group known as Los Gringos VIP. Estrada began his professional wrestling career in 2000, working as the enmascarado character El Chupacabras. Estrada was around 13 years old when he wrestled his first match, something that is not unheard of in Lucha Libre","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[743,2871],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":29,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":52,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":53,"brandBuilding":31,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":77,"awareness":56,"judgement":74}},{"id":2259,"name":"Cien Caras Jr.","realName":"Cien Caras Jr.","picture":"Cien Caras Jr.jpg","ability":61,"currentAbility":60,"potentialAbility":60,"charisma":74,"micSkills":65,"popularity":4,"condition":83,"hardcoreAbility":72,"injuryProne":99,"type":"wrestler","style":"high flyer","gender":"M","weight":120,"height":187,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1980-10-18T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Cien Caras Jr  is a Mexican luchador enmascarado. In Lucha Libre it is traditional to keep the true identify of a masked wrestler a secret, not revealing their real names and oftentimes not revealing what previous ring names they have competed under. While Cien Caras Jr. is listed as having made his professional wrestling debut in 1997 under the name \"Sheriff\", it has not been confirmed if he previously worked under a masked or unmasked ring identity and then adopted the masked character \"Sheriff\" afterwards. He became Cien Caras Jr. in 2005, adopting the masked character of a son of wrestler Carmelo Reyes González, better known as Cien Caras. He also began teaming with Hijo de Cien Caras, like Cien Caras Jr. he was not an actual son of Reyes, but paid to use the character.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":74,"productFit":90,"riskTaking":44,"matchLayout":76,"psychology":69,"workerManagement":90,"trainingIntensity":69,"technicalCoaching":58,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":56,"brandBuilding":47,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":18,"reactionSpeed":69,"consistency":69,"awareness":69,"judgement":77}},{"id":2260,"name":"Guerrero 2000","realName":"Guerrero 2000","picture":"Guerrero 2000.jpg","ability":48,"currentAbility":50,"potentialAbility":50,"charisma":60,"micSkills":49,"popularity":2,"condition":91,"hardcoreAbility":31,"injuryProne":93,"type":"writer","style":"high flyer","gender":"M","weight":93,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1991-10-19T00:00:00.000Z","debut":"2009-10-01T00:00:00.000Z","mor