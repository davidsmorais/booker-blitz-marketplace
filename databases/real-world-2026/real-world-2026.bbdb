ode of Jakked, Evans teamed with Mike Hollow in a losing effort to Dean Malenko and Perry Saturn. On the December 6 2010 episode of Ring of Honor Wrestling, Evans and his client Mike Bennett appeared in the crowd to watch a match between the ROH World Television Champion Eddie Edwards and Christopher Daniels. At the June 23, 2013, tapings of Ring of Honor Wrestling, Bennett turned on Evans.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2646],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":74,"productFit":60,"riskTaking":16,"matchLayout":76,"psychology":69,"workerManagement":60,"trainingIntensity":59,"technicalCoaching":43,"characterCoaching":45,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":45,"brandBuilding":39,"socialMediaSavvy":39,"ruleKnowledge":0,"positioning":12,"reactionSpeed":59,"consistency":67,"awareness":69,"judgement":65}},{"id":2329,"name":"Wesna Busic","realName":"Wesna Busic","picture":"Wesna Busic.jpg","ability":76,"currentAbility":82,"potentialAbility":82,"charisma":79,"micSkills":95,"popularity":3,"condition":67,"hardcoreAbility":99,"injuryProne":100,"type":"writer","style":"striker","gender":"F","weight":89,"height":172,"base":"Europe","birthplace":"Croatia","dateOfBirth":"1983-06-26T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Wesna Busic, a 1998 graduate of the GWF Wrestling School, is a retired Croatian wrestler who works primarily as a road agent. She is best known for her work with wXw, GWF and SHIMMER.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":70,"productFit":100,"riskTakin