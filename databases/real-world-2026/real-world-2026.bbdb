o Dick Togo in a 5-way match on May 6, 2008.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":12,"teams":[1553,2437,2438,2439,2907],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":82,"storytelling":83,"productFit":100,"riskTaking":18,"matchLayout":83,"psychology":82,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":75,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":82,"brandBuilding":74,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":86,"awareness":82,"judgement":89},"contract":{"id":"tew-contract-1461","wrestlerId":1461,"promotionId":12,"startDate":"2001-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":1462,"name":"Hoshitango","realName":"Hoshitango","picture":"Hoshitango.jpg","ability":60,"currentAbility":51,"potentialAbility":51,"charisma":37,"micSkills":41,"popularity":3,"condition":65,"hardcoreAbility":54,"injuryProne":95,"type":"wrestler","style":"striker","gender":"M","weight":135,"height":180,"base":"Other","birthplace":"Argentina","dateOfBirth":"1965-09-05T00:00:00.000Z","debut":"2006-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Hoshitango Imachi (born Imachi Marcelo Salomon) is an Argentine-born Japanese former professional sumo wrestler and current professional wrestler. His highest rank was Juryo 3. A former swimming instructor, Salomon joined Michinoku stable in May 1987. He was the first Jew in professional sumo. Hoshitango became a Japanese citizen in October 2000. His Japanese name was registered as Tango Hoshi. Imachi is currently a professional wrestler for the Japanese company DDT (Dramatic Dream Team) and has also wrestled for HUSTLE, Ice Ribbon and New Japan Pro Wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":103,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit":100,"riskTaking":37,"matchLayout":61,"psychology":56,"workerManagement":100,"trainingIntensity":52,"technicalCoaching":28,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":62,"brandBuilding":33,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":52,"consistency":56,"awareness":56,"judgement":74},"contract":{"id":"tew-contract-1462","wrestlerId":1462,"promotionId":103,"startDate":"2012-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1463,"name":"Kazuki Hirata","realName":"Kazuki Hirata","picture":"Kazuki Hirata.jpg","ability":61,"currentAbility":60,"potentialAbility":60,"charisma":63,"micSkills":75,"popularity":4,"condition":100,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":78,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1987-11-21T00:00:00.000Z","debut":"2010-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kazuki Hirata is a Japanese wrestler who works exclusively in Japan. He is a Lightweight who is classed as using a Entertainer style. He is best known for his work with DDT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":12,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":61,"productFit":100,"riskTaking":25,"matchLayout":63,"p