power test U23’s,whilst achieving 1st place overall in the 2016 South East Classic Powerlifting competition; a competition recognised to a national level by the International Powerlifting Federation.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":38,"storytelling":42,"productFit":10,"riskTaking":38,"matchLayout":44,"psychology":38,"workerManagement":10,"trainingIntensity":67,"technicalCoaching":35,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":54,"brandBuilding":71,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":2,"reactionSpeed":67,"consistency":55,"awareness":38,"judgement":27}},{"id":3301,"name":"Kez Evans","realName":"Kez Evans","picture":"Kez Evans.jpg","ability":65,"currentAbility":55,"potentialAbility":55,"charisma":55,"micSkills":58,"popularity":1,"condition":100,"hardcoreAbility":72,"injuryProne":93,"type":"wrestler","style":"technical","gender":"M","weight":119,"height":182,"base":"UK","birthplace":"Scotland","dateOfBirth":"1995-01-26T00:00:00.000Z","debut":"2015-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kez Evans is a Scottish wrestler who works exclusively in America. He is a Middleweight who is classed as using a Regular Wrestler style. He was chosen to main event the first ever show held at ICW and GPWA’s base “The Asylum” up against Wolfgang (Or “WWE superstar Wolfgang\" to give him his proper title) and produced a match well beyond his experience level at that time. A fine way to kick off a singles career that he’ll be hoping has many more highlights like that and of course his bout with Mr Anderson in 2017.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws