th the comedy gimmick of Golden Pine.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1096],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":25,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":57,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":65,"brandBuilding":38,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":61,"awareness":56,"judgement":74}},{"id":1763,"name":"Tatsuhito Takaiwa","realName":"Tatsuhito Takaiwa","picture":"Tatsuhito Takaiwa.jpg","ability":62,"currentAbility":62,"potentialAbility":62,"charisma":51,"micSkills":50,"popularity":5,"condition":67,"hardcoreAbility":60,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":94,"height":175,"base":"Other","birthplace":"South Korea","dateOfBirth":"1972-07-05T00:00:00.000Z","debut":"1992-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Tatsuhito Takaiwa is a Zainichi-Korean professional wrestler. Takaiwa is one of the more well-traveled junior heavyweights in Japan, having wrestled for New Japan, and Zero1, as well as making special appearances in All Japan and NOAH. He formed a successful tag team with Shinjiro Otani during the 1990s and won the IWGP Jr Heavyweight Tag Titles in 1998 and 1999. He's a former holder of the Zero-One International Jr. Heavyweight Title, IWGP Jr. Heavyweight Title and a former holder of the Pro Wrestling Noah GHC Jr. Heavyweight Title, and the AWA World Jr. Heavyweight Title. On February 15, 2009, Takaiwa debuted as the fifth Black Tiger, breaking the Black Tiger tradition of foreigners under the mask, by attacking Tiger Mask IV. On June 20, 2009, at Dominion 6.20 Tiger Mask defeated him in a mask vs. mask match and afterwards Takaiwa revealed his identity by removing his mask.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":104,"teams":[2954,2955,2956],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":72,"storytelling":76,"productFit":100,"riskTaking":23,"matchLayout":78,"psychology":72,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":67,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":53,"brandBuilding":38,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":61,"awareness":72,"judgement":83},"contract":{"id":"tew-contract-1763","wrestlerId":1763,"promotionId":104,"startDate":"2022-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1764,"name":"Aki Kanbayashi","realName":"Aki Kanbayashi","picture":"Aki Kambayashi.jpg","ability":51,"currentAbility":57,"potentialAbility":57,"charisma":53,"micSkills":47,"popularity":3,"condition":62,"hardcoreAbility":37,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":70,"height":152,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-09-02T00:00:00.000Z","debut":"1995-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Aki Kambayashi is a Japanese professional wrestler who has been around since the mid 90's. She spent the early part of her career with the FMW promotion under her real name, and the name Miss Mongol, a name she would continue using for most of her career.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":59,"storytelling":66,"productFit":100,"riskTaking":26,"matchLayout":68,"psychology":59,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":54,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":54,"brandBuilding":36,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":67,"awareness":59,"judgement":75}},{"id":1765,"name":"Alex Lee","realName":"Alex Lee","picture":"Alex Lee.jpg","ability":50,"currentAbility":42,"potentialAbility":42,"charisma":54,"micSkills":29,"popularity":2,"condition":85,"hardcoreAbility":57,"injuryProne":100,"type":"wrestler","style":"striker","gender":"F","weight":70,"height":167,"base":"Other","birthplace":"Unknown","dateOfBirth":"1985-06-24T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Irena Janjic s a former WWE Diva, who worked in its developmental area Florida Championship Wrestling. In the spring of 2010 she moved to Canada to train with Lance Storm at his Storm Wrestling Academy and graduated from it in May 2010. Janjic returned to her independent wrestling origins, working under the ring name of Alex Lee. She began wrestling in Japanese shows beginning in 2012. Her first show appearance was for REINA X World on June 24 at REINA X World #2 in a tag match, teaming with Kaji Tomato in a losing effort against Kikutaro and La Comandante.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1700,1715,1716],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":43,"storytelling":46,"productFit":100,"riskTaking":29,"matchLayout":47,"psychology":43,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":40,"characterCoaching":48,"diagnosis":50,"