79,"currentAbility":71,"potentialAbility":71,"charisma":62,"micSkills":77,"popularity":23,"condition":78,"hardcoreAbility":80,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":70,"height":154,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-10-04T00:00:00.000Z","debut":"1995-06-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Emi Sakura is a Japanese womens professional wrestler who is currently a freelancer. Emi is a long time wrestler who is incredibly well traveled. Emi started Ice Ribbon in the mid-naughts but is now looking to create a new promotion in Thailand. Because of this she has become a true freelancer, only looking to come to Japan to do a few shows here and there while her new company gets set up. Emi is a great all arounder with the abillity to have a good match with almost anyone, and is also a fantastic trainer.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[2506,2719,2720],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":85,"storytelling":87,"productFit":100,"riskTaking":22,"matchLayout":87,"psychology":85,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":78,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":76,"brandBuilding":45,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":80,"awareness":85,"judgement":91},"contract":{"id":"tew-contract-884","wrestlerId":884,"promotionId":49,"startDate":"2019-05-25T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":885,"name":"Ayesha Raymond","realName":"Ayesha Raymond","picture":"Ayesha Ray.jpg","ability":47,"currentAbility":46,"potentialAbility":46,"charisma":35,"micSkills":47,"popularity":2,"condition":90,"hardcoreAbility":33,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"F","weight":92,"height":180,"base":"UK","birthplace":"England","dateOfBirth":"1989-09-24T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ayesha Ray, also known as \"The Famle Predator\" Amazon was 17 years old and when she began her training with former FWA star, ASHE in London, the training school was later taken over by British legend, and former FWA star Justin Richards in 2008. Later on in that year, she began training at WAW (World Association Of Wrestling) , under the tutelage of “Rowdy” Ricky Knight and Sweet Saraya, where she made my wrestling debut against Zak Zodiac and his sister Britani Knight, current FCW anti-diva, Paige.  She had always wanted to be a professional wrestler since I was about five years old.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2579],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":48,"productFit":68,"riskTaking":36,"matchLayout":50,"psychology":44,"workerManagement":68,"trainingIntensity":65,"technicalCoaching":31,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":68,"brandBuilding":53,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":14,"reactionSpeed":65,"consistency":68,"awareness":44,"judgement":54}},{"id":886,"name":"Kasey Owens","realName":"Kasey Owens","picture":"Kasey Owens.jpg","ability":54,"currentAbility":56,"potentialAbility":56,"charisma":62,"micSkills":51,"popularity":1,"condition":100,"hardcoreAbility":42,"injuryProne":96,"type":"wrestler","style":"technical","gender":"F","weight":57,"height":165,"base":"Other","birthplace":"Unknown","dateOfBirth":"1989-06-26T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kasey Owens is a Northern Irish wrestler who works exclusively in the British Isles. She is a Small worker who is classed as using a Regular style. She is best known for her work with EVE and TNT. She is currently the EVE International champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1489,2583],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":59,"productFit":75,"riskTaking":34,"matchLayout":60,"psychology":55,"workerManagement":75,"trainingIntensity":68,"technicalCoaching":55,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":64,"brandBuilding":44,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":15,"reactionSpeed":68,"consistency":73,"awareness":55,"judgement":63}},{"id":887,"name":"Leah Owens","realName":"Leah Owens","picture":"Leah Owens.jpg","ability":18,"currentAbility":17,"potentialAbility":17,"charisma":27,"micSkills":26,"popularity":1,"condition":95,"hardcoreAbility":36,"injuryProne":99,"type":"commentator","style":"technical","gender":"F","weight":57,"height":165,"base":"Other","birthplace":"Unknown","dateOfBirth":"1989-06-26T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Leah Owens is a retired Northern Irish wrestler who works primarily as a colour commentator. She is best known for her work with Stardom, Ice Ribbon, EVE and ICW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1489,2583],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":34,"storytelling":40,"productFit":30,"riskTaking":34,"matchLayout":42,"psychology":34,"workerManagement":30,"trainingIntensity":62,"technicalCoaching":46,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":63,"brandBuilding":32,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":6,"reactionSpeed":62,"consistency":73,"awareness":34,"judgement":32}},{"id":888,"name":"Nikki Storm","realName":"Nikki Storm","picture":"Nikki Storm.jpg","ability":47,"currentAbility":56,"potentialAbility":56,"charisma":44,"micSkills":62,"popularity":34,"condition":96,"hardcoreAbility":48,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":55,"height":152,"base":"UK","birthplace":"Scotland","dateOfBirth":"1989-04-21T00:00:00.000Z","debut":"2008-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Nikki Cross’ unbridled fury and penchant for pain makes her one of WWE’s most dangerous Superstars.\r\n\r\nThe unhinged Cross enjoys pain so much that she has been known to bite her own hand and claw at her own face in the middle of a match. With wild behavior like this, it’s no wonder she once found herself fighting alongside the chaos-inducing group known as SAnitY.\r\n\r\nThere's more to Cross than just an unpredictable approach, however. After she joined the Raw brand, Nikki displayed her many dimensions alongside unexpected ally Alexa Bliss. The odd couple even managed to capture the WWE Women's Tag Team Titles on two separate occasions, including a win at WrestleMania 36.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":44,"teams":[1909,2772,2773],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit":100,"riskTaking":27,"matchLayout":61,"psychology":56,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":49,"characterCoaching":74,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":74,"brandBuilding":48,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":78,"awareness":56,"judgement":74},"contract":{"id":"tew-contract-888","wrestlerId":888,"promotionId":44,"startDate":"2026-05-26T00:00:00.000Z","endDate":"2028-05-26T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-05-26T00:00:00.000Z","wage":1000},{"id":890,"name":"Shanna","realName":"Shanna","picture":"Shanna.jpg","ability":48,"currentAbility":58,"potentialAbility":58,"charisma":64,"micSkills":50,"popularity":6,"condition":92,"hardcoreAbility":73,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":54,"height":162,"base":"Other","birthplace":"Portugal","dateOfBirth":"1982-07-08T00:00:00.000Z","debut":"2006-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"'Portugal's Perfect Athlete' Shanna debuted to critical acclaim at Pro-Wrestling:EVE's 'Empire Strikes Back' event on Oct 16 2010. In her debut contest she and the (then) 18 year old prodigy of the female wrestling world Britani Knight (NXT's Paige) battled back and forth in an athletically charged contest that saw Knight earn a hard fought victory. Shanna gained a victory back against the second generation starlet when both competed in the 3 Minute Warning match later in the evening.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2773],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":66,"productFit":100,"riskTaking":25,"matchLayout":67,"psychology":61,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":53,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":69,"brandBuilding":55,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":75,"awareness":61,"judgement":77}},{"id":891,"name":"Viper","realName":"Viper","picture":"Viper.jpg","ability":67,"currentAbility":62,"potentialAbility":62,"charisma":56,"micSkills":62,"popularity":29,"condition":83,"hardcoreAbility":66,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"F","weight":100,"height":170,"base":"UK","birthplace":"Scotland","dateOfBirth":"1991-05-06T00:00:00.000Z","debut":"2008-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Piper Niven is on a mission to take NXT UK by storm. The no-nonsense powerhouse comes to the rising brand after competing across numerous promotions, including Shine, SHIMMER and Insane Championship Wrestling, and she has yet to back down from anyone who stands in her way.\r\n\r\nThe commanding competitor joins a lineage of Scottish wrestlers who love to unleash a beating on their opponents. Drawn to sports-entertainment at an early age, Niven played contact sports in her youth, which no doubt set the foundation for her arrival inside the ropes in 2008. Armed with an impactful arsenal, she can knock out her competition at any given moment with a single, monstrous move.\r\n\r\nAfter an impressive showing in the Mae Young Classic, Niven emerged on NXT UK, interrupting first-ever NXT UK Women’s Champion Rhea Ripley to proclaim her dominance. Since then, she has quickly established herself as a force to be reckoned with and a definite threat to the entire NXT UK locker room.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[2581,3186,3995,4171],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":66,"productFit":100,"riskTaking":29,"matchLayout":67,"psychology":63,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":52,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":63,"brandBuilding":35,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":73,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-891","wrestlerId":891,"promotionId":64,"startDate":"2019-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"injury":{"type":"Broken Neck","daysToRecover":8},"returnDate":"2026-04-20T00:00:00.000Z"},{"id":892,"name":"Kirsty Love","realName":"Kirsty Love","picture":"Kirsty Love.jpg","ability":36,"currentAbility":34,"potentialAbility":34,"charisma":42,"micSkills":29,"popularity":1,"condition":100,"hardcoreAbility":43,"injuryProne":87,"type":"wrestler","style":"technical","gender":"F","weight":59,"height":162,"base":"UK","birthplace":"Scotland","dateOfBirth":"1992-04-16T00:00:00.000Z","debut":"2010-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Love is a bubbly and fun loving competitor, bouncing to the ring with a lot of energy and passion but despite her outgoing and playful nature, she’s no pushover! Constantly learning and evolving at the Source Wrestling School, Love made her breakout moment when she gained several victories over SWA breakout Nikki Storm and took over her spot as the favoured female on the roster. Since the she has become the target of both Storm and the aggressive Vyper and has become a focal point of the womens division, but whatever challenges she faces, she goes in with a wink and a smile and most importantly, a determination to be the best over any challenge.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":16,"storytelling":25,"productFit":30,"riskTaking":40,"matchLayout":28,"psychology":16,"workerManagement":30,"trainingIntensity":64,"technicalCoaching":31,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":58,"brandBuilding":16,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":6,"reactionSpeed":64,"consistency":67,"awareness":16,"judgement":22}},{"id":893,"name":"Hikaru Shida","realName":"Hikaru Shida","picture":"Hikaru Shida.jpg","ability":71,"currentAbility":66,"potentialAbility":66,"charisma":65,"micSkills":64,"popularity":30,"condition":90,"hardcoreAbility":63,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"F","weight":61,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1988-06-11T00:00:00.000Z","debut":"2008-07-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Hikaru Shida is a Japanese wrestler who works in America, the British Isles and Japan. She is a Small worker who is classed as using a Technician Striker style. She is best known for her work with CMLL, AEW, TJPW, Sendai Girls, Ice Ribbon, SEAdLINNNG, SHIMMER, OZ Academy, EVE and Gatoh Move. She is currently the AEW Women's World champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1699,2478,3607,3608],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":25,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":69,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":62,"brandBuilding":72,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":79,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-893","wrestlerId":893,"promotionId":76,"startDate":"2019-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":898,"name":"Adam Revolver","realName":"Adam Revolver","picture":"Adam Revolver.jpg","ability":60,"currentAbility":52,"potentialAbility":52,"charisma":67,"micSkills":38,"popularity":2,"condition":86,"hardcoreAbility":58,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":100,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1980-01-01T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jared Pridgin is an American professional wrestler, better known as Adam Revolver.  Adam Revolver has tagged with Ted McNaler for the past five years as \"The Elite\" to dominate the world of tag team wrestling. The Elite achieved the second longest OVW tag title reign in history the first time they won the belts. No team in OVW has the resume that the Elite presents. Adam Revolver's crushing Russian Leg Sweep combined with Ted McNaler's flying Spear has created the most lethal tag team finisher known as \"The First Class Ride\" - and it's a ride their opponents won't soon forget!","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":56,"productFit":60,"riskTaking":29,"matchLayout":58,"psychology":49,"workerManagement":60,"trainingIntensity":75,"technicalCoaching":44,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":62,"brandBuilding":38,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":12,"reactionSpeed":75,"consistency":84,"awareness":49,"judgement":53}},{"id":900,"name":"Johnny Kidd","realName":"Johnny Kidd","picture":"Johnny Kidd.jpg","ability":59,"currentAbility":66,"potentialAbility":66,"charisma":54,"micSkills":69,"popularity":4,"condition":71,"hardcoreAbility":60,"injuryProne":81,"type":"wrestler","style":"technical","gender":"M","weight":102,"height":172,"base":"UK","birthplace":"England","dateOfBirth":"1955-09-20T00:00:00.000Z","debut":"1978-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Johnny Kidd is the ring name of John Lowing, a British professional wrestler best known for his work during what was known as the Golden Era of British Wrestling. Kidd made his professional wrestling debut in a singles match against Tony Scarlo at the Salisbury City Hall in Salisbury, Wiltshire after being trained by the Ampthill Amateur Wrestling Club. A practitioner of the British style of wrestling, Kidd found little success in the more modern form of wrestling. However, Kidd would find sanctuary in old-school promotions like Revolution British Wrestling, and Premier Promotions where he won various titles. Kidd still continues to compete in wrestling to this day, wrestling for various promotions around the UK, mostly LDN Wrestling, where has competed on all 4 Legends Showdown events.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":72,"storytelling":78,"productFit":100,"riskTaking":9,"matchLayout":80,"psychology":72,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":71,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":91,"mediaHandling":62,"brandBuilding":37,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":55,"awareness":72,"judgement":83}},{"id":901,"name":"Banana Senga","realName":"Banana Senga","picture":"Banana Senga.jpg","ability":44,"currentAbility":52,"potentialAbility":52,"charisma":62,"micSkills":61,"popularity":4,"condition":75,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":75,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1984-01-02T00:00:00.000Z","debut":"2004-05-16T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Tatsuhito Senga s a Japanese professional wrestler. He currently wrestles as a freelancer in the Japanese independent circuit and as a regular in Michinoku Pro Wrestling. After training in the Último Dragón Gym, Senga made his pro wrestling debut in Toryumon Mexico on December 11, 2004 under his real name. After some events, Senga changed his ring name to Banana Senga and became a member of the salsa-themed heel stable Los Salseros Japoneses. When El Dorado Wrestling was created in 2006, Senga was brought in by his Toryumon comrades and formed an alliance with Toru Owashi. In 2007, Owashi, founded a stable called Animal Planets, which had an animal theme. Thus, Senga adopted the name of Hercules Oosenga. In 2010, Senga debuted in Pro Wrestling Noah as RONIN, a creepy samurai ghost, and attacked SUGI after a match against Taiji Ishimori.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1326,2461],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":66,"productFit":100,"riskTaking":22,"matchLayout":67,"psychology":61,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":55,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":60,"brandBuilding":40,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":75,"awareness":61,"judgement":77}},{"id":902,"name":"Ken45°","realName":"Ken45°","picture":"Ken45.jpg","ability":52,"currentAbility":56,"potentialAbility":56,"charisma":69,"micSkills":54,"popularity":4,"condition":84,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-05-25T00:00:00.000Z","debut":"2002-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kenichi Sakai is a Japanese professional wrestler in the Michinoku Pro Wrestling promotion known by his ring name Ken45°. He debuted in Toryumon as Pineapple Hanai in the Los Salseros Japoneses stable, along with Takeshi Minamino and Mango Fukuda. He has since changed to a Rock and Roll character along the lines of Japanese legend, Ricky Fuji. When he first joined El Dorado, he wanted to become a member of the Aagan Iisou stable, but would lose a match to Takuya Sugawara which stipulated that he could not even occasionally team up with them. He instead became freelance, not allied with any stable. After growing tired of his free lifestyle, he joined up with the Sukiyaki stable when they were first being formed. He would soon turn heel and join the HELL DEMONS stable. Outside of wrestling, he's part of the rock band Crazy Crew with Ricky Fuji and The Great Sasuke.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":60,"storytelling":67,"productFit":100,"riskTaking":29,"matchLayout":69,"psychology":60,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":64,"characterCoaching":75,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":75,"brandBuilding":53,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":67,"awareness":60,"judgement":76}},{"id":903,"name":"Bear Fukuda","realName":"Bear Fukuda","picture":"Bear Fukuda.jpg","ability":58,"currentAbility":48,"potentialAbility":48,"charisma":52,"micSkills":39,"popularity":1,"condition":85,"hardcoreAbility":49,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":110,"height":175,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-06-27T00:00:00.000Z","debut":"2003-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Takayasu Fukuda is a Japanese professional wrestler. He currently wrestles as a freelancer in the Japanese independent circuit and as a regular in Secret Base. A Último Dragón Gym graduate, Fukuda started his career in Mexico under his real name, being the only heavyweight in his school class term. Shortly after his debut, Fukuda turned heel and joined forces with Takeshi Minamino and Pineapple Hanai to form the Los Salseros Japoneses stable, changing his name to Mango Fukuda and his attire to a salsa music outfit. The trio moved to Toryumon X and gained a major success by feuding with Sailor Boys (Taiji Ishimori, Kei Sato and Shu Sato).","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":57,"productFit":100,"riskTaking":32,"matchLayout":58,"psychology":53,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":47,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":66,"brandBuilding":30,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":58,"awareness":53,"judgement":72}},{"id":908,"name":"Slyck Wagner Brown","realName":"Slyck Wagner Brown","picture":"Wagner Brown.jpg","ability":49,"currentAbility":55,"potentialAbility":55,"charisma":67,"micSkills":63,"popularity":1,"condition":83,"hardcoreAbility":58,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":100,"height":185,"base":"Other","birthplace":"Unknown","dateOfBirth":"1979-09-05T00:00:00.000Z","debut":"1997-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Wagner Brown is a Jamaican born professional wrestler trained by Killer Kowalski and is better known by his ring name of Slyck Wagner Brown. SWB is signed with Urban Wrestling Federation and wrestles on the underground circuit in the Northeastern United States. Among his career highlights has been defeating Christopher Daniels for the 3PW Championship. He has competed for several Northeastern independent promotions, including Ring of Honor, Squared Circle Wrestling, and Big Time Wrestling. Brown would also have a longtime association with former NWo Girls April Hunter, who would manage and tag with him for several years even holding tag team titles together in several promotions. SWB also has experience wrestling in Japan, England, Ireland, Canada, and Puerto Rico.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3297],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":59,"productFit":100,"riskTaking":26,"matchLayout":61,"psychology":53,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":37,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":67,"brandBuilding":49,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":67,"awareness":53,"judgement":72}},{"id":912,"name":"Jonny Storm","realName":"Jonny Storm","picture":"Jonny Storm.jpg","ability":60,"currentAbility":56,"