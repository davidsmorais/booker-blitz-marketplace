vy":34,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":45,"awareness":0,"judgement":0},"contract":{"id":"tew-contract-729","wrestlerId":729,"promotionId":45,"startDate":"2020-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":730,"name":"Kentaro Hirakawa","realName":"Kentaro Hirakawa","picture":"Kentaro Hirakawa.jpg","ability":65,"currentAbility":62,"potentialAbility":62,"charisma":76,"micSkills":54,"popularity":2,"condition":100,"hardcoreAbility":52,"injuryProne":0,"type":"commentator","style":"all rounder","gender":"M","weight":76,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1970-01-06T00:00:00.000Z","debut":"1988-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kentaro Hirakawa is a Japanese announcer who works in Japan. He has called matches for many promotions and cross promotion events however he mostly covers the Pro Wrestling NOAH events.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":45,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":56,"brandBuilding":0,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":65,"awareness":0,"judgement":0},"contract":{"id":"tew-contract-730","wrestlerId":730,"promotionId":45,"startDate":"2020-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":731,"name":"Sam Shaw","realName":"Sam Shaw","picture":"Sam Shaw.jpg","ability":59,"currentAbility":56,"potentialAbility":56,"charisma":53,"micSkills":59,"popularity":33,"condition":93,"hardcoreAbility":55,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":109,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1984-01-17T00:00:00.000Z","debut":"2007-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Disconcerting. Unsettling. Creepy. All are perfectly apt descriptions for Dexter Lumis.\r\n\r\nWith a cold, dead stare that sent chills down the spines of the NXT Universe, Lumis made his debut on the black-and-gold brand in the summer of 2019 as part of the revolutionary Breakout Tournament. From the moment he stalked into the arena, it immediately became clear that the enigmatic powerhouse is cut from a different cloth than most Superstars.\r\n\r\nLittle is known about Lumis, but his abilities inside the ring are not in question. He is crushingly powerful, sadistically methodical and completely unorthodox in his movement. Moreover, he seems to take pleasure in others’ agony. Lumis likes to use his hands to “frame” opponents before upending them with his punishing offense, almost as if he’s preparing them to become portraits of his destruction.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2623,2821],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":59,"productFit":100,"riskTaking":27,"matchLayout":60,"psychology":56,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":53,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":68,"brandBuilding":68,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":67,"awareness":56,"judgement":74}},{"id":732,"name":"Chase Stevens","realName":"Chase Stevens","picture":"Chase Stevens.jpg","ability":53,"currentAbility":50,"potentialAbility":50,"charisma":43,"micSkills":46,"popularity":3,"condition":79,"hardcoreAbility":55,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":107,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1979-01-17T00:00:00.000Z","debut":"1998-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Chase Stevens is an American professional wrestler. He is known for his work in Total Nonstop Action Wrestling where he was a member of The Naturals alongside his former tag team partner Andy Douglas. In high school, Chase Stevens was a Golden Gloves boxing champion. After attending a professional wrestling training session, in order to watch a friend, Stevens decided to become a wrestler and joined the training school. After several weeks, veteran wrestler Tracy Smothers took him under his wing and became his trainer and mentor. Stevens debuted in 1998 under a mask as \"Glacius\", losing to fellow trainee Johnny B. Dazzled. In USA Championship Wrestling Stevens was placed in a tag team with Andy Douglas by Bob Ryder. While on a fishing trip they chose the name \"Natural Heat\", which was later shortened to \"The Naturals\". The Naturals became a pair of sneaky, cheating villains.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1443],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":39,"storytelling":48,"productFit":90,"riskTaking":42,"matchLayout":51,"psychology":39,"workerManagement":90,"trainingIntensity":67,"technicalCoaching":51,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":58,"mediaHandling":60,"brandBuilding":43,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":18,"reactionSpeed":67,"consistency":70,"awareness":39,"judgement":59}},{"id":733,"name":"Cassidy Riley","realName":"Cassidy Riley","picture":"Cassidy O'Reilly.jpg","ability":60,"currentAbility":56,"potentialAbility":56,"charisma":66,"micSkills":59,"popularity":2,"condition":77,"hardcoreAbility":39,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":93,"height":177,"base":"USA","birthplace":"United States","dateOfBirth":"1976-11-21T00:00:00.000Z","debut":"1994-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Cassidy Riley is an American professional wrestler, also known as Cassidy Reilly and Cassidy O'Riley best known for work with Total Nonstop Action Wrestling and World Wrestling Entertainment. O'Reilly trained under Lolly Dude, a promoter in Dallas, for eight months, receiving supplemental training from Terry Taylor and Tommy Rogers, who were working for Dude at the time. He debuted in 1995 under his own name, facing Cedric Crain in Brighton, Tennessee. He then began wrestling on the Southern independent circuit. O'Reilly formed a new tag team with Chase Stevens known as \"The Hotshots\". The Hotshots worked in Nashville before appearing with the fledgling NWA:TNA promotion in July 2002, when they were signed to full time contracts. Following a feud with America's Most Wanted, the team split in October 2002 when O'Reilly left TNA due to travel problems, returning to Louisiana and taking a hiatus from wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1443],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":21,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":52,"characterCoaching":48,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":48,"brandBuilding":42,"socialMediaSavvy":52,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":65,"awareness":58,"judgement":75}},{"id":735,"name":"Todd Keneley","realName":"Todd Keneley","picture":"Todd Keneley.jpg","ability":42,"currentAbility":50,"potentialAbility":50,"charisma":52,"micSkills":41,"popularity":1,"condition":100,"hardcoreAbility":31,"injuryProne":24,"type":"commentator","style":"all rounder","gender":"M","weight":90,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1976-12-08T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Todd Keneley is a wrestling ring & play-by-play announcer. Broke into the business working for UPW in California and achieved his greatest success as the ring announcer for Celebrity Championship Wrestling. He also played one of The Undertaker's druids at WrestleMania 21.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":53,"brandBuilding":37,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0}},{"id":736,"name":"Tony Nese","realName":"Tony Nese","picture":"Anthony Nese.jpg","ability":59,"currentAbility":62,"potentialAbility":62,"charisma":69,"micSkills":75,"popularity":16,"condition":87,"hardcoreAbility":81,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":89,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1985-08-06T00:00:00.000Z","debut":"2005-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Tony Nese refers to himself as “The Premier Athlete,” but he just might be the premier Cruiserweight in the world.\r\n\r\nA longtime mainstay of the American independent circuit, Nese brings a certain confidence to the Cruiserweight division. And, to be fair, that confidence is not unfounded. With the most impressive physique in the division, a resume that includes clashes with the likes of Matt Hardy and Paul London, as well as a beyond-impressive 450 Splash, Nese has it all. \r\n\r\nThe Premier Athlete lived up to his considerable hype at WrestleMania 35 when he defeated former training partner Buddy Murphy in an edge-of-your-seat fight to capture his first WWE Cruiserweight Title.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[1087,3018,3260,3573],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":37,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":62,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":44,"brandBuilding":48,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":78,"awareness":56,"judgement":74},"contract":{"id":"tew-contract-736","wrestlerId":736,"promotionId":49,"startDate":"2023-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000,"inDevelopment":true},{"id":738,"name":"Kevin Thorn","realName":"Kevin Thorn","picture":"Sevin Thorn.jpg","ability":53,"currentAbility":51,"potentialAbility":51,"charisma":41,"micSkills":53,"popularity":5,"condition":67,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":125,"height":187,"base":"USA","birthplace":"United States","dateOfBirth":"1977-01-17T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kevin Matthew Fertig is an American professional wrestler best known for working with World Wrestling Entertainment (WWE) on its ECW brand under the ring name Kevin Thorn. Fertig made his professional wrestling debut in 2000, and quickly began working for the Memphis Championship Wrestling promotion in his hometown, under the ring name Seven. He signed a contract with WWE in April 2002, and was assigned to their developmental territory, Ohio Valley Wrestling (OVW). He competed in OVW for two years, winning the OVW Southern Tag Team Championship with Travis Bane, before being called up to the SmackDown brand as Mordecai, a religious zealot. Following his WWE release, Fertig began using the Mordecai name again while working on the independent circuit. Fertig made his return in June 2006 on WWE's ECW brand as a vampire. Following his release from WWE, Fertig toured Europe, and stated he was considering working in Mexico and Puerto Rico.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":56,"productFit":100,"riskTaking":29,"matchLayout":57,"psychology":54,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":36,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":64,"brandBuilding":54,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":65,"awareness":54,"judgement":72}},{"id":739,"name":"DASH Chisako","realName":"DASH Chisako","picture":"DASH Chisako.jpg","ability":57,"currentAbility":62,"potentialAbility":62,"charisma":58,"micSkills":51,"popularity":4,"condition":82,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":56,"height":147,"base":"Japan","birthplace":"Japan","dateOfBirth":"1988-08-24T00:00:00.000Z","debut":"2006-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"DASH Chisako (real name Chisako Jumonji) is a professional wrestler working for Sendai Girls Pro Wrestling since its opening. She was trained under Meiko Satomura along with her sister Sendai Sachiko.  Has had good success tagging with her sister, and seems to have alot of potential. On October 2, 2005, Jumonji, along with her sister Sachiko, took part in a professional wrestling audition held by Meiko Satomura. After passing the audition, both of the Jumonji sisters were admitted to the first training class of Satomura's new Sendai Girls' Pro Wrestling promotion, and began training under her the following December. Jumonji made her professional wrestling debut on July 9, 2006, at Sendai Girls' first ever event, where she, working under the ring name Chisako Kanari.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":70,"teams":[1698,1724,1957,2482,2483,2484,3348],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":72,"storytelling":75,"productFit":100,"riskTaking":30,"matchLayout":76,"psychology":72,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":61,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":73,"brandBuilding":65,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":65,"awareness":72,"judgement":83},"contract":{"id":"tew-contract-739","wrestlerId":739,"promotionId":70,"startDate":"2006-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":740,"name":"Johnny Swinger","realName":"Johnny Swinger","picture":"Johnny Swinger.jpg","ability":60,"currentAbility":60,"potentialAbility":60,"charisma":61,"micSkills":69,"popularity":7,"condition":79,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":98,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1975-07-03T00:00:00.000Z","debut":"1993-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Joseph Robert \"Joe\" Dorgan s an American professional wrestler. He is best known for his appearances with Extreme Championship Wrestling and Total Nonstop Action Wrestling as Johnny Swinger and with World Wrestling Entertainment as Johnny Parisi. After training in Toronto, Ontario, Dorgan started wrestling on the independent circuit in 1993 as \"Johnny Paradise\". After he discovered that another wrestler was already using that name, he renamed himself \"Johnny Hollywood Swinger\" and began to make a name for himself as a villain in Scott D'Amore's \"Syndicate\" faction. Swinger joined ECW in 2000. He was placed in a tag team with Simon Diamond by booker Paul Heyman in May 2000, and shortened his name to \"Swinger.\" He remained with ECW until it folded in April 2001. Swinger returned to WCW for one week for the Cruiserweight Tag Team Tournament.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":118,"teams":[428,2669],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":65,"productFit":100,"riskTaking":20,"matchLayout":66,"psychology":62,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":56,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":64,"brandBuilding":45,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":66,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-740","wrestlerId":740,"promotionId":118,"startDate":"2024-10-19T00:00:00.000Z","endDate":"2026-10-19T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-10-19T00:00:00.000Z","wage":1000},{"id":742,"name":"Tamon Honda","realName":"Tamon Honda","picture":"Tamon Honda.jpg","ability":85,"currentAbility":90,"potentialAbility":90,"charisma":77,"micSkills":100,"popularity":6,"condition":48,"hardcoreAbility":78,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":136,"height":185,"base":"Japan","birthplace":"Japan","dateOfBirth":"1963-08-15T00:00:00.000Z","debut":"1993-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Tamon Honda is a Japanese professional wrestler who worked for Pro Wrestling Noah. Honda represented Japan in three Olympic Games in freestyle wrestling in 1984, 1988, and 1992. He almost joined All Japan Pro Wrestling in the 1980s, but it wasn't until after he turned 30 years old that he debuted. Although he never reached the main event level many believed he would, Honda held the All Asia Tag Team Championship in the late 1990s. After joining Pro Wrestling Noah, he gradually became a regular on the roster, with 2002 and 2003 seeing major progress for him.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3301,3302],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":79,"storytelling":81,"productFit":100,"riskTaking":31,"matchLayout":81,"psychology":79,"workerManagement":100,"trainingIntensity":50,"technicalCoaching":66,"characterCoaching":38,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":38,"brandBuilding":25,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":20,"reactionSpeed":50,"consistency":35,"awareness":79,"judgement":87}},{"id":744,"name":"BxB Hulk","realName":"BxB Hulk","picture":"BxB Hulk.jpg","ability":65,"currentAbility":60,"potentialAbility":60,"charisma":51,"micSkills":71,"popularity":6,"condition":69,"hardcoreAbility":48,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":81,"height":175,"base":"Japan","birthplace":"Japan","dateOfBirth":"1980-07-15T00:00:00.000Z","debut":"2005-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"BxB Hulk, a 2005 graduate of the Dragon Gate Dojo, is a Japanese wrestler who works in America and Japan. He is a Lightweight who is classed as using a Technician Flyer style. He is best known for his work with Dragongate. He is currently an Open the Twin Gate champion. He was voted Young Wrestler Of The Year in 2007.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[921,1211],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":72,"storytelling":76,"productFit":100,"riskTaking":21,"matchLayout":77,"psychology":72,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":68,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":78,"brandBuilding":73,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":62,"awareness":72,"judgement":83},"contract":{"id":"tew-contract-744","wrestlerId":744,"promotionId":14,"startDate":"2005-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"boo