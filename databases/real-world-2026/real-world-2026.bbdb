00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Danny Garnell is a retired English wrestler who works primarily as a colour commentator.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2837],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":52,"storytelling":58,"productFit":70,"riskTaking":31,"matchLayout":60,"psychology":52,"workerManagement":70,"trainingIntensity":72,"technicalCoaching":42,"characterCoaching":45,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":45,"brandBuilding":36,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":14,"reactionSpeed":72,"consistency":78,"awareness":52,"judgement":59}},{"id":792,"name":"Dave Mastiff","realName":"Dave Mastiff","picture":"Dave Mastiff.jpg","ability":65,"currentAbility":58,"potentialAbility":58,"charisma":56,"micSkills":73,"popularity":3,"condition":75,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":143,"height":172,"base":"UK","birthplace":"England","dateOfBirth":"1984-07-21T00:00:00.000Z","debut":"2002-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Simply put, Dave Mastiff loves a good fight. Willing to take a hit in order to hit someone back even harder, the always-intense Mastiff has never been accused of being bashful.\r\n\r\nWith his imposing and massive frame, the bruiser used to participate in strongman competitions, but he was also a former county-level gymnast. That all translates to a confounding but effective package inside the ring, as the big, bad Mastiff can surprise opponents with feats of agility that are both awe-inspiring and destructive. Mastiff’s diverse skillset makes him an immediate threat every time he steps through the ropes.\r\n\r\nWithout a doubt, The Bomber is among the most feared competitors in the NXT UK locker room, and it’s a safe bet that whenever he competes, all-out destruction will follow.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2837,3537],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":59,"productFit":100,"riskTaking":27,"matchLayout":60,"psychology":56,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":42,"characterCoaching":45,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":45,"brandBuilding":43,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":68,"awareness":56,"judgement":74}},{"id":793,"name":"Iestyn Rees","realName":"Iestyn Rees","picture":"Iestyn Rees.jpg","ability":62,"currentAbility":56,"potentialAbility":56,"charisma":54,"micSkills":51,"popularity":2,"condition":87,"hardcoreAbility":70,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":114,"height":190,"base":"UK","birthplace":"Wales","dateOfBirth":"1983-03-31T00:00:00.000Z","debut":"2003-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Iestyn Rees is a Welsh wrestler who works in the British Isles and Europe. He is a Light Heavyweight who is classed as using a Regular style.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2724,2725,3087],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":47,"storytelling":54,"productFit":100,"riskTaking":34,"matchLayout":56,"psychology":47,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":47,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":66,"brandBuilding":69,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":76,"awareness":47,"judgement":68}},{"id":795,"name":"James Mason","realName":"James Mason","picture":"James Mason.jpg","ability":67,"currentAbility":64,"potentialAbility":64,"charisma":71,"micSkills":79,"popularity":8,"condition":81,"hardcoreAbility":44,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":100,"height":177,"base":"UK","birthplace":"England","dateOfBirth":"1979-07-22T00:00:00.000Z","debut":"1993-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"James Atkins s a British professional wrestler best known under his ring name James Mason. A childhood fan of Big Daddy, Atkins began wrestling for All Star Wrestling in 1993, adopting the ringname James Mason, after the film actor of the same name at the behest of ring announcer John Harris. Early in his career, he also wrestled for Welsh promoter Orig Williams under the name Jesse James (as Williams felt the actor in question was \"boring\" and this would reflect poorly on Atkins.) In 1995, Mason was named by All Star as \"Young Wrestler Of 1995\" and was interviewed by Simon Garfield for his book The Wrestling. In early 1996, he won a tournament promoted by Rumble Promotions for the World Middleweight Title left vacant by Danny Collins when he moved up the weights. Mason lost the title to Mal Sanders a month later. Alongside his appearances for All Star and promoting his own shows and hiring out his ring, Mason also wrestles for International Pro Wrestling: United Kingdom.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":60,"storytelling":68,"productFit":90,"riskTaking":21,"matchLayout":70,"psychology":60,"workerManagement":90,"trainingIntensity":79,"technicalCoaching":67,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":51,"brandBuilding":51,"socialMediaSavvy":31,"ruleKnowledge":0,"positioning":18,"reactionSpeed":79,"consistency":76,"awareness":60,"judgement":72}},{"id":804,"name":"Martin Kirby","realName":"Martin Kirby","picture":"Martin Kirby.jpg","ability":52,"currentAbility":61,"potentialAbility":61,"charisma":52,"micSkills":75,"popularity":4,"condition":81,"hardcoreAbility":60,"injuryProne":99,"type":"wrestler","style":"powerhouse","gender":"M","weight":82,"height":177,"base":"UK","birthplace":"England","dateOfBirth":"1982-05-13T00:00:00.000Z","debut":"2000-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"As one half of Project: Ego, Martin Kirby has gained a reputation as one of the most obnoxious wrestlers in the UK today. Alongside his partner Kris Travis, Kirby has found success in the North of England and the duo have cemented themselves as the best team in that region. At IPW:UK Summer Sizzler, Project: Ego began their quest to become the best tag team not only in the North but in the whole of England, and captured their first ever IPW:UK gold in August of 2012, defeating then champions The Leaders of the New School.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2727,3079,3080],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":72,"productFit":100,"riskTaking":27,"matchLayout":73,"psychology":70,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":67,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":66,"brandBuilding":42,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":78,"awareness":70,"judgement":82}},{"id":805,"name":"Noam Dar","realName":"Noam Dar","picture":"Noam Dar.jpg","ability":71,"currentAbility":64,"potentialAbility":64,"charisma":62,"micSkills":60,"popularity":24,"condition":85,"hardcoreAbility":52,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":81,"height":172,"base":"Other","birthplace":"Unknown","dateOfBirth":"1993-07-28T00:00:00.000Z","debut":"2008-06-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"As one of the youngest competitors in WWE and the first Israeli-born Superstar to compete in a WWE ring, Dar has been making a name for himself in Europe since breaking into the industry as a teenager. A mat-wrestling maven that has forced countless opponents to submit to his vicious kneebar, Dar has held his own against the likes of Finn Bálor and AJ Styles while solidifying himself as one of the UK’s brightest stars. The Scottish Supernova represented his home countries of Scotland and Israel well in the inaugural WWE Cruiserweight Classic, making it all the way to the Quarterfinals.\r\n\r\nAfter competing on Monday Night Raw and WWE 205 Live, Dar jumped to NXT UK, looking to make a major impact back in his homeland. And he’s done just that with an extremely brash attitude.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":65,"teams":[1016,4385],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":71,"storytelling":73,"productFit":100,"riskTaking":14,"matchLayout":74,"psychology":71,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":69,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":70,"brandBuilding":43,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":72,"awareness":71,"judgement":83},"contract":{"id":"tew-contract-805","wrestlerId":805,"promotionId":65,"startDate":"2018-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"inDevelopment":true},{"id":808,"name":"Rampage Brown","realName":"Rampage Brown","picture":"Rampage Brown.jpg","ability":53,"currentAbility":61,"potentialAbility":61,"charisma":53,"micSkills":55,"popularity":3,"condition":85,"hardcoreAbility":44,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":106,"height":182,"base":"UK","birthplace":"England","dateOfBirth":"1983-08-08T00:00:00.000Z","debut":"2001-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"A 20-year veteran of the squared circle, Rampage Brown is here to live up to his name and tear NXT UK apart.\r\n\r\nAn absolute bruiser from Leeds, England, Brown has thrown down with some of WWE’s biggest Superstars during his career, including Drew McIntyre, Samoa Joe and Aleister Black, to name a few. But now, Rampage Brown has finally brought his brand of destruction to WWE. Armed with a devastating Doctor Bomb and the respect of the entire locker room, the rampage has begun in NXT UK, and there’s seemingly no limit as to how far Rampage Brown’s obliteration will go.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1606,1969,2846],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":69,"productFit":100,"riskTaking":20,"matchLayout":70,"psychology":67,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":45,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":58,"brandBuilding":67,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":64,"awareness":67,"judgement":80}},{"id":809,"name":"RJ Singh","realName":"RJ Singh","picture":"RJ Singh.jpg","ability":48,"currentAbility":53,"potentialAbility":53,"charisma":63,"micSkills":57,"popularity":2,"condition":86,"hardcoreAbility":45,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":77,"height":175,"base":"UK","birthplace":"England","dateOfBirth":"1981-05-26T00:00:00.000Z","debut":"2001-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"RJ Singh is an English wrestler who works exclusively in the British Isles. He is a Lightweight who is classed as using a Technician Flyer style. He is best known for his work with RevPro, PROGRESS and SWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":59,"productFit":100,"riskTaking":30,"matchLayout":61,"psychology":54,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":47,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":58,"brandBuilding":36,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":75,"awareness":54,"judgement":72}},{"id":811,"name":"Sha Samuels","realName":"Sha Samuels","picture":"Sha Samuels.jpg","ability":57,"currentAbility":63,"potentialAbility":63,"charisma":61,"micSkills":59,"popularity":5,"condition":82,"hardcoreAbility":51,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":107,"height":182,"base":"UK","birthplace":"England","dateOfBirth":"1985-02-27T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"The East-End hard man is another IPW:UK original, having been with the promotion since its inception.  As one half of The Kartel alongside his best friend Terry Frazier, Samuels enjoyed huge success in the tag team ranks as The Kartel, dominating that division for many years. With a rugged, hard hitting style, Sha Samuels was the perfect partner to Frazier’s faster, high flying style and this perfect partnership led The Kartel to the British Tag Team Championships.  In May 2011, Samuels took on Undisputed Champion Dave Mastiff and Pro Wrestling Noah star Takeshi Morishima in a Triple Threat match with the richest prize in European wrestling on the line. Morishima was the first man eliminated which left Samuels and Mastiff to battle it out. Following interference from ‘Rockstar’ Spud, Samuels used a title belt to finish off Mastiff and become the brand new Undisputed British Heavyweight Champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":48,"teams":[1652,3212,3231],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":63,"productFit":100,"riskTaking":29,"matchLayout":65,"psychology":56,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":51,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":69,"brandBuilding":54,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":78,"awareness":56,"judgement":74},"contract":{"id":"tew-contract-811","wrestlerId":811,"promotionId":48,"startDate":"2023-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":814,"name":"Zack Sabre Jr.","realName":"Zack Sabre Jr.","picture":"Zack Sabre Jr.jpg","ability":64,"currentAbility":70,"potentialAbility":70,"charisma":68,"micSkills":71,"popularity":44,"condition":86,"hardcoreAbility":66,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":96,"height":182,"base":"UK","birthplace":"England","dateOfBirth":"1987-07-24T00:00:00.000Z","debut":"2002-07-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Zack Sabre Jr. has a well-earned reputation for being one of the best technical wrestlers and deadliest strikers in pro wrestling. A member of the Suzuki-gun faction in New Japan Pro-Wrestling, the no-nonsense Sabre has won championships all over the world. In 2018, he also won the prestigious New Japan World Cup by defeating Tetsuya Naito, Kota Ibushi, Sanada and Hiroshi Tanahashi in succession.\r\n\r\nSabre made his much-anticipated Ring of Honor debut at Final Battle 2018, where he defeated Jonathan Gresham in a matchup of outstanding technicians.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[592,2086,2224,3052],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":78,"productFit":100,"riskTaking":14,"matchLayout":80,"psychology":73,"workerManagement":100,"trainingIntensity":88,"technicalCoaching":90,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":76,"brandBuilding":64,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":88,"consistency":93,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-814","wrestlerId":814,"promotionId":38,"startDate":"2017-03-06T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":817,"name":"Carlito","realName":"Carlito","picture":"Carlito.jpg","ability":64,"currentAbility":58,"potentialAbility":58,"charisma":46,"micSkills":61,"popularity":38,"condition":71,"hardcoreAbility":49,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":109,"height":175,"base":"USA","birthplace":"Puerto Rico","dateOfBirth":"1979-02-21T00:00:00.000Z","debut":"1999-10-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Carlito is a Puerto Rican wrestler who works in America, Canada, Mexico and the British Isles. He is a Middleweight who is classed as using a Regular style. He is best known for his work with WWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[983,3082],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":66,"productFit":100,"riskTaking":27,"matchLayout":67,"psychology":61,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":53,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":77,"brandBuilding":65,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":49,"awareness":61,"judgement":77}},{"id":820,"name":"Sabu","realName":"Sabu","picture":"Sabu.jpg","ability":45,"currentAbility":51,"potentialAbility":51,"charisma":36,"micSkills":62,"popularity":26,"condition":53,"hardcoreAbility":33,"injuryProne":100,"type":"wrestler","style":"hardcore","gender":"M","weight":107,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1964-12-12T00:00:00.000Z","debut":"1985-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":true,"story":"Terry Michael Brunk better known by his ring name Sabu, is an American professional wrestler. He is a three-time world heavyweight champion (two ECW Championships, one NWA Championship), and is best known for his appearances with the original Extreme Championship Wrestling and other independents throughout the 1990s, Total Nonstop Action Wrestling from 2002 until 2006, and his recent tenure in World Wrestling Entertainment on its ECW brand, which lasted from April 2006 until May 2007. He is most well-known for his extreme wrestling style.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1304,3281,3282,3283],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":43,"storytelling":54,"productFit":100,"riskTaking":58,"matchLayout":58,"psychology":43,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":36,"characterCoaching":80,"diagnosis":50,"rehabilitation":50,"prevention":42,"mediaHandling":80,"brandBuilding":68,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":40,"awareness":43,"judgement":66}},{"id":821,"name":"The Sandman","realName":"The Sandman","picture":"Sandman.jpg","ability":38,"currentAbility":35,"potentialAbility":35,"charisma":45,"micSkills":44,"popularity":20,"condition":48,"hardcoreAbility":38,"injuryProne":45,"type":"wrestler","style":"hardcore","gender":"M","weight":109,"height":190,"base":"USA","birthplace":"United States","dateOfBirth":"1963-06-16T00:00:00.000Z","debut":"1989-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"James \"Jim\" Fullington better known by his ring name Sandman, is an American professional wrestler, best known for his career with Extreme Championship Wrestling (ECW), where he developed into a \"Hardcore Icon\". Fullington has been a five-time world heavyweight champion, having held the ECW World Heavyweight Championship 5 times. He has also held the XPW World Heavyweight Championship once, the IWC World Heavyweight Championship once, and the UWF Universal Heavyweight Championship once. He also had stints in World Championship Wrestling, Total Nonstop Action Wrestling, and World Wrestling Entertainment.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":40,"storytelling":44,"productFit":100,"riskTaking":63,"matchLayout":45,"psychology":40,"workerManagement":100,"trainingIntensity":24,"technicalCoaching":11,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":37,"mediaHandling":82,"brandBuilding":38,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":24,"consistency":21,"awareness":40,"judgement":64}},{"id":823,"name":"Damián 666","realName":"Damián 666","picture":"Damian 666.jpg","ability":59,"currentAbility":54,"potentialAbility":54,"charisma":57,"micSkills":42,"popularity":8,"condition":64,"hardcoreAbility":35,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":101,"height":172,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1961-07-09T00:00:00.000Z","debut":"1979-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Leonardo Carrera Gómez is a Mexican professional wrestler best known under the name Damián 666. He has worked for World Championship Wrestling (WCW), Consejo Mundial de Lucha Libre (CMLL), Asistencia Asesoría y Administración (AAA), World Wrestling Association (WWA) and various promotions on the Mexican independent circuit, including Perros del Mal Producciones. Carrera also worked under the ring name Galaxy in WCW, a masked Luchador. Carrera often team with Halloween, forming the team \"Mexico's Most Wanted\" which has worked extensively in North America for such promotions as Xtreme Pro Wrestling (XPW) and Revolution Pro. Carrera's son currently wrestles for Perros del Mal as Bestia 666.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1153,1223,1655,1916,3176],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":64,"storytelling":69,"productFit":100,"riskTaking":32,"matchLayout":71,"psychology":64,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":31,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":63,"brandBuilding":48,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":63,"awareness":64,"judgement":78}},{"id":824,"name":"TAJIRI","realName":"TAJIRI","picture":"Tajiri.jpg","ability":75,"currentAbility":65,"potentialAbility":65,"charisma":75,"micSkills":78,"popularity":18,"condition":64,"hardcoreAbility":81,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":83,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1970-09-29T00:00:00.000Z","debut":"1994-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Trained in lucha libre and Japanese styles of wrestling, Tajiri first made an impact on U.S. shores when he debuted in Extreme Championship Wrestling in late 1998. Clad in traditional blue and white tights with an insignia of Japan's rising sun, he initially could have passed as an Asian Bob Backlund, circa 1970s and ‘80s, in his appearance. But there was nothing plain about Tajiri's repertoire, and fans immediately knew he was something special.\r\n\r\nTajiri reminded observers of The Great Muta with his vicious roundhouse kicks, moonsaults, corkscrew elbow drops, Tarantula Boston Crabs in the ropes and flying somersault elbows in the corner. Soon after his ECW debut, Tajiri grew a goatee, started wearing long ninja pants and spewing green mist. His transformation was complete -- he was no longer just Yoshiro Tajiri, he was \"The Japanese Buzzsaw.\"","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2305,2832,2887],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":76,"productFit":100,"riskTaking":26,"matchLayout":78,"psychology":69,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":67,"characterCoaching":74,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":74,"brandBuilding":51,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":62,"awareness":69,"judgement":81}},{"id":825,"name":"Koharu Hinata","realName":"Koharu Hinata","picture":"Koharu Hinata.jpg","ability":63,"currentAbility":59,"potentialAbility":59,"charisma":72,"micSkills":56,"popularity":0,"condition":100,"hardcoreAbility":63,"injuryProne":71,"type":"referee","style":"technical","gender":"F","weight":45,"height":142,"base":"Japan","birthplace":"Japan","dateOfBirth":"1984-12-01T00:00:00.000Z","debut":"2006-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Koharu Hinata is a Japanese wrestler who works exclusively in Japan. She is a Small worker who is classed as using a Regular Wrestler style.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":63,"productFit":65,"riskTaking":59,"matchLayout":63,"psychology":61,"workerManagement":65,"trainingIntensity":64,"technicalCoaching":55,"characterCoaching":42,"diagnosis":50,"rehabilitation":50,"prevention":41,"mediaHandling":42,"brandBuilding":23,"socialMediaSavvy":51,"ruleKnowledge":59,"positioning":60,"reactionSpeed":64,"consistency":44,"awareness":61,"judgement":63}},{"id":827,"name":"Ophidian","realName":"Ophidian","picture":"Ophidian.jpg","ability":85,"currentAbility":82,"potentialAbility":82,"charisma":83,"micSkills":79,"popularity":3,"condition":88,"hardcoreAbility":93,"injuryProne":100,"type":"writer","style":"high flyer","gender":"M","weight":75,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1987-12-20T00:00:00.000Z","debut":"2007-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":true,"dead":false,"story":"Joel Maldonado, better known by his ring name, Ophidian, is a professional wrestler best known for performing with Chikara. He was previously a member of the The Osirian Portal stable along with his former partners Amasis and Hieracon. His gimmick was an anthropomorphic Egyptian cobra, which was reflected in his in-ring gear and cobra head mask as well as his mannerisms and speech. Ophidian currently serves as an assistant trainer at The Wrestle Factory, operated by Chikara founder Mike Quackenbush. Ophidian began using a new look at Chikara shows for the eleventh season, switching to a red snake mask instead of a cobra's head at Chikarasaurus Rex: How to Hatch a Dinosaur. Throughout the eleventh season he also began allying himself with The Batiri and Delirious.\r\n\r\nHe's venomous and vile... he's the serpent from the Nile... he is Ophidian.\r\n","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1485,3147,3148],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":69,"productFit":100,"riskTaking":21,"matchLayout":71,"psychology":63,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":61,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":67,"brandBuilding":44,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":74,"awareness":63,"judgement":78}},{"id":828,"name":"Desean Pratt","realName":"Desean Pratt","picture":"Amasis_alt.jpg","ability":49,"currentAbility":55,"potentialAbility":55,"charisma":55,"micSkills":59,"popularity":0,"condition":81,"hardcoreAbility":40,"injuryProne":98,"type":"wrestler","style":"powerhouse","gender":"M","weight":81,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1987-01-16T00:00:00.000Z","debut":"2007-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Desean Pratt was formerly known as \"The Funky Pharaoh\" Amasis and is a product of the CHIKARA Wrestle Factory. He debuted in 2007 and formed a dominant partnership with Ophidian as the Osirian Portal. In 2011 Amasis was hurt in a \"non-wrestling\" accident (although what this was is only speculated) and was forced to retire from active in ring action. Amasis made a shock return to Chikara on December 2, 2012, at Under the Hood, starting a rivalry with Ophidian. He lost his mask in 2016 to Frightmare at CHIKARA's Temple of Doom Event.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1485,3147,3148,3416],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":55,"productFit":50,"riskTaking":44,"matchLayout":57,"psychology":49,"workerManagement":50,"trainingIntensity":71,"technicalCoaching":58,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":76,"brandBuilding":47,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":10,"reactionSpeed":71,"consistency":75,"awareness":49,"judgement":49}},{"id":829,"name":"Trent Beretta","realName":"Trent Beretta","picture":"Trent Barreta.jpg","ability":73,"currentAbility":65,"potentialAbility":65,"charisma":56,"micSkills":70,"popularity":31,"condition":77,"hardcoreAbility":81,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":92,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1987-03-30T00:00:00.000Z","debut":"2004-07-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Trent has a well-deserved reputation as a tag team specialist. After establishing himself as a talented and versatile competitor with various U.S. promotions for more than a decade, Trent made his debut in Ring of Honor in March 2015 as one half of Roppongi Vice with international superstar Rocky Romero. Less than 30 days after debuting as a team, Trent? and Romero won the IWGP Junior Heavyweight Tag Team Championships from The Young Bucks and would go on to win those titles three other times.\r\n\r\nIn 2017, Trent formed a new team with Chuck Taylor. Calling themselves Best Friends, Trent and Taylor immediately became one of the most popular tag teams in ROH and have set their sights on the ROH World Tag Team Titles.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[946,1301,1302,1778,1779,1900,3417,4204,4205],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":68,"productFit":100,"riskTaking":30,"matchLayout":69,"psychology":65,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":64,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":61,"brandBuilding":60,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":78,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-829","wrestlerId":829,"promotionId":76,"startDate":"2019-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":830,"name":"Bob Holly","realName":"Bob Holly","picture":"Bob Holly.jpg","ability":60,"currentAbility":61,"potentialAbility":61,"charisma":49,"micSkills":51,"popularity":6,"condition":60,"hardcoreAbility":79,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":107,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1963-01-29T00:00:00.000Z","debut":"1987-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"is an American professional wrestler. He is best known for his 15-year stint with the World Wrestling Federation/World Wrestling Entertainment (WWF/E) under the ring names Thurman \"Sparky\" Plugg, Bob Holly, Bombastic Bob and Hardcore Holly. After debuting in 1990, Holly worked for Smoky Mountain Wrestling and other independent promotions, before joining WWE full-time in 1994. Initially portraying the character of a NASCAR driver, Thurman \"Sparky\" Plugg, his name was soon changed to Bob \"Spark Plug\" Holly, before forming a team with Bodacious Bart, known as The New Midnight Express in 1998. After becoming known simply as \"Hardcore Holly\" in 1999, he was joined by on-screen cousins, Crash and Molly. In 2002, he suffered a broken neck, which sidelined him for over a year. Upon his return, he engaged in minor feuds with wrestlers such as Mr. Kennedy and Rob Van Dam, before forming a tag team with Cody Rhodes in 2007. Holly was released from WWE in 2009.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2709],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":70,"productFit":100,"riskTaking":29,"matchLayout":72,"psychology":65,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":40,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":44,"brandBuilding":38,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":64,"awareness":65,"judgement":79}},{"id":831,"name":"Ikuhisa Minowa","realName":"Ikuhisa Minowa","picture":"Ikuhisa Minowa.jpg","ability":66,"currentAbility":57,"potentialAbility":57,"charisma":59,"micSkills":52,"popularity":2,"condition":77,"hardcoreAbility":66,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":88,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-01-12T00:00:00.000Z","debut":"2010-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ikuhisa Minowa is a Japanese mixed martial artist and professional wrestler. He was a longtime veteran of PRIDE and Pancrase and has also competed in other mixed martial arts promotions such as K-1 HERO'S, Cage Rage, UFC, and DEEP. At 5'9\" he is notable for taking fights with much larger opponents and defeating the majority of them, in his 21 career Openweight bouts. He is the former Dream Super Hulk Tournament Champion. Minowa made his professional debut in the Lumax Cup in 1996, but would spend most of his early career in the Pancrase organization. Minowa has also undertook some additional professional wrestling training under the tutelage of Satoru Sayama, the original Tiger Mask. A Fifth Generation Tiger Mask debuted on July 18, 2010 alongside the original Tiger Mask, Sayama, in a tag match for Maki Dojo. It has been confirmed that Tiger Mask V is Ikuhisa Minowa.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":46,"storytelling":54,"productFit":16,"riskTaking":37,"matchLayout":57,"psychology":46,"workerManagement":16,"trainingIntensity":73,"technicalCoaching":68,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":67,"brandBuilding":57,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":3,"reactionSpeed":73,"consistency":77,"awareness":46,"judgement":34}},{"id":832,"name":"Super Delfin","realName":"Super Delfin","picture":"Super Delfin.jpg","ability":52,"currentAbility":60,"potentialAbility":60,"charisma":69,"micSkills":51,"popularity":4,"condition":71,"hardcoreAbility":51,"injuryProne":99,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":165,"base":"Japan","birthplace":"Japan","dateOfBirth":"1967-09-22T00:00:00.000Z","debut":"1989-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Hiroto Wakita is a Japanese professional wrestler who currently runs Okinawa Pro Wrestling and is also working as a wrestler there. He is better known by his stage name Super Delfin. Hiroto Wakita joined the New Japan Pro Wrestling dojo. He was affiliated with the Takeshi Puroresu Gundan, a Japanese take on the \"Rock 'n Wrestling\" concept espoused by the WWF at the time. On March 15, 1996 he defeated El Pantera for the CMLL World Welterweight Championship in Osaka, Japan. However Consejo Mundial de Lucha Libre did not acknowledge the change and declared the championship vacant because El Pantera had jumped to CMLL's competitor Asistencia Asesoría y Administración before leaving for Japan.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":73,"productFit":100,"riskTaking":36,"matchLayout":74,"psychology":69,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":68,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":44,"brandBuilding":49,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":60,"awareness":69,"judgement":81}},{"id":833,"name":"Matt Cross","realName":"Matt Cross","picture":"Matt Cross.jpg","ability":53,"currentAbility":57,"potentialAbility":57,"charisma":69,"micSkills":47,"popularity":12,"condition":78,"hardcoreAbility":39,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1980-12-31T00:00:00.000Z","debut":"2001-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Matt Cross is an American wrestler who works in the USA, Canada, the British Isles, Japan and Europe. He is a 5'7\", 177lb worker who is classed as using a High Flyer style. He uses the Death From Above as his finisher. He is best known for his work with NOAH, PWG, ROH, NWA, wXw, BJW, MLW, HOH, DEFY, Lucha Ungrnd, Beyond, PROGRESS, AAW, JCW, AIW, Smash, IWA-MS, CZW, ICW and SWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":120,"teams":[473,1580,2881],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":19,"matchLayout":66,"psychology":58,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":51,"brandBuilding":43,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":67,"awareness":58,"judgement":75},"contract":{"id":"tew-contract-833","wrestlerId":833,"promotionId":120,"startDate":"2024-05-03T00:00:00.000Z","endDate":"2026-05-03T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-05-03T00:00:00.000Z","wage":1000},{"id":834,"name":"Barbie Blank","realName":"Barbie Blank","picture":"Kelly Kelly.jpg","ability":42,"currentAbility":40,"potentialAbility":40,"charisma":35,"micSkills":32,"popularity":17,"condition":91,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"F","weight":49,"height":162,"base":"USA","birthplace":"United States","dateOfBirth":"1987-01-15T00:00:00.000Z","debut":"2006-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Barbara Jean \"Barbie\" Blank is an American model, professional wrestling valet, dancer, and professional wrestler, better known by her ring name Kelly Kelly. Blank has a background in gymnastics and cheerleading. She studied broadcast journalism, hoping to become a television anchor, and worked as a model for Venus Swimwear and Hawaiian Tropic. In 2006, Blank was signed to a contract by WWE and sent to Ohio Valley Wrestling, a WWE developmental territory. She debuted on the ECW brand in June 2006 as 'Kelly Kelly', with the character of an exhibitionist and performing a striptease. On December 4 2012, Kelly made her first independent wrestling show appearance for North East Wrestling","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1391],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":37,"storytelling":43,"productFit":40,"riskTaking":34,"matchLayout":45,"psychology":37,"workerManagement":40,"trainingIntensity":63,"technicalCoaching":35,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":63,"brandBuilding":50,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":8,"reactionSpeed":63,"consistency":55,"awareness":37,"judgement":38}},{"id":835,"name":"Maryse","realName":"Maryse","picture":"Maryse.jpg","ability":54,"currentAbility":49,"potentialAbility":49,"charisma":63,"micSkills":39,"popularity":27,"condition":80,"hardcoreAbility":61,"injuryProne":100,"type":"manager","style":"all rounder","gender":"F","weight":52,"height":170,"base":"Canada","birthplace":"Canada","dateOfBirth":"1983-01-21T00:00:00.000Z","debut":"2006-08-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Maryse Ouellet is a French Canadian glamour model, professional wrestler, professional wrestling valet, and business woman, better known simply as Maryse. She is best known for her time with WWE between 2006 and 2011. After spending years modelling, including winning Miss Hawaiian Tropic Canada in 2003, Maryse was hired by WWE in 2006, after she participated in the WWE Diva Search competition. On the September 22, 2006 episode of SmackDown!, Ouellet, known as simply Maryse, was shown on the TitanTron welcoming the Montreal viewers (in French) to the season premiere of SmackDown! on the CW Network.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":57,"productFit":100,"riskTaking":24,"matchLayout":58,"psychology":53,"workerManagement":100,"trainingIntensity":54,"technicalCoaching":35,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":73,"brandBuilding":66,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":20,"reactionSpeed":54,"consistency":67,"awareness":53,"judgement":72}},{"id":838,"name":"Dave Rayne","realName":"Dave Rayne","picture":"Dave Rayne.jpg","ability":52,"currentAbility":57,"potentialAbility":57,"charisma":49,"micSkills":71,"popularity":2,"condition":91,"hardcoreAbility":37,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":85,"height":177,"base":"UK","birthplace":"England","dateOfBirth":"1982-10-29T00:00:00.000Z","debut":"2003-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Dave Rayne wasted no time in showing the PCW fans what he was made of when he cheated to pin Mad Man Manson on the very first show, A New Beginning, in August 2011. If Rayne thought that this would be the end of his time spent with Mad Man Manson though, he would be very much mistaken! Over the next several months, Dave struggled to find a tag team partner who would put up with his massive ego and out of control arrogance. Nigel McGuinness would turn on him in December at Festive Fury leading to him being pinned by the tag team of Disco Madness and then in February 2012 at Blood, Sweat & Beers, Terry Frazier would grow tired of Dave too, letting Disco Madness defeat him again.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[796,3083],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":59,"productFit":59,"riskTaking":40,"matchLayout":60,"psychology":55,"workerManagement":59,"trainingIntensity":75,"technicalCoaching":53,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":55,"brandBuilding":53,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":12,"reactionSpeed":75,"consistency":74,"awareness":55,"judgement":57}},{"id":839,"name":"Davey Blaze","realName":"Davey Blaze","picture":"Davey Blaze.jpg","ability":53,"currentAbility":49,"potentialAbility":49,"charisma":39,"micSkills":45,"popularity":1,"condition":91,"hardcoreAbility":40,"injuryProne":92,"type":"wrestler","style":"technical","gender":"M","weight":100,"height":180,"base":"UK","birthplace":"Scotland","dateOfBirth":"1993-10-08T00:00:00.000Z","debut":"2009-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Preston City Wrestling fans thought they had a new hero in young Davey Blaze. Coming from the crowd at September 2011's Road to Glory to accept Dave Rayne's open challenge, the plucky underdog, then known only as David, had the crowd firmly behind him to teach the arrogant Rayne a lesson on that night. Alas, it was not to be. As Blaze had the upper hand over Rayne, PBW stalwarts Lionheart and Noam Dar rushed the ring and began to menace Davey. It was all a carefully planned ruse however as Lionheart superkicked Rayne into next week and then pulled off Blaze's Preston North End football shirt to reveal the PBW logo underneath. Davey would re-emerge the very next month at PCW vs PBW as part of Kid Fite's invading group of Scottish rebels. Whilst Blaze was unsuccesful that night in the 6 Man Elimination Match, he proved he was anything but just some kid from the crowd.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1401,1462],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":57,"productFit":40,"riskTaking":44,"matchLayout":58,"psychology":54,"workerManagement":40,"trainingIntensity":66,"technicalCoaching":43,"characterCoaching":42,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":42,"brandBuilding":22,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":8,"reactionSpeed":66,"consistency":53,"awareness":54,"judgement":48}},{"id":840,"name":"Dean Allmark","realName":"Dean Allmark","picture":"Dean Allmark.jpg","ability":71,"currentAbility":62,"potentialAbility":62,"charisma":74,"micSkills":59,"popularity":2,"condition":83,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":82,"height":172,"base":"UK","birthplace":"England","dateOfBirth":"1983-12-26T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Dean Allmark is an English wrestler who works in America, the British Isles and Japan. He is a Lightweight who is classed as using a Technician style. He is best known for his work with IMPACT, RevPro, PROGRESS, TNT and SWE. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2605],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":60,"storytelling":65,"productFit":100,"riskTaking":26,"matchLayout":66,"psychology":60,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":69,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":58,"brandBuilding":52,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":82,"awareness":60,"judgement":76}},{"id":841,"name":"Greg Burridge","realName":"Greg Burridge","picture":"Greg Burridge.jpg","ability":65,"currentAbility":61,"potentialAbility":61,"charisma":59,"micSkills":58,"popularity":3,"condition":71,"hardcoreAbility":54,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":90,"height":182,"base":"UK","birthplace":"England","dateOfBirth":"1981-09-12T00:00:00.000Z","debut":"2000-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Greg Burridge is a British professional wrestler. He is best known for his work on the independent circuit throughout the United Kingdom and Europe. Greg is the head trainer along with Garry Vanderhorne at the London School of Lucha Libre. Burridge began his training in his late teens with the FWA Academy, in London and would go on to appear in the Frontier Wrestling Alliance promotion. After moving to the Dropkixx training school in Essex, he would be taught by \"The Gay One\" Vince Randell, Bobby Barnes and Tony Scarlo. Burridge would first adopt the same gay gimmick comedy routine used by these two World of Sport legends (Randall and Barnes) as \"Exotic\" Baxter Burridge, but once established on the independent circuit he soon adapted it to his well-known King of Chavs gimmick \"The Pukka One\" Darren Burridge.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2712],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":66,"productFit":100,"riskTaking":26,"matchLayout":67,"psychology":61,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":53,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":77,"brandBuilding":48,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":84,"awareness":61,"judgement":77}},{"id":843,"name":"Joey Hayes","realName":"Joey Hayes","picture":"Joey Hayes.jpg","ability":61,"currentAbility":52,"potentialAbility":52,"charisma":42,"micSkills":48,"popularity":5,"condition":84,"hardcoreAbility":64,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":77,"height":177,"base":"UK","birthplace":"England","dateOfBirth":"1985-08-05T00:00:00.000Z","debut":"2001-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"One of the most crowd pleasing members of the PCW roster, Joey Hayes was in fact the very first man through the curtain on the very first PCW show! From the minute the PCW fans set eyes on him, he had them firmly rooting for him, a trend which has continued through every event he's appeared at since! On the first show, A New Beginning in August 2011, Hayes would advance into the next round of the PCW Championship tournament by defeating CJ Banks. Unfortunately, Joey would crash out in the next round in September after being defeated by Noam Dar, but would bounce back with strong showings in the Money in the Bank match in December and 4 Way matches in February and March 2012. The latter 4 Way match, Joey would emerge victorious from, much to the delight of the fans in attendance.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3080],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":54,"productFit":60,"riskTaking":33,"matchLayout":56,"psychology":49,"workerManagement":60,"trainingIntensity":77,"technicalCoaching":51,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":62,"brandBuilding":44,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":12,"reactionSpeed":77,"consistency":80,"awareness":49,"judgement":53}},{"id":844,"name":"Johnny Moss","realName":"Johnny Moss","picture":"Johnny Moss.jpg","ability":88,"currentAbility":82,"potentialAbility":82,"charisma":67,"micSkills":92,"popularity":4,"condition":79,"hardcoreAbility":84,"injuryProne":100,"type":"writer","style":"technical","gender":"M","weight":108,"height":177,"base":"UK","birthplace":"England","dateOfBirth":"1980-03-11T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"This Cumbrian powerhouse not only has muscles as big as boulders, but can fly around the ring like a Cruiserweight. Johnny Moss made his PCW debut in February 2012 as part of the PCW Championship Triple Threat Main Event of Blood, Sweat & Beers. Competing against Champion T-Bone and TNA star Mark Haskins, Moss would come up short that night but leave a lasting impression on those both inside the ring and outside it.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":65,"teams":[2840],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":69,"productFit":100,"riskTaking":23,"matchLayout":71,"psychology":63,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":66,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":56,"brandBuilding":36,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":82,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-844","wrestlerId":844,"promotionId":65,"startDate":"2017-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"inDevelopment":true},{"id":845,"name":"Jonathan Gresham","realName":"Jonathan Gresham","picture":"Jonathan Gresham.jpg","ability":62,"currentAbility":70,"potentialAbility":70,"charisma":58,"micSkills":75,"popularity":27,"condition":75,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":82,"height":160,"base":"USA","birthplace":"United States","dateOfBirth":"1988-03-20T00:00:00.000Z","debut":"2005-03-05T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jonathan Gresham is an American wrestler who works in the USA, Canada, Mexico, the British Isles, Japan and Europe. He is a 5'4\", 180lb worker who is classed as using a Technician style. He uses the Figure Four Leglock, the German Suplex Hold and the Octopus Stretch as his finishers. He is best known for his work with NJPW, TNA, PWG, ROH, wXw, RevPro, ZERO1, GCW, The Crash, Beyond, PROGRESS, FCP, C4, IWA-MS, DTU, CZW, CHIKARA and SWE. He is married to Jordynne Grace.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":77,"teams":[1814,1972,3325,3326],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":70,"productFit":100,"riskTaking":13,"matchLayout":72,"psychology":65,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":83,"characterCoaching":50,"diagnosis":50,"rehabilitation":50,"prevention":87,"mediaHandling":50,"brandBuilding":37,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":83,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-845","wrestlerId":845,"promotionId":77,"startDate":"2025-04-06T00:00:00.000Z","endDate":"2027-04-06T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-04-06T00:00:00.000Z","wage":1000},{"id":846,"name":"Lionheart","realName":"Lionheart","picture":"Lionheart.jpg","ability":53,"currentAbility":51,"potentialAbility":51,"charisma":47,"micSkills":40,"popularity":3,"condition":100,"hardcoreAbility":35,"injuryProne":96,"type":"wrestler","style":"all rounder","gender":"M","weight":104,"height":182,"base":"UK","birthplace":"England","dateOfBirth":"1982-12-17T00:00:00.000Z","debut":"2002-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"Adrian \"Lionheart\" McCallum was a British professional wrestler, professional wrestling promoter and actor, often better known by his ring name Lionheart. On 11 February 2007 Lionheart made his Insane Championship Wrestling debut, losing to James Wallace. He wrestled for numerous promotions in the British Independent wrestling circuit including Insane Championship Wrestling. In March 2014, at a Preston City Wrestling show, McCallum's neck was broken in two places after receiving the Styles Clash following match against AJ Styles. As a result of the injury doctors warned McCallum that he may never walk again. ust over a year later, McCallum defied doctors' orders and returned to in-ring competition in March 2015. On 19 June 2019, McCallum's death was announced on Twitter by ICW. He was the promotions Heavyweight Champion at the time of his death.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3231],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":70,"riskTaking":25,"matchLayout":63,"psychology":58,"workerManagement":70,"trainingIntensity":60,"technicalCoaching":47,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":66,"brandBuilding":51,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":14,"reactionSpeed":60,"consistency":80,"awareness":58,"judgement":63}},{"id":847,"name":"Mad Man Manson","realName":"Mad Man Manson","picture":"Mad Man Manson.jpg","ability":78,"currentAbility":72,"potentialAbility":72,"charisma":85,"micSkills":69,"popularity":2,"condition":96,"hardcoreAbility":66,"injuryProne":100,"type":"manager","style":"technical","gender":"M","weight":93,"height":185,"base":"UK","birthplace":"Ireland","dateOfBirth":"1979-01-06T00:00:00.000Z","debut":"2004-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"This lovable Irish lunatic immediately won the hearts of the PCW fans upon his inception in the company at August 2011's debut show A New Beginning. Despite being cheated out of a win by the slimy Dave Rayne, Manson would be a thorn Rayne's side for almost an entire year afterwards. September's Road to Glory saw Manson and new tag team partner Sam Bailey (dubbed \"Disco Madness\" by the fans that night; a name which stuck!) defeat the Blackpool Blondes. The next month, Manson would set his sights on Dave Rayne again and this time, he would have Sam Bailey for help. Despite a couple of losses in the spring, Manson's popularity with the PCW crowd hasn't declined one iota and he remains arguably the most popular member of the PCW roster.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3234],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":68,"productFit":100,"riskTaking":27,"matchLayout":70,"psychology":61,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":51,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":77,"brandBuilding":47,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":82,"awareness":61,"judgement":77}},{"id":849,"name":"Des Robinson","realName":"Des Robinson","picture":"Des Robinson.jpg","ability":56,"currentAbility":58,"potentialAbility":58,"charisma":50,"micSkills":69,"popularity":0,"condition":100,"hardcoreAbility":59,"injuryProne":100,"type":"referee","style":"all rounder","gender":"M","weight":80,"height":162,"base":"UK","birthplace":"England","dateOfBirth":"1980-03-06T00:00:00.000Z","debut":"2003-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Des Robinson is a British referee who works on the UK indy scene, most notably for PCW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":14,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":14,"brandBuilding":3,"socialMediaSavvy":8,"ruleKnowledge":58,"positioning":46,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0}},{"id":851,"name":"Nathan Cruz","realName":"Nathan Cruz","picture":"Nathan Cruz.jpg","ability":56,"currentAbility":55,"potentialAbility":55,"charisma":44,"micSkills":70,"popularity":3,"condition":100,"hardcoreAbility":47,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":92,"height":180,"base":"UK","birthplace":"England","dateOfBirth":"1990-09-10T00:00:00.000Z","debut":"2007-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Nathan Cruz is an English wrestler who works in America, the British Isles and Europe. He is a Middleweight who is classed as using a Regular style. He is one half of Second II None alongside Matt Myers. He is best known for his work with RevPro, NORTH, PROGRESS, Defiant, TNT, ICW and SWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[449,3323],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":60,"productFit":50,"riskTaking":33,"matchLayout":61,"psychology":57,"workerManagement":50,"trainingIntensity":78,"technicalCoaching":49,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":66,"brandBuilding":64,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":10,"reactionSpeed":78,"consistency":75,"awareness":57,"judgement":54}},{"id":852,"name":"Keith Myatt","realName":"Keith Myatt","picture":"Keith Myatt.jpg","ability":93,"currentAbility":83,"potentialAbility":83,"charisma":88,"micSkills":71,"popularity":1,"condition":53,"hardcoreAbility":71,"injuryProne":84,"type":"writer","style":"striker","gender":"M","weight":95,"height":175,"base":"UK","birthplace":"England","dateOfBirth":"1959-07-28T00:00:00.000Z","debut":"1982-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Keith as trained by former World Of Sport wrestler Wildman John Wilkie and Maurice Hunter.His first professional contest was against Dave Duran at Blackpool Pleasure Beach in 1982 where current WWE Superstar William Regal started,In 1984 Keith made his debut for Merseyside Enterprises who are now known as All Star Promotions the largest promotion in Europe.In 1984 Keith made his debut for Joint Promotions against Jeff Kaye at Warrington and worked for Joints for the next few years wrestling people such as Big Daddy,Rollerball Rocco,Dave Finley,Johnny Saint etc.In the early 90s Keith worked for other promotions such as Revoltion BrItish Wrestling,Norton British Wrestling etc. Keith has held many tag and single titles over the years and has fought Alan Kilby for the British Lightheavyweight Title in 1988 and also fought for the Ring Of Honour World Title in 2008 in a Three Way Match with Lionheart and (then) holder Nigel Mcguiness.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":70,"productFit":100,"riskTaking":24,"matchLayout":71,"psychology":65,"workerManagement":100,"trainingIntensity":47,"technicalCoaching":49,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":70,"brandBuilding":14,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":47,"consistency":62,"awareness":65,"judgement":79}},{"id":854,"name":"Sam Bailey","realName":"Sam Bailey","picture":"Sam Bailey.jpg","ability":39,"currentAbility":45,"potentialAbility":45,"charisma":30,"micSkills":31,"popularity":1,"condition":90,"hardcoreAbility":60,"injuryProne":96,"type":"wrestler","style":"high flyer","gender":"M","weight":83,"height":175,"base":"UK","birthplace":"England","dateOfBirth":"1988-04-28T00:00:00.000Z","debut":"2006-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Sam Bailey is an English wrestler who works in the British Isles and Europe. He is a Lightweight who is classed as using a High Flyer style. He is best known for his work with TNT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[686,796,3234,3323],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":47,"storytelling":50,"productFit":50,"riskTaking":38,"matchLayout":51,"psychology":47,"workerManagement":50,"trainingIntensity":78,"technicalCoaching":55,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":69,"brandBuilding":51,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":10,"reactionSpeed":78,"consistency":77,"awareness":47,"judgement":48}},{"id":855,"name":"Tyson T-Bone","realName":"Tyson T-Bone","picture":"T-Bone.jpg","ability":46,"currentAbility":51,"potentialAbility":51,"charisma":58,"micSkills":61,"popularity":3,"condition":85,"hardcoreAbility":55,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":111,"height":180,"base":"UK","birthplace":"England","dateOfBirth":"1981-06-09T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"This tattooed monster who hails from Essex is one of the most dangerous men in Preston City Wrestling. These days saying that somebody is from Essex will conjure up all sorts of stereotypes thanks to TV show \"The Only Way is Essex\". T-Bone is about as far removed from that stereotype as is possible. Because of his unique background, T-Bone is more of a bare-knuckle fighter than a wrestler, utilizing a barrage of punches, kicks and headbutts to get his point across in the ring. A tip to the referees: Keep an eye of this guy, as he isn’t afraid to also incorporate a dirty tactic or two into his arsenal. Put simply, as T-Bone himself explains, “My style is to win. It’s a style he has become very familiar with, thanks much in part to his Gypsy’s Kiss finisher. “Once you’ve had that on your head,” T-Bone says, “the only thing you’ll be doing is wishing yourself good night.”","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2607,2846],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":57,"productFit":100,"riskTaking":39,"matchLayout":59,"psychology":53,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":26,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":64,"brandBuilding":58,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":73,"awareness":53,"judgement":72}},{"id":857,"name":"Kay Lee Ray","realName":"Kay Lee Ray","picture":"Kay Lee Ray.jpg","ability":59,"currentAbility":61,"potentialAbility":61,"charisma":73,"micSkills":74,"popularity":30,"condition":87,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":51,"height":170,"base":"UK","birthplace":"Scotland","dateOfBirth":"1992-08-11T00:00:00.000Z","debut":"2009-07-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Scottish high-flyer Kay Lee Ray is a fiery star on the rise from the flourishing United Kingdom circuit. A young veteran, Ray boasts an innovative, daredevil attack. When watching her in action, your best chance of keeping up with her is by following the scarlet streak of Ray’s hair as she soars around the ring, diving through the ropes and propelling herself off the turnbuckle with her graceful take on the Swanton Bomb. With several titles on her resume, including the NXT UK Women's Championship, Ray stands as a very dangerous threat in the rising NXT UK brand as she makes a splash on a global scale.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":102,"teams":[1053,1654,3718,3726,4171],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":70,"productFit":100,"riskTaking":23,"matchLayout":71,"psychology":69,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":64,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":70,"brandBuilding":72,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":87,"awareness":69,"judgement":81},"contract":{"id":"tew-contract-857","wrestlerId":857,"promotionId":102,"startDate":"2026-07-01T00:00:00.000Z","endDate":"2028-07-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-07-01T00:00:00.000Z","wage":1000},{"id":859,"name":"Hiroshi Yamato","realName":"Hiroshi Yamato","picture":"Hiroshi Yamato.jpg","ability":72,"currentAbility":65,"potentialAbility":65,"charisma":74,"micSkills":52,"popularity":6,"condition":85,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":82,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1983-10-20T00:00:00.000Z","debut":"2007-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Hiroshi Mihara s a Japanese professional wrestler, better known by the ring name Hiroshi Yamato. Trained by the All Japan Pro Wrestling promotion, he started his career in February 2007 working in Mexico for the International Wrestling Revolution Group (IWRG) promotion, where he won the 2007 Rey del Ring tournament. Yamato returned to Japan and his home promotion in February 2008 and during the next five years went on to become a one-time AJPW World Junior Heavyweight and AJPW All Asia Tag Team Champion and the winner of the 2012 Junior Hyper League. In June 2013, Yamato left All Japan in a mass exodus to join the new Wrestle-1 promotion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":12,"teams":[2882],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":70,"productFit":100,"riskTaking":22,"matchLayout":72,"psychology":65,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":64,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":60,"brandBuilding":64,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":71,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-859","wrestlerId":859,"promotionId":12,"startDate":"2018-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":860,"name":"Andy Wu","realName":"Andy Wu","picture":"Andy Wu.jpg","ability":53,"currentAbility":52,"potentialAbility":52,"charisma":40,"micSkills":62,"popularity":3,"condition":89,"hardcoreAbility":64,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1992-01-20T00:00:00.000Z","debut":"2012-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Andy Wu, a 2012 graduate of the AJPW Dojo, is a masked Japanese wrestler who works exclusively in Japan. He is a Small worker who is classed as using a Technician Flyer style. He is best known for his work with BJW, AJPW, ZERO1 and WRESTLE-1.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":7,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":59,"productFit":100,"riskTaking":31,"matchLayout":61,"psychology":54,"workerManagement":100,"trainingIntensity":73,"technicalCoac