gIntensity":65,"technicalCoaching":57,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":65,"brandBuilding":35,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":53,"awareness":69,"judgement":81}},{"id":1803,"name":"Meiko Satomura","realName":"Meiko Satomura","picture":"Meiko Satomura.jpg","ability":91,"currentAbility":92,"potentialAbility":92,"charisma":94,"micSkills":98,"popularity":29,"condition":72,"hardcoreAbility":100,"injuryProne":100,"type":"writer","style":"submission","gender":"F","weight":68,"height":154,"base":"Japan","birthplace":"Japan","dateOfBirth":"1979-11-17T00:00:00.000Z","debut":"1995-04-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Meiko Satomura is a Japanese professional wrestler. She co-founded Sendai Girls' Pro Wrestling alongside Jinsei Shinzaki. She is a 2 time AAAW Singles Champion, a 2 time AAAW Tag Team Champion (with Ayako Hamada) and a 1 time AAAW Junior Heavyweight Tag Team Champion (with Sonoko Kato). Meiko has also trained several current female wrestlers, including Dash Chisako and Sendai Sachiko.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":70,"teams":[2842,2843],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":84,"storytelling":86,"productFit":100,"riskTaking":15,"matchLayout":86,"psychology":84,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":80,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":63,"brandBuilding":64,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":73,"awareness":84,"judgement":90},"contract":{"id":"tew-contract-1803","wrestlerId":1803,"promotionId":70,"startDate":"2006-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1804,"name":"Mayumi Ozaki","realName":"Mayumi Ozaki","picture":"Mayumi Ozaki.jpg","ability":65,"currentAbility":67,"potentialAbility":67,"charisma":75,"micSkills":73,"popularity":6,"condition":63,"hardcoreAbility":86,"injuryProne":100,"type":"wrestler","style":"submission","gender":"F","weight":57,"height":154,"base":"Japan","birthplace":"Japan","dateOfBirth":"1968-10-28T00:00:00.000Z","debut":"1986-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Mayumi Ozaki is a Japanese female professional wrestler. Ozaki debuted in a tag match in August, 1986.[2] In her career, she held the WWWA tag titles with Dynamite Kansai from April 11, 1993 to December 6, 1993 (both winning from and losing to Manami Toyota and Toshiyo Yamada of All Japan Women's Pro-Wrestling (AJW). She also held the UWA Junior and JWP Junior titles between 1988 and 1991, and teamed with Cuty Suzuki and Hikari Fukuoka to win the JWP Tag Titles a number of times between 1992 and 1995. Most recently, she held the AAAW Tag Team Championship with Aja Kong, beating GAEA's Sugar Sato and Chikayo Nagashima on August 23, 1998 in Tokyo. In December 2011, Ozaki took part in American promotion Chikara's JoshiMania weekend, teaming with Mio Shirai in a losing effort against the team of Cherry and Ayako Hamada on night one on December 2.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1713,1714,1715,2507,3007,3008],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":85,"storytelling":87,"productFit":100,"riskTaking":24,"matchLayout":88,"psychology":85,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":65,"characterCoaching":79,"diagnosis":50,"rehabi