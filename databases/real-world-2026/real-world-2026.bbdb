known for her work with Stardom, wXw, ROH, MLW, Beyond, SHIMMER, SHINE, PROGRESS and EVE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1599,1600,3340,3341,3342],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":54,"productFit":58,"riskTaking":34,"matchLayout":56,"psychology":49,"workerManagement":58,"trainingIntensity":65,"technicalCoaching":52,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":70,"brandBuilding":50,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":12,"reactionSpeed":65,"consistency":75,"awareness":49,"judgement":53}},{"id":2657,"name":"Anthony Greene","realName":"Anthony Greene","picture":"Anthony Greene.jpg","ability":53,"currentAbility":58,"potentialAbility":58,"charisma":73,"micSkills":57,"popularity":15,"condition":91,"hardcoreAbility":54,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":87,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1993-08-23T00:00:00.000Z","debut":"2012-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Anthony Greene is an American wrestler who works in the USA, Canada, the British Isles, Japan, Europe and India. He is a 6'2\", 192lb worker who is classed as using a Entertainer style. He uses the D-1 and the Piledriver as his finishers. He is one half of Star Struck alongside Channing Thomas. He is best known for his work with NOAH, NXT, wXw, Beyond, EVOLVE, BLP, C4, A1, DTU, CHIKARA, CZW and WXM. He is engaged to Ava Everett.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":92,"teams":[2547,2659,2861,3112,3113,4301,4302],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit