rehabilitation":50,"prevention":75,"mediaHandling":68,"brandBuilding":45,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":64,"awareness":58,"judgement":75}},{"id":677,"name":"Nevaeh","realName":"Nevaeh","picture":"Nevaeh.jpg","ability":61,"currentAbility":59,"potentialAbility":59,"charisma":64,"micSkills":49,"popularity":4,"condition":100,"hardcoreAbility":69,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":61,"height":160,"base":"USA","birthplace":"United States","dateOfBirth":"1986-01-29T00:00:00.000Z","debut":"2005-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Beth Crist (née Vocke), is an American professional wrestler best known as Neveah. She currently performs for several Northern United States-based independent promotions as well as the all-female promotion SHIMMER Women Athletes. Vocke made her wrestling debut on December 1, 2005 under the ring name Nevaeh, where she lost to Hellena Heavenly in a match for Mad-Pro Wrestling. On April 26, 2008, Nevaeh made her debut for Shimmer Women Athletes at the Volume 17 tapings, where she and her rival Ashley Lane lost to The Experience. Because of the working agreement between Shimmer and Ring of Honor, Nevaeh made her ROH debut on March 1, 2009. On February 4, 2012, Nevaeh made her Combat Zone Wrestling debut with a victory over Kimber Lee. She is married to fellow professional wrestler and Ohio Is For Killers' stablemate Jake Crist.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1750,2293],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":65,"productFit":40,"riskTaking":30,"matchLayout":67,"psychology":61,"workerManagement":40,"trainingIntensity":71,"technicalCoaching":57,"characterCoaching":66,"diagnosis":50,"re