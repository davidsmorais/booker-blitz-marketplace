0,"acceptsIndieBookings":false,"promotionId":76,"teams":[3603,3604],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":56,"productFit":65,"riskTaking":28,"matchLayout":59,"psychology":49,"workerManagement":65,"trainingIntensity":83,"technicalCoaching":49,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":53,"brandBuilding":58,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":13,"reactionSpeed":83,"consistency":58,"awareness":49,"judgement":55},"contract":{"id":"tew-contract-4199","wrestlerId":4199,"promotionId":76,"startDate":"2023-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":4200,"name":"Sandra Moone","realName":"Sandra Moone","picture":"Sandra Moone2.jpg","ability":52,"currentAbility":48,"potentialAbility":48,"charisma":52,"micSkills":35,"popularity":1,"condition":100,"hardcoreAbility":40,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":61,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"2000-05-09T00:00:00.000Z","debut":"2017-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Hailing from wherever the stars lead her, Sandra Moone is a promising prospect from the Future Stars of Wrestling promotion in Las Vegas. Sandra quickly established herself in Indiana's top promotion, Paradigm Pro Wrestling, debuting on the first season of No Hook, wrestling Kayla Kassidy in her debut match. Moone would soon get her first big match, main eventing the season finale and even beating Nolan Edward in a Loser Leaves Town match. Another big opportunity awaited Sandra as she faced Janai Kai in PPW's newest match concept, Terminal Combat, on their eponymously named show. She would once again emerge victorious, delivering a gutwrench powerbomb and a flurry of elbows that forced a referee stoppage. Only 21 years old, Sandra Moone has a bright future ahead of her. Despite not being the biggest or the tallest girl, she makes up for it with a charming personality that has endeared her to many independent wrestling fans.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":41,"storytelling":47,"productFit":11,"riskTaking":39,"matchLayout":49,"psychology":41,"workerManagement":11,"trainingIntensity":73,"technicalCoaching":50,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":55,"brandBuilding":62,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":2,"reactionSpeed":73,"consistency":58,"awareness":41,"judgement":29}},{"id":4201,"name":"Tiffany Stratton","realName":"Tiffany Stratton","picture":"Jessica Woynilko.jpg","ability":47,"currentAbility":57,"potentialAbility":57,"charisma":63,"micSkills":72,"popularity":47,"condition":97,"hardcoreAbility":76,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":65,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1999-05-01T00:00:00.000Z","debut":"2021-08-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Tiffany Stratton is an American wrestler who works exclusively in the USA. She is a 5'7\", 143lb worker who is classed as using a Regular style. She uses the Prettiest Moonsault Ever and the Reverse STO as her finishers. She is best known for her work with WWE and NXT. She is currently the WWE Women's champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[],"record":{"wins":0,"losses":0,"