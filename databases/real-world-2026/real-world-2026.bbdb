ttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":36,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":58,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":56,"brandBuilding":38,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":63,"awareness":58,"judgement":75},"contract":{"id":"tew-contract-2406","wrestlerId":2406,"promotionId":38,"startDate":"2025-02-12T00:00:00.000Z","endDate":"2027-02-12T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-02-12T00:00:00.000Z","wage":1000},{"id":2409,"name":"Garza Jr.","realName":"Garza Jr.","picture":"Garza Jr.jpg","ability":55,"currentAbility":60,"potentialAbility":60,"charisma":56,"micSkills":52,"popularity":30,"condition":94,"hardcoreAbility":61,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":96,"height":177,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1992-09-23T00:00:00.000Z","debut":"2008-11-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Blessed with movie-star good looks, a spectacular sports-entertainment pedigree and machismo to spare, Angel Garza is an attention-getter to the nth degree.\r\n\r\nThe third-generation luchador, who hails from Mexico’s famed Garza wrestling dynasty, broke into the sport at age 15 and hasn’t looked back since. After spending a decade conquering the competition in his homeland, Garza was signed to NXT in 2019, joining a roster that already included his cousin Humberto Carrillo. Following in the footsteps of his forefathers — such as his late uncle, former WCW Superstar Hector Garza — Angel Garza proudly embodies the traditions of lucha libre, employing a silky-smooth style of combat that emphasizes attacks from the sky.\r\n\r\nIn short, Garza’s good and he knows it. He’s not bashful about praising his own abilities or even his cosmetic appeal.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":5,"teams":[1067,2060,2365,2785,3878],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":65,"productFit":100,"riskTaking":22,"matchLayout":67,"psychology":58,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":58,"characterCoaching":74,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":74,"brandBuilding":69,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":70,"awareness":58,"judgement":75},"contract":{"id":"tew-contract-2409","wrestlerId":2409,"promotionId":5,"startDate":"2024-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"inDevelopment":true},{"id":2410,"name":"Gringo Loco","realName":"Gringo Loco","picture":"Gringo Loco.jpg","ability":54,"currentAbility":59,"potentialAbility":59,"charisma":49,"micSkills":53,"popularity":9,"condition":75,"hardcoreAbility":39,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":115,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1985-07-20T00:00:00.000Z","debut":"2000-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Gringo Loco took MLW by storm in late 2018. Winning fans and league officials over with his versatility blending lucha libre with brawling, Loco has become one of the more exciting newcomers in MLW in some time. Loco has competed in Mexico for AAA among other groups on and off for the last several years. A cunning veteran, this resourceful wrestler mixes aspects of being a rudo and tecnico into his in-ring game. Referring to himself as the “base god” because of his ability to use his body as a gravitational base to counter his high flying opponents to his advantage, Gringo Loco can go with the best of them. Now, Gringo Loco looks to show the world he is truly major league.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":77,"teams":[3532],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":27,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":48,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":64,"brandBuilding":36,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":76,"awareness":62,"judgement":77},"contract":{"id":"tew-contract-2410","wrestlerId":2410,"promotionId":77,"startDate":"2018-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":2411,"name":"Dave the Clown","realName":"Dave the Clown","picture":"Dave the Clown.jpg","ability":37,"currentAbility":45,"potentialAbility":45,"charisma":44,"micSkills":45,"popularity":7,"condition":95,"hardcoreAbility":30,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":87,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1984-09-26T00:00:00.000Z","debut":"2012-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Dave the Clown is a masked Mexican luchador who works exclusively in Mexico. He is a Lightweight who is classed as using a Luchador style. He is best known for his work with AAA.","alterEgos":[],"managerId":0,"acceptsIndieBo