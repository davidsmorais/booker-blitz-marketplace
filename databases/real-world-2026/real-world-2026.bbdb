tention. He returned to being strictly Guadalajara based in October of 2011. Popped back up in Mexico City in late January 2012 as a fill in.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":71,"storytelling":76,"productFit":70,"riskTaking":22,"matchLayout":77,"psychology":71,"workerManagement":70,"trainingIntensity":73,"technicalCoaching":57,"characterCoaching":33,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":33,"brandBuilding":49,"socialMediaSavvy":25,"ruleKnowledge":0,"positioning":14,"reactionSpeed":73,"consistency":84,"awareness":71,"judgement":71}},{"id":2230,"name":"Quka","realName":"Quka","picture":"Quka.jpg","ability":42,"currentAbility":46,"potentialAbility":46,"charisma":40,"micSkills":59,"popularity":1,"condition":84,"hardcoreAbility":50,"injuryProne":99,"type":"wrestler","style":"high flyer","gender":"M","weight":92,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1985-02-03T00:00:00.000Z","debut":"2009-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Quka is a masked Mexican luchador who works exclusively in Mexico. He is a Lightweight who is classed as using a Luchador style. He is best known for his work with CMLL.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":51,"productFit":21,"riskTaking":23,"matchLayout":54,"psychology":44,"workerManagement":21,"trainingIntensity":71,"technicalCoaching":51,"characterCoaching":39,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":39,"brandBuilding":28,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":4,"reactionSpeed