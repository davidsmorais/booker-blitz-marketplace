2,"judgement":40}},{"id":1884,"name":"David Finlay","realName":"David Finlay","picture":"David Finlay Jr.jpg","ability":75,"currentAbility":68,"potentialAbility":68,"charisma":79,"micSkills":55,"popularity":28,"condition":90,"hardcoreAbility":79,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":95,"height":180,"base":"Europe","birthplace":"Turkey","dateOfBirth":"1993-05-16T00:00:00.000Z","debut":"2012-12-22T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"David Finlay is a German wrestler who works in the USA, Canada, the British Isles, Japan and Europe. He is a 6'0\", 209lb worker who is classed as using a Technician style. He uses the Celtic Cross as his finisher. He is best known for his work with AEW, NJPW, CMLL, TNA, ROH and MLP. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1812,2360,2591],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":75,"productFit":100,"riskTaking":15,"matchLayout":75,"psychology":73,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":63,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":68,"brandBuilding":68,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":70,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-1884","wrestlerId":1884,"promotionId":76,"startDate":"2026-03-04T00:00:00.000Z","endDate":"2026-04-08T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-04-08T23:00:00.000Z","wage":1000},{"id":1885,"name":"Cassie Lee","realName":"Cassie Lee","picture":"Peyton Royce.jpg","ability":43,"currentAbility":37,"potentialAbility":37,"charisma":29,"mi