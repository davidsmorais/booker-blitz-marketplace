clusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-08-08T00:00:00.000Z","wage":1000},{"id":1165,"name":"Ice Cream Jr.","realName":"Ice Cream Jr.","picture":"Ice Cream Jr.jpg","ability":51,"currentAbility":54,"potentialAbility":54,"charisma":45,"micSkills":44,"popularity":0,"condition":90,"hardcoreAbility":74,"injuryProne":100,"type":"wrestler","style":"comedy","gender":"M","weight":94,"height":187,"base":"USA","birthplace":"United States","dateOfBirth":"1984-10-19T00:00:00.000Z","debut":"2005-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":true,"dead":false,"story":"Ice Cream Jr. is one half of the CHIKARA tag team Los Ice Creams with El Hijo del Ice Cream. The duo were trained in Mexico by Bobby Lee. He has been wrestling on the indy scene since 2005.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":57,"productFit":100,"riskTaking":29,"matchLayout":58,"psychology":54,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":54,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":65,"brandBuilding":40,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":55,"awareness":54,"judgement":72}},{"id":1167,"name":"Ryan Howe","realName":"Ryan Howe","picture":"Ryan Howe_alt.jpg","ability":49,"currentAbility":45,"potentialAbility":45,"charisma":37,"micSkills":51,"popularity":2,"condition":94,"hardcoreAbility":42,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":100,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1987-08-23T00:00:00.000Z","debut":"2011-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Howe began working for Ohio Valley Wrestling (OVW) during May 2011. He has since been known for his musical gimmick being a rock guitar player. He won his first title in OVW on the August 8, 2012 edition of OVW TV, winning the OVW Television Championship by defeating Rob Terry and reigning champion Tony Gunn. He later dropped the title to Alex Silva in a match during the September 12 2012 edition of OVW TV. Howe was invited onto the televised programming of Total Nonstop Action Wrestling (TNA) during its July edition of the TNA Gutcheck. During the video promos for the competition, Howe described his musical background and how it led into his choice of entering professional wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2819],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":38,"storytelling":42,"productFit":30,"riskTaking":29,"matchLayout":44,"psychology":38,"workerManagement":30,"trainingIntensity":77,"technicalCoaching":42,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":55,"brandBuilding":57,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":6,"reactionSpeed":77,"consistency":75,"awareness":38,"judgement":35}},{"id":1172,"name":"El Hijo del Santo","realName":"El Hijo del Santo","picture":"Hijo del Santo.jpg","ability":71,"currentAbility":66,"potentialAbility":66,"charisma":57,"micSkills":68,"popularity":24,"condition":53,"hardcoreAbility":47,"injuryProne":96,"type":"wrestler","style":"high flyer","gender":"M","weight":84,"height":167,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1963-08-02T00:00:00.000Z","debut":"1982-02-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":true,"dead":false,"story":"El Hijo del Santo is a Mexican professional wrestler, political activist and one of the most successful stars in Lucha Libre. He is the youngest son of the legendary professional wrestler, film actor and Mexican folk hero El Santo. \"Santito\", as he is often called, was the only one of his father's 10 children to become a professional wrestler. He began wrestling without his father's consent in February 1982 as \"El Korak\" but he made his official debut as \"El Hijo del Santo\" in October of that year after he earned his college degree in Communication Science per his father's request.","alterEgos":[],"managerId":0,"acceptsIndieBookings":true,"promotionId":null,"teams":[2921,3164],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":87,"storytelling":89,"productFit":100,"riskTaking":23,"matchLayout":89,"psychology":87,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":64,"characterCoaching":84,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":84,"brandBuilding":88,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":53,"awareness":87,"judgement":92}},{"id":1173,"name":"The Great Sasuke","realName":"The Great Sasuke","picture":"The Great Sasuke.jpg","ability":57,"currentAbility":66,"potentialAbility":66,"charisma":78,"micSkills":76,"popularity":13,"condition":55,"hardcoreAbility":69,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":88,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1969-07-18T00:00:00.000Z","debut":"1990-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Masanori Murakawa is a Japanese professional wrestler, known by his ring name The Great Sasuke as well as a former Iwate Prefectural Assembly legislator. He has wrestled in Japan and in the United States in various wrestling promotions. He is said to have an incredible tolerance for pain, mainly in reference to the injuries he has had including a cracked skull. Sasuke still currently wrestles in Michinoku Pro Wrestling, although he left the running of the promotion to Shinzaki in 2003 to focus on his political career. On April 15, 2011, Sasuke returned to the United States to wrestle for Chikara in the 2011 King of Trios tournament, where he would represent Michinoku Pro with Dick Togo and Jinsei Shinzaki.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":43,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":81,"storytelling":85,"productFit":100,"riskTaking":28,"matchLayout":87,"psychology":81,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":62,"characterCoaching":43,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":43,"brandBuilding":62,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":49,"awareness":81,"judgement":89},"contract":{"id":"tew-contract-1173","wrestlerId":1173,"promotionId":43,"startDate":"2025-04-01T00:00:00.000Z","endDate":"2027-04-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-04-01T00:00:00.000Z","wage":1000},{"id":1175,"name":"Ryuji Ito","realName":"Ryuji Ito","picture":"Ryuji Ito.jpg","ability":57,"currentAbility":63,"potentialAbility":63,"charisma":54,"micSkills":51,"popularity":5,"condition":71,"hardcoreAbility":66,"injuryProne":100,"type":"wrestler","style":"hardcore","gender":"M","weight":95,"height":180,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-04-08T00:00:00.000Z","debut":"1999-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ryuji Ito is a Japanese professional wrestler currently competing in Big Japan Pro Wrestling. He is well known for his death match style of wrestling. Ito, whose gimmick is reminiscent of the Mortal Kombat icon Liu Kang, has been known for competing in many deathmatches over the span of his career, including a Cage match variation which saw him defeat Kintaro Kanemura. Ito is perhaps most famous for participating in an infamous \"Lightube Lightsaber match\" in which he fought and defeated Abdullah Kobayashi. The match has since become a hit video among hardcore wrestling fans on the website YouTube.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":7,"teams":[1825],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":72,"productFit":100,"riskTaking":38,"matchLayout":73,"psychology":69,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":54,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":54,"brandBuilding":58,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":73,"awareness":69,"judgement":81},"contract":{"id":"tew-contract-1175","wrestlerId":1175,"promotionId":7,"startDate":"1999-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":1176,"name":"Trevor Murdoch","realName":"Trevor Murdoch","picture":"Trevor Murdock.jpg","ability":92,"currentAbility":84,"potentialAbility":84,"charisma":89,"micSkills":90,"popularity":14,"condition":65,"hardcoreAbility":72,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":109,"height":190,"base":"USA","birthplace":"United States","dateOfBirth":"1980-09-10T00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Trevor Murdoch is a retired American wrestler who works primarily as a road agent. He is best known for his work with WWE, NOAH, TNA, NWA, CWFH and IWA-MS. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2820,3086,3831],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":68,"productFit":100,"riskTaking":22,"matchLayout":68,"psychology":67,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":53,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":61,"brandBuilding":42,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":83,"awareness":67,"judgement":80}},{"id":1177,"name":"Xavier Woods","realName":"Xavier Woods","picture":"Xavier Woods.jpg","ability":65,"currentAbility":66,"potentialAbility":66,"charisma":51,"micSkills":81,"popularity":50,"condition":85,"hardcoreAbility":52,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":93,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1986-09-04T00:00:00.000Z","debut":"2005-06-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"It’s a New Day, yes it is! And, without a doubt, Xavier Woods is a huge part of it.\r\n\r\nA dynamic Superstar with plenty of brains — he's currently earning his Ph.D. in educational psychology in addition to his two bachelor's degrees in psychology and philosophy and a master's in psychology — Woods is far more intelligent than his off-key trombone bleating may let on. He's damn good in the ring, too, snatching multiple WWE Tag Team Championships alongside his New Day crew of Big E and Kofi Kingston.\r\n\r\nLegit pop-culture phenoms, The New Day proved their place in sports-entertainment history by setting the record for the longest Tag Team Championship reign in WWE history. They also released their own Booty-O’s cereal, hosted WrestleMania and brought some much-needed magic and wonder back to WWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1248,1249,2653,3660,4402],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":72,"productFit":100,"riskTaking":20,"matchLayout":73,"psychology":69,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":58,"characterCoaching":83,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":83,"brandBuilding":67,"socialMediaSavvy":77,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":74,"awareness":69,"judgement":81}},{"id":1178,"name":"Kohei Sato","realName":"Kohei Sato","picture":"Kohei Sato.jpg","ability":58,"currentAbility":61,"potentialAbility":61,"charisma":72,"micSkills":57,"popularity":5,"condition":82,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":120,"height":190,"base":"Japan","birthplace":"Japan","dateOfBirth":"1977-09-21T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"One of ZERO1's most consistent performers, Kohei Sato is veteran who is among ZERO1's top tag team wrestlers and has had some singles success. In April 2010 Sato finally broke through, defeating outsider Toshiaki Kawada for the title, bringing the belt back to ZERO1 and ending Kawada’s nearly 6 month reign as champion. In addition to 4 NWA Intercontinental Tag Team Title reigns he has also held the All-Japan All-Asia Tag Team Title, the WEW Tag Team Title, the NWA UN Heavyweight Title and the ZERO1-MAX US Openweight Title and was the 2004 Fire Festival winner. Before debuting in wrestling, Sato briefly competed in MMA. He fought twice for Shooto in 1999, winning both fights. He appeared at the inaugral W-1 event.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1730,2885,2886,2904,2905],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":74,"productFit":100,"riskTaking":15,"matchLayout":75,"psychology":69,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":67,"characterCoaching":35,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":35,"brandBuilding":54,"socialMediaSavvy":37,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":63,"awareness":69,"judgement":81}},{"id":1179,"name":"Ryouji Sai","realName":"Ryouji Sai","picture":"Ryoji Sai.jpg","ability":59,"currentAbility":65,"potentialAbility":65,"charisma":60,"micSkills":68,"popularity":4,"condition":78,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":107,"height":185,"base":"Japan","birthplace":"Japan","dateOfBirth":"1980-06-03T00:00:00.000Z","debut":"2001-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ryouji Sai is a 3rd Generation Zainichi Korean that was born in Osaka, Japan. At 15 years old, Ryouji attended the Sidmouth International School in Sidmouth, England. While in Europe he studied Martial Arts under Gerard Gordeau in the Netherlands. When he returned to Japan he joined Pro Wrestling ZERO-ONE, debuting on September 1, 2001 at the ZERO-ONE \"FIRE FESTIVAL 2001\" versus Igor Meindert. in a non-tournament match. From 2002 to 2004, he would be out of pro wrestling with an unknown ailment. Returning in 2004, he would begin to regularly team with Kohei Sato winning the NWA Intercontinental Tag Team Championship in 2005 and 2006. Ryoji twice finished as the runner-up in ZERO1 Fire Festival tournaments in both 2007 and 2006, losing to Masato Tanaka. He also regularly appeared for the HUSTLE wrestling promotion during Pro Wrestling ZERO1's working agreement with them.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":43,"teams":[2306,2885],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":72,"productFit":100,"riskTaking":44,"matchLayout":73,"psychology":67,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":65,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":56,"brandBuilding":54,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":55,"awareness":67,"judgement":80},"contract":{"id":"tew-contract-1179","wrestlerId":1179,"promotionId":43,"startDate":"2025-04-01T00:00:00.000Z","endDate":"2027-04-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-04-01T00:00:00.000Z","wage":1000},{"id":1180,"name":"Taiyo Kea","realName":"Taiyo Kea","picture":"Taiyo Kea.jpg","ability":74,"currentAbility":64,"potentialAbility":64,"charisma":70,"micSkills":78,"popularity":4,"condition":72,"hardcoreAbility":49,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":106,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1975-11-18T00:00:00.000Z","debut":"1994-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Maunakea Mossman is an American professional wrestler, better known under his stage name Taiyo Kea. Although he was born in Hawaii, he has spent nearly his entire career as a member of the Japan-based All Japan Pro Wrestling promotion. He is the only wrestler to have held the AJPW Triple Crown Heavyweight Championship, the AJPW Unified World Tag Team Championship and the AJPW World Junior Heavyweight Championship. Mossman was a Hawaiian state amateur champion, and was scouted by Giant Baba during a trip to the islands. Debuting in 1994 as a junior heavyweight, Mossman was pushed immediately, winning the AJPW World Junior Heavyweight Title in 1997.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3057],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":24,"matchLayout":75,"psychology":68,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":62,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":62,"brandBuilding":60,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":71,"awareness":68,"judgement":81}},{"id":1181,"name":"Becky Lynch","realName":"Becky Lynch","picture":"Becky Lynch.jpg","ability":67,"currentAbility":72,"potentialAbility":72,"charisma":84,"micSkills":70,"popularity":71,"condition":77,"hardcoreAbility":57,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":61,"height":165,"base":"UK","birthplace":"Ireland","dateOfBirth":"1987-01-30T00:00:00.000Z","debut":"2002-11-01T00:00:00.000Z","morale":"great","prestige":"high","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Hardened by a career defined by betrayal, disappointment and underestimation, Becky Lynch decided to take her destiny into her own hands and force her way to the top of the mountain by throwing off anyone, friend or foe, who was blocking her path. The results speak for themselves. Lynch gave the Women’s division a shot in the arm in 2018 when she won her second SmackDown Women’s Championship, leading an invasion of Raw that left Ronda Rousey demoralized and humiliated — this despite Becky suffering a concussion in the process. The Man made her mark again by winning the 2019 Royal Rumble Match to earn a World Championship opportunity at WrestleMania 35. That opportunity eventually became the first women’s main event in WrestleMania history where The Man defeated Raw Women’s Champion Ronda Rousey and SmackDown Women’s Champion Charlotte Flair to claim both titles in their Winner Take All Match.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":81,"productFit":100,"riskTaking":22,"matchLayout":81,"psychology":80,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":72,"characterCoaching":88,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":88,"brandBuilding":88,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":73,"awareness":80,"judgement":88},"contract":{"id":"tew-contract-1181","wrestlerId":1181,"promotionId":64,"startDate":"2025-01-07T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":1182,"name":"Adam Scherr","realName":"Adam Scherr","picture":"Braun Strowman.jpg","ability":53,"currentAbility":53,"potentialAbility":53,"charisma":64,"micSkills":54,"popularity":54,"condition":71,"hardcoreAbility":61,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":175,"height":200,"base":"USA","birthplace":"United States","dateOfBirth":"1983-09-06T00:00:00.000Z","debut":"2014-12-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Adam Scherr, a 2014 graduate of the WWE Performance Center, is an American wrestler who works in America and Canada. He is a Big Heavyweight who is classed as using a Powerhouse style. He is best known for his work with WWE, NXT and ROH. He is dating someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1526,3712],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":60,"productFit":100,"riskTaking":22,"matchLayout":60,"psychology":61,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":19,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":73,"brandBuilding":86,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":76,"awareness":61,"judgement":77},"injury":{"type":"Knee Ligament Damage","daysToRecover":-4},"returnDate":"2026-04-08T00:00:00.000Z"},{"id":1185,"name":"Rikishi","realName":"Rikishi","picture":"Rikishi.jpg","ability":53,"currentAbility":45,"potentialAbility":45,"charisma":55,"micSkills":53,"popularity":15,"condition":57,"hardcoreAbility":39,"injuryProne":81,"type":"wrestler","style":"powerhouse","gender":"M","weight":193,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1965-10-11T00:00:00.000Z","debut":"1985-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Solofa Fatu Jr. is a Samoan American professional wrestler, best known under the ring name Rikishi (which means sumo wrestler in Japanese) with World Wrestling Entertainment (WWE), where he was a one time Intercontinental Champion, two time World Tag Team Champion, and one time WWE Tag Team Champion. Solofa Fatu, Jr. first got the fans attention in 1985 as he worked for Gino Brito and Dino Bravo’s “International Wrestling\" territory based in Montreal.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2826],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":71,"productFit":100,"riskTaking":26,"matchLayout":71,"psychology":69,"workerManagement":100,"trainingIntensity":35,"technicalCoaching":8,"characterCoaching":80,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":80,"brandBuilding":51,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":35,"consistency":57,"awareness":69,"judgement":81}},{"id":1187,"name":"Shad Gaspard","realName":"Shad Gaspard","picture":"Shad Gaspard.jpg","ability":52,"currentAbility":50,"potentialAbility":50,"charisma":35,"micSkills":35,"popularity":4,"condition":89,"hardcoreAbility":61,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":129,"height":198,"base":"USA","birthplace":"United States","dateOfBirth":"1981-01-13T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":true,"story":"Shad Gaspard  is an American professional wrestler of Haitian and Curaçaon descent. After high school, he continued to play basketball at Georgia Perimeter College, and after leaving, he became a bodyguard for several rappers and actors, including pop star Britney Spears, Puff Daddy, Cuba Gooding, Jr., and Mike Tyson. Born in Brooklyn, New York, he is best known for his time with World Wrestling Entertainment (WWE), where he once teamed with his partner JTG where they worked as the tag team, Cryme Tyme. He is also an actor, bodybuilder, model, and former Bodyguard. Shad is the son of Ben Gaspard, a former street enforcer for street gangs and personal security guard in the early 1970s.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1009,3289],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":42,"storytelling":47,"productFit":100,"riskTaking":38,"matchLayout":49,"psychology":42,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":30,"characterCoaching":75,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":75,"brandBuilding":69,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":56,"awareness":42,"judgement":65}},{"id":1188,"name":"Santana Garrett","realName":"Santana Garrett","picture":"Santana Garrett.jpg","ability":50,"currentAbility":53,"potentialAbility":53,"charisma":57,"micSkills":39,"popularity":11,"condition":90,"hardcoreAbility":35,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":64,"height":162,"base":"USA","birthplace":"United States","dateOfBirth":"1988-05-22T00:00:00.000Z","debut":"2009-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Santana Garrett is an American wrestler who works in America, Canada and Japan. She is a Small worker who is classed as using a Regular Wrestler style. Garrett began her career in Bruno Sassi's South Florida based Coastal Championship Wrestling on November 27, 2009 event, where she defeated Kimberly to win the CCW Ladies Championship in her debut match. Santana Garrett, as Santana G appeared in IWA Mid-South on March 26, where she faced Jessika Haze, in a winning effort. Garrett made her debut for Shimmer Women Athletes, on September 27, 2012 at Volume 50, where she competed against Mercedes Martinez in a losing effort. In mid-August 2019, it was announced that Garrett has been officially signed to a contract and will report to the Performance Center before she appears in the developmental company NXT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[661,3107],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":61,"productFit":100,"riskTaking":27,"matchLayout":62,"psychology":57,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":55,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":56,"brandBuilding":68,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":69,"awareness":57,"judgement":74}},{"id":1191,"name":"Jimmy Korderas","realName":"Jimmy Korderas","picture":"Jimmy Korderas.jpg","ability":79,"currentAbility":83,"potentialAbility":83,"charisma":88,"micSkills":85,"popularity":9,"condition":100,"hardcoreAbility":85,"injuryProne":80,"type":"referee","style":"all rounder","gender":"M","weight":95,"height":177,"base":"Canada","birthplace":"Canada","dateOfBirth":"1962-03-19T00:00:00.000Z","debut":"1985-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Demetrius Korderas  better known by his referee name, Jim \"Jimmy\" Korderas is a Canadian professional wrestling referee who worked for World Wrestling Entertainment for over 22 years. On January 9, 2009, WWE released Korderas from his contract.  On May 12, 2012 Jim Korderas refereed a match at Ring of Honor's Internet Pay-Per View entitled Border Wars. He has also been known to do some announcing since leaving WWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":19,"technicalCoaching":0,"characterCoaching":37,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":37,"brandBuilding":19,"socialMediaSavvy":15,"ruleKnowledge":83,"positioning":66,"reactionSpeed":19,"consistency":0,"awareness":0,"judgement":0}},{"id":1192,"name":"Afa Jr.","realName":"Afa Jr.","picture":"Afa Anoai Jr.jpg","ability":60,"currentAbility":52,"potentialAbility":52,"charisma":41,"micSkills":37,"popularity":1,"condition":78,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":115,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1984-10-06T00:00:00.000Z","debut":"1998-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Afa Anoa'i, Jr. is an American professional wrestler of Samoan descent. He is best known for his work in World Wrestling Entertainment, where he competed on its Raw brand under the ring name Manu. Anoa'i began training as a wrestler under his father, Afa, and brothers, Lloyd and Samula He made his debut on August 28, 1998 at the age of 13, winning a battle royal in Austria. In October 2006, Anoa'i received a try-out with World Wrestling Entertainment, held at the Deep South Wrestling development territory. Later that month, Anoa'i officially signed with WWE, going under his father's ring name, \"Afa\".  At Unforgiven 2008, Anoa'i made his debut on the full-time roster under the name \"Manu\". On April 18, 2009, Anoa'i returned to the independent circuit at a World Xtreme Wrestling (WXW) show.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[723],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":50,"storytelling":54,"productFit":100,"riskTaking":32,"matchLayout":55,"psychology":50,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":44,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":55,"brandBuilding":55,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":56,"awareness":50,"judgement":70}},{"id":1193,"name":"Melina","realName":"Melina","picture":"Melina Perez.jpg","ability":50,"currentAbility":57,"potentialAbility":57,"charisma":61,"micSkills":68,"popularity":23,"condition":75,"hardcoreAbility":41,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":55,"height":160,"base":"USA","birthplace":"United States","dateOfBirth":"1979-03-09T00:00:00.000Z","debut":"2002-04-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Melina began her career as a fashion model, but the wrestling bug bit the Los Angeles native in 2000 when she began training at the School of Hard Knocks in San Bernardino, Calif. She continued to work various wrestling shows, honing her in-ring abilities.\r\n\r\nHer dream was finally realized in 2003 when WWE signed her in San Diego. Melina soon became known as a force to be reckoned with as a manager and then in the Divas division when she debuted on SmackDown as the manager of MNM (Mercury, Nitro and Melina). She credited the experience of training with both men and women for making her tougher and stronger. You simply must take the hits, she believed, and keep on going.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":66,"productFit":100,"riskTaking":27,"matchLayout":67,"psychology":62,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":51,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":72,"brandBuilding":63,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":66,"awareness":62,"judgement":77}},{"id":1194,"name":"Reby Sky","realName":"Reby Sky","picture":"Reby Sky.jpg","ability":38,"currentAbility":34,"potentialAbility":34,"charisma":21,"micSkills":35,"popularity":9,"condition":94,"hardcoreAbility":27,"injuryProne":95,"type":"wrestler","style":"high flyer","gender":"F","weight":52,"height":162,"base":"USA","birthplace":"United States","dateOfBirth":"1986-08-06T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Reby Sky was an American wrestler who has since left the business. She is best known for her work with IMPACT and SHINE. She is married to Matt Hardy.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":38,"storytelling":40,"productFit":16,"riskTaking":38,"matchLayout":41,"psychology":38,"workerManagement":16,"trainingIntensity":48,"technicalCoaching":25,"characterCoaching":70,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":70,"brandBuilding":54,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":3,"reactionSpeed":48,"consistency":65,"awareness":38,"judgement":29}},{"id":1195,"name":"Thea Trinidad","realName":"Thea Trinidad","picture":"Rosita.jpg","ability":43,"currentAbility":40,"potentialAbility":40,"charisma":34,"micSkills":40,"popularity":40,"condition":100,"hardcoreAbility":41,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"F","weight":48,"height":152,"base":"USA","birthplace":"United States","dateOfBirth":"1990-12-27T00:00:00.000Z","debut":"2010-02-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Thea Trinidad is an American wrestler who works exclusively in North America. She is a 5'1\", 106lb worker who is classed as using a High Flyer style. She uses the Cutter and the Moonsault as her finishers. She is best known for her work with WWE, TNA and NXT. She is currently the WWE Women's United States champion. She is married to Malakai Black. She was voted Female Manager Of The Year in 2017.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2784],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":48,"storytelling":50,"productFit":53,"riskTaking":34,"matchLayout":50,"psychology":48,"workerManagement":53,"trainingIntensity":68,"technicalCoaching":29,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":79,"brandBuilding":68,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":11,"reactionSpeed":68,"consistency":63,"awareness":48,"judgement":50}},{"id":1196,"name":"Shawn Daivari","realName":"Shawn Daivari","picture":"Shawn Daivari.jpg","ability":84,"currentAbility":87,"potentialAbility":87,"charisma":88,"micSkills":72,"popularity":9,"condition":76,"hardcoreAbility":73,"injuryProne":100,"type":"writer","style":"high flyer","gender":"M","weight":86,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1984-04-30T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Iranian American Dara Shawn Daivari lived the American dream. Signing a lucrative contract before his 21st birthday, winning championships around the world and gaining immense notoriety. However, this all left him unfulfilled and, ultimately a lost soul.\r\n\r\nIt wasn’t until Daivari journeyed abroad and discovered the black flag of CONTRA Unit. Reemerging a different man both physically with more muscularity than before and mentally, Daivari is on the frontlines of CONTRA’s war against the world, and specifically MLW.\r\n\r\nGuided early on by Adnan Al-Kaissie, Daivari has found what he believes is enlightenment through CONTRA. Fanatically loyal to Josef Samael, Daivari has sworn allegiance to CONTRA. A soldier in CONTRA’s war against MLW and a world of structure and perceived decadence, this foot soldier vows to be CONTRA’s greatest warrior.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[748,1502,2747],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":74,"productFit":100,"riskTaking":17,"matchLayout":74,"psychology":73,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":57,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":54,"brandBuilding":54,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":71,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-1196","wrestlerId":1196,"promotionId":64,"startDate":"2021-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1198,"name":"Chris Stone","realName":"Chris Stone","picture":"Chris Stone.jpg","ability":57,"currentAbility":58,"potentialAbility":58,"charisma":64,"micSkills":66,"popularity":3,"condition":84,"hardcoreAbility":73,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":97,"height":177,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-01-22T00:00:00.000Z","debut":"1995-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Chris Stone was a long time CMLL undercarder, teaming with his brother Alan. The team reached a level of popularity, but never got much farther than their initial push and seemed to be eternally stuck in a midcard or lower position. The Stones jumped to AAA in 2005. Chris returned for a short stint back in CMLL, but redebuted in AAA in 2006, and has been a member of Guapos VIP ever since. Chris hasn't had the success (or amount of work) in AAA as his brother. There's a popular myth he may have been under Super Calo (Chris' other brother) mask during his first AAA stint, but there's no evidence to support this.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":28,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":53,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":56,"brandBuilding":53,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":77,"awareness":62,"judgement":77}},{"id":1200,"name":"Simon Dean","realName":"Simon Dean","picture":"Simon Dean.jpg","ability":62,"currentAbility":60,"potentialAbility":60,"charisma":51,"micSkills":65,"popularity":7,"condition":75,"hardcoreAbility":73,"injuryProne":95,"type":"wrestler","style":"high flyer","gender":"M","weight":98,"height":177,"base":"USA","birthplace":"United States","dateOfBirth":"1972-06-05T00:00:00.000Z","debut":"1990-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Michael \"Mike\" Bucci is probably best known for his appearances in ECW as Nova, Super Nova and \"Hollywood\" Nova and WWE as Simon Dean ,he was also a member of the blue World order, He now wrestles the odd matches on the Indy Circuit. On August 8, 2010, Bucci took part in Total Nonstop Action Wrestling's ECW reunion show, Hardcore Justice, where he, as Hollywood Nova, accompanied Stevie Richards to the ring and later attacked Tommy Dreamer during his match with Raven.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2665,2928,3296,3305,3306],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":70,"productFit":100,"riskTaking":43,"matchLayout":73,"psychology":61,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":58,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":69,"brandBuilding":58,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":70,"awareness":61,"judgement":77}},{"id":1202,"name":"Mascarita Dorada","realName":"Mascarita Dorada","picture":"Mascarita Dorada.jpg","ability":58,"currentAbility":54,"potentialAbility":54,"charisma":42,"micSkills":45,"popularity":11,"condition":81,"hardcoreAbility":74,"injuryProne":96,"type":"wrestler","style":"high flyer","gender":"M","weight":50,"height":132,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1982-02-19T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Mascarita Dorada is the ring name of a Mexican Luchador enmascarado, or masked professional wrestler, who worked in the Mini-Estrella division, comparable to the U.S. Midget professional wrestling division, currently signed with WWE under the name of El Torito (Spanish for The Little Bull). From 2000 until 2007 he worked under the name Mascarita Sagrada in Asistencia Asesoría y Administración (AAA), taking over after the original Mascarita Sagrada left AAA. In 2007 he moved from AAA to join Consejo Mundial de Lucha Libre (CMLL) he changed name to Mascarita Dorada. After leaving CMLL in 2011, he began wrestling for El Hijo del Santo under the ring name Mascarita Plateada, while also returning to AAA under the Mascarita Dorada ring name.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":59,"storytelling":66,"productFit":100,"riskTaking":31,"matchLayout":68,"psychology":59,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":64,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":67,"brandBuilding":42,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":56,"awareness":59,"judgement":75}},{"id":1203,"name":"Swoggle","realName":"Swoggle","picture":"Hornswoggle.jpg","ability":33,"currentAbility":33,"potentialAbility":33,"charisma":19,"micSkills":22,"popularity":14,"condition":75,"hardcoreAbility":46,"injuryProne":84,"type":"wrestler","style":"powerhouse","gender":"M","weight":64,"height":132,"base":"USA","birthplace":"United States","dateOfBirth":"1989-05-29T00:00:00.000Z","debut":"2004-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Debuting in 2006, Hornswoggle was first seen as a cackling fiend who capered out from under the ring to wreak havoc on the opponents of fellow countryman Fit Finlay. His madcap antics soon earned him an unprintable nickname from Michael Cole, one that stuck with him until his real name was revealed the following year.\r\n\r\nShortly after the disclosure of Hornswoggle’s name, the little man shocked the world when he defeated Jamie Noble for the Cruiserweight Championship. The title’s retirement in September 2007 meant that Hornswoggle was the last Superstar ever to reign as Cruiserweight Champion. In a short time, Hornswoggle locked horns with Superstars such as Chavo Guerrero and The Miz, rocked out with 3MB and was revealed to be the anonymous Raw General Manager. Not bad for a guy who could grow a beard before he was able to form a coherent sentence.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1767,2682,3519],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":35,"storytelling":40,"productFit":50,"riskTaking":38,"matchLayout":41,"psychology":35,"workerManagement":50,"trainingIntensity":50,"technicalCoaching":12,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":60,"brandBuilding":33,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":10,"reactionSpeed":50,"consistency":62,"awareness":35,"judgement":41}},{"id":1204,"name":"Stevie Richards","realName":"Stevie Richards","picture":"Stevie Richards.jpg","ability":68,"currentAbility":67,"potentialAbility":67,"charisma":63,"micSkills":74,"popularity":7,"condition":73,"hardcoreAbility":64,"injuryProne":100,"type":"manager","style":"striker","gender":"M","weight":104,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1971-10-09T00:00:00.000Z","debut":"1992-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Michael Stephen Manna  is an American professional wrestler and podcaster, better known by the ring name Stevie Richards. He currently works for Lucha Libre USA and previously wrestled for Extreme Championship Wrestling (ECW), World Wrestling Federation/Entertainment (WWF/WWE), Total Nonstop Action Wrestling (TNA), National Wrestling Alliance (NWA) and World Championship Wrestling (WCW). He has also made appearances for Ring Of Honor (ROH). He has held over 40 titles in his career, including the WWE Hardcore Championship 21 times, the ECW World Tag Team Championship twice and the NWA National Heavyweight Championship once.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[515,3267,3268,3307],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":66,"storytelling":69,"productFit":100,"riskTaking":29,"matchLayout":70,"psychology":66,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":56,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":77,"brandBuilding":53,"socialMediaSavvy":71,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":62,"awareness":66,"judgement":80}},{"id":1205,"name":"Candice LeRae","realName":"Candice LeRae","picture":"Candice LeRae.jpg","ability":58,"currentAbility":62,"potentialAbility":62,"charisma":64,"micSkills":73,"popularity":24,"condition":73,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":50,"height":154,"base":"USA","birthplace":"United States","dateOfBirth":"1985-09-29T00:00:00.000Z","debut":"2002-09-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"The tough Superstar got her first taste of WWE when she competed as one of the top fan-favorites in the inaugural Mae Young Classic tournament, battling her way to the Quarterfinal Round.\r\n\r\nSigning with the WWE Performance Center in January 2018, she soon made her presence felt in NXT when she jumped the barricade during her husband Johnny Gargano’s NXT Title Match, taking out Andrade “Cien” Almas’ business manager Zelina Vega with a flurry of punches. LeRae also displayed her fighting spirit in the 2019 Women's Royal Rumble Match. \r\n\r\nWith a never-say-die attitude, an explosive and high-risk offensive arsenal and unrivaled grit, LeRae is primed to raise the level of competition within NXT’s Women’s division.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[2330],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":28,"matchLayout":70,"psychology":68,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":63,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":72,"brandBuilding":56,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":63,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-1205","wrestlerId":1205,"promotionId":64,"startDate":"2022-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":1208,"name":"Alexa Bliss","realName":"Alexa Bliss","picture":"Alexa Bliss.jpg","ability":56,"currentAbility":57,"potentialAbility":57,"charisma":51,"micSkills":57,"popularity":56,"condition":86,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"F","weight":46,"height":152,"base":"USA","birthplace":"United States","dateOfBirth":"1991-08-09T00:00:00.000Z","debut":"2013-09-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"It almost doesn’t seem possible that so much bad attitude can fit into Alexa Bliss’ 5-foot-1 frame.\r\n\r\nSly, sassy and sporting a whole lot of ferocity, Alexa has been a driven competitor her entire life, participating in softball, track and kickboxing since her youth, excelling especially in gymnastics and eventually becoming a Division I cheerleader. Alexa even entered the world of competitive bodybuilding, where she became one of the youngest competitors to receive her IFBB Professional status.\r\n\r\nWhen she joined SmackDown, Alexa ascended to the top by becoming SmackDown Women's Champion, winning her first title by defeating Becky Lynch in a Tables Match. Then, weeks after joining Monday Night Raw in the Superstar Shake-up, Alexa Bliss made history at WWE Payback, reigning supreme over Bayley in a hard-fought contest to become the first Superstar to win both the SmackDown Women's Title and the Raw Women's Title.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[1909,3632,4282],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":68,"productFit":100,"riskTaking":20,"matchLayout":68,"psychology":67,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":52,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":85,"brandBuilding":78,"socialMediaSavvy":85,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":74,"awareness":67,"judgement":80},"contract":{"id":"tew-contract-1208","wrestlerId":1208,"promotionId":64,"startDate":"2018-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":1209,"name":"The Godfather","realName":"The Godfather","picture":"The Godfather.jpg","ability":46,"currentAbility":47,"potentialAbility":47,"charisma":41,"micSkills":54,"popularity":16,"condition":75,"hardcoreAbility":57,"injuryProne":69,"type":"wrestler","style":"powerhouse","gender":"M","weight":150,"height":195,"base":"USA","birthplace":"United States","dateOfBirth":"1961-05-16T00:00:00.000Z","debut":"1989-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Charles Wright  is an American businessman and semi-retired professional wrestler. Wright first entered professional wrestling after being noticed tending bar by wrestlers during the filming of the movie Over the Top. The wrestlers involved gave him the advice that, with his large body type and unique (tattooed) look, he should try seeking out Larry Sharpe and his Monster Factory to get into the business. He is best known for his tenure with the World Wrestling Federation throughout the 1990s and early 2000s under the ring names Papa Shango, Kama, Kama Mustafa, The Godfather, and The Goodfather (when he joined Right to Censor). After leaving the wrestling business he moved to Las Vegas, where he currently manages the strip club Cheetah's.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit":100,"riskTaking":33,"matchLayout":61,"psychology":56,"workerManagement":100,"trainingIntensity":34,"technicalCoaching":25,"characterCoaching":76,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":76,"brandBuilding":54,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":34,"consistency":43,"awareness":56,"judgement":74}},{"id":1211,"name":"Jim Duggan","realName":"Jim Duggan","picture":"Jim Duggan.jpg","ability":66,"currentAbility":69,"potentialAbility":69,"charisma":83,"micSkills":68,"popularity":8,"condition":72,"hardcoreAbility":83,"injuryProne":77,"type":"manager","style":"powerhouse","gender":"M","weight":120,"height":187,"base":"USA","birthplace":"United States","dateOfBirth":"1954-01-14T00:00:00.000Z","debut":"1972-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"James Edward Duggan, Jr. better known by his ring name \"Hacksaw\" Jim Duggan, is an American professional wrestler. He is signed with World Wrestling Entertainment in a Legends contract. His best known character is that of an American patriot, which sees him use a 2x4 length of wood as a weapon, the battle cry \"Hooo!\" and the U-S-A! cheer. Duggan is a survivor of kidney cancer, an illness he was diagnosed with during his time with WCW. Duggan has claimed to have wrestled in all 50 American states and in Australia, Austria, the Bahamas, Belgium, Bermuda, Canada, the Dominican Republic, El Salvador, England, Scotland, Ireland, Wales, France, Germany, Guam, the Netherlands, Italy, Japan, Poland, Spain, and Switzerland. In the WWF, Duggan was the winner of the first ever Royal Rumble match in 1988.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3192],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":71,"productFit":100,"riskTaking":40,"matchLayout":73,"psychology":65,"workerManagement":100,"trainingIntensity":34,"technicalCoaching":11,"characterCoaching":81,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":81,"brandBuilding":44,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":34,"consistency":36,"awareness":65,"judgement":79}},{"id":1212,"name":"Mosh","realName":"Mosh","picture":"Mosh.jpg","ability":44,"currentAbility":49,"potentialAbility":49,"charisma":51,"micSkills":53,"popularity":7,"condition":62,"hardcoreAbility":29,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":90,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1971-05-28T00:00:00.000Z","debut":"1989-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Charles \"Chaz\" Warrington  is an American professional wrestler. He is currently performing under the ring name Mosh as one-half of the tag team The Headbangers along with Thrasher. Warrington began training under Larry Sharpe and Glenn Ruth during the early 1990s. In 1993 he would make several appearances in the World Wrestling Federation as an enhancement talent (under the name Chaz Ware). In 1994, he teamed up with his co-trainer Glenn Ruth. He and Ruth, working as the masked team \"the Spiders\" lost to Axel and Ian Rotten in ECW. Wrestling under a variety of names and gimmicks.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[362,1438,3257],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":54,"productFit":100,"riskTaking":31,"matchLayout":55,"psychology":49,"workerManagement":100,"trainingIntensity":53,"technicalCoaching":38,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":64,"brandBuilding":36,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":53,"consistency":60,"awareness":49,"judgement":69}},{"id":1213,"name":"Thrasher","realName":"Thrasher","picture":"Thrasher.jpg","ability":59,"currentAbility":50,"potentialAbility":50,"charisma":56,"micSkills":39,"popularity":7,"condition":67,"hardcoreAbility":36,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":111,"height":190,"base":"USA","birthplace":"United States","dateOfBirth":"1969-06-13T00:00:00.000Z","debut":"1990-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Glenn Ruth  is an American professional wrestler, better known by his ring name, Thrasher. He is one-half of the tag team The Headbangers with Mosh. Ruth is best known for his appearances in the World Wrestling Federation between 1996 and 2000. Thrasher is a former NWA World Tag Team Champion and WWF World Tag Team Champion. After retiring in 2002, he returned to professional wrestling in 2011, reforming The Headbangers with Mosh and appearing on the independent circuit.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[362,1438],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":49,"storytelling":54,"productFit":100,"riskTaking":27,"matchLayout":55,"psychology":49,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":39,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":58,"brandBuilding":36,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":60,"awareness":49,"judgement":69}},{"id":1215,"name":"Joey Janela","realName":"Joey Janela","picture":"Joey Janela.jpg","ability":42,"currentAbility":49,"potentialAbility":49,"charisma":45,"micSkills":43,"popularity":23,"condition":79,"hardcoreAbility":43,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":83,"height":170,"base":"USA","birthplace":"United States","dateOfBirth":"1989-07-03T00:00:00.000Z","debut":"2008-06-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Joey Janela is an American wrestler who works in America, Canada, Mexico, the British Isles, Japan and Europe. He is a Lightweight who is classed as using a Daredevil style. He is best known for his work with AEW, DDT, PWG, MLW, GCW, The Crash, DEFY, EVOLVE, Beyond, PROGRESS, AAW, AIW, Smash, C4, A1, DTU and CZW. He is currently the GCW Extreme champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":77,"teams":[2154,2510,2603],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":56,"productFit":100,"riskTaking":35,"matchLayout":57,"psychology":53,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":44,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":72,"brandBuilding":48,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":68,"awareness":53,"judgement":72},"contract":{"id":"tew-contract-1215","wrestlerId":1215,"promotionId":77,"startDate":"2015-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1216,"name":"Avery Good","realName":"Avery Good","picture":"Dasher Hatfield.jpg","ability":57,"currentAbility":55,"potentialAbility":55,"charisma":49,"micSkills":61,"popularity":3,"condition":90,"hardcoreAbility":50,"injuryProne":100,"type":"manager","style":"powerhouse","gender":"M","weight":99,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1986-08-14T00:00:00.000Z","debut":"2007-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Dasher Hatfield is as embedded in the heart and soul of Chikara as guys like Mike Quackenbush, the Colony, Team FIST and Claudio Castagnoli. While he's still very green in the ring, he's got the rare quality to take a crowd in the palm of his hand and play them to perfection. Sure, they're only small crowds for now, but that kind of charisma translates into bigger crowds and better reactions with time. There is such an endearing quality about Dasher, especially in this latest and hopefully final permutation of the Create-a-Wrestler gimmick.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2634],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":60,"productFit":100,"riskTaking":22,"matchLayout":61,"psychology":57,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":58,"characterCoaching":71,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":71,"brandBuilding":51,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":71,"awareness":57,"judgement":74}},{"id":1217,"name":"Savannah Summers","realName":"Savannah Summers","picture":"Savannah Summers.jpg","ability":48,"currentAbility":50,"potentialAbility":50,"charisma":40,"micSkills":53,"popularity":2,"condition":100,"hardcoreAbility":64,"injuryProne":95,"type":"wrestler","style":"technical","gender":"F","weight":57,"height":160,"base":"Australia","birthplace":"Australia","dateOfBirth":"1987-11-15T00:00:00.000Z","debut":"2005-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Savannah is the first lady of Riot City Wrestling, and has been with RCW since its inception in 2006. In 2012 she became the first RCW Women’s Champion, proving that she is undoubtedly Riot City’s leading female wrestler. Her hard hitting in ring ability and technical high flying moves make her one of the most talented female wrestlers in Australia. Savannah has also been interviewed for various publications such as Dolly magazine, The Sunday Mail and also more recently for radio with ABC online. Initially starting out prior to RCW as a Valet, Savannah trained for 18 months before making her in ring debut against Sara Jay.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":45,"storytelling":49,"productFit":40,"riskTaking":38,"matchLayout":50,"psychology":45,"workerManagement":40,"trainingIntensity":71,"technicalCoaching":56,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":62,"brandBuilding":47,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":8,"reactionSpeed":71,"consistency":64,"awareness":45,"judgement":43}},{"id":1219,"name":"Shigehiro Irie","realName":"Shigehiro Irie","picture":"Shigehiro Irie.jpg","ability":68,"currentAbility":68,"potentialAbility":68,"charisma":82,"micSkills":74,"popularity":17,"condition":89,"hardcoreAbility":49,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":115,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1988-03-28T00:00:00.000Z","debut":"2008-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Shigehiro Irie is a Japanese wrestler who works in America, Canada, the British Isles, Japan and Europe. He is a Middleweight who is classed as using a Impactful style. He is best known for his work with AJPW, DDT, wXw, BJW, RevPro, ZERO1, GCW, GanPro, GLEAT, WRESTLE-1, FREEDOMS, PROGRESS, AAW, FCP, AIW, ATTACK!, IWA-MS and SWE. He is currently the wXw Unified World Wrestling champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":96,"teams":[1358,3396,4002,4003,4004],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":69,"productFit":100,"riskTaking":27,"matchLayout":71,"psychology":65,"workerManagement":100,"trainingIntensity":89,"technicalCoaching":58,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":72,"brandBuilding":58,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":89,"consistency":66,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-1219","wrestlerId":1219,"promotionId":96,"startDate":"2021-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1220,"name":"Keisuke Ishii","realName":"Keisuke Ishii","picture":"Keisuke Ishii.jpg","ability":48,"currentAbility":58,"potentialAbility":58,"charisma":46,"micSkills":73,"popularity":5,"condition":84,"hardcoreAbility":53,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":80,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1985-02-06T00:00:00.000Z","debut":"2008-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Keisuke Ishii is a member of the DDT roster, and a part of the group known as Team Dream Futures alongside Shigehiro Irie and Soma Takao. The duo of Ishii and Irie have also appeared for AJP and are slowly making names for themselves.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":104,"teams":[1358],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":24,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":64,"characterCoaching":43,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":43,"brandBuilding":44,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":73,"awareness":56,"judgement":74},"contract":{"id":"tew-contract-1220","wrestlerId":1220,"promotionId":104,"startDate":"2015-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1221,"name":"Kyohei Wada","realName":"Kyohei Wada","picture":"Kyohei Wada.jpg","ability":75,"currentAbility":84,"potentialAbility":84,"charisma":97,"micSkills":91,"popularity":3,"condition":55,"hardcoreAbility":69,"injuryProne":45,"type":"referee","style":"all rounder","gender":"M","weight":82,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1954-11-20T00:00:00.000Z","debut":"1972-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kyohei Wada is the main referee in All-Japan and has more than 35 years’ experience as a referee. He made his debut in the NWA in 1974 and has received commendations from the annual Tokyo Sports Grand Prix for his work. He also does some front office work and is also an avid skier in his free time. Wada decided to leave All-Japan in June 2011 due in part to his role in the promotion diminishing over the previous 2 years. He will remain active as a referee though, and be something of a freelancer when it comes to working with various promotions.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":76,"productFit":100,"riskTaking":100,"matchLayout":76,"psychology":78,"workerManagement":100,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":14,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":14,"brandBuilding":13,"socialMediaSavvy":9,"ruleKnowledge":84,"positioning":87,"reactionSpeed":0,"consistency":58,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-1221","wrestlerId":1221,"promotionId":3,"startDate":"2013-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1222,"name":"Daiki Inaba","realName":"Daiki Inaba","picture":"Daiki Inaba.jpg","ability":56,"currentAbility":61,"potentialAbility":61,"charisma":49,"micSkills":53,"popularity":4,"condition":84,"hardcoreAbility":70,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":82,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1988-02-28T00:00:00.000Z","debut":"2013-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Inaba has a history of training in judo from back when he was in school. He was accepted to the All Japan Pro-Wrestling dojo after he passed an audition that took place in January of 2012. He would remain under training for almost a year and a half and would embark on his first overseas expedition in April of 2013 as he went to Canada. While he was in Japan he would make his professional debut in the Altantice Grand Prix Wrestling against Bobby Sharp on May 24, 2013. Inaba would compete in Canada with face paint much like his mentor Keiji Mutoh, Great Muta, did back when he competed in North America. Inaba was noted as being more than ready for his debut and gained a bit of notoriety amongst some of his peers, namely the man he debuted against in Bobby Sharp and even Rene Dupree.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":45,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":60,"storytelling":64,"productFit":100,"riskTaking":19,"matchLayout":65,"psychology":60,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":62,"characterCoaching":42,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":42,"brandBuilding":49,"socialMediaSavvy":36,"ruleKnowledge":1,"positioning":21,"reactionSpeed":82,"consistency":75,"awareness":60,"judgement":76},"contract":{"id":"tew-contract-1222","wrestlerId":1222,"promotionId":45,"startDate":"2020-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"injury":{"type":"Dislocated Hip","daysToRecover":-4},"returnDate":"2026-04-08T00:00:00.000Z"},{"id":1223,"name":"Kikutaro","realName":"Kikutaro","picture":"Kikutaro.jpg","ability":63,"currentAbility":60,"potentialAbility":60,"charisma":59,"micSkills":60,"popularity":13,"condition":67,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"comedy","gender":"M","weight":105,"height":165,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-11-17T00:00:00.000Z","debut":"1994-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Mitsunobu Kikuzawa better known by his wrestling persona Kikutaro and formerly Ebessan, is a freelance Japanese professional wrestler primarily competing for Kensuke Office and Osaka Pro Wrestling. Kikuzawa has also made appearances in North America, competing in promotions such as Ring of Honor and Pro Wrestling Guerrilla. Kikuzawa started his wrestling career in 1994, wrestling under his birth name for Japanese hardcore wrestling promotions including FMW and W*ING. He was only a jobber and never made much of a name for himself at this stage in his career. In 2009, he gave away his Ebessan character to a regular Osaka Pro wrestler. He now competes freelance as his sole character, Kikutaro.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":75,"productFit":100,"riskTaking":17,"matchLayout":76,"psychology":73,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":52,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":82,"brandBuilding":38,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":61,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-1223","wrestlerId":1223,"promotionId":14,"startDate":"2023-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1225,"name":"Sarah Rowe","realName":"Sarah Rowe","picture":"Mary Dobson.jpg","ability":59,"currentAbility":54,"potentialAbility":54,"charisma":46,"micSkills":55,"popularity":26,"condition":91,"hardcoreAbility":55,"injuryProne":100,"type":"wrestler","style":"striker","gender":"F","weight":63,"height":165,"base":"USA","birthplace":"United States","dateOfBirth":"1993-09-10T00:00:00.000Z","debut":"2011-11-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Sarah Rowe is an American wrestler who works in America, Mexico, the British Isles and Japan. She is a Small worker who is classed as using a Brawler style. She is best known for her work with WWE, NXT, Sendai Girls, SHIMMER, SHINE, AIW and CHIKARA. She is married to Raymond Rowe.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":55,"productFit":100,"riskTaking":45,"matchLayout":56,"psychology":54,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":44,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":55,"mediaHandling":68,"brandBuilding":45,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":65,"awareness":54,"judgement":72}},{"id":1226,"name":"Daichi Hashimoto","realName":"Daichi Hashimoto","picture":"Daichi Hashimoto.jpg","ability":68,"currentAbility":62,"potentialAbility":62,"charisma":61,"micSkills":64,"popularity":5,"condition":86,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":100,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1992-04-13T00:00:00.000Z","debut":"2011-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"A Japanese professional wrestler, who wrestles for Pro Wrestling Zero1. He is the son of the late Shinya Hashimoto. The oldest of three children, Daichi Hashimoto grew up around full-contact sports, as his father Shinya was a legendary pro wrestler, alongside his \"uncles\" Masahiro Chono and Keiji Mutoh. Since the sixth grade, Daichi took up karate, and was part of his middle school's MMA school, Blue Sky. When his father died in July 2005, Daichi decided he wanted to become a professional wrestler. In September 2009, he took part in his father's 25th Anniversary show, hosted by Pro Wrestling Zero1. He competed in an exhibition kickboxing match against Satoru Kobayashi. After nearly a year and a half of training, Daichi Hashimoto finally made his debut on March 6, 2011, at Pro Wrestling Zero1's 10th Anniversary show, where he wrestled Masahiro Chono in a losing effort.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":7,"teams":[1731,1736,2405,2406],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":20,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":68,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":54,"brandBuilding":61,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":51,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-1226","wrestlerId":1226,"promotionId":7,"startDate":"2016-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1228,"name":"Tim Donst","realName":"Tim Donst","picture":"Tim Donst.jpg","ability":62,"currentAbility":65,"potentialAbility":65,"charisma":71,"micSkills":59,"popularity":2,"condition":71,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":109,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1987-10-17T00:00:00.000Z","debut":"2007-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Timothy \"Tim\" Donst  is an American professional wrestler, performing primarily in Chikara, where he is a former Young Lions Cup holder. He is known for his amateur wrestling background, which became the focal point of his gimmick. Donst started out his career by training in Chikara's training facility under the tutelage of Claudio Castagnoli and Mike Quackenbush. He made his debut in 2007 at Rey de Voladores in a trios match, which had his team end up on the losing end. This would continue for a while, as he would lose to many more opponents, slowly building some steam, before the match got him noticed against Eddie Kingston, who dished out vicious punishment that Donst would survive through, and keep coming back, but still lost.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":31,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":66,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":69,"brandBuilding":38,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":62,"awareness":58,"judgement":75}},{"id":1229,"name":"Dory Funk Jr.","realName":"Dory Funk Jr.","picture":"Dory Funk Jr.jpg","ability":88,"currentAbility":94,"potentialAbility":94,"charisma":79,"micSkills":100,"popularity":13,"condition":34,"hardcoreAbility":100,"injuryProne":100,"type":"writer","style":"technical","gender":"M","weight":102,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1941-02-03T00:00:00.000Z","debut":"1959-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":true,"story":"Dorrance Earnest \"Dory\" Funk, Jr. is a retired professional wrestler and wrestling trainer. He is the son of Dory Funk, Sr. and brother of Terry Funk. He is credited with the invention of the Texas cloverleaf submission hold and runs the Funking Conservatory, a professional wrestling school. His students and friends participate in a wrestling show, local to Ocala, Florida, called !Bang!. Dory is a former world heavyweight champion, having held the NWA World Heavyweight Championship once. To date, he was the fifth longest reigning NWA World Heavyweight Champion of all time, holding it for over four years. In addition, he also held the major heavyweight titles (but not officially recognized as World Titles): WWC Universal Heavyweight Championship once, the CWA World Heavyweight Championship once. He is also a 2009 WWE Hall of Fame Inductee. He is currently working for All Japan Pro Wrestling as the Pacific Wrestling Federation (PWF) chairman.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1060,1427,3304],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":88,"storytelling":92,"productFit":100,"riskTaking":40,"matchLayout":93,"psychology":88,"workerManagement":100,"trainingIntensity":44,"technicalCoaching":49,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":60,"brandBuilding":38,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":44,"consistency":27,"awareness":88,"judgement":93}},{"id":1230,"name":"Chris Raaber","realName":"Chris Raaber","picture":"Bambikiller.jpg","ability":63,"currentAbility":59,"potentialAbility":59,"charisma":44,"micSkills":70,"popularity":3,"condition":88,"hardcoreAbility":73,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":114,"height":190,"base":"Germany","birthplace":"Germany","dateOfBirth":"1981-09-06T00:00:00.000Z","debut":"1998-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Chris Raaber is an Austrian wrestler who works in America, Canada, Mexico, the British Isles, Japan, Europe and Oceania. He is a Middleweight who is classed as using a Regular style.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":54,"storytelling":60,"productFit":100,"riskTaking":29,"matchLayout":62,"psychology":54,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":53,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":53,"brandBuilding":62,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":78,"awareness":54,"judgement":72}},{"id":1231,"name":"Adam Page","realName":"Adam Page","picture":"Adam Page.jpg","ability":69,"currentAbility":74,"potentialAbility":74,"charisma":68,"micSkills":86,"popularity":53,"condition":87,"hardcoreAbility":73,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":97,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1991-07-27T00:00:00.000Z","debut":"2008-05-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Adam Page is an American wrestler who works in the USA, Canada and Japan. He is a 6'0\", 213lb worker who is classed as using a Brawler style. He uses the Buckshot Lariat as his finisher. He is best known for his work with AEW, NJPW, PWG, ROH and EVOLVE. He is currently the AEW World champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[652,1269,1968],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":82,"storytelling":81,"productFit":100,"riskTaking":27,"matchLayout":81,"psychology":82,"workerManagement":100,"trainingIntensity":86,"technicalCoaching":64,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":85,"