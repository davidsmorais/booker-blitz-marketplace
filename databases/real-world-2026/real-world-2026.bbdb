"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":59,"storytelling":63,"productFit":100,"riskTaking":31,"matchLayout":64,"psychology":59,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":36,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":55,"brandBuilding":44,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":75,"awareness":59,"judgement":75}},{"id":1101,"name":"Yoshiaki Yatsu","realName":"Yoshiaki Yatsu","picture":"Yoshiaki Yatsu.jpg","ability":81,"currentAbility":88,"potentialAbility":88,"charisma":92,"micSkills":87,"popularity":4,"condition":54,"hardcoreAbility":100,"injuryProne":86,"type":"writer","style":"submission","gender":"M","weight":115,"height":182,"base":"Japan","birthplace":"Japan","dateOfBirth":"1956-07-19T00:00:00.000Z","debut":"1976-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"A veteran wrestler who has been active for over 30 years, Yatsu was originally an olympic freestyle wrestler who took part to the Montreal olympic games. After retiring, Yatsu immediately joined the New Japan Dojo and debuted in USA in the WWF. A couple of years later Yatsu finally had his Japanese debut, as a Riki Choshu protégé. In 1984 Yatsu left New Japan for All Japan, where he had a huge push, capturing the NWA International Tag Team Title when he teamed with Riki Choshu. In 1998/1999 Yatsu formed a successful tag team with Jumbo Tsuruta and they would win the All Japan Tag Team Championship 5 times. Following this success, Yatsu even had a title shot for the Triple Crown, but was defeated by Tenryu. In 1990 Yatsu joined SWS and when the promotion closed its doors in 1992, his career started to decline. He founded SPWF (Social Pro Wrestling Federation), which has never encountered a great deal of success.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2978,2979],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":76,"storytelling":78,"productFit":100,"riskTaking":22,"matchLayout":79,"psychology":76,"workerManagement":100,"trainingIntensity":44,"technicalCoaching":41,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":55,"brandBuilding":43,"socialMediaSavvy":49,"ruleKnowledge":25,"positioning":40,"reactionSpeed":44,"consistency":49,"awareness":76,"judgement":86}},{"id":1103,"name":"Azteca","realName":"Azteca","picture":"Azteca.jpg","ability":51,"currentAbility":58,"potentialAbility":58,"charisma":57,"micSkills":51,"popularity":3,"condition":64,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":90,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1970-07-16T00:00:00.000Z","debut":"1993-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Azteca is the co-founder of KAGEKI and a 16-year veteran of wrestling. He debuted in Mexico and competed throughout Japan before founding KAGEKI and becoming it’s leader and top star. He has maintained good relationships with some of puroresu’s top stars, which has opened the door not only for some KAGEKI stars to participate in other promotions, but for these big names to also appear in KAGEKI over the years.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":71,"productFit":100,"riskTaking":25,"matchLayout":72,"psychology":68,"workerManagement":100,"trainingIntensity":52,"technicalCoaching":56,"characterCoaching":64,"diagnosis":50,"reha