r Heavyweight Championship reign which was 1,309 days. With a background in amateur wrestling, Fuchi debuted as a professional wrestler on August 22, 1974 for AJPW, facing future Death Match innovator Atsushi Onita. On July 14 2013, during the launching event of the post-Keiji Mutoh All Japan, Fuchi appeared and announced that he had officially re-signed with AJPW not only as a wrestler, but also as a member of the Board of Directors.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[2883,2884],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":85,"productFit":100,"riskTaking":28,"matchLayout":86,"psychology":80,"workerManagement":100,"trainingIntensity":54,"technicalCoaching":68,"characterCoaching":31,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":31,"brandBuilding":28,"socialMediaSavvy":31,"ruleKnowledge":0,"positioning":20,"reactionSpeed":54,"consistency":56,"awareness":80,"judgement":88},"contract":{"id":"tew-contract-914","wrestlerId":914,"promotionId":3,"startDate":"1983-08-19T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":916,"name":"Seiki Yoshioka","realName":"Seiki Yoshioka","picture":"Seiki Yoshioka.jpg","ability":50,"currentAbility":59,"potentialAbility":59,"charisma":50,"micSkills":54,"popularity":5,"condition":93,"hardcoreAbility":68,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":77,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1988-01-05T00:00:00.000Z","debut":"2008-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Seiki Yoshioka is a Japanese wrestler who works in the British Isles and Japan. He is a 5'7\", 169lb worker who is classed as using a Technician Flyer style. He uses the Zero Shootout as his finisher. He is best known for his work with NOAH, AJPW, ZERO1, GLEAT, WRESTLE-1 and FCP. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[2957,3460,4294],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":71,"productFit":100,"riskTaking":21,"matchLayout":72,"psychology":67,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":68,"characterCoaching":48,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":48,"brandBuilding":54,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":73,"awareness":67,"judgement":80},"contract":{"id":"tew-contract-916","wrestlerId":916,"promotionId":3,"startDate":"2024-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":917,"name":"Addy Starr","realName":"Addy Starr","picture":"Addy Starr.jpg","ability":46,"currentAbility":47,"potentialAbility":47,"charisma":49,"micSkills":54,"popularity":1,"condition":89,"hardcoreAbility":54,"injuryProne":100,"type":"wrestler","style":"striker","gender":"F","weight":50,"height":154,"base":"Canada","birthplace":"Canada","dateOfBirth":"1988-07-08T00:00:00.000Z","debut":"2006-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Addy Starr is a Canadian wrestler who works in America, Canada and the British Isles. She is a Small worker who is classed as using a Brawler style. She is best known for her work with RevPro, Beyond, PROGRESS, AIW, C4 and EVE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null