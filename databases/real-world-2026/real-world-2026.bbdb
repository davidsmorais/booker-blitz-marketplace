25,"matchLayout":88,"psychology":86,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":74,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":56,"brandBuilding":58,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":95,"awareness":86,"judgement":92},"contract":{"id":"tew-contract-221","wrestlerId":221,"promotionId":65,"startDate":"2012-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":222,"name":"Corey Graves","realName":"Corey Graves","picture":"Corey Graves.jpg","ability":78,"currentAbility":75,"potentialAbility":75,"charisma":78,"micSkills":60,"popularity":25,"condition":71,"hardcoreAbility":73,"injuryProne":100,"type":"commentator","style":"technical","gender":"M","weight":94,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1984-02-24T00:00:00.000Z","debut":"2000-03-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Matt Polinsky is an American professional wrestler, better known by his ring name Sterling James Keenan. Polinsky chose his ring name the night before his first professional wrestling match, and picked the name \"Sterling James Keenan\" as a tribute to Sterling Sharpe, Polinsky's favorite American football player as a child, and Maynard James Keenan of the band Tool. Throughout his career, Keenan has made appearances for NWA Upstate, Independent Wrestling Association Mid-South, Cleveland All-Pro Wrestling, and Full Throttle Wrestling. Keenan debuted in the International Wrestling Cartel (IWC) on October 19, 2002, defeating Troy Lords. Keenan made his debut for the United Kingdom-based 1 Pro Wrestling (1PW) at their inaugural show, A Cruel Twist of Fate, on October 1, 2005, defeating D'Lo Brown. In August 2011, it was reported that Polinksy had signed a developmental contract with WWE.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":64,"storytelling":67,"productFit":100,"riskTaking":22,"matchLayout":68,"psychology":64,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":53,"characterCoaching":75,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":60,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":73,"awareness":64,"judgement":78},"contract":{"id":"tew-contract-222","wrestlerId":222,"promotionId":64,"startDate":"2025-06-16T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":223,"name":"Steve Keirn","realName":"Steve Keirn","picture":"Steve Keirn.jpg","ability":79,"currentAbility":84,"potentialAbility":84,"charisma":94,"micSkills":81,"popularity":12,"condition":77,"hardcoreAbility":89,"injuryProne":89,"type":"writer","style":"all rounder","gender":"M","weight":98,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1951-09-10T00:00:00.000Z","debut":"1972-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Stephen Paul \"Steve\" Keirn is an American retired professional wrestler. He is best known for being part of the tag team The Fabulous Ones, with Stan Lane, and later for a run in the World Wrestling Federation (WWF) as Skinner, a gimmick that portrayed him as a tobacco spitting alligator hunter from the Everglades. Since the late 1980s, Keirn has run a school to train wrestlers. Originally located in Tampa, Florida, Keirn's \"Professional Wrestling School of Hard Knocks\" is now located in Brandon, Florida. Keirn helped train many wrestlers, including Mike Awesome, Dennis Knight, Joe \"Destiny\" Clapp, Diamond Dallas Page, Dustin Rhodes and Tracy Smothers. The school has since been incorporated into the WWE's developmental territory, NXT Wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3121],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":76,"productFit":100,"riskTaking":25,"matchLayout":79,"psychology":68,"workerManagement":100,"trainingIntensity":35,"technicalCoaching":30,"characterCoaching":49,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":49,"brandBuilding":40,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":35,"consistency":41,"awareness":68,"judgement":81}},{"id":224,"name":"Terry Taylor","realName":"Terry Taylor","picture":"Terry Taylor.jpg","ability":89,"currentAbility":82,"potentialAbility":82,"charisma":76,"micSkills":83,"popularity":9,"condition":55,"hardcoreAbility":98,"injuryProne":93,"type":"writer","style":"all rounder","gender":"M","weight":102,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1955-08-12T00:00:00.000Z","debut":"1979-08-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Paul Worden Taylor III is a retired American professional wrestler better known by his ring name Terry Taylor and for his time in National Wrestling Alliance, World Championship Wrestling and World Wrestling Federation. Terry Taylor was a popular fan favorite for much of his early career in the Mid-South region, as well as the Mid-Atlantic in the 1980s. Taylor was originally selected to be part of The Fabulous Ones tag team with Stan Lane, but that role went to Florida wrestler, Steve Keirn. Taylor then formed a tag team with Bobby Fulton called the Fantastic Ones. In 2012, Taylor was resigned by WWE to work as a trainer in its developmental territory NXT Wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":65,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":69,"productFit":100,"riskTaking":34,"matchLayout":71,"psychology":63,"workerManagement":100,"trainingIntensity":35,"technicalCoaching":16,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":53,"brandBuilding":40,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":35,"consistency":69,"awareness":63,"judgement":78},"contract":{"id":"tew-contract-224","wrestlerId":224,"promotionId":65,"startDate":"2012-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"inDevelopment":true},{"id":225,"name":"Taylor Rotunda","realName":"Taylor Rotunda","picture":"Bo Dallas.jpg","ability":52,"currentAbility":55,"potentialAbility":55,"charisma":63,"micSkills":48,"popularity":43,"condition":92,"hardcoreAbility":38,"injuryProne":98,"type":"wrestler","style":"technical","gender":"M","weight":102,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1990-05-25T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Bo Dallas Bo-lieves he was born to be a star, and based on his unbreakable spirit, he’ll have no problem achieving his dream. A former NXT Champion, this grinning grappler sports an impressive array of in-ring maneuvers, including his signature Running Tornado \"Bo-Dog.\" His impact extends beyond the ropes, however, with his moving messages for the WWE Universe, opponents and anyone who will listen. The sky is the limit for this self-proclaimed success story. Hitting the main roster after weeks of inspirational vignettes urging the WWE Universe to reach for the stars and follow their dreams, it was Bo-Time. Making his WWE ring debut on the May 23, 2014 edition of SmackDown, Dallas didn’t disappoint, beginning his WWE career with an impressive winning streak.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1500,1612],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":60,"productFit":100,"riskTaking":24,"matchLayout":61,"psychology":57,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":46,"characterCoaching":75,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":75,"brandBuilding":50,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":62,"awareness":57,"judgement":74}},{"id":226,"name":"Angelo Dawkins","realName":"Angelo Dawkins","picture":"Angelo Dawkins.jpg","ability":52,"currentAbility":62,"potentialAbility":62,"charisma":63,"micSkills":54,"popularity":46,"condition":85,"hardcoreAbility":47,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":118,"height":193,"base":"USA","birthplace":"United States","dateOfBirth":"1990-07-24T00:00:00.000Z","debut":"2012-06-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Angelo Dawkins is a proven success story when it comes to athletic achievements. During his collegiate days, this multifaceted competitor captured national titles in three sports: football, wrestling and track. Dawkins credits his previous athletic accomplishments to his highly competitive nature and distinct ability to outmaneuver those who stand before him.\r\n\r\nFast-forward a few years to Angelo Dawkins, established Superstar, and not much has changed. Dawkins remains a top competitor in his chosen sport, an athlete who’s willing to outhustle and outwork opponents at every turn. Although it took The Curse of Greatness some time to find himself — he tested the waters with various tag team partners early in his career — Dawkins experienced a breakthrough moment upon forming The Street Profits with tag team partner Montez Ford.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[1603,2361,2675],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":61,"productFit":100,"riskTaking":26,"matchLayout":63,"psychology":57,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":61,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":65,"brandBuilding":60,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":80,"awareness":57,"judgement":74},"contract":{"id":"tew-contract-226","wrestlerId":226,"promotionId":64,"startDate":"2018-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":228,"name":"Real1","realName":"Real1","picture":"Enzo Amore.jpg","ability":46,"currentAbility":45,"potentialAbility":45,"charisma":49,"micSkills":37,"popularity":18,"condition":85,"hardcoreAbility":61,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":91,"height":177,"base":"USA","birthplace":"United States","dateOfBirth":"1986-12-08T00:00:00.000Z","debut":"2012-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Real1, a 2012 graduate of the WWE Performance Center, is an American wrestler who works in America and Canada. He is a Small worker who is classed as using a Entertainer style. He is one half of Nzo & Caz alongside Big Bill. He is best known for his work with WWE, NXT and MLW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1045,1046,2071],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":49,"productFit":41,"riskTaking":47,"matchLayout":51,"psychology":44,"workerManagement":41,"trainingIntensity":62,"technicalCoaching":26,"characterCoaching":86,"diagnosis":50,"rehabilitation":50,"prevention":53,"mediaHandling":86,"brandBuilding":68,"socialMediaSavvy":76,"ruleKnowledge":0,"positioning":8,"reactionSpeed":62,"consistency":60,"awareness":44,"judgement":43}},{"id":229,"name":"Luchasaurus","realName":"Luchasaurus","picture":"Luchasaurus.jpg","ability":63,"currentAbility":53,"potentialAbility":53,"charisma":68,"micSkills":39,"popularity":27,"condition":87,"hardcoreAbility":43,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":125,"height":193,"base":"USA","birthplace":"United States","dateOfBirth":"1985-03-10T00:00:00.000Z","debut":"2009-10-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Some say he is disturbed, others say he is a mad genius, but if you asked him - he would simply say that he is ahead of the curve. Judas Devlin is one of the more deranged, yet oddly intellectual superstars of NXT. Standing at 6 feet 5 inches tall and covered in colorful tattoos, this modern day Aristocrat uses his deceitful intellect to confuse and break down his opponents mentally before ever stepping foot in the ring. Hailing from the coast of California, where from an early age he was exposed to off-beat cultural and philosophical ideas, Judas began his career not in the ring, but in the halls at the University of Berkley. There, after years of study he became a published author, scholar, and professor of history. However, with time he became disgusted with what he called, “the weak wills and feeble hearts of his colleagues and students.”","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1619,1904,1946,3452],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":50,"storytelling":55,"productFit":56,"riskTaking":30,"matchLayout":56,"psychology":50,"workerManagement":56,"trainingIntensity":68,"technicalCoaching":35,"characterCoaching":57,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":57,"brandBuilding":73,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":11,"reactionSpeed":68,"consistency":66,"awareness":50,"judgement":52},"contract":{"id":"tew-contract-229","wrestlerId":229,"promotionId":76,"startDate":"2019-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"injury":{"type":"Dislocated Shoulder","daysToRecover":-4},"returnDate":"2026-04-08T00:00:00.000Z"},{"id":231,"name":"Dean Muhtadi","realName":"Dean Muhtadi","picture":"Mojo Rawley.jpg","ability":47,"currentAbility":45,"potentialAbility":45,"charisma":54,"micSkills":44,"popularity":19,"condition":82,"hardcoreAbility":38,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":120,"height":190,"base":"USA","birthplace":"United States","dateOfBirth":"1986-07-17T00:00:00.000Z","debut":"2013-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Prior to his ring career, Rawley played all positions on the defensive line for the University of Maryland while assuming the same role for the Green Bay Packers and Arizona Cardinals in the NFL. Pushing the boundaries of every muscle in his body and brain, Mojo shattered countless records in strength and speed, and even earned his MBA degree at the young age of 23.\r\n\r\nAll of this made Rawley a no-brainer to join the world of sports-entertainment, where one must stay hyped and hungry at all times. Mojo proved to be both, blazing a trail through WWE NXT that eventually landed him in a tag team with veteran Superstar Zack Ryder. As The Hype Bros, Mojo and Zack fed off each other’s enthusiasm and energy, becoming a force to be reckoned with in NXT and SmackDown LIVE's tandem divisions. While The Hype Bros initially stayed within striking distance of the SmackDown Tag Team Titles, a prolonged losing streak proved too much for Rawley, who shocked the WWE Universe, savagely attacking Ryder.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1449,1450],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":48,"productFit":100,"riskTaking":32,"matchLayout":49,"psychology":44,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":18,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":68,"brandBuilding":67,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":62,"awareness":44,"judgement":66}},{"id":232,"name":"Adam Cole","realName":"Adam Cole","picture":"Adam Cole.jpg","ability":77,"currentAbility":67,"potentialAbility":67,"charisma":79,"micSkills":69,"popularity":50,"condition":71,"hardcoreAbility":58,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":92,"height":177,"base":"USA","birthplace":"United States","dateOfBirth":"1989-07-05T00:00:00.000Z","debut":"2008-04-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Irreverent, decorated and undeniably a big-match player, Cole was already drawing comparisons to a young Shawn Michaels by the time he made his unannounced NXT debut at TakeOver: Brooklyn III. It was there that The Panama City Playboy emerged from the stands to join Bobby Fish and Kyle O’Reilly in attacking then–NXT Champion Drew McIntyre. The NXT Universe’s chorus of “Adam Cole, Bay Bay” made it clear that a new main-event Superstar had arrived, but nobody realized that NXT was also witnessing the formation of what would become its most successful faction: The Undisputed ERA.\r\n\r\nWith Cole leading the charge, The Undisputed ERA soon expanded to include Roderick Strong, and together, the four-Superstar unit has achieved nothing less than total dominance. Whether through sheer talent, occasional treachery or a wolfpack-like force in numbers, The Undisputed ERA wasted little time trouncing the competition and accumulating a staggering collection of championships.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1062,3809,3810],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":73,"productFit":100,"riskTaking":18,"matchLayout":74,"psychology":70,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":67,"characterCoaching":82,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":82,"brandBuilding":74,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":66,"awareness":70,"judgement":82},"contract":{"id":"tew-contract-232","wrestlerId":232,"promotionId":76,"startDate":"2021-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"injury":{"type":"Concussion","daysToRecover":-1},"returnDate":"2026-04-11T00:00:00.000Z"},{"id":235,"name":"BJ Whitmer","realName":"BJ Whitmer","picture":"BJ Whitmer.jpg","ability":65,"currentAbility":64,"potentialAbility":64,"charisma":58,"micSkills":79,"popularity":13,"condition":58,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":105,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1978-01-25T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"BJ Whitmer is a retired American wrestler who works primarily as a road agent. He is best known for his work with AEW, IMPACT, NOAH, PWG, wXw, ROH, AAW, AIW, IWA-MS, A1 and CZW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1426,1490,1565],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":72,"productFit":100,"riskTaking":25,"matchLayout":75,"psychology":63,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":51,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":54,"brandBuilding":32,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":64,"awareness":63,"judgement":78}},{"id":237,"name":"Brian Gorie","realName":"Brian Gorie","picture":"Brian Gorie.jpg","ability":61,"currentAbility":60,"potentialAbility":60,"charisma":54,"micSkills":66,"popularity":1,"condition":100,"hardcoreAbility":54,"injuryProne":100,"type":"referee","style":"all rounder","gender":"M","weight":71,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1982-07-04T00:00:00.000Z","debut":"1998-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Brian Gorie is an American professional wrestling referee. Debuting in 1998 at the age of 16, Brian has refereed for over 80 different professional wrestling promotions including Ring Of Honor, TNA Wrestling, Juggalo Championship Wrestling and Shimmer Women Athletes. Ring Of Honor is known to employ the best referees in all of professional wrestling & continuing that tradition is veteran official Brian Gorie. Debuting with ROH in 2003, Gorie has reffed for nearly every top wrestling group in the United States before starting full-time with ROH in 2012. As well as being known for his speed and athleticism, BG is also ambidextrous, allowing him to count with either hand to ensure the best positioning possible for pinfalls. Due to his vast experience as a Shimmer referee, Brian has earned the role of the official 'Women Of Honor' ref in ROH.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":11,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":11,"brandBuilding":11,"socialMediaSavvy":5,"ruleKnowledge":60,"positioning":48,"reactionSpeed":0,"consistency":78,"awareness":0,"judgement":0}},{"id":239,"name":"Caprice Coleman","realName":"Caprice Coleman","picture":"Caprice Coleman.jpg","ability":54,"currentAbility":54,"potentialAbility":54,"charisma":45,"micSkills":57,"popularity":4,"condition":82,"hardcoreAbility":57,"injuryProne":100,"type":"commentator","style":"technical","gender":"M","weight":97,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1977-03-20T00:00:00.000Z","debut":"1996-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Caprice Coleman is an American wrestler who works in America and Canada. He is a Lightweight who is classed as using a Technician style. He is best known for his work with NWA and ROH. He is the protege of Jeff Hardy.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[975],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":40,"matchLayout":66,"psychology":58,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":50,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":53,"brandBuilding":49,"socialMediaSavvy":40,"ruleKnowledge":40,"positioning":52,"reactionSpeed":72,"consistency":75,"awareness":58,"judgement":75},"contract":{"id":"tew-contract-239","wrestlerId":239,"promotionId":49,"startDate":"2011-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000,"inDevelopment":true},{"id":240,"name":"Cary Silkin","realName":"Cary Silkin","picture":"Cary Silkin.jpg","ability":43,"currentAbility":39,"potentialAbility":39,"charisma":53,"micSkills":48,"popularity":3,"condition":100,"hardcoreAbility":34,"injuryProne":33,"type":"manager","style":"all rounder","gender":"M","weight":78,"height":162,"base":"USA","birthplace":"United States","dateOfBirth":"1959-11-22T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"As the former owner of Ring of Honor from 2004 - 2011, Cary Silkin spearheaded the international growth of ROH Wrestling.  Under his ownership, the company traveled into new territory both in terms of live events and in the ways in which fans could experience ROH for themselves.  Under Mr. Silkin, Ring of Honor branched out across the United States as well as into the United Kingdom and Japan to bring the best pro wrestling on the planet to the world.  In addition, it was under his direction that ROH first broached the realm on traditional PPV broadcasts, entered into the television realm with a two year run on HDNet, and innovated the field of iPPV as it pertained to professional wrestling.  Ring of Honor would not be where it is today without Cary Silkin.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":2,"storytelling":1,"productFit":0,"riskTaking":99,"matchLayout":1,"psychology":2,"workerManagement":0,"trainingIntensity":2,"technicalCoaching":0,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":1,"mediaHandling":55,"brandBuilding":27,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":0,"reactionSpeed":2,"consistency":1,"awareness":2,"judgement":1},"contract":{"id":"tew-contract-240","wrestlerId":240,"promotionId":49,"startDate":"2004-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":241,"name":"Cedric Alexander","realName":"Cedric Alexander","picture":"Cedric Alexander.jpg","ability":69,"currentAbility":60,"potentialAbility":60,"charisma":63,"micSkills":69,"popularity":29,"condition":82,"hardcoreAbility":43,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":93,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1989-08-16T00:00:00.000Z","debut":"2009-07-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Cedric Alexander is an American wrestler who works in the USA and Canada. He is a 5'10\", 205lb worker who is classed as using a High Flyer style. He uses the Kick to Kill, the Lumbar Check and the Overtime as his finishers. He is best known for his work with WWE, TNA, ROH and DPW. He is married to Big Swole.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":28,"teams":[975,2075,2441,2661,3937],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":60,"storytelling":65,"productFit":100,"riskTaking":21,"matchLayout":67,"psychology":60,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":58,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":60,"brandBuilding":58,"socialMediaSavvy":52,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":70,"awareness":60,"judgement":76},"contract":{"id":"tew-contract-241","wrestlerId":241,"promotionId":28,"startDate":"2025-06-21T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":243,"name":"Davey Richards","realName":"Davey Richards","picture":"Davey Richards.jpg","ability":60,"currentAbility":69,"potentialAbility":69,"charisma":56,"micSkills":62,"popularity":18,"condition":70,"hardcoreAbility":49,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":92,"height":170,"base":"USA","birthplace":"United States","dateOfBirth":"1983-03-01T00:00:00.000Z","debut":"2004-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Davey Richards is a retired American wrestler who tends to stay behind the scenes in the wrestling world. He is best known for his work with NJPW, IMPACT, Dragongate, NOAH, PWG, wXw, ROH, MLW, RevPro, DEFY, EVOLVE, BLP, AAW, IWA-MS, DTU and CZW. He was one half of the Tag Team Of The Year in 2009.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[929,930,1258,1259,1347,1356,1375,1524,3017],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":64,"storytelling":70,"productFit":100,"riskTaking":27,"matchLayout":72,"psychology":64,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":78,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":54,"brandBuilding":64,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":80,"awareness":64,"judgement":78}},{"id":244,"name":"Delirious","realName":"Delirious","picture":"Delirious.jpg","ability":83,"currentAbility":84,"potentialAbility":84,"charisma":96,"micSkills":87,"popularity":11,"condition":84,"hardcoreAbility":80,"injuryProne":100,"type":"writer","style":"high flyer","gender":"M","weight":91,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1980-12-19T00:00:00.000Z","debut":"2001-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"“Bah bah bah … bah bah … bah … BAHHHHH!”\r\n\r\nIn other words, welcome to the Edge of Sanity, where Delirious resides when he’s not busy tearing up the wrestling ring with a style as unpredictable and chaotic as the language -- or is it languages? -- flowing from his mouth. The unorthodox masked madman made his Ring of Honor debut in 2004 and quickly gained a cult following despite not winning his first match in ROH until two years later.\r\n\r\nDelirious went on to win the 2006 Survival of the Fittest and become a top challenger for the ROH World Championship. Delirious’ appearances in ROH have been sporadic in recent years, but the one thing that has remained certain about Delirious is that absolutely nothing is for certain.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":28,"teams":[2637,2649],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":70,"productFit":100,"riskTaking":17,"matchLayout":71,"psychology":67,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":60,"characterCoaching":81,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":81,"brandBuilding":58,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":76,"awareness":67,"judgement":80},"contract":{"id":"tew-contract-244","wrestlerId":244,"promotionId":28,"startDate":"2022-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":245,"name":"Eddie Edwards","realName":"Eddie Edwards","picture":"Eddie Edwards.jpg","ability":80,"currentAbility":73,"potentialAbility":73,"charisma":78,"micSkills":87,"popularity":29,"condition":76,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":97,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1983-12-30T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Eddie Edwards is an American wrestler who works in America, Canada and Japan. He is a Middleweight who is classed as using a Impactful style. He is best known for his work with AAA, NOAH, IMPACT, PWG, ROH, ZERO1, RevPro, WRESTLE-1, Beyond, AAW, C4 and CZW. He is married to Alexxis Nevaeh. He was one half of the Tag Team Of The Year in 2009.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":28,"teams":[929,930,1033,1375,1524,2664,4001],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":72,"storytelling":76,"productFit":100,"riskTaking":24,"matchLayout":77,"psychology":72,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":77,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":55,"brandBuilding":52,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":82,"awareness":72,"judgement":83},"contract":{"id":"tew-contract-245","wrestlerId":245,"promotionId":28,"startDate":"2014-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":247,"name":"Fit Finlay","realName":"Fit Finlay","picture":"Dave Finlay.jpg","ability":86,"currentAbility":92,"potentialAbility":92,"charisma":100,"micSkills":89,"popularity":31,"condition":62,"hardcoreAbility":88,"injuryProne":87,"type":"writer","style":"technical","gender":"M","weight":106,"height":175,"base":"Other","birthplace":"Unknown","dateOfBirth":"1958-01-31T00:00:00.000Z","debut":"1974-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"His name is Finlay, and he loves to fight. That was the tough-as-nails Northern Irishman’s mantra throughout his sports-entertainment career. After demolishing opponents across Europe for 20 years, Fit Finlay first invaded the United States in 1996, blindsiding Lord Steven Regal on WCW Saturday Night and declaring that he was out for revenge for 400 years of oppression against his people by the British. That ignited a brutal rivalry that saw them scuffle in arenas throughout the country and even in a vicious Parking Lot Brawl that is remembered to this day. Though Finlay left active competition in 2010, there’s always a chance that the surly Superstar will get the itch to put up his dukes and start brawling with any and all comers.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[169,2682],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":83,"storytelling":88,"productFit":100,"riskTaking":23,"matchLayout":90,"psychology":83,"workerManagement":100,"trainingIntensity":39,"technicalCoaching":49,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":56,"brandBuilding":43,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":39,"consistency":38,"awareness":83,"judgement":90},"contract":{"id":"tew-contract-247","wrestlerId":247,"promotionId":64,"startDate":"2020-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":250,"name":"Homicide","realName":"Homicide","picture":"Homicide.jpg","ability":58,"currentAbility":65,"potentialAbility":65,"charisma":72,"micSkills":75,"popularity":16,"condition":69,"hardcoreAbility":52,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":100,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1977-03-20T00:00:00.000Z","debut":"1993-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Homicide is an American wrestler who works in America and Canada. He is a Lightweight who is classed as using a Brawler style. He is one half of Strong Style Thugz alongside Eddie Kingston. He is best known for his work with IMPACT, BJW, NJoA, NWA, ROH, MLW, GCW, ZERO1 and AAW. He is married to someone outside the wrestling business. He was one half of the Tag Team Of The Year in 2006. He is part of the GCW Hall Of Fame.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[107,144,1152,1267,1657,1928,2651],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":27,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":58,"characterCoaching":73,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":73,"brandBuilding":52,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":80,"awareness":68,"judgement":81}},{"id":251,"name":"Jay Briscoe","realName":"Jay Briscoe","picture":"Jay Briscoe.jpg","ability":61,"currentAbility":70,"potentialAbility":70,"charisma":75,"micSkills":61,"popularity":19,"condition":76,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":105,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1984-01-25T00:00:00.000Z","debut":"2000-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"Jay Briscoe, who made his ROH debut on the company’s very first show in 2002, has a well-deserved reputation for being one of the toughest, most intense and dangerous competitors to ever step foot inside a Ring of Honor ring.\r\n\r\nNo one has won more championships in ROH than him. In addition to holding the ROH World Tag Team Titles a record eight times with his brother Mark, Jay is a two-time ROH World Champion and a co-holder of the ROH World Six-Man Tag Team Titles with Mark and Bully Ray. The Sandy Fork, Delaware native also won a share of the 2009 Honor Rumble with Mark, and he and Mark captured the IWGP Heavyweight Tag Team Team Titles in 2012. In addition to all of their championships, “Dem Boys” proudly claim responsibility for ending the legendary Bully Ray’s career.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1396,1397,3097,3098,3495],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":75,"storytelling":77,"productFit":100,"riskTaking":26,"matchLayout":78,"psychology":75,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":64,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":79,"brandBuilding":70,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":85,"awareness":75,"judgement":85}},{"id":252,"name":"Jay Lethal","realName":"Jay Lethal","picture":"Jay Lethal.jpg","ability":71,"currentAbility":70,"potentialAbility":70,"charisma":67,"micSkills":84,"popularity":32,"condition":75,"hardcoreAbility":76,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":97,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1985-04-29T00:00:00.000Z","debut":"2001-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jay Lethal has come to be known as “The Franchise” in Ring of Honor, and with good reason. Lethal, who made his debut with ROH as a teenager in 2003, is the only man to have held the ROH World and ROH World Television Titles simultaneously, as well as the only man to have won all three singles titles in ROH (including the Pure Title, which was subsequently merged with the world title). No one has held the ROH World Television Title longer than Lethal, and his 427-day reign as ROH World Champion is the fourth-longest. Lethal also has won the Honor Rumble (2011) and Survival of the Fittest (2012).\r\n\r\nBeyond that impressive list of accomplishments, Lethal continues to be the measuring stick in ROH. A victory over Lethal not only is a major achievement, but it’s also career-defining.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[113,1172,1972,2652,2653],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":76,"storytelling":79,"productFit":100,"riskTaking":17,"matchLayout":80,"psychology":76,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":69,"characterCoaching":71,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":71,"brandBuilding":54,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":79,"awareness":76,"judgement":86},"contract":{"id":"tew-contract-252","wrestlerId":252,"promotionId":49,"startDate":"2024-12-20T00:00:00.000Z","endDate":"2026-12-20T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-12-20T00:00:00.000Z","wage":1000,"inDevelopment":true},{"id":253,"name":"Jim Cornette","realName":"Jim Cornette","picture":"Jim Cornette.jpg","ability":68,"currentAbility":73,"potentialAbility":73,"charisma":68,"micSkills":85,"popularity":27,"condition":89,"hardcoreAbility":72,"injuryProne":45,"type":"commentator","style":"all rounder","gender":"M","weight":105,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1961-09-17T00:00:00.000Z","debut":"1982-01-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"James Mark \"Jim\" Cornette is an American professional wrestling manager, commentator, promoter, and booker. Cornette is the former \"Commissioner\" of Ring of Honor and is formerly a road agent for Total Nonstop Action Wrestling. As a manager and creative writer, he has worked for Jim Crockett Promotions, World Championship Wrestling and the World Wrestling Federation, and from 1991 to 1995, was the owner of Smoky Mountain Wrestling. A firm believer in \"old-school\" territorial wrestling, Cornette began the Smoky Mountain Wrestling (SMW) promotion in 1991. SMW promoted shows in Tennessee, Kentucky, West Virginia, Georgia, and the Carolinas. By this point, however, the nature of wrestling in the United States had already changed irrevocably, leading Cornette to seek a working relationship with the WWF in 1993. This did not change the new national perception that regional promotions were \"minor league\". The move also did not help the federation's finances, and Cornette closed SMW's doors.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":85,"storytelling":63,"productFit":0,"riskTaking":98,"matchLayout":55,"psychology":85,"workerManagement":0,"trainingIntensity":2,"technicalCoaching":0,"characterCoaching":81,"diagnosis":50,"rehabilitation":50,"prevention":2,"mediaHandling":81,"brandBuilding":46,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":0,"reactionSpeed":2,"consistency":2,"awareness":85,"judgement":51}},{"id":254,"name":"Jimmy Jacobs","realName":"Jimmy Jacobs","picture":"Jimmy Jacobs.jpg","ability":52,"currentAbility":59,"potentialAbility":59,"charisma":67,"micSkills":74,"popularity":17,"condition":63,"hardcoreAbility":71,"injuryProne":100,"type":"manager","style":"high flyer","gender":"M","weight":82,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1984-02-17T00:00:00.000Z","debut":"1999-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jimmy Jacobs is an American wrestler who works in America and Canada. He is a Small worker who is classed as using a Daredevil style. He is best known for his work with IMPACT, NXT, ROH, AAW and IWA-MS. He is the current booker of IMPACT.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":118,"teams":[32,110,1006,1372,1426,1565],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":76,"storytelling":77,"productFit":100,"riskTaking":38,"matchLayout":77,"psychology":76,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":45,"characterCoach