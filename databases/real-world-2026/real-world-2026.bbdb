Women's champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2641],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":69,"productFit":84,"riskTaking":27,"matchLayout":69,"psychology":67,"workerManagement":84,"trainingIntensity":67,"technicalCoaching":62,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":64,"brandBuilding":55,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":17,"reactionSpeed":67,"consistency":71,"awareness":67,"judgement":74}},{"id":2020,"name":"Mat Basso","realName":"Mat Basso","picture":"GD Grimm.jpg","ability":59,"currentAbility":62,"potentialAbility":62,"charisma":69,"micSkills":69,"popularity":3,"condition":100,"hardcoreAbility":44,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":114,"height":195,"base":"Australia","birthplace":"Australia","dateOfBirth":"1986-04-23T00:00:00.000Z","debut":"2005-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Matt Basso is one of the few wrestlers left from RCW’s inception in 2005. He came in to Riot City along side his brother, former ally Chris Basso.\r\nDetermined to make a name for himself, the Giant used his height + power advantage to become the first ever RCW Champion, a championship he later lost to Kash Kourageous. He had notable feuds with Kash Kourageous and Damon Mathews until he turned his back on Chris and the fans in 2007 which sparked a massive rivalry between the two brothers.\r\nMatt was able to capture the championship Gold for a second time after defeating Chris in front of a sell out crowd at Rites Of Passage 2009.\r\nMatt has held notable feuds with Voodoo, Jacko Lantern, and Rocky Menero.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3130],"reco