,"productFit":100,"riskTaking":30,"matchLayout":75,"psychology":68,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":68,"characterCoaching":44,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":44,"brandBuilding":55,"socialMediaSavvy":27,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":57,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-620","wrestlerId":620,"promotionId":45,"startDate":"2020-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":622,"name":"B-Boy","realName":"B-Boy","picture":"B-Boy.jpg","ability":65,"currentAbility":56,"potentialAbility":56,"charisma":58,"micSkills":69,"popularity":3,"condition":88,"hardcoreAbility":59,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":91,"height":175,"base":"USA","birthplace":"United States","dateOfBirth":"1978-12-29T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Benjamin \"Benny\" Cuntapay is an American professional wrestler better known by his ring name, B–Boy. He was a wrestler for Wrestling Society X, wearing a mask as Delikado. After being trained by numerous wrestlers, including Christopher Daniels, Cuntapay began working on the independent circuit. Using the name Benny Chong, he quickly formed a tag team with \"Funky\" Billy Kim in Ultimate Pro Wrestling (UPW) known as \"The Manilla Thrillaz\". In late 2003, B-Boy began working primarily for Combat Zone Wrestling, Jersey All Pro Wrestling, and Pro Wrestling Guerrilla, however, he still made numerous appearances for Southern California independent promotions. On April 25, 2009 B-Boy made his first appearance in So*Cal Pro Wrestling. The last match he wrestled for So*Cal Pro was a defeat on May 19, 2012.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[476,2651,2718,2926,3095,3638],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":61,"productFit":80,"riskTaking":38,"matchLayout":63,"psychology":55,"workerManagement":80,"trainingIntensity":78,"technicalCoaching":56,"characterCoaching":55,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":55,"brandBuilding":36,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":16,"reactionSpeed":78,"consistency":78,"awareness":55,"judgement":65}},{"id":623,"name":"Sami Callihan","realName":"Sami Callihan","picture":"Sami Callihan.jpg","ability":54,"currentAbility":63,"potentialAbility":63,"charisma":75,"micSkills":61,"popularity":26,"condition":71,"hardcoreAbility":46,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":95,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1987-09-01T00:00:00.000Z","debut":"2006-03-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Some would call him a psychopath but Sami Callihan calls himself “The Draw”, claiming he’s the reason fans tune in to IMPACT Wrestling.\r\n\r\nThe former leader of Ohio vs Everything made a splash upon his arrival to IMPACT Wrestling at Bound for Glory 2017 and has been relentless ever since. Sami reached the pinnacle of success at IMPACT Wrestling when he defeated then champion Brian Cage on the debut of IMPACT on AXS TV in October 2019 to become the IMPACT World Champion.\r\n\r\nSami has since left his oVe members behind, revealing himself as the ICU hacker, using technology and mind games to get into the heads of his opponents. Sami is one of the toughest, most skilled competitors in the ring at IMPACT Wrestling, but he isn’t afraid to use his black baseball bat if somebody gets in his way to reclaiming the IMPACT World Championship.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1348,2158,2647,2667,2680,2681],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":61,"productFit":100,"riskTaking":25,"matchLayout":63,"psychology":56,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":54,"characterCoaching":75,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":75,"brandBuilding":45,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":80,"awareness":56,"judgement":74}},{"id":625,"name":"Adam Pearce","realName":"Adam Pearce","picture":"Adam Pearce.jpg","ability":62,"currentAbility":61,"potentialAbility":61,"charisma":50,"micSkills":56,"popularity":31,"condition":63,"hardcoreAbility":41,"injuryProne":100,"type":"manager","style":"all rounder","gender":"M","weight":110,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1978-06-24T00:00:00.000Z","debut":"1996-05-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Adam Pearce, is an American professional wrestler. Since his debut, he has become one of the most hated heel wrestlers on the independent circuit. He is a former five-time NWA World Heavyweight Champion and a one-time PWG World and NWA British Commonwealth Heavyweight Champion. Pearce had his debut match on May 16, 1996, a few weeks before he graduated from high school. Pearce quickly began wrestling for independent professional wrestling promotions, especially in Milwaukee and Wisconsin. On March 28, 2013 Pearce appeared on Impact Wrestling as it was announced that he would compete in a TNA Gut Check match against Magno.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":80,"productFit":100,"riskTaking":18,"matchLayout":81,"psychology":78,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":61,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":65,"brandBuilding":45,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":70,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-625","wrestlerId":625,"promotionId":64,"startDate":"2019-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":626,"name":"Tenille Dashwood","realName":"Tenille Dashwood","picture":"Emma.jpg","ability":65,"currentAbility":58,"potentialAbility":58,"charisma":67,"micSkills":64,"popularity":29,"condition":88,"hardcoreAbility":69,"injuryProne":100,"type":"wrestler","style":"technical","gender":"F","weight":60,"height":162,"base":"Australia","birthplace":"Australia","dateOfBirth":"1989-03-01T00:00:00.000Z","debut":"2005-07-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Tenille Dashwood, a 2007 graduate of the Storm Wrestling Academy, is an Australian wrestler who works in America, Canada, the British Isles, Europe and Oceania. She is a Small worker who is classed as using a Regular style. She is best known for her work with WWE, IMPACT, NXT, ROH and SHIMMER. She is the protege of Lance Storm.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2316,3540],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":63,"productFit":100,"riskTaking":24,"matchLayout":65,"psychology":58,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":60,"characterCoaching":67,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":67,"brandBuilding":62,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":70,"awareness":58,"judgement":75}},{"id":627,"name":"Super Dragon","realName":"Super Dragon","picture":"Super Dragon.jpg","ability":90,"currentAbility":87,"potentialAbility":87,"charisma":93,"micSkills":89,"popularity":4,"condition":70,"hardcoreAbility":67,"injuryProne":84,"type":"writer","style":"submission","gender":"M","weight":102,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1980-06-08T00:00:00.000Z","debut":"1994-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":true,"dead":false,"story":"Daniel Lyon, better known by his ring name Super Dragon, is an American professional wrestler. Beginning his career in 1997, he has competed in companies such as All Pro Wrestling, Revolution Pro, and Combat Zone Wrestling. Dragon is also one of the six owners of the Southern California based promotion Pro Wrestling Guerrilla. Super Dragon started training in 1996 in World Power Wrestling's wrestling school, where he was trained under owner Martin Marin. He had his first match in 1997 against Tiger Joe. Super Dragon became friends with Blitzkrieg, who during a tour of Mexico caught the eye of local wrestlers, such as Psicosis and Juventud Guerrera, who were also performing for World Championship Wrestling (WCW). Afterwards Blitzkrieg and Super Dragon were granted a dark match for WCW with the help of American Wild Child, who was friends with Konnan.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2761,3017,3095],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":77,"productFit":100,"riskTaking":46,"matc