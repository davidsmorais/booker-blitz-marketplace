site numbers in these matchups. As the Young Lion competition grew stronger, the Young Lion Cup was announced for the Road to Destruction tour, with Fredericks one of the eight entrants. Fredericks would go on to win the cup, certifying himself as one of the very top prospects in NJPW, regardless of Dojo affiliation.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":52,"storytelling":57,"productFit":49,"riskTaking":27,"matchLayout":58,"psychology":52,"workerManagement":49,"trainingIntensity":73,"technicalCoaching":60,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":58,"brandBuilding":71,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":10,"reactionSpeed":73,"consistency":61,"awareness":52,"judgement":51}},{"id":3277,"name":"Sal Rinauro","realName":"Sal Rinauro","picture":"Sal Rinauro.jpg","ability":63,"currentAbility":57,"potentialAbility":57,"charisma":70,"micSkills":59,"popularity":4,"condition":83,"hardcoreAbility":77,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":84,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1982-09-12T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Sal Rinauro is an American wrestler who works exclusively in America. He is a Lightweight who is classed as using a High Flyer style. He is best known for his work with NWA, ROH and IWA-MS.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2711],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":21,"matchLayout":66,"psychology":58,"workerManagement":10