etired":false,"dead":false,"story":"Federico Palacios is an American professional wrestler better known as Azrieal and for his appearences in the Northeast with some of the major American indy promotions like ROH, JAPW and CZW. On June 23, 2011, Palacios made an appearance on Total Nonstop Action Wrestling's Impact Wrestling television show, losing to Zema Ion in a three–way match, which also included Dakota Darsow.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[939,2652,2746,2991],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":44,"storytelling":49,"productFit":70,"riskTaking":47,"matchLayout":51,"psychology":44,"workerManagement":70,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":53,"mediaHandling":56,"brandBuilding":30,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":14,"reactionSpeed":73,"consistency":69,"awareness":44,"judgement":54}},{"id":761,"name":"DJ Hyde","realName":"DJ Hyde","picture":"DJ Hyde.jpg","ability":50,"currentAbility":46,"potentialAbility":46,"charisma":58,"micSkills":55,"popularity":3,"condition":64,"hardcoreAbility":29,"injuryProne":100,"type":"wrestler","style":"hardcore","gender":"M","weight":136,"height":190,"base":"USA","birthplace":"United States","dateOfBirth":"1978-03-01T00:00:00.000Z","debut":"2003-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"David Markland is an American professional wrestler best known as DJ Hyde. A graduate of the CZW Wrestling Academy, he debuted for CZW in 2003. He went on to have a memorable feud with Danny Havoc. He eventually went on to join the MBA (Maven Bentley Association) where he teamed frequently with Brain Damage. After the group disbanded D.J. went on to compete for the CZW Ironman championship which he has four-times in his career. For a short stint D.J. was released from CZW, But returned shortly after he acquired the company from its owner John Zandig. D.J. now wrestles and acts as the on-screen authority for CZW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":48,"storytelling":50,"productFit":100,"riskTaking":51,"matchLayout":50,"psychology":48,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":22,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":49,"mediaHandling":58,"brandBuilding":20,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":68,"awareness":48,"judgement":69}},{"id":762,"name":"Eddie Orengo","realName":"Eddie Orengo","picture":"Eddie Orengo.jpg","ability":66,"currentAbility":66,"potentialAbility":66,"charisma":76,"micSkills":51,"popularity":3,"condition":87,"hardcoreAbility":82,"injuryProne":100,"type":"referee","style":"all rounder","gender":"M","weight":76,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1987-04-18T00:00:00.000Z","debut":"2003-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Eddie Orengo is a retired American wrestler who works primarily as a referee. He is best known for his work with NXT and CZW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":65,"teams":[939],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":38,"storytelling":47,"productFit":77,"riskTaking":49,"matchLayout":50,"psychology":38,"workerManagement":77,"trainingIntensity":73,"technicalCoaching":44,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":51,"mediaHandling":58,"brandBuilding":38,"socialMediaSavvy":53,"ruleKnowledge":66,"positioning":68,"reactionSpeed":73,"consistency":70,"awareness":38,"judgement":54},"contract":{"id":"tew-contract-762","wrestlerId":762,"promotionId":65,"startDate":"2018-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333,"inDevelopment":true},{"id":763,"name":"Danny Havoc","realName":"Danny Havoc","picture":"Danny Havoc.jpg","ability":37,"currentAbility":42,"potentialAbility":42,"charisma":56,"micSkills":54,"popularity":4,"condition":71,"hardcoreAbility":43,"injuryProne":100,"type":"manager","style":"high flyer","gender":"M","weight":86,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1986-05-19T00:00:00.000Z","debut":"2005-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"Danny Havoc is a graduate of the CZW Wrestling Academy, he debuted for CZW in 2005. He went on to have a memorable feud with D.J. Hyde. Havoc slowly built a cult following of fans and won his first championship in 2007, when he won fiveway ladder match for the CZW Jr. Title. Not long after he won the seventh annual Tournament of Death in May of 2008. He was soon after given the Ultraviolent Underground Championship by his friend Drake Younger. He went on to feud with the freshly turned Necro Butcher. He has been feuding with Sami Callahan.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":50,"storytelling":53,"productFit":100,"riskTaking":45,"matchLayout":54,"psychology":50,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":38,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":55,"mediaHandling":56,"brandBuilding":35,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":68,"awareness":50,"judgement":70}},{"id":765,"name":"Drew Gulak","realName":"Drew Gulak","picture":"Drew Gulak.jpg","ability":70,"currentAbility":70,"potentialAbility":70,"charisma":72,"micSkills":85,"popularity":25,"condition":85,"hardcoreAbility":80,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":88,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1987-04-28T00:00:00.000Z","debut":"2005-04-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Drew Gulak is every bit as hard-nosed as the city he hails from, Philadelphia. \r\n\r\nA minimalist mutilator, what Gulak lacks in frills like kneepads or elbow pads he offsets with a completist’s arsenal of submission holds and suplexes, not to mention a lariat that can rip heads from shoulders, as his competition discovered in the inaugural WWE Cruiserweight Classic.\r\n\r\nBeing raised in Philly did more than toughen up Gulak; it also exposed the self-described “student of the game” to one of the world’s top wrestling hotbeds at a young age. Now an 11-year veteran of the sport, the old-school throwback emerged as one of the Cruiserweight Division’s most promising competitors.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[986,1087,2738],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":75,"storytelling":78,"productFit":100,"riskTaking":15,"matchLayout":79,"psychology":75,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":79,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":65,"brandBuilding":44,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":83,"awareness":75,"judgement":85}},{"id":767,"name":"Joe Gacy","realName":"Joe Gacy","picture":"Joe Gacy.jpg","ability":51,"currentAbility":55,"potentialAbility":55,"charisma":62,"micSkills":40,"popularity":32,"condition":85,"hardcoreAbility":40,"injuryProne":100,"type":"wrestler","style":"striker","gender":"M","weight":113,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1987-08-08T00:00:00.000Z","debut":"2007-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"A highly-decorated independent brawler since 2006, Joe Gacy has now fought his way into the competitive world of NXT and shown true grit in the 2021 NXT Breakout Tournament. Many an unfortunate opponent have felt the force of the burly brawler’s arsenal of chops, headbutts and an earth-shattering clothesline off the ropes. Without a doubt, anyone who gets in the way of tough-as-nails Gacy better count his teeth once the action is done.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1851,2808,3398],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":55,"storytelling":59,"productFit":100,"riskTaking":44,"matchLayout":60,"psychology":55,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":29,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":62,"brandBuilding":38,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":84,"awareness":55,"judgement":73}},{"id":768,"name":"Masada","realName":"Masada","picture":"Masada.jpg","ability":54,"currentAbility":64,"potentialAbility":64,"charisma":61,"micSkills":56,"popularity":3,"condition":69,"hardcoreAbility":46,"injuryProne":100,"type":"wrestler","style":"hardcore","gender":"M","weight":104,"height":185,"base":"USA","birthplace":"United States","dateOfBirth":"1981-06-16T00:00:00.000Z","debut":"2002-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Brigham Doane is an American professional wrestler. He is best known by his ring name Masada as well as well for his appearances in Ring of Honor, Full Impact Pro, NWA Wildside, and his tours with Big Japan Pro Wrestling. He has also wrestled matches for World Wrestling Entertainment and Total Nonstop Action Wrestling. Doane was first trained by Steve Oubre at the IWA training center in Orange, Texas and later by Rudy Roy Gonzalez and Shawn Michaels at the Texas Wrestling Academy. He then began his professional career by debuting in the Coastal States Wrestling Alliance (CSWA) before moving to Ring of Honor as a member of The Carnage Crew with HC Loc, DeVito, and later Justin Credible. Along with ROH, Masada wrestled for many other companies. He wrestled alongside Jared Steele and Delirious against 3 Live Kru in a dark match for TNA as well against Maven on WWE Heat. Masada also wrestled for IWA Mid-South, Full Impact Pro, and NWA Wildside.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2875],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":61,"storytelling":64,"productFit":100,"riskTaking":45,"matchLayout":65,"psychology":61,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":58,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":55,"mediaHandling":66,"brandBuilding":57,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":77,"awareness":61,"judgement":77}},{"id":769,"name":"The Blade","realName":"The Blade","picture":"Pepper Parks.jpg","ability":68,"currentAbility":65,"potentialAbility":65,"charisma":65,"micSkills":58,"popularity":22,"condition":70,"hardcoreAbility":65,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weig