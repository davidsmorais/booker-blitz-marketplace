n Pro Wrestling NOAH, as well as sporadic self-produced independent shows. Prior to that Nakajima participated in All Japan Pro Wrestling, where he is a former AJPW World Junior Heavyweight Champion.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":96,"teams":[1135,1775,1823,1905,3055,3215],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":79,"storytelling":81,"productFit":100,"riskTaking":32,"matchLayout":82,"psychology":79,"workerManagement":100,"trainingIntensity":88,"technicalCoaching":76,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":85,"brandBuilding":82,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":88,"consistency":76,"awareness":79,"judgement":87},"contract":{"id":"tew-contract-727","wrestlerId":727,"promotionId":96,"startDate":"2024-06-01T00:00:00.000Z","endDate":"2026-06-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-06-01T00:00:00.000Z","wage":1000},{"id":728,"name":"Shinichi Nakayama","realName":"Shinichi Nakayama","picture":"Shinichi Nakayama.jpg","ability":77,"currentAbility":70,"potentialAbility":70,"charisma":85,"micSkills":73,"popularity":1,"condition":100,"hardcoreAbility":88,"injuryProne":81,"type":"referee","style":"all rounder","gender":"M","weight":74,"height":162,"base":"Japan","birthplace":"Japan","dateOfBirth":"1960-04-03T00:00:00.000Z","debut":"1978-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Shinichi Nakayama is a former professional wrestler now currently working as a referee in Japan. He is most known for his appearances in Pro Wrestling NOAH.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":45,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history"