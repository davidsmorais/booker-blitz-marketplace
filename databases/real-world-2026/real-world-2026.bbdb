resentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Growing up in one of the most dangerous cities in America, Jordan Oliver has firsthand experience with the perils of the streets… and those streets have made him resourceful, hungry and able to out scrap anyone that gets into a fight with the Hudson Valley high flyer. A standout prospect, Oliver wrestled for Newburgh Free Academy in high school while the six-foot sensation moonlighted as a rookie grappler every weekend on the northeast wrestling circuit. Lighting up the competition with an electrifying arsenal of moves, the hard knocks Newburgh wrestler quickly caught the eye of league scouts. Representing the 845, the “Sauce God” is motivated to show the world he’s got the special ingredients to be a champion in the majors.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":49,"teams":[3603,3604,4158,4322,4323,4324,4325,4326],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":46,"storytelling":51,"productFit":100,"riskTaking":37,"matchLayout":53,"psychology":46,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":45,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":62,"brandBuilding":38,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":52,"awareness":46,"judgement":68},"contract":{"id":"tew-contract-3090","wrestlerId":3090,"promotionId":49,"startDate":"2026-01-16T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000,"inDevelopment":true},{"id":3091,"name":"Jacob Fatu","realName":"Jacob Fatu","picture":"Jacob Fatu.jpg","ability":58,"currentAbility":61,"potentialAbility":61,"charisma":54,"micSkills":62,"popularity":52,"condition":94,"hardcore