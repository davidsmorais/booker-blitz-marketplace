 Honda","realName":"Antonio Honda","picture":"Antonio Honda.jpg","ability":64,"currentAbility":64,"potentialAbility":64,"charisma":51,"micSkills":50,"popularity":4,"condition":83,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"powerhouse","gender":"M","weight":80,"height":165,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-01-02T00:00:00.000Z","debut":"2005-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"The third member of the “Italian Mafia” faction in DDT, Antonio Honda is also a regular in the promotion. Sporting a gimmick that seems to fall somewhere between a Lou Thesz knockoff and Tarzan, the 4-year pro alternates between teaming with his Italian mafia stablemates-who he has a UWA Trios Title reign and a KO-D Tag Team Title reign with-and generally appearing in opening and early card matches.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":103,"teams":[2892],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":75,"productFit":100,"riskTaking":13,"matchLayout":75,"psychology":73,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":61,"characterCoaching":78,"diagnosis":50,"rehabilitation":50,"prevention":87,"mediaHandling":78,"brandBuilding":31,"socialMediaSavvy":83,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":81,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-1454","wrestlerId":1454,"promotionId":103,"startDate":"2013-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1456,"name":"Daisuke Sasaki","realName":"Daisuke Sasaki","picture":"Daisuke Sasaki.jpg","ability":78,"currentAbility":68,"potentialAbility":68