ed":true,"retired":false,"dead":false,"story":"Acero is a Mexican luchador enmascarado, or masked professional wrestler currently working for the Mexican professional wrestling promotion Consejo Mundial de Lucha Libre (CMLL) in their Mini-Estrella division. Working in the Mini-Estrellas division does not necessarily mean that Acero is a dwarf as several wrestlers who are just shorter in stature work in the \"Mini\" division. Acero is Spanish for \"Steel\" and is a shortened version of his previous ring name Niño de Acero or \"Boy of Steel\". Acero's real name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":11,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":51,"storytelling":57,"productFit":75,"riskTaking":35,"matchLayout":59,"psychology":51,"workerManagement":75,"trainingIntensity":62,"technicalCoaching":49,"characterCoaching":41,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":41,"brandBuilding":30,"socialMediaSavvy":23,"ruleKnowledge":0,"positioning":15,"reactionSpeed":62,"consistency":60,"awareness":51,"judgement":61},"contract":{"id":"tew-contract-1918","wrestlerId":1918,"promotionId":11,"startDate":"2012-03-04T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":1919,"name":"Último Dragoncito","realName":"Último Dragoncito","picture":"Ultimo Dragoncito.jpg","ability":52,"currentAbility":61,"potentialAbility":61,"charisma":72,"micSkills":72,"popularity":2,"condition":63,"hardcoreAbility":60,"injuryProne":77,"type":"wrestler","style":"high flyer","gender":"M","weight":73,"height":154,"base":"Mexico","birthplace":"Mexico","dateOf