he was the first ever WWF Light Heavyweight Champion. Having held championship titles in Japan, North America, Mexico and Europe, Yoshida is known for his long title reigns. He held the FMW Independent World Junior Heavyweight Title for a combined duration of more than 15 months, the WWF Light Heavyweight Title for a then record-setting 10 months and the WEW Six-Man Tag Team Title for almost a year. Yoshida has held the AJPW World Junior Heavyweight Title, Michinoku Pro Tohoku Junior Heavyweight Title and Kaientai Dojo Strongest-K Title simultaneously for almost 10 months.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3293,3294],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":77,"storytelling":82,"productFit":100,"riskTaking":34,"matchLayout":83,"psychology":77,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":68,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":72,"brandBuilding":43,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":65,"awareness":77,"judgement":86}},{"id":356,"name":"Taichi","realName":"Taichi","picture":"Taichi.jpg","ability":59,"currentAbility":66,"potentialAbility":66,"charisma":78,"micSkills":59,"popularity":25,"condition":76,"hardcoreAbility":60,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":100,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1980-03-19T00:00:00.000Z","debut":"2002-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Taichi is a Japanese wrestler who works in America, Mexico and Japan. He is a Middleweight who is classed as using a Technician Flyer style. He is best known for his work with NJPW, CMLL, NOAH, AJPW and ZERO1. He is the protege of Toshiaki Kawada.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[1345,2086,3033,4241,4371],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":75,"storytelling":76,"productFit":100,"riskTaking":18,"matchLayout":77,"psychology":75,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":61,"characterCoaching":83,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":83,"brandBuilding":72,"socialMediaSavvy":76,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":72,"awareness":75,"judgement":85},"contract":{"id":"tew-contract-356","wrestlerId":356,"promotionId":38,"startDate":"2017-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":357,"name":"Kazushi Sakuraba","realName":"Kazushi Sakuraba","picture":"Kazushi Sakuraba.jpg","ability":70,"currentAbility":70,"potentialAbility":70,"charisma":56,"micSkills":83,"popularity":5,"condition":69,"hardcoreAbility":74,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":85,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1969-07-14T00:00:00.000Z","debut":"1993-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kazushi Sakuraba is a Japanese professional mixed martial artist and professional wrestler. He has competed in pro-wrestling for New Japan Pro Wrestling, UWFi and Kingdom Pro Wrestling. He has fought in MMA competition in the Ultimate Fighting Championship, PRIDE Fighting Championships, K-1 Hero's and Dream. He is known as the \"Gracie Hunter\" due to his wins over four members of the famed Gracie family including Royler Gracie, Renzo Gracie, Ryan Gracie, and Royce Gracie. In particular, Sakuraba is famous for his initial fight with Royce Gracie which lasted ninety minutes. After considering the mixed martial arts organization Pancrase, he ultimately chose the UWFi, a professional wrestling league that was nonetheless known for its highly technical and realistic-looking bouts. In 2008, it was announced that Kazushi Sakuraba would compete in the Middleweight Grand Prix of the new MMA promotion, Dream.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1163],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":75,"storytelling":78,"productFit":100,"riskTaking":21,"matchLayout":79,"psychology":75,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":79,"characterCoaching":64,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":64,"brandBuilding":62,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":73,"awareness":75,"judgement":85}},{"id":358,"name":"Katsuyori Shibata","realName":"Katsuyori Shibata","picture":"Katsuyori Shibata.jpg","ability":71,"currentAbility":76,"potentialAbility":76,"charisma":91,"micSkills":79,"popularity":33,"condition":66,"hardcoreAbility":71,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":95,"height":180,"base":"Japan","birthplace":"Japan","dateOfBirth":"1979-11-17T00:00:00.000Z","debut":"1999-10-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Katsuyori Shibata, a 1999 graduate of the New Japan Dojo, is a Japanese wrestler who works in America and Japan. He is a Middleweight who is classed as using a MMA Crossover style. He is best known for his work with NJPW. Outside of wrestling he is a former MMA fighter.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1082,1163,2976],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":80,"storytelling":83,"productFit":100,"riskTaking":47,"matchLayout":84,"psychology":80,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":80,"characterCoaching":65,"diagnosis":50,"rehabilitation":50,"prevention":53,"mediaHandling":65,"brandBuilding":78,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":75,"awareness":80,"judgement":88},"contract":{"id":"tew-contract-358","wrestlerId":358,"promotionId":76,"startDate":"2023-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":360,"name":"Ric Flair","realName":"Ric Flair","picture":"Ric Flair.jpg","ability":70,"currentAbility":64,"potentialAbility":64,"charisma":74,"micSkills":51,"popularity":60,"condition":39,"hardcoreAbility":50,"injuryProne":56,"type":"manager","style":"all rounder","gender":"M","weight":110,"height":177,"base":"USA","birthplace":"United States","dateOfBirth":"1949-02-25T00:00:00.000Z","debut":"1972-12-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"The unmistakable strut. The overdramatic flop. The flagrant low blow. The… \"Woooooooo!\" Such an animated performer like Ric Flair can't be encapsulated in words. He's a man of vibrant actions and endless sound bites. If Dean Malenko is \"The Man of 1,000 Holds,\" then Flair is absolutely \"The Man of 1,000 Faces\" – each one more flushed red with intensity than the last. There was a time when Flair didn't blaze through arenas like a fireball of charisma, but that was before he found his calling as \"The Nature Boy.\" Prior to stealing kisses, flying on jets and riding in limousines, the 16-time World Heavyweight Champion was an adopted, brown-haired kid in Minnesota with a chip on his shoulder.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3142,3270],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":98,"storytelling":99,"productFit":100,"riskTaking":63,"matchLayout":99,"psychology":98,"workerManagement":100,"trainingIntensity":23,"technicalCoaching":30,"characterCoaching":84,"diagnosis":50,"rehabilitation":50,"prevention":37,"mediaHandling":84,"brandBuilding":61,"socialMediaSavvy":79,"ruleKnowledge":0,"positioning":20,"reactionSpeed":23,"consistency":26,"awareness":98,"judgement":99}},{"id":363,"name":"Ultimo Dragon","realName":"Ultimo Dragon","picture":"Ultimo Dragon.jpg","ability":58,"currentAbility":68,"potentialAbility":68,"charisma":59,"micSkills":56,"popularity":30,"condition":64,"hardcoreAbility":63,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":83,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1966-12-12T00:00:00.000Z","debut":"1987-05-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":true,"retired":false,"dead":false,"story":"Ultimo Dragon is a masked Japanese wrestler who works in America, Canada, Mexico and Japan. He is a Lightweight who is classed as using a Technician Flyer style. He is best known for his work with WWE, NJPW, CMLL, AAA, Dragongate and AJPW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":76,"storytelling":83,"productFit":100,"riskTaking":15,"matchLayout":85,"psychology":76,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":76,"characterCoaching":48,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":48,"brandBuilding":66,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":62,"awareness":76,"judgement":86},"contract":{"id":"tew-contract-363","wrestlerId":363,"promotionId":14,"startDate":"2019-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":364,"name":"Suwama","realName":"Suwama","picture":"Suwama.jpg","ability":70,"currentAbility":70,"potentialAbility":70,"charisma":64,"micSkills":81,"popularity":7,"condition":59,"hardcoreAbility":58,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":120,"height":185,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-11-23T00:00:00.000Z","debut":"2004-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kohei Suwama is a Japanese professional wrestler also known simply as Suwama. He is best known for his work in All Japan Pro Wrestling as part of the Voodoo Murders stable. Suwama was scouted and recruited to All Japan Pro Wrestling by Hiroshi Hase, particularly because of his amateur wrestling background. He joined the All Japan Dojo on March 1, 2004, and teamed with All Japan president Keiji Mutoh early in his career. Suwama aligned himself with the Voodoo Murders stable on January 8, 2006, following an AJPW Triple Crown Championship match between Satoshi Kojima and stable leader TARU. Upon joining the group, he officially changed his name to Suwama, which translates to \"Suwa evil spirit\". In later 2012, Suwama formed the Last Revolution tag team with Joe Doering, which in March 2013 was also joined by Shuji Kondo.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[1049,1695,2694],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":80,"productFit":100,"riskTaking":20,"matchLayout":81,"psychology":78,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":58,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":56,"brandBuilding":65,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":76,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-364","wrestlerId":364,"promotionId":3,"startDate":"2026-01-25T00:00:00.000Z","endDate":"2028-01-25T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2028-01-25T00:00:00.000Z","wage":1000},{"id":365,"name":"Keiji Mutoh","realName":"Keiji Mutoh","picture":"Keiji Mutoh.jpg","ability":95,"currentAbility":97,"potentialAbility":97,"charisma":90,"micSkills":98,"popularity":28,"condition":53,"hardcoreAbility":90,"injuryProne":86,"type":"writer","style":"submission","gender":"M","weight":110,"height":185,"base":"Japan","birthplace":"Japan","dateOfBirth":"1962-12-23T00:00:00.000Z","debut":"1984-10-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Keiji Mutoh, a 1984 graduate of the New Japan Dojo, is a retired Japanese wrestler who works primarily as a road agent. He is best known for his work with WCW, NJPW, CMLL, NOAH, IMPACT, AJPW, Dragongate, DDT, PWG, ROH, ZERO1 and WRESTLE-1. He is married to someone outside the wrestling business. He was voted Wrestler Of The Year in 2001. He is part of the WWE Hall Of Fame.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":45,"teams":[1332,1414,1432,3056,3057],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":94,"storytelling":96,"productFit":100,"riskTaking":22,"matchLayout":96,"psychology":94,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":55,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":85,"brandBuilding":62,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":60,"awareness":94,"judgement":96},"contract":{"id":"tew-contract-365","wrestlerId":365,"promotionId":45,"startDate":"2024-05-01T00:00:00.000Z","endDate":"2026-05-01T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-05-01T00:00:00.000Z","wage":1000},{"id":366,"name":"Gregory Helms","realName":"Gregory Helms","picture":"Gregory Helms.jpg","ability":91,"currentAbility":84,"potentialAbility":84,"charisma":95,"micSkills":87,"popularity":16,"condition":68,"hardcoreAbility":96,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":98,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1974-07-12T00:00:00.000Z","debut":"1991-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Gregory Shane Helms is an American professional wrestler. He is best known for his time with World Wrestling Entertainment (WWE) where he wrestled as The Hurricane and Gregory Helms  and with World Championship Wrestling (WCW) as \"Sugar\" Shane Helms. Helms and his friend Shannon Moore signed with World Championship Wrestling (WCW) in May 1999. In WCW, Helms, along with Moore and Evan Karagias, formed the heel stable, 3 Count, and the trio debuted on the December 23 episode of WCW Thunder. Helms made his WWF debut on the July 5, 2001 episode of SmackDown!, using the name \"Hollywood\" Gregory Helms. Helms began wrestling on the independent circuit, including for the Canadian Wrestling Elite as Hurricane Helms.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":64,"teams":[106],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":22,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":58,"characterCoaching":74,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":74,"brandBuilding":65,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":72,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-366","wrestlerId":366,"promotionId":64,"startDate":"2020-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":367,"name":"Shannon Moore","realName":"Shannon Moore","picture":"Shannon Moore.jpg","ability":62,"currentAbility":54,"potentialAbility":54,"charisma":41,"micSkills":49,"popularity":5,"condition":82,"hardcoreAbility":58,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":170,"base":"USA","birthplace":"United States","dateOfBirth":"1979-07-27T00:00:00.000Z","debut":"1995-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Shannon Brian Moore is an American professional wrestler best known for his work with World Championship Wrestling (WCW) as a member of 3 Count, and for WWE, as a follower of Mattitude in 2003. He returned to WWE in 2006 on the ECW brand, before returning to SmackDown in 2007. On August 8, 2008, he was released from WWE. He is a former one time WCW Hardcore Champion. He is also former one time and inaugural WSW World Champion. Moore befriended Matt and Jeff Hardy as a child, and they later trained him to wrestle. He debuted in 1995, and competed for several North Carolina-based promotions. Aside from wrestling, Moore is also a tattoo artist, and owns a tattoo parlour known as Gas Chamber Ink in Southern Pines, North Carolina. He is also a musician, having written his own entrance music, and was part of the band Peroxwhy?gen with Jeff Hardy.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[106,3193],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":47,"storytelling":54,"productFit":100,"riskTaking":23,"matchLayout":57,"psychology":47,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":52,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":53,"brandBuilding":45,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":77,"awareness":47,"judgement":68}},{"id":368,"name":"Juventud Guerrera","realName":"Juventud Guerrera","picture":"Juventud Guerrera.jpg","ability":54,"currentAbility":58,"potentialAbility":58,"charisma":72,"micSkills":66,"popularity":17,"condition":74,"hardcoreAbility":38,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":80,"height":162,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1974-11-23T00:00:00.000Z","debut":"1992-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Eduardo Aníbal González Hernández, better known as Juventud Guerrera, is a Mexican professional wrestler who is best known for his work in many wrestling promotions worldwide, including all the major American wrestling promotions, such as World Wrestling Entertainment, World Championship Wrestling, Extreme Championship Wrestling and Total Nonstop Action Wrestling, as well as the major Mexican wrestling promotions Asistencia Asesoría y Administración and Consejo Mundial de Lucha Libre. In WCW, Guererra made his debut on August 26, 1996 edition of Monday Nitro in a victory over Billy Kidman. Prior to signing with WCW, he competed briefly in ECW. In the spring of 2005, Guerrera had signed a contract with World Wrestling Entertainment (WWE). He debuted on television, wrestling simply as Juventud, on June 18, 2005. On February 23, 2012, Guerrera returned to AAA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1127,3264,3265],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":44,"matchLayout":66,"psychology":58,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":65,"characterCoaching":77,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":77,"brandBuilding":64,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":35,"awareness":58,"judgement":75}},{"id":369,"name":"Psicosis","realName":"Psicosis","picture":"Nicho El Millionario.jpg","ability":48,"currentAbility":58,"potentialAbility":58,"charisma":45,"micSkills":44,"popularity":15,"condition":60,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":91,"height":180,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1971-05-19T00:00:00.000Z","debut":"1991-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Dionicio Castellanos Torres is a Mexican professional wrestler best known by the stage names Psychosis or Psicosis. He has performed for World Wrestling Entertainment, World Championship Wrestling, Extreme Championship Wrestling, Consejo Mundial de Lucha Libre, Total Nonstop Action Wrestling, Asistencia Asesoría y Administración and Xtreme Pro Wrestling. Castellanos debuted as \"El Salvaje,\" after being trained by Rey Misterio, Sr. and his brother, Fobia. Castellanos signed with World Championship Wrestling in 1996, anglicizing his name to \"Psychosis.\" Psychosis was released from a financially suffering WCW in the spring of 2000. In 2005, Castellanos signed a contract with World Wrestling Entertainment (WWE). Psicosis worked as \"Nicho el Millonario\" in Consejo Mundial de Lucha Libre (CMLL) up until 2007. On the March 3, 2007 televised episode of AAA, Psicosis came as Nicho and started a fight with Cibernético. On May 6 2012, Nicho returned to working under his old mask as Psicosis.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1127,1155,1222,1655,3264,3265,3266],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":33,"matchLayout":70,"psychology":63,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":60,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":68,"brandBuilding":49,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":57,"awareness":63,"judgement":78}},{"id":370,"name":"Scott Hall","realName":"Scott Hall","picture":"Scott Hall.jpg","ability":61,"currentAbility":71,"potentialAbility":71,"charisma":85,"micSkills":81,"popularity":46,"condition":74,"hardcoreAbility":87,"injuryProne":62,"type":"manager","style":"all rounder","gender":"M","weight":130,"height":198,"base":"USA","birthplace":"United States","dateOfBirth":"1958-10-20T00:00:00.000Z","debut":"1984-10-01T00:00:00.000Z","morale":"fair","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":true,"story":"Scott Oliver Hall is an American professional wrestler. In the course of his career, which has spanned three decades, Hall has wrestled for the American Wrestling Association, the National Wrestling Alliance, Total Nonstop Action Wrestling (TNA), World Class Championship Wrestling, World Championship Wrestling, Extreme Championship Wrestling (ECW), and the World Wrestling Federation. Reached his maximum fame as a nember of the nWo. Former professional wrestler, Diamond Dallas Page allowed Hall to stay at his place to stay sober and \"rebuild his life from the ground up... physically, mentally, professionally, and spiritually.\" Page also initiated a fundraising drive, which raised nearly $110,000 ($30,000 over their $80,000 goal) to pay for hip replacement surgery and dental work for Hall.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1486,3135,3218,3219,3220],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":85,"storytelling":86,"productFit":100,"riskTaking":38,"matchLayout":86,"psychology":85,"workerManagement":100,"trainingIntensity":31,"technicalCoaching":22,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":79,"brandBuilding":56,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":31,"consistency":24,"awareness":85,"judgement":91}},{"id":371,"name":"Scott Steiner","realName":"Scott Steiner","picture":"Scott Steiner.jpg","ability":53,"currentAbility":52,"potentialAbility":52,"charisma":64,"micSkills":53,"popularity":37,"condition":46,"hardcoreAbility":57,"injuryProne":56,"type":"wrestler","style":"striker","gender":"M","weight":125,"height":182,"base":"USA","birthplace":"United States","dateOfBirth":"1962-07-29T00:00:00.000Z","debut":"1986-01-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"It’s hard to believe that the Scott Steiner who ruled the tag ranks alongside his brother, Rick, and the Scott Steiner who later dubbed himself the “Big Bad Booty Daddy” were the same man. But in a career that spanned more than three decades, the collegiate standout from the University of Michigan dominated sports-entertainment as both an innovative member of The Steiner Brothers and a hulking, loudmouthed gym rat who bleached his hair white and reinvented himself as an aggressive ladies man known as “Big Poppa Pump.”\r\n\r\nForming one of sports-entertainment’s most celebrated tag teams with his brother, Rick, in 1989, Scott captured the WCW Tag Team Titles seven times and the United States Tag Team Titles once. The duo’s success was not entirely limited to the Atlanta-based organization. During their brief time in WWE in the early ’90s, the pair also won the WWE Tag Team Championships twice.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1113,1331,3271,3272,3273,3274,3275,3285],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":43,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":37,"characterCoaching":83,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":83,"brandBuilding":67,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":40,"awareness":62,"judgement":77}},{"id":372,"name":"Rick Steiner","realName":"Rick Steiner","picture":"Rick Steiner.jpg","ability":64,"currentAbility":57,"potentialAbility":57,"charisma":59,"micSkills":66,"popularity":17,"condition":51,"hardcoreAbility":56,"injuryProne":68,"type":"wrestler","style":"striker","gender":"M","weight":116,"height":180,"base":"USA","birthplace":"United States","dateOfBirth":"1961-03-09T00:00:00.000Z","debut":"1983-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Robert Rechsteiner better known by his ring name Rick Steiner, is an American professional wrestler. Steiner is best known for his appearances with the National Wrestling Alliance, World Championship Wrestling, World Wrestling Federation, and Total Nonstop Action Wrestling, both as a singles wrestler and one half of the tag team The Steiner Brothers with his younger brother, Scott. Rechsteiner was an amateur wrestling standout at the University of Michigan, where he placed second at the Big Ten Championships in 1983. He formed an early tag team with Sting in the UWF and was a charter member of the faction known as the Varsity Club along with Mike Rotunda and their manager Kevin Sullivan. In early 1989, his brother Scott began accompanying him to the ring and eventually, the two formed a tag team. During a title defense against the Outsiders during SuperBrawl VIII on February 22, the Steiner Brothers disbanded when Scott turned on Rick.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1331,3271,3272,3273,3274,3275],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":70,"productFit":100,"riskTaking":15,"matchLayout":71,"psychology":67,"workerManagement":100,"trainingIntensity":35,"technicalCoaching":42,"characterCoaching":62,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":62,"brandBuilding":33,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":35,"consistency":51,"awareness":67,"judgement":80}},{"id":373,"name":"Marty Jannetty","realName":"Marty Jannetty","picture":"Marty Jannetty.jpg","ability":49,"currentAbility":50,"potentialAbility":50,"charisma":38,"micSkills":37,"popularity":7,"condition":50,"hardcoreAbility":44,"injuryProne":69,"type":"wrestler","style":"technical","gender":"M","weight":104,"height":177,"base":"USA","birthplace":"United States","dateOfBirth":"1960-02-03T00:00:00.000Z","debut":"1984-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Fredrick Marty Jannetty is an American professional wrestler, best known for his time in the World Wrestling Federation as part of tag team The Rockers with partner Shawn Michaels, and later as a singles competitor. While in the WWF, he became a one time Intercontinental Champion and a one time Tag Team Champion with the 1-2-3 Kid, and headlined Survivor Series 1989. With Michaels, The Rockers became two time World Tag Team Champions in the American Wrestling Association. Joining forces with fellow rookie Shawn Michaels in late 1985. The two teamed as The Midnight Rockers. In 1988 the duo joined WWF. Now called simply The Rockers, Jannetty and Michaels popularity carried over from their stint in the AWA. Attempting to help settle their differences, Brutus Beefcake invited both on his interview segment \"The Barbershop\". Michaels and Jannetty appeared to reconcile, but then Michaels hit Jannetty with Sweet Chin Music and soon threw him through the set's plate glass window.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1478,1499],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":45,"storytelling":54,"productFit":100,"riskTaking":40,"matchLayout":57,"psychology":45,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":44,"characterCoaching":45,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":45,"brandBuilding":40,"socialMediaSavvy":23,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":66,"awareness":45,"judgement":67}},{"id":374,"name":"Dave Bautista","realName":"Dave Bautista","picture":"Batista.jpg","ability":55,"currentAbility":58,"potentialAbility":58,"charisma":48,"micSkills":70,"popularity":74,"condition":64,"hardcoreAbility":38,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":107,"height":195,"base":"USA","birthplace":"United States","dateOfBirth":"1969-01-18T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"great","prestige":"high","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Taming wild animals is best left to trained professionals. Taming “The Animal” is another matter entirely.\r\n\r\nIf Batista always appeared in control of his meteoric rise through the ranks of WWE, that’s because you’re not counting his tempestuous formative years. What would ultimately bring the 6-foot-6, 290-pound brute to the top was his ability to avoid the perils and violence all around him in his troubled youth.\r\n\r\nHe didn’t ask to be born into a rougher part of Washington, D.C., which delivered three early reality checks in the form of homicides committed on his parents’ front lawn. He cannot undo becoming estranged from his parents by age 17 or the assault charges he accrued and probation he served for unleashing his ferocious temper on two unruly patrons at a club where Batista worked as a bouncer.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3142],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":66,"productFit":100,"riskTaking":31,"matchLayout":67,"psychology":65,"workerManagement":100,"trainingIntensity":52,"technicalCoaching":33,"characterCoaching":79,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":79,"brandBuilding":86,"socialMediaSavvy":84,"ruleKnowledge":0,"positioning":20,"reactionSpeed":52,"consistency":58,"awareness":65,"judgement":79}},{"id":375,"name":"Masakatsu Funaki","realName":"Masakatsu Funaki","picture":"Masakatsu Funaki.jpg","ability":81,"currentAbility":71,"potentialAbility":71,"charisma":79,"micSkills":79,"popularity":5,"condition":62,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":84,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1969-03-13T00:00:00.000Z","debut":"1984-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Masaharu Funaki, best known under his stage name Masakatsu Funaki is a Japanese mixed martial artist and professional wrestler who wrestled in New Japan Pro Wrestling, PWFG, as well as the UWF. He is the co-founder of Pancrase, one of the first mixed martial arts organizations and non-rehearsed shoot wrestling promotions (following five years after the inception of Shooto but predating America's Ultimate Fighting Championship). Not only the organization's co-founder, Funaki was also one of Pancrase's most successful fighters to date, scoring submission victories over the likes of Ken Shamrock, Frank Shamrock, Guy Mezger, Yuki Kondo and Bas Rutten through the course of his 50-fight career. He is the only fighter in mixed martial arts to hold wins over both Shamrock brothers and Bas Rutten, and was the first man to win the King of Pancrase title twice.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":72,"storytelling":76,"productFit":100,"riskTaking":30,"matchLayout":78,"psychology":72,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":73,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":51,"brandBuilding":52,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":78,"awareness":72,"judgement":83}},{"id":376,"name":"Jun Akiyama","realName":"Jun Akiyama","picture":"Jun Akiyama.jpg","ability":68,"currentAbility":77,"potentialAbility":77,"charisma":79,"micSkills":88,"popularity":18,"condition":59,"hardcoreAbility":66,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":110,"height":185,"base":"Japan","birthplace":"Japan","dateOfBirth":"1969-10-09T00:00:00.000Z","debut":"1992-09-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jun Akiyama, a 1992 graduate of the AJPW Dojo, is a Japanese wrestler who works exclusively in Japan. He is a Middleweight who is classed as using a Impactful style. He is best known for his work with NOAH, DDT and AJPW. He is currently the DDT Extreme champion. He has been half of the Tag Team Of The Year three times. He was voted Young Wrestler Of The Year in 1993.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":12,"teams":[973,1566,2935],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":87,"storytelling":89,"productFit":100,"riskTaking":14,"matchLayout":90,"psychology":87,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":73,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":68,"brandBuilding":73,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":77,"awareness":87,"judgement":92},"contract":{"id":"tew-contract-376","wrestlerId":376,"promotionId":12,"startDate":"2021-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":377,"name":"Kaz Hayashi","realName":"Kaz Hayashi","picture":"Kaz Hayashi.jpg","ability":81,"currentAbility":85,"potentialAbility":85,"charisma":91,"micSkills":99,"popularity":8,"condition":75,"hardcoreAbility":82,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":83,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1973-05-18T00:00:00.000Z","debut":"1992-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Kazuhiro \"Kaz\" Hayashi is a Japanese professional wrestler. He gained fame in North America in WCW as one-half of the tag team The Jung Dragons with Jimmy Yang. For much of his early career, Hayashi wrestled in Michinoku Pro under a mask, using the name Shiryu (Growing Dragon in Japanese). As Shiryu, he was part of the memorable rudo group, Kaientai Deluxe, which waged war with Michinoku Pro's Sekigun for many years. After unmasking, Hayashi joined World Championship Wrestling (WCW) in 1998. Early on, he was relegated to a jobber and comedy character. He would be taken under the management of Sonny Onoo and even come to inherit Glacier's ceremonial armor and light show for a time. After returning to Japan, Hayashi eventually decided to join All Japan Pro Wrestling (AJPW) due to his friendship with Keiji Mutoh and established himself as one of their top stars.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":96,"teams":[1123,1353,2742,2947,2970,2971],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":74,"productFit":100,"riskTaking":26,"matchLayout":76,"psychology":69,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":68,"characterCoaching":54,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":54,"brandBuilding":54,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":79,"awareness":69,"judgement":81},"contract":{"id":"tew-contract-377","wrestlerId":377,"promotionId":96,"startDate":"2020-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":378,"name":"Osamu Nishimura","realName":"Osamu Nishimura","picture":"Osamu Nishimura.jpg","ability":80,"currentAbility":74,"potentialAbility":74,"charisma":61,"micSkills":62,"popularity":5,"condition":76,"hardcoreAbility":82,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":105,"height":182,"base":"Japan","birthplace":"Japan","dateOfBirth":"1971-09-23T00:00:00.000Z","debut":"1991-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"Osamu Nishimura is a Japanese professional wrestler. Nishimura formerly worked for New Japan Pro Wrestling and MUGA World Pro Wrestling. Nishimura debuted in 1991 after training in the NJPW Dojo. In 1994, he embarked on a tour of the United States, entering the Global Wrestling Federation and becoming a top contender for the vacant NWA World Heavyweight Championship. In the infamous tournament promoted by Extreme Championship Wrestling in August 1994 (which featured winner Shane Douglas throwing the belt down after winning it), Nishimura was eliminated in the first round by Dean Malenko. He returned to New Japan in 1998 and teamed with Shinya Hashimoto in the struggle against nWo Japan's Keiji Mutoh and Masahiro Chono. On October 20, 2007, Nishimura announced that he and trainee Manabu Soya had signed with All Japan Pro Wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":true,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":74,"productFit":100,"riskTaking":17,"matchLayout":77,"psychology":65,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":85,"characterCoaching":46,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":46,"brandBuilding":45,"socialMediaSavvy":37,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":83,"awareness":65,"judgement":79}},{"id":379,"name":"Shuji Kondo","realName":"Shuji Kondo","picture":"Shuji Kondo.jpg","ability":94,"currentAbility":85,"potentialAbility":85,"charisma":70,"micSkills":100,"popularity":5,"condition":73,"hardcoreAbility":70,"injuryProne":100,"type":"writer","style":"technical","gender":"M","weight":95,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-01-21T00:00:00.000Z","debut":"2001-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"upper","masked":false,"retired":false,"dead":false,"story":"Shuji Kondo is a Japanese professional wrestler. Prior to becoming a pro wrestler, he played rugby. Kondo was part of the T2P class in Toryumon. At first he was a face in the Toryumon Seikegun. Kondo was built up as the heel ace of the dragondoor promotion. He soon joined AJPW, where he and long-time associate \"brother\" YASSHI would ally themselves with TARU's Voodoo Murders stable and even hold the All-Asia Tag Team Titles for a short time. Kondo is also one of the main players in dragondoor's successor, El Dorado. Unlike in dragondoor, Kondo was set up to be the face ace of the promotion. On March 4, 2013, Kondo joined Suwama and Joe Doering as a member of the stable, LAST REVOLUTION.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":110,"teams":[1353,2947,3941,3942],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":75,"productFit":100,"riskTaking":24,"matchLayout":76,"psychology":70,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":67,"characterCoaching":48,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":48,"brandBuilding":50,"socialMediaSavvy":39,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":70,"awareness":70,"judgement":82},"contract":{"id":"tew-contract-379","wrestlerId":379,"promotionId":110,"startDate":"2025-07-22T00:00:00.000Z","endDate":"2027-07-22T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-07-22T00:00:00.000Z","wage":1000},{"id":380,"name":"Takao Omori","realName":"Takao Omori","picture":"Takao Omori.jpg","ability":70,"currentAbility":68,"potentialAbility":68,"charisma":76,"micSkills":78,"popularity":6,"condition":74,"hardcoreAbility":87,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":110,"height":187,"base":"Japan","birthplace":"Japan","dateOfBirth":"1969-10-16T00:00:00.000Z","debut":"1992-10-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Takao Omori is a Japanese professional wrestler.  He has competed in All Japan Pro Wrestling, Pro Wrestling Noah, Pro Wrestling ZERO 1 and New Japan Pro Wrestling. After being trained by Animal Hamaguchi, Omori debuted in All Japan Pro Wrestling, initially languishing in the mid-card and only able to get some recognition.  His first American venture was in the World Wrestling Federation, where he competed in the 1996 Royal Rumble, before being eliminated by the returning Jake Roberts. For an undisclosed reason, Omori called for an early ending to his singles bout with Shinya Hashimoto in the middle of their singles match at Noah's Great Voyage 2000 event, which was the company's most important event up to that point. Because of this, Omori was immediately in Misawa's doghouse. On August 16, 2008 Omori announced that he was leaving ZERO1-MAX and taking a break from pro wrestling.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1076,1566,2888,2889,2890],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":81,"productFit":100,"riskTaking":16,"matchLayout":82,"psychology":78,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":55,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":58,"brandBuilding":50,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":68,"awareness":78,"judgement":87}},{"id":381,"name":"Minoru Tanaka","realName":"Minoru Tanaka","picture":"Minoru Tanaka.jpg","ability":78,"currentAbility":72,"potentialAbility":72,"charisma":57,"micSkills":73,"popularity":7,"condition":65,"hardcoreAbility":91,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":76,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1972-11-29T00:00:00.000Z","debut":"1994-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Minoru Tanaka is a Japanese professional wrestler and shoot boxer. Minoru Tanaka was originally a shootboxer. He started his career as a wrestler in Fujiwara Gumi, trained by its owner, Yoshiaki Fujiwara. In late 1995 Tanaka and everyone else in the promotion abandoned Fujiwara and formed their own promotion, BattlARTS, led by Yuki Ishikawa. Tanaka made his New Japan Pro Wrestling debut on April 10, 1999 and would proceed to take part in Best of the Super Juniors in block B. In late 2002 Tanaka began wearing a mask and calling himself \"HEAT\" after the GBA video game Toukon Heat. After leaving New Japan on January 31, 2009, in a shocking move, Tanaka quickly signed with rival promotion All Japan Pro Wrestling in late February & made his presence felt by joining the hated \"VooDoo Murders\" stable. On December 21 2011, Tanaka along with Masakatsu Funaki and Masayuki Kono formed the stable Stack of Arms.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":96,"teams":[1125,2972,2973,2974,2975,3223],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":77,"storytelling":80,"productFit":100,"riskTaking":28,"matchLayout":81,"psychology":77,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":78,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":56,"brandBuilding":54,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":65,"awareness":77,"judgement":86},"contract":{"id":"tew-contract-381","wrestlerId":381,"promotionId":96,"startDate":"2020-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":382,"name":"Akira Raijin","realName":"Akira Raijin","picture":"Akira Raijin.jpg","ability":52,"currentAbility":57,"potentialAbility":57,"charisma":51,"micSkills":46,"popularity":3,"condition":76,"hardcoreAbility":52,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":106,"height":180,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-07-17T00:00:00.000Z","debut":"1998-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Akira Kawabata is a Japanese professional wrestler who has worked under a variety of names in various promotions; Akira Raijin, Akira, Kowabata, Kiyoshi and under the masked Suicide character in TNA briefly. Trained by former junior heavyweight contender Masanobu Kurisu, Kawabata made his debut in 1998, using the ring name Akira Raijin, competing primarily on the independent circuit. In 2004, he competed in All Japan Pro Wrestling for sometime with marginal success. In 2007, he left Japan to live in Windsor, Ontario, Canada with Scott D'Amore to gain \"learning experience\" in North America, where he competed for numerous independent promotions. Raijin returned to All Japan on June 22, 2008, but just three months later it was announced that he would be travelling back to North America, to compete for Total Nonstop Action Wrestling, who had signed him to a contract. On March 21, 2010, Raijin made another return to All Japan.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":33,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":54,"characterCoaching":51,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":51,"brandBuilding":59,"socialMediaSavvy":15,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":63,"awareness":58,"judgement":75}},{"id":383,"name":"Ryota Hama","realName":"Ryota Hama","picture":"Ryota Hama.jpg","ability":46,"currentAbility":42,"potentialAbility":42,"charisma":28,"micSkills":29,"popularity":4,"condition":72,"hardcoreAbility":60,"injuryProne":75,"type":"wrestler","style":"submission","gender":"M","weight":200,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1979-11-21T00:00:00.000Z","debut":"2008-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Ryota Hama is a retired Japanease sumo wrestler and current professional wrestler. Hama joined sumo in July 1995, and he fought for the Hakkaku stable run by former yokozuna Hokutoumi. His shikona was Hokutoarashi and he reached a highest rank of makushita 6 in November 2001. Injury-prone, he fell greatly in rank and announced his retirement in May 2008. His career record was 235 wins to 169 losses, with 114 absences due to injury. After retiring from sumo, Hama became a professional wrestler. Hama debuted in professional wrestling on November 3, 2008 losing to former Sumo champion Akebono. On September 23, 2009, Hama and Akebono, known collectively as SMOP (Super Megaton Ohzumo Powers), won the AJPW All Asia Tag Team Championship.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":7,"teams":[1734,1830],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":53,"storytelling":55,"productFit":100,"riskTaking":32,"matchLayout":56,"psychology":53,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":9,"characterCoaching":41,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":41,"brandBuilding":45,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":51,"consistency":61,"awareness":53,"judgement":72},"contract":{"id":"tew-contract-383","wrestlerId":383,"promotionId":7,"startDate":"2017-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":385,"name":"Go Shiozaki","realName":"Go Shiozaki","picture":"Go Shiozaki.jpg","ability":76,"currentAbility":75,"potentialAbility":75,"charisma":83,"micSkills":80,"popularity":11,"condition":56,"hardcoreAbility":64,"injuryProne":81,"type":"wrestler","style":"submission","gender":"M","weight":110,"height":180,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-01-21T00:00:00.000Z","debut":"2004-07-24T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Go Shiozaki is a Japanese professional wrestler who graduated from the NOAH Dojo. Shiozaki entered the Noah dojo in 2003 and according to the commentators from the event Universal Uproar, was the only man to graduate in his class as well as being the youngest wrestler on the roster. Following his debut, Shiozaki became a protégé of the legendary Kenta Kobashi. Shiozaki made his Ring of Honor debut during ROH's August 2006 tour of England. In July 2007, he wrestled Bryan Danielson in ROH's debut show in Tokyo, Japan. On January 26, 2013, Shiozaki, Atsushi Aoki, Jun Akiyama, Kotaro Suzuki and Yoshinobu Kanemaru, all of whom had quit Noah at the same time, announced that they had joined All Japan Pro Wrestling, forming the \"Burning\" stable.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[1810,1823,1905,3053],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":84,"storytelling":86,"productFit":100,"riskTaking":22,"matchLayout":86,"psychology":84,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":72,"characterCoaching":58,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":58,"brandBuilding":70,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":72,"awareness":84,"judgement":90},"contract":{"id":"tew-contract-385","wrestlerId":385,"promotionId":3,"startDate":"2025-10-11T00:00:00.000Z","endDate":"2027-10-11T00:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2027-10-11T00:00:00.000Z","wage":1000},{"id":386,"name":"NOSAWA Rongai","realName":"NOSAWA Rongai","picture":"NOSAWA.jpg","ability":93,"currentAbility":83,"potentialAbility":83,"charisma":96,"micSkills":88,"popularity":7,"condition":65,"hardcoreAbility":69,"injuryProne":100,"type":"writer","style":"all rounder","gender":"M","weight":93,"height":175,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-12-17T00:00:00.000Z","debut":"1995-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Kazushige Nosawa, better known by his ring names NOSAWA and NOSAWA Rongai, is a Japanese freelance professional wrestler, best known for his appearances in All Japan Pro Wrestling and various independent promotions. He was caught bringing drugs into Japan, bringing his future in wrestling (at least in Japan) into question. Mexico-based Japanese wrestler Takuya Sugi held a press conference on July 9 2012 and confessed to planting the drugs on Nosawa and Shirai. According to Sugi, the deed had been orchestrated by Masahiro Hayashi, who worked as a liaison between Japanese and Mexican promotions and who had a personal grudge with Nosawa.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":45,"teams":[1088,1540],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":65,"storytelling":67,"productFit":100,"riskTaking":27,"matchLayout":67,"psychology":65,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":54,"characterCoaching":69,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":69,"brandBuilding":50,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":67,"awareness":65,"judgement":79},"contract":{"id":"tew-contract-386","wrestlerId":386,"promotionId":45,"startDate":"2022-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":387,"name":"Manabu Soya","realName":"Manabu Soya","picture":"Manabu Soya.jpg","ability":69,"currentAbility":67,"potentialAbility":67,"charisma":79,"micSkills":61,"popularity":5,"condition":82,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":112,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1984-12-23T00:00:00.000Z","debut":"2007-04-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Manabu Soya is a Japanese professional wrestler loyal to All Japan Pro Wrestling. Another of the next generation of up-and-coming talent, Manabu Soya is a pro who debuted in spring 2007. Shortly after his debut on the indy scene, he followed mentor Osamu Nishimura to All Japan. He has participated in one World’s Strongest Tag League so far and more recently began teaming with Riki Choshu during the New Japan star’s appearances in All Japan. Soya left AJPW to train overseas. Upon his return, in 2011 to early 2012 Manabu Soya and All Japan veteran Takao Omori formed the team \"GET WILD\".","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":45,"teams":[1076,1325,2468,3058,4386],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":73,"productFit":100,"riskTaking":24,"matchLayout":74,"psychology":70,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":54,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":63,"brandBuilding":69,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":67,"awareness":70,"judgement":82},"contract":{"id":"tew-contract-387","wrestlerId":387,"promotionId":45,"startDate":"2020-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":388,"name":"Atsushi Aoki","realName":"Atsushi Aoki","picture":"Atsushi Aoki.jpg","ability":55,"currentAbility":61,"potentialAbility":61,"charisma":49,"micSkills":46,"popularity":5,"condition":86,"hardcoreAbility":73,"injuryProne":47,"type":"wrestler","style":"technical","gender":"M","weight":85,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1977-09-25T00:00:00.000Z","debut":"2005-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":true,"story":"Atsushi Aoki is a Japanese professional wrestler. Aoki won the Kanto Amaresu League in 2003, and followed up by joining the NOAH dojo in 2005. He has made strong progress. Aoki made his professional wrestling debut in 2005 and has worked primarily for Pro Wrestling Noah, where he was part of the Sternness group. Together with Go Shiozaki he held the AAA World Tag Team Championship which was his first professional wrestling championship ever. On January 26, 2013, Aoki, Go Shiozaki, Jun Akiyama, Kotaro Suzuki and Yoshinobu Kanemaru, all of whom had quit Noah at the same time, announced that they had joined All Japan Pro Wrestling, forming the \"Burning\" stable.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3022],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":65,"productFit":70,"riskTaking":44,"matchLayout":68,"psychology":58,"workerManagement":70,"trainingIntensity":78,"technicalCoaching":66,"characterCoaching":50,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":50,"brandBuilding":54,"socialMediaSavvy":38,"ruleKnowledge":5,"positioning":18,"reactionSpeed":78,"consistency":75,"awareness":58,"judgement":63}},{"id":389,"name":"Kotaro Suzuki","realName":"Kotaro Suzuki","picture":"Kotaro Suzuki.jpg","ability":61,"currentAbility":66,"potentialAbility":66,"charisma":74,"micSkills":73,"popularity":6,"condition":74,"hardcoreAbility":62,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":86,"height":167,"base":"Japan","birthplace":"Japan","dateOfBirth":"1978-06-18T00:00:00.000Z","debut":"2001-12-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kotaro Suzuki is a Japanese professional wrestler. Suzuki was the last person remaining of a grueling thirty person training class in Pro Wrestling Noah's dojo. He debuted on Noah's 2001 Christmas show. In 2005, he ended up adopting the guise of \"Mushiking Terry,\" a gimmick tying into the card/arcade game Mushiking: King of the Beetles, defeating \"Mushiking Joker\" in his debut at DESTINY 2005. On January 26, 2013, Suzuki, Atsushi Aoki, Go Shiozaki, Jun Akiyama and Yoshinobu Kanemaru, all of whom had quit Noah at the same time, announced that they had joined All Japan Pro Wrestling, forming the \"Burning\" stable.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":96,"teams":[1865,3050,3051,4278],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":73,"storytelling":78,"productFit":100,"riskTaking":18,"matchLayout":79,"psychology":73,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":71,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":61,"brandBuilding":55,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":73,"awareness":73,"judgement":84},"contract":{"id":"tew-contract-389","wrestlerId":389,"promotionId":96,"startDate":"2023-01-18T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":390,"name":"René Duprée","realName":"René Duprée","picture":"Rene Dupree.jpg","ability":67,"currentAbility":64,"potentialAbility":64,"charisma":65,"micSkills":57,"popularity":13,"condition":79,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":118,"height":187,"base":"Canada","birthplace":"Canada","dateOfBirth":"1983-12-15T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"René Goguen better known by his ring name René Duprée, is a Canadian professional wrestler. Goguen is best known for his tenure in World Wrestling Entertainment, where he is a one time World Tag Team Champion with Sylvain Grenier as the tag team La Résistance and a one time WWE Tag Team Champion with Kenzo Suzuki. Upon winning both titles, Goguen became the youngest wrestler in WWE history to win the World Tag Team Championship (at age 19) and the WWE Tag Team Championship (at age 20). His World Tag Team Championship win also made him the youngest man in WWE history to win any title. He is also the son of celebrated Canadian Maritimes wrestling promoter Emile Duprée. On June 22, 2008, Goguen debuted for All Japan Pro Wrestling as René Duprée and defeated Manabu Soya. During his short stint in 2008 he aligned himself with the Voodoo Murders stable where he teamed up with TARU mostly.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1036,1157,1291,2068,3062,3063],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":58,"storytelling":65,"productFit":100,"riskTaking":20,"matchLayout":67,"psychology":58,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":58,"characterCoaching":68,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":68,"brandBuilding":69,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":68,"awareness":58,"judgement":75}},{"id":391,"name":"SANADA","realName":"SANADA","picture":"Seiya Sanada.jpg","ability":70,"currentAbility":68,"potentialAbility":68,"charisma":79,"micSkills":75,"popularity":34,"condition":88,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"technical","gender":"M","weight":100,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1988-01-28T00:00:00.000Z","debut":"2007-03-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"SANADA is a Japanese wrestler who works in America, Canada, the British Isles and Japan. He is a Middleweight who is classed as using a Impactful style. He is best known for his work with NJPW, IMPACT, BJW, AJPW, WRESTLE-1 and CHIKARA.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[1325,1686],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":70,"storytelling":74,"productFit":100,"riskTaking":18,"matchLayout":75,"psychology":70,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":72,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":60,"brandBuilding":83,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":67,"awareness":70,"judgement":82},"contract":{"id":"tew-contract-391","wrestlerId":391,"promotionId":38,"startDate":"2016-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":392,"name":"Yoshinobu Kanemaru","realName":"Yoshinobu Kanemaru","picture":"Yoshinobu Kanemaru.jpg","ability":65,"currentAbility":68,"potentialAbility":68,"charisma":78,"micSkills":53,"popularity":18,"condition":77,"hardcoreAbility":56,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":85,"height":170,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-09-23T00:00:00.000Z","debut":"1996-07-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Yoshinobu Kanemaru, a 1996 graduate of the AJPW Dojo, is a Japanese wrestler who works in the British Isles and Japan. He is a Lightweight who is classed as using a Technician Flyer style. He is best known for his work with NJPW, NOAH, wXw and AJPW.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[1345,2043,3049,3050,3051],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":78,"storytelling":81,"productFit":100,"riskTaking":15,"matchLayout":82,"psychology":78,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":70,"characterCoaching":45,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":45,"brandBuilding":42,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":85,"awareness":78,"judgement":87},"contract":{"id":"tew-contract-392","wrestlerId":392,"promotionId":38,"startDate":"2017-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":393,"name":"KAI","realName":"KAI","picture":"KAI.jpg","ability":68,"currentAbility":61,"potentialAbility":61,"charisma":55,"micSkills":72,"popularity":6,"condition":90,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":100,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1983-05-20T00:00:00.000Z","debut":"2007-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Atsushi Sakai, better known as KAI, is a Japanese professional wrestler. Sakai was originally trained in professional wrestling at the All Japan Pro Wrestling (AJPW) dojo, before going on a learning excursion to Mexico, where he made his in-ring debut on February 22, 2007. Kai finally returned to his native country and All Japan Pro Wrestling in February 2008. He was quick to achieve his first accomplishment in his home promotion by winning the 2008 Junior League the following August. On September 6, 2009, Kai returned to Mexico to work events held by the Alianza Universal de Lucha Libre. In April 2011, Kai teamed up with former opponent, Kaz Hayashi, to win the 2011 Junior Tag League. On February 23, 2013, All Japan Pro Wrestling announced that Kai would be making his return to the ring and his debut as a heavyweight.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":14,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":64,"storytelling":70,"productFit":100,"riskTaking":31,"matchLayout":72,"psychology":64,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":62,"characterCoaching":56,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":56,"brandBuilding":52,"socialMediaSavvy":37,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":80,"awareness":64,"judgement":78},"contract":{"id":"tew-contract-393","wrestlerId":393,"promotionId":14,"startDate":"2018-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":394,"name":"KENSO","realName":"KENSO","picture":"KENSO.jpg","ability":47,"currentAbility":57,"potentialAbility":57,"charisma":66,"micSkills":56,"popularity":3,"condition":68,"hardcoreAbility":67,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":118,"height":187,"base":"Japan","birthplace":"Japan","dateOfBirth":"1974-07-25T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kenzo Suzuki is a Japanese professional wrestler. He is perhaps best known for his appearances with New Japan Pro Wrestling and in the United States with World Wrestling Entertainment. Suzuki debuted at New Japan Pro Wrestling's Wrestling World 2000 event at the Tokyo Dome, replacing Bill Goldberg. In 2003, Suzuki resigned from New Japan, choosing to follow his mentor and trainer, Riki Choshu, to Choshu's World Japan promotion. Later in the year, he left to wrestle in the United States. In 2004, Suzuki debuted for World Wrestling Entertainment (WWE)'s SmackDown! brand, along with his geisha valet (and real-life wife) Hiroko, whose trademark phrase was \"You cheer Kenzo Suzuki on to the victory!\". On July 25, 2010, Suzuki, disguised under a La Parka mask, made his debut for All Japan Pro Wrestling (AJPW), helping the Voodoo Murders put Keiji Mutoh through a table. Afterwards, Suzuki unmasked himself, adopted the ring name KENSO.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1142,1291,1432,3062],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":61,"productFit":100,"riskTaking":25,"matchLayout":62,"psychology":57,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":44,"characterCoaching":57,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":57,"brandBuilding":59,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":67,"awareness":57,"judgement":74}},{"id":395,"name":"Joe Doering","realName":"Joe Doering","picture":"Joe Doering.jpg","ability":67,"currentAbility":59,"potentialAbility":59,"charisma":52,"micSkills":52,"popularity":20,"condition":25,"hardcoreAbility":44,"injuryProne":51,"type":"wrestler","style":"striker","gender":"M","weight":135,"height":193,"base":"USA","birthplace":"United States","dateOfBirth":"1982-04-16T00:00:00.000Z","debut":"2004-12-01T00:00:00.000Z","morale":"poor","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":true,"story":"Joe Doering, who graduated from Can-Am Wrestling School on 01 December 2004, was an American wrestler who passed away on 26 June 2026. He is best known for his work with AJPW, TNA and NXT. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1036,1049,1784],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":72,"storytelling":75,"productFit":100,"riskTaking":22,"matchLayout":76,"psychology":72,"workerManagement":100,"trainingIntensity":36,"technicalCoaching":42,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":61,"brandBuilding":58,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":36,"consistency":72,"awareness":72,"judgement":83}},{"id":396,"name":"Jimmy Yang","realName":"Jimmy Yang","picture":"Jimmy Yang.jpg","ability":58,"currentAbility":63,"potentialAbility":63,"charisma":60,"micSkills":55,"popularity":8,"condition":81,"hardcoreAbility":73,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":93,"height":172,"base":"USA","birthplace":"United States","dateOfBirth":"1981-05-13T00:00:00.000Z","debut":"1999-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jimmy Wang Yang’s Fu Manchu mustache and cowboy hat resembled a redneck costume you’d find at a party store, which was fitting, considering Halloween helped him get a foot in the sports-entertainment door. When Yang was a teenager, he and his buddies trick-or-treated at every house in suburban Georgia until they found Diamond Dallas Page’s. Yang stayed in touch with DDP throughout high school, and a week after graduation, he was training in WCW’s famed Power Plant. In the final days of WCW, Yang formed The Jung Dragons with Kaz Hayashi and Jamie Noble in the revived Cruiserweight division before joining WWE as Akio, one of Tajiri’s high-flying henchmen.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[1123,2853,2971,3193],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":63,"productFit":100,"riskTaking":25,"matchLayout":65,"psychology":56,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":60,"characterCoaching":71,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":71,"brandBuilding":40,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":68,"awareness":56,"judgement":74}},{"id":397,"name":"Hikaru Sato","realName":"Hikaru Sato","picture":"Hikaru Sato.jpg","ability":68,"currentAbility":62,"potentialAbility":62,"charisma":77,"micSkills":66,"popularity":5,"condition":78,"hardcoreAbility":72,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":92,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1980-07-08T00:00:00.000Z","debut":"2008-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Hiroaki Sato is a Japanese professional wrestler and mixed martial artist, better known by the ring name Hikaru Sato. Sato started his MMA career in February 2000, fighting for Pancrase Hybrid Wrestling. During the next eight years, Sato fought, on average, five times a year, compiling a record of 18 wins, 19 losses and four draws. In May 2008, Sato transitioned into the world of professional wrestling, when he was signed by the Dramatic Dream Team (DDT) promotion. He has since had only five MMA fights. On November 3, 2010, Sato reunited with Michael Nakazawa and Tomomitsu Matsunaga as the Shit Heart?Foundation to defeat The Great Kojika, Mr. #6 and Riho for the DDT Jiyugaoka Six-Person Tag Team.  On January 3, 2013, Sato made another appearance for All Japan, when he and Yamato came together to challenge the Junior Stars of Koji Kanemoto and Minoru Tanaka to a match for the AJPW All Asia Tag Team Championship.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[2882,3595,3740,3741],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":57,"storytelling":64,"productFit":100,"riskTaking":26,"matchLayout":66,"psychology":57,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":78,"characterCoaching":53,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":53,"brandBuilding":58,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":62,"awareness":57,"judgement":74},"contract":{"id":"tew-contract-397","wrestlerId":397,"promotionId":3,"startDate":"2010-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":400,"name":"Cuervo","realName":"Cuervo","picture":"Dark Cuervo.jpg","ability":62,"currentAbility":60,"potentialAbility":60,"charisma":67,"micSkills":45,"popularity":6,"condition":80,"hardcoreAbility":50,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":87,"height":170,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1974-01-04T00:00:00.000Z","debut":"1993-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Jaime Ignacio Tirado Correa  is a Mexican Luchador who is best known as Cuervo / Dark Cuervo, a heel character that works for Asistencia Asesoría y Administración (AAA) and has been part of The Black Family since it was formed in 2001 when Charly Manson formed the stable. Jaime Correa trained under Dos Caras and Impala before making his wrestling debut in 1996. Correa debuted as El Cuervo (Spanish for \"The Raven\"), a Goth inspired character complete with white face paint and black markings. In the early parts of 2001 El Cuervo teamed up with other four other wrestlers that all used a similar gimmick, look and attitude as Cuervo to form the stable the Black Family. The other wrestlers were Charly Manson, Escoria and Ozz. On August 18, 2012, the former members of La Secta came together with former leader Cibernético's stable Los Bizarros to form La Secta Bizarra Cibernetica.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[948,1159,1917,1918],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":67,"storytelling":69,"productFit":100,"riskTaking":26,"matchLayout":70,"psychology":67,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":56,"characterCoaching":63,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":63,"brandBuilding":55,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":57,"awareness":67,"judgement":80}},{"id":401,"name":"Ozz","realName":"Ozz","picture":"Dark Ozz.jpg","ability":62,"currentAbility":64,"potentialAbility":64,"charisma":77,"micSkills":52,"popularity":5,"condition":86,"hardcoreAbility":60,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":98,"height":177,"base":"Mexico","birthplace":"Mexico","dateOfBirth":"1975-01-30T00:00:00.000Z","debut":"1996-01-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Marcos Tinajero is a Mexican Luchador who is most well known under the name Ozz / Dark Ozz, a Face character that works for Asistencia Asesoría y Administración (AAA). He has been part of The Black Family since it was formed. During his time in the Black Family Ozz has been a member of Lucha Libre Latina (LLL) and La Secta del Mesías, its predecessor La Secta Cibernetica and La Legión Extranjera but now the Black Family is its own independent entity. After training under one of Mexico's most prolific wrestling trainers, Jorge \"Skayde\" Rivera, Marcos Tinajero made his debut in 1996. In the early parts of 2001 Tinajero made a radical change both to his appearance, his gimmick and his alignment as a wrestler. Gone was the masked, high flying, fan friendly Path Finder, instead he was reinvented as the face paint wearing, dark, Goth looking villain called Ozz.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[948],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":72,"productFit":100,"riskTaking":22,"matchLayout":73,"psychology":68,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":63,"characterCoaching":80,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":80,"brandBuilding":65,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":67,"awareness":68,"judgement":81}},{"id":402,"name":"Tomoaki Honma","realName":"Tomoaki Honma","picture":"Tomoaki Honma.jpg","ability":64,"currentAbility":62,"potentialAbility":62,"charisma":73,"micSkills":53,"popularity":14,"condition":49,"hardcoreAbility":66,"injuryProne":90,"type":"wrestler","style":"striker","gender":"M","weight":95,"height":177,"base":"Japan","birthplace":"Japan","dateOfBirth":"1976-11-18T00:00:00.000Z","debut":"1997-05-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Tomoaki Honma, a 1997 graduate of the Animal Hamaguchi Gym, is a Japanese wrestler who works exclusively in Japan. He is a Middleweight who is classed as using a Brawler style. He is best known for his work with NJPW, NOAH, BJW, AJPW and ZERO1. He is married to someone outside the wrestling business.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":38,"teams":[1084,3044],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":75,"storytelling":75,"productFit":100,"riskTaking":33,"matchLayout":75,"psychology":75,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":40,"characterCoaching":80,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":80,"brandBuilding":54,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":49,"awareness":75,"judgement":85},"contract":{"id":"tew-contract-402","wrestlerId":402,"promotionId":38,"startDate":"2013-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":403,"name":"Masayuki Kono","realName":"Masayuki Kono","picture":"Masayuki Kono.jpg","ability":56,"currentAbility":58,"potentialAbility":58,"charisma":58,"micSkills":60,"popularity":5,"condition":76,"hardcoreAbility":41,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":115,"height":190,"base":"Japan","birthplace":"Japan","dateOfBirth":"1980-04-12T00:00:00.000Z","debut":"2003-03-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Masayuki Kono, is a Japanese  retired mixed martial artist and professional wrestler. Kono trained in the All Japan Dojo and made his debut on March 28, 2003 in a losing effort to Nobutaka Araya. In early 2005, Kono began a MMA career fighting for Pancrase Hybrid Wrestling. By early 2009, Kono ended his MMA career and returned to professional wrestling. He spent the first few months of 2009 in Canada, wrestling on the independents before finally returning to All Japan in May 2009. On January 3, 2011, KONO and KENSO challenged Taiyo Kea and Akebono for the AJPW World Tag Team Titles but lost. On January 4, 2012, Kono made a special appearance for New Japan Pro Wrestling at Wrestle Kingdom VI in Tokyo Dome.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":56,"storytelling":61,"productFit":100,"riskTaking":31,"matchLayout":63,"psychology":56,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":54,"characterCoaching":39,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":39,"brandBuilding":37,"socialMediaSavvy":37,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":69,"awareness":56,"judgement":74},"contract":{"id":"tew-contract-403","wrestlerId":403,"promotionId":3,"startDate":"2022-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":404,"name":"Kenny Omega","realName":"Kenny Omega","picture":"Kenny Omega.jpg","ability":80,"currentAbility":80,"potentialAbility":80,"charisma":93,"micSkills":74,"popularity":61,"condition":61,"hardcoreAbility":78,"injuryProne":100,"type":"wrestler","style":"high flyer","gender":"M","weight":99,"height":180,"base":"Canada","birthplace":"Canada","dateOfBirth":"1983-10-16T00:00:00.000Z","debut":"2000-02-01T00:00:00.000Z","morale":"good","prestige":"mid","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Kenny Omega is a Canadian wrestler who works in America, Canada, Mexico, the British Isles and Japan. He is a Middleweight who is classed as using a Technician Flyer style. He is best known for his work with NJPW, AEW, AAA, IMPACT, DDT, PWG, AJPW, ROH and Ice Ribbon. He is currently an AEW World Trios champion and the IWGP United States Heavyweight champion. He has been voted Wrestler Of The Year two times.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[1078,1079,1968,2706],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":86,"storytelling":87,"productFit":100,"riskTaking":15,"matchLayout":87,"psychology":86,"workerManagement":100,"trainingIntensity":92,"technicalCoaching":79,"characterCoaching":85,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":85,"brandBuilding":86,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":92,"consistency":91,"awareness":86,"judgement":92},"contract":{"id":"tew-contract-404","wrestlerId":404,"promotionId":76,"startDate":"2019-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":4333,"type":"exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":4333},{"id":405,"name":"Tsuyoshi Kikuchi","realName":"Tsuyoshi Kikuchi","picture":"Tsuyoshi Kikuchi.jpg","ability":64,"currentAbility":58,"potentialAbility":58,"charisma":45,"micSkills":65,"popularity":5,"condition":74,"hardcoreAbility":45,"injuryProne":100,"type":"wrestler","style":"all rounder","gender":"M","weight":90,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1964-11-21T00:00:00.000Z","debut":"1988-02-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":true,"dead":false,"story":"Tsuyoshi Kikuchi is a professional wrestler. He has previously worked for All Japan Pro Wrestling and Pro-Wrestling NOAH. Kikuchi idolized and patterned his style after the Dynamite Kid. Kikuchi turned pro on February 26, 1988, his debut was against veteran wrestler Mitsuo Momota. On May 25, 1992 Kikuchi and Kobashi would once again challenge Furnas and Kroffat for the All Asia Tag Team Titles and this time would be victorious as Kikuchi would win his first title. Kikuchi debuted for NOAH at their first show on August 5, 2000. After leaving NOAH, Kikuchi became a freelancer doing shows for All Japan and Dragon Gate. On September 20, 2010, Kikuchi challenged Kaz Hayashi for the AJPW World Junior Heavyweight Championship but lost.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[3311,3312],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":63,"storytelling":71,"productFit":100,"riskTaking":19,"matchLayout":74,"psychology":63,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":56,"characterCoaching":45,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":45,"brandBuilding":33,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":62,"awareness":63,"judgement":78}},{"id":406,"name":"Daisuke Sekimoto","realName":"Daisuke Sekimoto","picture":"Daisuke Sekimoto.jpg","ability":81,"currentAbility":74,"potentialAbility":74,"charisma":71,"micSkills":74,"popularity":12,"condition":67,"hardcoreAbility":87,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":120,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1981-02-09T00:00:00.000Z","debut":"1999-08-10T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Daisuke Sekimoto  is a Japanese  professional wrestler. He despite starting for BJW, a notorious death match company, has become one of the worlds greatest traditional wrestlers. He's proven himself in many companies outside of his homebase, and has even made way into America and Europe. He is a former six-time BJW Tag Team Champion, as well as a former NWA United National Heavyweight Champion in ZERO1-MAX. He lost the title to his partner Yoshihito Sasaki on November 13, 2007. Sekimoto and Okabayashi, under the name Strong BJ, debuted for All Japan Pro Wrestling on January 3, 2011. Sekimoto was part of Team Big Japan, which also included Kankuro Hoshino and Yuji Okabayashi, to take part in Chikara's King Of Trios 2010.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":3,"teams":[1241,1733,2303,2403,4155],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":75,"storytelling":78,"productFit":100,"riskTaking":27,"matchLayout":79,"psychology":75,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":65,"characterCoaching":61,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":61,"brandBuilding":65,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":80,"awareness":75,"judgement":85},"contract":{"id":"tew-contract-406","wrestlerId":406,"promotionId":3,"startDate":"2025-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":407,"name":"Yuji Okabayashi","realName":"Yuji Okabayashi","picture":"Yuji Okabayashi.jpg","ability":61,"currentAbility":69,"potentialAbility":69,"charisma":54,"micSkills":55,"popularity":6,"condition":89,"hardcoreAbility":55,"injuryProne":100,"type":"wrestler","style":"submission","gender":"M","weight":120,"height":172,"base":"Japan","birthplace":"Japan","dateOfBirth":"1982-10-31T00:00:00.000Z","debut":"2008-06-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"heel","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Yuji Okabayashi is a Japanese pro wrestler for Big Japan Pro Wrestling. Much like his trainer Daisuke Sekimoto, Yuji is much more of a traditional wrestler then most of his BJW counterparts. Him, along with Sekimoto, has had a great deal of tag team success, not only in BJW but also Zero-One and All Japan Pro Wrestling. Yuji is a stand out for BJWs new Strong division.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":7,"teams":[1733,2403,2437,2438,2439],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":69,"storytelling":73,"productFit":100,"riskTaking":29,"matchLayout":75,"psychology":69,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":60,"characterCoaching":66,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":66,"brandBuilding":60,"socialM