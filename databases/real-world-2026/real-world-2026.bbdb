1970-07-02T00:00:00.000Z","debut":"1989-11-01T00:00:00.000Z","morale":"broken","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"Scott Ronald \"Scotty\" Garland is an American firefighter and professional wrestler. He is best known for his appearances with the World Wrestling Federation/World Wrestling Entertainment under the ring names Scott Taylor (1991-1999) and Scotty 2 Hotty (1999-2007). During his WWF/WWE career, Garland held the WWF World Tag Team Championship, WWE Tag Team Championship and WWF Light Heavyweight Championship.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":76,"teams":[2826],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":68,"storytelling":72,"productFit":100,"riskTaking":14,"matchLayout":73,"psychology":68,"workerManagement":100,"trainingIntensity":59,"technicalCoaching":53,"characterCoaching":72,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":72,"brandBuilding":38,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":59,"consistency":62,"awareness":68,"judgement":81},"contract":{"id":"tew-contract-2242","wrestlerId":2242,"promotionId":76,"startDate":"2023-12-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":1000,"bookingsPerMonth":4,"type":"non-exclusive","status":"active","autoRenew":false},"contractExpiryDate":"2026-03-31T23:00:00.000Z","wage":1000},{"id":2244,"name":"Shayna Baszler","realName":"Shayna Baszler","picture":"Shayna Baszler.jpg","ability":64,"currentAbility":62,"potentialAbility":62,"charisma":68,"micSkills":48,"popularity":38,"condition":87,"hardcoreAbility":43,"injuryProne":100,"type":"wrestler","style":"submission","gender":"F","weight":62,"height":167,"base":"USA","birthplace":"United States","dateOfBirth":"1980-08-08T00:00:00.000Z","debut":"2015-09-01T00:00:00.000Z","morale":"fair","prestige":"low","presentation":"face","cardPosition":"lower","masked":false,"retired":false,"dead":false,"story":"There are plenty of tough women in WWE, but only one of them used to fight in a cage for a living.\r\n\r\nThe Queen of Spades is one of the true pioneers of women’s MMA, as well as a member of the MMA Four Horsewomen faction alongside the likes of Ronda Rousey. A devotee of catch wrestling, a time-tested, hybrid form of grappling, Baszler trained extensively under former UFC Heavyweight Champion Josh Barnett and even studied under U.K. wrestling legend Billy Robinson, continuing a rich combat lineage that counts no less than “The God of Wrestling,” Karl Gotch, in its ranks.\r\n\r\nAfter vanquishing many a foe inside the octagon, The Submission Magician chose to apply her martial craft to the squared circle. She made her auspicious WWE debut in the inaugural Mae Young Classic, dominating opponents with punishing strikes and suffocating submissions to advance all the way to the tournament final.","alterEgos":[],"managerId":0,"acceptsIndieBookings":false,"promotionId":null,"teams":[2340,3739,4111,4143],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"staffAttributes":{"bookingLogic":62,"storytelling":65,"productFit":100,"riskTaking":22,"matchLayout":66,"psychology":62,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":69,"characterCoaching":60,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":60,"brandBuilding":64,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":80,"awareness":62,"judgement":77}},{"id":2246,"name":"John Laurinaitis","realName":"John Laurinaitis","picture":"John Laurinaitis.jpg","ability":45,"currentAbility":45,"potentialAbility":45,"charisma":42,"micSkills":52,"popularity":27,"condition":48,"hardcoreAbility":55,"injuryProne":68,"type":"wrestler","style":"all rounder","gender":"M","weight":114,"height":187,"base":"USA","birthplace":"United States","dateOfBirt