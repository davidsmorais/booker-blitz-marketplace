so known by the name Luster the Legend. He participated in the 2012 edition of TNA Gut Check, held in Bakersfield, California. In addition to the TNA Gut Check, Luster made a brief appearance on TNA's Impact Wrestling, facing \"The Cowboy\" James Storm. Luster remains an independent wrestler, working shows in the western United States promotions. He is also one half of the tag team known as Reno Scum with Adam Thornstowe.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[591,1293,1680],"staffAttributes":{"bookingLogic":49,"storytelling":55,"productFit":40,"riskTaking":43,"matchLayout":57,"psychology":49,"workerManagement":40,"trainingIntensity":62,"technicalCoaching":38,"characterCoaching":53,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":53,"brandBuilding":52,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":8,"reactionSpeed":62,"consistency":67,"awareness":49,"judgement":45},"picture":"Luster the Legend.png"},{"id":1950,"name":"Riea Von Slasher","realName":"Riea Von Slasher","nickname":"","type":"wrestler","base":"Canada","gender":"F","weight":176,"height":165,"dateOfBirth":"1988-06-18T00:00:00.000Z","debut":"2003-06-01T00:00:00.000Z","wage":37500,"popularity":0,"charisma":40,"micSkills":51,"condition":100,"hardcoreAbility":55,"injuryProne":100,"ability":43,"currentAbility":40,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Raeannon Irene Elizabeth Allemeersch  is a female Canadian professional wrestler better known by the name Riea Von Slasher. Riea broke into the wrestling business at a young age. She started training the day after her 14th birthday and wrestled under the name Pyro. As Pyro, she made her debut in 2003 and wrestled against men for the most part at the beginning.","alterEgos":[],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2943],"staffAttributes":{"bookingLogic":51,"storytelling":58,"productFit":100,"riskTaking":44,"matchLayout":60,"psychology":51,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":43,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":54,"brandBuilding":34,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":52,"awareness":51,"judgement":71},"picture":"Riea Von Slasher.png"},{"id":1951,"name":"Cremator Von Slasher","realName":"Cremator Von Slasher","nickname":"","type":"wrestler","base":"Canada","gender":"M","weight":289,"height":205,"dateOfBirth":"1983-03-26T00:00:00.000Z","debut":"2001-09-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":69,"micSkills":60,"condition":83,"hardcoreAbility":41,"injuryProne":100,"ability":60,"currentAbility":51,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Cody Washington is a Canadian professional wrestler better known by the names Cremator Von Slasher and Cremator. He was a part of the faction \"The Von Slasher Family\" along with Riea Von Slasher and Rigour Von Slasher.","alterEgos":["The Cremator"],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2943],"staffAttributes":{"bookingLogic":56,"storytelling":65,"productFit":70,"riskTaking":42,"matchLayout":68,"psychology":56,"workerManagement":70,"trainingIntensity":74,"technicalCoaching":46,"characterCoaching":62,"teaching":20,"diagnos