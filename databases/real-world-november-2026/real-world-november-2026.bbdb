","type":"manager","base":"Japan","gender":"F","weight":128,"height":152,"dateOfBirth":"1989-12-26T00:00:00.000Z","debut":"2006-07-01T00:00:00.000Z","wage":66000,"popularity":2,"charisma":58,"micSkills":34,"condition":91,"hardcoreAbility":35,"injuryProne":100,"ability":58,"currentAbility":55,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Sachiko Jumonji is a Japanese professional wrestler, better known by the ring name Sendai Sachiko. She was trained by Meiko Satomura and has worked for her Sendai Girls' Pro Wrestling promotion since her debut in July 2006. Her older sister Chisako is also a professional wrestler, working under the ring name Dash Chisako, and together the two have held Ice Ribbon's International Ribbon Tag Team Championship and JWP Joshi Puroresu's JWP and Daily Sports Women's Tag Team Championships, while also having won the latter's 2013 Tag League the Best tournament.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1698],"staffAttributes":{"bookingLogic":62,"storytelling":70,"productFit":40,"riskTaking":38,"matchLayout":73,"psychology":62,"workerManagement":40,"trainingIntensity":72,"technicalCoaching":68,"characterCoaching":69,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":69,"brandBuilding":42,"socialMediaSavvy":46,"ruleKnowledge":52,"positioning":50,"reactionSpeed":72,"consistency":73,"awareness":62,"judgement":53},"picture":"Sendai Sachiko.png"},{"id":1956,"name":"Luciferno","realName":"Hooligan","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":216,"height":172,"dateOfBirth":"1972-01-11T00:00:00.000Z","debut":"1989-12-01T00:00:00.000Z","wage":480