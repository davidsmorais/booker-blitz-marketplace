00,"riskTaking":29,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":52,"characterCoaching":53,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":53,"brandBuilding":31,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":77,"awareness":56,"judgement":74},"picture":"Apolo Estrada Jr.png"},{"id":2259,"name":"Cien Caras Jr.","realName":"Cien Caras Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":264,"height":187,"dateOfBirth":"1980-10-18T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":52,"micSkills":68,"condition":83,"hardcoreAbility":76,"injuryProne":99,"ability":51,"currentAbility":40,"potentialAbility":42,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Cien Caras Jr  is a Mexican luchador enmascarado. In Lucha Libre it is traditional to keep the true identify of a masked wrestler a secret, not revealing their real names and oftentimes not revealing what previous ring names they have competed under. While Cien Caras Jr. is listed as having made his professional wrestling debut in 1997 under the name \"Sheriff\", it has not been confirmed if he previously worked under a masked or unmasked ring identity and then adopted the masked character \"Sheriff\" afterwards. He became Cien Caras Jr. in 2005, adopting the masked character of a son of wrestler Carmelo Reyes González, better known as Cien Caras. He also began teaming with Hijo de Cien Caras, like Cien Caras Jr. he was not an actual son of Reyes, but paid to use the character.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffA