ad":false,"inDevelopment":false,"story":"Dean Matthew Roll is an American professional wrestler, better known by his ring name Shark Boy. Roll began training under Les Thatcher in October 1995 at the age of twenty. He debuted on May 3, 1997 in Thatcher's Heartland Wrestling Association, wrestling as the masked El Piranha. An HWA mainstay, Roll also occasionally portrayed the character of Dean Baldwin, the purported fifth, lesser known Baldwin brother. Later that year, debuted in the Independent Wrestling Association, where he developed the cartoonish character Shark Boy, partly inspired by the 1995 song \"I Come From the Water\" by the Toadies.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":26,"storytelling":41,"productFit":100,"riskTaking":34,"matchLayout":46,"psychology":26,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":44,"characterCoaching":77,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":77,"brandBuilding":50,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":68,"awareness":26,"judgement":56},"picture":"Shark Boy.png"},{"id":1689,"name":"Mandy Leon","realName":"Mandy Leon","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":119,"height":165,"dateOfBirth":"1992-03-03T00:00:00.000Z","debut":"2014-04-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":29,"micSkills":27,"condition":100,"hardcoreAbility":31,"injuryProne":99,"ability":30,"currentAbility":29,"potentialAbility":29,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Mandy Leon is a professional wrestler trained by Ring Of Honor Wrestling and ROH DOJO's Head trainer Delirious. Mandy Leon often works for independent promotions including Ring Of Honor. Mandy also has worked as a model, actress, and dancer. Mandy's devoted, committed, and in love with Professional Wrestling. Mandy is an ROH Dojo Graduate and still continues to train at the ROH Dojo to be the best athlete possible. When Leon is not training at ROH Dojo, she is in her local gym full force doing Sports Performance and Physical training to be in the best shape possible.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2521],"staffAttributes":{"bookingLogic":38,"storytelling":41,"productFit":29,"riskTaking":37,"matchLayout":42,"psychology":38,"workerManagement":29,"trainingIntensity":61,"technicalCoaching":34,"characterCoaching":59,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":59,"brandBuilding":56,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":6,"reactionSpeed":61,"consistency":55,"awareness":38,"judgement":34},"picture":"Mandy Leon.png"},{"id":1690,"name":"Sammi Baynz","realName":"Sammi Baynz","nickname":"","type":"wrestler","base":"UK","gender":"F","weight":155,"height":162,"dateOfBirth":"1991-01-18T00:00:00.000Z","debut":"2005-10-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":30,"micSkills":34,"condition":88,"hardcoreAbility":55,"injuryProne":100,"ability":44,"currentAbility":43,"potentialAbility":43,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Sammi Baynz is a British professional who was born in Norwich, Norfolk. She was trained by Ricky Knight and Sweet Saraya, and is the former tag team partner of WWE's Paige (as the Norfolk Dolls), winning the WAWW Tag Team Championship wit