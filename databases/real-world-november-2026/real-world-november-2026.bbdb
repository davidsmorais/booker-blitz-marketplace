rdPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Not to be confused with the former WWF Tag Team Champion of the same name. Tito Santana is a young luchador who was seen mainly on the Monterrey indy scene. He made his debut in 2000 and is the son of former luchador Kendor. He is usually paired with high flying tecnicos but recently has taken on a new, more villianous persona, that of Soul Rocker, a member of Los Infernal Rockers in AAA.","alterEgos":["Soul Rocker"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1278],"staffAttributes":{"bookingLogic":54,"storytelling":60,"productFit":100,"riskTaking":27,"matchLayout":62,"psychology":54,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":56,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":64,"brandBuilding":38,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":78,"awareness":54,"judgement":72},"picture":"Tito Santana.png"},{"id":457,"name":"Rey Fénix","realName":"Rey Fénix","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":182,"height":175,"dateOfBirth":"1990-12-30T00:00:00.000Z","debut":"2006-04-01T00:00:00.000Z","wage":20500,"wageType":"monthly","popularity":40,"charisma":76,"micSkills":81,"condition":75,"hardcoreAbility":93,"injuryProne":100,"ability":84,"currentAbility":84,"potentialAbility":90,"morale":"fair","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Rey Fénix is a masked Mexican luchador who works in the USA, Canada, Mexico and the British Isles. He is a 5'10\", 165lb worker who is classed as using a Luchador style. He uses the Meteora as his finisher. He is one half of Lucha Brothers alongside Penta El Zero M. He is best known for his work with WWE, CMLL, AEW, NOAH, TNA, AAA, PWG, wXw, IWRG, MLW, Lucha Ungrnd, The Crash, DEFY, AAW, FCP, DTU, Defiant, CHIKARA and SWE. He was one half of the Male Tag Team Of The Year in 2019.","alterEgos":["Fénix","King"],"birthplace":"Mexico City, Mexico","managerId":0,"contractExpiryDate":"2027-03-01T00:00:00.000Z","contract":{"id":"tew-contract-457","wrestlerId":457,"promotionId":5,"startDate":"2025-03-01T00:00:00.000Z","endDate":"2027-03-01T00:00:00.000Z","wage":20500,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1207,1902,2386,2431,3711],"staffAttributes":{"bookingLogic":64,"storytelling":70,"productFit":100,"riskTaking":27,"matchLayout":72,"psychology":64,"workerManagement":100,"trainingIntensity":86,"technicalCoaching":73,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":67,"brandBuilding":68,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":86,"consistency":87,"awareness":64,"judgement":78},"picture":"Rey Fénix.png"},{"id":458,"name":"Flamita","realName":"Flamita","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":161,"height":167,"dateOfBirth":"1994-11-30T00:00:00.000Z","debut":"2005-12-01T00:00:00.000Z","wage":4166,"popularity":19,"charisma":51,"micSkills":68,"condition":85,"hardcoreAbility":53,"injuryProne":96,"ability":65,"currentAbility":65,"potentialAbility":73,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"A third-generation star from Mexico, Flamita has risen quickly into the upper-echelon of luchadors, drawing comparisons to lucha royalty. Before making his ROH debut on the Honor United 2019 tour, Flamita drew acclaim all over the globe, including representing the groups Millenials and Dia.Hearts in Dragon Gate and teaming with international mega star Bandido as Mexiblood.\r\n\r\nFlamita has excelled in singles competition, holding The Crash’s Cruiserweight Championship, but has made his mark in six-man tag action in Dragon Gate, holding their six-man tag team titles, as well as The Crash and Progress World Tag Team Titles with Bandido. In ROH, that success continued and continued quickly when the master of the FlamaFlame Spanish Fly won the ROH World Six-Man Tag Team Titles with Bandido and Rey Horus in Atlanta at Saturday Night at Center Stage 2020.","alterEgos":["Night Claw","Octagon, Jr.","Demonic Flamita"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1034,1793,1970,3094],"staffAttributes":{"bookingLogic":51,"storytelling":59,"productFit":100,"riskTaking":25,"matchLayout":62,"psychology":51,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":62,"characterCoaching":49,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":49,"brandBuilding":58,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":68,"awareness":51,"judgement":71},"picture":"Flamita.png"},{"id":459,"name":"Gronda II","realName":"Gronda II","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":220,"height":180,"dateOfBirth":"1960-08-20T00:00:00.000Z","debut":"2002-06-23T00:00:00.000Z","wage":37500,"popularity":3,"charisma":46,"micSkills":52,"condition":61,"hardcoreAbility":29,"injuryProne":100,"ability":51,"currentAbility":23,"potentialAbility":25,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Gronda II took over the gimmick when the orignal Gronda walked out on AAA. Despite his menacing look, Gronda II hasn't had much success and is usually booked on the mid/undercard for AAA. He is better in the ring than the original Gronda (which isn't difficult), but still not good enough to be considered a top draw for the company after 7 years portraying the character.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":46,"storytelling":51,"productFit":100,"riskTaking":54,"matchLayout":53,"psychology":46,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":22,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":46,"mediaHandling":64,"brandBuilding":60,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":53,"awareness":46,"judgement":68},"picture":"Gronda.png"},{"id":460,"name":"Cruz Del Toro","realName":"Raul Mendoza","nickname":"","type":"wrestler","promotionId":64,"base":"Mexico","gender":"M","weight":176,"height":167,"dateOfBirth":"1991-11-25T00:00:00.000Z","debut":"2006-09-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":25,"charisma":54,"micSkills":69,"condition":91,"hardcoreAbility":84,"injuryProne":100,"ability":54,"currentAbility":54,"potentialAbility":60,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"One of the world’s fastest Superstars and most spectacular aerial artists, Raul Mendoza keeps opponents on their toes by darting around the ring like a pinball bouncing off bumpers.\r\n\r\nFollowing in the footsteps of his idol, WWE Hall of Famer Eddie Guerrero, Mendoza established himself in Mexico’s tradition-rich lucha libre scene before attaining Superstardom under the WWE banner. He first gained the attention of the WWE Universe with an impressive showing during the 2016 Cruiserweight Classic. The performance opened eyes and earned Mendoza a spot on the NXT roster, where he now mixes it up with the black-and-yellow brand’s toughest competitors.\r\n\r\nCapable of stealing the show on any given night, Mendoza remains among the brightest young prospects in all of WWE.","alterEgos":["Raul Mendoza","Jinzo"],"birthplace":"Cosio, Aguascalientes, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-460","wrestlerId":460,"promotionId":64,"startDate":"2016-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1831,2161],"staffAttributes":{"bookingLogic":58,"storytelling":61,"productFit":100,"riskTaking":26,"matchLayout":62,"psychology":58,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":51,"characterCoaching":41,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":41,"brandBuilding":51,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":62,"awareness":58,"judgement":75},"picture":"Cruz Del Toro.png"},{"id":461,"name":"Joe Lider","realName":"Joe Lider","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":220,"height":172,"dateOfBirth":"1978-06-02T00:00:00.000Z","debut":"1993-12-01T00:00:00.000Z","wage":4166,"popularity":4,"charisma":63,"micSkills":53,"condition":60,"hardcoreAbility":48,"injuryProne":100,"ability":47,"currentAbility":35,"potentialAbility":37,"morale":"broken","presentation":"heel","prestige":"low","style":"striker","cardPosition":"upper","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"José de Jesús Álvarez is a Mexican professional wrestler, better known by his ringname Joe Líder. He currently competes in Asistencia Asesoría y Administración. He is known for being a former member of the tag team La Hermandad Extrema with Nicho el Millonario who, like himself, is one of several wrestlers to emerge from the independent circuit during the 1990s. Álvarez is also the real-life brother of Demoledor and had faced him on several occasions during his career, most notably, defeating him in their hometown in a \"hair vs. hair\" match at the Arena Victoria in January 2005.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1155,1199,1200,1271,3197],"staffAttributes":{"bookingLogic":61,"storytelling":64,"productFit":100,"riskTaking":33,"matchLayout":65,"psychology":61,"workerManagement":100,"trainingIntensity":61,"technicalCoaching":38,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":58,"brandBuilding":52,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":61,"consistency":64,"awareness":61,"judgement":77},"picture":"Joe Lider.png"},{"id":463,"name":"El Zorro","realName":"El Zorro","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":201,"height":172,"dateOfBirth":"1975-07-20T00:00:00.000Z","debut":"1993-07-01T00:00:00.000Z","wage":37500,"popularity":6,"charisma":53,"micSkills":71,"condition":68,"hardcoreAbility":43,"injuryProne":100,"ability":62,"currentAbility":43,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jesus Cristóbal Martínez Rodriguez is a Mexican Luchador (professional wrestler) who is best known as El Zorro. His gimmick started out very similar to the fictional character Zorro complete with mask, but in recent years it has evolved and the mask has been eliminated. He currently wrestlers for the Asistencia Asesoría y Administración (AAA) promotion in Mexico. In late September TNA founder Jeff Jarrett travelled to Mexico to hold talks with AAA, during which Martínez was offered a two–year non–exclusive contract with TNA. On December 2, 2012, at Guerra de Titanes, Martínez made his debut as the masked \"La Parka Negra\", the rudo counterpart of La Parka.","alterEgos":["La Parka Negra","The Chrizh"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":69,"storytelling":71,"productFit":100,"riskTaking":21,"matchLayout":72,"psychology":69,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":53,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":67,"brandBuilding":58,"socialMediaSavvy":58,"ruleKnowledge":5,"positioning":24,"reactionSpeed":66,"consistency":62,"awareness":69,"judgement":81},"picture":"El Zorro_alt1.png"},{"id":464,"name":"Máscara Año 2000 Jr.","realName":"Máscara Año 2000 Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":225,"height":180,"dateOfBirth":"1977-01-16T00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":52,"micSkills":56,"condition":84,"hardcoreAbility":48,"injuryProne":100,"ability":63,"currentAbility":46,"potentialAbility":48,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Ángel Omar Reyes Franco is a Mexican luchador or professional wrestler, better known as Máscara Año 2000, Jr. Reyes made his professional wrestling debut at some point in 1999, under an undisclosed ring name. From 1999 until 2006 he wrestled without revealing his family relations to his father Jesús Reyes González, better known as Luchador Máscara Año 2000. This is a practice not uncommon in Lucha libre where sons often \"learn the trade\" before being given the \"family name\". On November 2, 2008 Máscara Año 2000, Jr. was one of 10 wrestlers who put their mask on the line under Lucha de Apuesta, or bet match, rules. On December 16, 2011, at AAA's Guerra de Titanes pay-per-view, Máscara Año 2000, Jr. formed the stable El Consejo (\"The Council\") with former CMLL workers El Texano, Jr. and Toscano. On August 5 in the main event of Triplemanía XX, Máscara Año 2000, Jr. was defeated by Dr. Wagner, Jr. in a Mask vs. Mask match. Following the loss, Reyes was forced to unmask.","alterEgos":["Capo Mayor"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1195,1743],"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":29,"matchLayout":66,"psychology":58,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":62,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":56,"brandBuilding":54,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":69,"awareness":58,"judgement":75},"picture":"Mascara Ano 2000 Jr_alt.png"},{"id":465,"name":"Monster Clown","realName":"Monster Clown","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":231,"height":182,"dateOfBirth":"1976-02-24T00:00:00.000Z","debut":"1997-02-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":65,"micSkills":59,"condition":68,"hardcoreAbility":52,"injuryProne":100,"ability":61,"currentAbility":43,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Monster Clown is the ring name of a Mexican Luchador enmascarado, or masked professional wrestler. He is best known as part of Los Psycho Circus in Asistencia Asesoría y Administración (AAA) along with Psycho Clown and Murder Clown where they portray a trio of \"evil clowns\". The wrestler who would later be known as Monster Clown began his professional wrestling career in 1997 as the enmascarado (masked wrestler) \"Highlander\" working primarily in and around the Tijuana, Baja California area. He some times worked on Asistencia Asesoría y Administración (AAA) shows when the promotion ran shows in Tijuana, but was not a full time member of the roster. In 200X he began working more for AAA as AAA owner Antonio Peña came up with a new ring character for him called \"Aliens\". The \"Aliens\" character was that of an actual alien from space who had come to earth to wrestle. He was even given a mascota (a Mini-Estrella companion) called \"Mungo\".","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1205],"staffAttributes":{"bookingLogic":64,"storytelling":65,"productFit":100,"riskTaking":40,"matchLayout":65,"psychology":64,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":30,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":62,"brandBuilding":53,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":71,"awareness":64,"judgement":78},"picture":"Monster Clown.png"},{"id":466,"name":"Murder Clown","realName":"Murder Clown","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":288,"height":190,"dateOfBirth":"1986-03-01T00:00:00.000Z","debut":"2007-12-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":5,"charisma":54,"micSkills":76,"condition":83,"hardcoreAbility":60,"injuryProne":100,"ability":69,"currentAbility":69,"potentialAbility":73,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"A member of the Psycho Circus. One of the largest men on the AAA roster, Also went by the name of Killer Clown until the threat of being sued made AAA change his name. Los Psycho Circus is a Lucha libre, or professional wrestling, trio. Asistencia Asesoría y Administración (AAA) has a long history of using clown based ring characters ever since the company was founded in 1992, most famously the group known as Los Payasos (Spanish for \"The Clowns\") that existed until 1999. AAA later tried to promote other clown trios such as Payasos del Mal (\"Evil Clowns\") in 2007. It was not until AAA took the wrestler who had worked as Aliens, Kronus (son of Brazo de Plata) and a third wrestler whose previous identity has not been revealed and turned them into Los Psycho Circus.","alterEgos":["Killer Clown"],"birthplace":"Mexico City, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-466","wrestlerId":466,"promotionId":5,"startDate":"2007-12-14T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1205],"staffAttributes":{"bookingLogic":56,"storytelling":58,"productFit":100,"riskTaking":37,"matchLayout":58,"psychology":56,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":18,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":62,"brandBuilding":62,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":67,"awareness":56,"judgement":74},"picture":"Murder Clown.png"},{"id":467,"name":"Psycho Clown","realName":"Psycho Clown","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":236,"height":185,"dateOfBirth":"1985-12-16T00:00:00.000Z","debut":"2000-04-20T00:00:00.000Z","wage":41000,"wageType":"per-appearance","popularity":26,"charisma":80,"micSkills":96,"condition":79,"hardcoreAbility":100,"injuryProne":100,"ability":76,"currentAbility":76,"potentialAbility":79,"morale":"poor","presentation":"face","prestige":"low","style":"striker","cardPosition":"upper","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Psycho Clown is the ring name of a Mexican Luchador enmascarado and son of Luchador José Alvarado Nieves, better known under the ring names Brazo de Plata or Super Porky. He was not trained by his father or any of his uncles for his professional wrestling career, instead Memo Díaz was responsible for training the young Alvarado as well as his brother José Christian. He made his debut in 2000 working as Brazo de Plata, Jr. (\"Silver Arm, Jr.\"), taking his father's name and adopting the same style mask his father had worn. In 2003 he along with his brother (now working as Brazo de Platino, Jr.) and his cousin (working as Brazo de Oro, Jr. began working for Consejo Mundial de Lucha Libre (CMLL) the same company his father worked for. Brazo de Platino, Jr. became Máximo, Brazo de Oro, Jr. became La Máscara and Brazo de Plata, Jr. adopted the enmascarado identity \"Kronos\".","alterEgos":[],"birthplace":"Mexico City, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-467","wrestlerId":467,"promotionId":5,"startDate":"2006-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":41000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":65,"storytelling":67,"productFit":100,"riskTaking":30,"matchLayout":68,"psychology":65,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":48,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":85,"brandBuilding":83,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":67,"awareness":65,"judgement":79},"picture":"Psycho Clown_alt1.png"},{"id":468,"name":"Burger Boy","realName":"Niño Hamburguesa","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":223,"height":165,"dateOfBirth":"1996-01-30T00:00:00.000Z","debut":"2011-01-01T00:00:00.000Z","wage":4166,"popularity":4,"charisma":62,"micSkills":51,"condition":89,"hardcoreAbility":45,"injuryProne":100,"ability":53,"currentAbility":53,"potentialAbility":62,"morale":"broken","presentation":"face","prestige":"low","style":"comedy","cardPosition":"mid","finisher":"","finisherType":"counter","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ivan Flores is a Mexican wrestler known by the ring name Niño Hamburguesa. He is a former DTU trainee who's become something of a cult favorite for his name and his agility despite his size.","alterEgos":["Niño Hamburguesa"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":55,"storytelling":56,"productFit":100,"riskTaking":30,"matchLayout":56,"psychology":55,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":23,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":76,"brandBuilding":42,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":73,"awareness":55,"judgement":73},"picture":"Nino Hamburguesa.png"},{"id":471,"name":"Penta","realName":"Penta El Zero M","nickname":"","type":"wrestler","promotionId":64,"base":"Mexico","gender":"M","weight":200,"height":177,"dateOfBirth":"1985-02-05T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":44,"charisma":72,"micSkills":100,"condition":80,"hardcoreAbility":100,"injuryProne":100,"ability":78,"currentAbility":78,"potentialAbility":81,"morale":"fair","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Penta El Zero M is a masked Mexican luchador who works in America, Canada, Mexico and the British Isles. He is a Lightweight who is classed as using a Luchador style. He is one half of Lucha Brothers alongside Rey Fénix. He is best known for his work with AEW, AAA, CMLL, IMPACT, PWG, wXw, MLW, RevPro, DEFY, Lucha Ungrnd, The Crash, IWRG, AAW, FCP, DTU and Defiant. He is currently an AEW World Trios champion. He was one half of the Tag Team Of The Year in 2019.","alterEgos":["Penta El Zero M","Pentagon Jr.","Lucha Brother"],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-471","wrestlerId":471,"promotionId":64,"startDate":"2024-12-06T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1207,1902,2431,3711],"staffAttributes":{"bookingLogic":71,"storytelling":75,"productFit":100,"riskTaking":22,"matchLayout":76,"psychology":71,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":62,"characterCoaching":86,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":86,"brandBuilding":73,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":58,"awareness":71,"judgement":83},"picture":"Penta.png"},{"id":472,"name":"Polvo de Estrellas","realName":"Polvo de Estrellas","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":207,"height":172,"dateOfBirth":"1966-05-26T00:00:00.000Z","debut":"1984-05-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":59,"micSkills":66,"condition":59,"hardcoreAbility":36,"injuryProne":96,"ability":54,"currentAbility":28,"potentialAbility":30,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Fidel (or Felipe) Alavarado is a Mexican wrestler, known primarily as Polvo de Estrellas (Stardust), an Exotico character. Debuting in 1987 as Adrian, he would go on to become one of the more bizarre characters in Mexico (and that says something). He is a tenacious and driven worker who has been \"walking with class and glamour\" in the AAA for 10+ years! He also had a short lived stint as a member of Los Bizaros in AAA under the name Amadeus.","alterEgos":["Amadeus"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":25,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":45,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":67,"brandBuilding":33,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":78,"awareness":63,"judgement":78},"picture":"Polvo De Estrellas.png"},{"id":474,"name":"Súper Fly","realName":"Súper Fly","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":180,"height":167,"dateOfBirth":"1987-02-24T00:00:00.000Z","debut":"2001-03-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":68,"micSkills":52,"condition":86,"hardcoreAbility":62,"injuryProne":100,"ability":70,"currentAbility":64,"potentialAbility":68,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Super Fly is the ring name of a Mexican Luchador enmascarado. Super Fly's real name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans. Through his fathers contacts the future Super Fly was trained by highly renowned Mexican wrestling trainer Skayde and by Psicosis before making his debut at just 14 years of age. He originally did not wrestle under the name \"Super Fly\" but employed an unknown ring name and for the first couple of years. In 2005 he signed a contract with Asistencia Asesoría y Administración (AAA), one of Mexico's two largest promotions. In 2006 he became one of the founding members of a group called Real Fuerza Aérea (Spanish for \"Royal Air Force\") alongside Laredo Kid and Nemesis. After over a year of on and off teasing, Super Fly finally turned rudo on November 28, 2010 but by 2012 he was once again a tecnico and rejoined Real Fuerza Aérea.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":57,"storytelling":65,"productFit":100,"riskTaking":29,"matchLayout":67,"psychology":57,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":62,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":51,"brandBuilding":48,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":77,"awareness":57,"judgement":74},"picture":"Super Fly.png"},{"id":475,"name":"Ultimo Gladiador","realName":"Ultimo Gladiador","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":212,"height":180,"dateOfBirth":"1978-03-28T00:00:00.000Z","debut":"1997-06-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":62,"micSkills":69,"condition":81,"hardcoreAbility":43,"injuryProne":100,"ability":52,"currentAbility":39,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Gerardo Campos Poza, better known under his ring name Último Gladiador (Spanish for \"Last Gladiator\") is a Mexican Luchador enmascarado. Campos trained for his professional under Black Man and Rocky Santana as well as receiving additional training by his uncle Pantera later on. He made his debut on June 11, 1997 as a rúdo character called El Potro. Campos' relationship with wrestler Crazy Boy landed him a change to work for Asistencia Asesoría y Administración (AAA), one of Mexico's largest wrestling promotions, when Crazy Boy hurt his back and needed someone to replace him in tag team matches. Último Gladiador joined the Mexican Powers and teamed with Juventud Guerrera and Joe Líder to make his AAA debut on February 10, 2008.","alterEgos":["La Parka Negra"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1198,3295,3313],"staffAttributes":{"bookingLogic":55,"storytelling":65,"productFit":100,"riskTaking":35,"matchLayout":68,"psychology":55,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":40,"characterCoaching":55,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":55,"brandBuilding":68,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":75,"awareness":55,"judgement":73},"picture":"Ultimo Gladiador.png"},{"id":476,"name":"Vampiro","realName":"Vampiro","nickname":"","type":"wrestler","base":"Canada","gender":"M","weight":249,"height":187,"dateOfBirth":"1967-05-31T00:00:00.000Z","debut":"1984-07-29T00:00:00.000Z","wage":4166,"popularity":24,"charisma":42,"micSkills":58,"condition":48,"hardcoreAbility":47,"injuryProne":100,"ability":45,"currentAbility":24,"potentialAbility":66,"morale":"poor","presentation":"face","prestige":"low","style":"striker","cardPosition":"upper","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ian Richard Hodgkinson is a Canadian  professional wrestler better known by his ring name Vampiro. Hodgkinson has wrestled for various wrestling promotions, but is best known for his time in Consejo Mundial de Lucha Libre during the early 1990s. He later wrestled for World Championship Wrestling, where he held the WCW Tag Team Championship with The Great Muta. In his professional wrestling career, Hodgkinson is a six time World heavyweight champion having won the NWE World Heavyweight Championship once, WWC Universal Heavyweight Championship once, UWA World Heavyweight Championship once, WSX Championship once, and JCW Heavyweight Championship twice. He recently joined the Guardian Angels and will head the group's chapter in Mexico City.","alterEgos":[],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1414],"staffAttributes":{"bookingLogic":76,"storytelling":75,"productFit":100,"riskTaking":37,"matchLayout":74,"psychology":76,"workerManagement":100,"trainingIntensity":48,"technicalCoaching":34,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":78,"brandBuilding":63,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":48,"consistency":38,"awareness":76,"judgement":86},"picture":"Vampiro_alt3.png"},{"id":477,"name":"Cynthia Moreno","realName":"Cynthia Moreno","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":152,"height":162,"dateOfBirth":"1970-07-23T00:00:00.000Z","debut":"1987-07-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":73,"micSkills":70,"condition":76,"hardcoreAbility":77,"injuryProne":87,"ability":62,"currentAbility":37,"potentialAbility":39,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Flavia Antonia Moreno León is a Mexican Luchadora, better known under the ring name Cynthia Moreno (sometimes spelled \"Cinthia Moreno\") She is currently working for Asistencia Asesoría y Administración (AAA). Moreno is a part of an extended wrestling family that includes her father Alfonso Moreno, her brother who wrestles as El Oriental and her sisters, Esther, Alda and Rossy Moreno. Flavia Antonia Moreno León is the daughter of Alfonso \"Acorazado\" (Spanish for \"Battleship\") Moreno and was trained by her father as well as by Pepe Casas for her professional wrestling career. She made her debut in 1987 in Arena Azteca Budoka in Nezahualcoyotl, Mexico State, the building her father promoted at the time, under the name Cynthia Moreno. In the early 1990s Cynthia and her sister Esther Moreno travelled to Japan to wrestle for All Japan Women's Pro-Wrestling. She is a former two times holder of the AAA World Mixed Tag Team Championship with her brother El Oriental.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3136,3137,3138,3139],"staffAttributes":{"bookingLogic":71,"storytelling":76,"productFit":100,"riskTaking":22,"matchLayout":78,"psychology":71,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":61,"characterCoaching":71,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":71,"brandBuilding":53,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":78,"awareness":71,"judgement":83},"picture":"Cynthia Moreno.png"},{"id":478,"name":"La Hechicera","realName":"La Hechicera","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":254,"height":182,"dateOfBirth":"1972-12-28T00:00:00.000Z","debut":"1998-07-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":33,"micSkills":55,"condition":87,"hardcoreAbility":49,"injuryProne":100,"ability":38,"currentAbility":24,"potentialAbility":26,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Low ranked AAA ruda, who mostly has just made occasional appearances and participated in Reina de Reinas tournaments. She's been in AAA since 1998, though there are years where she doesn't appear to turn on TV. Seemed to be dropped for good in late 2008, but turned up on spot show lineups in 2009. Still doesn't make TV, but fills out relevos AAA and women's tag matches on non televised shows.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":57,"productFit":100,"riskTaking":36,"matchLayout":57,"psychology":58,"workerManagement":100,"trainingIntensity":36,"technicalCoaching":26,"characterCoaching":33,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":33,"brandBuilding":12,"socialMediaSavvy":27,"ruleKnowledge":0,"positioning":20,"reactionSpeed":36,"consistency":49,"awareness":58,"judgement":75},"picture":"La Hechicera.png"},{"id":479,"name":"La Magnífica","realName":"La Magnífica","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":132,"height":157,"dateOfBirth":"1989-03-30T00:00:00.000Z","debut":"2007-05-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":41,"micSkills":33,"condition":88,"hardcoreAbility":55,"injuryProne":100,"ability":29,"currentAbility":27,"potentialAbility":32,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tamara Rubí Barrón García is a luchadora. Daugther of Gran Cochisse, briefly wrestled in Arena Coliseo Guadalajara before her father was fired as trainer at the gym. Occasionally appeared on Guadalajara independent shows. Won the 2011 AAA Quien Pinta Para La Corona championship for women, but strangely never appeared on television and stopped being mentioned as a winner. AAA never explained what happened. Resurfaced in a match at the Guadalajara stop on the 2012 QPPLC tryout tour. Again appeared at the 2012 Mexico City final and was acknowledged as last year's champion for the first time since she won. Her brother Saturno won the 2012 men's contest at the same show.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":35,"storytelling":39,"productFit":80,"riskTaking":43,"matchLayout":40,"psychology":35,"workerManagement":80,"trainingIntensity":65,"technicalCoaching":44,"characterCoaching":40,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":40,"brandBuilding":35,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":16,"reactionSpeed":65,"consistency":68,"awareness":35,"judgement":53},"picture":"La Magnifica.png"},{"id":480,"name":"Dr. Wagner Jr.","realName":"Dr. Wagner Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":216,"height":175,"dateOfBirth":"1965-08-12T00:00:00.000Z","debut":"1986-04-01T00:00:00.000Z","wage":4166,"popularity":30,"charisma":64,"micSkills":56,"condition":67,"hardcoreAbility":66,"injuryProne":100,"ability":78,"currentAbility":40,"potentialAbility":82,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Juan Manuel González Barrón is a Mexican Luchador Enmascarado who is best known under the ring name Dr. Wagner, Jr.. On the day that Dr. Wagner, Jr. was to make his in-ring debut as his father's tag-team partner, Wagner, Sr. was involved in a car accident that killed his long-time partner Angel Blanco, leaving Wagner, Sr. disabled and unable to continue his wrestling career. As Dr. Wagner, Jr. he has worked mainly in Mexico for Consejo Mundial de Lucha Libre (CMLL) and Asistencia Asesoría y Administración (AAA), Mexico's two largest professional wrestling promotions as well as working for several Japanese promotions including New Japan Pro Wrestling (NJPW). Gonzalez is the son of professional wrestler Dr. Wagner, brother of Silver King and the father of recently debuted professional wrestler Dr. Wagner III.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1232,3154,3155,3156,3157,3158],"staffAttributes":{"bookingLogic":85,"storytelling":87,"productFit":100,"riskTaking":21,"matchLayout":88,"psychology":85,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":67,"characterCoaching":84,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":84,"brandBuilding":82,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":65,"awareness":85,"judgement":91},"picture":"Dr Wagner Jr_alt.png"},{"id":481,"name":"L.A. Park","realName":"L.A. Park","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":299,"height":182,"dateOfBirth":"1965-11-14T00:00:00.000Z","debut":"1982-01-01T00:00:00.000Z","wage":37500,"popularity":25,"charisma":74,"micSkills":61,"condition":65,"hardcoreAbility":82,"injuryProne":100,"ability":75,"currentAbility":38,"potentialAbility":80,"morale":"poor","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"The dead has risen.\r\n\r\nNo stranger to MLW, LA Park competed in the 2002 World Heavyweight Title Tournament as well as taking part in one of the most talked-about rivalries in the league’s history as he battled Sabu from 2002 through 2003.\r\n\r\nSince then, the man known originally as La Parka has continued his wickedness south of the border where he has ascended to legendary status with his wild, chaotic brawls. LA Park regularly performs in the main event in 20,000-seat arenas across Mexico.\r\n\r\nDonning his iconic skeleton mask, this rudo is virtually unstoppable. Swinging a chair, which he has wrapped around countless opponents, LA Park has always been one of the most unpredictable men in the sport. That makes an encounter with “The Chairman” one most men desperately try to avoid.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2003,2324,2325,2327],"staffAttributes":{"bookingLogic":82,"storytelling":83,"productFit":100,"riskTaking":19,"matchLayout":83,"psychology":82,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":57,"characterCoaching":84,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":84,"brandBuilding":67,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":80,"awareness":82,"judgement":89},"picture":"LA Park.png"},{"id":483,"name":"Sexy Xtar","realName":"Sexy Xtar","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":126,"height":157,"dateOfBirth":"1982-09-20T00:00:00.000Z","debut":"2006-08-01T00:00:00.000Z","wage":37500,"popularity":9,"charisma":57,"micSkills":54,"condition":79,"hardcoreAbility":60,"injuryProne":100,"ability":54,"currentAbility":45,"potentialAbility":57,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Dulce Maria García Rivas is a Mexican Luchadora enmascarada, who performs under the ring name Sexy Star. She is a former two-time AAA Reina de Reinas Champion as a member of La Legión Extranjera. She previously wrestled under the name Dulce Poly and held the FILL Women's Championship that name. Dulce García was born on September 20, 1982 in Monterrey, Nuevo León. Growing up she had devoted herself to sports such as boxing, kickboxing and Muay Thai. García made her professional wrestling debut on August 29, 2006 under the ring name Dulce Poly, on a Federacion Internacional de Lucha Libre (FILL) show. In FILL she often teamed up with one of her trainers, Humberto Garza, Jr. and together the two won the FILL Mixed Tag Team Championship at one point.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":44,"storytelling":49,"productFit":100,"riskTaking":43,"matchLayout":51,"psychology":44,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":37,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":54,"brandBuilding":75,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":55,"awareness":44,"judgement":66},"picture":"Sexy Star.png"},{"id":485,"name":"Copetes Salazar","realName":"Copetes Salazar","nickname":"","type":"referee","base":"Mexico","gender":"M","weight":181,"height":170,"dateOfBirth":"1961-09-27T00:00:00.000Z","debut":"1979-09-01T00:00:00.000Z","wage":66000,"popularity":2,"charisma":85,"micSkills":64,"condition":53,"hardcoreAbility":74,"injuryProne":83,"ability":79,"currentAbility":36,"potentialAbility":36,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Raul \"Copetes\" Salazar is a former luchador turned referee. He went by many different names during his time as an in ring competitor including; Mister Kamba, Super Sónico, Galático, Apolo (1990-1995) and Century 2000. Currently he is a referee with the AAA promotion in Mexico, which is also where he spent most of his career wrestling.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":45,"storytelling":54,"productFit":100,"riskTaking":27,"matchLayout":57,"psychology":45,"workerManagement":100,"trainingIntensity":20,"technicalCoaching":20,"characterCoaching":47,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":47,"brandBuilding":18,"socialMediaSavvy":36,"ruleKnowledge":75,"positioning":80,"reactionSpeed":20,"consistency":22,"awareness":45,"judgement":67},"picture":"Copetes Salazar.png"},{"id":486,"name":"Dorian Roldán","realName":"Dorian Roldán","nickname":"","type":"manager","promotionId":5,"base":"Mexico","gender":"M","weight":178,"height":175,"dateOfBirth":"1984-10-15T00:00:00.000Z","debut":"2002-10-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":5,"charisma":34,"micSkills":46,"condition":100,"hardcoreAbility":69,"injuryProne":100,"ability":58,"currentAbility":50,"potentialAbility":53,"morale":"broken","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"After the death of uncle, Antonio Pena, young Dorian took control of AAA with his father Joaquin Roldan. In front of the cameras, Dorian is the rebelling rudo son of current AAA owners Joaquin and Marisela. Backstage, Dorian is in charge of the creative direction of the company and many of the new initiatives.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-486","wrestlerId":486,"promotionId":5,"startDate":"2009-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":60,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":60,"brandBuilding":47,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Dorian Roldan.png"},{"id":488,"name":"El Hijo del Tirantes","realName":"El Hijo del Tirantes","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":198,"height":170,"dateOfBirth":"1977-03-04T00:00:00.000Z","debut":"1997-02-26T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":4,"charisma":36,"micSkills":42,"condition":93,"hardcoreAbility":49,"injuryProne":100,"ability":52,"currentAbility":38,"potentialAbility":40,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Much like his father, started out as a wrestler but ended up becoming an AAA referee. Normally a tecnico, but can be bullied into going along with the rudos. Really loves to partially notice an offense worth disqualification, consider calling for the DQ, poll the crowd about the offense, and resolving the situation by doing nothing at all. Incongruously more muscular than many of the wrestlers in his matches, he wears outfits to show off his upper body. Hijo del Tirantes has become the top rudo referee in AAA. Whenever the AAA side wins a major battle against the Legion, Hijo del Tirantes will be forced to call matches fairly. This leads to a few weeks of tension, before the story is forgotten and Hijo del Tirantes returns to his usual activities.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-488","wrestlerId":488,"promotionId":5,"startDate":"1997-02-26T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":55,"storytelling":53,"productFit":45,"riskTaking":28,"matchLayout":52,"psychology":55,"workerManagement":45,"trainingIntensity":48,"technicalCoaching":18,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":73,"brandBuilding":28,"socialMediaSavvy":68,"ruleKnowledge":73,"positioning":67,"reactionSpeed":48,"consistency":65,"awareness":55,"judgement":51},"picture":"El Hijo del Tirantes.png"},{"id":490,"name":"Andrade El Idolo","realName":"Andrade El Idolo","nickname":"","type":"wrestler","promotionId":76,"base":"Mexico","gender":"M","weight":210,"height":172,"dateOfBirth":"1989-11-03T00:00:00.000Z","debut":"2003-10-01T00:00:00.000Z","wage":80000,"wageType":"per-appearance","popularity":52,"charisma":74,"micSkills":93,"condition":86,"hardcoreAbility":90,"injuryProne":100,"ability":72,"currentAbility":72,"potentialAbility":87,"morale":"good","presentation":"heel","prestige":"mid","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"As a third-generation luchador, Andrade was born to be a Superstar, and he’s happy for it. The life suits him. Endlessly talented and even more confident, Andrade enjoys the perks that come with squared circle stardom. Andrade’s inherent skill for the family trade was unmistakable from the moment he debuted at age 13. He first established himself in his native Mexico and Japan, capturing championships in both countries. In WWE under the direction of Zelina Vega, Andrade used uncanny speed and ring awareness to ascend to the top of the black-and-gold brand when he captured the NXT Championship at NXT TakeOver: WarGames in 2017. After joining SmackDown in 2018, Andrade took every opportunity to catch the attention of the WWE Universe and put on several instant classics during an intense rivalry with Rey Mysterio. With multiple championship reigns and several show-stealing matches on his resume, Andrade's future looks as bright as ever.","alterEgos":["La Sombra","Andrade","Andrade \"Cien\" Almas"],"birthplace":"Gómez Palacio, Durango, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-490","wrestlerId":490,"promotionId":76,"startDate":"2025-12-22T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":80000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2060],"staffAttributes":{"bookingLogic":75,"storytelling":78,"productFit":100,"riskTaking":19,"matchLayout":79,"psychology":75,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":75,"characterCoaching":79,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":79,"brandBuilding":82,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":63,"awareness":75,"judgement":85},"picture":"Andrade El Idolo.png","additionalContracts":[{"id":"tew-contract-490-38","wrestlerId":490,"promotionId":38,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-490-118","wrestlerId":490,"promotionId":118,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":10500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["MLP","NJPW"]},{"id":491,"name":"Low Ki","realName":"Low Ki","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":174,"height":167,"dateOfBirth":"1979-09-06T00:00:00.000Z","debut":"1998-10-01T00:00:00.000Z","wage":37500,"popularity":21,"charisma":76,"micSkills":67,"condition":77,"hardcoreAbility":79,"injuryProne":100,"ability":65,"currentAbility":50,"potentialAbility":92,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Pound-for-pound, Low Ki is one of the most dangerous fighters in the sport. Employing knockout power with his quick, vicious strikes, Low Ki is capable of ending any match at any time. Not only does Low Ki utilize explosive kicks, he is also the master of an array of chops, submission holds and moves executed with precision second to none. A devout martial artist since childhood, Low Ki blends various martial arts techniques and disciplines, making him a challenge for adversaries of any size, regardless of their fighting system.","alterEgos":["Kaval","Senshi"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1573],"staffAttributes":{"bookingLogic":55,"storytelling":63,"productFit":100,"riskTaking":33,"matchLayout":66,"psychology":55,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":73,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":56,"brandBuilding":63,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":87,"awareness":55,"judgement":73},"picture":"Low-Ki_alt2.png"},{"id":492,"name":"Kota Ibushi","realName":"Kota Ibushi","nickname":"","type":"wrestler","promotionId":76,"base":"Japan","gender":"M","weight":205,"height":177,"dateOfBirth":"1982-05-21T00:00:00.000Z","debut":"2004-07-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":43,"charisma":66,"micSkills":66,"condition":66,"hardcoreAbility":64,"injuryProne":96,"ability":61,"currentAbility":61,"potentialAbility":83,"morale":"fair","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kota Ibushi is a Japanese wrestler who works in America, Mexico and Japan. He is a Middleweight who is classed as using a Technician Flyer style. He is best known for his work with WWE, NJPW, DDT, ROH and GCW. He was voted Independent Wrestler Of The Year in 2013.","alterEgos":["Tiger Mask W"],"birthplace":"Aira, Kagoshima, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-492","wrestlerId":492,"promotionId":76,"startDate":"2023-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1078,1079,1080,2085,2945],"staffAttributes":{"bookingLogic":73,"storytelling":76,"productFit":100,"riskTaking":35,"matchLayout":77,"psychology":73,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":72,"characterCoaching":71,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":71,"brandBuilding":79,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":62,"awareness":73,"judgement":84},"picture":"Kota Ibushi.png","injury":{"type":"Broken Leg","daysToRecover":5},"returnDate":"2026-04-17T00:00:00.000Z"},{"id":493,"name":"Extreme Tiger","realName":"Extreme Tiger","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":156,"height":157,"dateOfBirth":"1981-04-04T00:00:00.000Z","debut":"1998-09-01T00:00:00.000Z","wage":37500,"popularity":11,"charisma":47,"micSkills":66,"condition":77,"hardcoreAbility":62,"injuryProne":100,"ability":50,"currentAbility":40,"potentialAbility":52,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Extreme Tiger is a masked Mexican luchador who works in America, Mexico, the British Isles and Japan. He is a Small worker who is classed as using a Luchador style. He is best known for his work with AAA, IMPACT, NOAH, MLW, The Crash, WRESTLE-1, IWRG, DTU and SWE.","alterEgos":["Tigre Uno","Rey Xolo"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":53,"storytelling":60,"productFit":100,"riskTaking":37,"matchLayout":62,"psychology":53,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":53,"characterCoaching":47,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":47,"brandBuilding":62,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":64,"awareness":53,"judgement":72},"picture":"Extreme Tiger_alt1.png"},{"id":494,"name":"Taiji Ishimori","realName":"Taiji Ishimori","nickname":"","type":"wrestler","promotionId":38,"base":"Japan","gender":"M","weight":165,"height":162,"dateOfBirth":"1983-02-10T00:00:00.000Z","debut":"2002-05-01T00:00:00.000Z","wage":60000,"wageType":"monthly","popularity":25,"charisma":57,"micSkills":56,"condition":70,"hardcoreAbility":88,"injuryProne":100,"ability":52,"currentAbility":52,"potentialAbility":65,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Taiji Ishimori is a Japanese wrestler who works in Canada, Mexico and Japan. He is a Small worker who is classed as using a Technician Flyer style. He is best known for his work with NJPW, AAA, IMPACT, NOAH, wXw and AJPW.","alterEgos":[],"birthplace":"Tagajo, Miyagi, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-494","wrestlerId":494,"promotionId":38,"startDate":"2018-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1726,2044,3024,3034,4355],"staffAttributes":{"bookingLogic":63,"storytelling":69,"productFit":100,"riskTaking":30,"matchLayout":71,"psychology":63,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":62,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":63,"brandBuilding":56,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":71,"awareness":63,"judgement":78},"picture":"Taiji Ishimori.png"},{"id":495,"name":"Takeshi Morishima","realName":"Takeshi Morishima","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":275,"height":187,"dateOfBirth":"1978-10-15T00:00:00.000Z","debut":"1998-03-01T00:00:00.000Z","wage":37500,"popularity":10,"charisma":63,"micSkills":71,"condition":65,"hardcoreAbility":50,"injuryProne":100,"ability":67,"currentAbility":50,"potentialAbility":80,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Takeshi Morishima is a Japanese professional wrestler.  He's a former ROH World Heavyweight and GHC Heavyweight champion. Morishima currently holds a position on Pro Wrestling Noah's board of directors. Morshima has also wrestled in the United States and United Kingdom. He competed in Harley Race's World League Wrestling promotion in 2003, defending the WLW Heavyweight Championship, which he had won from Ron Harris while Harris toured Japan.  Morishima returned to the United States in February 2007, wrestling four matches with Ring of Honor. He lost to Samoa Joe on February 16, 2007 before defeating Homicide in a match for the ROH World Championship on the subsequent evening, thus becoming the first non-American to hold the title. On January 22, 2012, Morishima defeated Go Shiozaki to win the GHC Heavyweight Championship for the second time.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3060,3299],"staffAttributes":{"bookingLogic":73,"storytelling":76,"productFit":100,"riskTaking":25,"matchLayout":77,"psychology":73,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":54,"characterCoaching":55,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":55,"brandBuilding":55,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":68,"awareness":73,"judgement":84},"picture":"Takeshi Morishima_alt1.png"},{"id":496,"name":"Akuma","realName":"Akuma","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":194,"height":175,"dateOfBirth":"1995-08-28T00:00:00.000Z","debut":"2012-05-01T00:00:00.000Z","wage":48000,"wageType":"per-appearance","popularity":4,"charisma":61,"micSkills":68,"condition":92,"hardcoreAbility":65,"injuryProne":100,"ability":60,"currentAbility":60,"potentialAbility":68,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Akuma is the ring name of a Mexican luchador enmascarado. The wrestler known as Akuma is the younger brother of Consejo Mundial de Lucha Libre (CMLL) wrestler Demus 3:16 who works in CMLL's Mini-Estrella division. He is the brother-in-law of retired professional wrestler Hiroka Yaginuma who is married to Demus 3:16. Lucha libre has a tradition of keeping the real name and personal information of masked wrestlers private if they have never been officially unmasked, it makes it possible that Akuma has worked under a different ring name and masked identity before May 12, 2012 where he made his in ring debut under that name. His official CMLL debut came on September 16, 2012 on a show in Arena Mexico where he teamed up with Guerrero Negro, Jr. to defeat Oro, Jr. and Robin.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-496","wrestlerId":496,"promotionId":11,"startDate":"2012-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":48000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3070],"staffAttributes":{"bookingLogic":63,"storytelling":66,"productFit":100,"riskTaking":22,"matchLayout":67,"psychology":63,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":58,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":76,"brandBuilding":61,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":71,"awareness":63,"judgement":78},"picture":"Akuma_alt1.png"},{"id":498,"name":"El Terrible","realName":"El Terrible","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":231,"height":182,"dateOfBirth":"1976-04-17T00:00:00.000Z","debut":"1995-02-01T00:00:00.000Z","wage":48000,"wageType":"per-appearance","popularity":8,"charisma":83,"micSkills":77,"condition":75,"hardcoreAbility":75,"injuryProne":100,"ability":73,"currentAbility":52,"potentialAbility":54,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Damián Gutiérrez Hernández is a Mexican professional wrestler known by the ring name El Terrible. Gutiérrez began wrestling in his native Monterrey and elsewhere for smaller independent promotions under a mask as El Engendro del Mal (The Bad Boy). In 2002, he debuted in Consejo Mundial de Lucha Libre without a mask as Damián El Terrible but later the \"Damián\" part of his name was dropped, possibly to alleviate any confusion with Damián 666. He was part of Shocker's first \"University of 1000% Guapos,\" a group of undercarders competing for a spot in Shocker's Los Guapos group. On May 11, 2008, he and Damian 666 lost to The Hell Warriors (Animal and Power) in Mexico City in a match for the then recently vacated UWA World Tag Team Championship. On August 31, El Terrible defeated New Japan Pro Wrestling representative Hiroshi Tanahashi to become the 2012 Universal Champion.","alterEgos":[],"birthplace":"Monterrey, Nuevo León, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-498","wrestlerId":498,"promotionId":11,"startDate":"2002-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":48000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1194,1367,1368,4245],"staffAttributes":{"bookingLogic":77,"storytelling":79,"productFit":100,"riskTaking":28,"matchLayout":80,"psychology":77,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":59,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":76,"brandBuilding":62,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":73,"awareness":77,"judgement":86},"picture":"El Terrible.png"},{"id":499,"name":"Rush","realName":"Rush","nickname":"","type":"wrestler","promotionId":76,"base":"Mexico","gender":"M","weight":205,"height":180,"dateOfBirth":"1988-09-29T00:00:00.000Z","debut":"2006-09-01T00:00:00.000Z","wage":60000,"wageType":"monthly","popularity":36,"charisma":93,"micSkills":91,"condition":87,"hardcoreAbility":64,"injuryProne":100,"ability":81,"currentAbility":81,"potentialAbility":86,"morale":"fair","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"RUSH has the in-ring talent, the look, the charisma and the swagger of a superstar. The international sensation made his much-anticipated Ring of Honor debut at the end of 2018 and signed an exclusive contract with ROH shortly thereafter.\r\n\r\nRUSH is one of the biggest names in Mexico and the founder of the influential Los Ingobernables faction. Known as El Toro Blanco (The White Bull), RUSH is a former CMLL World Light Heavyweight Champion, two-time CMLL World Tag Team Champion and CMLL World Trios Champion. Rush also has made an impact in New Japan Pro-Wrestling. He has competed in the G1 Climax and World Tag League tournaments and scored victories over stars such as Tetsuya Naito and Shinsuke Nakamura.","alterEgos":["Rush Toro Blanco"],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-499","wrestlerId":499,"promotionId":76,"startDate":"2022-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1193],"staffAttributes":{"bookingLogic":70,"storytelling":74,"productFit":100,"riskTaking":20,"matchLayout":75,"psychology":70,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":58,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":85,"brandBuilding":88,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":79,"awareness":70,"judgement":82},"picture":"Rush.png"},{"id":500,"name":"Último Guerrero","realName":"Último Guerrero","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":210,"height":170,"dateOfBirth":"1972-03-01T00:00:00.000Z","debut":"1990-09-01T00:00:00.000Z","wage":64000,"wageType":"per-appearance","popularity":21,"charisma":74,"micSkills":75,"condition":74,"hardcoreAbility":68,"injuryProne":100,"ability":66,"currentAbility":42,"potentialAbility":44,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Último Guerrero  is a Mexican Luchador enmascarado. Último Guerrero was trained in \"Gimnasio El Ranchero\" by Tinito and Halcón Suriano and made his debut in 1990. Guerrero is a charter member of the stable of wrestlers known as Los Guerreros de Infierno / Los Guerreros de Atlantida and has made appearances for Total Nonstop Action Wrestling  where he as part of Team Mexico won the 2008 World X Cup. Último Guerrero is not related to Lucha libre legend Gory Guerrero or any of his children, \"Guerrero\" in this case is the Spanish word for warrior and not his surname. His name is literally translated to The Last Warrior in English. In early 2013 the long running feud between Atlantis and Último Guerrero came to the forefront of CMLL booking once more. The two were booked for the 2013 Torneo Nacional de Parejas Increibles tournament, forcing the two rivals to team up. Before their qualifying round both Atlantis and Gurrero stated that they would put their differences aside.","alterEgos":[],"birthplace":"Gómez Palacio, Durango, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-500","wrestlerId":500,"promotionId":11,"startDate":"1997-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":64000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1068,1187,1191,1232],"staffAttributes":{"bookingLogic":86,"storytelling":88,"productFit":100,"riskTaking":14,"matchLayout":88,"psychology":86,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":73,"characterCoaching":84,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":84,"brandBuilding":77,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":80,"awareness":86,"judgement":92},"picture":"Último Guerrero.png","additionalContracts":[{"id":"tew-contract-500-38","wrestlerId":500,"promotionId":38,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-500-68","wrestlerId":500,"promotionId":68,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["MLW","NJPW"]},{"id":501,"name":"Atlantis","realName":"Atlantis","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":202,"height":170,"dateOfBirth":"1962-09-28T00:00:00.000Z","debut":"1983-06-01T00:00:00.000Z","wage":64000,"wageType":"per-appearance","popularity":20,"charisma":80,"micSkills":62,"condition":60,"hardcoreAbility":60,"injuryProne":100,"ability":68,"currentAbility":32,"potentialAbility":34,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Atlantis made his professional wrestling debut on June 12, 1983 after training under world renowned Mexican wrestling trainer Diablo Velazco for just under a year. He adopted the masked ring persona of \"Atlantis\", a supposed warrior from the lost city of Atlantis, complete with a mask that had the image of two fish on it.[2] After working for various Mexican promotions for the first year of his career Atlantis became a regular for Empressa Mexicana de Lucha Libre (EMLL), Mexico's oldest professional wrestling promotion. After being a career tecnico, Atlantis was changed to a rudo in 2005. It did not appear to be his idea or even the promotion's idea, but the fans forcing a change. CMLL had been building up Atlantis, including weekly Seccion Azul features trumpeting his work with kids or focusing an award being given to Atlantis, to push him as the ultimate good guy.","alterEgos":[],"birthplace":"Los Altos, Jalisco, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-501","wrestlerId":501,"promotionId":11,"startDate":"1983-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":64000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":88,"storytelling":89,"productFit":100,"riskTaking":15,"matchLayout":89,"psychology":88,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":73,"characterCoaching":82,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":82,"brandBuilding":80,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":70,"awareness":88,"judgement":93},"picture":"Atlantis.png","additionalContracts":[{"id":"tew-contract-501-38","wrestlerId":501,"promotionId":38,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["NJPW"]},{"id":502,"name":"Samuray del Sol","realName":"Samuray del Sol","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":169,"height":165,"dateOfBirth":"1986-11-14T00:00:00.000Z","debut":"2006-12-01T00:00:00.000Z","wage":37500,"popularity":26,"charisma":50,"micSkills":65,"condition":86,"hardcoreAbility":37,"injuryProne":100,"ability":59,"currentAbility":53,"potentialAbility":67,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Samuray del Sol is a masked American wrestler who works in the USA, Canada, Mexico, the British Isles, Europe and India. He is a 5'6\", 169lb worker who is classed as using a Luchador style. He uses the Del Sol Driver and the Rising Sun as his finishers. He has regular tag teams with Cinta de Oro (The Latin Dragons) and Lince Dorado (Good Lucha Things). He is best known for his work with WWE, CMLL, TNA, AAA, NXT, PWG, EVOLVE, REVOLVER, AAW, AIW, DTU, CZW and WXM. He is married to someone outside the wrestling business.","alterEgos":["Kalisto","Octagon Jr."],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1584,1585,3513,3946,3961],"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":34,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":53,"characterCoaching":45,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":45,"brandBuilding":64,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":56,"awareness":56,"judgement":74},"picture":"Kalisto.png"},{"id":503,"name":"Averno","realName":"Averno","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":174,"height":172,"dateOfBirth":"1977-03-09T00:00:00.000Z","debut":"1995-10-01T00:00:00.000Z","wage":64000,"wageType":"per-appearance","popularity":13,"charisma":80,"micSkills":79,"condition":72,"hardcoreAbility":86,"injuryProne":100,"ability":72,"currentAbility":53,"potentialAbility":55,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Renato Ruíz Cortes, is a Mexican professional wrestler. He is best known for his time in Consejo Mundial de Lucha Libre as Averno, where he is a former one–time World Middleweight Champion and a three–time World Tag Team Champion. His ring name is the Spanish rendering of Avernus, the crater where Aeneas descended into the underworld in Virgil's Aeneid and is most commonly translated as \"Hell\" in English. He began wrestling in 1995 under the name Rencor Latino (Latin Hostility) after being trained by his father, a former wrestler and referee named Rodolfo Ruiz. During a televised segment Satánico used his supposed \"satanic powers\" to turn técnico (good guy) Rencor Latino into one of his \"minions\", the rudo (bad guy) known as \"Averno\". On June 17 at Juicio Final, Averno was defeated by La Máscara two falls to one, forcing him to unmask himself.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-503","wrestlerId":503,"promotionId":11,"startDate":"2021-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":64000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1186,1188,1189],"staffAttributes":{"bookingLogic":82,"storytelling":83,"productFit":100,"riskTaking":17,"matchLayout":83,"psychology":82,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":74,"characterCoaching":81,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":81,"brandBuilding":58,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":75,"awareness":82,"judgement":89},"picture":"Averno.png"},{"id":504,"name":"La Máscara","realName":"La Máscara","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":187,"height":172,"dateOfBirth":"1982-01-08T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":59,"micSkills":64,"condition":75,"hardcoreAbility":75,"injuryProne":100,"ability":56,"currentAbility":46,"potentialAbility":48,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Felipe de Jesús Alvarado Mendoza aka La Máscara is a Mexican professional wrestler. La Mascara is the son of Brazo de Oro, cousin of Psycho Clown and Máximo and nephew to Brazo de Plata and El Brazo. Making his professional debut on April 2, 2000, La Mascara spent much of his early career as a midcard tecnico in Consejo Mundial de Lucha Libre (CMLL). He debuted in CMLL as Brazo de Oro Jr. Like the other sons of Los Brazos, he took up a new gimmick in summer 2005 to create own identity. La Mascara has been pushed strongly since changing to that gimmick (from Brazo de Oro Jr.), with some thought that it might be due to his family connections. His work has appeared to catch up with his push. On January 22, 2011, La Máscara made his Japanese debut, when he took part in the Fantasticamania 2011 weekend, co-promoted by CMLL and New Japan Pro Wrestling in Tokyo.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1193],"staffAttributes":{"bookingLogic":62,"storytelling":69,"productFit":100,"riskTaking":22,"matchLayout":71,"psychology":62,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":68,"characterCoaching":44,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":44,"brandBuilding":60,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":75,"awareness":62,"judgement":77},"picture":"La Mascara.png"},{"id":505,"name":"Apocalipsis","realName":"Apocalipsis","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":198,"height":167,"dateOfBirth":"1975-01-16T00:00:00.000Z","debut":"1997-02-01T00:00:00.000Z","wage":32000,"wageType":"per-appearance","popularity":3,"charisma":55,"micSkills":67,"condition":68,"hardcoreAbility":54,"injuryProne":100,"ability":48,"currentAbility":33,"potentialAbility":35,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Juan Carlos Contreras Uribe better known under the ring name Apocalipsis, is a Mexican luchador enmascarado. Juan Contreras made his in ring debut on February 11, 2000 after training under Consejo Mundial de Lucha Libre (CMLL) wrestling trainers Tony Salazar and Jose Luis Feliciano. He adopted the ring name El Koreano for his wrestling character, a martial arts inspired character that supposedly was from South Korea.  He made his Apocalisis debut as part of the 2005 Gran Alternativa tournament, where a Novato or rookie, teamed up with a veteran for a tag team tournament. As Apocalipsis he teamed up with Damian 666 for the tournament.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-505","wrestlerId":505,"promotionId":11,"startDate":"2000-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":74,"storytelling":76,"productFit":100,"riskTaking":20,"matchLayout":76,"psychology":74,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":56,"characterCoaching":32,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":32,"brandBuilding":29,"socialMediaSavvy":25,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":75,"awareness":74,"judgement":84},"picture":"Apocalipsis.png"},{"id":507,"name":"Principe Odin Jr.","realName":"Principe Odin Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":168,"height":167,"dateOfBirth":"1982-08-12T00:00:00.000Z","debut":"2001-01-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":66,"micSkills":71,"condition":88,"hardcoreAbility":71,"injuryProne":100,"ability":59,"currentAbility":49,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Artillero has been a constant opening match guy since his debut. He's always partnered with his (older) brother Super Comando. They've established themselves as a military themed tag team - and sometimes trio with Flecha - and have an ongoing rivalry with Los Rayos Tapatíos and Sombra de Plata (who's not publicly acknowledged as their brother.) At this point, they seem stuck in their card position. On at least one occasion after being reborn as Artillero, he's wrestled as Chamaco Torres for no apparent reason. His career underwent a transformation in 2018 after changing his name to Principe Odin Jr., adopting a name inherited from his father, a prominent independent luchador of the 1970s.","alterEgos":["Artillero"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":56,"storytelling":63,"productFit":100,"riskTaking":33,"matchLayout":65,"psychology":56,"workerManagement":100,"trainingIntensity":53,"technicalCoaching":49,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":66,"brandBuilding":42,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":53,"consistency":73,"awareness":56,"judgement":74},"picture":"Artillero.png"},{"id":509,"name":"Andy Wild","realName":"Andy Wild","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":275,"height":182,"dateOfBirth":"1988-09-05T00:00:00.000Z","debut":"2008-02-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":38,"micSkills":42,"condition":90,"hardcoreAbility":33,"injuryProne":100,"ability":37,"currentAbility":34,"potentialAbility":39,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Andrew Inch is a Scottish wrestler known by his ring name \"Unstoppable\" Andy Wild. He is one of the the fastest rising stars on the UK scene today. Having had huge matches in Scotland with some of the top Independent names in the world, including \"Prince\" Fergal Devitt and Zack Sabre Jr, Wild has firmly established himself as one of the premier wrestlers in Europe with appearances in Germany, Denmark and Spain to name a few. With his sights firmly set on becoming a World Champion, few can argue why Andy Wild is known as, \"Unstoppable\".","alterEgos":[],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":39,"storytelling":46,"productFit":40,"riskTaking":42,"matchLayout":49,"psychology":39,"workerManagement":40,"trainingIntensity":69,"technicalCoaching":40,"characterCoaching":47,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":58,"mediaHandling":47,"brandBuilding":44,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":8,"reactionSpeed":69,"consistency":69,"awareness":39,"judgement":39},"picture":"Andy Wild_alt1.png"},{"id":511,"name":"Dustin Rhodes","realName":"Dustin Rhodes","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":235,"height":190,"dateOfBirth":"1969-04-11T00:00:00.000Z","debut":"1988-09-01T00:00:00.000Z","wage":60000,"wageType":"monthly","popularity":34,"charisma":82,"micSkills":85,"condition":74,"hardcoreAbility":87,"injuryProne":100,"ability":44,"currentAbility":44,"potentialAbility":76,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Dustin Patrick Runnels is an American professional wrestler. Runnels is best known as Goldust in WWE. He is also known for performing in various companies such as World Championship Wrestling and Total Nonstop Action Wrestling as Dustin Rhodes. Among the other names Runnels has performed under are Black Reign and Seven. Runnels is the son of \"The American Dream\" Dusty Rhodes and the half brother of Cody Rhodes. Rhodes debuted as a fan favorite in the World Wrestling Federation in late 1990, wrestling as Dustin Rhodes. In February 1991, Rhodes joined World Championship Wrestling, wrestling as \"The Natural\" Dustin Rhodes. In September 1995, Rhodes returned to the World Wrestling Federation, wrestling as a villain nicknamed \"the bizarre one\" because of his freaky, mysterious, very suggestive mannerisms and presence under the name Goldust.","alterEgos":["Black Reign","Goldust"],"birthplace":"Dallas, Texas, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-511","wrestlerId":511,"promotionId":76,"startDate":"2019-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1037,1081,1903,1989,2714,2715,3689,4045,4046],"staffAttributes":{"bookingLogic":84,"storytelling":86,"productFit":100,"riskTaking":12,"matchLayout":87,"psychology":84,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":54,"characterCoaching":82,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":88,"mediaHandling":82,"brandBuilding":56,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":78,"awareness":84,"judgement":90},"picture":"Dustin Rhodes.png","injury":{"type":"Knee Ligament Damage","daysToRecover":3},"returnDate":"2026-04-15T00:00:00.000Z"},{"id":512,"name":"BT Gunn","realName":"BT Gunn","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":194,"height":177,"dateOfBirth":"1986-04-02T00:00:00.000Z","debut":"2006-01-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":48,"micSkills":53,"condition":70,"hardcoreAbility":58,"injuryProne":100,"ability":52,"currentAbility":46,"potentialAbility":50,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosi