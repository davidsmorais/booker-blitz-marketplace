anada, Mexico and Japan. He is a Middleweight who is classed as using a Comedy style. He is best known for his work with NJPW, NOAH and ROH.","alterEgos":[],"birthplace":"Arakawa, Tokyo, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-336","wrestlerId":336,"promotionId":38,"startDate":"2005-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[952,994,3043,3045,3048,3657],"staffAttributes":{"bookingLogic":73,"storytelling":75,"productFit":100,"riskTaking":16,"matchLayout":76,"psychology":73,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":62,"characterCoaching":86,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":86,"brandBuilding":40,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":82,"awareness":73,"judgement":84},"picture":"Toru Yano.png"},{"id":337,"name":"Milano Collection A.T.","realName":"Milano Collection A.T.","nickname":"","type":"writer","promotionId":61,"base":"Japan","gender":"M","weight":187,"height":180,"dateOfBirth":"1976-08-27T00:00:00.000Z","debut":"2000-05-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":14,"charisma":100,"micSkills":86,"condition":56,"hardcoreAbility":76,"injuryProne":100,"ability":86,"currentAbility":61,"potentialAbility":61,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Akihito Terui, also known as Milano Collection A.T., is a retired Japanese professional wrestler. Now works often as a color commentator. Terui made his debut in 2000 in Toryumon, and gained success. He later adopted the persona of Milano Collection A.T. (A.T. being his initials; compare Magnum T.A. in the United States) to achieve greater success. He worked for New Japan Pro Wrestling as a part of the R.I.S.E. faction. He competed in Total Nonstop Action Wrestling's World X Cup as a part of Team Japan, winning his first and only singles match for TNA against Curry Man, gaining 2 points for his team. On January 18, 2010, Terui announced his retirement from the professional wrestling because of inferior oblique muscle palsy, brought on by an excessively strong thrust kick to the eye by Gedo. A retirement ceremony was held on February 14.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-337","wrestlerId":337,"promotionId":61,"startDate":"2019-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2975,3033],"staffAttributes":{"bookingLogic":82,"storytelling":83,"productFit":100,"riskTaking":25,"matchLayout":83,"psychology":82,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":83,"characterCoaching":87,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":87,"brandBuilding":56,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":69,"awareness":82,"judgement":89},"picture":"Milano Collection AT.png"},{"id":339,"name":"Kazuo Yamazaki","realName":"Kazuo Yamazaki","nickname":"","type":"commentator","promotionId":38,"base":"Japan","gender":"M","weight":227,"height":185,"dateOfBirth":"1962-08-15T00:00:00.000Z","debut":"1980-08-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":4,"charisma":55,"micSkills":49,"condition":100,"hardcoreAbility":71,"injuryProne":100,"ability":58,"currentAbility":27,"potentialAbility":27,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Kazuo Yamazaki is a former Japanese professional wrestler, who is known for his work in New Japan Pro Wrestling and UWF International. Yamazaki's wrestling career began in May 1982 in New Japan Pro Wrestling. In 1984, Yamazaki joined the Japanese UWF. However, differences between his mentor Satoru Sayama and Akira Maeda over direction caused the promotion to fail. He rejoined New Japan in 1985 as a junior heavyweight. Despite this, he found more success in tag teams in 1987, winning the IWGP Tag Team Championship with one of his mentors, Yoshiaki Fujiwara. In 1988, however, the UWF was reconstituted as Newborn UWF and Yamazaki joined it, and stayed there until it folded in December 1990. Kazuo Yamazaki now works as a wrestling instructor at the New Japan Pro Wrestling dojo and sometimes acts as color commentator for the NJPW program on TV Asahi.","alterEgos":[],"birthplace":"Tokyo, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-339","wrestlerId":339,"promotionId":38,"startDate":"2005-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3037,3039],"staffAttributes":{"bookingLogic":77,"storytelling":80,"productFit":100,"riskTaking":25,"matchLayout":81,"psychology":77,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":33,"characterCoaching":56,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":56,"brandBuilding":14,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":80,"awareness":77,"judgement":86},"picture":"Kazuo Yamazaki.png"},{"id":341,"name":"Marty Asami","realName":"Marty Asami","nickname":"","type":"referee","promotionId":38,"base":"Japan","gender":"M","weight":136,"height":154,"dateOfBirth":"1973-01-03T00:00:00.000Z","debut":"1995-11-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":4,"charisma":82,"micSkills":89,"condition":100,"hardcoreAbility":71,"injuryProne":100,"ability":76,"currentAbility":49,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Marty Asami is a Japanease professional wrestling referee. Marty Asami is the 3rd referee in New Japan. He began in November 1995 in IWA Japan, then worked in various indies and now-defunct promotions before moving to FMW. He joined New Japan in 2002 and has been with them since.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-341","wrestlerId":341,"promotionId":38,"startDate":"2002-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":36,"technicalCoaching":0,"characterCoaching":40,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":40,"brandBuilding":7,"socialMediaSavvy":10,"ruleKnowledge":82,"positioning":66,"reactionSpeed":36,"consistency":0,"awareness":0,"judgement":0},"picture":"Marty Asami.png"},{"id":342,"name":"Red Shoes Unno","realName":"Red Shoes Unno","nickname":"","type":"