ributes":{"bookingLogic":60,"storytelling":64,"productFit":100,"riskTaking":23,"matchLayout":66,"psychology":60,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":62,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":58,"brandBuilding":52,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":78,"awareness":60,"judgement":76},"picture":"Mike Bennett.png","additionalContracts":[{"id":"tew-contract-265-76","wrestlerId":265,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW"]},{"id":267,"name":"Nigel McGuinness","realName":"Nigel McGuinness","nickname":"","type":"commentator","promotionId":76,"base":"UK","gender":"M","weight":235,"height":187,"dateOfBirth":"1976-01-23T00:00:00.000Z","debut":"1999-09-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":32,"charisma":60,"micSkills":62,"condition":69,"hardcoreAbility":50,"injuryProne":86,"ability":75,"currentAbility":53,"potentialAbility":55,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Nigel McGuinness, one of the United Kingdom’s greatest wrestling exports, has come to WWE to share his unique outlook on the mat game with the WWE Universe.\r\n\r\nThe London native made his mark on the independent scene alongside some of WWE’s biggest Superstars, including Kevin Owens, Seth Rollins, Cesaro, Samoa Joe and his greatest rival, SmackDown LIVE General Manager Daniel Bryan. A British punk with bleach-blond, spiked hair, McGuinness matched his look with an in-ring style meshing traditional British grappling with smash-mouth strikes. His devastating rebounding lariat knocked his opposition for a loop and inspired an up-and-coming Dean Ambrose. McGuinness is widely considered to be one of the best competitors to never have a major run in WWE.","alterEgos":["Desmond Wolfe"],"birthplace":"London, England","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-267","wrestlerId":267,"promotionId":76,"startDate":"2023-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2816,2817],"staffAttributes":{"bookingLogic":85,"storytelling":87,"productFit":100,"riskTaking":19,"matchLayout":87,"psychology":85,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":79,"characterCoaching":78,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":78,"brandBuilding":68,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":78,"awareness":85,"judgement":91},"picture":"Nigel McGuinness.png"},{"id":269,"name":"Prince Nana","realName":"Prince Nana","nickname":"","type":"manager","promotionId":76,"base":"USA","gender":"M","weight":235,"height":177,"dateOfBirth":"1979-08-01T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":29,"charisma":67,"micSkills":59,"condition":80,"hardcoreAbility":48,"injuryProne":98,"ability":56,"currentAbility":43,"potentialAbility":43,"morale":"poor","presentation":"heel","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Prince Nana Osei Bandoh is an American professional wrestler of Ghanaian extraction, better known by his ring name, Prince Nana. He also claims to be an Ashanti prince. Although Nana was born in the United States, he states that he is the son of an Ashanti tribe member with royal heritage and the heir to the throne of Ashanti in Ghana. In 2002, he joined the upstart Ring of Honor promotion, where in 2004 he formed a heel stable known as The Embassy. In storylines, Nana used his wealth gained from the taxes of people of Ghana to hire wrestlers to wrestle his opponents and rivals. Under his management John Walters defended his ROH Pure Championship and Jimmy Rave, Alex Shelley and Abyss won the Trios Tournament in 2006. He remained with Ring of Honor until September 2006, when he gave his notice. On October 24, 2008, in Danbury, Connecticut, Nana made a surprise return to Ring of Honor, saying he has no more riches, no more crown, and just wants a job before he was dragged away.","alterEgos":[],"birthplace":"Brooklyn, New York, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-269","wrestlerId":269,"promotionId":76,"startDate":"2022-12-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":55,"storytelling":57,"productFit":100,"riskTaking":28,"matchLayout":58,"psychology":55,"workerManagement":100,"trainingIntensity":53,"technicalCoaching":41,"characterCoaching":84,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":84,"brandBuilding":55,"socialMediaSavvy":77,"ruleKnowledge":0,"positioning":20,"reactionSpeed":53,"consistency":53,"awareness":55,"judgement":73},"picture":"Prince Nana.png"},{"id":270,"name":"RD Evans","realName":"RD Evans","nickname":"","type":"writer","promotionId":76,"base":"Canada","gender":"M","weight":198,"height":185,"dateOfBirth":"1983-10-19T00:00:00.000Z","debut":"2001-02-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":3,"charisma":85,"micSkills":93,"condition":86,"hardcoreAbility":71,"injuryProne":100,"ability":77,"currentAbility":65,"potentialAbility":65,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Robert D. Evans is a Canadian professional wrestler, also known by the ring names Archibald Peck and \"Barrister\" R.D. Evans. Evans has spent most of his career working for several independent promotions in Texas, but in 2011 also started working in the Northeastern United States, making his debut as a non-wrestling manager R.D. Evans for Ring of Honor (ROH) and as the marching band leader Archibald Peck for Chikara. On March 27, 2010, Evans made his debut for Ring of Honor (ROH), working in a dark match, where he, David E. Jones and Ryan Stone were defeated by Johnny Goodtime, Johnny Yuma and Mike Sydal. On January 28, 2011, Philadelphia, Pennsylvania-based Chikara began airing videos on the promotion's official YouTube channel, hyping the upcoming debut of \"The Band\". The videos eventually led to Evans' debut as marching band leader Archibald Peck, accompanied by his majorette Veronica.","alterEgos":["Mysterious & Handsome Stranger","Archibald Peck","The Latvian Proud Oak"],"birthplace":"Canada","managerId":0,"contractExpiryDate":"2026-06-01T00:00:00.000Z","contract":{"id":"tew-contract-270","wrestlerId":270,"promotionId":76,"startDate":"2024-06-01T00:00:00.000Z","endDate":"2026-06-01T00:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1218],"staffAttributes":{"bookingLogic":66,"storytelling":70,"productFit":100,"riskTaking":30,"matchLayout":72,"psychology":66,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":40,"characterCoaching":66,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":66,"brandBuilding":35,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":75,"awareness":66,"judgement":80},"picture":"RD Evans.png"},{"id":271,"name":"Rhett Titus","realName":"Rhett Titus","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":227,"height":185,"dateOfBirth":"1987-09-15T00:00:00.000Z","debut":"2006-01-01T00:00:00.000Z","wage":37500,"popularity":7,"charisma":61,"micSkills":48,"condition":100,"hardcoreAbility":67,"injuryProne":100,"ability":62,"currentAbility":56,"potentialAbility":60,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Rhett Titus is an American wrestler who works in America and Canada. He is a Lightweight who is classed as using a Entertainer style. He is best known for his work with NWA, ROH, GCW, HOH, Beyond, ICW NHB and CHIKARA. He is married to someone outside the wrestling business. He is the protege of Austin Aries.","alterEgos":["The Romantic Touch"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[924,1683],"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit":100,"riskTaking":19,"matchLayout":62,"psychology":56,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":58,"characterCoaching":75,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":75,"brandBuilding":53,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":61,"awareness":56,"judgement":74},"picture":"Rhett Titus_alt1.png"},{"id":272,"name":"Rhino","realName":"Rhino","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":295,"height":175,"dateOfBirth":"1975-10-07T00:00:00.000Z","debut":"1994-09-01T00:00:00.000Z","wage":37500,"popularity":25,"charisma":51,"micSkills":68,"condition":74,"hardcoreAbility":50,"injuryProne":100,"ability":59,"currentAbility":41,"potentialAbility":93,"morale":"poor","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Rhyno began his career wrestling for small companies in Canada where he became close friends with future ring allies Christian and WWE Hall of Famer Edge, but he first rose to national prominence in the original incarnation of Extreme Championship Wrestling. Debuting in mid-1999, the powerhouse took the renegade company by storm as he destroyed Extreme icons like Raven, Tommy Dreamer and The Sandman. Soon, even the highly-passionate hardcore fan base began to take notice of the devastating and impactful “GORE!”\r\n\r\nRhyno didn’t just defeat opponents. He ended them – barreling through his rivals like a full-steam-ahead locomotive. At CyberSlam 2000, he defeated Yoshihiro Tajiri for the ECW Television Championship. Over the ensuing months, Rhyno defended his title against all comers, including Jerry Lynn, Raven, Mikey Whipwreck, New Jack, Spike Dudley and even Rob Van Dam – who had vacated the title after a 23-month reign – but all were unable to topple The Man Beast.","alterEgos":["Rhyno"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1322,1421,2419,2420],"staffAttributes":{"bookingLogic":72,"storytelling":74,"productFit":100,"riskTaking":20,"matchLayout":75,"psychology":72,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":42,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":70,"brandBuilding":67,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":74,"awareness":72,"judgement":83},"picture":"Rhino_alt5.png"},{"id":273,"name":"Roderick Strong","realName":"Roderick Strong","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":200,"height":175,"dateOfBirth":"1983-07-26T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":37,"charisma":87,"micSkills":100,"condition":76,"hardcoreAbility":91,"injuryProne":100,"ability":73,"currentAbility":73,"potentialAbility":86,"morale":"fair","presentation":"face","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Roderick Strong, The Undisputed ERA’s Messiah of the Backbreaker, is a chiropractor’s worst nightmare. His opponents don’t like him much either.\r\n\r\nThat’s for good reason: Since entering the sport as a teenager, Strong has evolved into one of the ring’s hardest-hitting and best-conditioned Superstars, making him almost impossible to keep up with. And with his fellow Undisputed ERA members always keeping a watchful eye, Strong operates with the confidence of a man who knows he has backup whenever he needs it — not that Strong needs backup to be a threat.\r\n\r\nHaving waged wars against the likes of AJ Styles, Daniel Bryan and Seth Rollins on the independent circuit, Strong brought a wealth of experience when he arrived to the black-and-gold brand in 2016. He became an NXT Title contender from almost the instant he showed up, embarking on competitive, if unsuccessful, runs against NXT Champions like Bobby Roode and Drew McIntyre.","alterEgos":[],"birthplace":"Eau Claire, Wisconsin, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-273","wrestlerId":273,"promotionId":76,"startDate":"2023-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1033,1074,1259,1445,1446,1762,2820,4175],"staffAttributes":{"bookingLogic":74,"storytelling":77,"productFit":100,"riskTaking":15,"matchLayout":78,"psychology":74,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":77,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":64,"brandBuilding":45,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":94,"awareness":74,"judgement":84},"picture":"Roderick Strong.png"},{"id":275,"name":"Shelton Benjamin","realName":"Shelton Benjamin","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":248,"height":185,"dateOfBirth":"1975-07-09T00:00:00.000Z","debut":"2000-11-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":39,"charisma":93,"micSkills":94,"condition":77,"hardcoreAbility":100,"injuryProne":100,"ability":74,"currentAbility":74,"potentialAbility":86,"morale":"fair","presentation":"face","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"There are few stories in WWE history quite like that of Shelton Benjamin. Growing up on the dangerous streets of urban Orangeburg, S.C., he lived in an area known for drug trafficking and weapons use, but rather than ending up on the wrong side of the tracks, he was accepted to the University of Minnesota, continuing his career as a stand-out amateur wrestler and eventually becoming a WWE Superstar.\r\n\r\nBenjamin parted ways with WWE in 2010 but went on to compete all over the world, including New Japan Pro Wrestling, where he continued to dazzle crowds with his athleticism and appetite for risk-taking. After seven years of globetrotting, Benjamin returned to WWE in 2017, joining the SmackDown LIVE roster to team with former Olympic wrestler Chad Gable. Once again rolling solo, Benjamin is determined to seize the championship opportunities he feels are owed to him on the red brand.","alterEgos":["Shelton X Benjamin"],"birthplace":"Orangeburg, South Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-275","wrestlerId":275,"promotionId":76,"startDate":"2024-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1225,1671,2441,2624,2625,2626,2780,4281],"staffAttributes":{"bookingLogic":70,"storytelling":74,"productFit":100,"riskTaking":18,"matchLayout":76,"psychology":70,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":72,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":61,"brandBuilding":68,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":81,"awareness":70,"judgement":82},"picture":"Shelton Benjamin.png"},{"id":276,"name":"Steve Corino","realName":"Steve Corino","nickname":"","type":"writer","promotionId":65,"base":"Canada","gender":"M","weight":242,"height":187,"dateOfBirth":"1973-05-29T00:00:00.000Z","debut":"1994-04-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":18,"charisma":100,"micSkills":89,"condition":65,"hardcoreAbility":98,"injuryProne":100,"ability":83,"currentAbility":54,"potentialAbility":56,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Steven \"Steve\" Eugene Corino is a Canadian professional wrestler, who worked for Pro Wrestling Zero1 and numerous independent promotions. Corino is a four-time world heavyweight champion, having held the NWA World Heavyweight Championship and the ECW World Heavyweight Championship once each and the WWC Universal Heavyweight Championship twice. Corino began wrestling in 1994 and spent four years working on the independent circuit. During this time, he was a part of the Organization of Modern Extreme Grappling Arts, a promotion run by Matt and Jeff Hardy. Corino began an anti-hardcore gimmick on the independent circuit, because he felt he would have more chance of getting work if he did not work hardcore matches. In 1998, Corino debuted in Extreme Championship Wrestling as a heel manager.","alterEgos":["Mr. Wrestling III"],"birthplace":"Winnipeg, Manitoba, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-276","wrestlerId":276,"promotionId":65,"startDate":"2020-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1006,1360],"staffAttributes":{"bookingLogic":79,"storytelling":81,"productFit":100,"riskTaking":20,"matchLayout":82,"psychology":79,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":60,"characterCoaching":79,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":79,"brandBuilding":46,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":74,"awareness":79,"judgement":87},"picture":"Steve Corino_alt10.png"},{"id":277,"name":"Todd Sinclair","realName":"Todd Sinclair","nickname":"","type":"referee","base":"USA","gender":"M","weight":141,"height":167,"dateOfBirth":"1971-01-02T00:00:00.000Z","debut":"2001-01-01T00:00:00.000Z","wage":66000,"popularity":3,"charisma":27,"micSkills":47,"condition":100,"hardcoreAbility":41,"injuryProne":100,"ability":47,"currentAbility":29,"potentialAbility":31,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"As ROH's Senior Official, Todd Sinclair is the man many wrestlers will unquestionable refer to as the best referee in the business.  Sinclair has officiated more ROH title bouts than any other man, and can always be counted on to call every match right down the middle.  He, just like Bobby Cruise, has become a staple of Ring of Honor live events, iPPVs, & television broadcasts, and the man nicknamed \"Fat Pants\" is truly beloved by the ROH faithful.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":2,"storytelling":4,"productFit":0,"riskTaking":99,"matchLayout":5,"psychology":2,"workerManagement":0,"trainingIntensity":2,"technicalCoaching":0,"characterCoaching":35,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":1,"mediaHandling":35,"brandBuilding":12,"socialMediaSavvy":34,"ruleKnowledge":37,"positioning":30,"reactionSpeed":2,"consistency":2,"awareness":2,"judgement":1},"picture":"Todd Sinclair.png"},{"id":278,"name":"Tommaso Ciampa","realName":"Tommaso Ciampa","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":205,"height":180,"dateOfBirth":"1985-05-08T00:00:00.000Z","debut":"2005-01-01T00:00:00.000Z","wage":60000,"wageType":"monthly","popularity":36,"charisma":77,"micSkills":77,"condition":64,"hardcoreAbility":96,"injuryProne":98,"ability":77,"currentAbility":77,"potentialAbility":80,"morale":"fair","presentation":"heel","prestige":"low","style":"striker","cardPosition":"mid","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tommaso Ciampa is the type of Superstar you should keep an eye on. Not only because he’s supremely talented, but because he’ll stab you in the back when you’re not looking if you get in his way.\r\n\r\nIt was that cutthroat competitive nature that helped transform Ciampa from an unsigned free agent into the self-proclaimed “Greatest Sports-Entertainer of All Time,” a standard-bearer for the gold-and-black brand, and one of the most influential NXT Champions of all time. Indeed, when Ciampa arrived in NXT, it was without a contract. Instead, all he was promised was a chance to prove himself to NXT’s powers-that-be. He united with fellow independent wrestling standout Johnny Gargano in the inaugural Dusty Rhodes Tag Team Classic, and it didn’t take long for the team eventually known as #DIY to earn full-time spots on the NXT roster, as well as a memorable reign as NXT Tag Team Champions.","alterEgos":[],"birthplace":"Boston, Massachusetts, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-278","wrestlerId":278,"promotionId":76,"startDate":"2026-01-28T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[906,1421,2331,3856],"staffAttributes":{"bookingLogic":75,"storytelling":77,"productFit":100,"riskTaking":22,"matchLayout":78,"psychology":75,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":64,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":63,"brandBuilding":66,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":82,"awareness":75,"judgement":85},"picture":"Tommaso Ciampa.png"},{"id":279,"name":"Truth Martini","realName":"Truth Martini","nickname":"","type":"manager","base":"USA","gender":"M","weight":196,"height":170,"dateOfBirth":"1975-05-08T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","wage":66000,"popularity":3,"charisma":41,"micSkills":49,"condition":98,"hardcoreAbility":43,"injuryProne":100,"ability":46,"currentAbility":32,"potentialAbility":32,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Martin Krcaj is an Albanian-American professional wrestler, manager and trainer. He is perhaps best known for his time as a manager at Ring of Honor for the stable The House of Truth. He made his professional wrestling debut for Insane Championship Wrestling losing to Andy Muscat in a high school. He later joined Juggalo Championship Wrestling and participated in their first show. Krcaj adopted the gimmick of Doink the Clown and teamed with another Doink who was Tarek The Great. Truth teamed up with Chris Sabin in their first match for Independent Wrestling Revolution where they would be defeated by Frankie The Face & Jaimy Coxxx. On December 15, 2005 N8 Mattson & Truth Martini defeated Gary Havok & The Golden Ninja in their debut match for AAW. A self-professed Life Intervention Expert, Truth Martini and his House of Truth stormed onto the scene of Ring of Honor in 2009.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":65,"storytelling":70,"productFit":100,"riskTaking":28,"matchLayout":71,"psychology":65,"workerManagement":100,"trainingIntensity":59,"technicalCoaching":48,"characterCoaching":66,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":66,"brandBuilding":40,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":59,"consistency":80,"awareness":65,"judgement":79},"picture":"Truth Martini_alt1.png"},{"id":280,"name":"Veda Scott","realName":"Veda Scott","nickname":"","type":"commentator","promotionId":77,"base":"USA","gender":"M","weight":114,"height":152,"dateOfBirth":"1984-01-01T00:00:00.000Z","debut":"2010-03-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","popularity":5,"charisma":59,"micSkills":56,"condition":100,"hardcoreAbility":61,"injuryProne":100,"ability":63,"currentAbility":54,"potentialAbility":57,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"A graduate of the Ring of Honor Wrestling Academy under Delirious and Daizee Haze, Veda Scott might be new to the sport...but her knowledge of professional wrestling is anything but immature. After two decades of just watching from the sidelines (or, more aptly, the TV), Veda knew she had to get the rest of the story firsthand - even if it means a few bumps and bruises along the way.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-280","wrestlerId":280,"promotionId":77,"startDate":"2022-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2231,2282,2863],"staffAttributes":{"bookingLogic":43,"storytelling":47,"productFit":100,"riskTaking":32,"matchLayout":49,"psychology":43,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":35,"characterCoaching":73,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":73,"brandBuilding":50,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":52,"awareness":43,"judgement":66},"picture":"Veda Scott.png"},{"id":281,"name":"ACH","realName":"ACH","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":200,"height":172,"dateOfBirth":"1987-12-07T00:00:00.000Z","debut":"2007-02-01T00:00:00.000Z","wage":37500,"popularity":19,"charisma":65,"micSkills":66,"condition":88,"hardcoreAbility":53,"injuryProne":100,"ability":64,"currentAbility":58,"potentialAbility":72,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Known for bombarding adversaries with a variety of 450º splashes and signature moves like the Dragon Ball Z (multiple elbows to a cornered opponent followed by a running thrust attack), ACH is a powerhouse anime character come to life. Wowing crowds around the world, ACH is a dynamic athlete with a vertical leap that would make NFL and NBA players envious. Combining uncanny agility with blistering strikes, ACH is the evolution of the modern-day fighter. ACH is supremely humble and respectful to his opponents. But don’t let that fool you. This Austin, Texas native is a beast once the bell rings. Once you see ACH take flight, you’ll agree that this hybrid wrestler is in fact “SUUUUUUUPER”!","alterEgos":["Jordan Myles"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[918,1658,1797,2732],"staffAttributes":{"bookingLogic":53,"storytelling":61,"productFit":100,"riskTaking":24,"matchLayout":63,"psychology":53,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":58,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":58,"brandBuilding":52,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":70,"awareness":53,"judgement":72},"picture":"ACH.png"},{"id":284,"name":"Bruce Prichard","realName":"Bruce Prichard","nickname":"","type":"writer","promotionId":64,"base":"USA","gender":"M","weight":249,"height":180,"dateOfBirth":"1963-03-07T00:00:00.000Z","debut":"1981-03-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":10,"charisma":90,"micSkills":89,"condition":100,"hardcoreAbility":82,"injuryProne":63,"ability":94,"currentAbility":45,"potentialAbility":47,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Bruce Prichard is a professional wrestling personality, best known as a manager and producer for World Wrestling Entertainment (formerly the World Wrestling Federation), where he portrayed Brother Love, the original manager of The Undertaker. Prichard began his career working for Paul Boesch out of Houston, Texas, as a ring announcer and sometimes referee. Due to Boesch's working relationship with Bill Watts' Universal Wrestling Federation in the 1980s, Prichard would also act as ring announcer for some UWF shows. In June 1988, Prichard debuted as Brother Love, a red-faced, smarmy, effusive and boisterous \"preacher\" character dressed in a conspicuous white suit, tight red shirt and white tie, who claimed to preach not the word of God, but \"the word of love\". On October 17, 2011, Total Nonstop Action Wrestling sent out a press release stating that Prichard was promoted to Senior Vice President, Programming & Talent Relations.","alterEgos":["Brother Love"],"birthplace":"El Paso, Texas, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-284","wrestlerId":284,"promotionId":64,"startDate":"2019-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":75,"storytelling":64,"productFit":100,"riskTaking":40,"matchLayout":60,"psychology":75,"workerManagement":100,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":65,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":65,"brandBuilding":18,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":0,"consistency":41,"awareness":75,"judgement":85},"picture":"Bruce Prichard.png"},{"id":285,"name":"Cliff Compton","realName":"Cliff Compton","nickname":"","type":"commentator","base":"USA","gender":"M","weight":240,"height":185,"dateOfBirth":"1979-11-02T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","wage":66000,"popularity":4,"charisma":29,"micSkills":34,"condition":78,"hardcoreAbility":11,"injuryProne":100,"ability":14,"currentAbility":11,"potentialAbility":11,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Clifford \"Cliff\" Compton, is an American professional wrestler. He is best known for his work in World Wrestling Entertainment (WWE), as a performer for its SmackDown brand. Before being promoted to the main WWE roster, Compton was assigned to WWE's developmental territory OVW in Louisville, Kentucky in 2005. While situated at OVW, he wrestled under the name Dice Domino and was placed in tag team competition, alongside Deuce Shade. Together, the pair won the OVW Southern Tag Team Championship on three occasions. It was also during this time that he and Deuce, alongside their manager Cherry, were known as \"The Throw-Backs\" and later as \"The Untouchables\".","alterEgos":["Domino"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":56,"storytelling":59,"productFit":100,"riskTaking":30,"matchLayout":60,"psychology":56,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":24,"characterCoaching":67,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":67,"brandBuilding":34,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":59,"awareness":56,"judgement":74},"picture":"Cliff Compton_alt.png"},{"id":286,"name":"Matt Hardy","realName":"Matt Hardy","nickname":"","type":"wrestler","promotionId":28,"base":"USA","gender":"M","weight":236,"height":185,"dateOfBirth":"1974-09-23T00:00:00.000Z","debut":"1992-10-01T00:00:00.000Z","wage":41000,"wageType":"per-appearance","popularity":41,"charisma":59,"micSkills":68,"condition":51,"hardcoreAbility":67,"injuryProne":100,"ability":50,"currentAbility":50,"potentialAbility":72,"morale":"fair","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Matthew \"Matt\" Moore Hardy (born September 23, 1974) is an American professional wrestler. Besides his WWE career, Hardy, with his brother Jeff, founded a wrestling organization called Organization of Modern Extreme Grappling Arts (OMEGA). While there, Matt held many championships including the Heavyweight and Tag Team Championship (with Jeff). The promotion folded in October 1999 when they signed contracts with WWE. The Hardys gained notoriety in WWE's tag team division due to their participation in Tables, Ladders, and Chairs matches. As a tag team wrestler, Hardy is a six time World Tag Team Champion, a one time WWE Tag Team Champion, and a one time WCW Tag Team Champion.","alterEgos":[],"birthplace":"Cameron, North Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-286","wrestlerId":286,"promotionId":28,"startDate":"2024-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":41000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[164,1398,1434,1436,1624,1749,3454,3470],"staffAttributes":{"bookingLogic":75,"storytelling":77,"productFit":100,"riskTaking":38,"matchLayout":78,"psychology":75,"workerManagement":100,"trainingIntensity":54,"technicalCoaching":56,"characterCoaching":84,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":84,"brandBuilding":55,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":20,"reactionSpeed":54,"consistency":58,"awareness":75,"judgement":85},"picture":"Matt Hardy.png"},{"id":287,"name":"Mike Mondo","realName":"Mike Mondo","nickname":"","type":"wrestler","promotionId":79,"base":"USA","gender":"M","weight":220,"height":172,"dateOfBirth":"1983-03-26T00:00:00.000Z","debut":"2002-06-01T00:00:00.000Z","wage":16400,"wageType":"per-appearance","popularity":3,"charisma":68,"micSkills":72,"condition":75,"hardcoreAbility":57,"injuryProne":100,"ability":69,"currentAbility":58,"potentialAbility":61,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Michael \"Mike\" Brendli is an American professional wrestler who performed for Florida Championship Wrestling in development with World Wrestling Entertainment as \"The Professional\" Mike Mondo. Brendli is also known for his time as Spirit Squad member Mikey on the Raw brand. After training at the Critical Mass Wrestling School, he debuted in June 2002 and began working for several independent promotions as Mike Mondo, Livewyre, or El Livewyre. His earliest success came in the New York Wrestling Connection promotion, where he won the NYWC Heavyweight Championship on two occasions between 2003 and 2005. In February 2005, he signed a contract with WWE, and was assigned to the Ohio Valley Wrestling (OVW) developmental territory. In OVW, he formed the Spirit Squad faction with four other wrestlers. In late 2011, Brendli returned to Ring of Honor as a full-time member, under his 'Mike Mondo' personality.","alterEgos":["Mikey"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-10-06T00:00:00.000Z","contract":{"id":"tew-contract-287","wrestlerId":287,"promotionId":79,"startDate":"2024-10-06T00:00:00.000Z","endDate":"2026-10-06T00:00:00.000Z","wage":16400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[271,1328,1908,3214],"staffAttributes":{"bookingLogic":56,"storytelling":61,"productFit":100,"riskTaking":25,"matchLayout":62,"psychology":56,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":58,"characterCoaching":55,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":55,"brandBuilding":52,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":73,"awareness":56,"judgement":74},"picture":"Mike Mondo_alt3.png"},{"id":289,"name":"Matt Taven","realName":"Matt Taven","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":218,"height":185,"dateOfBirth":"1985-03-20T00:00:00.000Z","debut":"2008-03-01T00:00:00.000Z","wage":37500,"popularity":25,"charisma":53,"micSkills":67,"condition":88,"hardcoreAbility":45,"injuryProne":100,"ability":58,"currentAbility":51,"potentialAbility":74,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"He’s Matt Taven, and he’s one of the most decorated competitors in Ring of Honor. Taven is the second Grand Slam Champion in company history, having held the ROH World Title, Television Title, Tag Team Titles and Six-Man Tag Team Titles. The leader of The Kingdom also is one of only three men to have held championships in ROH, NJPW in Japan and CMLL in Mexico.\r\n\r\nTaven broke through in 2013 when he won ROH’s Top Prospect Tournament. As a result of that triumph, Taven received a shot at then-ROH World Television Champion Adam Cole. Not only did Taven win the title, but he would hold it for a then-record 287 days. Taven later joined forces with Cole, Michael Bennett and Maria Kanellis to form The Kingdom, which became one of the top factions in ROH. After that version of The Kingdom disbanded, Taven formed a new Kingdom in his own image with Vinny Marseglia and TK O’Ryan.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1456,1457,3370,3385,3386,3622,4206],"staffAttributes":{"bookingLogic":62,"storytelling":64,"productFit":100,"riskTaking":20,"matchLayout":65,"psychology":62,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":61,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":61,"brandBuilding":58,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":81,"awareness":62,"judgement":77},"picture":"Matt Taven_alt8.png"},{"id":291,"name":"Bobby Fish","realName":"Bobby Fish","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":197,"height":177,"dateOfBirth":"1976-10-27T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","wage":37500,"popularity":27,"charisma":54,"micSkills":65,"condition":69,"hardcoreAbility":82,"injuryProne":100,"ability":75,"currentAbility":53,"potentialAbility":75,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Bobby Fish is an American wrestler who works in America, Canada and Japan. He is a Lightweight who is classed as using a Technician style. He is best known for his work with NJPW, AEW, NOAH, NXT, ROH, NJoA and MLW. He is married to someone outside the wrestling business.","alterEgos":["Jerk Jackson"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1288,1289,1635,3429],"staffAttributes":{"bookingLogic":70,"storytelling":74,"productFit":100,"riskTaking":20,"matchLayout":75,"psychology":70,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":65,"characterCoaching":46,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":46,"brandBuilding":42,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":78,"awareness":70,"judgement":82},"picture":"Bobby Fish_alt11.png"},{"id":292,"name":"Adam Copeland","realName":"Adam Copeland","nickname":"","type":"wrestler","promotionId":76,"base":"Canada","gender":"M","weight":238,"height":190,"dateOfBirth":"1973-10-30T00:00:00.000Z","debut":"1992-07-01T00:00:00.000Z","wage":80000,"wageType":"monthly","popularity":63,"charisma":100,"micSkills":89,"condition":68,"hardcoreAbility":86,"injuryProne":98,"ability":72,"currentAbility":72,"potentialAbility":94,"morale":"good","presentation":"face","prestige":"mid","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Beyond his ability to capitalize on opportunities, Edge became known as The Master Manipulator because he wasn't afraid to cross the line in order to rattle the competition. After he made history in 2006 as the first man to ever cash in the Money in the Bank briefcase, he rubbed his WWE Championship triumph in the face of all challengers with an R-rated celebration on Raw; more explicitly, a frolicking good time with Lita on a bed placed right in the middle of the squared circle. Mind games were taken to a whole new level by the self-proclaimed \"most-watched champion.\"\r\n\r\nA debilitating injury forced Edge to retire in 2011, but in the 2020 Royal Rumble Match, The Ultimate Opportunist made a surprise return. Former Rated-RKO partner Randy Orton claimed that he wanted to send Edge back into retirement for his own good, but he was thwarted when The Ultimate Opportunist outlasted The Viper in a brutal Last Man Standing Match at WrestleMania 36.","alterEgos":["Edge","Cope"],"birthplace":"Orangeville, Ontario, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-292","wrestlerId":292,"promotionId":76,"startDate":"2023-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":80000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1039,1287,4268],"staffAttributes":{"bookingLogic":83,"storytelling":84,"productFit":100,"riskTaking":19,"matchLayout":84,"psychology":83,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":59,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":85,"brandBuilding":78,"socialMediaSavvy":84,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":75,"awareness":83,"judgement":90},"picture":"Adam Copeland.png"},{"id":293,"name":"Ted Dibiase Sr.","realName":"Ted Dibiase Sr.","nickname":"","type":"scout","base":"USA","gender":"M","weight":260,"height":182,"dateOfBirth":"1954-01-18T00:00:00.000Z","debut":"1975-06-01T00:00:00.000Z","wage":66000,"popularity":25,"charisma":63,"micSkills":65,"condition":54,"hardcoreAbility":82,"injuryProne":53,"ability":69,"currentAbility":32,"potentialAbility":32,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Theodore Marvin \"Ted\" DiBiase, Sr.  is a retired professional wrestler, manager, and color commentator. DiBiase achieved championship success in a number of well-known promotions, but is best recalled to mainstream audiences for his time in the WWF, where he wrestled as \"The Million Dollar Man\" Ted DiBiase. Among other accolades in the WWF, DiBiase was the first WWF North American Heavyweight Champion, a three-time WWF Tag Team Champion (with Irwin R. Schyster) and the 1988 King of the Ring. DiBiase also created his own championship, the Million Dollar Championship. He was well known for his cutting-edge heel promos, which were often concluded with his trademark evil laugh; DiBiase has been described by WWE as the organization's \"most despised villain\" during the late 1980s.","alterEgos":["Million Dollar Man"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1228,3016,3110],"staffAttributes":{"bookingLogic":34,"storytelling":53,"productFit":20,"riskTaking":33,"matchLayout":24,"psychology":41,"workerManagement":45,"trainingIntensity":60,"technicalCoaching":58,"characterCoaching":26,"teaching":35,"diagnosis":46,"rehabilitation":30,"prevention":26,"mediaHandling":53,"brandBuilding":55,"socialMediaSavvy":30,"ruleKnowledge":25,"positioning":56,"reactionSpeed":53,"consistency":41,"awareness":35,"judgement":65},"picture":"Ted DiBiase Sr..png"},{"id":294,"name":"Tom Prichard","realName":"Tom Prichard","nickname":"","type":"writer","promotionId":68,"base":"USA","gender":"M","weight":230,"height":175,"dateOfBirth":"1959-08-18T00:00:00.000Z","debut":"1979-10-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","popularity":10,"charisma":100,"micSkills":100,"condition":83,"hardcoreAbility":97,"injuryProne":83,"ability":100,"currentAbility":46,"potentialAbility":46,"morale":"broken","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Tom Prichard is a retired American wrestler who works primarily as a road agent. He is best known for his work with WWE, NJPW, AJPW, wXw and MLW.","alterEgos":["Zip"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-294","wrestlerId":294,"promotionId":68,"startDate":"2019-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":88,"storytelling":89,"productFit":100,"riskTaking":15,"matchLayout":89,"psychology":88,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":42,"characterCoaching":53,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":53,"brandBuilding":28,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":51,"consistency":54,"awareness":88,"judgement":93},"picture":"Tom Prichard.png"},{"id":297,"name":"Johnny TV","realName":"John Hennigan","nickname":"","type":"wrestler","promotionId":49,"base":"USA","gender":"M","weight":211,"height":182,"dateOfBirth":"1979-10-03T00:00:00.000Z","debut":"2003-01-01T00:00:00.000Z","wage":32800,"wageType":"per-appearance","popularity":40,"charisma":85,"micSkills":83,"condition":79,"hardcoreAbility":69,"injuryProne":100,"ability":62,"currentAbility":62,"potentialAbility":90,"morale":"fair","presentation":"heel","prestige":"mid","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"As his theme music reminds us, John Morrison “ain’t no make believe.” However, his lightning-fast offense and high-risk aerial expertise can make the WWE Universe wonder if their eyes are playing tricks on them every time he enters the ring. Hailing from sunny Los Angeles, The Guru of Greatness exudes Hollywood flash, from his colorful entrances to his attention-grabbing ring attire. But there's more to Morrison than his unique fashion sense and penchant for pyrotechnics. Schooled in the French discipline of parkour, which emphasizes freedom of movement, Morrison excels in just about any environment imaginable, performing athletic feats previously unseen in WWE. His rigorous training regimen and incredible agility earned this exciting Superstar a wholly appropriate nickname: The Prince of Parkour.","alterEgos":["John Hennigan","John Morrison","Johnny Mundo","Johnny Impact","Johnny Caballero","Johnny Game Changer","Johnny Progress","Johnny Downunder","Johnny Beyond","Johnny Black Label","Johnny Dramatic","Johnny Defy","Johnny Dragon","Johnny FREEDOMS","Johnny Ganbare","Johnny Gatoh","Johnny GLEAT","Johnny Japan","Johnny North","Johnny Guerrilla","Johnny Revolution","Johnny Consejo"],"birthplace":"Los Angeles, California, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-297","wrestlerId":297,"promotionId":49,"startDate":"2023-12-07T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32800,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1226,1468],"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":19,"matchLayout":68,"psychology":62,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":56,"characterCoaching":69,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":69,"brandBuilding":76,"socialMediaSavvy":52,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":63,"awareness":62,"judgement":77},"picture":"Johnny TV.png","additionalContracts":[{"id":"tew-contract-297-76","wrestlerId":297,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-297-118","wrestlerId":297,"promotionId":118,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":10500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW","MLP"]},{"id":298,"name":"Ken Shamrock","realName":"Ken Shamrock","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":243,"height":182,"dateOfBirth":"1964-02-11T00:00:00.000Z","debut":"1988-01-01T00:00:00.000Z","wage":37500,"popularity":31,"charisma":68,"micSkills":45,"condition":56,"hardcoreAbility":71,"injuryProne":84,"ability":69,"currentAbility":34,"potentialAbility":86,"morale":"poor","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"In the late 1990s, an unmistakable and thundering guitar riff marked the coming of The World’s Most Dangerous Man, Ken Shamrock. The memorable entrance theme signaled an unbridled intensity that Shamrock brought to the squared circle — a competitive nature forged through his mixed martial arts discipline and WWE career.\r\n\r\nThe leader of the Lion’s Den training camp for fighters made a name for himself in the early days of UFC. Shamrock’s rivalry with MMA legend Royce Gracie established him as one of the organizations first and biggest stars. In 1995, Shamrock became the UFC’s first champion outside of tournament competition, winning the Superfight Championship before competitors were divided by weight class. Establishing a hall of fame career in UFC, The World’s Most Dangerous Man decided to move on to a then-grander stage in 1997 by joining WWE.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2158],"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":38,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":53,"technicalCoaching":53,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":64,"brandBuilding":65,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":53,"consistency":42,"awareness":63,"judgement":78},"picture":"Ken Shamrock_alt1.png"},{"id":299,"name":"Davey Boy Smith Jr.","realName":"Davey Boy Smith Jr.","nickname":"","type":"wrestler","base":"Canada","gender":"M","weight":260,"height":193,"dateOfBirth":"1985-08-02T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":37500,"popularity":24,"charisma":54,"micSkills":76,"condition":84,"hardcoreAbility":54,"injuryProne":100,"ability":69,"currentAbility":60,"potentialAbility":73,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Davey Boy Smith Jr. is a Canadian wrestler who works in America, Canada, the British Isles, Japan and India. He is a Light Heavyweight who is classed as using a Technician style. He is one half of Killer Elite Squad alongside Lance Archer. He is best known for his work with WWE, NJPW, NOAH, NXT, NWA and MLW.","alterEgos":["David Hart Smith","Harry Smith"],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[816,1003,1136,1138,1437,1509,2087],"staffAttributes":{"bookingLogic":57,"storytelling":63,"productFit":100,"riskTaking":22,"matchLayout":65,"psychology":57,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":56,"characterCoaching":42,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":42,"brandBuilding":68,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":68,"awareness":57,"judgement":74},"picture":"Harry Smith_alt2.png"},{"id":302,"name":"Colt Cabana","realName":"Colt Cabana","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":233,"height":182,"dateOfBirth":"1980-05-06T00:00:00.000Z","debut":"1999-06-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":18,"charisma":62,"micSkills":73,"condition":66,"hardcoreAbility":61,"injuryProne":100,"ability":58,"currentAbility":58,"potentialAbility":70,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Possessing outstanding technical wrestling skills as well as a flair for comedy, Colt Cabana is one of the most distinguished and entertaining competitors in Ring of Honor history. He made his ROH debut in 2002 by defeating fellow Chicago native CM Punk. Several months later, Cabana, Punk and their trainer, Ace Steel, joined forces to form The Second City Saints. Cabana and Punk captured the ROH World Tag Team Titles twice. After leaving ROH in 2011 and becoming one of the most sought-after competitors on the independent and international circuits, Cabana made his return in 2016 and picked up right where he had left off.\r\n\r\nOutside the ring, he hosts the groundbreaking “Art of Wrestling” podcast and has branched out in the entertainment world by performing stand-up comedy. Cabana currently is the lead color commentator for ROH.","alterEgos":["Matt Classic","Scotty Goldman"],"birthplace":"Deerfield, Illinois, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-302","wrestlerId":302,"promotionId":76,"startDate":"2020-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[976,1110,1311,2710,2711,2712],"staffAttributes":{"bookingLogic":75,"storytelling":78,"productFit":100,"riskTaking":23,"matchLayout":79,"psychology":75,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":60,"characterCoaching":81,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":81,"brandBuilding":45,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":69,"awareness":75,"judgement":85},"picture":"Colt Cabana.png"},{"id":303,"name":"Katarina Waters","realName":"Katarina Waters","nickname":"","type":"manager","base":"Europe","gender":"F","weight":140,"height":170,"dateOfBirth":"1980-11-10T00:00:00.000Z","debut":"2000-02-01T00:00:00.000Z","wage":66000,"popularity":12,"charisma":61,"micSkills":67,"condition":88,"hardcoreAbility":64,"injuryProne":100,"ability":52,"currentAbility":41,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Katarina Leigh Waters is a German-born British professional wrestler. She is best known for her time in World Wrestling Entertainment and Total Nonstop Action Wrestling. During her time in WWE, she performed on its Raw brand under the ring name Katie Lea and performed under the ring name Winter, while working in TNA . Prior to signing with WWE, she spent many years on the independent circuit, particularly in the UK based Frontier Wrestling Alliance, where she used the ring name Nikita. On February 25, 2011 Waters made her debut at World Independent Ladies Division in a in ring segment with Tab Jackson and Aiden Riley. On May 14, 2011 at the FWE Meltdown pay-per-view, Waters made her debut for Family Wrestling Entertainment (FWE), defeating Rosita. Winter made her debut for House of Hardcore, on October 6, 2012.","alterEgos":["Katie Lea","Winter"],"birthplace":"Turkey","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2644],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":30,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":57,"characterCoaching":66,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":66,"brandBuilding":60,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":73,"awareness":58,"judgement":75},"picture":"Katie Lea.png"},{"id":304,"name":"Anthony Mayweather","realName":"Anthony Mayweather","nickname":"","type":"trainer","base":"USA","gender":"M","weight":240,"height":193,"dateOfBirth":"1985-02-21T00:00:00.000Z","debut":"2007-01-01T00:00:00.000Z","wage":66000,"popularity":5,"charisma":44,"micSkills":66,"condition":75,"hardcoreAbility":73,"injuryProne":100,"ability":51,"currentAbility":45,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Anthony Mayweather is an American wrestler who works in America and Canada. He is a Heavyweight who is classed as using a Brawler style. He is one half of The War Kings alongside Jax Dane. He is best known for his work with IMPACT and NWA. He is married to someone outside the wrestling business.","alterEgos":["Crimson"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1556,2539,2540],"staffAttributes":{"bookingLogic":59,"storytelling":46,"productFit":32,"riskTaking":54,"matchLayout":51,"psychology":58,"workerManagement":31,"trainingIntensity":76,"technicalCoaching":52,"characterCoaching":65,"teaching":74,"diagnosis":44,"rehabilitation":38,"prevention":53,"mediaHandling":22,"brandBuilding":20,"socialMediaSavvy":25,"ruleKnowledge":26,"positioning":44,"reactionSpeed":33,"consistency":29,"awareness":21,"judgement":53},"picture":"Tommy Mercer_alt1.png"},{"id":305,"name":"Brian Kendrick","realName":"Brian Kendrick","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":175,"height":167,"dateOfBirth":"1979-05-29T00:00:00.000Z","debut":"1999-10-01T00:00:00.000Z","wage":37500,"popularity":23,"charisma":81,"micSkills":52,"condition":74,"hardcoreAbility":61,"injuryProne":100,"ability":72,"currentAbility":55,"potentialAbility":77,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Whether you ask for it or not, The Brian Kendrick is always ready to take you to school, either in a mat-wrestling clinic, or in the form of his veteran teachings.\r\n\r\nThe grizzled veteran of 205 Live, Kendrick began his WWE tenure all the way back in 2002, a run that was highlighted by a pair of tag team championship reigns alongside Paul London and his participation in a Championship Scramble for the WWE Title.\r\n\r\nAfter an extended hiatus from WWE, Kendrick enjoyed an impressive run in WWE’s inaugural Cruiserweight Classic, joined 205 Live and captured the Cruiserweight Championship in short order.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[259,477,1134],"staffAttributes":{"bookingLogic":72,"storytelling":78,"productFit":100,"riskTaking":22,"matchLayout":80,"psychology":72,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":65,"characterCoaching":75,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":57,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":76,"awareness":72,"judgement":83},"picture":"Brian Kendrick_alt9.png"},{"id":307,"name":"Paul London","realName":"Paul London","nickname":"","type":"wrestler","promotionId":68,"base":"USA","gender":"M","weight":180,"height":175,"dateOfBirth":"1980-04-16T00:00:00.000Z","debut":"2000-04-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","popularity":17,"charisma":55,"micSkills":69,"condition":64,"hardcoreAbility":49,"injuryProne":100,"ability":56,"currentAbility":44,"potentialAbility":86,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Paul London is a retired American wrestler who works primarily as a road agent. He was one half of The Hooligans alongside Brian Kendrick. He is best known for his work with IMPACT. He is the protege of Christopher Daniels.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-08-29T00:00:00.000Z","contract":{"id":"tew-contract-307","wrestlerId":307,"promotionId":68,"startDate":"2024-08-29T00:00:00.000Z","endDate":"2026-08-29T00:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[477,1134,1621,1622,2751,2778],"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":24,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":61,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":66,"brandBuilding":53,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":62,"awareness":68,"judgement":81},"picture":"Paul London_alt5.png"},{"id":308,"name":"Hiroshi Tanahashi","realName":"Hiroshi Tanahashi","nickname":"","type":"businessperson","promotionId":38,"base":"Japan","gender":"M","weight":222,"height":177,"dateOfBirth":"1976-11-13T00:00:00.000Z","debut":"1999-10-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":49,"charisma":87,"micSkills":100,"condition":53,"hardcoreAbility":100,"injuryProne":78,"ability":95,"currentAbility":67,"potentialAbility":67,"morale":"fair","presentation":"face","prestige":"mid","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Hiroshi Tanahashi is a Japanese professional wrestler who works primarily for New Japan Pro Wrestling, where he is a former six-time IWGP Heavyweight Champion. Tanahashi shares the record for most reigns as the IWGP Heavyweight Champion with Tatsumi Fujinami, while his fifth reign holds the record for most successful defenses, with eleven. Tanahashi is one of the Four Heroes in New Japan. He is currently the biggest star of the promotion and the company seems to be built around him. Despite losing the title in early 2012, it really hasn't done much to dethrone his top wrestler status, due mostly to his great looks and amazing charisma.","alterEgos":[],"birthplace":"Ōgaki, Gifu, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-308","wrestlerId":308,"promotionId":38,"startDate":"1999-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1141,1142,1253,2085,2781,3020,3021,3657],"staffAttributes":{"bookingLogic":66,"storytelling":79,"productFit":64,"riskTaking":89,"matchLayout":52,"psychology":59,"workerManagement":45,"trainingIntensity":30,"technicalCoaching":60,"characterCoaching":29,"teaching":26,"diagnosis":54,"rehabilitation":56,"prevention":49,"mediaHandling":32,"brandBuilding":60,"socialMediaSavvy":49,"ruleKnowledge":26,"positioning":21,"reactionSpeed":26,"consistency":31,"awareness":59,"judgement":27},"picture":"Hiroshi Tanahashi_alt4.png"},{"id":309,"name":"Kazuchika Okada","realName":"Kazuchika Okada","nickname":"","type":"wrestler","promotionId":76,"base":"Japan","gender":"M","weight":235,"height":187,"dateOfBirth":"1987-11-08T00:00:00.000Z","debut":"2004-08-01T00:00:00.000Z","wage":80000,"wageType":"monthly","popularity":56,"charisma":80,"micSkills":92,"condition":73,"hardcoreAbility":89,"injuryProne":100,"ability":93,"currentAbility":93,"potentialAbility":97,"morale":"good","presentation":"heel","prestige":"mid","style":"submission","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kazuchika Okada, a 2007 graduate of the New Japan Dojo, is a Japanese wrestler who works in America, Canada, Mexico, Japan and Oceania. He is a Middleweight who is classed as using a Impactful style. He is best known for his work with NJPW, AEW, CMLL, IMPACT, ROH, RevPro and MCW. He is currently the IWGP World Heavyweight champion. He is married to someone outside the wrestling business. He was voted Wrestler Of The Year in 2017.","alterEgos":[],"birthplace":"Anjō, Aichi, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-309","wrestlerId":309,"promotionId":76,"startDate":"2024-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":80000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":92,"storytelling":94,"productFit":100,"riskTaking":20,"matchLayout":94,"psychology":92,"workerManagement":100,"trainingIntensity":92,"technicalCoaching":78,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":85,"brandBuilding":93,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":20,"reactionSpeed":92,"consistency":82,"awareness":92,"judgement":95},"picture":"Kazuchika Okada.png"},{"id":310,"name":"Shinsuke Nakamura","realName":"Shinsuke Nakamura","nickname":"","type":"wrestler","promotionId":64,"base":"Japan","gender":"M","weight":220,"height":185,"dateOfBirth":"1980-02-24T00:00:00.000Z","debut":"2002-08-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":60,"charisma":100,"micSkills":90,"condition":64,"hardcoreAbility":94,"injuryProne":100,"ability":71,"currentAbility":71,"potentialAbility":83,"morale":"good","presentation":"face","prestige":"mid","style":"submission","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Known the world over as The King of Strong Style, Shinsuke Nakamura employs a hard-hitting style in the ring, incorporating blistering strikes with submission holds. The crown jewel of his arsenal is a devastating knee strike, which has felled many opponents.\r\n\r\nNakamura’s smashmouth offense, along with an unusual but magnetic charisma, first earned him fame in New Japan Pro Wrestling, where he was a three-time IWGP Heavyweight Champion — a title held by the likes of WWE Hall of Famer Antonio Inoki, Vader, The Great Muta and AJ Styles. He was also the youngest competitor to earn that honor, winning it for the first time at 23. \r\n\r\nCan anyone hit hard enough to slow down The King of Strong Style? Perhaps, but you'll have to be fast enough to hit him at all.","alterEgos":[],"birthplace":"Kyōtango, Kyōto, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-310","wrestlerId":310,"promotionId":64,"startDate":"2016-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2103,2781,2782,3354],"staffAttributes":{"bookingLogic":83,"storytelling":85,"productFit":100,"riskTaking":25,"matchLayout":85,"psychology":83,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":72,"characterCoaching":88,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":88,"brandBuilding":84,"socialMediaSavvy":80,"ruleK