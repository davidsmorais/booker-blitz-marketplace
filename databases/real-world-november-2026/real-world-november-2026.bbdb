 moves. The reigning AAA World Cruiserweight Champion Laredo Kid is arguably AAA’s top luchador. A 13-year veteran, Kid has traveled the world holding titles in Mexico and Puerto Rico. In 2019, Laredo Kid entered MLW, wowing crowds with his rapid aerial attacks using moves like 630º splash. A fan favorite, or técnico, as referred to in Mexico, Laredo Kid’s goal in MLW is to win gold and possibly unify MLW and AAA championships. In 2019, Laredo Kid appeared on the popular Mexican reality show Exathlon, as part of the “celebrity/athlete” Exathlon team on Azteca TV.","alterEgos":[],"birthplace":"Nuevo Laredo, Tamaulipas, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2552","wrestlerId":2552,"promotionId":5,"startDate":"2018-06-03T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1067,4156],"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":24,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":60,"characterCoaching":52,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":52,"brandBuilding":56,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":79,"awareness":68,"judgement":81},"picture":"Laredo Kid.png"},{"id":2553,"name":"Clint Margera","realName":"Clint Margera","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":203,"height":170,"dateOfBirth":"1985-04-15T00:00:00.000Z","debut":"2010-01-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":55,"micSkills":54,"condition":88,"hardcoreAbility":49,"injuryProne":100,"ability":55,"currentAbility":48,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"hardcor