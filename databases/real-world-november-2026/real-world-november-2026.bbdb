0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":50,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":50,"brandBuilding":38,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Fumihito Kihara.png"},{"id":412,"name":"Yasufumi Nakanoue","realName":"Yasufumi Nakanoue","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":242,"height":180,"dateOfBirth":"1986-06-14T00:00:00.000Z","debut":"2010-01-01T00:00:00.000Z","wage":4166,"popularity":4,"charisma":54,"micSkills":65,"condition":94,"hardcoreAbility":50,"injuryProne":100,"ability":60,"currentAbility":53,"potentialAbility":57,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Yasufumi Nakanoue is a Japanese professional wrestler known for his work with AJPW. Yasufumi Nakanoue is a 2nd-year pro who is one of the newest members of All-Japan. He made his debut on January 2, 2010 against Shuji Kondo. He has mainly been used as a jobber, of course, but he did pick up his first career win on June 22 by beating Rene Dupree. He has been stuck in the jobber role thanks in large part to other young wrestlers missing major time due to injuries.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1830],"staffAttributes":{"bookingLogic":57,"storytelling":62,"productFit":87,"riskTaking":28,"matchLayout":63,"psychology":57,"workerManagement":87,"trainingIntensity":75,"technicalCoaching":53,"characterCoaching":44,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":44,"brandBuilding":46,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":17,"reactionSpeed":75,"consistency":76,"awareness":57,"judgement":69},"picture":"Yasufumi Nakanoue.png"},{"id":414,"name":"Nobuo Shiraishi","realName":"Nobuo Shiraishi","nickname":"","type":"writer","base":"Japan","gender":"M","weight":161,"height":162,"dateOfBirth":"1978-05-16T00:00:00.000Z","debut":"2013-05-01T00:00:00.000Z","wage":66000,"popularity":0,"charisma":5,"micSkills":6,"condition":100,"hardcoreAbility":20,"injuryProne":0,"ability":8,"currentAbility":6,"potentialAbility":8,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"On May 1, it was reported that negotiations had started between Speed Partners president Nobuo Shiraishi and All Japan president Masayuki Uchida, which would see Keiji Mutoh regain the promotion's presidency before the end of the month. However, on May 27, it was reported that Shiraishi himself would take over the presidency of All Japan effective June 1. This was later confirmed by All Japan, and led to Keiji Mutoh's resignation from the promotion.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":29,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":29,"brandBuilding":0,"socialMediaSavvy":0,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Nobuo Shiraishi.png"},{"id":415,"name":"Aero Star","realName":"Aero Star","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":152,"height":167,"dateOfBirth":"1984-10-22T00:00:00.000Z","debut":"2003-08-15T00:00:00.000Z","wage":30700,"wageType":"per-appearance","popularity":10,"charisma":64,"micSkills":82,"condition":76,"hardcoreAbility":64,"injuryProne":100,"ability":62,"currentAbility":62,"potentialAbility":65,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Aero Star is a Mexican Luchador enmascarado, or masked professional wrestler, best known for his work in the professional wrestling promotion Asistencia Asesoría y Administración (AAA) as a tecnico. He is a part of the group Real Fuerza Aérea along with Laredo Kid and Argenis. Aerostar won the 2008 Alas de Oro tournament and is known for his high risk moves off the top rope or off the arena's lighing structure. In July 2011, Aero Star and Jack Evans traveled to Japan to represent AAA in Pro Wrestling Noah's 2011 Nippon TV Cup Jr. Heavyweight Tag League. After two wins and two losses, the team finished third in their block, missing the finals of the tournament.","alterEgos":[],"birthplace":"Mexico City, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-415","wrestlerId":415,"promotionId":5,"startDate":"2003-08-15T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1757,2523,2524],"staffAttributes":{"bookingLogic":66,"storytelling":70,"productFit":100,"riskTaking":40,"matchLayout":72,"psychology":66,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":63,"characterCoaching":60,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":60,"brandBuilding":62,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":55,"awareness":66,"judgement":80},"picture":"Aerostar.png"},{"id":418,"name":"Raptor","realName":"Raptor","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":165,"height":162,"dateOfBirth":"1991-09-11T00:00:00.000Z","debut":"2003-11-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":63,"micSkills":35,"condition":88,"hardcoreAbility":38,"injuryProne":100,"ability":52,"currentAbility":50,"potentialAbility":56,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Made his debut for AAA in 2006 as Mini Dizzy and began appearing on televised events in 2007. It really didn't make sense to have a mini version of a wrestler not on the roster so he was given the name Atomic Boy before competing in the tournament for the AAA World Minis Championship. Seemed just used as an extra body for the tournament as he hadn't made TV since and his appearances seem to be limited to AAA shows in very small towns. Brought back to TV in June 2009 as a tecnico in the regular size division. Usually stuck in openers or off TV entirely. After a long absence, he made his return to AAA television in 2011.","alterEgos":["Atomic Boy"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":42,"storytelling":52,"productFit":100,"riskTaking":44,"matchLayout":56,"psychology":42,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":53,"characterCoaching":53,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":53,"brandBuilding":20,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":64,"awareness":42,"judgement":65},"picture":"Raptor.png"},{"id":420,"name":"Blue Demon Jr.","realName":"Blue Demon Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":207,"height":172,"dateOfBirth":"1966-07-16T00:00:00.000Z","debut":"1985-07-01T00:00:00.000Z","wage":37500,"popularity":17,"charisma":70,"micSkills":61,"condition":61,"hardcoreAbility":50,"injuryProne":100,"ability":69,"currentAbility":36,"potentialAbility":38,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Blue Demon, Jr. is a Mexican professional wrestler. He is the alleged adopted son of the legendary original Blue Demon and is the first Mexican and first masked luchador to win the NWA World Heavyweight Championship. Like most masked luchadors, Blue Demon, Jr.'s real name is unknown. Blue Demon Jr. won the UWA World Junior Heavyweight Championship in 1997 in Panama by defeating Black Demon. Between 1997 and 1999 (exact date unknown) he lost the title to Pablo Marquez. On October 25, 2008, Demon, Jr. became the first Mexican professional wrestler, as well as first masked luchador to win the NWA World Heavyweight Championship when he defeated champion Adam Pearce. His win was also the first time the title changed hands in Mexico. In 2007 he appeared in the film Mil Mascaras vs. the Aztec Mummy (also known as Mil Mascaras Resurrection).","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":78,"storytelling":80,"productFit":100,"riskTaking":22,"matchLayout":81,"psychology":78,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":61,"characterCoaching":75,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":86,"socialMediaSavvy":77,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":64,"awareness":78,"judgement":87},"picture":"Blue demon Jr.png"},{"id":421,"name":"Chessman","realName":"Chessman","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":231,"height":180,"dateOfBirth":"1975-06-02T00:00:00.000Z","debut":"1996-07-03T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":6,"charisma":55,"micSkills":68,"condition":70,"hardcoreAbility":60,"injuryProne":100,"ability":60,"currentAbility":41,"potentialAbility":53,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kevin Citlali Zamora is a Mexican professional wrestler, better known under his ring name Chessman. hroughout his career, Chessman has been a part of several factions, such as The Black Family, Lucha Libre Latina (LLL), La Secta Cibernetica, La Secta del Mesías and Los Hell Brothers. Chessman has been associated with Cibernético and Charly Manson in one way or the other throughout most of his career, either teaming with them or wrestling against them. After training with Lucha Libre legend El Canek and the father of the Casas family Pepe Casas (father of Negro Casas, Heavy Metal and El Felino), Zamora made his debut on July 3, 1995 working as an Enmascarado using the name M-357. In 2001 Chessman made his debut AAA debut as part of a new stable called the Black Family.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-421","wrestlerId":421,"promotionId":5,"startDate":"2001-01-21T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1188],"staffAttributes":{"bookingLogic":80,"storytelling":82,"productFit":100,"riskTaking":19,"matchLayout":82,"psychology":80,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":53,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":78,"brandBuilding":63,"socialMediaSavvy":76,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":76,"awareness":80,"judgement":88},"picture":"Chessman.png"},{"id":422,"name":"Cibernetico","realName":"Cibernetico","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":235,"height":180,"dateOfBirth":"1975-04-25T00:00:00.000Z","debut":"1994-06-01T00:00:00.000Z","wage":30700,"wageType":"per-appearance","popularity":8,"charisma":69,"micSkills":45,"condition":59,"hardcoreAbility":49,"injuryProne":100,"ability":66,"currentAbility":46,"potentialAbility":78,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"mid","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Octavio López Arreola is a Mexican professional wrestler who is best known under the ring name Cibernético. During AAA's short partnership with the World Wrestling Federation, he participated in the 1997 Royal Rumble and wrestled on Raw is War and WWF Shotgun, often teaming with Pierroth, Jr. He is a former AAA World Heavyweight Champion as well as a former three time Campeón de Campeones, the predecessor to the AAA world championship. López started out as a body builder, developing the physique that would later on become one of his strong points. He began training for a professional wrestling career in the Universal Wrestling Association (UWA) Gym under Karloff Lagarde and Ray Mendoza as well as training with Ojo de Tigre and Ebano Ruiz. e made his professional wrestling debut in 1992 under the ring name Urko and later worked as Espiritu Negro for a brief period of time.","alterEgos":["Ciber The Main Man"],"birthplace":"Aguascalientes, Aguascalientes, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-422","wrestlerId":422,"promotionId":5,"startDate":"2022-02-05T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":70,"storytelling":73,"productFit":100,"riskTaking":29,"matchLayout":74,"psychology":70,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":43,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":78,"brandBuilding":77,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":58,"awareness":70,"judgement":82},"picture":"Cibernetico_alt2.png"},{"id":423,"name":"Daga","realName":"Daga","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":180,"height":170,"dateOfBirth":"1988-06-19T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","wage":30700,"wageType":"monthly","popularity":14,"charisma":48,"micSkills":63,"condition":90,"hardcoreAbility":38,"injuryProne":100,"ability":61,"currentAbility":56,"potentialAbility":61,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Originally a Coliseo Coacalco trainee, gained attention with his first big feud with Eterno and became a popular Mexico City independent luchador in 2010. Won the 2011 AAA Quien Pinta Para La Corona men's contest in something less than a surprise since he'd already appeared on their television show under a different name. Started out as a tecnico, but turned rudo in summer 2012 to join up with Los Perros del Mal, and won the AAA World Cruiserweight Championship at Guerra de Titanes, 2012. Titular leader of the short lived Daga Dynamite Dojo. Style very influenced by 'strong style' wrestlers including US wrestler Davey Richards.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2028-07-01T00:00:00.000Z","contract":{"id":"tew-contract-423","wrestlerId":423,"promotionId":5,"startDate":"2026-07-01T00:00:00.000Z","endDate":"2028-07-01T00:00:00.000Z","wage":30700,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[4300],"staffAttributes":{"bookingLogic":62,"storytelling":65,"productFit":100,"riskTaking":27,"matchLayout":66,"psychology":62,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":63,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":54,"brandBuilding":58,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":81,"awareness":62,"judgement":77},"picture":"Daga_alt2.png"},{"id":424,"name":"Espiritu","realName":"Espiritu","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":183,"height":172,"dateOfBirth":"1975-12-09T00:00:00.000Z","debut":"1993-05-10T00:00:00.000Z","wage":37500,"popularity":4,"charisma":73,"micSkills":48,"condition":74,"hardcoreAbility":46,"injuryProne":100,"ability":60,"currentAbility":41,"potentialAbility":43,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Espíritu / Dark Espíritu (Spanish for \"Spirit\") is a Mexican Luchador who’s most well known for working as a heel. Espíritu made his debt on May 10, 1993 after learning the trade from Bobby Lee and Herculés León. Espíritu worked for years on the Mexican independent circuit until he began working for Asistencia Asesoría y Administración (AAA) in the mid to late 90s. Espíritu was original a member of the stable Los Vatos Locos, replacing Charly Manson when he left to form The Black Family in mid-2001. In November 2005 the Black Family asked Espíritu to join their group as they became part of La Secta Cibernética. Espíritu switched to the Black Family but parted amicably with the other Vatos Locos and at times teams with his old team mates Picudo, Nygma and Silver Cat. When La Secta became La Secta del Mesías Espíritu adopted the darker more \"gothic\" look that came with the shift in name.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":59,"storytelling":65,"productFit":100,"riskTaking":31,"matchLayout":67,"psychology":59,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":54,"characterCoaching":57,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":57,"brandBuilding":45,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":80,"awareness":59,"judgement":75},"picture":"Espiritu.png"},{"id":425,"name":"Dios del Inframundo","realName":"Dios del Inframundo","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":174,"height":172,"dateOfBirth":"1975-07-23T00:00:00.000Z","debut":"1998-04-01T00:00:00.000Z","wage":37500,"popularity":8,"charisma":63,"micSkills":46,"condition":75,"hardcoreAbility":71,"injuryProne":100,"ability":64,"currentAbility":44,"potentialAbility":66,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Víctor Manuel Soto Flores is a Mexican Luchador or professional wrestler currently working under the ring name Alan and also under a mask as Drago. Soto is best known by his previous ring name Gato Eveready or simply El Gato, under which he was an unofficial member of the wrestling group Real Fuerza Aérea. He is also known for his time working as \"Alan\", one third of a group called Los Barrio Boys. He has worked for the majority of his career for the Mexican professional wrestling promotion Asistencia Asesoría y Administración (AAA). Victor Soto made his professional wrestling debut in April, 1998 on an Asistencia Asesoría y Administración (AAA) show, under the name Morfo. Later on his ring name was changed to \"Jimmy Boy\" and he was teamed up with Billy and Vangelis to form a Boy band inspired group called Los Spice Boys. On April 20, 2011, Soto debuted under a new character Drago and was given a major push as a tecnico fighting for AAA in the war against La Sociedad and Los Bizarros.","alterEgos":["Drago"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1177,1619,1757,2523,2524],"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":25,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":67,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":70,"brandBuilding":66,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":68,"awareness":62,"judgement":77},"picture":"Drago.png"},{"id":426,"name":"Mr. Elektro","realName":"Mr. Elektro","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":209,"height":185,"dateOfBirth":"1970-04-22T00:00:00.000Z","debut":"1992-01-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":73,"micSkills":71,"condition":65,"hardcoreAbility":48,"injuryProne":100,"ability":66,"currentAbility":39,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Edgar Luna Pozos is a Mexican Luchador or professional wrestler best known under the ring name Electroshock, which he has used while working for the Mexican professional wrestling promotion Asistencia Asesoría y Administración (AAA) since 1997. After getting his license Pozos created the enmascarado character \"Ultimatum\" after seeing a band called \"Ultimatum\" and discovering that the term meant \"final warning\", a name he found appropriate for the showmanship of professional wrestling. As Ultimatum he earned a contract with Consejo Mundial de Lucha Libre (CMLL) and began working at their wrestling school to hone his skills under the tutelage of Arturo Beristain. Almost ready to quit wrestling Pozos friend José Mercado, who wrestles as Pentagón Black, convinced him to apply for a job with Asistencia Asesoría y Administración (AAA).","alterEgos":["Electroshock"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":73,"storytelling":75,"productFit":100,"riskTaking":30,"matchLayout":75,"psychology":73,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":58,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":62,"brandBuilding":60,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":70,"awareness":73,"judgement":84},"picture":"Electro Shock.png"},{"id":427,"name":"Kenta Kobashi","realName":"Kenta Kobashi","nickname":"","type":"scout","base":"Japan","gender":"M","weight":253,"height":182,"dateOfBirth":"1967-03-27T00:00:00.000Z","debut":"1988-02-01T00:00:00.000Z","wage":66000,"popularity":17,"charisma":100,"micSkills":88,"condition":40,"hardcoreAbility":100,"injuryProne":80,"ability":100,"currentAbility":54,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Kenta Kobashi is a Japanese retired professional wrestler. e started his career in AJPW in 1988 and during the next twelve years become one of the promotion's top stars, before taking part in a mass exodus led by Mitsuharu Misawa, which led to the formation of Pro Wrestling Noah. Kobashi worked for Noah for thirteen years, though spent years sidelined by various injuries, before retiring from in-ring action in May 2013. On March 17, 2013, Kobashi made an appearance for All Japan Pro Wrestling to promote his retirement match. Before the main event, Hiroshi Hase announced that he would be resigning as Pacific Wrestling Federation (PWF) chairman to focus on the National Diet and that Kobashi would be replacing him, after his retirement on May 11. Kobashi thus became the first AJPW-trained wrestler to become chairman.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[917,973,3217,3301,3302,3311,3312],"staffAttributes":{"bookingLogic":50,"storytelling":54,"productFit":43,"riskTaking":24,"matchLayout":22,"psychology":28,"workerManagement":42,"trainingIntensity":54,"technicalCoaching":29,"characterCoaching":31,"teaching":47,"diagnosis":43,"rehabilitation":56,"prevention":38,"mediaHandling":29,"brandBuilding":43,"socialMediaSavvy":27,"ruleKnowledge":32,"positioning":34,"reactionSpeed":58,"consistency":22,"awareness":27,"judgement":94},"picture":"Kenta Kobashi_alt1.png"},{"id":428,"name":"El Elegido","realName":"El Elegido","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":260,"height":180,"dateOfBirth":"1975-11-23T00:00:00.000Z","debut":"2005-04-22T00:00:00.000Z","wage":37500,"popularity":4,"charisma":53,"micSkills":44,"condition":70,"hardcoreAbility":49,"injuryProne":100,"ability":44,"currentAbility":30,"potentialAbility":32,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"The latest in the seemingly never ending line of AAA pretty boy characters, El Elegido was a Monterrey wrestler scooped up by Antonio Pena. Elegido's progress in AAA seemed to crater after Pena's passing, with the new management group preferring other wrestlers. Elegido's also run afoul of those in charge by pushing his stripping gimmick a bit too far. AAA tends to put Elegido on TV for a few weeks, starting or continuing a storyline with him, then just drops the whole idea for a few months before repeating the idea again. Elegido's considered a very unskilled luchador, but is still tremendously popular with female audience.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":45,"storytelling":48,"productFit":100,"riskTaking":32,"matchLayout":49,"psychology":45,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":34,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":66,"brandBuilding":65,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":65,"awareness":45,"judgement":67},"picture":"El Elegido.png"},{"id":429,"name":"Escoria","realName":"Escoria","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":180,"height":172,"dateOfBirth":"1980-12-09T00:00:00.000Z","debut":"1998-12-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":74,"micSkills":46,"condition":80,"hardcoreAbility":54,"injuryProne":100,"ability":57,"currentAbility":45,"potentialAbility":47,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jose Ibarra is a Mexican Luchador who is best known as Escoria / Dark Escoria (Spanish for \"Dreg\"). Ibarra has been part of The Black Family since it was formed, but left the stable in October 2010. During his time in the Black Family, Escoria was also a member of Lucha Libre Latina (LLL) and La Secta del Mesias, its predecessor La Secta Cibernetica and La Legión Extranjera. Ibarra made his wrestling debut in 1998 after training with Blackman, Negro Sosa and Draco for over six months. In the early parts of 2001 Escoria teamed up with four other wrestlers that all used a similar gimmick, look and attitude as Cuervo to form the stable the Black Family. The other wrestlers were Charly Manson, Cuervo and Ozz. In 2005 Cibernético formed a new group called La Secta Cibernetica that included his friends Charly Manson and Chessman and through Chessman's membership the Black Family was also invited to join this new supergroup.","alterEgos":["Dark Escoria"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1159,1917,1918],"staffAttributes":{"bookingLogic":65,"storytelling":69,"productFit":100,"riskTaking":28,"matchLayout":70,"psychology":65,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":61,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":62,"brandBuilding":49,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":80,"awareness":65,"judgement":79},"picture":"Escoria.png"},{"id":430,"name":"Halloween","realName":"Halloween","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":207,"height":172,"dateOfBirth":"1971-05-22T00:00:00.000Z","debut":"1989-05-01T00:00:00.000Z","wage":4166,"popularity":5,"charisma":61,"micSkills":54,"condition":79,"hardcoreAbility":44,"injuryProne":100,"ability":43,"currentAbility":26,"potentialAbility":28,"morale":"broken","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Manuel Ortiz Partida is a professional wrestler who is currently wrestling the independent circuit in Mexico, particularly in the Tijuana area. He is better known by his stage name Halloween but is also known in the United States as Ciclope, a character he portrayed in World Championship Wrestling. Manuel Ortiz Partida, debut in the pros in 1990, spent his time in the Independent Circuit. He wrestled as \"Halloween\" for most of his career. In 1996, Ortiz joined WCW where he took the name \"Ciclope.\" On March 13, 2012, Halloween, Bestia 666, Damián 666, Super Nova and X-Fly announced that they were forming La Familia de Tijuana, a group of independent wrestlers, much like Los Perros del Mal, with the exception that they were not looking to form their own promotion.","alterEgos":["Ciclope"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1153,1223,3176],"staffAttributes":{"bookingLogic":57,"storytelling":60,"productFit":100,"riskTaking":44,"matchLayout":61,"psychology":57,"workerManagement":100,"trainingIntensity":61,"technicalCoaching":44,"characterCoaching":53,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":53,"brandBuilding":54,"socialMediaSavvy":50,"ruleKnowledge":2,"positioning":22,"reactionSpeed":61,"consistency":59,"awareness":57,"judgement":74},"picture":"Halloween.png"},{"id":431,"name":"Heavy Metal","realName":"Heavy Metal","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":194,"height":170,"dateOfBirth":"1970-10-04T00:00:00.000Z","debut":"1988-02-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":49,"micSkills":56,"condition":64,"hardcoreAbility":54,"injuryProne":100,"ability":57,"currentAbility":34,"potentialAbility":36,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Erick Francisco Casas Ruiz is a Mexican professional wrestler currently working under the ring name Heavy Metal.  He is the son of referee Pepe Casas and the brother of Negro Casas and Felino. Erick Casas started his professional wrestling career as Canelo Casas wrestling for Consejo Mundial de Lucha Libre (CMLL). Erick Casas left CMLL when he decided to go to the newly created promotion Asistencia Asesoría y Administración (AAA) in 1992. He changed his gimmick to Heavy Metal where he was a rudo and had a rock-star look which was based on heavy metal music. Heavy Metal went to Total Nonstop Action Wrestling (TNA) because AAA's working agreement. After TNA, Heavy Metal returned to Asistencia Asesoría y Administración. Since his return, he turned back into a tecnico. At AAA's show in Mexico City, an event competing directly against CMLL's major event Homenaje a Dos Leyendas, Heavy Metal made surprising return to AAA, attacking Konnan and joining forces with Cibernético.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3181],"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":27,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":56,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":64,"brandBuilding":56,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":62,"awareness":63,"judgement":78},"picture":"Heavy Metal.png"},{"id":433,"name":"Jack Evans","realName":"Jack Evans","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":169,"height":170,"dateOfBirth":"1982-04-02T00:00:00.000Z","debut":"2000-09-01T00:00:00.000Z","wage":4166,"popularity":19,"charisma":54,"micSkills":73,"condition":71,"hardcoreAbility":44,"injuryProne":100,"ability":48,"currentAbility":48,"potentialAbility":60,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jack Evans is an American wrestler who works in America, Canada, Mexico, the British Isles, Japan and Europe. He is a Lightweight who is classed as using a Daredevil style. He is one half of The Hybrid2 alongside Angélico. He is best known for his work with AEW. He is married to someone outside the wrestling business.","alterEgos":["Dr. Muscle"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1185,1897,2559],"staffAttributes":{"bookingLogic":45,"storytelling":53,"productFit":100,"riskTaking":37,"matchLayout":56,"psychology":45,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":62,"brandBuilding":55,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":45,"awareness":45,"judgement":67},"picture":"Jack Evans_alt2.png"},{"id":434,"name":"Konnan","realName":"Konnan","nickname":"","type":"trainer","promotionId":5,"base":"Other","gender":"M","weight":240,"height":175,"dateOfBirth":"1964-01-06T00:00:00.000Z","debut":"1987-01-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":30,"charisma":68,"micSkills":68,"condition":38,"hardcoreAbility":66,"injuryProne":50,"ability":59,"currentAbility":29,"potentialAbility":29,"morale":"poor","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Considered one of the biggest stars in the history of lucha libre, Konnan is one of the most influential luchadores in the history of the sport.\r\n\r\nShattering box office records as a perennial main eventer in Mexico, Konnan co-founded AAA while acting as the guiding light of some of today and tomorrow’s emerging top luchadores.\r\n\r\nThese are just a few of the bullets on this Miami native’s resume, which is decorated with accomplishments. Konnan’s hustled and headlined both in the United States as well as blazed a hall of fame career in Mexico.","alterEgos":[],"birthplace":"Santiago, Oriente Province, Cuba","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-434","wrestlerId":434,"promotionId":5,"startDate":"2018-06-04T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[910,911,1423],"staffAttributes":{"bookingLogic":56,"storytelling":28,"productFit":48,"riskTaking":48,"matchLayout":58,"psychology":58,"workerManagement":22,"trainingIntensity":66,"technicalCoaching":51,"characterCoaching":69,"teaching":95,"diagnosis":59,"rehabilitation":42,"prevention":47,"mediaHandling":44,"brandBuilding":29,"socialMediaSavvy":25,"ruleKnowledge":42,"positioning":33,"reactionSpeed":29,"consistency":36,"awareness":53,"judgement":24},"picture":"Konnan_alt1.png"},{"id":435,"name":"El Mesias","realName":"El Mesias","nickname":"","type":"wrestler","promotionId":5,"base":"USA","gender":"M","weight":244,"height":180,"dateOfBirth":"1975-05-25T00:00:00.000Z","debut":"1997-04-01T00:00:00.000Z","wage":30700,"wageType":"per-appearance","popularity":15,"charisma":75,"micSkills":68,"condition":83,"hardcoreAbility":45,"injuryProne":100,"ability":70,"currentAbility":48,"potentialAbility":50,"morale":"broken","presentation":"heel","prestige":"low","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Gilbert Cosme better known by his ring names El Mesías and Ricky Banderas, is a Puerto Rican professional wrestler. He began his career in the International Wrestling Association based on Puerto Rico. While performing in the company, he won the IWA World Heavyweight Championship on five instances and held minor championships on fifteen separate occasions, before leaving the company in 2006. Following the culmination of his contract with the International Wrestling Association, Cosme signed a contract with Asistencia Asesoría y Administración (AAA). He debuted on March 12, 2006, as \"Muerte Cibernética\" a rudo. As noted on the \"TNA Mobile\" service, Cosme signed a contract with Total Nonstop Action Wrestling (TNA). Cosme was billed as James Mitchell's kayfabe son and thus Abyss' brother. Beginning on July 1, 2007, vignettes began to air for this \"monster-like\" character. His name was eventually billed as Judas Mesias.","alterEgos":["Ricky Banderas","Mil Muertes"],"birthplace":"New York City, New York, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-435","wrestlerId":435,"promotionId":5,"startDate":"2023-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":71,"storytelling":74,"productFit":100,"riskTaking":27,"matchLayout":75,"psychology":71,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":38,"characterCoaching":80,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":80,"brandBuilding":76,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":65,"awareness":71,"judgement":83},"picture":"El Mesias.png"},{"id":436,"name":"Octagón","realName":"Octagón","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":189,"height":170,"dateOfBirth":"1961-03-27T00:00:00.000Z","debut":"1981-12-01T00:00:00.000Z","wage":64000,"wageType":"per-appearance","popularity":25,"charisma":63,"micSkills":69,"condition":58,"hardcoreAbility":42,"injuryProne":100,"ability":62,"currentAbility":29,"potentialAbility":31,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Juan Escalera is a Mexican luchador enmascarado better known as Octagón. Octagón formed a Tag team with El Hijo Del Santo to take on Los Gringos Locos (Eddie Guerrero and Art Barr) in a double mask versus hair match on the first pay-per-view put on by a Mexican wrestling promotion. Over the years the Octagón gimmick has spawned a Mascot called Octagóncito and an \"Evil clone\" known as Pentagón. In late 1988 to early 1989, Octagón, along with CMLL booker Antonio Peña (the man in charge of writing the storylines that CMLL used), decided to create a new character that played off Octagón's martial arts background. The name was inspired by the movie The Octagon starring Chuck Norris.","alterEgos":[],"birthplace":"Xalapa, Veracruz, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-436","wrestlerId":436,"promotionId":11,"startDate":"2022-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":64000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":84,"storytelling":85,"productFit":100,"riskTaking":23,"matchLayout":86,"psychology":84,"workerManagement":100,"trainingIntensity":50,"technicalCoaching":70,"characterCoaching":42,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":42,"brandBuilding":65,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":50,"consistency":65,"awareness":84,"judgement":90},"picture":"Octagon.png"},{"id":437,"name":"Pimpinela Escarlata","realName":"Pimpinela Escarlata","nickname":"","type":"interviewer","promotionId":5,"base":"Mexico","gender":"M","weight":191,"height":172,"dateOfBirth":"1969-04-18T00:00:00.000Z","debut":"1988-06-15T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":5,"charisma":60,"micSkills":55,"condition":62,"hardcoreAbility":47,"injuryProne":100,"ability":55,"currentAbility":31,"potentialAbility":33,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Mario González Lozano is a Mexican Luchador, or professional wrestler who works as an Exotico. As Escarlata he is a former AAA Reina de Reinas Champion, Mexican National Middleweight Champion and AAA World Mixed Tag Team Champion. His ring name is Spanish for \"The Scarlet Pimpernel\" and is taken from the fictional character of the same name. The fact that González works as an Exotico, a transvestite, homosexual character, it does not necessarily mean that it reflects his personal preferences. Mario González began his professional wrestling career in 1988, initially working under the ring name Pantera Rosa (Spanish for \"the Pink Panther\") and later on briefly worked as Fly Boy. González was a fan of such Exotico wrestlers as Adorable Rubí and Sergio El Hermoso growing up and decided to become an Exotico himself.","alterEgos":[],"birthplace":"Delicias, Chihuahua, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-437","wrestlerId":437,"promotionId":5,"startDate":"2001-03-30T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":20,"storytelling":54,"productFit":27,"riskTaking":27,"matchLayout":40,"psychology":36,"workerManagement":40,"trainingIntensity":45,"technicalCoaching":42,"characterCoaching":41,"teaching":26,"diagnosis":43,"rehabilitation":42,"prevention":51,"mediaHandling":81,"brandBuilding":67,"socialMediaSavvy":52,"ruleKnowledge":59,"positioning":35,"reactionSpeed":24,"consistency":27,"awareness":43,"judgement":20},"picture":"Pimpinela Escarlata.png"},{"id":439,"name":"El Texano Jr.","realName":"El Texano Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":220,"height":182,"dateOfBirth":"1984-07-31T00:00:00.000Z","debut":"1999-02-24T00:00:00.000Z","wage":4166,"popularity":10,"charisma":52,"micSkills":68,"condition":78,"hardcoreAbility":84,"injuryProne":100,"ability":60,"currentAbility":52,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Juan Aguilar Leos is a Mexican luchador, or professional wrestler, best known under the ring name El Texano, Jr. Aguilar is the son of Juan Conrado Aguilar Jáuregui, who wrestled under the name El Texano; Aguilar also has several uncles and cousins that are professional wrestlers. Aguilar has mainly worked for the Mexican professional wrestling promotion Consejo Mundial de Lucha Libre (CMLL) throughout his career, but has made several tours of Japan for New Japan Pro Wrestling (NJPW) from 2005 until 2007. In November 2011, Aguilar left CMLL to join Perros del Mal Producciones and Asistencia Asesoría y Administración (AAA). On December 2 2012 at Guerra de Titanes, El Texano, Jr. defeated El Mesías to become the youngest AAA World Heavyweight Champion in history.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3356,3648,4243],"staffAttributes":{"bookingLogic":75,"storytelling":77,"productFit":100,"riskTaking":21,"matchLayout":77,"psychology":75,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":62,"characterCoaching":71,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":71,"brandBuilding":68,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":63,"awareness":75,"judgement":85},"picture":"Texano Jr.png"},{"id":440,"name":"Toscano","realName":"Toscano","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":209,"height":172,"dateOfBirth":"1973-12-20T00:00:00.000Z","debut":"1993-11-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":53,"micSkills":54,"condition":83,"hardcoreAbility":57,"injuryProne":100,"ability":45,"currentAbility":29,"potentialAbility":31,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Oziel Toscano Jasso is a Mexican professional wrestler, or Luchador as they are known in Spanish, best known under the ring name Tarzan Boy and Toscano. He briefly worked for the World Wrestling Federation (WWF) as Armando Fernandez in 1998 and 1999 on their Lucha libre oriented WWF Super Astros television program. Tarzan Boy was initially trained as a \"técnico\" by Blue Fish and made his official debut on November 27, 1993 in Monterrey under the name Baby Toscano. He was turned rudo and aligned with Rey Bucanero and Último Guerrero to form Los Guerreros del Infierno. On December 8, 2011, Toscano appeared at a press conference, where it was announced that he was joining CMLL's rival promotion Asistencia Asesoría y Administración (AAA). With the announcement, in just 30 days, Toscano became the third CMLL worker, after Héctor Garza and El Texano, Jr., to leave the promotion for AAA.","alterEgos":["Tarzan Boy"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":37,"storytelling":51,"productFit":90,"riskTaking":27,"matchLayout":56,"psychology":37,"workerManagement":90,"trainingIntensity":72,"technicalCoaching":70,"characterCoaching":44,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":44,"brandBuilding":53,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":18,"reactionSpeed":72,"consistency":62,"awareness":37,"judgement":58},"picture":"Toscano.png"},{"id":441,"name":"Faby Apache","realName":"Faby Apache","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"F","weight":139,"height":157,"dateOfBirth":"1980-12-26T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","wage":30700,"wageType":"per-appearance","popularity":15,"charisma":70,"micSkills":79,"condition":74,"hardcoreAbility":83,"injuryProne":100,"ability":61,"currentAbility":61,"potentialAbility":73,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Born Fabiola Balbuena Torres, the daughter of Gran Apache soon shortened her name to Fabi Apache when she debuted in lucha libre. La India Bonita, Fabi split her time between Mexico and Japan, wrestling for ARSION. More agile than fast. Between 2005 and 2009 she was involved in a long running storyline that revolved around her relationship with Billy Boy (Billy el Malo), her real life husband as well as her father Gran Apache, sister Mari Apache and even saw Billy Boy and Faby Apache's son Marvin play a part in it. In August 2011, Faby and her sister worked a tour of Japan, working with Oz Academy and Pro Wrestling Wave. On April 6, 2012, Mari Apache turned ruda and started a rivalry with Faby.","alterEgos":[],"birthplace":"Mexico City, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-441","wrestlerId":441,"promotionId":5,"startDate":"2023-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1376,2872,2873],"staffAttributes":{"bookingLogic":77,"storytelling":80,"productFit":100,"riskTaking":20,"matchLayout":81,"psychology":77,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":68,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":73,"brandBuilding":67,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":73,"awareness":77,"judgement":86},"picture":"Faby Apache_alt2.png"},{"id":442,"name":"Mary Apache","realName":"Mary Apache","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":154,"height":157,"dateOfBirth":"1979-10-15T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","wage":37500,"popularity":6,"charisma":66,"micSkills":68,"condition":79,"hardcoreAbility":57,"injuryProne":100,"ability":70,"currentAbility":54,"potentialAbility":56,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Mariella Balbuena Torres is a Mexican Luchadora, best known under the ring name Mari Apache (sometimes written as \"Mary Apache\"). She is the daughter of Luchador Gran Apache and the sister of luchadora Faby Apache. She has wrestled for an extended period of time in Japan but is best known for working in Asistencia Asesoría y Administración along with her father and sister. She is a former holder of the AAA Reina de Reinas and AAA World Mixed Tag Team Championship, the latter of which she held along with her father. Torres has previously wrestled under the ring name Princesa Apache as well as the enmascarada (masked) characters Love and Lady Venum.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1376,2872,2873],"staffAttributes":{"bookingLogic":67,"storytelling":72,"productFit":90,"riskTaking":23,"matchLayout":73,"psychology":67,"workerManagement":90,"trainingIntensity":65,"technicalCoaching":62,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":61,"brandBuilding":55,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":18,"reactionSpeed":65,"consistency":68,"awareness":67,"judgement":76},"picture":"Mary Apache.png"},{"id":443,"name":"Jennifer Blake","realName":"Jennifer Blake","nickname":"","type":"wrestler","base":"Canada","gender":"F","weight":125,"height":167,"dateOfBirth":"1983-09-16T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":48,"micSkills":64,"condition":90,"hardcoreAbility":53,"injuryProne":100,"ability":59,"currentAbility":50,"potentialAbility":50,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Jennifer Ykema is a Canadian professional wrestler, better known by her ring name Jennifer Blake. She is often referred to by her nickname Girl Dynamite. She is best known for her work in Asistencia Asesoría y Administración in Mexico, where she has been one half of the AAA World Mixed Tag Team Champions, and Shimmer Women Athletes in the United States as well as all-women's promotions in America and Canada. Blake made her first wrestling appearance in 2004 as a ring announcer. Following this, she transitioned into a managerial role and began acting as a valet for Derek Wylde and Cody Deaner while receiving training from Cody. Blake made her debut for Shimmer Women Athletes on April 26, 2008. In early 2009, Blake took part in the tapings of Jimmy Hart's Wrestlicious as Autumn Frost. In 2009, Blake branched out into Mexico.","alterEgos":["\"Ice Princess\"Autumn Frost"],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":44,"storytelling":54,"productFit":50,"riskTaking":29,"matchLayout":57,"psychology":44,"workerManagement":50,"trainingIntensity":78,"technicalCoaching":49,"characterCoaching":58,"teaching":20,"diagnos