Id":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-318","wrestlerId":318,"promotionId":38,"startDate":"2017-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[952,994,3035,3036,3037,3038],"staffAttributes":{"bookingLogic":33,"storytelling":46,"productFit":20,"riskTaking":49,"matchLayout":23,"psychology":46,"workerManagement":51,"trainingIntensity":71,"technicalCoaching":46,"characterCoaching":72,"teaching":84,"diagnosis":38,"rehabilitation":54,"prevention":39,"mediaHandling":55,"brandBuilding":52,"socialMediaSavvy":22,"ruleKnowledge":24,"positioning":25,"reactionSpeed":36,"consistency":31,"awareness":28,"judgement":54},"picture":"Takashi Iizuka.png"},{"id":319,"name":"Hirooki Goto","realName":"Hirooki Goto","nickname":"","type":"wrestler","promotionId":38,"base":"Japan","gender":"M","weight":227,"height":177,"dateOfBirth":"1979-06-25T00:00:00.000Z","debut":"2003-07-06T00:00:00.000Z","wage":80000,"wageType":"monthly","popularity":30,"charisma":90,"micSkills":92,"condition":83,"hardcoreAbility":65,"injuryProne":100,"ability":70,"currentAbility":70,"potentialAbility":82,"morale":"poor","presentation":"face","prestige":"low","style":"submission","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Hirooki Goto, who graduated from New Japan Dojo on 06 July 2003, is a Japanese wrestler who works in the USA, Mexico and Japan. He is a 5'11\", 227lb worker who is classed as using a Impactful style. He uses the GTR as his finisher. He is one half of Bishamon alongside YOSHI-HASHI. He is best known for his work with CMLL and NJPW. He is currently the IWGP World Heavyweight champion.","alterEgos":[],"birthplace":"Kuwana, Mie,