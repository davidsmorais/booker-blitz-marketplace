tation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Rionne McAvoy is an Australian professional wrestler of English and Irish descent, currently signed to Wrestling New Classic (WNC), where he works under the ring name Fujiwara Rionne. He is also an independent film director, kickboxer and 3rd degree aikido blackbelt. McAvoy made the transition from martial arts to professional wrestling in April 2012. In addition to his wrestling Rionne is a respected film maker in Japan. McAvoy practiced karate during his elementary and high school days and won the 2000 Queensland state championships. He first visited Japan when he was 19 for karate before switching to aikido when he was 21. His father, a 4th degree aikido teacher, taught him how to roll and fall when he was younger, and the progression to aikido was natural for him. McAvoy also joined the world famous Ihara Kickboxing gym and continues to practice there.","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":55,"riskTaking":27,"matchLayout":63,"psychology":58,"workerManagement":55,"trainingIntensity":79,"technicalCoaching":58,"characterCoaching":48,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":48,"brandBuilding":44,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":11,"reactionSpeed":79,"consistency":64,"awareness":58,"judgement":57},"picture":"Rionne McAvoy.png"},{"id":1573,"name":"Baron Corbin","realName":"Baron Corbin","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":284,"height":195,"dateOfBirth":"1984-09-13T00:00:00.000Z","debut":"2012-10-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":48,"charisma":81,"micSkills":78,"condition":85,"hardcoreAbility":92,"injuryProne":100,"ability":67,"currentAbility":67,"potentialAbility":80,"morale":"fair","presentation":"heel","prestige":"mid","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Hate King Corbin? You’re giving him exactly what he wants. A former NFL player whose aggression got him booted from the game, Corbin has found the perfect outlet for his rage in WWE, and the perfect target for it in, well, anyone and everyone who crosses his path. Less a Superstar than a force of nature, The Lone Wolf first made his mark on The Grandest Stage of Them All when he eliminated Kane from the third annual Andre the Giant Memorial Battle Royal to win the bout and stake his claim as the legendary giant’s heir apparent.","alterEgos":["Tom Pestock","Bishop Dyer"],"birthplace":"Lenexa, Kansas, United States","managerId":0,"contractExpiryDate":"2026-08-03T00:00:00.000Z","contract":{"id":"tew-contract-1573","wrestlerId":1573,"promotionId":64,"startDate":"2026-07-10T00:00:00.000Z","endDate":"2026-08-03T00:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3067,3907,4221],"staffAttributes":{"bookingLogic":64,"storytelling":68,"productFit":100,"riskTaking":8,"matchLayout":69,"psychology":64,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":33,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":92,"mediaHandling":65,"brandBuilding":57,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":88,"awareness":64,"judgement":78},"picture":"Baron Corbin.png"},{"id":1574,"name":"Crazzy Steve","realName":"Crazzy Steve","nickname":"","type":"wrestler",