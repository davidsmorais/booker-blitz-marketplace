ings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Killer Kelly is a Portuguese wrestler who works in the USA, the British Isles, Japan and Europe. She is a 5'5\", 128lb worker who is classed as using a Technician style. She uses the Superkick as her finisher. She is best known for her work with TNA, NXT UK, wXw, Sendai Girls, DPW, REVOLVER, PROGRESS, EVE, BLP and Riptide.","alterEgos":[],"birthplace":"Portugal","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3778],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":53,"riskTaking":22,"matchLayout":63,"psychology":58,"workerManagement":53,"trainingIntensity":80,"technicalCoaching":67,"characterCoaching":75,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":70,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":11,"reactionSpeed":80,"consistency":75,"awareness":58,"judgement":56},"picture":"Killer Kelly.png"},{"id":2831,"name":"Parrow","realName":"Parrow","nickname":"","type":"wrestler","promotionId":77,"base":"USA","gender":"M","weight":293,"height":190,"dateOfBirth":"1982-02-09T00:00:00.000Z","debut":"2010-02-01T00:00:00.000Z","wage":19700,"wageType":"per-appearance","popularity":8,"charisma":54,"micSkills":36,"condition":65,"hardcoreAbility":68,"injuryProne":100,"ability":60,"currentAbility":50,"potentialAbility":52,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Parrow is an American wrestler who works in America and Japan. He is a Light Heavyweight who is classed as using a Powerhouse style. He is one half of The End alongside Odinson. He is best known for his work with AJPW, NWA, MLW and GCW. He is engaged to someone outside the wrestling business.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2831","wrestlerId":2831,"promotionId":77,"startDate":"2020-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":19700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2426,2427,2428,2429],"staffAttributes":{"bookingLogic":52,"storytelling":55,"productFit":56,"riskTaking":25,"matchLayout":56,"psychology":52,"workerManagement":56,"trainingIntensity":57,"technicalCoaching":28,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":58,"brandBuilding":73,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":11,"reactionSpeed":57,"consistency":68,"awareness":52,"judgement":54},"picture":"Mike Parrow.png"},{"id":2833,"name":"Destiny","realName":"Destiny","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":199,"height":170,"dateOfBirth":"1997-08-09T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","wage":3000,"popularity":2,"charisma":45,"micSkills":46,"condition":95,"hardcoreAbility":68,"injuryProne":100,"ability":54,"currentAbility":54,"potentialAbility":63,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Black Destiny is a masked Mexican luchador who works exclusively in Mexico. He is a Lightweight who is classed as using a Luchador style. He is best known for his work with The Crash.","alterEgos":["Black Destiny"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":44,"storytelling":52,"productFit":84,"riskTaking":37,"matchLayout":55,"psychology":44,"workerManagement":84,"trainingIntensity":72,"technicalCoaching":58,"characterCoaching":48,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":48,"brandBuilding":48,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":17,"reactionSpeed":72,"consistency":57,"awareness":44,"judgement":60},"picture":"Black Boy.png"},{"id":2834,"name":"Lexis King","realName":"Brian Pillman Jr.","nickname":"","type":"wrestler","promotionId":65,"base":"USA","gender":"M","weight":205,"height":182,"dateOfBirth":"1993-09-09T00:00:00.000Z","debut":"2017-12-01T00:00:00.000Z","wage":41000,"wageType":"monthly","popularity":29,"charisma":56,"micSkills":68,"condition":100,"hardcoreAbility":64,"injuryProne":100,"ability":67,"currentAbility":67,"potentialAbility":84,"morale":"poor","presentation":"heel","prestige":"low","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"One of the most highly-touted prospects in the sport has finally made it to the major leagues. Wearing Bengal print trunks like his father, Brian Pillman Jr. is looking to follow his own path to championship gold, fame and fortune in the sport. With a rock star’s swagger and look, Pillman can talk the talk. But what separates Pillman from the pack? He can also back it up it up in the ring.\r\n\r\nEmploying a combination of aerial attacks and aggressive physicality, the 6-foot 2-inch Cincinnati native is an explosive combination, which provides plenty of challenges for his adversaries. Trained by Lance Storm in Calgary as well as the renowned Rip Rogers, Pillman has quickly turned heads with his blend of technical precision and agility.\r\n\r\nWith a college degree and background in lacrosse, Pillman has a sharp mind for the business end of the sport.","alterEgos":["Brian Pillman Jr."],"