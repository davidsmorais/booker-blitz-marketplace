cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"The masked mach-speed luchador Aramis is a once in a generation luchador.\r\n\r\nA fearless fighter for righteous causes, Aramis has become one of Mexico’s most talked about luchadores, due in part to his cutting-edge arsenal of aerial moves, reversals, and strikes. But don’t overlook Aramis’ tenacity for never giving up, often overcoming much bigger competitors to triumph as thousands of fans chant his name in sold out arenas in Mexico.\r\n\r\nAAA co-founder Konnan, who discovered the likes or Rey Mysterio Jr., the Lucha Bros., Psicosis and countless others, has flagged Aramis as the next breakout luchador in the sport.","alterEgos":["Aramis"],"birthplace":"Coacalco de Berriozábal, State of Mexico, Mexico","managerId":0,"contractExpiryDate":"2026-07-01T00:00:00.000Z","contract":{"id":"tew-contract-3102","wrestlerId":3102,"promotionId":76,"startDate":"2024-07-01T00:00:00.000Z","endDate":"2026-07-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2313,4110],"staffAttributes":{"bookingLogic":54,"storytelling":60,"productFit":100,"riskTaking":24,"matchLayout":62,"psychology":54,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":59,"characterCoaching":49,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":49,"brandBuilding":51,"socialMediaSavvy":25,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":71,"awareness":54,"judgement":72},"picture":"Hologram.png","injury":{"type":"Torn Meniscus","daysToRecover":-4},"returnDate":"2026-04-08T00:00:00.000Z"},{"id":3103,"name":"Oliver Carter","realName":"Oliver Carter","nickname":"","type":"wrestler","base":"Europe","gender":"M","weight":198,"height":177,"dateOfBirth":"1995-05-09T00:00:00.000Z","debut":"2012-05-01T00:00:00.000Z","wage":37500,"popularity":19,"charisma":72,"micSkills":67,"condition":95,"hardcoreAbility":43,"injuryProne":100,"ability":66,"currentAbility":66,"potentialAbility":84,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"A new arrival on the scene in NXT UK, Oliver Carter has proven himself to be a formidable competitor in singles and tag team action. The Swiss and Ghanaian Superstar made a big impression on the WWE Universe upon his debut, then quickly joined forces with Ashton Smith, entering the red-hot NXT UK tag team division.\r\n\r\nCarter brings a fast-paced, high-flying offense to the tandem, a solid pairing with Smith’s raw power. Carter & Smith have stood toe-to-toe with the likes of Imperium and Grizzled Young Veterans, giving them the experience to make sure they’re on the rise in WWE’s fastest-growing brand.","alterEgos":["Oro Mensah","Oro"],"birthplace":"Switzerland","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2238,2845],"staffAttributes":{"bookingLogic":52,"storytelling":57,"productFit":53,"riskTaking":26,"matchLayout":58,"psychology":52,"workerManagement":53,"trainingIntensity":72,"technicalCoaching":48,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":67,"brandBuilding":57,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":11,"reactionSpeed":72,"consistency":75,"awareness":52,"judgement":52},"picture":"Oliver Carter_alt3.png"},{"id":3104,"name":"Elton Prince","realName":"Lewis Howley","nickname":"","type":"wrestler","promotionId":64,"base":"UK","gender":"M","weight":172,"height":182,"dateOfBirth":"1997-05-21T00: