"characterCoaching":25,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":25,"brandBuilding":26,"socialMediaSavvy":27,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Marisela Pena.png"},{"id":2632,"name":"Mini Histeria","realName":"Mini Histeria","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":150,"height":157,"dateOfBirth":"1982-05-05T00:00:00.000Z","debut":"1996-04-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":61,"micSkills":58,"condition":82,"hardcoreAbility":75,"injuryProne":100,"ability":57,"currentAbility":47,"potentialAbility":49,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Rolando Fuentes Romero is a Mexican Luchador enmascarado better known under the ring name Mini Histeria. In 1997 Fuentes adopted the ring name \"Rocky Mavin\" patterned after his father's ring name Rocco Marvin. The name change came after the debut of Fuentes' younger brother Ricky Marvin, which initially led to people thinking he was a \"Mini Ricky Marvin\" character until the fact that they were brothers became public knowledge.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":64,"storytelling":68,"productFit":100,"riskTaking":23,"matchLayout":70,"psychology":64,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":48,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":62,"brandBuilding":24,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":69,"awareness":64,"judgement":78},"picture":"Mini Histeria.png"},{"id":2633,"name":"Mini Rey Misterio","realName":"Mini Rey Misterio","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":137,"height":144,"dateOfBirth":"1972-04-23T00:00:00.000Z","debut":"1995-02-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":48,"micSkills":64,"condition":81,"hardcoreAbility":58,"injuryProne":100,"ability":59,"currentAbility":37,"potentialAbility":37,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"His first match was in 1995, but he'd been trying to get into the business as early as 1990. He couldn't afford traning for years, then spent two years learning before his first match.\r\nTold Dos de Tres that Antonio Pena planned to retire the La Parkita character when the original La Parka left the company, and Pena told him he'd join the Cadetes del Espacio as Venum. However, he ran into Octagon on his way out of the meeting, told him about the change, and Octagon brought him back to Pena, asking that he become Octagoncito instead.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":45,"storytelling":54,"productFit":100,"riskTaking":27,"matchLayout":57,"psychology":45,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":69,"characterCoaching":42,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":42,"brandBuilding":50,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":62,"awareness":45,"judgement":67},"picture":"Mini Rey Misterio.png"},{"id":2634,"name":"Monsta Mack","realName":"Monsta Mack","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":242,"height":187,"dateOfBirth":"1979-05-03T00:00:00.000Z","debut":"1998-10-0