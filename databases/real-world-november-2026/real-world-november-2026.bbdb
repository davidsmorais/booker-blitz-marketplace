nder":"M","weight":214,"height":177,"dateOfBirth":"1958-03-10T00:00:00.000Z","debut":"1977-11-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":50,"micSkills":73,"condition":55,"hardcoreAbility":78,"injuryProne":100,"ability":57,"currentAbility":26,"potentialAbility":28,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Máscara Año 2000 is a Mexican luchador who works exclusively in Mexico. He is a Lightweight who is classed as using a Luchador style. Making his debut in 1977, only a few years after his older brother, Cien Caras made his. Both brothers worked regularly for Empresa Mexicana de Lucha Libre (EMLL) from the early 1980s and they also brought in their younger brother who worked as Universo 2000 to form a trio billed as Los Hermanos Dinamita. In mid-1992 then CMLL booker Antonio Peña decided to break away from the promotion and form his own promotion called Asistencia Asesoría y Administración, wanting to produce his own style of wrestling shows that differed from the very conservative way CMLL ran things. Among the people that left CMLL to join AAA were Los Hermanos, who took the Mexican National Trios title with them. By mid-1996 Los Hermanos left AAA and returned to CMLL.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":75,"storytelling":80,"productFit":100,"riskTaking":31,"matchLayout":81,"psychology":75,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":58,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":61,"brandBuilding":42,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":51,"consistency":64,"awareness":75,"judgem