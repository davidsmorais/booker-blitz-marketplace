"wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1172,2746,2747],"staffAttributes":{"bookingLogic":50,"storytelling":57,"productFit":38,"riskTaking":26,"matchLayout":43,"psychology":43,"workerManagement":47,"trainingIntensity":40,"technicalCoaching":53,"characterCoaching":51,"teaching":28,"diagnosis":38,"rehabilitation":41,"prevention":33,"mediaHandling":27,"brandBuilding":44,"socialMediaSavvy":30,"ruleKnowledge":35,"positioning":20,"reactionSpeed":49,"consistency":37,"awareness":49,"judgement":75},"picture":"Sonjay Dutt.png"},{"id":162,"name":"Sting","realName":"Sting","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":251,"height":187,"dateOfBirth":"1959-03-20T00:00:00.000Z","debut":"1985-11-01T00:00:00.000Z","wage":37500,"popularity":61,"charisma":80,"micSkills":80,"condition":55,"hardcoreAbility":80,"injuryProne":81,"ability":45,"currentAbility":45,"potentialAbility":95,"morale":"good","presentation":"face","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Often dubbed “The Franchise of WCW,” the man called Sting is one of the most recognizable and unique faces in sports-entertainment history. It was that distinction that made him the backbone of the Atlanta-based organization throughout the late 1980s until the end of WCW in 2001. It would be Triple H's protege, Seth Rollins, who would next face off against the face-painted legend at Night of Champions. The two would battle for the WWE World Heavyweight Championship with Rollins squeaking by with a roll-up on The Stinger. Though The Stinger often likes to say \"the only thing sure about Sting is that nothing is for sure,\" there is one thing nobody can deny - that Sting has had a Hall of Fame-worthy career. That will be confirmed on the eve of WrestleMania 32, when he joins the WWE Hall of Fame as a member of the Class of 2016.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1332,2595],"staffAttributes":{"bookingLogic":88,"storytelling":89,"productFit":100,"riskTaking":16,"matchLayout":89,"psychology":88,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":30,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":85,"brandBuilding":78,"socialMediaSavvy":76,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":67,"awareness":88,"judgement":93},"picture":"Sting.png"},{"id":163,"name":"Taeler Hendrix","realName":"Taeler Hendrix","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":125,"height":167,"dateOfBirth":"1989-06-07T00:00:00.000Z","debut":"2008-08-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":49,"micSkills":43,"condition":81,"hardcoreAbility":24,"injuryProne":100,"ability":43,"currentAbility":40,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Taeler Conrad-Mellen is an American professional wrestler and valet. Starting her career in 2008, she spent her first years working on the independent circuit for promotions including New England Championship Wrestling (NECW), Top Rope Promotions (TRP) and World Women's Wrestling (WWW), before being signed to a contract by Ohio Valley Wrestling (OVW), a Total Nonstop Action Wrestling (TNA) developmental territory, in 2011. In November 2011, Hendrix won the OVW Women's Championship, holding the championship for 203 days. Hendrix cites Tara, Sensational Sherri, Velvet McIntyre and her favorite male wrestlers are Curt Hennig and Chris Jericho.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3388],"staffAttributes":{"bookingLogic":49,"storytelling":51,"productFit":57,"riskTaking":37,"matchLayout":51,"psychology":49,"workerManagement":57,"trainingIntensity":55,"technicalCoaching":34,"characterCoaching":69,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":69,"brandBuilding":58,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":11,"reactionSpeed":55,"consistency":51,"awareness":49,"judgement":52},"picture":"Taeler Hendrix_alt1.png"},{"id":164,"name":"Velvet Sky","realName":"Velvet Sky","nickname":"","type":"commentator","base":"USA","gender":"F","weight":125,"height":162,"dateOfBirth":"1981-06-02T00:00:00.000Z","debut":"2003-01-01T00:00:00.000Z","wage":66000,"popularity":16,"charisma":14,"micSkills":14,"condition":67,"hardcoreAbility":12,"injuryProne":100,"ability":34,"currentAbility":27,"potentialAbility":27,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Velvet Sky is a retired American wrestler who works as a colour commentator and a manager. She was one half of Team T&A alongside April Hunter. She is best known for her work with AAA, IMPACT, ROH and NWA.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1383,1384,3335],"staffAttributes":{"bookingLogic":56,"storytelling":58,"productFit":100,"riskTaking":30,"matchLayout":59,"psychology":56,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":48,"characterCoaching":77,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":77,"brandBuilding":63,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":65,"awareness":56,"judgement":74},"picture":"Velvet Sky.png"},{"id":165,"name":"Taz","realName":"Taz","nickname":"","type":"commentator","promotionId":76,"base":"USA","gender":"M","weight":240,"height":172,"dateOfBirth":"1967-10-11T00:00:00.000Z","debut":"1987-01-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":25,"charisma":66,"micSkills":74,"condition":57,"hardcoreAbility":73,"injuryProne":68,"ability":57,"currentAbility":31,"potentialAbility":31,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Taz is a retired American wrestler who works as a colour commentator, a manager and an on-screen personality. He is best known for his work with WWE, NJPW, AEW, IMPACT and ECW. He is married to someone outside the wrestling business. He was voted Manager Of The Year in 2020.","alterEgos":["Tazmaniac","Tazz"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-165","wrestlerId":165,"promotionId":76,"startDate":"2020-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":81,"storytelling":86,"productFit":100,"riskTaking":32,"matchLayout":87,"psychology":81,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":44,"characterCoaching":69,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":69,"brandBuilding":54,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":55,"awareness":81,"judgement":89},"picture":"Taz.png"},{"id":166,"name":"Wes Brisco","realName":"Wes Brisco","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":224,"height":175,"dateOfBirth":"1983-02-21T00:00:00.000Z","debut":"2009-06-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":41,"micSkills":31,"condition":94,"hardcoreAbility":53,"injuryProne":100,"ability":54,"currentAbility":46,"potentialAbility":49,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Wes Brisco is an American professional wrestler. He is a member of the Brisco wrestling family; the son of former Championship Wrestling from Florida mainstay Gerald Brisco and the nephew of former NWA World Heavyweight Champion Jack Brisco. Brisco signed a developmental contract with World Wrestling Entertainment in 2009 and was sent to Florida Championship Wrestling for further training. After being released from WWE, Brisco started wrestling in the independent circuit, primarily in Florida. Brisco debuted on independent circuit at Florida Underground Wrestling, on October 14 2011. Brisco made his Total Nonstop Action Wrestling debut on the October 11, 2012, episode Impact Wrestling, in a backstage segment with Kurt Angle. On the January 31 episode of Impact Wrestling, Brisco and Bischoff revealed themselves as members of Aces & Eights and attacked Kurt Angle, turning heel in the process.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":35,"storytelling":40,"productFit":65,"riskTaking":26,"matchLayout":42,"psychology":35,"workerManagement":65,"trainingIntensity":65,"technicalCoaching":36,"characterCoaching":26,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":26,"brandBuilding":45,"socialMediaSavvy":21,"ruleKnowledge":0,"positioning":13,"reactionSpeed":65,"consistency":63,"awareness":35,"judgement":47},"picture":"Wes Brisco_alt2.png"},{"id":167,"name":"William Regal","realName":"William Regal","nickname":"","type":"scout","promotionId":65,"base":"UK","gender":"M","weight":243,"height":187,"dateOfBirth":"1968-05-10T00:00:00.000Z","debut":"1983-01-01T00:00:00.000Z","wage":20500,"wageType":"monthly","popularity":43,"charisma":97,"micSkills":100,"condition":50,"hardcoreAbility":84,"injuryProne":100,"ability":90,"currentAbility":50,"potentialAbility":50,"morale":"fair","presentation":"face","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":true,"story":"As a teenager, Regal traveled the roads of his native United Kingdom, wrestling fellow grapplers, as well as complete strangers out of the crowd, as part of a touring carnival act. Here, he fostered a reputation as a lethal opponent whose crushing submissions and stiff strikes could render even the heartiest adversaries totally helpless. Regal diversified his abilities by traveling the world, mastering different styles and winning championships in Europe, the Middle East and Japan.\r\n\r\nAfter finding further success in WCW, Regal carved a tremendous legacy in WWE, winning numerous championships and accolades worthy of such a competitor, including the mantle of Raw General Manager in 2007. Arguably his crowning achievement, however, was when he became truly regal, winning the prestigious 2008 King of the Ring Tournament.","alterEgos":[],"birthplace":"Codsall, Staffordshire, England","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-167","wrestlerId":167,"promotionId":65,"startDate":"2023-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[169,2832,2833],"staffAttributes":{"bookingLogic":56,"storytelling":38,"productFit":38,"riskTaking":26,"matchLayout":35,"psychology":54,"workerManagement":26,"trainingIntensity":46,"technicalCoaching":34,"characterCoaching":41,"teaching":49,"diagnosis":43,"rehabilitation":29,"prevention":56,"mediaHandling":47,"brandBuilding":52,"socialMediaSavvy":42,"ruleKnowledge":24,"positioning":41,"reactionSpeed":50,"consistency":40,"awareness":57,"judgement":80},"picture":"William Regal.png"},{"id":171,"name":"Taryn Terrell","realName":"Taryn Terrell","nickname":"","type":"manager","base":"USA","gender":"F","weight":125,"height":165,"dateOfBirth":"1985-12-28T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","wage":66000,"popularity":8,"charisma":41,"micSkills":65,"condition":82,"hardcoreAbility":43,"injuryProne":100,"ability":58,"currentAbility":51,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Taryn Terrell is a retired American wrestler who works primarily as a manager. She is best known for her work with WWE, IMPACT and NWA.","alterEgos":["Tiffany"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1391],"staffAttributes":{"bookingLogic":51,"storytelling":57,"productFit":44,"riskTaking":22,"matchLayout":59,"psychology":51,"workerManagement":44,"trainingIntensity":58,"technicalCoaching":48,"characterCoaching":74,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":74,"brandBuilding":73,"socialMediaSavvy":71,"ruleKnowledge":0,"positioning":9,"reactionSpeed":58,"consistency":64,"awareness":51,"judgement":48},"picture":"Taryn Terrell.png"},{"id":172,"name":"TJP","realName":"TJP","nickname":"","type":"wrestler","promotionId":5,"base":"USA","gender":"M","weight":174,"height":175,"dateOfBirth":"1984-09-03T00:00:00.000Z","debut":"1998-08-01T00:00:00.000Z","wage":41000,"wageType":"per-appearance","popularity":33,"charisma":73,"micSkills":86,"condition":83,"hardcoreAbility":92,"injuryProne":100,"ability":71,"currentAbility":71,"potentialAbility":84,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The flashy TJP broke into wrestling as a teenager, traveling throughout California and Mexico to sharpen his skills. He went on to hone his craft further at the Los Angeles dojo of New Japan Pro Wrestling along with Daniel Bryan and Shinsuke Nakamura, among others. After becoming the youngest American to compete for NJPW, TJP continued to travel around the world and establish himself as one of the preeminent grapplers on the planet.\r\n\r\nTJP backed up his swagger in the squared circle with top-notch technical wrestling, which helped him shock the world by defeating tournament favorite Kota Ibushi on his way to winning the inaugural Cruiserweight Classic and becoming the first WWE Cruiserweight Champion.","alterEgos":["TJ Perkins","Manik"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2028-01-17T00:00:00.000Z","contract":{"id":"tew-contract-172","wrestlerId":172,"promotionId":5,"startDate":"2026-01-17T00:00:00.000Z","endDate":"2028-01-17T00:00:00.000Z","wage":41000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2159,3640,3882,4274,4275],"staffAttributes":{"bookingLogic":75,"storytelling":78,"productFit":100,"riskTaking":21,"matchLayout":79,"psychology":75,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":75,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":64,"brandBuilding":48,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":70,"awareness":75,"judgement":85},"picture":"TJ Perkins_alt8.png"},{"id":174,"name":"Erick Redbeard","realName":"Erick Redbeard","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":312,"height":200,"dateOfBirth":"1981-11-28T00:00:00.000Z","debut":"2003-11-01T00:00:00.000Z","wage":37500,"popularity":35,"charisma":90,"micSkills":90,"condition":79,"hardcoreAbility":78,"injuryProne":100,"ability":65,"currentAbility":65,"potentialAbility":77,"morale":"fair","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Erick Redbeard is an American wrestler who works in America, Canada, Japan and Oceania. He is a Big Heavyweight who is classed as using a Powerhouse style. He is best known for his work with WWE, AEW and NXT. He is married to someone outside the wrestling business.","alterEgos":["Erick Rowan"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1092,1525,1892],"staffAttributes":{"bookingLogic":55,"storytelling":57,"productFit":100,"riskTaking":27,"matchLayout":58,"psychology":55,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":13,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":56,"brandBuilding":59,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":67,"awareness":55,"judgement":73},"picture":"Erick Rowan_alt8.png"},{"id":176,"name":"Rusev","realName":"Miro","nickname":"","type":"wrestler","promotionId":64,"base":"Europe","gender":"M","weight":279,"height":180,"dateOfBirth":"1985-12-25T00:00:00.000Z","debut":"2008-11-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":49,"charisma":83,"micSkills":62,"condition":86,"hardcoreAbility":78,"injuryProne":100,"ability":77,"currentAbility":77,"potentialAbility":80,"morale":"fair","presentation":"heel","prestige":"mid","style":"striker","cardPosition":"mid","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Miro is a Bulgarian wrestler who works in America, Canada and Europe. He is a Light Heavyweight who is classed as using a Brawler style. He is best known for his work with WWE, AEW and NXT. He is married to CJ Perry.","alterEgos":["Miro"],"birthplace":"Bulgaria","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-176","wrestlerId":176,"promotionId":64,"startDate":"2025-04-21T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2676,2726],"staffAttributes":{"bookingLogic":63,"storytelling":67,"productFit":100,"riskTaking":30,"matchLayout":68,"psychology":63,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":48,"characterCoaching":80,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":80,"brandBuilding":82,"socialMediaSavvy":82,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":79,"awareness":63,"judgement":78},"picture":"Rusev.png"},{"id":179,"name":"Dr. Vik","realName":"Vik","nickname":"","type":"wrestler","promotionId":79,"base":"Canada","gender":"M","weight":219,"height":185,"dateOfBirth":"1980-12-04T00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","wage":32800,"wageType":"per-appearance","popularity":10,"charisma":72,"micSkills":69,"condition":89,"hardcoreAbility":43,"injuryProne":100,"ability":55,"currentAbility":43,"potentialAbility":45,"morale":"broken","presentation":"heel","prestige":"low","style":"striker","cardPosition":"upper","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Apoc began his career in the Hart Dungeon under the teachings of Bruce and Ross Hart. He also received training under Tokyo Joe. He started working for Stampede Wrestling in 2001 as Bishop, later to be renamed \"Apocalypse\" which he continued to work as until 2008. In Stampede Wrestling, he won the North American Heavyweight Championship. He also held the International Tag Team Championship twice with partner Dave Swift. He did a tour with New Japan Pro Wrestling as \"The Shadow\" in November–December 2003. On January 16, 2008, APOC would debut under his new name Erik Doom and lost to Justin LaRouche. In February 2011, APOC signed a developmental contract with the WWE and was assigned to FCW under the ring name Rick Victor.","alterEgos":["Vik","Viktor"],"birthplace":"Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-179","wrestlerId":179,"promotionId":79,"startDate":"2023-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32800,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1377,1379,2395,4283],"staffAttributes":{"bookingLogic":62,"storytelling":68,"productFit":100,"riskTaking":17,"matchLayout":70,"psychology":62,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":56,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":62,"brandBuilding":46,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":78,"awareness":62,"judgement":77},"picture":"Viktor_alt3.png"},{"id":180,"name":"Charlotte Flair","realName":"Charlotte Flair","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"F","weight":143,"height":175,"dateOfBirth":"1986-04-05T00:00:00.000Z","debut":"2012-10-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":62,"charisma":75,"micSkills":82,"condition":94,"hardcoreAbility":78,"injuryProne":100,"ability":74,"currentAbility":74,"potentialAbility":78,"morale":"good","presentation":"face","prestige":"mid","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"She may be the daughter of 16-time World Champion Ric Flair, but Charlotte Flair is carving out a path of greatness all her own.\r\n\r\nDisplaying a level of athleticism that few Superstars in history can match, Charlotte first captured the attention of the WWE Universe with the type of statement victory that’s rarely been seen before or since. With her father watching on, Charlotte defeated Natalya at NXT TakeOver to win an eight-woman tournament on May 29, 2014, becoming the new NXT Women's Champion in the process. In the months that followed, the self-proclaimed “genetically superior athlete” turned back one challenger after another, helping cement the Women’s division as one of the most competitive in all of sports-entertainment.\r\n\r\nSoon, Charlotte made her long-awaited debut on Raw, helping to usher in a genuine women's evolution in WWE. Charlotte was the first of the new arrivals to win the Divas Title and the first athlete to win the Raw Women's Championship.","alterEgos":["Ashley Flair"],"birthplace":"Charlotte, North Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-180","wrestlerId":180,"promotionId":64,"startDate":"2012-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[995,4282],"staffAttributes":{"bookingLogic":79,"storytelling":80,"productFit":100,"riskTaking":33,"matchLayout":81,"psychology":79,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":64,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":76,"brandBuilding":86,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":55,"awareness":79,"judgement":87},"picture":"Charlotte Flair.png"},{"id":183,"name":"Paige","realName":"Saraya","nickname":"","type":"wrestler","promotionId":64,"base":"UK","gender":"F","weight":119,"height":170,"dateOfBirth":"1992-08-17T00:00:00.000Z","debut":"2005-04-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":51,"charisma":47,"micSkills":67,"condition":68,"hardcoreAbility":70,"injuryProne":100,"ability":53,"currentAbility":53,"potentialAbility":70,"morale":"good","presentation":"face","prestige":"mid","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Saraya is an English wrestler who works in America, Canada, the British Isles and Europe. She is a Very Small worker who is classed as using a Regular style. She is best known for her work with WWE, AEW, NXT, SHIMMER and EVE. She is dating someone outside the wrestling business.","alterEgos":["Saraya","Britani Knight"],"birthplace":"England","managerId":0,"contractExpiryDate":"2028-05-01T00:00:00.000Z","contract":{"id":"tew-contract-183","wrestlerId":183,"promotionId":64,"startDate":"2026-05-01T00:00:00.000Z","endDate":"2028-05-01T00:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[500,1146,4384],"staffAttributes":{"bookingLogic":60,"storytelling":64,"productFit":100,"riskTaking":35,"matchLayout":65,"psychology":60,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":52,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":78,"brandBuilding":80,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":43,"awareness":60,"judgement":76},"picture":"Paige.png"},{"id":184,"name":"Byron Saxton","realName":"Byron Saxton","nickname":"","type":"interviewer","promotionId":64,"base":"USA","gender":"M","weight":230,"height":175,"dateOfBirth":"1981-08-20T00:00:00.000Z","debut":"2003-08-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":14,"charisma":49,"micSkills":37,"condition":90,"hardcoreAbility":55,"injuryProne":90,"ability":50,"currentAbility":40,"potentialAbility":40,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"From in-ring competitor to color commentator, Byron Saxton has done it all in WWE. After receiving a bachelor's degree from the University of Florida, Saxton worked as a reporter and anchor for WJXT Channel 4 News in Jacksonville, Fla. This on-camera experience proved to be very useful as he began his career in the ring, which was preceded by a stint as an ECW announcer. A rookie rooted in both the fourth and fifth seasons of NXT, Saxton worked with NXT Pros like Dolph Ziggler and Yoshi Tatsu. Byron honed his skills under some of the brightest stars in the WWE Universe, and now, this charismatic and camera-friendly Superstar uses his diverse abilities to make a lasting impression in WWE as a dynamic color commentator.","alterEgos":[],"birthplace":"Burke, Virginia, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-184","wrestlerId":184,"promotionId":64,"startDate":"2012-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":54,"storytelling":21,"productFit":33,"riskTaking":41,"matchLayout":22,"psychology":35,"workerManagement":45,"trainingIntensity":58,"technicalCoaching":56,"characterCoaching":32,"teaching":41,"diagnosis":40,"rehabilitation":57,"prevention":47,"mediaHandling":55,"brandBuilding":71,"socialMediaSavvy":68,"ruleKnowledge":20,"positioning":25,"reactionSpeed":60,"consistency":53,"awareness":37,"judgement":25},"picture":"Byron Saxton.png"},{"id":185,"name":"Chris Hero","realName":"Chris Hero","nickname":"","type":"trainer","promotionId":76,"base":"USA","gender":"M","weight":268,"height":190,"dateOfBirth":"1979-12-24T00:00:00.000Z","debut":"1998-09-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":23,"charisma":100,"micSkills":86,"condition":70,"hardcoreAbility":94,"injuryProne":100,"ability":95,"currentAbility":73,"potentialAbility":75,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"When Kassius Ohno hits the ring, it can only mean one thing: Someone’s about to get their lights turned out.\r\n\r\nHero is a feared striker who’s traveled the world to make a name for himself in the ring while dishing out devastating blows, such as his patented Rolling Elbow. He arrived on the scene in NXT in 2012, cold-cocking everyone in his path while making it clear he was a top contender to the NXT Championship. However, Hero’s title dreams did not pan out before his departure in late 2013.\r\n\r\nThe Knockout Artist returned to the independent scene shortly thereafter and wasted no time establishing himself as one of the best competitors on the planet. Still, those unfulfilled championship dreams left Hero with unfinished business in NXT, as he made known upon his shocking comeback to the black-and-yellow brand in early 2017.","alterEgos":["Kassius Ohno"],"birthplace":"Dayton, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-185","wrestlerId":185,"promotionId":76,"startDate":"2023-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[702,1144,1347,2710,2748],"staffAttributes":{"bookingLogic":40,"storytelling":27,"productFit":24,"riskTaking":51,"matchLayout":34,"psychology":52,"workerManagement":51,"trainingIntensity":76,"technicalCoaching":69,"characterCoaching":50,"teaching":90,"diagnosis":50,"rehabilitation":55,"prevention":48,"mediaHandling":43,"brandBuilding":59,"socialMediaSavvy":24,"ruleKnowledge":35,"positioning":20,"reactionSpeed":59,"consistency":40,"awareness":27,"judgement":40},"picture":"Chris Hero_alt4.png"},{"id":186,"name":"Big Cass","realName":"Big Bill","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":282,"height":205,"dateOfBirth":"1986-08-16T00:00:00.000Z","debut":"2010-10-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":33,"charisma":75,"micSkills":89,"condition":81,"hardcoreAbility":64,"injuryProne":100,"ability":66,"currentAbility":66,"potentialAbility":70,"morale":"poor","presentation":"heel","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Growing up on the mean streets of Queens, NY – Colin Cassady found out very quickly that he had to learn how to defend himself in order to survive. It was in that borough where Colin refined his trash-talking skills; developing into the brash and confident individual he is today.\r\nCassady is also a money-hungry capitalist who does not shy away from flaunting his wealth and business acumen. Business smart and street wise, this 6’10 athlete uses his considerable size and commanding presence to his advantage in the realm of sports entertainment.  This trash-talking titan is not afraid to go toe-to-toe with anyone and feels he is fated to be the “realist of them all”. Colin states: “Most people spend their whole lives trying to make it big… but I… well, I was BORN TO BE BIG!”","alterEgos":["Big Bill","W. Morrissey"],"birthplace":"Queens, New York, United States","managerId":0,"contractExpiryDate":"2026-08-06T00:00:00.000Z","contract":{"id":"tew-contract-186","wrestlerId":186,"promotionId":64,"startDate":"2026-07-13T00:00:00.000Z","endDate":"2026-08-06T00:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1045,1046,2071,3868,4184,4376],"staffAttributes":{"bookingLogic":61,"storytelling":62,"productFit":100,"riskTaking":21,"matchLayout":63,"psychology":61,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":18,"characterCoaching":77,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":77,"brandBuilding":84,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":77,"awareness":61,"judgement":77},"picture":"Big Cass.png"},{"id":192,"name":"Sami Zayn","realName":"Sami Zayn","nickname":"","type":"wrestler","promotionId":64,"base":"Canada","gender":"M","weight":211,"height":182,"dateOfBirth":"1984-07-12T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":63,"charisma":90,"micSkills":90,"condition":77,"hardcoreAbility":90,"injuryProne":100,"ability":78,"currentAbility":78,"potentialAbility":91,"morale":"good","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"A Canadian-born Superstar of Syrian descent, Sami Zayn brought with him an experience level matched by few when he arrived in WWE. After all, how many Superstars can say they have competed in a staggering 29 countries?\r\n\r\nKnown as an honorable competitor who approached situations with a lighthearted, fun-loving attitude, Zayn changed his tune at WWE Hell in Cell 2017 when he interfered in the main event and helped his old friend Kevin Owens overcome Shane McMahon.\r\n\r\nLike him of loathe him, no one could afford to underestimate Zayn’s intensity in the squared circle. His in-ring presence incorporates an eclectic blend of styles, from his explosive aerial moves to his hard-hitting strikes. Simply put, Zayn can take down any Superstar on the roster — an ability he has displayed in show-stealing matches against the likes of Owens, Cesaro and John Cena.","alterEgos":["El Generico","Remi Sebei"],"birthplace":"Laval, Quebec, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-192","wrestlerId":192,"promotionId":64,"startDate":"2016-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[976,1040,1330,1744,2516,2778],"staffAttributes":{"bookingLogic":85,"storytelling":85,"productFit":100,"riskTaking":19,"matchLayout":85,"psychology":85,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":74,"characterCoaching":87,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":87,"brandBuilding":64,"socialMediaSavvy":89,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":83,"awareness":85,"judgement":91},"picture":"Sami Zayn.png"},{"id":194,"name":"El Hijo de Dos Caras","realName":"El Hijo de Dos Caras","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":233,"height":182,"dateOfBirth":"1988-06-26T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":41,"micSkills":54,"condition":90,"hardcoreAbility":35,"injuryProne":100,"ability":53,"currentAbility":49,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"The Brother of WWE superstar Alberto Del Rio and son of the legendary Dos Caras. Wrestled as Dark Phoenix before signing with WWE. Driven by ambition and the will to live up to the high expectations of his family, Memo Montenegro has arrived at NXT to prove he has what it takes to make a dent in the world of Sports Entertainment. This second generation superstar comes from a lofty Sports Entertainment family lineage, but is determined to make it on his own merits. He looks to do such by using his catlike quickness, uncanny agility and lucha libre style of Sports Entertainment. Memo is a perfect example of never judging a book by its cover. On the surface, this youthful competitor may appear distinguished and dignified, but Memo has recently exhibited a darker and more aggressive side in the squared circle of NXT.","alterEgos":["Memo Montenegro"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1195],"staffAttributes":{"bookingLogic":53,"storytelling":57,"productFit":62,"riskTaking":30,"matchLayout":58,"psychology":53,"workerManagement":62,"trainingIntensity":75,"technicalCoaching":36,"characterCoaching":38,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":38,"brandBuilding":70,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":12,"reactionSpeed":75,"consistency":71,"awareness":53,"judgement":57},"picture":"Hijo de Dos Caras.png"},{"id":195,"name":"Jamie Noble","realName":"James Gibson","nickname":"","type":"writer","promotionId":64,"base":"USA","gender":"M","weight":202,"height":167,"dateOfBirth":"1976-12-23T00:00:00.000Z","debut":"1995-02-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":20,"charisma":100,"micSkills":91,"condition":70,"hardcoreAbility":96,"injuryProne":100,"ability":83,"currentAbility":59,"potentialAbility":59,"morale":"poor","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"James Howard Gibson better known by his WWE ring name Jamie Noble, is an American former professional wrestler working for WWE as a producer. He is best known for his work from 2002 to 2009 when a severe back injury forced him to retire from competition. He is also known for his appearances in World Championship Wrestling in its cruiserweight division under the names Jamie-San and Jamie Knoble and is a one time Cruiserweight Champion. Gibson also wrestled in Ring of Honor as James Gibson and is a one time world champion, having won the ROH World Championship during his time in that organization.","alterEgos":["James Gibson"],"birthplace":"Hanover, West Virginia, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-195","wrestlerId":195,"promotionId":64,"startDate":"2009-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2756],"staffAttributes":{"bookingLogic":82,"storytelling":84,"productFit":100,"riskTaking":16,"matchLayout":84,"psychology":82,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":64,"characterCoaching":64,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":64,"brandBuilding":48,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":51,"consistency":75,"awareness":82,"judgement":89},"picture":"Jamie Noble.png"},{"id":196,"name":"Jason Ayers","realName":"Jason Ayers","nickname":"","type":"referee","promotionId":64,"base":"USA","gender":"M","weight":150,"height":175,"dateOfBirth":"1982-01-13T00:00:00.000Z","debut":"1998-10-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":3,"charisma":97,"micSkills":90,"condition":100,"hardcoreAbility":79,"injuryProne":100,"ability":73,"currentAbility":60,"potentialAbility":62,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jason Ayers is an American man who works primarily as a referee. He is best known for his work with WWE, ROH, NXT and EVOLVE.","alterEgos":[],"birthplace":"Havelock, North Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-196","wrestlerId":196,"promotionId":64,"startDate":"2016-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00: