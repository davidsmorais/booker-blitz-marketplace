e":"Trevor Lee","nickname":"","type":"wrestler","promotionId":68,"base":"USA","gender":"M","weight":220,"height":180,"dateOfBirth":"1993-09-30T00:00:00.000Z","debut":"2009-11-01T00:00:00.000Z","wage":19700,"wageType":"per-appearance","popularity":25,"charisma":74,"micSkills":61,"condition":90,"hardcoreAbility":70,"injuryProne":100,"ability":61,"currentAbility":60,"potentialAbility":87,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"With a devastating offense that’s equal parts gritty and opportunistic, Cameron Grimes is nothing less than a technical savage.\r\n\r\nBoasting “country power” and the force of cinder blocks for legs, the second-generation grappler from Burlington, N.C., has no trouble bringing the school of hard knocks to the ring. \r\n\r\nIf his leaping foot stomps aren’t caving in his opponents’ chests, his battering ram-like strikes are sure to make the most intimidating competitors shriek. Of course, he learned from the best. His father, Tracy Caddell, wrestled alongside The Hardy Boyz in the revolutionary indie promotion, OMEGA, and Matt & Jeff were key influences on Grimes during his formative years.","alterEgos":["Cameron Grimes"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2028-01-29T00:00:00.000Z","contract":{"id":"tew-contract-1593","wrestlerId":1593,"promotionId":68,"startDate":"2026-01-29T00:00:00.000Z","endDate":"2028-01-29T00:00:00.000Z","wage":19700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[961,1440,1756],"staffAttributes":{"bookingLogic":62,"storytelling":66,"productFit":100,"riskTaking":32,"matchLayout":68,"psychology":62,"workerManagement":100,"trainingIntensity":92,"technicalCoaching":65,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":76,"brandBuilding":52,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":92,"consistency":72,"awareness":62,"judgement":77},"picture":"Trevor Lee_alt6.png"},{"id":1601,"name":"Gentleman Jervis","realName":"Gentleman Jervis","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":200,"height":180,"dateOfBirth":"1987-10-18T00:00:00.000Z","debut":"2014-02-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":38,"micSkills":57,"condition":97,"hardcoreAbility":52,"injuryProne":98,"ability":45,"currentAbility":41,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"comedy","cardPosition":"lower","finisher":"","finisherType":"counter","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"Gentleman Jervis is a masked American wrestler who works exclusively in America. He is a Lightweight who is classed as using a Comedy style.","alterEgos":["Kevin Condron"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2929,2930],"staffAttributes":{"bookingLogic":40,"storytelling":46,"productFit":38,"riskTaking":37,"matchLayout":48,"psychology":40,"workerManagement":38,"trainingIntensity":58,"technicalCoaching":40,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":67,"brandBuilding":25,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":8,"reactionSpeed":58,"consistency":51,"awareness":40,"judgement":39},"picture":"Jervis Cottonbelly.png"},{"id":1602,"name":"Ivar","realName":"Hanson","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":293,"height":185,"dateOfBirth":"1984-03-03T00:00:00.000Z","debut":"2001-03-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":34,"charisma":70,"micSkills":68,"condition":85,"hardcoreAbility":73,"injuryProne":100,"ability":66,"currentAbility":66,"potentialAbility":69,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The Viking Raiders, Ivar & Erik, have one objective in mind: World domination.\r\n\r\nFor years, The Viking Raiders used brute force to capture tag team titles wherever they went, from the U.K. to Japan. Looking to devour new competition, Ivar & Erik turned their attention to the NXT Tag Team scene in early 2018. Their impact was felt immediately, as The Viking Raiders arrived by surprise to unleash a barrage on two of the black-and-yellow brand’s top tandems, Heavy Machinery and Riddick Moss & Tino Sabbatelli, less than one week after NXT TakeOver: New Orleans.\r\n\r\nIvar & Erik, whose gruff exteriors would look right at home beyond the wall in “Game of Thrones,” have made smash-mouth collisions their stock in trade. Yet, Ivar, a protégé of WWE Hall of Famer Killer Kowalski, is also deceptively agile for a man of his size. Every bit as athletic as he is ferocious, the 300-pounder has been known to come crashing down on opponents from the top rope.","alterEgos":["Hanson"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1602","wrestlerId":1602,"promotionId":64,"startDate":"2019-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1562,1563,1691,2307],"staffAttributes":{"bookingLogic":62,"storytelling":66,"productFit":100,"riskTaking":28,"matchLayout":67,"psychology":62,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":47,"characterCoaching":60,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":60,"brandBuilding":56,"socialMediaSavvy":52,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":77,"awareness":62,"judgement":77},"picture":"Ivar.png"},{"id":1603,"name":"Erik","realName":"Raymond Rowe","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":247,"height":182,"dateOfBirth":"1984-08-21T00:00:00.000Z","debut":"2003-05-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":34,"charisma":89,"micSkills":81,"condition":82,"hardcoreAbility":66,"injuryProne":100,"ability":62,"currentAbility":62,"potentialAbility":65,"morale":"poor","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The Viking Raiders, Erik & Ivar, are bent on world domination. The powerful alliance made strides toward that goal for years, decimating tag team competition around the globe, from the U.K. to Japan. In early 2018, the bruising brawlers turned their focus to the NXT Tag Team division, much to the detriment of every other duo on the black-and-yellow brand. Their arrival was explosive: Erik & Ivar ambushed Heavy Machinery and Riddick Moss & Tino Sabbatelli in an amazing display of force. Looking like warriors ready to plunder an unsuspecting village, Erik & Ivar possess an in-ring ferocity that matches their fearsome appearance. Erik boasts incredible power, the perfect complement to Ivar's surprising speed and agility. With years of experience teaming together, The Viking Raiders have also perfected their tag-team craft, resulting in one of WWE’s most well-honed tandem arsenals.","alterEgos":["Raymond Rowe"],"birthplace":"Cleveland, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1603","wrestlerId":1603,"promotionId":64,"startDate":"2018-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1562,1563,1691,1692,2307],"staffAttributes":{"bookingLogic":64,"storytelling":68,"productFit":100,"riskTaking":30,"matchLayout":70,"psychology":64,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":37,"characterCoaching":50,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":50,"brandBuilding":56,"socialMediaSavvy":25,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":73,"awareness":64,"judgement":78},"picture":"Erik.png"},{"id":1604,"name":"Kongo Kong","realName":"Kongo Kong","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":383,"height":200,"dateOfBirth":"1979-08-10T00:00:00.000Z","debut":"1999-02-13T00:00:00.000Z","wage":4166,"popularity":4,"charisma":55,"micSkills":46,"condition":89,"hardcoreAbility":50,"injuryProne":100,"ability":40,"currentAbility":31,"potentialAbility":33,"morale":"broken","presentation":"heel","prestige":"low","style":"striker","cardPosition":"mid","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kongo Kong is an American wrestler who works in America and Canada. He is a Super Heavyweight who is classed as using a Brawler style. He is best known for his work with IWA:MS.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":45,"storytelling":53,"productFit":100,"riskTaking":32,"matchLayout":56,"psychology":45,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":