ncy":27,"awareness":30,"judgement":61},"picture":"Dave Lagana.png"},{"id":748,"name":"LuDarK ShAiTAN","realName":"LuDarK ShAiTAN","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":141,"height":162,"dateOfBirth":"1992-06-19T00:00:00.000Z","debut":"2010-03-01T00:00:00.000Z","wage":3000,"popularity":2,"charisma":51,"micSkills":39,"condition":73,"hardcoreAbility":58,"injuryProne":100,"ability":40,"currentAbility":39,"potentialAbility":46,"morale":"broken","presentation":"face","prestige":"low","style":"hardcore","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Ludark Shaitan (stylized LuDarK ShAiTAN) is a Mexican wrestler that made her debut along with her cousin Sexy Lady in early 2010. Currenty one of a handful of female wrestlers on DTU's lineup where she is enjoying some success. She was trained by Dr. Karonte, El As, Platino and Silver King.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":38,"storytelling":42,"productFit":69,"riskTaking":55,"matchLayout":43,"psychology":38,"workerManagement":69,"trainingIntensity":60,"technicalCoaching":38,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":45,"mediaHandling":64,"brandBuilding":54,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":14,"reactionSpeed":60,"consistency":68,"awareness":38,"judgement":50},"picture":"Ludark Shaitan.png"},{"id":749,"name":"Pesadilla","realName":"Pesadilla","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":176,"height":182,"dateOfBirth":"1986-07-24T00:00:00.000Z","debut":"2004-03-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":40,"micSkills":57,"condition":92,"hardcoreAbility":63,"injuryProne":100,"ability":46,"currentAbility":41,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"Pesadilla (Spanish for Nightmare) is a Mexican Luchadore. He appeared in AAA during and around the 2006 AAA Luchando Por un Sueño tournament, beating Nemesis but losing to Laredo Kid. Didn't stick with AAA, but worked their spot shows within range of Tulancingo. Appears in promotions started by people from his city: Super Crazy's LJLL and Crazy Boy's DTU. (The three are listed as related, but it's unverified.) Has appeared on Perros del Mal undercards.","alterEgos":["Nowhere Man"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1007],"staffAttributes":{"bookingLogic":53,"storytelling":56,"productFit":50,"riskTaking":36,"matchLayout":57,"psychology":53,"workerManagement":50,"trainingIntensity":69,"technicalCoaching":53,"characterCoaching":27,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":27,"brandBuilding":42,"socialMediaSavvy":18,"ruleKnowledge":0,"positioning":10,"reactionSpeed":69,"consistency":86,"awareness":53,"judgement":52},"picture":"Pesadilla.png"},{"id":751,"name":"El Hijo de Dr. Wagner Jr.","realName":"El Hijo de Dr. Wagner Jr.","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":229,"height":175,"dateOfBirth":"1991-12-04T00:00:00.000Z","debut":"2010-01-01T00:00:00.000Z","wage":41000,"wageType":"per-appearance","popularity":23,"charisma":77,"micSkills":87,"condition":87,"hardcoreAbility":65,"injuryProne":100,"ability":70,"currentAbility":70,"potentialAbility":76,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"El Hijo de Dr. Wagner is a Mexican luchador enmascarado currently working on the Mexican Independent circuit, including International Wrestling Revolution Group (IWRG). While his name indicates that he is the son of Dr. Wagner, he is actually the grandson of Dr. Wagner and the son of Dr. Wagner, Jr. His mother is professional wrestler Rossy Moreno and he is part of both the Wagner and the Moreno wrestling families. Before his official debut he was at times referred to as \"Dr. Wagner III\" (\"Dr. Wagner the Third\") by some lucha libre publications, but that name was never officially used. He made his debut on a Perros del Mal show on December 25, 2009 teaming with C. Manson, X-Fly and his uncle Groon XXX as the team defeated El Oriental, Halloween, Hysteria Extreme and Máscara Año 2000, Jr.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-06-15T00:00:00.000Z","contract":{"id":"tew-contract-751","wrestlerId":751,"promotionId":5,"startDate":"2024-06-15T00:00:00.000Z","endDate":"2026-06-15T00:00:00.000Z","wage":41000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2068,3004,3005,4065,4244],"staffAttributes":{"bookingLogic":76,"storytelling":77,"productFit":100,"riskTaking":23,"matchLayout":78,"psychology":76,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":74,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":70,"brandBuilding":78,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":74,"awareness":76,"judgement":86},"picture":"El Hijo del Dr. Wagner Jr._alt1.png"},{"id":752,"name":"El Hijo de L.A. Park","realName":"El Hijo de L.A. Park","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":198,"height":180,"dateOfBirth":"1988-11-20T00:00:00.000Z","debut":"2008-07-01T00:00:00.000Z","wage":37500,"popularity":7,"charisma":53,"micSkills":64,"condition":91,"hardcoreAbility":41,"injuryProne":100,"ability":66,"currentAbility":61,"potentialAbility":66,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"A new generation of wickedness has risen from the ground with the emergence of Hijo de LA Park.\r\n\r\nThe son of the legendary luchador LA Park, this high-risk and high-flying luchador has exceptional speed and athleticism.\r\n\r\nDonning a ghoulish skull mask and the iconic skeleton ring gear his father made famous, Hijo de LA Park’s intimidating presence alone can overwhelm some adversaries.\r\n\r\nWhat makes Hijo de LA Park a challenge is the unknown. He’s a mystery to many wrestlers as a newcomer to MLW.","alterEgos":["Black Spirit"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2003,2324,2326,2328],"staffAttributes":{"bookingLogic":54,"storytelling":59,"productFit":87,"riskTaking":33,"matchLayout":60,"psychology":54,"workerManagement":87,"trainingIntensity":66,"technicalCoaching":54,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":70,"brandBuilding":68,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":17,"reactionSpeed":66,"consistency":66,"awareness":54,"judgement":67},"picture":"Hijo de LA PARK.png"},{"id":754,"name":"Lizmark Jr.","realName":"Lizmark Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":262,"height":185,"dateOfBirth":"1972-10-16T00:00:00.000Z","debut":"1991-07-01T00:00:00.000Z","wage":37500,"popularity":7,"charisma":77,"micSkills":61,"condition":59,"hardcoreAbility":55,"injuryProne":100,"ability":58,"currentAbility":37,"potentialAbility":39,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":true,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Juan Carlos Baños is a Mexican professional wrestler or \"Luchador\" known as Lizmark, Jr. or El Hijo del Lizmark (Son of Lizmark). Lizmark, Jr. is actually the son of the professional wrestler Lizmark, not just using the ring name as is at times the case in Lucha libre. Lizmark was a big star in Mexico in the 1980s and 1990s. Outside of Mexico, Lizmark, Jr. is probably best remembered for his stint in World Championship Wrestling (WCW) where he was part of the groups cruiserweight division in the late 1990s. In the 2000s, Lizmark, Jr. started working for Consejo Mundial de Lucha Libre (CMLL), Mexico's top wrestling promotion and the oldest promotion still active today. Lizmark, Jr. turned rudo, joined up with Los Perros del Mal and has been moving up the ranks to main eventing on a regular basis.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":38,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":62,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":64,"brandBuilding":56,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":78,"awareness":58,"judgement":75},"picture":"Lizmark Jr.png"},{"id":756,"name":"Amazing Red","realName":"Amazing Red","nickname":"","type":"wrestler","promotionId":28,"base":"USA","gender":"M","weight":150,"height":165,"dateOfBirth":"1982-04-26T00:00:00.000Z","debut":"1999-04-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":10,"charisma":75,"micSkills":67,"condition":67,"hardcoreAbility":91,"injuryProne":100,"ability":63,"currentAbility":63,"potentialAbility":85,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jonathan Figueroa is a professional wrestler better known by his ring name, (The) Amazing Red, or simply Red for short. He is best known for working for Total Nonstop Action Wrestling, where he is a former three-time X Division Champion, while also working on the American independent circuit. Figueroa is also one of the head trainers of the House of Glory wrestling school, based in Ridgewood, Queens, New York City. Figueroa originally wrestled as Red, but Savio Vega decided to expand his ring name to include the word \"Amazing\" while he worked for the International Wrestling Association in Puerto Rico, giving origin to his more common pseudonym, Amazing Red.","alterEgos":["Sangriento"],"birthplace":"Cayey, Puerto Rico","managerId":0,"contractExpiryDate":"2027-10-12T00:00:00.000Z","contract":{"id":"tew-contract-756","wrestlerId":756,"promotionId":28,"startDate":"2026-10-12T00:00:00.000Z","endDate":"2027-10-12T00:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":66,"storytelling":69,"productFit":100,"riskTaking":32,"matchLayout":70,"psychology":66,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":60,"characterCoaching":40,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":40,"brandBuilding":40,"socialMediaSavvy":26,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":75,"awareness":66,"judgement":80},"picture":"Amazing Red.png"},{"id":757,"name":"Abdullah Kobayashi","realName":"Abdullah Kobayashi","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":364,"height":172,"dateOfBirth":"1976-07-22T00:00:00.000Z","debut":"1995-05-01T00:00:00.000Z","wage":4166,"popularity":5,"charisma":42,"micSkills":69,"condition":66,"hardcoreAbility":50,"injuryProne":100,"ability":45,"currentAbility":32,"potentialAbility":34,"morale":"broken","presentation":"face","prestige":"low","style":"hardcore","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Yosuke Kobayashi is a Japanese professional wrestler best known by his stage name Abdullah Kobayashi after Abdullah the Butcher, who was his trainer. He began his career in 1995 as one of the main wrestlers in Big Japan Pro Wrestling and has wrestled for Big Japan Pro Wrestling throughout most of his career. He is well known for his very brutal deathmatches with the likes of Ryuji Ito and several other BJPW wrestlers. On June 26, 2010, Kobayashi made his American debut in Combat Zone Wrestling's Tournament of Death IX defeating Nick Gage in the first round but lost in the second to JC Bailey.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1241,2303],"staffAttributes":{"bookingLogic":68,"storytelling":67,"productFit":100,"riskTaking":43,"matchLayout":67,"psychology":68,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":23,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":78,"brandBuilding":38,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":68,"awareness":68,"judgement":81},"picture":"Abdullah Kobayashi.png"},{"id":758,"name":"Alex Colon","realName":"Alex Colon