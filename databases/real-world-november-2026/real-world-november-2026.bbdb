okings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Nick Comoroto, who graduated from The Monster Factory on 01 July 2014, is an American wrestler who works in the USA and Canada. He is a 6'3\", 273lb worker who is classed as using a Powerhouse style. He uses the Powerbomb as his finisher. He is best known for his work with AEW, NXT and ROH. He is the protege of QT Marshall.","alterEgos":["Nick Ogarelli"],"birthplace":"Blackwood, New Jersey, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3064","wrestlerId":3064,"promotionId":49,"startDate":"2023-04-20T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":16400,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2737],"staffAttributes":{"bookingLogic":43,"storytelling":48,"productFit":52,"riskTaking":38,"matchLayout":49,"psychology":43,"workerManagement":52,"trainingIntensity":63,"technicalCoaching":36,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":65,"brandBuilding":76,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":10,"reactionSpeed":63,"consistency":63,"awareness":43,"judgement":47},"picture":"Nick Comoroto.png"},{"id":3065,"name":"Kris Levin","realName":"Kris Levin","nickname":"","type":"referee","base":"USA","gender":"M","weight":141,"height":170,"dateOfBirth":"1992-07-29T00:00:00.000Z","debut":"2007-01-01T00:00:00.000Z","wage":66000,"popularity":0,"charisma":66,"micSkills":65,"condition":100,"hardcoreAbility":68,"injuryProne":100,"ability":61,"currentAbility":60,"potentialAbility":67,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kris Levin is an American man who works primarily as a referee. He is best known for his work with ICW NHB and Beyond.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":49,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":49,"brandBuilding":11,"socialMediaSavvy":33,"ruleKnowledge":51,"positioning":41,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Kris Levin.png"},{"id":3067,"name":"Kacy Catanzaro","realName":"Kacy Catanzaro","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":100,"height":149,"dateOfBirth":"1990-01-14T00:00:00.000Z","debut":"2017-01-01T00:00:00.000Z","wage":37500,"popularity":31,"charisma":59,"micSkills":54,"condition":97,"hardcoreAbility":56,"injuryProne":100,"ability":49,"currentAbility":47,"potentialAbility":53,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kacy Catanzaro is a mighty as they come.\r\n\r\nThe 5-foot tall dynamo is living proof that even in WWE, size doesn’t always matter. A marvel under the spotlight, Catanzaro wowed the world in 2014, when she became the first woman to scale the perilous Warped Wall obstacle on NBC’s “American Ninja Warrior.” Prior to obstacle-course racing, the mind-blowing athlete was also an NCAA Division I gymnast and was named the Southeast Regional Gymnast of the Year in 2012. She is also a two-time designee in Sports Illustrated’s Fitted 50 list, which celebrates the world’s fittest athletes.\r\n\r\nAll those milestones are now batteries in the mighty engine’s back, as she continues to reach greater heights under the NXT umbrella. After reporting to the WWE Performance Center in 2018, Catanzaro has amplified her world-class athleticism and lightning-quick agility, leaving the WWE Universe with a gasp after her incredible performances in the 2018 Mae Young Classic and the 2019 Women’s Royal Rumble Match.","alterEgos":["Katana Chance"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2344,3727],"staffAttributes":{"bookingLogic":48,"storytelling":52,"productFit":29,"riskTaking":30,"matchLayout":54,"psychology":48,"workerManagement":29,"trainingIntensity":73,"technicalCoaching":38,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":56,"brandBuilding":55,"socialMediaSavvy":37,"ruleKnowledge":0,"positioning":6,"reactionSpeed":73,"consistency":72,"awareness":48,"judgement":40},"picture":"Kacy Catanzaro.png"},{"id":3068,"name":"Tyson La Bestia","realName":"Tyson La Bestia","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":220,"height":182,"dateOfBirth":"1978-07-10T00:00:00.000Z","debut":"2014-11-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":54,"micSkills":60,"condition":88,"hardcoreAbility":38,"injuryProne":100,"ability":41,"currentAbility":31,"potentialAbility":33,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Tyson La Bestia is a masked Mexican luchador who works exclusively in Mexico. He is a Middleweight who is classed as using a Luchador style. He is best known for his work with CMLL and IWRG. He is married to Marcela.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws"