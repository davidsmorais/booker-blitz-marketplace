 appearances outside of CMLL, but there is no pretense that it is two difference characters that he is playing. Hechicero is Spanish for \"Wizard\" and \"Rey Hechicero\" means \"Wizard King\".","alterEgos":["Rey Hechicero"],"birthplace":"Monterrey, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1638","wrestlerId":1638,"promotionId":11,"startDate":"2014-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":64000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":75,"storytelling":79,"productFit":100,"riskTaking":18,"matchLayout":80,"psychology":75,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":90,"characterCoaching":80,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":80,"brandBuilding":76,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":72,"awareness":75,"judgement":85},"picture":"Hechicero.png","additionalContracts":[{"id":"tew-contract-1638-76","wrestlerId":1638,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW"]},{"id":1639,"name":"Davey Vega","realName":"Davey Vega","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":180,"height":177,"dateOfBirth":"1985-07-10T00:00:00.000Z","debut":"2006-02-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":53,"micSkills":51,"condition":91,"hardcoreAbility":71,"injuryProne":100,"ability":46,"currentAbility":40,"potentialAbility":43,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","