":[934,1647,1658,2045,3430,3658,3799],"staffAttributes":{"bookingLogic":68,"storytelling":72,"productFit":100,"riskTaking":22,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":65,"characterCoaching":77,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":77,"brandBuilding":45,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":72,"awareness":68,"judgement":81},"picture":"Ryusuke Taguchi.png"},{"id":329,"name":"Tiger Mask IV","realName":"Tiger Mask IV","nickname":"","type":"writer","promotionId":38,"base":"Japan","gender":"M","weight":187,"height":170,"dateOfBirth":"1970-10-20T00:00:00.000Z","debut":"1995-07-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":14,"charisma":76,"micSkills":70,"condition":47,"hardcoreAbility":100,"injuryProne":100,"ability":80,"currentAbility":47,"potentialAbility":47,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"Yoshihiro Yamazaki, best known by his ring name Tiger Mask (IV), is a Japanese professional wrestler who currently works for New Japan Pro Wrestling. Yamazaki is the fourth wrestler to portray the Tiger Mask image / persona; having used it since 1995. This makes him the person to have used the \"Tiger Mask\" gimmick the longest time. The young Yamazaki was originally trained by the original Tiger Mask (Satoru Sayama) and The Great Sasuke and unlike Tiger Mask II and Tiger Mask III, Yamazaki has been endorsed by Sayama himself. He also traveled to Mexico where he trained in lucha libre. Considered by many to be both selfish and lazy and many question why he was endorsed by Sayama to continue the legacy.","alterEgos":[],"birthplace":"Urayasu, Chiba, Japan","managerId":0,"contractExpiryDate":