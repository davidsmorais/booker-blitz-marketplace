,"dead":false,"inDevelopment":false,"story":"After debuting in 2015 on the American independent scene, Fredericks took a bold step and made a fresh start, entering the NJPW LA Dojo in 2018. Studying under Katsuyori Shibata, he was embued with an old school fighting spirit, and while he is still young in his career, he has unlimited potential. Together with Clark Connors, he participated in G1 Climax 29, where he wrestled in the warm-up matches. He was particularly physical with his Japanese Young Lion opposite numbers in these matchups. As the Young Lion competition grew stronger, the Young Lion Cup was announced for the Road to Destruction tour, with Fredericks one of the eight entrants. Fredericks would go on to win the cup, certifying himself as one of the very top prospects in NJPW, regardless of Dojo affiliation.","alterEgos":["Eddy Thorpe"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":52,"storytelling":57,"productFit":49,"riskTaking":27,"matchLayout":58,"psychology":52,"workerManagement":49,"trainingIntensity":73,"technicalCoaching":60,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":58,"brandBuilding":71,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":10,"reactionSpeed":73,"consistency":61,"awareness":52,"judgement":51},"picture":"Karl Fredericks_alt2.png"},{"id":3277,"name":"Sal Rinauro","realName":"Sal Rinauro","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":185,"height":172,"dateOfBirth":"1982-09-12T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":58,"micSkills":66,"condition":83,"hardcoreAbility":64,"injuryProne":100,"ability":61,"currentAbility":50,"potentialAbility":52,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Sal Rinauro is an American wrestler who works exclusively in America. He is a Lightweight who is classed as using a High Flyer style. He is best known for his work with NWA, ROH and IWA-MS.","alterEgos":["Sal The Pal"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2711],"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":21,"matchLayout":66,"psychology":58,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":58,"brandBuilding":25,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":83,"awareness":58,"judgement":75},"picture":"Sal Rinauro.png"},{"id":3278,"name":"Kazuyuki Fujita","realName":"Kazuyuki Fujita","nickname":"","type":"wrestler","promotionId":45,"base":"Japan","gender":"M","weight":254,"height":180,"dateOfBirth":"1970-10-16T00:00:00.000Z","debut":"1996-11-01T00:00:00.000Z","wage":38400,"wageType":"per-appearance","popularity":6,"charisma":62,"micSkills":79,"condition":61,"hardcoreAbility":75,"injuryProne":100,"ability":56,"currentAbility":33,"potentialAbility":35,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kazuyuki Fujita is a Japanese professional wrestler, mixed martial artist and a former amateur wrestler. He has most recently fought in Road FC, but is also known for his work in the PRIDE Fighting Championships, K-1, Rizin Fighting Federation, and World Victory Road. Fujita began his career as a professional wrestler in 1993, joining the New Japan Pro Wrestling (NJPW) dojo, while still competing as an amateur wrestler. Debuting in 1996, Fujita would put his wrestling career on hiatus in early 2000 to train in MMA. Returning the following year with a new shoot based offence, Fujita won the IWGP Heavyweight Championship immediately and went on to hold it two more times before leaving the company in 2005.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3278","wrestlerId":3278,"promotionId":45,"startDate":"2019-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":38400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":30,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":64,"characterCoaching":45,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":45,"brandBuilding":66,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":62,"awareness":68,"judgement":81},"picture":"Kazuyuki Fujita.png"},{"id":3279,"name":"The Butcher","realName":"The Butcher","nickname":"","type":"wrestler","promotionId":77,"base":"USA","gender":"M","weight":273,"height":187,"dateOfBirth":"1977-12-12T00:00:00.000Z","debut":"2016-03-01T00:00:00.000Z","wage":26200,"wageType":"per-appearance","popularity":22,"charisma":63,"micSkills":54,"condition":77,"hardcoreAbility":53,"injuryProne":100,"ability":66,"currentAbility":48,"potentialAbility":48,"morale":"poor","presentation":"heel","prestige":"low","style":"powerhouse","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":true,"inDevelopment":false,"story":"The Butcher i