weight who is classed as using a Brawler style. He is best known for his work with AJPW and IWRG.","alterEgos":[],"birthplace":"Unknown","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":56,"storytelling":57,"productFit":84,"riskTaking":29,"matchLayout":57,"psychology":56,"workerManagement":84,"trainingIntensity":65,"technicalCoaching":22,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":76,"brandBuilding":57,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":17,"reactionSpeed":65,"consistency":65,"awareness":56,"judgement":67},"picture":"Gianni Valletta.png"},{"id":3090,"name":"Jordan Oliver","realName":"Jordan Oliver","nickname":"","type":"wrestler","promotionId":49,"base":"USA","gender":"M","weight":220,"height":180,"dateOfBirth":"1999-06-18T00:00:00.000Z","debut":"2016-10-01T00:00:00.000Z","wage":16400,"wageType":"per-appearance","popularity":13,"charisma":35,"micSkills":42,"condition":100,"hardcoreAbility":42,"injuryProne":100,"ability":57,"currentAbility":56,"potentialAbility":86,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Growing up in one of the most dangerous cities in America, Jordan Oliver has firsthand experience with the perils of the streets… and those streets have made him resourceful, hungry and able to out scrap anyone that gets into a fight with the Hudson Valley high flyer. A standout prospect, Oliver wrestled for Newburgh Free Academy in high school while the six-foot sensation moonlighted as a rookie grappler every weekend on the northeast wrestling circuit. Lighting up the competition with an electrifying arsenal of moves, the hard knocks Newburgh wrestler quickly caught the eye of league scouts. Representing the 845, the “Sauce God” is motivated to show the world he’s got the special ingredients to be a champion in the majors.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3090","wrestlerId":3090,"promotionId":49,"startDate":"2026-01-16T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":16400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"additionalContracts":[{"id":"tew-contract-3090-76","wrestlerId":3090,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-3090-77","wrestlerId":3090,"promotionId":77,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3603,3604,4158,4322,4323,4324,4325,4326],"staffAttributes":{"bookingLogic":46,"storytelling":51,"productFit":100,"riskTaking":37,"matchLayout":53,"psychology":46,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":45,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":62,"brandBuilding":38,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":52,"awareness":46,"judgement":68},"picture":"Jordan Oliver.png","alsoWorksFor":["AEW","GCW"]},{"id":3091,"name":"Jacob Fatu","realName":"Jacob Fatu","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":279,"height":182,"dateOfBirth":"1992-04-18T00:00:00.000Z","debut":"2012-09-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":52,"charism