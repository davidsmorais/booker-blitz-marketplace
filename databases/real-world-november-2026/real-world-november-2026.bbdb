alse,"story":"Eiji Tosaka is one of the founders of Big Japan and a former referee in the promotion. He has been involved in wrestling since 1995, mostly as a referee and in various executive positions. Today he is part of Big Japan’s front office staff.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":21,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":21,"brandBuilding":5,"socialMediaSavvy":24,"ruleKnowledge":54,"positioning":43,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Eiji Tosaka.png"},{"id":1723,"name":"Ryuichi Kawakami","realName":"Ryuichi Kawakami","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":220,"height":177,"dateOfBirth":"1988-11-29T00:00:00.000Z","debut":"2008-12-04T00:00:00.000Z","wage":4166,"popularity":4,"charisma":62,"micSkills":61,"condition":84,"hardcoreAbility":69,"injuryProne":100,"ability":64,"currentAbility":59,"potentialAbility":64,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ryuichi Kawakami is a Japanese wrestler who works exclusively in Japan. He is a Middleweight who is classed as using a Impactful style. He is best known for his work with NOAH, AJPW, wXw, BJW, GLEAT and BASARA. He is the protege of Daisuke Sekimoto.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2468],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTakin