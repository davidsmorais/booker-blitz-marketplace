nship Wrestling.","alterEgos":["Franky The Mobster"],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":62,"storytelling":63,"productFit":100,"riskTaking":33,"matchLayout":63,"psychology":62,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":32,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":73,"brandBuilding":64,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":61,"awareness":62,"judgement":77},"picture":"Franky The Mobster.png"},{"id":2349,"name":"Fred La Merveille","realName":"Fred La Merveille","nickname":"","type":"wrestler","base":"Canada","gender":"M","weight":191,"height":170,"dateOfBirth":"1982-06-07T00:00:00.000Z","debut":"1999-10-01T00:00:00.000Z","wage":37500,"popularity":0,"charisma":29,"micSkills":32,"condition":82,"hardcoreAbility":39,"injuryProne":100,"ability":46,"currentAbility":38,"potentialAbility":40,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Frederic Lauzon is a Canadian professional wrestler, promoter and manager best known for his time as WonderFred in the International Wrestling Syndicate as the leader of the SLI stable. He is the owner and promoter of the Monteregian Wrestling Federation, a promotion based on the south shore of Montreal. In the MWF, Fred has formed a succesful tag team with fellow veteran Fabulous Stevie.","alterEgos":["Fred Lauzon"],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":52,"storytelling":55,"productFit":100,"riskTaking":35,"matchLayout":56,"psychology":52,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":23,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":51,"brandBuilding":22,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":53,"awareness":52,"judgement":71},"picture":"Fred La Merveille.png"},{"id":2354,"name":"Jacques Rougeau Jr.","realName":"Jacques Rougeau Jr.","nickname":"","type":"writer","base":"Canada","gender":"M","weight":257,"height":182,"dateOfBirth":"1960-06-13T00:00:00.000Z","debut":"1977-06-01T00:00:00.000Z","wage":66000,"popularity":6,"charisma":100,"micSkills":89,"condition":75,"hardcoreAbility":100,"injuryProne":50,"ability":87,"currentAbility":40,"potentialAbility":40,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Jacques Rougeau Jr. is a Canadian professional wrestler, trainer and promoter, better known for his run as a tag team wrestler in the WWF and for his Mountie character, having held the WWF Tag Team Championship three times and the Intercontinental title once. He has been promoting his own shows under various names since 1993 and has been training wrestlers since then, his most famous trainees being Kevin Owens, Cedric Rougeau, Carl Ouellet & Kurrgan. A traditionalist who long-resisted doing business with other promotions, he has recently opened up to the world, influenced by his son Cedric.","alterEgos":[],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1816,1817],"staffAttributes":{"bookingLogic":82,"storytelling":82,"productFit":100,"riskTaking":28,"matchLayout":82,"psychology":82,"workerManagement":100,"trainingIntensity":28,"technicalCoaching":37,"characterCoaching":65,"teaching":40,"diagno