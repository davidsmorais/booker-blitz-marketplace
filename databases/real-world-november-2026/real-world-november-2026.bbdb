ent":27,"trainingIntensity":61,"technicalCoaching":53,"characterCoaching":45,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":45,"brandBuilding":62,"socialMediaSavvy":30,"ruleKnowledge":25,"positioning":25,"reactionSpeed":61,"consistency":52,"awareness":38,"judgement":34},"picture":"Raychell Rose.png"},{"id":4433,"name":"James Darnell","realName":"James Darnell","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":245,"height":182,"dateOfBirth":"1996-04-14T00:00:00.000Z","debut":"2021-12-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":52,"micSkills":60,"condition":100,"hardcoreAbility":54,"injuryProne":81,"ability":50,"currentAbility":50,"potentialAbility":59,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"James Darnell, best known by his online pseudonym CMPulse, is an American Youtuber, Twitch Streamer and Podcast host. He started his Youtube channel doing running commentary for WWE Games primarily based around professional wrestler CM Punk. As the years went on and Pulse's popularity grew, he became a mainstay in the online wrestling community and outstretched his talents to the worlds of podcasting with the Deadlock podcast and social media influencing with his forum Machinmapalooza. Since 2015, Darnell has made a concentrated effort to lose a considerable amount of weight in order to fufill his long time dream of becoming a professional wrestler where he has been trained thus far by Steve Corino. Looks like somebody is going to have get in the Money Clippa! GET CLIPPED!","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3696],"staffAttributes":{"bookingLogic":57,"storytelling":55,"productFit":10,"riskTaking":48,"matchLayout":54,"psychology":57,"workerManagement":10,"trainingIntensity":52,"technicalCoaching":32,"characterCoaching":45,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":52,"mediaHandling":45,"brandBuilding":24,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":2,"reactionSpeed":52,"consistency":58,"awareness":57,"judgement":38},"picture":"James Darnell.png"},{"id":4434,"name":"John Blud","realName":"John Blud","nickname":"","type":"commentator","base":"USA","gender":"M","weight":221,"height":182,"dateOfBirth":"1993-11-25T00:00:00.000Z","debut":"2021-12-01T00:00:00.000Z","wage":66000,"popularity":1,"charisma":32,"micSkills":30,"condition":100,"hardcoreAbility":20,"injuryProne":100,"ability":38,"currentAbility":38,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The fearless leader of the streaming group New Legacy Inc, John E. Blud (Jawnny) has been streaming for well over a decade, starting on Justin.tv (The precursor to Twitch) as a 16-year-old in the late 2000s. Prior to streaming, John worked for CZW as a sound technician. Jawnny would eventually form New Legacy Inc with LT, Slip and Blake, all of whom he met through wrestling forums, beginning a decade of decadence, accidentally exposing hilarious bugs, and raising literally hundreds of thousands for charity with Fighting Back. In December 2019, he was invited to co-host the Deadlock Podcast by his good friend Anthony Douglas (TonyPizzaGuy) as James was vacationing in Japan. But the temporary gig quickly turned permanent, as the trio of pals exuded chemistry. Infamously was banned from the MPire Mall after a UMAD episode which poked fun of an e-fed named Victory Road Wrestling.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":26,"storytelling":28,"productFit":0,"riskTaking":59,"matchLayout":29,"psychology":26,"workerManagement":0,"trainingIntensity":44,"technicalCoaching":20,"characterCoaching":66,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":41,"mediaHandling":66,"brandBuilding":32,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":0,"reactionSpeed":44,"consistency":43,"awareness":26,"judgement":16},"picture":"John Blud.png"},{"id":4435,"name":"Bojack","realName":"Bojack","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":354,"height":180,"dateOfBirth":"2000-01-07T00:00:00.000Z","debut":"2017-09-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":56,"micSkills":70,"condition":100,"hardcoreAbility":64,"injuryProne":100,"ability":59,"currentAbility":57,"potentialAbility":68,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Bojack is an American wrestler who works exclusively in America. He is a Big Heavyweight who is classed as using a Powerhouse style. He is best known for his work with PWF and Deadlock Pro Wrestling.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3696],"staffAttributes":{"bookingLogic":57,"storytelling":59,"productFit":35,"riskTaking":36,"matchLayout":60,"psychology":57,"workerManagement":35,"trainingIntensity":73,"technicalCoaching":42,"characterCoaching":52,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":52,"brandBuilding":47,"socialMediaSavvy":33,"ruleKnowledge":0,"positioning":7,"reactionSpeed":73,"consistency":68,"awareness":57,"judgement":48},"picture":"Bojack_alt1.png"},{"id":4436,"name":"Chris Danger","realName":"Chris Danger","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":194,"height":177,"dateOfBirth":"1986-10-25T00:00:00.000Z","debut":"2021-12-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":40,"micSkills":51,"condition":100,"hardcoreAbility":56,"injuryProne":93,"ability":42,"currentAbility":37,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Chris Denker is an American Youtuber and Podcast host. Considered by many as the \"face\" of wrestling game youtube, Denker has been uploading WWE game content on his channel DenkOps since late 2013, before hitting his stride with his MyCareer series on WWE 2K15, chronicling the rise of his fictional alter ego, Chris Danger. The series would see his viewcounts spike, and become the launching pad for his youtube career. Over the following half decade, Chris would not only grow his subscribers into the millions, but form close friendships with both fellow youtubers, and AEW & WWE talent\r\n\r\nAfter seven years of \"playing pretend\", Denker would take his biggest, and most unexpected step into the world of Professional Wrestling, when he announced he'd be portraying his fictional alter ego at the first set of DPW tapings.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":43,"storytelling":43,"productFit":5,"riskTaking":31,"matchLayout":43,"psychology":43,"workerManagement":5,"trainingIntensity":55,"technicalCoaching":24,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":65,"brandBuilding":46,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":