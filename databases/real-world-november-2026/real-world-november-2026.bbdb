e her professional wrestling debut, where she was defeated by Miyu Yamashita. On March 13, 2017 at At This Time, Get Excited In Nerima! Itoh was defeated by Mil Clown in a three-way match also featuring Maho Kurone. Maki made her US debut at Joey Ryan's Penis Party event organized by Joey Ryan where she fought in a multi-man match for the Ironman Heavymetalweight Championship, but was defeated by the champion Yoshihiko.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2028-01-10T00:00:00.000Z","contract":{"id":"tew-contract-2970","wrestlerId":2970,"promotionId":61,"startDate":"2026-01-10T00:00:00.000Z","endDate":"2028-01-10T00:00:00.000Z","wage":41000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1808,2081,2487,3327,3560,3925,4377],"staffAttributes":{"bookingLogic":67,"storytelling":68,"productFit":100,"riskTaking":26,"matchLayout":68,"psychology":67,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":55,"characterCoaching":88,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":88,"brandBuilding":73,"socialMediaSavvy":81,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":69,"awareness":67,"judgement":80},"picture":"Maki Ito.png"},{"id":2971,"name":"Bull Nakano","realName":"Bull Nakano","nickname":"","type":"trainer","base":"Japan","gender":"F","weight":201,"height":167,"dateOfBirth":"1968-01-08T00:00:00.000Z","debut":"1983-09-01T00:00:00.000Z","wage":66000,"popularity":9,"charisma":31,"micSkills":29,"condition":65,"hardcoreAbility":45,"injuryProne":80,"ability":31,"currentAbility":17,"potentialAbility":17,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"