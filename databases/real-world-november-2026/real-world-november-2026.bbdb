i Oji","realName":"Satoshi Oji","nickname":"","type":"writer","base":"Japan","gender":"M","weight":143,"height":162,"dateOfBirth":"1970-04-20T00:00:00.000Z","debut":"2000-04-01T00:00:00.000Z","wage":66000,"popularity":1,"charisma":6,"micSkills":3,"condition":85,"hardcoreAbility":8,"injuryProne":0,"ability":7,"currentAbility":4,"potentialAbility":6,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Satoshi Oji is the President of Dragon Gate’s US-based expansion, Dragon Gate USA. Although he is believed to have the final say in what happens in the promotion, he generally remains behind-the-scenes and lets his partner in the promotion, VP Gabe Sapolsky, handle the day-to-day duties and promoting the promotion’s events & talent. He is also the President of Full Impact Pro.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":22,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":22,"brandBuilding":0,"socialMediaSavvy":0,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Satoshi Oji.png"},{"id":1063,"name":"Caleb Konley","realName":"Caleb Konley","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":207,"height":180,"dateOfBirth":"1983-08-30T00:00:00.000Z","debut":"2006-06-01T00:00:00.000Z","wage":4166,"popularity":5,"charisma":48,"micSkills":47,"condition":87,"hardcoreAbility":50,"injuryProne":100,"ability":69,"currentAbility":58,"potentialAbility":61,"morale":"broken","pres