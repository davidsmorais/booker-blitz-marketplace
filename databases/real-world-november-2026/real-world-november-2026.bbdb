ay 8 2010 at The Delphi Club in Sudbury, Suffolk.","alterEgos":[],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":60,"productFit":100,"riskTaking":100,"matchLayout":61,"psychology":58,"workerManagement":100,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":55,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":55,"brandBuilding":26,"socialMediaSavvy":42,"ruleKnowledge":47,"positioning":58,"reactionSpeed":0,"consistency":0,"awareness":58,"judgement":75},"picture":"Dann Read.png"},{"id":4093,"name":"Emily Read","realName":"Emily Read","nickname":"","type":"writer","base":"UK","gender":"F","weight":147,"height":162,"dateOfBirth":"1987-01-29T00:00:00.000Z","debut":"2012-01-01T00:00:00.000Z","wage":66000,"popularity":0,"charisma":0,"micSkills":0,"condition":100,"hardcoreAbility":19,"injuryProne":100,"ability":10,"currentAbility":9,"potentialAbility":13,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Emily Read is an English woman who tends to stay behind the scenes in the wrestling world. She is married to Dann Read. Emily is the co-founder, co-owner, co-promoter & Ring Announcer of Pro-Wrestling: EVE, an all-female professional wrestling company that runs out of a railway arch in Bethnal Green. Emily is among only a handful of women who work as wrestling promoters & is dedicated to helping other women work in all sectors of the wrestling business. Emily is a mental health advocate, openly talking about her own struggles with bipolar, she homeschools her two children & loves Terry Pratchett.","alterEgos":[],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"h