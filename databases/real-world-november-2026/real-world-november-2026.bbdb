-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","popularity":0,"charisma":0,"micSkills":0,"condition":90,"hardcoreAbility":0,"injuryProne":100,"ability":0,"currentAbility":0,"potentialAbility":3,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Brett Lauderdale is an American man who tends to stay behind the scenes in the wrestling world. He is best known for his work with GCW. He is the current owner and booker of GCW.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3083","wrestlerId":3083,"promotionId":77,"startDate":"2015-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":11,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":11,"brandBuilding":7,"socialMediaSavvy":11,"ruleKnowledge":56,"positioning":45,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Brett Lauderdale.png"},{"id":3085,"name":"SHLAK","realName":"SHLAK","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":246,"height":172,"dateOfBirth":"1979-02-12T00:00:00.000Z","debut":"2016-03-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":34,"micSkills":53,"condition":83,"hardcoreAbility":19,"injuryProne":100,"ability":33,"currentAbility":25,"potentialAbility":27,"morale":"broken","presentation":"face","prestige