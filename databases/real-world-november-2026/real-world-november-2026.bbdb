ne":92,"ability":52,"currentAbility":51,"potentialAbility":58,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"If “Back to the Future” was set in Scotland, Kenny Williams says he would be Marty McFly — a bit cheeky, but also banking on both his abilities and a touch of luck to get him through whatever is put in front of him.\r\n\r\nTrained by 205 Live Superstar Noam Dar, Williams sports an “act first, think later” attitude inside the squared circle, making him an exciting competitor to watch. Rarely the biggest dog in the fight, he uses his speed and agility to push the pace against his often-larger opponents. A flashy showman, Williams knows that he is often viewed as an underdog, but as a hardened six-year veteran with the guts to take on anybody, he’d have it no other way.","alterEgos":[],"birthplace":"Scotland","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1016,1895,2654],"staffAttributes":{"bookingLogic":53,"storytelling":57,"productFit":81,"riskTaking":33,"matchLayout":59,"psychology":53,"workerManagement":81,"trainingIntensity":83,"technicalCoaching":44,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":63,"brandBuilding":48,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":16,"reactionSpeed":83,"consistency":65,"awareness":53,"judgement":64},"picture":"Kenny Williams.png"},{"id":1622,"name":"Ray Rosas","realName":"Ray Rosas","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":172,"height":170,"dateOfBirth":"1986-06-08T00:00:00.000Z","debut":"2009-04-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":46,"micSkills":60,"condition":85,"hardcoreAbility":53,"injuryProne":100,"ability":62,"currentAbility":55,"potential