ly a REVOLVER Tag Team champion. He is engaged to someone outside the wrestling business. He is the protege of Alex Shelley.","alterEgos":["Wes Lee"],"birthplace":"Dayton, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2555","wrestlerId":2555,"promotionId":76,"startDate":"2026-01-14T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1746,1815,2287,2314,2522,2804,3960],"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":27,"matchLayout":66,"psychology":58,"workerManagement":100,"trainingIntensity":87,"technicalCoaching":55,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":66,"brandBuilding":62,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":87,"consistency":80,"awareness":58,"judgement":75},"picture":"Dezmond Xavier.png"},{"id":2556,"name":"Zachary Wentz","realName":"Zachary Wentz","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":176,"height":175,"dateOfBirth":"1994-04-29T00:00:00.000Z","debut":"2014-05-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":24,"charisma":58,"micSkills":60,"condition":96,"hardcoreAbility":70,"injuryProne":100,"ability":64,"currentAbility":64,"potentialAbility":72,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Zachary Wentz is an American wrestler who works in the USA, Canada, the British Isles and Japan. He is a 5'10\", 176lb worker who is classed as using a Technician Flyer style. He uses the Bite The Curb and the Gunckel Driver as his finishers. He is one half of The Rascalz alongside Trey Miguel. He is best known for his work with AEW, TNA, NXT, Dragon Gate, PWG, DDT, GCW, WRESTLE-1, Beyond, EVOLVE, REVOLVER, AAW, FCP, OTT, IWA-MS, Riptide, A1, CHIKARA, CZW and SWE. He is currently a REVOLVER Tag Team champion. He is engaged to Priscilla Kelly. He is the protege of Alex Shelley.","alterEgos":["Wentz","Nash Carter"],"birthplace":"Lima, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2556","wrestlerId":2556,"promotionId":76,"startDate":"2026-01-14T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1746,1815,2287,2314,2522,2685,2686,2804,2834,3772,3959,3960],"staffAttributes":{"bookingLogic":57,"storytelling":62,"productFit":100,"riskTaking":26,"matchLayout":63,"psychology":57,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":58,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":61,"brandBuilding":43,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":88,"awareness":57,"judgement":74},"picture":"Zachary Wentz.png"},{"id":2559,"name":"Ruaka","realName":"Ruaka","nickname":"","type":"wrestler","promotionId":61,"base":"Japan","gender":"F","weight":176,"height":162,"dateOfBirth":"2004-08-16T00:00:00.000Z","debut":"2016-11-01T00:00:00.000Z","wage":20500,"wageType":"monthly","popularity":3,"charisma":45,"micSkills":58,"condition":92,"hardcoreAbility":29,"injuryProne":100,"ability":41,"currentAbility":36,"potentialAbility":51,"morale":"broken","presentation":"heel","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","characte