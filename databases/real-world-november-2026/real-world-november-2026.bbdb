house","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Sanshiro Takagi is a Japanese professional wrestler. Takagi plays a parody of Stone Cold Steve Austin of WWF fame, He is known in DDT and around the micro-indy scene for his hilarious promos and natural charisma as well as his extensive use of comedy in his matches. Sanshiro Takagi was trained by Goro Tsurumi and started at his International Pro Wrestling revival promotion, IWA Kakuto Shijuku. Soon, however, Takagi broke off, seeing that IWAKS's limited exposure would only limit him to be an independent wrestler, in 1997 he formed DDT (Dramatic Dream Team), which not only would promote in Tokyo (as opposed to Tsurumi's Chigasaki, Kanagawa base), but also be based on the entertainment wrestling kingpin of the day, World Wrestling Entertainment.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":79,"storytelling":80,"productFit":100,"riskTaking":20,"matchLayout":80,"psychology":79,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":42,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":78,"brandBuilding":35,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":72,"awareness":79,"judgement":87},"picture":"Sanshiro Takagi.png"},{"id":1451,"name":"José Manuel Guillén","realName":"José Manuel Guillén","nickname":"","type":"commentator","promotionId":5,"base":"Mexico","gender":"M","weight":164,"height":162,"dateOfBirth":"1968-07-17T00:00:00.000Z","debut":"1998-07-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":3,"charisma":65,"micSkills":84,"condition":100,"hardcoreAbility":71,"injuryProne":0,"ability":68,"currentAbility":38,"potentialAbi