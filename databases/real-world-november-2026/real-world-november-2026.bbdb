,"riskTaking":100,"matchLayout":10,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":62,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":62,"brandBuilding":15,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Shinpei Nogami.png"},{"id":1294,"name":"Tiger Hattori","realName":"Tiger Hattori","nickname":"","type":"writer","base":"Japan","gender":"M","weight":150,"height":162,"dateOfBirth":"1945-07-20T00:00:00.000Z","debut":"1977-07-01T00:00:00.000Z","wage":66000,"popularity":4,"charisma":7,"micSkills":0,"condition":100,"hardcoreAbility":0,"injuryProne":39,"ability":0,"currentAbility":0,"potentialAbility":2,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tiger Hattori is a referee in New Japan who has been involved in wrestling in some form for over 35 years. An amateur wrestler in college, Hattori competed in the All-Japan wrestling championships. Soon afterwards he began working with Hiro Matsuda and Masa Saito before making his referee debut in 1977 in the US. He joined All-Japan in 1980 as an NWA-recognized referee, then moved to New Japan in 1982 before leaving in 1984 to work for Riki Choshu’s Fighting World Of Japan. After the pro wrestling collapse in Japan, Hattori returned to New Japan and was appointed to a referee management position in 2001. He left New Japan again in 2002 but returned in 2004. Today he continues to referee and also does some PR work for the promotion.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":38,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":38,"brandBuilding":38,"socialMediaSavvy":28,"ruleKnowledge":78,"positioning":62,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Tiger Hattori.png"},{"id":1297,"name":"Taya Valkyrie","realName":"Taya Valkyrie","nickname":"","type":"wrestler","promotionId":49,"base":"Canada","gender":"F","weight":145,"height":170,"dateOfBirth":"1983-10-22T00:00:00.000Z","debut":"2010-04-01T00:00:00.000Z","wage":32800,"wageType":"per-appearance","popularity":28,"charisma":56,"micSkills":65,"condition":82,"hardcoreAbility":85,"injuryProne":100,"ability":64,"currentAbility":64,"potentialAbility":77,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Taya Valkyrie, a 2010 graduate of the Storm Wrestling Academy, is a Canadian wrestler who works in America, Canada, Mexico and the British Isles. She is a Small worker who is classed as using a Technician Flyer style. She is best known for her work with AAA, IMPACT, NXT, NWA, MLW and Lucha Ungrnd. She is currently the MLW Women's World Featherweight champion, an IMPACT Knockouts Tag Team champion and the AAA Reina de Reinas champion. She is married to John Hennigan. She is the protege of Lance Storm.","alterEgos":["Franky Monet"],"birthplace":"Victoria, British Columbia, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1297","wrestlerId":1297,"promotionId":49,"startDate":"2023-12-14T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32800,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"