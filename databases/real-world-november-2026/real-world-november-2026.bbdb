r who tends to stay behind the scenes in the wrestling world. She is best known for her work with Stardom, NXT UK, GWF, NORTH, PROGRESS, EVE, ATTACK! and Riptide.","alterEgos":[],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2836],"staffAttributes":{"bookingLogic":38,"storytelling":45,"productFit":21,"riskTaking":39,"matchLayout":48,"psychology":38,"workerManagement":21,"trainingIntensity":58,"technicalCoaching":53,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":61,"brandBuilding":60,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":4,"reactionSpeed":58,"consistency":56,"awareness":38,"judgement":31},"picture":"Candy Floss.png"},{"id":2977,"name":"Ka Kedita","realName":"Kakeru Sekiguchi","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":114,"height":154,"dateOfBirth":"1994-09-27T00:00:00.000Z","debut":"2017-03-01T00:00:00.000Z","wage":3000,"popularity":2,"charisma":42,"micSkills":53,"condition":93,"hardcoreAbility":40,"injuryProne":100,"ability":54,"currentAbility":54,"potentialAbility":62,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kakeru Sekiguchi is a Japanese wrestler who works exclusively in Japan. She is a Very Small worker who is classed as using a Technician style. She is best known for her work with OZ Academy.","alterEgos":["Kakeru Sekiguchi"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":45,"storytelling":51,"productFit":35,"riskTaking":23,"matchLayout":53,"psychology":45,"workerManagement":35,"trainingIntensity":71,"technicalCoaching":54,"characterCoaching":