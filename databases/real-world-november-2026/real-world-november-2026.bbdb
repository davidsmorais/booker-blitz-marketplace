andBuilding":23,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":45,"awareness":0,"judgement":0},"picture":"Daisuke Sugaya.png"},{"id":730,"name":"Kentaro Hirakawa","realName":"Kentaro Hirakawa","nickname":"","type":"commentator","promotionId":45,"base":"Japan","gender":"M","weight":168,"height":162,"dateOfBirth":"1970-01-06T00:00:00.000Z","debut":"1988-01-01T00:00:00.000Z","wage":25600,"wageType":"per-appearance","popularity":2,"charisma":54,"micSkills":47,"condition":100,"hardcoreAbility":67,"injuryProne":0,"ability":64,"currentAbility":38,"potentialAbility":40,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kentaro Hirakawa is a Japanese announcer who works in Japan. He has called matches for many promotions and cross promotion events however he mostly covers the Pro Wrestling NOAH events.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-730","wrestlerId":730,"promotionId":45,"startDate":"2020-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":25600,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":56,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":56,"brandBuilding":0,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":65,"awareness":0,"judgement":0},"picture":"Kentaro Hirakawa.png"},{"id":731,"name":"Samuel Shaw","realName":"Sam Shaw","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":240,"height":185,"dateOfBirth":"1984-01-17T00:00:00.000Z","debut":"2007-09-01T00:00:00.000Z","wage":11500,"popularity":33,"charisma":67,"micSkills":56,"condition":93,"hardcoreAbility":58,"injuryProne":100,"ability":67,"currentAbility":67,"potentialAbility":70,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Disconcerting. Unsettling. Creepy. All are perfectly apt descriptions for Dexter Lumis.\r\n\r\nWith a cold, dead stare that sent chills down the spines of the NXT Universe, Lumis made his debut on the black-and-gold brand in the summer of 2019 as part of the revolutionary Breakout Tournament. From the moment he stalked into the arena, it immediately became clear that the enigmatic powerhouse is cut from a different cloth than most Superstars.\r\n\r\nLittle is known about Lumis, but his abilities inside the ring are not in question. He is crushingly powerful, sadistically methodical and completely unorthodox in his movement. Moreover, he seems to take pleasure in others’ agony. Lumis likes to use his hands to “frame” opponents before upending them with his punishing offense, almost as if he’s preparing them to become portraits of his destruction.","alterEgos":["Dexter Lumis"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2623,2821],"staffAttributes":{"bookingLogic":56,"storytelling":59,"productFit":100,"riskTaking":27,"matchLayout":60,"psychology":56,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":53,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":68,"brandBuilding":68,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":67,"awareness":56,"judgement":74},"picture":"Samuel Shaw.png","promotionId":28,"contractExpiryDate":"2033-10-26T00:00:00.000Z"},{"id":732,"name":"Chase Stevens","realName":"Chase Stevens","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":235,"height":182,"dateOfBirth":"1979-01-17T00:00:00.000Z","debut":"1998-02-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":54,"micSkills":57,"condition":79,"hardcoreAbility":63,"injuryProne":100,"ability":51,"currentAbility":39,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Chase Stevens is an American professional wrestler. He is known for his work in Total Nonstop Action Wrestling where he was a member of The Naturals alongside his former tag team partner Andy Douglas. In high school, Chase Stevens was a Golden Gloves boxing champion. After attending a professional wrestling training session, in order to watch a friend, Stevens decided to become a wrestler and joined the training school. After several weeks, veteran wrestler Tracy Smothers took him under his wing and became his trainer and mentor. Stevens debuted in 1998 under a mask as \"Glacius\", losing to fellow trainee Johnny B. Dazzled. In USA Championship Wrestling Stevens was placed in a tag team with Andy Douglas by Bob Ryder. While on a fishing trip they chose the name \"Natural Heat\", which was later shortened to \"The Naturals\". The Naturals became a pair of sneaky, cheating villains.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1443],"staffAttributes":{"bookingLogic":39,"storytelling":48,"productFit":90,"riskTaking":42,"matchLayout":51,"psychology":39,"workerManagement":90,"trainingIntensity":67,"technicalCoaching":51,"characterCoaching":60,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":58,"mediaHandling":60,"brandBuilding":43,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":18,"reactionSpeed":67,"consistency":70,"awareness":39,"judgement":59},"picture":"Chase Stevens.png"},{"id":733,"name":"Cassidy Riley","realName":"Cassidy Riley","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":205,"height":177,"dateOfBirth":"1976-11-21T00:00:00.000Z","debut":"1994-11-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":59,"micSkills":43,"condition":77,"hardcoreAbility":59,"injuryProne":100,"ability":49,"currentAbility":35,"potentialAbility":37,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Cassidy Riley is an American professional wrestler, also known as Cassidy Reilly and Cassidy O'Riley best known for work with Total Nonstop Action Wrestling and World Wrestling Entertainment. O'Reilly trained under Lolly Dude, a promoter in Dallas, for eight months, receiving supplemental training from Terry Taylor and Tommy Rogers, who were working for Dude at the time. He debuted in 1995 under his own name, facing Cedric Crain in Brighton, Tennessee. He then began wrestling on the Southern independent circuit. O'Reilly formed a new tag team with Chase Stevens known as \"The Hotshots\". The Hotshots worked in Nashville before appearing with the fledgling NWA:TNA promotion in July 2002, when they were signed to full time contracts. Following a feud with America's Most Wanted, the team split in October 2002 when O'Reilly left TNA due to travel problems, returning to Louisiana and taking a hiatus from wrestling.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1443],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":21,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":52,"characterCoaching":48,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":48,"brandBuilding":42,"socialMediaSavvy":52,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":65,"awareness":58,"judgement":75},"picture":"Cassidy O'Reilly.png"},{"id":735,"name":"Todd Keneley","realName":"Todd Keneley","nickname":"","type":"commentator","base":"USA","gender":"M","weight":198,"height":180,"dateOfBirth":"1976-12-08T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","wage":66000,"popularity":1,"charisma":41,"micSkills":55,"condition":100,"hardcoreAbility":60,"injuryProne":24,"ability":42,"currentAbility":30,"potentialAbility":32,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Todd Keneley is a wrestling ring & play-by-play announcer. Broke into the business working for UPW in California and achieved his greatest success as the ring announcer for Celebrity Championship Wrestling. He also played one of The Undertaker's druids at WrestleMania 21.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":53,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":53,"brandBuilding":37,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Todd Keneley.png"},{"id":736,"name":"Tony Nese","realName":"Tony Nese","nickname":"","type":"wrestler","promotionId":49,"base":"USA","gender":"M","weight":196,"height":172,"dateOfBirth":"1985-08-06T00:00:00.000Z","debut":"2005-09-01T00:00:00.000Z","wage":16400,"wageType":"per-appearance","popularity":16,"charisma":57,"micSkills":52,"condition":87,"hardcoreAbility":42,"injuryProne":100,"ability":71,"currentAbility":62,"potentialAbility":65,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Tony Nese refers to himself as “The Premier Athlete,” but he just might be the premier Cruiserweight in the world.\r\n\r\nA longtime mainstay of the American independent circuit, Nese brings a certain confidence to the Cruiserweight division. And, to be fair, that confidence is not unfounded. With the most impressive physique in the division, a resume that includes clashes with the likes of Matt Hardy and Paul London, as well as a beyond-impressive 450 Splash, Nese has it all. \r\n\r\nThe Premier Athlete lived up to his considerable hype at WrestleMania 35 when he defeated former training partner Buddy Murphy in an edge-of-your-seat fight to capture his first WWE Cruiserweight Title.","alterEgos":[],"birthplace":"Ridge, New York, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-736","wrestlerId":736,"promotionId":49,"startDate":"2023-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":16400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1087,3018,3260,3573],"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":37,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":62,"characterCoaching":44,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":44,"brandBuilding":48,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":78,"awareness":56,"judgement":74},"picture":"Tony Nese.png","additionalContracts":[{"id":"tew-contract-736-76","wrestlerId":736,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW"]},{"id":738,"name":"Kevin Thorn","realName":"Kevin Thorn","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":275,"height":187,"dateOfBirth":"1977-01-17T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":51,"micSkills":49,"condition":67,"hardcoreAbility":57,"injuryProne":100,"ability":41,"currentAbility":30,"potentialAbility":32,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kevin Matthew Fertig is an American professional wrestler best known for working with World Wrestling Entertainment (WWE) on its ECW brand under the ring name Kevin Thorn. Fertig made his professional wrestling debut in 2000, and quickly began working for the Memphis Championship Wrestling promotion in his hometown, under the ring name Seven. He signed a contract with WWE in April 2002, and was assigned to their developmental territory, Ohio Valley Wrestling (OVW). He competed in OVW for two years, winning the OVW Southern Tag Team Championship with Travis Bane, before being called up to the SmackDown brand as Mordecai, a religious zealot. Following his WWE release, Fertig began using the Mordecai name again while working on the independent circuit. Fertig made his return in June 2006 on WWE's ECW brand as a vampire. Following his release from WWE, Fertig toured Europe, and stated he was considering working in Mexico and Puerto Rico.","alterEgos":["Mordecai"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":54,"storytelling":56,"productFit":100,"riskTaking":29,"matchLayout":57,"psychology":54,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":36,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":64,"brandBuilding":54,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":65,"awareness":54,"judgement":72},"picture":"Sevin Thorn.png"},{"id":739,"name":"DASH Chisako","realName":"DASH Chisako","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":123,"height":147,"dateOfBirth":"1988-08-24T00:00:00.000Z","debut":"2006-07-01T00:00:00.000Z","wage":4166,"popularity":4,"charisma":65,"micSkills":50,"condition":82,"hardcoreAbility":62,"injuryProne":100,"ability":59,"currentAbility":55,"potentialAbility":60,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"DASH Chisako (real name Chisako Jumonji) is a professional wrestler working for Sendai Girls Pro Wrestling since its opening. She was trained under Meiko Satomura along with her sister Sendai Sachiko.  Has had good success tagging with her sister, and seems to have alot of potential. On October 2, 2005, Jumonji, along with her sister Sachiko, took part in a professional wrestling audition held by Meiko Satomura. After passing the audition, both of the Jumonji sisters were admitted to the first training class of Satomura's new Sendai Girls' Pro Wrestling promotion, and began training under her the following December. Jumonji made her professional wrestling debut on July 9, 2006, at Sendai Girls' first ever event, where she, working under the ring name Chisako Kanari.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1698,1724,1957,2482,2483,2484,3348],"staffAttributes":{"bookingLogic":72,"storytelling":75,"productFit":100,"riskTaking":30,"matchLayout":76,"psychology":72,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":61,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":73,"brandBuilding":65,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":65,"awareness":72,"judgement":83},"picture":"DASH Chisako.png"},{"id":740,"name":"Johnny Parisi","realName":"Johnny Swinger","nickname":"","type":"wrestler","promotionId":118,"base":"USA","gender":"M","weight":216,"height":175,"dateOfBirth":"1975-07-03T00:00:00.000Z","debut":"1993-01-01T00:00:00.000Z","wage":15700,"wageType":"per-appearance","popularity":7,"charisma":56,"micSkills":48,"condition":79,"hardcoreAbility":61,"injuryProne":100,"ability":51,"currentAbility":35,"potentialAbility":37,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Joseph Robert \"Joe\" Dorgan s an American professional wrestler. He is best known for his appearances with Extreme Championship Wrestling and Total Nonstop Action Wrestling as Johnny Swinger and with World Wrestling Entertainment as Johnny Parisi. After training in Toronto, Ontario, Dorgan started wrestling on the independent circuit in 1993 as \"Johnny Paradise\". After he discovered that another wrestler was already using that name, he renamed himself \"Johnny Hollywood Swinger\" and began to make a name for himself as a villain in Scott D'Amore's \"Syndicate\" faction. Swinger joined ECW in 2000. He was placed in a tag team with Simon Diamond by booker Paul Heyman in May 2000, and shortened his name to \"Swinger.\" He remained with ECW until it folded in April 2001. Swinger returned to WCW for one week for the Cruiserweight Tag Team Tournament.","alterEgos":["Johnny Swinger"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-10-19T00:00:00.000Z","contract":{"id":"tew-contract-740","wrestlerId":740,"promotionId":118,"startDate":"2024-10-19T00:00:00.000Z","endDate":"2026-10-19T00:00:00.000Z","wage":15700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[428,2669],"staffAttributes":{"bookingLogic":62,"storytelling":65,"productFit":100,"riskTaking":20,"matchLayout":66,"psychology":62,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":56,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":64,"brandBuilding":45,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":66,"awareness":62,"judgement":77},"picture":"Johnny Swinger.png"},{"id":742,"name":"Tamon Honda","realName":"Tamon Honda","nickname":"","type":"writer","base":"Japan","gender":"M","weight":299,"height":185,"dateOfBirth":"1963-08-15T00:00:00.000Z","debut":"1993-10-01T00:00:00.000Z","wage":66000,"popularity":6,"charisma":85,"micSkills":86,"condition":48,"hardcoreAbility":96,"injuryProne":100,"ability":87,"currentAbility":42,"potentialAbility":42,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Tamon Honda is a Japanese professional wrestler who worked for Pro Wrestling Noah. Honda represented Japan in three Olympic Games in freestyle wrestling in 1984, 1988, and 1992. He almost joined All Japan Pro Wrestling in the 1980s, but it wasn't until after he turned 30 years old that he debuted. Although he never reached the main event level many believed he would, Honda held the All Asia Tag Team Championship in the late 1990s. After joining Pro Wrestling Noah, he gradually became a regular on the roster, with 2002 and 2003 seeing major progress for him.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3301,3302],"staffAttributes":{"bookingLogic":79,"storytelling":81,"productFit":100,"riskTaking":31,"matchLayout":81,"psychology":79,"workerManagement":100,"trainingIntensity":50,"technicalCoaching":66,"characterCoaching":38,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":38,"brandBuilding":25,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":20,"reactionSpeed":50,"consistency":35,"awareness":79,"judgement":87},"picture":"Tamon Honda.png"},{"id":744,"name":"BxB Hulk","realName":"BxB Hulk","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":179,"height":175,"dateOfBirth":"1980-07-15T00:00:00.000Z","debut":"2005-03-01T00:00:00.000Z","wage":4166,"popularity":6,"charisma":64,"micSkills":75,"condition":69,"hardcoreAbility":55,"injuryProne":100,"ability":55,"currentAbility":43,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"BxB Hulk, a 2005 graduate of the Dragon Gate Dojo, is a Japanese wrestler who works in America and Japan. He is a Lightweight who is classed as using a Technician Flyer style. He is best known for his work with Dragongate. He is currently an Open the Twin Gate champion. He was voted Young Wrestler Of The Year in 2007.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[921,1211],"staffAttributes":{"bookingLogic":72,"storytelling":76,"productFit":100,"riskTaking":21,"matchLayout":77,"psychology":72,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":68,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":78,"brandBuilding":73,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":62,"awareness":72,"judgement":83},"picture":"BxB Hulk.png"},{"id":746,"name":"Gangrel","realName":"Gangrel","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":255,"height":185,"dateOfBirth":"1969-02-16T00:00:00.000Z","debut":"1988-01-01T00:00:00.000Z","wage":37500,"popularity":16,"charisma":52,"micSkills":62,"condition":60,"hardcoreAbility":71,"injuryProne":87,"ability":69,"currentAbility":40,"potentialAbility":52,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Gangrel is an American wrestler who works all over the world. He is a Middleweight who is classed as using a Entertainer style. He is best known for his work with MLW. He is married to someone outside the wrestling business.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAtt