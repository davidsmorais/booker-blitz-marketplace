0,"riskTaking":14,"matchLayout":83,"psychology":84,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":55,"characterCoaching":83,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":83,"brandBuilding":90,"socialMediaSavvy":89,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":78,"awareness":84,"judgement":90},"picture":"Cody Rhodes.png"},{"id":22,"name":"The Great Khali","realName":"The Great Khali","nickname":"","type":"wrestler","base":"Other","gender":"M","weight":418,"height":213,"dateOfBirth":"1972-08-27T00:00:00.000Z","debut":"2000-10-01T00:00:00.000Z","wage":37500,"popularity":46,"charisma":40,"micSkills":29,"condition":44,"hardcoreAbility":45,"injuryProne":72,"ability":31,"currentAbility":20,"potentialAbility":22,"morale":"fair","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Everyone looked up to The Great Khali – whether you wanted to or not.\r\n\r\nThat’s because the 7-foot-1, 347-pound skyscraper of a man towered over all of the WWE Universe. Khali stood out from every crowd not only for his overwhelming size, but also for being the first to blaze a trail to WWE from his native India.\r\n\r\nKhali’s battle-ready mentality and intimidating presence combined to make him a unique threat to every member of the WWE roster. He successfully stood tall against celebrated WWE Superstars, including The Undertaker, Kane, Big Show, John Cena and Shawn Michaels. And he was the last man standing in a 20-Man Battle Royal on SmackDown in 2007 that allowed Khali to realize his dream of becoming World Heavyweight Champion.","alterEgos":[],"birthplace":"India","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":62,"storytelling":54,"productFit":100,"riskTaking":28,"matchLayout":51,"psychology":62,"workerManagement":100,"trainingIntensity":34,"technicalCoaching":4,"characterCoaching":50,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":50,"brandBuilding":76,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":34,"consistency":54,"awareness":62,"judgement":77},"picture":"The Great Khali_alt1.png"},{"id":23,"name":"David Otunga","realName":"David Otunga","nickname":"","type":"scout","base":"USA","gender":"M","weight":229,"height":180,"dateOfBirth":"1980-04-07T00:00:00.000Z","debut":"2009-05-01T00:00:00.000Z","wage":66000,"popularity":16,"charisma":52,"micSkills":40,"condition":92,"hardcoreAbility":71,"injuryProne":100,"ability":63,"currentAbility":50,"potentialAbility":50,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"David Daniel Otunga, Sr. is an American professional wrestler, lawyer, and actor. In November 2008, Otunga signed a developmental contract with World Wrestling Entertainment and was assigned to its development territory, Florida Championship Wrestling. He made his debut on May 29, 2009, under the ring name Dawson Alexander. On February 16, 2010, after numerous dark matches on both Raw and Smackdown, it was announced that Otunga would wrestle on the first season of WWE NXT under his real name, with R-Truth as his storyline mentor.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2754],"staffAttributes":{"bookingLogic":24,"storytelling":43,"productFit":59,"riskTaking":45,"matchLayout":50,"psychology":51,"workerManagement":20,"trainingIntensity":32,"technicalCoaching":48,"characterCoaching":22,"teaching":32,"diagnosis":48,"rehabilitation":57,"prevention":53,"mediaHandling":58,"brandBuilding":35,"socialMediaSavvy":26,"ruleKnowledge":21,"positioning":23,"reactionSpeed":49,"consistency":40,"awareness":25,"judgement":87},"picture":"David Otunga_alt3.png"},{"id":24,"name":"Dean Malenko","realName":"Dean Malenko","nickname":"","type":"writer","promotionId":76,"base":"USA","gender":"M","weight":212,"height":175,"dateOfBirth":"1960-08-04T00:00:00.000Z","debut":"1979-01-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":27,"charisma":81,"micSkills":90,"condition":42,"hardcoreAbility":97,"injuryProne":60,"ability":84,"currentAbility":39,"potentialAbility":39,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Dean Simon better known by his ring name Dean Malenko, is a retired professional wrestler.  He is best known for his time with Extreme Championship Wrestling (ECW), New Japan Pro Wrestling (NJPW) and World Championship Wrestling (WCW). In WWF, he was a 2-time Light Heavyweight Champion. In WCW, he was a 1-time United States Champion, a 4-time Cruiserweight Champion and a 1-time World Tag Team Champion with Chris Benoit. In ECW, he was a 2-time Television Champion and a 1-time Tag Team Champion with Chris Benoit.","alterEgos":[],"birthplace":"Irvington, New Jersey, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-24","wrestlerId":24,"promotionId":76,"startDate":"2019-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":87,"storytelling":90,"productFit":100,"riskTaking":11,"matchLayout":91,"psychology":87,"workerManagement":100,"trainingIntensity":29,"technicalCoaching":49,"characterCoaching":64,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":89,"mediaHandling":64,"brandBuilding":49,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":29,"consistency":46,"awareness":87,"judgement":92},"picture":"Dean Malenko_alt.png"},{"id":25,"name":"Alberto El Patrón","realName":"Alberto El Patrón","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":239,"height":193,"dateOfBirth":"1977-05-25T00:00:00.000Z","debut":"2000-05-01T00:00:00.000Z","wage":4166,"popularity":51,"charisma":74,"micSkills":74,"condition":70,"hardcoreAbility":74,"injuryProne":100,"ability":59,"currentAbility":43,"potentialAbility":85,"morale":"good","presentation":"face","prestige":"mid","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Alberto El Patrón is a Mexican luchador who works in the USA, Canada, Mexico, Japan and Europe. He is a 6'5\", 239lb worker who is classed as using a Technician style. He uses the Cross Armbreaker as his finisher. He is best known for his work with WWE, CMLL, AAA, ROH, GLEAT and Lucha Ungrnd. Outside of wrestling he is a former MMA fighter.","alterEgos":["Alberto Del Rio"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":75,"storytelling":78,"productFit":100,"riskTaking":14,"matchLayout":79,"psychology":75,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":65,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":78,"brandBuilding":79,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":70,"awareness":75,"judgement":85},"picture":"Alberto Del Rio_alt5.png"},{"id":26,"name":"Drew McIntyre","realName":"Drew Galloway","nickname":"","type":"wrestler","promotionId":64,"base":"UK","gender":"M","weight":266,"height":193,"dateOfBirth":"1985-06-06T00:00:00.000Z","debut":"2001-01-01T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":67,"charisma":97,"micSkills":100,"condition":81,"hardcoreAbility":93,"injuryProne":100,"ability":81,"currentAbility":81,"potentialAbility":84,"morale":"great","presentation":"heel","prestige":"mid","style":"striker","cardPosition":"upper","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"While many fellow 15-year-olds were worried about sitting at the “popular table” at lunchtime, Drew McIntyre was already training to become a WWE Superstar. He didn’t have to wait terribly long to achieve his dream, either, as the endlessly athletic Scotsman skyrocketed from the U.K. independent scene to WWE before he was old enough to rent a car.\r\n\r\nMcIntyre secured himself a long-awaited World Championship opportunity when he won the 30-Man Royal Rumble Match in January 2020. The Scotsman took his career to the next level with a win over Brock Lesnar at WrestleMania 36 to capture his first WWE Title, finally earning the World Championship that Mr. McMahon had predicted.\r\n\r\nAfter several impressive WWE Title defenses against the likes of Seth Rollins, Bobby Lashley and Randy Orton, McIntyre was recognized as the face of Monday Night Raw when the red brand made him the first overall selection of the 2020 WWE Draft.","alterEgos":["Drew Galloway"],"birthplace":"Ayr, Scotland","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-26","wrestlerId":26,"promotionId":64,"startDate":"2018-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[913,915,1019,1044,1745,3664],"staffAttributes":{"bookingLogic":76,"storytelling":78,"productFit":100,"riskTaking":21,"matchLayout":78,"psychology":76,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":57,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":76,"brandBuilding":84,"socialMediaSavvy":79,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":83,"awareness":76,"judgement":86},"picture":"Drew McIntyre.png"},{"id":27,"name":"The Rock","realName":"The Rock","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":264,"height":190,"dateOfBirth":"1972-05-02T00:00:00.000Z","debut":"1996-03-01T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":90,"charisma":87,"micSkills":77,"condition":65,"hardcoreAbility":93,"injuryProne":93,"ability":60,"currentAbility":60,"potentialAbility":92,"morale":"excellent","presentation":"heel","prestige":"high","style":"powerhouse","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"He has been dubbed The Great One, The People’s Champion and The Most Electrifying Man in All of Entertainment. Mere words fail to capture the essence of the most charismatic Superstar of all time, though the catchphrase “boots to asses” comes awfully close.\r\n\r\nThe first third-generation Superstar in WWE history, the man born Dwayne Johnson was destined for sports-entertainment immortality since birth, but his rise to the status of a pop culture icon was harder to predict. In the time since he made his debut as a grinning good guy at the 1996 Survivor Series, The Brahma Bull has won eight WWE Championships, headlined WrestleMania, hosted “Saturday Night Live,” written a New York Times bestselling autobiography, top-billed the popular HBO series “Ballers” and starred in films like “Fast Five” and “The Game Plan,” which have grossed literally billions of dollars. The amazing thing is, he’s just getting started.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-27","wrestlerId":27,"promotionId":64,"startDate":"2024-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1498],"staffAttributes":{"bookingLogic":86,"storytelling":84,"productFit":100,"riskTaking":28,"matchLayout":83,"psychology":86,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":38,"characterCoaching":100,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":100,"brandBuilding":100,"socialMediaSavvy":100,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":61,"awareness":86,"judgement":92},"picture":"The Rock_alt4.png"},{"id":28,"name":"Primo Colón","realName":"Eddie Colón","nickname":"","type":"wrestler","promotionId":79,"base":"USA","gender":"M","weight":210,"height":175,"dateOfBirth":"1982-12-21T00:00:00.000Z","debut":"1999-12-01T00:00:00.000Z","wage":32800,"wageType":"per-appearance","popularity":15,"charisma":49,"micSkills":64,"condition":86,"hardcoreAbility":47,"injuryProne":100,"ability":49,"currentAbility":41,"potentialAbility":43,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Edwin \"Eddie\" Carlos Colón is a Puerto Rican professional wrestler. He is the son of Carlos Colón, Sr. and the younger brother of wrestlers Stacy and Carly Colón, (better known as Carlito in his WWE stint). He began wrestling in the World Wrestling Council, where he won the WWC Universal Heavyweight Championship five times, as well as numerous secondary and tertiary titles. In 2007, Colón signed a developmental contract with WWE, being assigned to Florida Championship Wrestling. In this promotion he was teamed with Eric Pérez, forming a tag team known as The Puerto Rican Nightmares. On February 23, 2008, they became the first wrestlers to hold the FCW Florida Tag Team Championship. Upon being promoted to the main brand, he was teamed with his brother. Subsequently, The Colóns became the first team to hold the WWE Tag Team Championship and World Tag Team Championship at the same time, making them the first Unified WWE Tag Team Champions.","alterEgos":["Eddie Colón","Diego","Primo"],"birthplace":"Puerto Rico","managerId":0,"contractExpiryDate":"2026-10-05T00:00:00.000Z","contract":{"id":"tew-contract-28","wrestlerId":28,"promotionId":79,"startDate":"2024-10-05T00:00:00.000Z","endDate":"2026-10-05T00:00:00.000Z","wage":32800,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[983,1410,3163],"staffAttributes":{"bookingLogic":54,"storytelling":62,"productFit":100,"riskTaking":29,"matchLayout":64,"psychology":54,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":50,"characterCoaching":49,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":49,"brandBuilding":47,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":78,"awareness":54,"judgement":72},"picture":"Primo_alt6.png"},{"id":29,"name":"Big E","realName":"Big E","nickname":"","type":"scout","promotionId":64,"base":"USA","gender":"M","weight":285,"height":177,"dateOfBirth":"1986-03-01T00:00:00.000Z","debut":"2009-12-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":56,"charisma":85,"micSkills":67,"condition":80,"hardcoreAbility":93,"injuryProne":100,"ability":80,"currentAbility":71,"potentialAbility":71,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"The New Day love to have a good time. Good times come easy when you have a powerhouse like Big E on your team who is willing to wear a unicorn horn on his head.\r\n\r\nThe word “Big” almost feels like an understatement when talking about Big E, but how else do you describe a 290-pound tank of a man who can deadlift a Fiat? “Superhuman” comes to mind, as does “Herculean.” “Big,” though, leaves no question about the type of punishment he dishes out inside the ring.\r\n\r\nLong before he was chanting “New Day Rocks,” Big E was destined to command the spotlight. He was always the strongest kid in class — an advantage he used to win state championships in high school wrestling and punish quarterbacks on the defensive line for the University of Iowa.","alterEgos":["Ettore Ewen"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-29","wrestlerId":29,"promotionId":64,"startDate":"2013-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1247,1248],"staffAttributes":{"bookingLogic":24,"storytelling":24,"productFit":60,"riskTaking":42,"matchLayout":54,"psychology":52,"workerManagement":22,"trainingIntensity":35,"technicalCoaching":39,"characterCoaching":55,"teaching":32,"diagnosis":59,"rehabilitation":45,"prevention":44,"mediaHandling":58,"brandBuilding":25,"socialMediaSavvy":58,"ruleKnowledge":42,"positioning":24,"reactionSpeed":52,"consistency":41,"awareness":21,"judgement":67},"picture":"Big E.png"},{"id":30,"name":"Fred Rosser","realName":"Fred Rosser","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":238,"height":182,"dateOfBirth":"1983-11-02T00:00:00.000Z","debut":"2002-11-01T00:00:00.000Z","wage":37500,"popularity":17,"charisma":75,"micSkills":48,"condition":80,"hardcoreAbility":40,"injuryProne":100,"ability":50,"currentAbility":42,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Fred Rosser is an American wrestler who works in America, Canada and Japan. He is a Middleweight who is classed as using a Entertainer style. He is best known for his work with WWE, NJoA and NWA. He is the protege of Mark Henry.","alterEgos":["Darren Young"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1282,4036,4037],"staffAttributes":{"bookingLogic":59,"storytelling":62,"productFit":100,"riskTaking":18,"matchLayout":63,"psychology":59,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":51,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":58,"brandBuilding":55,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":69,"awareness":59,"judgement":75},"picture":"Fred Rosser.png"},{"id":32,"name":"Matt Bloom","realName":"Matt Bloom","nickname":"","type":"writer","promotionId":65,"base":"USA","gender":"M","weight":331,"height":198,"dateOfBirth":"1972-11-14T00:00:00.000Z","debut":"1997-11-01T00:00:00.000Z","wage":20500,"wageType":"monthly","popularity":25,"charisma":99,"micSkills":93,"condition":65,"hardcoreAbility":93,"injuryProne":74,"ability":89,"currentAbility":56,"potentialAbility":56,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Matthew Jason \"Matt\" Bloom is an American professional wrestler. Bloom first rose to prominence under the ring names Albert and A-Train during his first tenure with WWE when it was named the World Wrestling Federation, during which he also became a one time Intercontinental Champion. After leaving WWE, In March 2005, Bloom began wrestling for the Japanese All Japan Pro Wrestling promotion, adopting the ring name Giant Bernard, a reference to former wrestler Brute Bernard. He went on to join the Voodoo Murders stable alongside fellow WWE alumni Chuck Palumbo and Johnny Stamboli. He became a three time World Tag Team Champion by winning New Japan Pro Wrestling's IWGP Tag Team Championship twice (once with Travis Tomko and once with Karl Anderson as Bad Intentions) and Pro Wrestling Noah's GHC Tag Team Championship once with Anderson.","alterEgos":["Giant Bernard","Prince Albert","Jason Albert","Tensai"],"birthplace":"Peabody, Massachusetts, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-32","wrestlerId":32,"promotionId":65,"startDate":"2014-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[942,943,2814],"staffAttributes":{"bookingLogic":68,"storytelling":71,"productFit":100,"riskTaking":5,"matchLayout":72,"psychology":68,"workerManagement":100,"trainingIntensity":47,"technicalCoaching":35,"characterCoaching":61,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":95,"mediaHandling":61,"brandBuilding":53,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":47,"consistency":70,"awareness":68,"judgement":81},"picture":"Jason Albert.png"},{"id":33,"name":"Kane","realName":"Kane","nickname":"","type":"scout","base":"USA","gender":"M","weight":323,"height":210,"dateOfBirth":"1967-04-26T00:00:00.000Z","debut":"1992-06-01T00:00:00.000Z","wage":66000,"popularity":52,"charisma":75,"micSkills":87,"condition":61,"hardcoreAbility":85,"injuryProne":100,"ability":81,"currentAbility":44,"potentialAbility":44,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"At 7 feet tall and weighing in at more than 300 pounds, Kane is a monstrous abomination that seems to have been extracted directly from your childhood nightmares.\r\n\r\nConsumed by an infernal desire to set ablaze the lives of his fellow Superstars, Kane leaves a scorched path of destruction behind his fiery footsteps. Some of The Big Red Monster’s more demented acts have included setting a WWE Hall of Famer on fire, hitting a WWE executive with a Tombstone, kidnapping too many Superstars to mention and forcing Lita to marry him. No one is safe from his twisted desires and demonic impulses. Least of all, it would seem, Kane himself.","alterEgos":["Diesel.","Isaac Yankem DDS"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1129,1130,1131,1359,1400,3355],"staffAttributes":{"bookingLogic":35,"storytelling":56,"productFit":31,"riskTaking":23,"matchLayout":39,"psychology":51,"workerManagement":29,"trainingIntensity":54,"technicalCoaching":50,"characterCoaching":37,"teaching":41,"diagnosis":38,"rehabilitation":59,"prevention":20,"mediaHandling":44,"brandBuilding":32,"socialMediaSavvy":40,"ruleKnowledge":24,"positioning":31,"reactionSpeed":48,"consistency":34,"awareness":20,"judgement":95},"picture":"Kane_suit.png"},{"id":34,"name":"Heath","realName":"Heath","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":216,"height":185,"dateOfBirth":"1983-07-15T00:00:00.000Z","debut":"2004-08-01T00:00:00.000Z","wage":37500,"popularity":27,"charisma":58,"micSkills":45,"condition":87,"hardcoreAbility":45,"injuryProne":100,"ability":51,"currentAbility":43,"potentialAbility":76,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Fueled by a mouth that never stops running and arrogance as scorching as the shock of red hair on his head, Heath Slater certainly lives up to his self-imposed moniker, “The One-Man Band.”\r\n\r\nHailing from West Virginia, Slater first exploded onto the WWE scene as a Rookie on WWE NXT’s inaugural season. Right out of the gate, Slater made an impact, becoming the first-ever NXT Rookie to defeat a WWE Pro in a singles match. From there, he joined The Nexus in its hostile takeover of WWE and, like all good rockers before him, refused to stay painted into a single corner.","alterEgos":["Heath Slater"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[913,914,1321,1322,1932,2419,2420],"staffAttributes":{"bookingLogic":59,"storytelling":63,"productFit":100,"riskTaking":15,"matchLayout":65,"psychology":59,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":50,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":78,"brandBuilding":54,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":72,"awareness":59,"judgement":75},"picture":"Heath Miller_alt9.png"},{"id":36,"name":"Jake Hager","realName":"Jake Hager","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":275,"height":198,"dateOfBirth":"1982-03-24T00:00:00.000Z","debut":"2006-09-01T00:00:00.000Z","wage":37500,"popularity":32,"charisma":70,"micSkills":54,"condition":72,"hardcoreAbility":74,"injuryProne":100,"ability":48,"currentAbility":48,"potentialAbility":68,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Jacob \"Jake\" Hager, Jr. is an American professional wrestler. Hager attended the University of Oklahoma as a two sport athlete, participating in both football and wrestling. He switched to wrestling full-time in his sophomore year, and in 2006, set the record for most pins in a season with 30 as an All-American. Following a try-out, Hager signed a WWE contract in mid-2006. He made his debut for the WWE developmental territory Deep South Wrestling in September, and was moved to the Ohio Valley Wrestling territory in January 2007. A few months later, Hager debuted for Florida Championship Wrestling, where he was the final FCW Southern Heavyweight Champion and the inaugural FCW Florida Heavyweight Champion. In late 2008, he debuted for the ECW brand under the name Jack Swagger, and in January 2009, he won his first world championship, the ECW Championship after defeating Matt Hardy.","alterEgos":["Jack Swagger"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1493,1583],"staffAttributes":{"bookingLogic":56,"storytelling":63,"productFit":100,"riskTaking":29,"matchLayout":65,"psychology":56,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":69,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":62,"brandBuilding":67,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":77,"awareness":56,"judgement":74},"picture":"Jake Hager_alt9.png"},{"id":37,"name":"Christian Cage","realName":"Christian Cage","nickname":"","type":"wrestler","promotionId":76,"base":"Canada","gender":"M","weight":209,"height":182,"dateOfBirth":"1973-11-30T00:00:00.000Z","debut":"1995-06-01T00:00:00.000Z","wage":80000,"wageType":"monthly","popularity":51,"charisma":73,"micSkills":80,"condition":67,"hardcoreAbility":90,"injuryProne":100,"ability":60,"currentAbility":60,"potentialAbility":72,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Christian Cage, who graduated from Funking Conservatory on 01 January 1998, is a Canadian wrestler who works in the USA, Canada and the British Isles. He is a 6'1\", 209lb worker who is classed as using a Entertainer style. He uses the Killswitch and the Spear as his finishers. He is best known for his work with WWE, AEW and TNA. He was one half of the Male Tag Team Of The Year in 2000. He was voted Male Veteran Wrestler Of The Year in 2023.","alterEgos":["Christian"],"birthplace":"Kitchener, Ontario, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-37","wrestlerId":37,"promotionId":76,"startDate":"2021-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":80000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1039,2663,4268],"staffAttributes":{"bookingLogic":84,"storytelling":85,"productFit":100,"riskTaking":11,"matchLayout":85,"psychology":84,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":68,"characterCoaching":84,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":89,"mediaHandling":84,"brandBuilding":71,"socialMediaSavvy":84,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":83,"awareness":84,"judgement":90},"picture":"Christian Cage.png"},{"id":38,"name":"JTG","realName":"JTG","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":233,"height":182,"dateOfBirth":"1984-12-10T00:00:00.000Z","debut":"2002-12-01T00:00:00.000Z","wage":37500,"popularity":14,"charisma":54,"micSkills":62,"condition":85,"hardcoreAbility":47,"injuryProne":100,"ability":51,"currentAbility":44,"potentialAbility":67,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The street-savvy robbin’ hood wasn’t just about flossed-out grills, swiping wallets and hot steppin’. JTG’s heart was in competing and stealing the spotlight. From his early days as one-half of the controversial tag team Cryme Tyme to a notable run as a singles star on SmackDown, JTG proved himself a tough Brooklyn brawler both in and out of the ring.\r\n\r\nThe wildly popular Cryme Tyme effectively combined JTG’s speed with Shad’s brute strength for a winning combination in WWE’s tag team division. Together, JTG and Shad were embraced by the WWE Universe, who learned its share of hip lingo on the pair’s WWE.com series “Word Up!” When Cryme Tyme’s seemingly unbreakable bond shattered in 2010, JTG was forced to go his own way, navigating the singles ranks on SmackDown.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1009,3289,3371],"staffAttributes":{"bookingLogic":44,"storytelling":52,"productFit":100,"riskTaking":33,"matchLayout":55,"psychology":44,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":33,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":63,"brandBuilding":52,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":54,"awareness":44,"judgement":66},"picture":"JTG_alt5.png"},{"id":39,"name":"Jerry Lawler","realName":"Jerry Lawler","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":243,"height":180,"dateOfBirth":"1949-11-29T00:00:00.000Z","debut":"1970-11-01T00:00:00.000Z","wage":37500,"popularity":40,"charisma":54,"micSkills":63,"condition":42,"hardcoreAbility":69,"injuryProne":93,"ability":47,"currentAbility":21,"potentialAbility":23,"morale":"fair","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"It’s good to be the king. Just ask Jerry Lawler.\r\n\r\nReigning over sports-entertainment since the 1970s, Jerry “The King” Lawler has thrilled in the ring as the pride of Memphis, Tenn. and entertained from the announce table as Raw’s most irrepressible broadcaster. Effective as both a hero and villain, The King enraged WWE fans when he offended Bret Hart’s parents during a personal rivalry with The Hit Man, and then inspired them when he stepped in the ring to challenge The Miz for the WWE Title at 61 years of age. This aptitude for every aspect of sports-entertainment has earned Lawler countless titles, legions of fans and entry into the WWE Hall of Fame.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3187],"staffAttributes":{"bookingLogic":72,"storytelling":80,"productFit":100,"riskTaking":22,"matchLayout":83,"psychology":72,"workerManagement":100,"trainingIntensity":31,"technicalCoaching":22,"characterCoaching":75,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":53,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":31,"consistency":47,"awareness":72,"judgement":83},"picture":"Jerry Lawler_alt5.png"},{"id":40,"name":"Jesus Rodríguez","realName":"Ricardo Rodríguez","nickname":"","type":"wrestler","promotionId":68,"base":"USA","gender":"M","weight":191,"height":170,"dateOfBirth":"1986-02-17T00:00:00.000Z","debut":"2006-08-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","popularity":13,"charisma":40,"micSkills":68,"condition":87,"hardcoreAbility":43,"injuryProne":100,"ability":60,"currentAbility":53,"potentialAbility":57,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jesús Rodríguez is a Mexican American professional wrestler and ring announcer. Before wrestling for independent California promotions, Rodriguez wrestled with other upcoming wrestlers in backyards for BBW Beyond Backyard Wrestling. Rodriguez formerly wrestled for various promotions as the masked wrestler Chimaera, and his professional wrestling debut came at UEW's 1st Annual West Coast Cruiser Cup Tournament on August 11, 2006. In Chikara, he participated in the Young Lions Cup VII and was eliminated by KC Day. At Dragon Gate USA, Chimaera competed in a Dragon Gate Fray match which was won by Brad Allen on March 26, 2010. For Deutsche Wrestling Allianz Chimaera had two championship opportunities one for the DWA Cruiserweight Championship and one for DWA Tag Team Championship. He also participated in Vendetta Pro Triforce Championship tournament and won the vacant Vendetta Pro Triforce Championship which he vacated when he signed for WWE.","alterEgos":["Ricardo Rodríguez"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-40","wrestlerId":40,"promotionId":68,"startDate":"2023-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3190],"staffAttributes":{"bookingLogic":61,"storytelling":63,"productFit":86,"riskTaking":22,"matchLayout":64,"psychology":61,"workerManagement":86,"trainingIntensity":62,"technicalCoaching":48,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":70,"brandBuilding":32,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":17,"reactionSpeed":62,"consistency":60,"awareness":61,"judgement":71},"picture":"Ricardo Rodriguez_alt1.png"},{"id":41,"name":"Jim Ross","realName":"Jim Ross","nickname":"","type":"commentator","promotionId":76,"base":"USA","gender":"M","weight":242,"height":180,"dateOfBirth":"1952-01-03T00:00:00.000Z","debut":"1974-01-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":48,"charisma":67,"micSkills":75,"condition":44,"hardcoreAbility":79,"injuryProne":74,"ability":62,"currentAbility":28,"potentialAbility":30,"morale":"fair","presentation":"face","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jim Ross is an American man who works primarily as an announcer. He is best known for his work with WWE, WCW, NJPW and AEW. He has been voted Announcer Of The Year twelve times. He is in the Hall Of Fame for WWE and NWA.","alterEgos":[],"birthplace":"Fort Bragg, California, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-41","wrestlerId":41,"promotionId":76,"startDate":"2019-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":80,"storytelling":56,"productFit":0,"riskTaking":100,"matchLayout":48,"psychology":80,"workerManagement":0,"trainingIntensity":5,"technicalCoaching":0,"characterCoaching":78,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":78,"brandBuilding":26,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":0,"reactionSpeed":5,"consistency":0,"awareness":80,"judgement":48},"picture":"Jim Ross.png"},{"id":42,"name":"Roman Reigns","realName":"Roman Reigns","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":265,"height":187,"dateOfBirth":"1985-05-25T00:00:00.000Z","debut":"2010-08-19T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":80,"charisma":85,"micSkills":99,"condition":78,"hardcoreAbility":100,"injuryProne":100,"ability":94,"currentAbility":94,"potentialAbility":97,"morale":"excellent","presentation":"heel","prestige":"high","style":"powerhouse","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Roman Reigns is an American wrestler who works exclusively in the USA. He is a 6'3\", 265lb worker who is classed as using a Powerhouse style. He uses the Spear as his finisher. He is best known for his work with WWE and NXT. He is married to someone outside the wrestling business. He was one half of the Male Tag Team Of The Year in 2013.","alterEgos":["Joe Anoa'i"],"birthplace":"Pensacola, Florida, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-42","wrestlerId":42,"promotionId":64,"startDate":"2012-11-18T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1503],"staffAttributes":{"bookingLogic":82,"storytelling":82,"productFit":100,"riskTaking":17,"matchLayout":82,"psychology":82,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":46,"characterCoaching":88,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":88,"brandBuilding":94,"socialMediaSavvy":84,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":89,"awareness":82,"judgement":89},"picture":"Roman Reigns.png"},{"id":43,"name":"Curtis Axel","realName":"Curtis Axel","nickname":"","type":"trainer","base":"USA","gender":"M","weight":228,"height":187,"dateOfBirth":"1979-10-01T00:00:00.000Z","debut":"2007-07-01T00:00:00.000Z","wage":66000,"popularity":22,"charisma":79,"micSkills":87,"condition":85,"hardcoreAbility":69,"injuryProne":100,"ability":90,"currentAbility":69,"potentialAbility":69,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Joseph Curtis \"Joe\" Hennig is a 3rd generation American professional wrestler. He is the grandson of Larry \"The Axe\" Hennig and the son of \"Mr. Perfect\" Curt Hennig. Hennig made his professional debut on July 13, 2007 in Waterloo, Iowa for World League Wrestling (WLW), teaming with Ted DiBiase, Jr. On March 31, 2007, Hennig along with his mother, siblings, and his grandfather represented his father \"Mr. Perfect\" Curt Hennig at the 2007 WWE Hall of Fame ceremony by accepting the award on his behalf. Hennig signed a developmental contract with World Wrestling Entertainment and was assigned to its developmental territory Florida Championship Wrestling (FCW). On September 11, 2008, Hennig and Sebastian Slater defeated Nic Nemeth and Gavin Spears to win the FCW Florida Tag Team Championship.","alterEgos":["Axelmania","Joe Hennig","Michael McGillicutty"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1221,1305,1612,2754],"staffAttributes":{"bookingLogic":60,"storytelling":45,"productFit":36,"riskTaking":56,"matchLayout":41,"psychology":45,"workerManagement":39,"trainingIntensity":56,"technicalCoaching":70,"characterCoaching":57,"teaching":79,"diagnosis":42,"rehabilitation":36,"prevention":31,"mediaHandling":26,"brandBuilding":28,"socialMediaSavvy":59,"ruleKnowledge":49,"positioning":56,"reactionSpeed":43,"consistency":40,"awareness":38,"judgement":25},"picture":"Curtis Axel.png"},{"id":45,"name":"John Cena","realName":"John Cena","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":251,"height":182,"dateOfBirth":"1977-04-23T00:00:00.000Z","debut":"1999-11-01T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":82,"charisma":80,"micSkills":79,"condition":63,"hardcoreAbility":79,"injuryProne":100,"ability":77,"currentAbility":77,"potentialAbility":97,"morale":"excellent","presentation":"face","prestige":"high","style":"powerhouse","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"He’s a 16-time World Champion, New York Times best-selling author and record-setting Make-A-Wish granter. He’s released a hit album, starred in blockbuster movies and carried the torch for WWE since he first set foot in a WWE ring nearly two decades ago. If you really can’t see John Cena at this point, chances are you simply aren’t looking.\r\n\r\nWas there any doubt Cena would become the living legend he is today? You practically knew you were glimpsing the future “Face That Runs the Place” when a muscular Massachusetts kid threw down with Kurt Angle for a chance to become a true WWE Superstar. Sure enough, a little ruthless aggression went a long way. After gaining the respect of his peers by stepping to The Olympic Hero, Cena went supernova as the fire-spitting Doctor of Thuganomics, eventually reaching the peak by upending JBL for his first WWE Championship at WrestleMania 21.","alterEgos":[],"birthplace":"West Newbury, Massachusetts, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-45","wrestlerId":45,"promotionId":64,"startDate":"2002-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":85,"storytelling":83,"productFit":100,"riskTaking":18,"matchLayout":82,"psychology":85,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":52,"characterCoaching":92,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":92,"brandBuilding":95,"socialMediaSavvy":85,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":70,"awareness":85,"judgement":91},"picture":"John Cena_alt29.png"},{"id":46,"name":"John Cone","realName":"John Cone","nickname":"","type":"referee","promotionId":64,"base":"USA","gender":"M","weight":174,"height":172,"dateOfBirth":"1974-11-16T00:00:00.000Z","debut":"1995-08-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":9,"charisma":85,"micSkills":72,"condition":100,"hardcoreAbility":96,"injuryProne":98,"ability":86,"currentAbility":58,"potentialAbility":60,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Cone started refereeing independent wrestling matches in August 1995. He worked for Harley Race World League Wrestling from 1999 to 2006 and got his big break when a WWE official attended a match he refereed. Cone tried out for WWE and was quickly signed. He was sent to WWE developmental territory Ohio Valley Wrestling and later Deep South Wrestling. John was one of the first referees to work for all three WWE brands ECW, SmackDown, and Raw. Since signing with WWE, John has refereed in 15 countries and on 5 continents. John has said he is most proud of his performance in the boxing match between Matt Hardy and Evander Holyfield, which took place in August, 2007 in front of a sold out crowd at Madison Square Garden.","alterEgos":[],"birthplace":"Kansas City, Missouri, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-46","wrestlerId":46,"promotionId":64,"startDate":"2005-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":20,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":20,"brandBuilding":45,"socialMediaSavvy":6,"ruleKnowledge":80,"positioning":64,"reactionSpeed":0,"consistency":65,"awareness":0,"judgement":0},"picture":"John Cone.png"},{"id":47,"name":"JBL","realName":"John Layfield","nickname":"","type":"scout","promotionId":5,"base":"USA","gender":"M","weight":290,"height":195,"dateOfBirth":"1966-11-29T00:00:00.000Z","debut":"1992-09-23T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":41,"charisma":83,"micSkills":71,"condition":58,"hardcoreAbility":68,"injuryProne":100,"ability":61,"currentAbility":32,"potentialAbility":32,"morale":"fair","presentation":"heel","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Never challenge John Bradshaw Layfield to a street fight — especially on Wall Street. The former WWE Champion may have been vicious in the ring, but the self-made millionaire is downright heartless when it comes to making a buck. Gifted with the business sense of a banking executive, the big man from Sweetwater, Texas could’ve easily made his fortune by sitting behind a desk, but there was nothing JBL loved more than a fight. A pro football player before stepping in the ring, Bradshaw first made an impression in WWE as a member of The New Blackjacks alongside Barry Windham in 1997. The WWE Universe took notice of the aggressive Texan, but it wasn’t until JBL linked up with the imposing Ron Simmons that he made a lasting impact. JBL retired to a tropical island with millions in his bank account in 2009, but he returned to WWE in 2012 as a color commentator on SmackDown and the host of WWE.com’s “JBL & Cole Show.”","alterEgos":["John Layfield","John Bradshaw Layfield"],"birthplace":"Sweetwater, Texas, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-47","wrestlerId":47,"promotionId":5,"startDate":"2024-07-17T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":56,"storytelling":47,"productFit":35,"riskTaking":52,"matchLayout":48,"psychology":54,"workerManagement":34,"trainingIntensity":29,"technicalCoaching":44,"characterCoaching":36,"teaching":38,"diagnosis":49,"rehabilitation":49,"prevention":28,"mediaHandling":22,"brandBuilding":29,"socialMediaSavvy":44,"ruleKnowledge":49,"positioning":43,"reactionSpeed":33,"consistency":22,"awareness":43,"judgement":65},"picture":"JBL_alt1.png"},{"id":48,"name":"JDC","realName":"Dirty Dango","nickname":"","type":"wrestler","promotionId":28,"base":"USA","gender":"M","weight":240,"height":187,"dateOfBirth":"1983-07-22T00:00:00.000Z","debut":"1999-09-01T00:00:00.000Z","wage":30700,"wageType":"per-appearance","popularity":22,"charisma":71,"micSkills":75,"condition":71,"hardcoreAbility":75,"injuryProne":100,"ability":61,"currentAbility":61,"potentialAbility":61,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"First introduced in a series of vignettes that showed him moving seductively in a nightclub with a gorgeous woman, Fandango shocked the sports-entertainment world when he defeated Chris Jericho in his in-ring debut at WrestleMania 29. That win still ranks as one of the greatest upsets in sports-entertainment history and shot the dancing devil into the viral stratosphere with a trend known as “Fandangoing.”\r\n\r\nAfter hanging up his dancing shoes, the 6-foot-4, 244-pounder teamed up with Tyler Breeze to form Breezango. With more style than a stack of GQ magazines, the duo captured the hearts of the WWE Universe when they dubbed themselves “The Fashion Police” and sought to rid the blue brand of any fashion faux pas, and they achieved their greatest victory to date when they finally captured tandem gold by defeating Imperium for the NXT Tag Team Titles.","alterEgos":["Dirty Dango","Fandango","Johnny Curtis"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-48","wrestlerId":48,"promotionId":28,"startDate":"2022-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[960,2548,2664,3371,3784],"staffAttributes":{"bookingLogic":64,"storytelling":68,"productFit":100,"riskTaking":19,"matchLayout":69,"psychology":64,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":46,"characterCoaching":75,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":75,"brandBuilding":64,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":68,"awareness":64,"judgement":78},"picture":"JDC.png"},{"id":49,"name":"Jon Moxley","realName":"Jon Moxley","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":224,"height":185,"dateOfBirth":"1985-12-07T00:00:00.000Z","debut":"2004-06-01T00:00:00.000Z","wage":80000,"wageType":"per-appearance","popularity":63,"charisma":92,"micSkills":100,"condition":76,"hardcoreAbility":98,"injuryProne":100,"ability":86,"currentAbility":86,"potentialAbility":89,"morale":"good","presentation":"heel","prestige":"mid","style":"striker","cardPosition":"upper","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jonathan Good is an American professional wrestler. Good got his start in Heartland Wrestling Association (HWA) in 2004 using the ring name Jon Moxley. He started training under the tutelage of Cody Hawk and Les Thatcher. In June 2004, Moxley made his debut. On June 6, 2009, Moxley was a participant in Combat Zone Wrestling (CZW)'s Tournament of Death VIII. In the first round, Moxley defeated Brain Damage in a Dining Death match, but lost to Nick \"F'N\" Gage in a triple threat fans bring the weapons match, also including Scotty Vortekz, in the semi-finals. Moxley started working for Dragon Gate USA (DGUSA) in 2009 and made appearances with the company until 2011. On April 4, 2011, it was confirmed that Good had signed a developmental deal with World Wrestling Entertainment, and Dragon Gate USA granted his release from the promotion. On May 27 he joined WWE's developmental territory, Florida Championship Wrestling, under the name Dean Ambrose.","alterEgos":["Dean Ambrose"],"birthplace":"Cincinnati, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-49","wrestlerId":49,"promotionId":76,"startDate":"2019-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":80000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1348,2440,3459],"staffAttributes":{"bookingLogic":75,"storytelling":76,"productFit":100,"riskTaking":24,"matchLayout":76,"psychology":75,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":56,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":85,"brandBuilding":78,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":78,"awareness":75,"judgement":85},"picture":"Jon Moxley.png"},{"id":50,"name":"Jimmy Uso","realName":"Jimmy Uso","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":251,"height":187,"dateOfBirth":"1985-08-22T00:00:00.000Z","debut":"2009-06-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":58,"charisma":64,"micSkills":71,"condition":92,"hardcoreAbility":74,"injuryProne":100,"ability":65,"currentAbility":65,"potentialAbility":78,"morale":"good","presentation":"heel","prestige":"mid","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The Usos don’t care if you like them. They might actually prefer it if you didn’t.\r\n\r\nThe twin sons of WWE Hall of Famer Rikishi, Jey and his brother Jimmy bubbled under the radar for years as a workhorse tag team in WWE before finally hitting the big time while embracing their Samoan heritage. The brothers would repeatedly take to the skies in bright colors, flying tassels and dazzling war paint, winning the WWE Tag Team Championship and Slammy for Tag Team of the Year twice.\r\n\r\nAs four-time SmackDown Tag Team Champions, these Usos are perhaps the most ruthless tag team walking WWE today. They’ll bring the crowd to its feet with their skills virtually every time they enter the ring (their battles with The New Day in 2017 were all instant classics). Back on SmackDown, all Jey & Jimmy need is each other: The only two who have been down since Day One.","alterEgos":["Jonathan Fatu"],"birthplace":"San Francisco, California, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-50","wrestlerId":50,"promotionId":64,"startDate":"2014-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[266,1521],"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":24,"matchLayout":71,"psychology":68,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":43,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":70,"brandBuilding":68,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":80,"awareness":68,"judgement":81},"picture":"Jimmy Uso.png"},{"id":51,"name":"Josh Mathews","realName":"Josh Mathews","nickname":"","type":"scout","promotionId":76,"base":"USA","gender":"M","weight":143,"height":172,"dateOfBirth":"1980-11-25T00:00:00.000Z","debut":"2001-01-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":13,"charisma":39,"micSkills":32,"condition":94,"hardcoreAbility":63,"injuryProne":100,"ability":45,"currentAbility":36,"potentialAbility":36,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Josh Matthew Lomberger is an American presenter, announcer, and former pro wrestler, better known by his ring name Josh Mathews. Lomberger was a runner-up to Maven and Nidia in the first WWE Tough Enough in 2001. After Tough Enough, Lomberger gained some in-ring experience on the independent circuit and in Xcitement Wrestling Federation, which was run by WWE Hall of Famer Jimmy Hart. Lomberger was eventually hired by World Wrestling Entertainment, and began using the name \"Josh Matthews\". In December 2002, he began appearing as the backstage interviewer for the SmackDown! brand and as an announcer on WWE Velocity. Mathews became the play by play commentator of Saturday Morning Slam upon the show's debut on August 18, 2012 on The CW. Two months later he joined former adversary JBL to become the new Smackdown commentary team.","alterEgos":[],"birthplace":"Griffith, Indiana, United States","managerId":0,"contractExpiryDate":"2027-05-01T00:00:00.000Z","contract":{"id":"tew-contract-51","wrestlerId":51,"promotionId":76,"startDate":"2025-05-01T00:00:00.000Z","endDate":"2027-05-01T00:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":47,"storytelling":49,"productFit":34,"riskTaking":53,"matchLayout":60,"psychology":28,"workerManagement":57,"trainingIntensity":33,"technicalCoaching":23,"characterCoaching":26,"teaching":39,"diagnosis":58,"rehabilitation":56,"prevention":24,"mediaHandling":43,"brandBuilding":57,"socialMediaSavvy":44,"ruleKnowledge":23,"positioning":47,"reactionSpeed":32,"consistency":49,"awareness":54,"judgement":84},"picture":"Josh Matthews.png"},{"id":52,"name":"Jey Uso","realName":"Jey Uso","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":240,"height":185,"dateOfBirth":"1985-08-22T00:00:00.000Z","debut":"2009-06-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":64,"charisma":70,"micSkills":70,"condition":91,"hardcoreAbility":69,"injuryProne":100,"ability":70,"currentAbility":70,"potentialAbility":87,"morale":"good","presentation":"heel","prestige":"mid","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The Usos don’t care if you like them. They might actually prefer it if you didn’t.\r\n\r\nThe twin sons of WWE Hall of Famer Rikishi, Jey and his brother Jimmy bubbled under the radar for years as a workhorse tag team in WWE before finally hitting the big time while embracing their Samoan heritage. The brothers would repeatedly take to the skies in bright colors, flying tassels and dazzling war paint, winning the WWE Tag Team Championship and Slammy for Tag Team of the Year twice.\r\n\r\nAs four-time SmackDown Tag Team Champions, these Usos are perhaps the most ruthless tag team walking WWE today. They’ll bring the crowd to its feet with their skills virtually every time they enter the ring (their battles with The New Day in 2017 were all instant classics). Back on SmackDown, all Jey & Jimmy need is each other: The only two who have been down since Day One.","alterEgos":["Joshua Fatu"],"birthplace":"San Francisco, California, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-52","wrestlerId":52,"promotionId":64,"startDate":"2014-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[266,1521],"staffAttributes":{"bookingLogic":72,"storytelling":74,"productFit":100,"riskTaking":22,"matchLayout":74,"psychology":72,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":45,"characterCoaching":84,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":84,"brandBuilding":77,"socialMediaSavvy":81,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":70,"awareness":72,"judgement":83},"picture":"Jey Uso.png"},{"id":54,"name":"Kevin Nash","realName":"Kevin Nash","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":328,"height":205,"dateOfBirth":"1959-07-09T00:00:00.000Z","debut":"1990-09-01T00:00:00.000Z","wage":37500,"popularity":53,"charisma":38,"micSkills":52,"condition":48,"hardcoreAbility":60,"injuryProne":47,"ability":50,"currentAbility":23,"potentialAbility":83,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"As Kevin Nash lifted one of his mighty legs over the ropes, you immediately knew what was to follow. And no, we're not talking about that other leg. It was time for trouble. Whether he's known as Diesel, one of \"The Outsiders\" or simply Big Kev, this imposing Superstar has never been afraid to make waves at every stop. He's got the list of enemies to prove it.\r\n\r\nDebuting as a sunglassed ringside enforcer in WWE, Nash quickly made an impact by taking on the role of Shawn Michaels' personal – and cold-blooded – bodyguard. Within his first year, Diesel eliminated seven men in the 1994 Royal Rumble Match and later won the Intercontinental Championship. Shortly thereafter, Diesel and Michaels captured the World Tag Team Titles together, making \"Big Daddy Cool\" a double champion in WWE.","alterEgos":["Diesel"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1486,1549,3152,3218,3219,3220],"staffAttributes":{"bookingLogic":78,"storytelling":75,"productFit":100,"riskTaking":37,"matchLayout":74,"psychology":78,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":16,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":85,"brandBuilding":67,"socialMediaSavvy":84,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":40,"awareness":78,"judgement":87},"picture":"Kevin Nash_alt5.png"},{"id":55,"name":"Kofi","realName":"Kofi Kingston","nickname":"","type":"wrestler","promotionId":76,"base":"Other","gender":"M","weight":213,"height":182,"dateOfBirth":"1981-08-14T00:00:00.000Z","debut":"2006-02-01T00:00:00.000Z","wage":4166,"wageType":"monthly","popularity":48,"charisma":85,"micSkills":99,"condition":82,"hardcoreAbility":100,"injuryProne":100,"ability":76,"currentAbility":76,"potentialAbility":88,"morale":"fair","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The New Day’s Kofi Kingston is powered by positivity, and he’s used it to catapult himself to new heights, including the WWE Championship.\r\n\r\nSince bursting on the WWE scene in 2007, Kingston has established himself as one of WWE’s premier high-flyers. That, paired with his upbeat attitude, made him a perennial favorite of the WWE Universe as he racked up Intercontinental, United States and Tag Team Championships. Kingston also cemented his place in WWE history with a series of daredevil moments where he saved himself from elimination in several Royal Rumble Matches.\r\n\r\nWhen he joined forces with Big E and Xavier Woods to form The New Day, though, no one could have guessed that the trio of unicorn horn-wearing, Booty-O-chomping Superstars would achieve the feats that they have in WWE. In fact, the WWE Universe despised them at first, but soon grew to love them.","alterEgos":["Kofi"],"birthplace":"Kumasi, Ghana","managerId":0,"contractExpiryDate":"2028-10-31T00:00:00.000Z","contract":{"id":"contract-bbdb-55","wrestlerId":55,"promotionId":76,"startDate":"2025-07-01T00:00:00.000Z","endDate":"2028-10-31T00:00:00.000Z","wage":4166,"wageType":"monthly","type":"exclusive","status":"active"},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[920,1003,1148,1247,1249,3660,4402],"staffAttributes":{"bookingLogic":73,"storytelling":75,"productFit":100,"riskTaking":30,"matchLayout":75,"psychology":73,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":61,"characterCoaching":77,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":77,"brandBuilding":72,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":71,"awareness":73,"judgement":84},"picture":"Kofi.png"},{"id":57,"name":"Mark Henry","realName":"Mark Henry","nickname":"","type":"interviewer","base":"USA","gender":"M","weight":360,"height":190,"dateOfBirth":"1971-06-12T00:00:00.000Z","debut":"1996-09-01T00:00:00.000Z","wage":66000,"popularity":39,"charisma":24,"micSkills":21,"condition":57,"hardcoreAbility":29,"injuryProne":95,"ability":34,"currentAbility":21,"potentialAbility":21,"morale":"fair","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Imagine every bone in your body being crushed into sawdust while you struggle to take a breath. Either you’re about to become python food, or you’re on the business end of Mark Henry’s World’s Strongest Slam.\r\n\r\nHenry burst onto the scene at the 1992 Summer Olympics in Barcelona, where he competed in weightlifting in the super-heavyweight division. Three years later at the Pan American Games, Henry captured a gold, silver and bronze medal. Henry’s intimidating size and weightlifting prowess earned the attention of WWE, which signed him in 1996. He stands as the first developmental talent for WWE and was under contract for more than two decades. From there, the new Superstar joined the infamous Nation of Domination, where he established himself as a ruthless and powerful big man — traits he channeled to earn first prize in the 2002 \"World's Strongest Man\" competition at the Arnold Schwarzenegger Classic.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1471],"staffAttributes":{"bookingLogic":29,"storytelling":23,"productFit":52,"riskTaking":20,"matchLayout":60,"psychology":44,"workerManagement":29,"trainingIntensity":48,"technicalCoaching":38,"characterCoaching":23,"teaching":30,"diagnosis":27,"rehabilitation":23,"prevention":25,"mediaHandling":85,"brandBuilding":50,"socialMediaSavvy":72,"ruleKnowledge":28,"positioning":33,"reactionSpeed":32,"consistency":60,"awareness":55,"judgement":39},"picture":"Mark Henry_alt6.png"},{"id":58,"name":"Matt Striker","realName":"Matt Striker","nickname":"","type":"commentator","base":"USA","gender":"M","weight":225,"height":175,"dateOfBirth":"1974-06-26T00:00:00.000Z","debut":"2001-01-01T00:00:00.000Z","wage":66000,"popularity":15,"charisma":36,"micSkills":33,"condition":88,"hardcoreAbility":42,"injuryProne":100,"ability":47,"currentAbility":31,"potentialAbility":31,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Matt Striker is a retired American wrestler who works as an announcer and a road agent. He was one half of Young Bluds alongside Rob Eckos. He is best known for his work with WWE, IMPACT, NOAH, wXw, MLW, GCW, HOH, ZERO1, Lucha Ungrnd, CWFH, ICW NHB and Defiant. He was voted Announcer Of The Year in 2008.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2818],"staffAttributes":{"bookingLogic":61,"storytelling":65,"productFit":100,"riskTaking":24,"matchLayout":66,"psychology":61,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":73,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":73,"brandBuilding":49,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":74,"awareness":61,"judgement":77},"picture":"Matt Striker_alt3.png"},{"id":59,"name":"Matt Sydal","realName":"Matt Sydal","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":165,"height":172,"dateOfBirth":"1983-03-19T00:00:00.000Z","debut":"2000-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":28,"charisma":77,"micSkills":55,"condition":78,"hardcoreAbility":47,"injuryProne":100,"ability":58,"currentAbility":58,"potentialAbility":81,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"If you are his opponent, don't let his boyish smile and peace signs catch you off guard because, the next thing you know, Evan Bourne will be executing a Shooting Star Press off a ladder down onto your ribs!\r\n\r\n\"Air Bourne,\" as he called the move, was perhaps the most breathtaking aerial assault in WWE, but it was far from the only trick in the high-flyer's arsenal. Bourne proved time and time again that he was willing to throw caution to the wind, especially when opponents least expected it. When you look like a happy-go-lucky sprout in a land of snarling giants, extreme measures need to be taken.","alterEgos":["Evan Bourne"],"birthplace":"St. Louis, Missouri, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-59","wrestlerId":59,"promotionId":76,"startDate":"2020-09-05T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[920,1219,1340,2452,2649,2702,2732,3516],"staffAttributes":{"bookingLogic":60,"storytelling":66,"productFit":100,"riskTaking":45,"matchLayout":68,"psychology":60,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":58,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":55,"mediaHandling":58,"brandBuilding":58,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":64,"awareness":60,"judgement":76},"picture":"Matt Sydal.png"},{"id":60,"name":"Matt Cardona","realName":"Matt Cardona","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":224,"height":185,"dateOfBirth":"1985-05-14T00:00:00.000Z","debut":"2004-05-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":35,"charisma":79,"micSkills":87,"condition":79,"hardcoreAbility":80,"injuryProne":100,"ability":73,"currentAbility":73,"potentialAbility":86,"morale":"fair","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Matt Cardona is an American wrestler who works in the USA, Canada, the British Isles and Japan. He is a 6'2\", 224lb worker who is classed as using a Entertainer style. He uses the Rough Ryder as his finisher. He is best known for his work with WWE, AEW, TNA, DDT, NWA, GCW, MLP, JCW and AIW. He is married to Chelsea Green. He was voted Male Independent Wrestler Of The Year in 2023.","alterEgos":["Zack Ryder"],"birthplace":"Merrick, New York, United States","managerId":0,"contractExpiryDate":"2028-01-02T00:00:00.000Z","contract":{"id":"tew-contract-60","wrestlerId":60,"promotionId":64,"startDate":"2026-01-02T00:00:00.000Z","endDate":"2028-01-02T00:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1419,1449,1450,3409,3494,3731],"staffAttributes":{"bookingLogic":63,"storytelling":67,"productFit":100,"riskTaking":31,"matchLayout":68,"psychology":63,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":54,"characterCoaching":82,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":82,"brandBuilding":77,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":62,"awareness":63,"judgement":78},"picture":"Matt Cardona.png"},{"id":61,"name":"Michael Cole","realName":"Michael Cole","nickname":"","type":"commentator","promotionId":64,"base":"USA","gender":"M","weight":176,"height":172,"dateOfBirth":"1968-12-08T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":41,"charisma":51,"micSkills":35,"condition":100,"hardcoreAbility":51,"injuryProne":100,"ability":39,"currentAbility":22,"potentialAbility":24,"morale":"fair","presentation":"face","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Michael Sean Coulthard, better known by his stage name, Michael Cole, is an American professional wrestling commentator, wrestling show host, seldom wrestler, and former news journalist. Coulthard began his career in the media as a journalist, working for CBS Radio. His first high-profile assignment was to cover the failed 1988 US presidential campaign of Democratic Party nominee Michael Dukakis. Cole came to the World Wrestling Federation in mid-1997 after being recommended to company officials by Todd Pettengill and started using the stage name \"Michael Cole.\" He provided voice-overs for promotional videos and later became the host of LiveWire show alongside Jim Cornette. He signed for WWE where he served as commentator for SmackDown starting in 1999, before being shifted to the company's flagship program, Raw, where his has been since 2008 to the present.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-61","wrestlerId":61,"promotionId":64,"startDate":"2003-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":1,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":1,"trainingIntensity":20,"technicalCoaching":0,"characterCoaching":71,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":71,"brandBuilding":41,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":0,"reactionSpeed":20,"consistency":0,"awareness":0,"judgement":0},"picture":"Michael Cole.png"},{"id":62,"name":"Mick Foley","realName":"Mick Foley","nickname":"","type":"commentator","promotionId":76,"base":"USA","gender":"M","weight":287,"height":190,"dateOfBirth":"1965-06-07T00:00:00.000Z","debut":"1983-06-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":52,"charisma":65,"micSkills":65,"condition":38,"hardcoreAbility":84,"injuryProne":87,"ability":82,"currentAbility":42,"potentialAbility":42,"morale":"good","presentation":"face","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Inspired to become a Superstar after watching Jimmy Snuka leap from the top of a steel cage in Madison Square Garden, Mick Foley adopted Superfly’s fearlessness when he entered the ring himself. As Cactus Jack, he earned a fan following not for winning matches, but for surviving them. In a bout against the punishing Big Van Vader in Germany, Foley’s ear was torn off. In Japan, he suffered third-degree burns in an exploding ring. Still, no matter what he suffered through, Foley kept fighting back.\r\n\r\nWhen he came to WWE in 1996, he turned into Mankind, a deranged miscreant who lurked in boiler rooms and shoved his fingers down opponents’ throats. Under the leather mask of this maniac, Foley lived through sports-entertainment’s most shocking moment when he was thrown off the top of the Hell in a Cell by The Undertaker. The unforgettable image of Foley’s body artlessly plummeting to the ground below defined not only his career, but WWE’s “Attitude Era” as a whole.","alterEgos":["Cactus Jack","Dude Love","Mankind"],"birthplace":"Bloomington, Indiana, United States","managerId":0,"contractExpiryDate":"2028-07-01T00:00:00.000Z","contract":{"id":"tew-contract-62","wrestlerId":62,"promotionId":76,"startDate":"2026-07-01T00:00:00.000Z","endDate":"2028-07-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1498,3245,3246],"staffAttributes":{"bookingLogic":28,"storytelling":56,"productFit":47,"riskTaking":31,"matchLayout":21,"psychology":40,"workerManagement":49,"trainingIntensity":42,"technicalCoaching":58,"characterCoaching":29,"teaching":20,"diagnosis":58,"rehabilitation":50,"prevention":47,"mediaHandling":85,"brandBuilding":51,"socialMediaSavvy":69,"ruleKnowledge":24,"positioning":52,"reactionSpeed":31,"consistency":51,"awareness":37,"judgement":44},"picture":"Mick Foley.png"},{"id":63,"name":"Mike Rotunda","realName":"Mike Rotunda","nickname":"","type":"writer","base":"USA","gender":"M","weight":255,"height":190,"dateOfBirth":"1958-03-30T00:00:00.000Z","debut":"1981-10-01T00:00:00.000Z","wage":66000,"popularity":10,"charisma":98,"micSkills":80,"condition":79,"hardcoreAbility":94,"injuryProne":80,"ability":82,"currentAbility":38,"potentialAbility":38,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Lawrence Michael \"Mike\" Rotunda is a former American professional wrestler, perhaps best known under the names Irwin R. Schyster or Michael Wallstreet. Rotunda was a varsity wrestler for the Syracuse Orangemen in New York. While he was never an All American, he did win the EIWA Championships in 1981 as a Heavyweight. Rotunda and Windham joined the World Wrestling Federation as the U.S. Express in 1984. They won the WWF World Tag Team Championship twice. Rotunda left the WWF in early 1987 and returned to Florida, where he won the NWA Florida Heavyweight Championship in March. In the WWF, Rotunda became Irwin R. Schyster (or I.R.S.). Schyster had a heel \"tax-man\" gimmick (he was portrayed as a former IRS tax collector from Washington, D.C.), and harassed the faces and fans, scolding them to pay their taxes.","alterEgos":["Irwin R. Schyster","Michael Wallstreet"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1228],"staffAttributes":{"bookingLogic":67,"storytelling":77,"productFit":100,"riskTaking":29,"matchLayout":80,"psychology":67,"workerManagement":100,"trainingIntensity":19,"technicalCoaching":18,"characterCoaching":63,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":63,"brandBuilding":31,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":19,"consistency":29,"awareness":67,"judgement":80},"picture":"Mike Rotunda_alt1.png"},{"id":65,"name":"Místico","realName":"Místico","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":190,"height":167,"dateOfBirth":"1982-12-22T00:00:00.000Z","debut":"1998-04-01T00:00:00.000Z","wage":64000,"wageType":"per-appearance","popularity":42,"charisma":100,"micSkills":87,"condition":80,"hardcoreAbility":79,"injuryProne":100,"ability":78,"currentAbility":78,"potentialAbility":90,"morale":"fair","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"He is without a doubt one of the greatest figures in the history of wrestling. Protagonist of one of the greatest phenomena in the history of this sport and the engine of the new boom in this sport.\r\n\r\nYou can't talk about modern wrestling without mentioning this man. He began with the name Dr. Karonte Jr. in 1998 taking the name his father had wrestled with. Later, under the name Astro Boy, he joined the ranks of the World Wrestling Council where he began to show his great talent. As of 2004, he takes on the character Místico where he immediately captures the attention of the fans. \r\n\r\nIn 2004 he participated in the La Gran Alternativa Tournament which is a fair where a high-ranking fighter sponsors a rookie to give him a boost, there he was supported by El Hijo del Santo causing a real stir and winning said tournament. From that moment on, he captured the attention of the media and fans who began to fill the arenas where he performed, thus starting a new era in wrestling.","alterEgos":["Caristico","Myzteziz","Sin Cara"],"birthplace":"Mexico City, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-65","wrestlerId":65,"promotionId":11,"startDate":"2015-12-18T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":64000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"additionalContracts":[{"id":"tew-contract-65-38","wrestlerId":65,"promotionId":38,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-65-49","wrestlerId":65,"promotionId":49,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":16400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-65-68","wrestlerId":65,"promotionId":68,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-65-76","wrestlerId":65,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[982,1176,2775,2918],"staffAttributes":{"bookingLogic":76,"storytelling":79,"prod