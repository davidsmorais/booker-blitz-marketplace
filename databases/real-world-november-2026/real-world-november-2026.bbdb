"workerManagement":100,"trainingIntensity":31,"technicalCoaching":33,"characterCoaching":78,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":78,"brandBuilding":49,"socialMediaSavvy":79,"ruleKnowledge":0,"positioning":20,"reactionSpeed":31,"consistency":31,"awareness":96,"judgement":98},"picture":"Jake Roberts_alt1.png"},{"id":1132,"name":"Tatanka","realName":"Tatanka","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":264,"height":177,"dateOfBirth":"1965-06-08T00:00:00.000Z","debut":"1989-06-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":51,"micSkills":37,"condition":61,"hardcoreAbility":37,"injuryProne":92,"ability":60,"currentAbility":30,"potentialAbility":32,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Christopher \"Chris\" Chavis is a Native American professional wrestler best known for his work with World Wrestling Entertainment as Tatanka, His ring name is a Lakota word that literally means \"bull buffalo.\" He is descended from the Lumbee Native American tribe. In 1989, Chavis left Bally's to pursue an accounting career. He met \"Nature Boy\" Buddy Rogers in Florida at a video store while looking for wrestling tapes. Rogers had Chavis call Larry Sharpe, who ran a wrestling school in southern New Jersey called \"The Monster Factory.\" He had his first match, as Tatanka, against Joe Thunderstorm in Philadelphia, Pennsylvania on January 13, 1990.","alterEgos":["\"The Native American\" Tatanka"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":61,"storytelling":65,"productFit":100,"riskTaking":23,"matchLayout":66,"psychology":61,"workerManagement":100,"trainingIntensity":38,"technicalCoaching":30,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":58,"brandBuilding":58,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":38,"consistency":58,"awareness":61,"judgement":77},"picture":"Tatanka.png"},{"id":1133,"name":"Nick Dinsmore","realName":"Nick Dinsmore","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":235,"height":180,"dateOfBirth":"1975-12-17T00:00:00.000Z","debut":"1996-01-01T00:00:00.000Z","wage":37500,"popularity":6,"charisma":55,"micSkills":57,"condition":61,"hardcoreAbility":69,"injuryProne":99,"ability":66,"currentAbility":46,"potentialAbility":48,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Nicholas David Dinsmore is an American professional wrestler. He is perhaps best known for his time working World Wrestling Entertainment. Over the course of his career, Dinsmore has held the OVW Heavyweight Championship a record nine times, the OVW Southern Tag Team Championship eleven times, a record shared with former tag team partner Rob Conway, and the World Tag Team Championship one time. Dinsmore debuted in 1997, and soon began wrestling in the United States Wrestling Association. In Ohio Valley Wrestling, he formed a successful tag team with Rob Conway, called The Lords of The Ring.","alterEgos":["Eugene"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[330,2833],"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":21,"matchLayout":75,"psychology":68,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":63,"characterCoaching":72,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":72,"brandBuilding":44,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":65,"awareness":68,"judgement":81},"picture":"Nick Dinsmore_alt5.png"},{"id":1135,"name":"Necro Butcher","realName":"Necro Butcher","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":229,"height":185,"dateOfBirth":"1973-07-13T00:00:00.000Z","debut":"1998-01-01T00:00:00.000Z","wage":37500,"popularity":6,"charisma":39,"micSkills":29,"condition":51,"hardcoreAbility":29,"injuryProne":100,"ability":47,"currentAbility":31,"potentialAbility":33,"morale":"broken","presentation":"face","prestige":"low","style":"hardcore","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Dylan Keith Summers is an American professional wrestler best known by his ring name (The) Necro Butcher. Throughout the years he has worked for various promotions, including Beyond Wrestling, Firestormpro, Ring of Honor, Full Impact Pro, IWA-Mid South, Pro Wrestling Guerrilla, Big Japan Pro Wrestling, and Combat Zone Wrestling. Summers is well known for his willingness to participate in a creative and dangerous mix of hardcore wrestling, deathmatches, and brawls, as well as his appearance in the 2008 film The Wrestler.","alterEgos":["MAGA Butcher"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":38,"storytelling":41,"productFit":100,"riskTaking":65,"matchLayout":42,"psychology":38,"workerManagement":100,"trainingIntensity":48,"technicalCoaching":10,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":35,"mediaHandling":68,"brandBuilding":5,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":48,"consistency":50,"awareness":38,"judgement":63},"picture":"Necro Butcher.png"},{"id":1137,"name":"Ricky Reyes","realName":"Ricky Reyes","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":191,"height":172,"dateOfBirth":"1978-08-21T00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":46,"micSkills":72,"condition":70,"hardcoreAbility":49,"injuryProne":100,"ability":71,"currentAbility":53,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ricky Reyes is a Cuban-American professional wrestler known for his appearances in Ring of Honor, Pro Wrestling Guerrilla, and various other independent promotions, he is currently primarily working for the World Wrestling Council. On September 9, 2006, Reyes debuted in Combat Zone Wrestling (CZW) and joined The Blackout. Reyes left CZW on October 21, 2006 to join Pro Wrestling Unplugged. On the May 25, 2012 episode of WWE SmackDown, Reyes competed in a handicapped match on the losing end of a two-man team versus Ryback. Reyes competed under the name Brian Edwards.","alterEgos":["Cortez Castro","Veneno"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1413,2657,3025,3026,3278,3279],"staffAttributes":{"bookingLogic":61,"storytelling":65,"productFit":100,"riskTaking":29,"matchLayout":66,"psychology":61,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":62,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":51,"brandBuilding":38,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":67,"awareness":61,"judgement":77},"picture":"Ricky Reyes.png"},{"id":1140,"name":"Diamond Dallas Page","realName":"Diamond Dallas Page","nickname":"","type":"manager","base":"USA","gender":"M","weight":248,"height":193,"dateOfBirth":"1956-04-05T00:00:00.000Z","debut":"1988-01-01T00:00:00.000Z","wage":66000,"popularity":41,"charisma":81,"micSkills":59,"condition":61,"hardcoreAbility":72,"injuryProne":57,"ability":58,"currentAbility":27,"potentialAbility":27,"morale":"fair","presentation":"face","prestige":"mid","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Starting his career as a manager in the American Wrestling Association in the late '80s, Diamond Dallas Page made his first WWE appearance in 1990 when he drove The Honky Tonk Man and Greg Valentine to the ring in his pink Cadillac at WrestleMania VI.\r\n\r\nAs a result of using yoga to rehabilitate what he thought was a career-ending 1998 back injury in WCW, Page started developing DDP YOGA in 2005. On February 21, 2014, Page appeared on the ABC television series Shark Tank where he declined to sell a 5% share in DDP YOGA for $200,000. He had hoped to use the money to develop a mobile app. The investors believed the company's 2013 profits of $800,000 would decline in future years. Page later said he sold more than $1 million worth of product in the first six days after his appearance and used the revenues to build the DDP YOGA Performance Center in Smyrna, Georgia and develop the DDP NOW mobile app.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3152],"staffAttributes":{"bookingLogic":82,"storytelling":84,"productFit":100,"riskTaking":17,"matchLayout":84,"psychology":82,"workerManagement":100,"trainingIntensity":43,"technicalCoaching":27,"characterCoaching":79,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":79,"brandBuilding":55,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":43,"consistency":37,"awareness":82,"judgement":89},"picture":"Diamond Dallas Page.png"},{"id":1141,"name":"Hamuko Hoshi","realName":"Hamuko Hoshi","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":128,"height":147,"dateOfBirth":"1982-10-19T00:00:00.000Z","debut":"2008-04-01T00:00:00.000Z","wage":3000,"popularity":2,"charisma":47,"micSkills":38,"condition":77,"hardcoreAbility":54,"injuryProne":100,"ability":55,"currentAbility":45,"potentialAbility":47,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Hamuko Hoshi is a Japanese professional wrestler, currently working for the Ice Ribbon promotion, where she is a former one-time Internet Wrestling 19 and a four-time International Ribbon Tag Team Champion. Trained by Emi Sakura, Hoshi made her professional wrestling debut for her Ice Ribbon promotion on April 12, 2008, wrestling Makoto to a three-minute time limit draw.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2411,2412,2472,2473],"staffAttributes":{"bookingLogic":56,"storytelling":61,"productFit":100,"riskTaking":25,"matchLayout":62,"psychology":56,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":57,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":51,"brandBuilding":40,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":75,"awareness":56,"judgement":74},"picture":"Hamuko Hoshi.png"},{"id":1142,"name":"Maki Narumiya","realName":"Maki Narumiya","nickname":"","type":"manager","base":"Japan","gender":"F","weight":128,"height":160,"dateOfBirth":"1985-04-07T00:00:00.000Z","debut":"2011-03-01T00:00:00.000Z","wage":66000,"popularity":1,"charisma":56,"micSkills":52,"condition":93,"hardcoreAbility":62,"injuryProne":100,"ability":38,"currentAbility":33,"potentialAbility":33,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Maki Narumiya is a Japanese professional wrestler. A former dancer, Narumiya was trained in professional wrestling by Emi Sakura and has worked for the Ice Ribbon promotion ever since making her debut in March 2011. She is a former one-time ICE×60 and International Ribbon Tag Team Champion. Narumiya also makes regular appearances for the JWP Joshi Puroresu promotion. Former dancer and alum of Ochanomizu University.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2990],"staffAttributes":{"bookingLogic":47,"storytelling":57,"productFit":30,"riskTaking":34,"matchLayout":60,"psychology":47,"workerManagement":30,"trainingIntensity":82,"technicalCoaching":56,"characterCoaching":67,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":67,"brandBuilding":53,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":6,"reactionSpeed":82,"consistency":78,"awareness":47,"judgement":40},"picture":"Maki Narumiya.png"},{"id":1143,"name":"Aika Ando","realName":"Aika Ando","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":106,"height":157,"dateOfBirth":"1984-07-09T00:00:00.000Z","debut":"2007-10-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":34,"micSkills":42,"condition":100,"hardcoreAbility":42,"injuryProne":100,"ability":40,"currentAbility":34,"potentialAbility":34,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Aika Ando is one of Ice Ribbon’s least experienced (and of course most popular) wrestlers. She also competes almost exclusively in the promotion, but began expanding her reach in early 2010 and appearing in other promotions-most notably DDT. She currently appears in Ice Ribbon on an occasional basis, usually only doing major events. When not competing she’s a “weathergirl” for Nikkan Sports and she’s also a popular gravure/bikini idol and was the only “survivor” of an apparent gravure idol wrestling promotion. In September 2009 she did a promo video where she did appear in a bikini. She also makes regular appearances on TV Tokyo and is now even a singer!","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":36,"storytelling":44,"productFit":32,"riskTaking":25,"matchLayout":47,"psychology":36,"workerManagement":32,"trainingIntensity":66,"technicalCoaching":49,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":67,"brandBuilding":53,"socialMediaSavvy":60,"ruleKnowledge":0,"positioning":6,"reactionSpeed":66,"consistency":55,"awareness":36,"judgement":34},"picture":"Aika Ando.png"},{"id":1144,"name":"Mio Shirai","realName":"Mio Shirai","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":119,"height":162,"dateOfBirth":"1988-02-14T00:00:00.000Z","debut":"2007-03-04T00:00:00.000Z","wage":4166,"popularity":3,"charisma":66,"micSkills":59,"condition":70,"hardcoreAbility":54,"injuryProne":83,"ability":69,"currentAbility":64,"potentialAbility":69,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Mio Shirai is a Japanese professional wrestler, currently working as a freelancer on the Japanese independent circuit for promotions such as Ice Ribbon, Oz Academy, Pro Wrestling Wave, and Union Pro. She is also a member of the tag team Triple Tails.S with Kana, which was originally a stable also including Mio's younger sister Io, who left the group in September 2011. Together Mio and Io are former TLW World Young Women's Tag Team Champions.","alterEgos":["MIO"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[397,2924],"staffAttributes":{"bookingLogic":80,"storytelling":81,"productFit":100,"riskTaking":27,"matchLayout":82,"psychology":80,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":68,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":73,"brandBuilding":75,"socialMediaSavvy":68,"ruleKnowledge":69,"positioning":75,"reactionSpeed":70,"consistency":67,"awareness":80,"judgement":88},"picture":"Mio Shirai.png"},{"id":1145,"name":"Dax Harwood","realName":"Dax Harwood","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":211,"height":175,"dateOfBirth":"1984-06-30T00:00:00.000Z","debut":"2004-08-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":48,"charisma":81,"micSkills":80,"condition":75,"hardcoreAbility":99,"injuryProne":100,"ability":75,"currentAbility":75,"potentialAbility":88,"morale":"fair","presentation":"heel","prestige":"mid","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"David Michael Harwood is an American worker from North Carolina best known for his time in WWE under the name Scott Dawson, where he teamed with Dash Wilder as The Revival. Their old school 80s style of tag team wrestling led to them being compared favourably with The Brain Busters (Arn Anderson & Tully Blanchard) and they gained a reputation for having consistently great matches while in NXT. Despite becoming 3-time tag team champions after being called up to the main roster in 2017, they were plagued by poor booking and had multiple requests for their release turned down before finally being let go in April 2020. The former Dawson now goes by the name Dax Harwood and continues to team with Dash, now named Cash Wheeler, under the name \"FTR\" - a reference to their online feud with The Young Bucks through their web series Being The Elite.","alterEgos":["Dawson"],"birthplace":"Whiteville, North Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1145","wrestlerId":1145,"promotionId":76,"startDate":"2020-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1494,1495,2048,2077,3502,3590,3641],"staffAttributes":{"bookingLogic":84,"storytelling":85,"productFit":100,"riskTaking":17,"matchLayout":85,"psychology":84,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":68,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":62,"brandBuilding":58,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":90,"awareness":84,"judgement":90},"picture":"Dax Harwood.png"},{"id":1146,"name":"Tom LaRuffa","realName":"Tom LaRuffa","nickname":"","type":"wrestler","base":"Europe","gender":"M","weight":200,"height":177,"dateOfBirth":"1984-05-04T00:00:00.000Z","debut":"2007-01-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":60,"micSkills":68,"condition":88,"hardcoreAbility":58,"injuryProne":100,"ability":63,"currentAbility":54,"potentialAbility":57,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Straight from the nightclubs and the casinos of the Jet Set of the French Riviera, this over-the-top Frenchman comes from strong Italian and Greek Origins. His Mediterrean hot temper makes him an unpredictable character – as well as a dangerous one. He prides himself on being a main attraction everywhere he competes and even though small in stature, his intensity and aggressive nature makes him a threat to any giant in NXT. Lefort lives by the motto: “I am not a big guy – but I will do some big things”","alterEgos":["Basile Baraka","Sylvester Lefort"],"birthplace":"France","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":48,"storytelling":54,"productFit":58,"riskTaking":23,"matchLayout":56,"psychology":48,"workerManagement":58,"trainingIntensity":62,"technicalCoaching":44,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":64,"brandBuilding":62,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":12,"reactionSpeed":62,"consistency":84,"awareness":48,"judgement":52},"picture":"Tom La Ruffa.png"},{"id":1147,"name":"Manami Toyota","realName":"Manami Toyota","nickname":"","type":"trainer","base":"Japan","gender":"F","weight":150,"height":165,"dateOfBirth":"1971-03-02T00:00:00.000Z","debut":"1988-03-01T00:00:00.000Z","wage":1000,"popularity":9,"charisma":95,"micSkills":100,"condition":75,"hardcoreAbility":99,"injuryProne":90,"ability":100,"currentAbility":61,"potentialAbility":61,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Manami Toyota is a professional wrestler best known for her work with the All Japan Women's Pro-Wrestling (AJW) wrestling promotion. Following AJW's closure she has continued to work in other joshi promotions such as Gaea and NEO. Toyota is a member of the Wrestling Observer Newsletter Hall of Fame. Manami Toyota made her professional wrestling debut on August 5, 1987, at the age of 16, in a singles match against Sachiko Nakamura. Toyota produced her 25th anniversary event on September 22 2012, during which she wrestled in all five matches.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2989],"staffAttributes":{"bookingLogic":25,"storytelling":29,"productFit":56,"riskTaking":42,"matchLayout":47,"psychology":27,"workerManagement":56,"trainingIntensity":77,"technicalCoaching":49,"characterCoaching":55,"teaching":83,"diagnosis":47,"rehabilitation":46,"prevention":22,"mediaHandling":33,"brandBuilding":31,"socialMediaSavvy":52,"ruleKnowledge":27,"positioning":44,"reactionSpeed":48,"consistency":55,"awareness":46,"judgement":58},"picture":"Manami Toyota.png"},{"id":1149,"name":"El Pantera","realName":"El Pantera","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":187,"height":167,"dateOfBirth":"1964-02-03T00:00:00.000Z","debut":"1985-11-03T00:00:00.000Z","wage":37500,"popularity":4,"charisma":54,"micSkills":61,"condition":47,"hardcoreAbility":44,"injuryProne":98,"ability":62,"currentAbility":31,"potentialAbility":33,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Francisco Javier Pozas is a Mexican professional wrestler, or luchador, who is best known under the ring name El Pantera, but has also worked as Pantera II, El Manaya, América, Tritón and TANAKA over the years. Pozas made his wrestling debut in 1985, working as an enmascarado (masked wrestler) with a panther-inspired mask to go with his ring character of \"El Pantera\". Over the years Pozas has worked in Mexico, Japan and the United States; In Mexico he has worked for Consejo Mundial de Lucha Libre (CMLL), Asistencia Asesoría y Administración (AAA), International Wrestling Revolution Group (IWRG), in Japan he's worked for Universal Lucha Libre (ULL) and All-Japan Pro Wrestling (AJPW) and in the United States he's most known for his work in the World Wrestling Federation (WWF) from 1997 to 1999 and Chikara where he has worked shows since 2007. In 2006 Pantera lost his mask as a result of a match. He, however, continued wearing the mask when working for Chikara.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1202,2762],"staffAttributes":{"bookingLogic":85,"storytelling":86,"productFit":100,"riskTaking":18,"matchLayout":86,"psychology":85,"workerManagement":100,"trainingIntensity":49,"technicalCoaching":62,"characterCoaching":40,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":40,"brandBuilding":49,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":20,"reactionSpeed":49,"consistency":57,"awareness":85,"judgement":91},"picture":"El Pantera.png"},{"id":1150,"name":"El Hijo del Pantera","realName":"El Hijo del Pantera","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":176,"height":170,"dateOfBirth":"1991-12-18T00:00:00.000Z","debut":"2010-09-01T00:00:00.000Z","wage":32000,"wageType":"per-appearance","popularity":4,"charisma":58,"micSkills":48,"condition":93,"hardcoreAbility":35,"injuryProne":100,"ability":56,"currentAbility":54,"potentialAbility":60,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Hijo del Pantera is a Mexican enmascarado. He is most active around Queretaro and Arena Naucalpan, almost always working the same shows as his father early on. In 2012, he moved to Japan for an extended stay/training session with Wrestling New Classic, often facing Hajime Ohara. Came back to Mexico for a few months in late 2012 and early 2013, but returned again to Japan","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-07-05T00:00:00.000Z","contract":{"id":"tew-contract-1150","wrestlerId":1150,"promotionId":11,"startDate":"2024-07-05T00:00:00.000Z","endDate":"2026-07-05T00:00:00.000Z","wage":32000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1202],"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":34,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":58,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":54,"brandBuilding":42,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":67,"awareness":56,"judgement":74},"picture":"Hijo del Pantera.png"},{"id":1151,"name":"Tinieblas Jr.","realName":"Tinieblas Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":238,"height":190,"dateOfBirth":"1966-05-26T00:00:00.000Z","debut":"1990-06-01T00:00:00.000Z","wage":37500,"popularity":7,"charisma":60,"micSkills":50,"condition":79,"hardcoreAbility":67,"injuryProne":100,"ability":60,"currentAbility":31,"potentialAbility":33,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Tinieblas, Jr. is the ring name of a Mexican Luchador enmascarado. Tinieblas, Jr.'s full name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans. He is the son of Manuel Leal, who has wrestled for many years under the ring name Tinieblas. Tinieblas is Spanish for \"Darkness\". During the summer of 2010, Tinieblas, Jr. began working for a newly created wrestling promotion, backed by MTV2 called Lucha Libre USA, wrestling on their first television taping on June 19, 2010.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3167],"staffAttributes":{"bookingLogic":64,"storytelling":69,"productFit":100,"riskTaking":25,"matchLayout":70,"psychology":64,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":67,"characterCoaching":39,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":39,"brandBuilding":67,"socialMediaSavvy":25,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":64,"awareness":64,"judgement":78},"picture":"Tinieblas Jr.png"},{"id":1153,"name":"Lexie Fyfe","realName":"Lexie Fyfe","nickname":"","type":"trainer","base":"USA","gender":"F","weight":134,"height":160,"dateOfBirth":"1968-05-30T00:00:00.000Z","debut":"1995-08-01T00:00:00.000Z","wage":66000,"popularity":3,"charisma":90,"micSkills":83,"condition":85,"hardcoreAbility":95,"injuryProne":93,"ability":85,"currentAbility":47,"potentialAbility":47,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Mary Beth Bentley, is an American professional wrestler. She has wrestled in various independent wrestling promotions, most notably for Shimmer Women Athletes and has had tryouts for both WWE and WCW. When Shine Wrestling was established on July 20, 2012, Lexie began her stint as a babyface authority figure for the promotion.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3235],"staffAttributes":{"bookingLogic":48,"storytelling":58,"productFit":47,"riskTaking":54,"matchLayout":25,"psychology":55,"workerManagement":41,"trainingIntensity":84,"technicalCoaching":80,"characterCoaching":88,"teaching":93,"diagnosis":23,"rehabilitation":31,"prevention":39,"mediaHandling":25,"brandBuilding":25,"socialMediaSavvy":26,"ruleKnowledge":47,"positioning":51,"reactionSpeed":27,"consistency":23,"awareness":60,"judgement":24},"picture":"Lexie Fyfe.png"},{"id":1154,"name":"Rain","realName":"Rain","nickname":"","type":"trainer","base":"USA","gender":"F","weight":128,"height":165,"dateOfBirth":"1981-09-10T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":66000,"popularity":2,"charisma":73,"micSkills":63,"condition":87,"hardcoreAbility":47,"injuryProne":100,"ability":61,"currentAbility":49,"potentialAbility":49,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Bonnie Maxon is an American professional wrestler best known by her ring name Rain or as Payton Banks in Total Nonstop Action Wrestling. She formerly tag teamed with partner Lacey to form The Minnesota Home-Wrecking Crew (a play on the name of the Minnesota Wrecking Crew), but following Lacey's retirement, she teamed with British wrestler Jetta to form The International Home Wrecking Crew. Rain made her debut for new women's wrestling promotion Shine Wrestling, stylized as SHINE, on July 20 in Ybor City, Florida where she defeated Nikki Roxx.","alterEgos":["Payton Banks"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2950],"staffAttributes":{"bookingLogic":56,"storytelling":51,"productFit":49,"riskTaking":40,"matchLayout":46,"psychology":56,"workerManagement":40,"trainingIntensity":85,"technicalCoaching":75,"characterCoaching":55,"teaching":78,"diagnosis":39,"rehabilitation":24,"prevention":24,"mediaHandling":55,"brandBuilding":20,"socialMediaSavvy":56,"ruleKnowledge":49,"positioning":22,"reactionSpeed":24,"consistency":23,"awareness":51,"judgement":51},"picture":"Rain.png"},{"id":1156,"name":"April Hunter","realName":"April Hunter","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":150,"height":172,"dateOfBirth":"1974-09-24T00:00:00.000Z","debut":"1999-09-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":44,"micSkills":39,"condition":70,"hardcoreAbility":49,"injuryProne":78,"ability":36,"currentAbility":24,"potentialAbility":24,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"April Hunter is an American professional wrestler, professional wrestling valet and fitness and glamour model. She has appeared in many publications, from MuscleMag International to Playboy Magazine and even has her own comic book series, Code Red by Pickle Press. In 1999 after Hunter appeared in Playboy, she was hired by World Championship Wrestling (WCW) as a member of the NWo Girls. Hunter trained to become a professional wrestler with Killer Kowalski in Boston. he was the only female in the class and soon began working on the independent circuit and overseas. Hunter formed a tag team with fellow Kowalski graduate Nikki Roxx in World Xtreme Wrestling known as The Killer Babes.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3297,3335],"staffAttributes":{"bookingLogic":42,"storytelling":46,"productFit":100,"riskTaking":34,"matchLayout":47,"psychology":42,"workerManagement":100,"trainingIntensity":42,"technicalCoaching":32,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":61,"brandBuilding":44,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":42,"consistency":49,"awareness":42,"judgement":65},"picture":"April Hunter.png"},{"id":1159,"name":"Jessie Belle","realName":"Jessie Belle","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":145,"height":172,"dateOfBirth":"1985-07-02T00:00:00.000Z","debut":"2009-09-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":44,"micSkills":65,"condition":93,"hardcoreAbility":36,"injuryProne":100,"ability":46,"currentAbility":40,"potentialAbility":43,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jessie Belle McCoy is an American model, professional wrestling valet, and professional wrestler. She is signed to TNA's developmental territory Ohio Valley Wrestling (OVW), where she performs under the ring name Jessie Belle. Jessie made her professional wrestling debut at a Firestorm event on January 8, 2010, where she lost to Sassy Stephie.","alterEgos":["Jessie Belle Smothers"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[422,3106,3109],"staffAttributes":{"bookingLogic":52,"storytelling":55,"productFit":40,"riskTaking":44,"matchLayout":56,"psychology":52,"workerManagement":40,"trainingIntensity":60,"technicalCoaching":45,"characterCoaching":45,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":45,"brandBuilding":46,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":8,"reactionSpeed":60,"consistency":71,"awareness":52,"judgement":47},"picture":"Jessie Belle.png"},{"id":1160,"name":"Amber O'Neal","realName":"Amber O'Neal","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":141,"height":170,"dateOfBirth":"1974-06-22T00:00:00.000Z","debut":"1999-07-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":35,"micSkills":56,"condition":78,"hardcoreAbility":48,"injuryProne":100,"ability":50,"currentAbility":34,"potentialAbility":36,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kimberly Dawn Davis is an American professional wrestler, better known by her ring names, Amber O'Neal and Amber Holly. She previously worked for Wrestlicious under the ring name, Charlotte, The Southern Belle. Davis got into wrestling after watching it with a friend who was a fan of Stone Cold Steve Austin. Davis initially became a fan of Sable. After researching how to get involved with the sport, Davis trained under Strawberry Fields, Leilani Kai, and Gary Royal at the Mid-Atlantic Wrestling Academy in Charlotte, North Carolina.","alterEgos":["Amber Gallows"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3107,3109],"staffAttributes":{"bookingLogic":36,"storytelling":44,"productFit":60,"riskTaking":25,"matchLayout":46,"psychology":36,"workerManagement":60,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":53,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":53,"brandBuilding":35,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":12,"reactionSpeed":73,"consistency":50,"awareness":36,"judgement":46},"picture":"Amber O'Neal.png"},{"id":1161,"name":"Sal Hamaoui","realName":"Sal Hamaoui","nickname":"","type":"writer","base":"USA","gender":"M","weight":150,"height":162,"dateOfBirth":"1973-08-17T00:00:00.000Z","debut":"2000-08-01T00:00:00.000Z","wage":500,"popularity":0,"charisma":7,"micSkills":11,"condition":100,"hardcoreAbility":3,"injuryProne":0,"ability":5,"currentAbility":3,"potentialAbility":5,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Sal Hamaoui has a lot of fingers in a lot of wrestling pies! He is helping run many companies, including FIP, DG:USA, EVOLVE, and now along with Dave Prazak, SHINE. He is also the man behind the World Wrestling Network online streaming of wrestling events.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":44,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":44,"brandBuilding":0,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Sal Hamaoui.png"},{"id":1162,"name":"Solo Darling","realName":"Solo Darling","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":130,"height":157,"dateOfBirth":"1987-02-19T00:00:00.000Z","debut":"2009-01-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":60,"micSkil