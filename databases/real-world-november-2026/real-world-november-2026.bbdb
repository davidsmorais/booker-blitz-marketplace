 Naito","realName":"Tetsuya Naito","nickname":"","type":"wrestler","promotionId":45,"base":"Japan","gender":"M","weight":224,"height":177,"dateOfBirth":"1982-06-22T00:00:00.000Z","debut":"2006-05-01T00:00:00.000Z","wage":51200,"wageType":"per-appearance","popularity":46,"charisma":67,"micSkills":73,"condition":52,"hardcoreAbility":83,"injuryProne":66,"ability":70,"currentAbility":58,"potentialAbility":60,"morale":"fair","presentation":"heel","prestige":"mid","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tetsuya Naito, who graduated from New Japan Dojo on 01 January 2005, is a Japanese wrestler who works all over the world. He is a 5'11\", 224lb worker who is classed as using a Technician style. He uses the Destino as his finisher. He is one half of Los Tranquilos de Japón alongside BUSHI. He is best known for his work with CMLL, NJPW and TNA. He is married to someone outside the wrestling business.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-312","wrestlerId":312,"promotionId":45,"startDate":"2026-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":51200,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3040,3041,3042,4219,4220,4298],"staffAttributes":{"bookingLogic":84,"storytelling":86,"productFit":100,"riskTaking":19,"matchLayout":86,"psychology":84,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":67,"characterCoaching":91,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":91,"brandBuilding":84,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":56,"awareness":84,"judgement"