":85},"picture":"Giulia.png"},{"id":3289,"name":"Lutha","realName":"Luther","nickname":"","type":"manager","promotionId":76,"base":"Canada","gender":"M","weight":251,"height":182,"dateOfBirth":"1968-10-30T00:00:00.000Z","debut":"1988-04-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":14,"charisma":49,"micSkills":55,"condition":67,"hardcoreAbility":37,"injuryProne":100,"ability":58,"currentAbility":32,"potentialAbility":34,"morale":"broken","presentation":"face","prestige":"low","style":"hardcore","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Luther is a Canadian wrestler who works in America, Canada and Japan. He is a Middleweight who is classed as using a Hardcore style. He is one half of Chaos Project alongside Eddie Cruz. He is best known for his work with AEW. He is engaged to someone outside the wrestling business.","alterEgos":["Luther","Dr. Luther","Mad Jack","Lenny St. Clair"],"birthplace":"Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3289","wrestlerId":3289,"promotionId":76,"startDate":"2020-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2250,2730,3621],"staffAttributes":{"bookingLogic":63,"storytelling":64,"productFit":100,"riskTaking":47,"matchLayout":64,"psychology":63,"workerManagement":100,"trainingIntensity":49,"technicalCoaching":38,"characterCoaching":63,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":53,"mediaHandling":63,"brandBuilding":22,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":20,"reactionSpeed":49,"consistency":59,"awareness":63,"judgement":78},"picture":"Lutha.png"},{"id":3290,"nam