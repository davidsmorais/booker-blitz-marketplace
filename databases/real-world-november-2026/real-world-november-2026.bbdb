uding the RCW and BPW Australian Championship.\r\n\r\nIn his 10 years of competition he has had notable feuds with his brother, G.D. Grimm, Damon Mathews, Freddy FuZion, The Rude Ones and more recently his former friend and long time training partner, Andy ‘Voodoo’ Roy.","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3130],"staffAttributes":{"bookingLogic":72,"storytelling":73,"productFit":100,"riskTaking":23,"matchLayout":74,"psychology":72,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":67,"characterCoaching":57,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":57,"brandBuilding":53,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":65,"awareness":72,"judgement":83},"picture":"Chris Basso.png"},{"id":2013,"name":"Damian Slater","realName":"Damian Slater","nickname":"","type":"wrestler","base":"Australia","gender":"M","weight":202,"height":177,"dateOfBirth":"1987-06-14T00:00:00.000Z","debut":"2003-05-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":70,"micSkills":74,"condition":84,"hardcoreAbility":54,"injuryProne":100,"ability":68,"currentAbility":62,"potentialAbility":66,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Damian Slater is an Australian wrestler who works in America, Japan and Oceania. He is a Lightweight who is classed as using a Technician Flyer style. He is best known for his work with WR.","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2309,3236],"staffAttributes":{"bookingLogic":67,"storytelling":71,"productFit":100,"riskTaking":13,"matchLayout":72,"psychology":67,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":70,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":87,"mediaHandling":63,"brandBuilding":47,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":73,"awareness":67,"judgement":80},"picture":"Damian Slater.png"},{"id":2014,"name":"Dean Brady","realName":"Dean Brady","nickname":"","type":"wrestler","base":"Australia","gender":"M","weight":229,"height":180,"dateOfBirth":"1996-01-08T00:00:00.000Z","debut":"2014-01-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":76,"micSkills":62,"condition":95,"hardcoreAbility":55,"injuryProne":100,"ability":70,"currentAbility":70,"potentialAbility":79,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Hailing from a prestigious athletic background Dean Brady has always been a high achiever in the sporting world. Competing in such sports as Rugby League, track and field and even martial arts, he found his home in amateur wresting. He now uses the skills he honed as an edge in his true passion of professional wrestling. Referring to himself as “The Machine” he uses his guns (arms) to “break” his opponents, whomever they may be, unafraid to hold back from any opponent regardless of size, age, gender or ability. Dean Brady will always see himself as the naturally gifted competitor to enter a wrestling wring. And you can always hear him chant “Chick, Chick, BOOM!” whenever he is near.","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3505],"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":30,"riskTaking":35,"matchLayout":64,"psychology":56,"workerMa