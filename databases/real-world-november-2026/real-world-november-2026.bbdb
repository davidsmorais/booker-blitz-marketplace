ion":70,"hardcoreAbility":62,"injuryProne":100,"ability":51,"currentAbility":28,"potentialAbility":30,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"La Bestia del Ring is a Mexican luchador who works in America and Mexico. He is a Middleweight who is classed as using a Luchador style. He is best known for his work with CMLL, AAA and ROH.","alterEgos":["Pierroth"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1194],"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":21,"matchLayout":71,"psychology":68,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":51,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":65,"brandBuilding":55,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":72,"awareness":68,"judgement":81},"picture":"La Bestia Del Ring.png"},{"id":2209,"name":"La Comandante","realName":"La Comandante","nickname":"","type":"manager","promotionId":11,"base":"Mexico","gender":"F","weight":198,"height":172,"dateOfBirth":"1978-04-23T00:00:00.000Z","debut":"1996-02-01T00:00:00.000Z","wage":32000,"wageType":"per-appearance","popularity":3,"charisma":52,"micSkills":54,"condition":43,"hardcoreAbility":43,"injuryProne":100,"ability":60,"currentAbility":45,"potentialAbility":45,"morale":"broken","presentation":"heel","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"La Comandante began her career working under the ring name La Nazi (The Nazi), inspired by El Nazi, a hated Mexican rudo. Her early days as a professional wrestler was tough, she was met with a lot of resistance with people complaining that she was too rough in the ring, not protecting her opponents enough while wrestling. Her reputation for working \"stiff\", as it is called in wrestling, made it so hard for her to get work that she retired in the late 1990s. She did not return to full-time wrestling until she met wrestler Pierroth, Jr. who helped her improve in the ring and get regular work as well.","alterEgos":["La Nazi"],"birthplace":"Ecatepec, State of Mexico, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2209","wrestlerId":2209,"promotionId":11,"startDate":"2005-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":55,"storytelling":59,"productFit":100,"riskTaking":37,"matchLayout":60,"psychology":55,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":44,"characterCoaching":56,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":56,"brandBuilding":31,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":64,"awareness":55,"judgement":73},"picture":"La Comandante.png"},{"id":2210,"name":"La Seductora","realName":"La Seductora","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":139,"height":160,"dateOfBirth":"1973-10-20T00:00:00.000Z","debut":"1992-09-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":38,"micSkills":64,"condition":68,"hardcoreAbility":40,"injuryProne":100,"ability":58,"currentAbility":38,"potentialAbility":38,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Irene Lagunas s a Mexican luchadora better known under the ring name La Seductora. The woman known as \"La Seductora\" began training for a professional wrestling career in 1992 under Chico Hernández, who also coined the ring name \"La Seductora\", to go with her personality of being both charming and evil in the ring. Her career was put on hold for a number of years to have children, but once her two girls were old enough she returned to the ring, competing for Consejo Mundial de Lucha Libre (CMLL).","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":63,"productFit":100,"riskTaking":23,"matchLayout":65,"psychology":58,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":47,"characterCoaching":47,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":47,"brandBuilding":38,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":71,"awareness":58,"judgement":75},"picture":"La Seductora.png"},{"id":2211,"name":"La Vaquerita","realName":"La Vaquerita","nickname":"","type":"referee","promotionId":11,"base":"Mexico","gender":"F","weight":123,"height":152,"dateOfBirth":"1978-05-16T00:00:00.000Z","debut":"1993-06-01T00:00:00.000Z","wage":32000,"wageType":"per-appearance","popularity":3,"charisma":49,"micSkills":53,"condition":73,"hardcoreAbility":52,"injuryProne":100,"ability":61,"currentAbility":46,"potentialAbility":46,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"La Vaquerita is the ring name of a Mexican luchadora enmascarada  currently working for the Mexican professional wrestling promotion CMLL. She was the first holder of the Lucha POP Women's Championship and made her debut for CMLL in late 2012. La Vaquerita became interested in lucha libre by pure chance, passing by Arena Coliseo in her native Guadalajara, Jalisco she noticed that they had female wrestlers on the card and became interested. She went to renowned wrestling trainer Diablo Velasco who lived in Guadalajara and got accepted into his wrestling school. According to Vaquerita she was the last female wrestler to be trained by Diablo Velasco before he retired in 1997.","alterEgos":[],"birthplace":"Guadalajara, Jalisco, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2211","wrestlerId":2211,"promotionId":11,"startDate":"2013-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":65,"storytelling":69,"productFit":100,"riskTaking":26,"matchLayout":70,"psychology":65,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":54,"characterCoaching":44,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":44,"brandBuilding":49,"socialMediaSavvy":34,"ruleKnowledge":55,"positioning":64,"reactionSpeed":65,"consistency":62,"awareness":65,"judgement":79},"picture":"Vaquerita.png"},{"id":2213,"name":"Estrella Divina","realName":"Estrella Divina","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":145,"height":177,"dateOfBirth":"1994-09-20T00:00:00.000Z","debut":"2011-03-01T00:00:00.000Z","wage":4166,"popularity":4,"charisma":51,"micSkills":44,"condition":93,"hardcoreAbility":64,"injuryProne":96,"ability":57,"currentAbility":57,"potentialAbility":65,"morale":"broken","presentation":"face","