 works for AAA in Mexico as a commentator.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":66,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":66,"brandBuilding":0,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Andres Maronas.png"},{"id":1422,"name":"GENTARO","realName":"GENTARO","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":198,"height":172,"dateOfBirth":"1974-10-28T00:00:00.000Z","debut":"1999-05-01T00:00:00.000Z","wage":3000,"popularity":2,"charisma":67,"micSkills":69,"condition":75,"hardcoreAbility":80,"injuryProne":89,"ability":76,"currentAbility":51,"potentialAbility":53,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Gentaro Takahashi s a Japanese professional wrestler, better known by the ring name Gentaro (stylized in all capital letters). Though officially affiliated with the Freedoms promotion, Gentaro also works for several other independent promotions, including Dramatic Dream Team, Kaientai Dojo and women's wrestling promotion Ice Ribbon, where he works mainly as the lead play-by-play announcer. Takahashi also makes sporadic appearances as the character Benten (also stylized in all capital letters).","alterEgos":["Madness Tiger","Blue Onigumo"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":7