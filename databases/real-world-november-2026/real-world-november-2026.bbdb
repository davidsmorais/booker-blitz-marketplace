5,"micSkills":67,"condition":88,"hardcoreAbility":78,"injuryProne":100,"ability":71,"currentAbility":57,"potentialAbility":59,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Pirata Morgan Jr. is a Mexican luchador enmascarado. Pirata Morgan, Jr.'s real name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans. He is the son of professional wrestler Pedro Ortiz Villanueva, better known as Pirata Morgan, and not a fictional family relationship as it sometimes the case in Lucha Libre.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1203],"staffAttributes":{"bookingLogic":64,"storytelling":67,"productFit":61,"riskTaking":22,"matchLayout":68,"psychology":64,"workerManagement":61,"trainingIntensity":62,"technicalCoaching":47,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":62,"brandBuilding":46,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":12,"reactionSpeed":62,"consistency":69,"awareness":64,"judgement":63},"picture":"Pirata Morgan Jr.png"},{"id":1045,"name":"Hijo de Pirata Morgan","realName":"Hijo de Pirata Morgan","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":176,"height":167,"dateOfBirth":"1992-02-28T00:00:00.000Z","debut":"2005-03-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":58,"micSkills":47,"condition":90,"hardcoreAbility":64,"injuryProne":100,"ability":65,"currentAbility":64,"potentialAbility":71,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Antheus Ortiz Chávez, better known under the ring name Hijo de Pirata Morgan is a Mexican luchador. Hijo de Pirata Morgan's real name was not a matter of public record until March 16, 2013 where he lost his wrestling mask and had to reveal his real name. This is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans while they are masked. He is legitimately the son of professional wrestler Pedro Ortiz Villanueva, better known as Pirata Morgan, and not a storyline family relationship as it sometimes the case in Lucha Libre.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1203],"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit":100,"riskTaking":27,"matchLayout":61,"psychology":56,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":56,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":64,"brandBuilding":43,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":66,"awareness":56,"judgement":74},"picture":"Hijo Pirata Morgan.png"},{"id":1047,"name":"QT Marshall","realName":"QT Marshall","nickname":"","type":"trainer","promotionId":76,"base":"USA","gender":"M","weight":234,"height":180,"dateOfBirth":"1985-07-16T00:00:00.000Z","debut":"2004-07-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":24,"charisma":79,"micSkills":94,"condition":88,"hardcoreAbility":92,"injuryProne":100,"ability":77,"currentAbility":67,"potentialAbility":70,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"QT Marshall is an American wrestler who works exclusively in North America. He is a Lightweight who is classed as using a Regular style. He is best known for his work with AEW, AAA, ROH, NJoA, PROGRESS and AAW.","alterEgos":[],"birthplace":"Livingston, New Jersey, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1047","wrestlerId":1047,"promotionId":76,"startDate":"2024-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1218,1989,2741,4363,4364],"staffAttributes":{"bookingLogic":30,"storytelling":53,"productFit":60,"riskTaking":31,"matchLayout":56,"psychology":27,"workerManagement":28,"trainingIntensity":55,"technicalCoaching":75,"characterCoaching":57,"teaching":77,"diagnosis":58,"rehabilitation":39,"prevention":49,"mediaHandling":43,"brandBuilding":43,"socialMediaSavvy":38,"ruleKnowledge":58,"positioning":51,"reactionSpeed":21,"consistency":58,"awareness":51,"judgement":21},"picture":"QT Marshall_alt1.png"},{"id":1048,"name":"Silas Young","realName":"Silas Young","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":220,"height":177,"dateOfBirth":"1979-08-09T00:00:00.000Z","debut":"1998-08-01T00:00:00.000Z","wage":37500,"popularity":8,"charisma":63,"micSkills":57,"condition":87,"hardcoreAbility":51,"injuryProne":100,"ability":64,"currentAbility":49,"potentialAbility":61,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"According to Silas Young, he’s the “Last Real Man in Professional Wrestling.” There are plenty of competitors in Ring of Honor who would take issue with that claim, but there’s no denying that Young is one of the toughest and most talented wrestlers in the sport.\r\n\r\nYoung, who competed in the 2013 Top Prospect Tournament, won the 2016 Honor Rumble and scored the biggest victory of his career to that point by defeating former ROH World Champion Jay Lethal in a Last Man Standing Match at Supercard of Honor XI in 2017. Young captured his first title in ROH when he defeated Kenny King, Punishment Martinez and Shane Taylor in a Four Corner Survival Match for the ROH World Television Title at Final Battle 2017.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[970,1953],"staffAttributes":{"bookingLogic":67,"storytelling":71,"productFit":100,"riskTaking":29,"matchLayout":72,"psychology":67,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":47,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":63,"brandBuilding":65,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":73,"awareness":67,"judgement":80},"picture":"Silas Young.png"},{"id":1049,"name":"Eva Marie","realName":"Eva Marie","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":125,"height":170,"dateOfBirth":"1984-09-19T00:00:00.000Z","debut":"2013-05-01T00:00:00.000Z","wage":37500,"popularity":32,"charisma":21,"micSkills":27,"condition":94,"hardcoreAbility":28,"injuryProne":100,"ability":36,"currentAbility":31,"potentialAbility":34,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"A former model that traded in the runway for the wrestling ring, Eva Marie’s journey through the ranks of WWE’s Divas division was first chronicled on the hit E! reality series, Total Divas. There, she navigated personal and professional obstacles in an attempt to become the face of the division. When she finally got to the big time, Eva Marie made an immediate impact, slapping Jerry “The King” Lawler across the face in her first appearance on Raw. This red-headed wonder hasn’t stopped for a single second since that day, and she hasn’t cared who she polarizes in the process. Stirring up controversy on Total Divas didn’t even stop her from training independently with former WWE Tag Team Champion “The” Brian Kendrick for a career-altering run down in WWE NXT that is just beginning to bear fruit. Career-altering, that is, both for her and anyone who thinks this red-headed runway vet is anything resembling a pushover.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":38,"storytelling":41,"productFit":25,"riskTaking":36,"matchLayout":42,"psychology":38,"workerManagement":25,"trainingIntensity":59,"technicalCoaching":27,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":73,"brandBuilding":80,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":5,"reactionSpeed":59,"consistency":52,"awareness":38,"judgement":33},"picture":"Eva Marie_alt2.png"},{"id":1051,"name":"Harlem Bravado","realName":"Harlem Bravado","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":222,"height":185,"dateOfBirth":"1989-04-22T00:00:00.000Z","debut":"2008-04-01T00:00:00.000Z","wage":37500,"popularity":21,"charisma":50,"micSkills":46,"condition":91,"hardcoreAbility":59,"injuryProne":100,"ability":60,"currentAbility":56,"potentialAbility":71,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Welcome to Andre Chase University! Take notes. The up-and coming Andre Chase has looked to impose painful education on both NXT and 205 Live, as well as competed in the 2021 NXT Breakout Tournament. Overall, Chase is a quick-thinking Superstar with a strong intellect that gives him the ability to use his environment to his advantage against any opponent and unleash a calculating offense that includes maneuvers like the excruciating STF.","alterEgos":["Andre Chase"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[4027],"staffAttributes":{"bookingLogic":64,"storytelling":68,"productFit":100,"riskTaking":20,"matchLayout":69,"psychology":64,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":68,"brandBuilding":36,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":83,"awareness":64,"judgement":78},"picture":"Harlem Bravado_alt2.png"},{"id":1053,"name":"Thom Latimer","realName":"Thom Latimer","nickname":"","type":"wrestler","promotionId":79,"base":"UK","gender":"M","weight":238,"height":187,"dateOfBirth":"1986-08-06T00:00:00.000Z","debut":"2002-08-01T00:00:00.000Z","wage":32800,"wageType":"per-appearance","popularity":18,"charisma":69,"micSkills":64,"condition":82,"hardcoreAbility":71,"injuryProne":100,"ability":56,"currentAbility":50,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"upper","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Thom Latimer is an English wrestler who works in the USA, Canada, Mexico, the British Isles and Japan. He is a 6'3\", 238lb worker who is classed as using a Brawler style. He uses the Curb Stomp and the Velvet Noise as his finishers. He is best known for his work with TNA, NWA and MLP. He is currently the NWA World's Heavyweight champion. He is married to Kamille.","alterEgos":["Bram"],"birthplace":"England","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1053","wrestlerId":1053,"promotionId":79,"startDate":"2019-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32800,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1378,1416,1927],"staffAttributes":{"bookingLogic":57,"storytelling":62,"productFit":100,"riskTaking":30,"matchLayout":64,"psychology":57,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":42,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":68,"brandBuilding":73,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":70,"awareness":57,"judgement":74},"picture":"Bram.png"},{"id":1055,"name":"Serpentico","realName":"Jon Cruz","nickname":"","type":"wrestler","promotionId":49,"base":"USA","gender":"M","weight":174,"height":165,"dateOfBirth":"1984-02-23T00:00:00.000Z","debut":"2007-07-01T00:00:00.000Z","wage":16400,"wageType":"per-appearance","popularity":11,"charisma":52,"micSkills":54,"condition":81,"hardcoreAbility":71,"injuryProne":100,"ability":63,"currentAbility":54,"potentialAbility":57,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Jon Cruz is a Puerto Rican wrestler who works in America and Mexico. He is a Lightweight who is classed as using a Luchador style. He is best known for his work with AEW. He is married to Skyler Moore.","alterEgos":["Jon Cruz"],"birthplace":"Bayamón, Puerto Rico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1055","wrestlerId":1055,"promotionId":49,"startDate":"2023-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":16400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2250,2716,3621,3981,3982],"staffAttributes":{"bookingLogic":70,"storytelling":71,"productFit":100,"riskTaking":23,"matchLayout":71,"psychology":70,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":55,"characterCoaching":60,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":60,"brandBuilding":28,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":80,"awareness":70,"judgement":82},"picture":"Serpentico.png","additionalContracts":[{"id":"tew-contract-1055-76","wrestlerId":1055,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW"]},{"id":1056,"name":"Larry Dallas","realName":"Larry Dallas","nickname":"","type":"commentator","base":"USA","gender":"M","weight":215,"height":170,"dateOfBirth":"1984-10-21T00:00:00.000Z","debut":"2009-10-01T00:00:00.000Z","wage":66000,"popularity":1,"charisma":25,"micSkills":21,"condition":96,"hardcoreAbility":16,"injuryProne":96,"ability":15,"currentAbility":13,"potentialAbility":16,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Larry Dallas is an American man who works as a colour commentator and a manager.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":29,"storytelling":36,"productFit":40,"riskTaking":53,"matchLayout":38,"psychology":29,"workerManagement":40,"trainingIntensity":67,"technicalCoaching":31,"characterCoaching":66,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":47,"mediaHandling":66,"brandBuilding":33,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":8,"reactionSpeed":67,"consistency":47,"awareness":29,"judgement":33},"picture":"Larry Dallas.png"},{"id":1057,"name":"Jon Davis","realName":"Jon Davis","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":255,"height":180,"dateOfBirth":"1979-08-17T00:00:00.000Z","debut":"2003-06-01T00:00:00.000Z","wage":37500,"popularity":8,"charisma":60,"micSkills":61,"condition":86,"hardcoreAbility":46,"injuryProne":100,"ability":56,"currentAbility":43,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jon Davis is an American professional wrestler, working for independent promotions including Dragon Gate USA, Full Impact Pro, and Evolve. Davis is a two-time former NWA World Tag Team Champion and a former NWA Florida Tag Team Champion as part of the Dark City Fight Club with Kory Chavis. Davis was trained by Chris Turner and Dory Funk, Jr., and made his professional wrestling debut on June 23, 2003. In late 2005, Davis began wrestling for Funk's !Bang! promotion. In March 2008, Davis teamed with up Kory Chavis as the Dark City Fight Club (DCFC) in Full Impact Pro (FIP).","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2996,3408],"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit":100,"riskTaking":26,"matchLayout":62,"psychology":56,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":64,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":61,"brandBuilding":38,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":76,"awareness":56,"judgement":74},"picture":"Jon Davis.png"},{"id":1058,"name":"Corey Hollis","realName":"Corey Hollis","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":189,"height":167,"dateOfBirth":"1989-01-10T00:00:00.000Z","debut":"2009-03-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":71,"micSkills":45,"condition":90,"hardcoreAbility":43,"injuryProne":100,"ability":53,"currentAbility":50,"potentialAbility":50,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Corey Hollis was an American wrestler who has since left the business. He had regular tag teams with Mike Posey (Alabama Attitude), Adam Page (Country Jacked) and John Skyler (Bruiserweights). He is best known for his work with AEW, NXT and ROH. He is married to someone outside the wrestling business.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[327,652,1591],"staffAttributes":{"bookingLogic":66,"storytelling":68,"productFit":100,"riskTaking":20,"matchLayout":69,"psychology":66,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":61,"characterCoaching":48,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":48,"brandBuilding":38,"socialMediaSavvy":42,"ruleKnowledge":0,"positio