rCoaching":27,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":27,"brandBuilding":12,"socialMediaSavvy":16,"ruleKnowledge":89,"positioning":71,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Daichi Murayama.png"},{"id":863,"name":"Masahiro Chono","realName":"Masahiro Chono","nickname":"","type":"trainer","base":"Japan","gender":"M","weight":211,"height":182,"dateOfBirth":"1963-09-17T00:00:00.000Z","debut":"1984-10-01T00:00:00.000Z","wage":66000,"popularity":19,"charisma":87,"micSkills":95,"condition":67,"hardcoreAbility":100,"injuryProne":99,"ability":96,"currentAbility":46,"potentialAbility":46,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Masahiro Chono, is a Japanese professional wrestler. He primarily wrestled for New Japan Pro Wrestling (NJPW), but has also made appearances for the now defunct World Championship Wrestling, as a member of the New World Order. Chono, called Mister Black Jack when he first started as a villain, is one of the top villains in Japanese wrestling history. He is a former NWA World Champion and IWGP Heavyweight Champion. In January 2013, Chono signed with All Japan Pro Wrestling as an advisor.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2977,3056,3240],"staffAttributes":{"bookingLogic":45,"storytelling":57,"productFit":59,"riskTaking":53,"matchLayout":42,"psychology":56,"workerManagement":30,"trainingIntensity":81,"technicalCoaching":70,"characterCoaching":84,"teaching":86,"diagnosis":59,"rehabilitation":57,"prevention":31,"mediaHandling":58,"brandBuilding":27,"socialMediaSavvy":48,"ruleKnowledge":36,"positioning":29,"reactionSpeed":53,"consistency":42,"awareness":41,"judgement":22},"picture":"Masahiro Chono.png"},{"id":864,"name":"Akira Nogami","realName":"Akira Nogami","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":198,"height":177,"dateOfBirth":"1966-03-13T00:00:00.000Z","debut":"1984-10-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":62,"micSkills":54,"condition":70,"hardcoreAbility":83,"injuryProne":100,"ability":67,"currentAbility":35,"potentialAbility":37,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Akira Nogami is a Japanese professional wrestler and actor, currently working as AKIRA. He is signed to Wrestling New Classic (WNC), where he was the inaugural WNC Champion. After graduating from high school in 1984, Nogami was initiated into the New Japan dojo. He debuted in October of that year against Keiji Mutoh, making him one of the youngest wrestlers in New Japan history, at the age of 16. After leaving NJPW, Nogami found a new home in Yoshihiro Tajiri's Smash promotion, where he worked as a member of the Smash Seikigun until the promotion folded on March 14, 2012.","alterEgos":["AKIRA"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2792,3035,3058],"staffAttributes":{"bookingLogic":68,"storytelling":74,"productFit":100,"riskTaking":34,"matchLayout":76,"psychology":68,"workerManagement":100,"trainingIntensity":60,"technicalCoaching":63,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":64,"brandBuilding":33,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":60,"consistency":62,"awareness":68,"judgement":81},"picture":"AKIRA Nogami_alt.png"},{"id":865,"name":"Angelina Love","realName":"Angelina Love","nickname":"","type":"wrestler","base":"Canada","gender":"F","weight":122,"height":165,"dateOfBirth":"1981-09-13T00:00:00.000Z","debut":"2000-08-01T00:00:00.000Z","wage":37500,"popularity":17,"charisma":61,"micSkills":43,"condition":77,"hardcoreAbility":38,"injuryProne":100,"ability":51,"currentAbility":41,"potentialAbility":53,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Angelina Love is a Canadian wrestler who works in America, Canada, the British Isles and India. She is a Small worker who is classed as using a Regular style. She is best known for her work with IMPACT, NWA and ROH.","alterEgos":[],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1383,2521,2644,3700,3701],"staffAttributes":{"bookingLogic":57,"storytelling":61,"productFit":100,"riskTaking":26,"matchLayout":62,"psychology":57,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":36,"characterCoaching":77,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":77,"brandBuilding":63,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":78,"awareness":57,"judgement":74},"picture":"Angelina Love.png"},{"id":867,"name":"Bobby Lashley","realName":"Bobby Lashley","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":273,"height":187,"dateOfBirth":"1976-07-16T00:00:00.000Z","debut":"2004-11-01T00:00:00.000Z","wage":80000,"wageType":"monthly","popularity":53,"charisma":81,"micSkills":81,"condition":77,"hardcoreAbility":66,"injuryProne":100,"ability":63,"currentAbility":63,"potentialAbility":85,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Looking for credentials? The dominant Bobby Lashley is a three-time wrestling national champion and a four-time wrestling All-American. He's also a two-time Armed Forces Champion and took home the silver medal in the 2002 CISM World Championships, competing against the best of the rest of the world's military. \r\n\r\nYet, for Lashley, all that was a precursor to training for WWE. First coming to the squared circle through WWE's ECW brand, Lashley fought his way to becoming one of the final ECW Champions. He then joined Raw, where he continued to make an impact that included a hard-hitting reign as United States Champion and a key role in the legendary \"Battle of the Billionaires\" at WrestleMania 23 where he took on Mr. McMahon's representative Umaga and was chiefly responsible for the WWE Chairman being shaved bald.","alterEgos":[],"birthplace":"Junction City, Kansas, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-867","wrestlerId":867,"promotionId":76,"startDate":"2024-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":80000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[4281],"staffAttributes":{"bookingLogic":69,"storytelling":71,"productFit":100,"riskTaking":22,"matchLayout":72,"psychology":69,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":57,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":65,"brandBuilding":84,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":76,"awareness":69,"judgement":81},"picture":"Bobby Lashley.png"},{"id":869,"name":"Ivelisse","realName":"Ivelisse Vélez","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":115,"height":160,"dateOfBirth":"1988-09-21T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","wage":4166,"popularity":7,"charisma":67,"micSkills":75,"condition":77,"hardcoreAbility":85,"injuryProne":100,"ability":57,"currentAbility":57,"potentialAbility":62,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ivelisse Milagro Vélez is an American professional wrestler In 2011, she was a stand-out contestant on WWE Tough Enough, but was eliminated from the competition due to injury. Puerto Rico (2004-2011) Vélez began her wrestling career at the age of fifteen Puerto Rico. Soon after, she debuted in the World Wrestling Council, and subsequently wrestled in the International Wrestling Association. WWE signed her in November 2011 and Vélez adopted the ring name Sofia Cortez as she appeared in WWE's developmental territory Florida Championship Wrestling as well as WWE NXT. Vélez was released from the WWE in August 2012. On July 7th 2013, Ivelisse faced fellow Perros del Mal member Taya Valkyrie in a singles match.","alterEgos":["Ivelisse Vélez","Sofia Cortez"],"birthplace":"Puerto Rico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3338],"staffAttributes":{"bookingLogic":57,"storytelling":63,"productFit":100,"riskTaking":27,"matchLayout":65,"psychology":57,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":58,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":66,"brandBuilding":61,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":66,"awareness":57,"judgement":74},"picture":"Ivelisse Velez_alt2.png"},{"id":871,"name":"Justin Credible","realName":"Justin Credible","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":240,"height":180,"dateOfBirth":"1973-10-16T00:00:00.000Z","debut":"1992-10-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":51,"micSkills":43,"condition":95,"hardcoreAbility":53,"injuryProne":100,"ability":43,"currentAbility":28,"potentialAbility":30,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Peter Joseph Polaco is an American professional wrestler. Polaco traveled to Canada in order to train at the famous Hart Dungeon in Calgary, Alberta with Stu Hart, Keith Hart, and his future tag team partner, Lance Storm. He is best known for his appearances with the World Wrestling Federation under the ring name Aldo Montoya and with Extreme Championship Wrestling under the ring name Justin Credible. Has recently wrestled as \"Justin Time\" and PJ Polaco, as WWE owns the Justin Credible name. In WWF/E, he was a 8 time WWF/E Hardcore Champion. In ECW, he was a 1 time World Heavyweight Champion and a 2 time Tag Team Champion with Lance Storm.","alterEgos":["Justin Time","Aldo Montoya"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[282],"staffAttributes":{"bookingLogic":51,"storytelling":57,"productFit":100,"riskTaking":33,"matchLayout":59,"psychology":51,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":27,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":67,"brandBuilding":31,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":51,"awareness":51,"judgement":71},"picture":"Justin Credible.png"},{"id":872,"name":"Jody Fleisch","realName":"Jody Fleisch","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":154,"height":175