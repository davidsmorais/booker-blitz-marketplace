at lighthearted competitor, but he has flashed a scary new mean streak during submission victories against the likes of Velveteen Dream, Timothy Thatcher and Tony Nese.","alterEgos":[],"birthplace":"Ōta, Tokyo, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-331","wrestlerId":331,"promotionId":38,"startDate":"2022-07-03T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":80000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1535,2811,3318,3668,3669,3671,3887,4207],"staffAttributes":{"bookingLogic":73,"storytelling":77,"productFit":100,"riskTaking":24,"matchLayout":78,"psychology":73,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":80,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":61,"brandBuilding":67,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":67,"awareness":73,"judgement":84},"picture":"KUSHIDA.png"},{"id":332,"name":"Alex Shelley","realName":"Alex Shelley","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":215,"height":175,"dateOfBirth":"1983-05-23T00:00:00.000Z","debut":"2002-03-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":38,"charisma":70,"micSkills":92,"condition":69,"hardcoreAbility":78,"injuryProne":90,"ability":72,"currentAbility":72,"potentialAbility":85,"morale":"fair","presentation":"face","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Alex Shelley has been entertaining fans in Ring of Honor with his unique offense for more than a decade. The enigmatic Detroit native initially made his mark in ROH in 2004 as part of the controversial Generation Next. Shelley later was a member of The Embassy, a group guided by Prince Nana.\r\n \r\nShelley found his greatest success after forming Motor City Machine Guns with Chris Sabin. They began teaming in ROH in 2007 and have established themselves as one of the best tag teams of the past decade. After winning championships in various promotions in the U.S. and Japan, including the prestigious IWGP Junior Heavyweight Tag Team Titles, Shelley and Sabin finally captured the ROH World Tag Team Titles in 2017, defeating The Young Bucks.","alterEgos":[],"birthplace":"Detroit, Michigan, United States","managerId":0,"contractExpiryDate":"2026-08-23T00:00:00.000Z","contract":{"id":"tew-contract-332","wrestlerId":332,"promotionId":76,"startDate":"2026-07-30T00:00:00.000Z","endDate":"2026-08-23T00:00:00.000Z","wage":60000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1234,1235,1270,1420,1535,2811,3690,3792,3887,3958,4040,4041],"staffAttributes":{"bookingLogic":78,"storytelling":81,"productFit":100,"riskTaking":19,"matchLayout":82,"psychology":78,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":78,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":76,"brandBuilding":67,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":79,"awareness":78,"judgement":87},"picture":"Alex Shelley.png"},{"id":333,"name":"BUSHI","realName":"BUSHI","nickname":"","type":"wrestler","promotionId":45,"base":"Japan","gender":"M","weight":183,"height":170,"dateOfBirth":"1983-04-05T00:00:00.000Z","debut":"2007-03-01T00:00:00.000Z","wage":51200,"wageType":"per-appearance","popularity":22,"charisma":56,"micSkills":49,"condition":74,"hardcoreAbility":63,"injuryProne":100,"ability":50,"currentAbility":42,"potentialAbility":45,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"BUSHI, who graduated from AJPW Dojo on 01 March 2007, is a masked Japanese wrestler who works in Mexico and Japan. He is a 5'8\", 183lb worker who is classed as using a Technician Flyer style. He uses the Firebird Splash and the MX as his finishers. He is one half of Los Tranquilos de Japón alongside Tetsuya Naito. He is best known for his work with CMLL, NJPW, AJPW and RevPro.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-333","wrestlerId":333,"promotionId":45,"startDate":"2026-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":51200,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1785,2185,4219,4220,4298],"staffAttributes":{"bookingLogic":57,"storytelling":63,"productFit":100,"riskTaking":22,"matchLayout":65,"psychology":57,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":56,"characterCoaching":61,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":61,"brandBuilding":57,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":55,"awareness":57,"judgement":74},"picture":"BUSHI_alt1.png"},{"id":334,"name":"El Desperado","realName":"El Desperado","nickname":"","type":"wrestler","promotionId":38,"base":"Japan","gender":"M","weight":198,"height":175,"dateOfBirth":"1983-12-29T00:00:00.000Z","debut":"2010-03-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":26,"charisma":83,"micSkills":90,"condition":91,"hardcoreAbility":71,"injuryProne":100,"abi