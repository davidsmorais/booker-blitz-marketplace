obs":[],"titles":[]},"teams":[1492,2823,2824],"staffAttributes":{"bookingLogic":86,"storytelling":88,"productFit":100,"riskTaking":25,"matchLayout":88,"psychology":86,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":74,"characterCoaching":56,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":56,"brandBuilding":58,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":95,"awareness":86,"judgement":92},"picture":"Sara Del Ray.png"},{"id":222,"name":"Corey Graves","realName":"Corey Graves","nickname":"","type":"commentator","promotionId":64,"base":"USA","gender":"M","weight":208,"height":182,"dateOfBirth":"1984-02-24T00:00:00.000Z","debut":"2000-03-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":25,"charisma":77,"micSkills":85,"condition":71,"hardcoreAbility":90,"injuryProne":100,"ability":70,"currentAbility":60,"potentialAbility":60,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Matt Polinsky is an American professional wrestler, better known by his ring name Sterling James Keenan. Polinsky chose his ring name the night before his first professional wrestling match, and picked the name \"Sterling James Keenan\" as a tribute to Sterling Sharpe, Polinsky's favorite American football player as a child, and Maynard James Keenan of the band Tool. Throughout his career, Keenan has made appearances for NWA Upstate, Independent Wrestling Association Mid-South, Cleveland All-Pro Wrestling, and Full Throttle Wrestling. Keenan debuted in the International Wrestling Cartel (IWC) on October 19, 2002, defeating Troy Lords. Keenan made his debut for the United Kingdom-based 1 Pro Wrestling (1PW) at their inaugural show, A Cruel Twist of Fate, on October 1, 2005, defeating D'Lo Brown. In August 2011, it was reported that Polinksy had signed a developmental contract with WWE.","alterEgos":["Sterling James Keenan"],"birthplace":"Pittsburgh, Pennsylvania, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-222","wrestlerId":222,"promotionId":64,"startDate":"2025-06-16T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":64,"storytelling":67,"productFit":100,"riskTaking":22,"matchLayout":68,"psychology":64,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":53,"characterCoaching":75,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":60,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":73,"awareness":64,"judgement":78},"picture":"Corey Graves.png"},{"id":223,"name":"Steve Keirn","realName":"Steve Keirn","nickname":"","type":"writer","base":"USA","gender":"M","weight":215,"height":180,"dateOfBirth":"1951-09-10T00:00:00.000Z","debut":"1972-09-01T00:00:00.000Z","wage":66000,"popularity":12,"charisma":93,"micSkills":77,"condition":77,"hardcoreAbility":76,"injuryProne":89,"ability":86,"currentAbility":39,"potentialAbility":39,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Stephen Paul \"Steve\" Keirn is an American retired professional wrestler. He is best known for being part of the tag team The Fabulous Ones, with Stan Lane, and later for a run in the World Wrestling Federation (WWF) as Skinner, a gimmick that portrayed him as a tobacco spitting alligator hunter from the Everglades. Since the late 1980s, Keirn has run a school to train wrestlers. Originally located in Tampa, Florida, Keirn's \"Professional Wrestling School of Hard Knocks\" is now located in Brandon, Florida. Keirn helped train many wrestlers, including Mike Awesome, Dennis Knight, Joe \"Destiny\" Clapp, Diamond Dallas Page, Dustin Rhodes and Tracy Smothers. The school has since been incorporated into the WWE's developmental territory, NXT Wrestling.","alterEgos":["Doink the Clown","Skinner"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3121],"staffAttributes":{"bookingLogic":68,"storytelling":76,"productFit":100,"riskTaking":25,"matchLayout":79,"psychology":68,"workerManagement":100,"trainingIntensity":35,"technicalCoaching":30,"characterCoaching":49,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":49,"brandBuilding":40,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":35,"consistency":41,"awareness":68,"judgement":81},"picture":"Steve Keirn.png"},{"id":224,"name":"Terry Taylor","realName":"Terry Taylor","nickname":"","type":"writer","promotionId":65,"base":"USA","gender":"M","weight":225,"height":182,"dateOfBirth":"1955-08-12T00:00:00.000Z","debut":"1979-08-01T00:00:00.000Z","wage":20500,"wageType":"monthly","popularity":9,"charisma":80,"micSkills":80,"condition":55,"hardcoreAbility":91,"injuryProne":93,"ability":86,"currentAbility":39,"potentialAbility":39,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":true,"story":"Paul Worden Taylor III is a retired American professional wrestler better known by his ring name Terry Taylor and for his time in National Wrestling Alliance, World Championship Wrestling and World Wrestling Federation. Terry Taylor was a popular fan favorite for much of his early career in the Mid-South region, as well as the Mid-Atlantic in the 1980s. Taylor was originally selected to be part of The Fabulous Ones tag team with Stan Lane, but that role went to Florida wrestler, Steve Keirn. Taylor then formed a tag team with Bobby Fulton called the Fantastic Ones. In 2012, Taylor was resigned by WWE to work as a trainer in its developmental territory NXT Wrestling.","alterEgos":["Red Rooster"],"birthplace":"Greenville, South Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-224","wrestlerId":224,"promotionId":65,"startDate":"2012-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":63,"storytelling":69,"productFit":100,"riskTaking":34,"matchLayout":71,"psychology":63,"workerManagement":100,"trainingIntensity":35,"technicalCoaching":16,"characterCoaching":53,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":53,"brandBuilding":40,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":35,"consistency":69,"awareness":63,"judgement":78},"picture":"Terry Taylor_alt1.png"},{"id":225,"name":"Taylor Rotunda","realName":"Taylor Rotunda","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":224,"height":182,"dateOfBirth":"1990-05-25T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","wage":37500,"popularity":43,"charisma":58,"micSkills":58,"condition":92,"hardcoreAbility":50,"injuryProne":98,"ability":58,"currentAbility":58,"potentialAbility":84,"morale":"fair","presentation":"face","prestige":"mid","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Bo Dallas Bo-lieves he was born to be a star, and based on his unbreakable spirit, he’ll have no problem achieving his dream. A former NXT Champion, this grinning grappler sports an impressive array of in-ring maneuvers, including his signature Running Tornado \"Bo-Dog.\" His impact extends beyond the ropes, however, with his moving messages for the WWE Universe, opponents and anyone who will listen. The sky is the limit for this self-proclaimed success story. Hitting the main roster after weeks of inspirational vignettes urging the WWE Universe to reach for the stars and follow their dreams, it was Bo-Time. Making his WWE ring debut on the May 23, 2014 edition of SmackDown, Dallas didn’t disappoint, beginning his WWE career with an impressive winning streak.","alterEgos":["Bo Dallas","Uncle Howdy"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1500,1612],"staffAttributes":{"bookingLogic":57,"storytelling":60,"productFit":100,"riskTaking":24,"matchLayout":61,"psychology":57,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":46,"characterCoaching":75,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":75,"brandBuilding":50,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":62,"awareness":57,"judgement":74},"picture":"Bo Dallas_alt6.png"},{"id":226,"name":"Angelo Dawkins","realName":"Angelo Dawkins","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":260,"height":193,"dateOfBirth":"1990-07-24T00:00:00.000Z","debut":"2012-06-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":46,"charisma":75,"micSkills":66,"condition":85,"hardcoreAbility":83,"injuryProne":100,"ability":61,"currentAbility":61,"potentialAbility":67,"morale":"fair","presentation":"face","prestige":"mid","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Angelo Dawkins is a proven success story when it comes to athletic achievements. During his collegiate days, this multifaceted competitor captured national titles in three sports: football, wrestling and track. Dawkins credits his previous athletic accomplishments to his highly competitive nature and distinct ability to outmaneuver those who stand before him.\r\n\r\nFast-forward a few years to Angelo Dawkins, established Superstar, and not much has changed. Dawkins remains a top competitor in his chosen sport, an athlete who’s willing to outhustle and outwork opponents at every turn. Although it took The Curse of Greatness some time to find himself — he tested the waters with various tag team partners early in his career — Dawkins experienced a breakthrough moment upon forming The Street Profits with tag team partner Montez Ford.","alterEgos":["Gary Gordan"],"birthplace":"Fairfield, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-226","wrestlerId":226,"promotionId":64,"startDate":"2018-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1603,2361,2675],"staffAttributes":{"bookingLogic":57,"storytelling":61,"productFit":100,"riskTaking":26,"matchLayout":63,"psychology":57,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":61,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":65,"brandBuilding":60,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":80,"awareness":57,"judgement":74},"picture":"Angelo Dawkins.png"},{"id":228,"name":"Real1","realName":"Real1","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":200,"height":177,"dateOfBirth":"1986-12-08T00:00:00.000Z","debut":"2012-10-01T00:00:00.000Z","wage":37500,"popularity":18,"charisma":49,"micSkills":40,"condition":85,"hardcoreAbility":63,"injuryProne":100,"ability":55,"currentAbility":49,"potentialAbility":83,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Real1, a 2012 graduate of the WWE Performance Center, is an American wrestler who works in America and Canada. He is a Small worker who is classed as using a Entertainer style. He is one half of Nzo & Caz alongside Big Bill. He is best known for his work with WWE, NXT and MLW.","alterEgos":["Enzo Amore"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1045,1046,2071],"staffAttributes":{"bookingLogic":44,"storytelling":49,"productFit":41,"riskTaking":47,"matchLayout":51,"psychology":44,"workerManagement":41,"trainingIntensity":62,"technicalCoaching":26,"characterCoaching":86,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":53,"mediaHandling":86,"brandBuilding":68,"socialMediaSavvy":76,"ruleKnowledge":0,"positioning":8,"reactionSpeed":62,"consistency":60,"awareness":44,"judgement":43},"picture":"Enzo Amore.png"},{"id":229,"name":"Luchasaurus","realName":"Luchasaurus","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":275,"height":193,"dateOfBirth":"1985-03-10T00:00:00.000Z","debut":"2009-10-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":27,"charisma":78,"micSkills":72,"condition":87,"hardcoreAbility":57,"injuryProne":100,"ability":72,"currentAbility":72,"potentialAbility":85,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Some say he is disturbed, others say he is a mad genius, but if you asked him - he would simply say that he is ahead of the curve. Judas Devlin is one of the more deranged, yet oddly intellectual superstars of NXT. Standing at 6 feet 5 inches tall and covered in colorful tattoos, this modern day Aristocrat uses his deceitful intellect to confuse and break down his opponents mentally before ever stepping foot in the ring. Hailing from the coast of California, where from an early age he was exposed to off-beat cultural and philosophical ideas, Judas began his career not in the ring, but in the halls at the University of Berkley. There, after years of study he became a published author, scholar, and professor of history. However, with time he became disgusted with what he called, “the weak wills and feeble hearts of his colleagues and students.”","alterEgos":["Vibora","Killswitch"],"birthplace":"Woodland Hills, California, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-229","wrestlerId":229,"promotionId":76,"startDate":"2019-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1619,1904,1946,3452],"staffAttributes":{"bookingLogic":50,"storytelling":55,"productFit":56,"riskTaking":30,"matchLayout":56,"psychology":50,"workerManagement":56,"trainingIntensity":68,"technicalCoaching":35,"characterCoaching":57,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":57,"brandBuilding":73,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":11,"reactionSpeed":68,"consistency":66,"awareness":50,"judgement":52},"picture":"Luchasaurus.png","injury":{"type":"Dislocated Shoulder","daysToRecover":-4},"returnDate":"2026-04-08T00:00:00.000Z"},{"id":231,"name":"Dean Muhtadi","realName":"Dean Muhtadi","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":265,"height":190,"dateOfBirth":"1986-07-17T00:00:00.000Z","debut":"2013-05-01T00:00:00.000Z","wage":37500,"popularity":19,"charisma":53,"micSkills":33,"condition":82,"hardcoreAbility":38,"injuryProne":100,"ability":46,"currentAbility":41,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Prior to his ring career, Rawley played all positions on the defensive line for the University of Maryland while assuming the same role for the Green Bay Packers and Arizona Cardinals in the NFL. Pushing the boundaries of every muscle in his body and brain, Mojo shattered countless records in strength and speed, and even earned his MBA degree at the young age of 23.\r\n\r\nAll of this made Rawley a no-brainer to join the world of sports-entertainment, where one must stay hyped and hungry at all times. Mojo proved to be both, blazing a trail through WWE NXT that eventually landed him in a tag team with veteran Superstar Zack Ryder. As The Hype Bros, Mojo and Zack fed off each other’s enthusiasm and energy, becoming a force to be reckoned with in NXT and SmackDown LIVE's tandem divisions. While The Hype Bros initially stayed within striking distance of the SmackDown Tag Team Titles, a prolonged losing streak proved too much for Rawley, who shocked the WWE Universe, savagely attacking Ryder.","alterEgos":["Mojo Rawley"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1449,1450],"staffAttributes":{"bookingLogic":44,"storytelling":48,"productFit":100,"riskTaking":32,"matchLayout":49,"psychology":44,"workerManagement":100,"trainingIntensity":66,"technicalCoaching":18,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":68,"brandBuilding":67,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":66,"consistency":62,"awareness":44,"judgement":66},"picture":"Mojo Rawley.png"},{"id":232,"name":"Adam Cole","realName":"Adam Cole","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":202,"height":177,"dateOfBirth":"1989-07-05T00:00:00.000Z","debut":"2008-04-01T00:00:00.000Z","wage":80000,"wageType":"monthly","popularity":50,"charisma":86,"micSkills":83,"condition":71,"hardcoreAbility":82,"injuryProne":100,"ability":75,"currentAbility":75,"potentialAbility":90,"morale":"good","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Irreverent, decorated and undeniably a big-match player, Cole was already drawing comparisons to a young Shawn Michaels by the time he made his unannounced NXT debut at TakeOver: Brooklyn III. It was there that The Panama City Playboy emerged from the stands to join Bobby Fish and Kyle O’Reilly in attacking then–NXT Champion Drew McIntyre. The NXT Universe’s chorus of “Adam Cole, Bay Bay” made it clear that a new main-event Superstar had arrived, but nobody realized that NXT was also witnessing the formation of what would become its most successful faction: The Undisputed ERA.\r\n\r\nWith Cole leading the charge, The Undisputed ERA soon expanded to include Roderick Strong, and together, the four-Superstar unit has achieved nothing less than total dominance. Whether through sheer talent, occasional treachery or a wolfpack-like force in numbers, The Undisputed ERA wasted little time trouncing the competition and accumulating a staggering collection of championships.","alterEgos":[],"birthplace":"Lancaster, Pennsylvania, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-232","wrestlerId":232,"promotionId":76,"startDate":"2021-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":80000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1062,3809,3810],"staffAttributes":{"bookingLogic":70,"storytelling":73,"productFit":100,"riskTaking":18,"matchLayout":74,"psychology":70,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":67,"characterCoaching":82,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":82,"brandBuilding":74,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":66,"awareness":70,"judgement":82},"picture":"Adam Cole.png","injury":{"type":"Concussion","daysToRecover":-1},"returnDate":"2026-04-11T00:00:00.000Z"},{"id":235,"name":"BJ Whitmer","realName":"BJ Whitmer","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":231,"height":185,"dateOfBirth":"1978-01-25T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":37500,"popularity":13,"charisma":54,"micSkills":59,"condition":58,"hardcoreAbility":57,"injuryProne":100,"ability":56,"currentAbility":42,"potentialAbility":52,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"BJ Whitmer is a retired American wrestler who works primarily as a road agent. He is best known for his work with AEW, IMPACT, NOAH, PWG, wXw, ROH, AAW, AIW, IWA-MS, A1 and CZW.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1426,1490,1565],"staffAttributes":{"bookingLogic":63,"storytelling":72,"productFit":100,"riskTaking":25,"matchLayout":75,"psychology":63,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":51,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":54,"brandBuilding":32,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":64,"awareness":63,"judgement":78},"picture":"BJ Whitmer_alt1.png"},{"id":237,"name":"Brian Gorie","realName":"Brian Gorie","nickname":"","type":"referee","base":"USA","gender":"M","weight":156,"height":172,"dateOfBirth":"1982-07-04T00:00:00.000Z","debut":"1998-07-01T00:00:00.000Z","wage":66000,"popularity":1,"charisma":53,"micSkills":49,"condition":100,"hardcoreAbility":69,"injuryProne":100,"ability":62,"currentAbility":51,"potentialAbility":53,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Brian Gorie is an American professional wrestling referee. Debuting in 1998 at the age of 16, Brian has refereed for over 80 different professional wrestling promotions including Ring Of Honor, TNA Wrestling, Juggalo Championship Wrestling and Shimmer Women Athletes. Ring Of Honor is known to employ the best referees in all of professional wrestling & continuing that tradition is veteran official Brian Gorie. Debuting with ROH in 2003, Gorie has reffed for nearly every top wrestling group in the United States before starting full-time with ROH in 2012. As well as being known for his speed and athleticism, BG is also ambidextrous, allowing him to count with either hand to ensure the best positioning possible for pinfalls. Due to his vast experience as a Shimmer referee, Brian has earned the role of the official 'Women Of Honor' ref in ROH.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":11,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":11,"brandBuilding":11,"socialMediaSavvy":5,"ruleKnowledge":60,"positioning":48,"reactionSpeed":0,"consistency":78,"awareness":0,"judgement":0},"picture":"Brian Gorie_alt1.png"},{"id":239,"name":"Caprice Coleman","realName":"Caprice Coleman","nickname":"","type":"commentator","promotionId":49,"base":"USA","gender":"M","weight":213,"height":175,"dateOfBirth":"1977-03-20T00:00:00.000Z","debut":"1996-01-01T00:00:00.000Z","wage":16400,"wageType":"per-appearance","popularity":4,"charisma":58,"micSkills":67,"condition":82,"hardcoreAbility":38,"injuryProne":100,"ability":45,"currentAbility":33,"potentialAbility":35,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Caprice Coleman is an American wrestler who works in America and Canada. He is a Lightweight who is classed as using a Technician style. He is best known for his work with NWA and ROH. He is the protege of Jeff Hardy.","alterEgos":[],"birthplace":"Jamaica, New York, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-239","wrestlerId":239,"promotionId":49,"startDate":"2011-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":16400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[975],"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":100,"riskTaking":40,"matchLayout":66,"psychology":58,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":50,"characterCoaching":53,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":53,"brandBuilding":49,"socialMediaSavvy":40,"ruleKnowledge":40,"positioning":52,"reactionSpeed":72,"consistency":75,"awareness":58,"judgement":75},"picture":"Caprice Coleman_alt1.png"},{"id":240,"name":"Cary Silkin","realName":"Cary Silkin","nickname":"","type":"manager","promotionId":49,"base":"USA","gender":"M","weight":171,"height":162,"dateOfBirth":"1959-11-22T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","wage":16400,"wageType":"per-appearance","popularity":3,"charisma":52,"micSkills":35,"condition":100,"hardcoreAbility":33,"injuryProne":33,"ability":38,"currentAbility":17,"potentialAbility":19,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"As the former owner of Ring of Honor from 2004 - 2011, Cary Silkin spearheaded the international growth of ROH Wrestling.  Under his ownership, the company traveled into new territory both in terms of live events and in the ways in which fans could experience ROH for themselves.  Under Mr. Silkin, Ring of Honor branched out across the United States as well as into the United Kingdom and Japan to bring the best pro wrestling on the planet to the world.  In addition, it was under his direction that ROH first broached the realm on traditional PPV broadcasts, entered into the television realm with a two year run on HDNet, and innovated the field of iPPV as it pertained to professional wrestling.  Ring of Honor would not be where it is today without Cary Silkin.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-240","wrestlerId":240,"promotionId":49,"startDate":"2004-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":16400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":2,"storytelling":1,"productFit":0,"riskTaking":99,"matchLayout":1,"psychology":2,"workerManagement":0,"trainingIntensity":2,"technicalCoaching":0,"characterCoaching":55,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":1,"mediaHandling":55,"brandBuilding":27,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":0,"reactionSpeed":2,"consistency":1,"awareness":2,"judgement":1},"picture":"Cary Silkin.png"},{"id":241,"name":"Cedric Alexander","realName":"Cedric Alexander","nickname":"","type":"wrestler","promotionId":28,"base":"USA","gender":"M","weight":205,"height":175,"dateOfBirth":"1989-08-16T00:00:00.000Z","debut":"2009-07-01T00:00:00.000Z","wage":30700,"wageType":"per-appearance","popularity":29,"charisma":82,"micSkills":84,"condition":82,"hardcoreAbility":57,"injuryProne":100,"ability":73,"currentAbility":73,"potentialAbility":78,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Cedric Alexander is an American wrestler who works in the USA and Canada. He is a 5'10\", 205lb worker who is classed as using a High Flyer style. He uses the Kick to Kill, the Lumbar Check and the Overtime as his finishers. He is best known for his work with WWE, TNA, ROH and DPW. He is married to Big Swole.","alterEgos":[],"birth