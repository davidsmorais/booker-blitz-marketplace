otentialAbility":67,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Arisa Nakajima  is a Japanese professional wrestler. Trained by the Major Girl's Fighting AtoZ promotion, Nakajima made her debut in January 2006, but when the promotion folded the following May, she transferred over to JWP Joshi Puroresu, where she has worked ever since, becoming a two-time JWP Openweight Champion, a two-time JWP Junior and Princess of Pro-Wrestling Champion and a one-time JWP Tag Team and Daily Sports Women's Tag Team Champion in the process. Nakajima retired from professional wrestling in June 2009, but made her return to JWP in April 2012. The following December, Nakajima won JWP's top title, the JWP Openweight Championship, for the first time.","alterEgos":["Commander Nakajima"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1697,2477,3374,3375,3975],"staffAttributes":{"bookingLogic":83,"storytelling":84,"productFit":100,"riskTaking":21,"matchLayout":84,"psychology":83,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":83,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":68,"brandBuilding":69,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":88,"awareness":83,"judgement":90},"picture":"Arisa Nakajima_alt1.png"},{"id":1395,"name":"Alisha Edwards","realName":"Alisha Edwards","nickname":"","type":"wrestler","promotionId":28,"base":"USA","gender":"F","weight":119,"height":149,"dateOfBirth":"1987-01-07T00:00:00.000Z","debut":"2006-05-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":13,"charisma":51,"micSkills":69,"condition":87,"hardcoreAbility":48,"injuryProne":10