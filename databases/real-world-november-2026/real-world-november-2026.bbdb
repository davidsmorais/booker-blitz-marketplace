:{"id":"tew-contract-212","wrestlerId":212,"promotionId":65,"startDate":"2012-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":68,"storytelling":78,"productFit":100,"riskTaking":22,"matchLayout":81,"psychology":68,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":25,"characterCoaching":75,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":75,"brandBuilding":55,"socialMediaSavvy":65,"ruleKnowledge":25,"positioning":40,"reactionSpeed":51,"consistency":65,"awareness":68,"judgement":81},"picture":"Norman Smiley.png"},{"id":215,"name":"Ricky Steamboat","realName":"Ricky Steamboat","nickname":"","type":"writer","base":"USA","gender":"M","weight":237,"height":175,"dateOfBirth":"1953-02-28T00:00:00.000Z","debut":"1971-02-01T00:00:00.000Z","wage":66000,"popularity":38,"charisma":85,"micSkills":96,"condition":56,"hardcoreAbility":100,"injuryProne":93,"ability":89,"currentAbility":41,"potentialAbility":41,"morale":"fair","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Richard Henry Blood better known by his ring name Ricky \"The Dragon\" Steamboat, is a retired American professional wrestler. He is best known for his work with the American Wrestling Association (AWA), the National Wrestling Alliance (NWA), World Championship Wrestling (WCW), and the World Wrestling Federation (WWF). In the NWA and WCW, he was a one-time NWA World Heavyweight Champion, a four-time United States Heavyweight Champion, a four-time World Television Champion, a twelve-time World Tag Team Champion (eight-time under the WCW banner, one-time (though unofficial) under the NWA banner, and three-time under the Mid-Atlantic banner), and a two-time Mid-Atlantic Heavyweight Champion. In the WWF/E, Steamboat was a one-time Intercontinental Champion and was inducted into the WWE Hall of Fame in 2009.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1329,2715],"staffAttributes":{"bookingLogic":95,"storytelling":97,"productFit":100,"riskTaking":12,"matchLayout":97,"psychology":95,"workerManagement":100,"trainingIntensity":50,"technicalCoaching":60,"characterCoaching":72,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":88,"mediaHandling":72,"brandBuilding":45,"socialMediaSavvy":68,"ruleKnowledge":68,"positioning":74,"reactionSpeed":50,"consistency":62,"awareness":95,"judgement":97},"picture":"Ricky Steamboat_alt1.png"},{"id":216,"name":"Robbie Brookside","realName":"Robbie Brookside","nickname":"","type":"writer","promotionId":65,"base":"UK","gender":"M","weight":241,"height":187,"dateOfBirth":"1966-03-11T00:00:00.000Z","debut":"1984-03-01T00:00:00.000Z","wage":20500,"wageType":"monthly","popularity":4,"charisma":79,"micSkills":70,"condition":87,"hardcoreAbility":87,"injuryProne":100,"ability":76,"currentAbility":40,"potentialAbility":40,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":true,"story":"Robbie Brookside is a retired English wrestler who works primarily as a road agent. He is best known for his work with WCW, NJPW, NXT, wXw and AJPW.","alterEgos":[],"birthplace":"Liverpool, England","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-216","wrestlerId":216,"promotionId":65,"startDate":"2020-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":2