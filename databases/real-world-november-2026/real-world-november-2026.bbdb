king":38,"matchLayout":54,"psychology":37,"workerManagement":36,"trainingIntensity":48,"technicalCoaching":28,"characterCoaching":60,"teaching":34,"diagnosis":55,"rehabilitation":36,"prevention":24,"mediaHandling":78,"brandBuilding":83,"socialMediaSavvy":47,"ruleKnowledge":36,"positioning":28,"reactionSpeed":34,"consistency":48,"awareness":38,"judgement":51},"picture":"Dasha Gonzalez.png"},{"id":3260,"name":"Mansoor","realName":"Mansoor","nickname":"","type":"wrestler","promotionId":49,"base":"Other","gender":"M","weight":216,"height":180,"dateOfBirth":"1995-10-28T00:00:00.000Z","debut":"2015-01-01T00:00:00.000Z","wage":32800,"wageType":"per-appearance","popularity":29,"charisma":78,"micSkills":64,"condition":100,"hardcoreAbility":77,"injuryProne":100,"ability":73,"currentAbility":73,"potentialAbility":81,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Going from vicariously living out his WWE Superstar aspirations through pixelated Create-a-Wrestler fantasy to winning the largest Battle Royal in WWE history at Super ShowDown isn’t just a sweet coming-of-age journey, but a testament to Mansoor’s unshakable drive. As WWE’s first Saudi Arabian-born Superstar, the scrappy 6-foot, 190-pounder spent much of his blossoming career proving his worth against anyone who crossed his path.\r\n\r\nAfter watching fellow “fight for your dreams” advocate Daniel Bryan defeat John Cena for the WWE Championships at SummerSlam 2013, Mansoor was inspired to pursue his dream of becoming a WWE Superstar, making waves in the independent circuit at the tender age of 18. Dedicating his all in this pursuit of sports-entertainment glory, Mansoor saw his unwavering persistence pay off big time in 2018, when he participated in a WWE tryout in Jeddah, Saudi Arabia, and wowed coaches enough to earn a contract with NXT.","alterEgos":[],"birthplace":"Riyadh, Saudi Arabia","managerId":0,"contractExpiryDate":"2026-07-26T00:00:00.000Z","contract":{"id":"tew-contract-3260","wrestlerId":3260,"promotionId":49,"startDate":"2024-07-26T00:00:00.000Z","endDate":"2026-07-26T00:00:00.000Z","wage":32800,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2763,3796,3852,4223,4224,4225,4226,4227,4228,4332],"staffAttributes":{"bookingLogic":62,"storytelling":65,"productFit":72,"riskTaking":28,"matchLayout":66,"psychology":62,"workerManagement":72,"trainingIntensity":72,"technicalCoaching":55,"characterCoaching":80,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":80,"brandBuilding":70,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":14,"reactionSpeed":72,"consistency":78,"awareness":62,"judgement":66},"picture":"Mansoor.png","additionalContracts":[{"id":"tew-contract-3260-76","wrestlerId":3260,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW"]},{"id":3261,"name":"Boa","realName":"Boa","nickname":"","type":"wrestler","base":"Other","gender":"M","weight":220,"height":190,"dateOfBirth":"1995-06-21T00:00:00.000Z","debut":"2017-07-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":61,"micSkills":43,"condition":100,"hardcoreAbility":49,"injuryProne":100,"ability":45,"currentAbility":45,"potentialAbility":53,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The phrase “think fast” comes to mind when NXT Superstar Boa hits the ring with strikes quicker than lightning \r\nMaking his way out of Beijing, China, Boa is a striking machine and marital arts expert. The Chinese Superstar, a former Brazilian Jiu-Jitsu champion in his native country, also boasts a background in submission wrestling and Muay Thai, altogether establishing him as a multi-versed threat. Those sharpened tools became the 6-foot-4 striker’s golden ticket during WWE's historic 2016 talent tryout in Shanghai, where, after a grueling four days, he earned a contract and the opportunity to eventually join NXT. With a hard-hitting skillset that clearly speaks volumes, it’s no wonder Boa believes his in-ring technique is “for me to know and you guys to find out.” Motivated by the pride that comes with representing his country, this Muay Thai practitioner is ready to strike down on anyone that comes in the way of getting his hand raised at the closing bell.","alterEgos":["Yanbo Wang"],"birthplace":"China","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":37,"storytelling":42,"productFit":15,"riskTaking":38,"matchLayout":43,"psychology":37,"workerManagement":15,"trainingIntensity":69,"technicalCoaching":47,"characterCoaching":25,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":25,"brandBuilding":62,"socialMediaSavvy":15,"ruleKnowledge":0,"positioning":3,"reactionSpeed":69,"consistency":45,"awareness":37,"judgement":28},"picture":"Boa.png"},{"id":3263,"name":"Holden Albright","realName":"Holden Albright","nickname":"","type":"wrestler","base":"Canada","gender":"M","weight":255,"height":182,"dateOfBirth":"1995-06-13T00:00:00.000Z","debut":"2015-10-01T00:00:00.000Z","wage":37500,"popularity":0,"charisma":55,"micSkills":39,"condition":100,"hardcoreAbility":54,"injuryProne":100,"ability":57,"currentAbility":57,"potentialAbility":65,"morale":"broken","presentation":"face","prest