3089],"staffAttributes":{"bookingLogic":43,"storytelling":47,"productFit":26,"riskTaking":43,"matchLayout":48,"psychology":43,"workerManagement":26,"trainingIntensity":67,"technicalCoaching":34,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":68,"brandBuilding":69,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":5,"reactionSpeed":67,"consistency":61,"awareness":43,"judgement":36},"picture":"Adam Maxted.png"},{"id":2527,"name":"Levi Cooper","realName":"Levi Cooper","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":250,"height":187,"dateOfBirth":"1990-07-24T00:00:00.000Z","debut":"2015-01-01T00:00:00.000Z","wage":37500,"popularity":17,"charisma":44,"micSkills":68,"condition":91,"hardcoreAbility":75,"injuryProne":100,"ability":55,"currentAbility":53,"potentialAbility":53,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"At six-foot-two and 320 pounds, Tucker could rely on size alone in the squared circle. He doesn’t. A former All-American wrestler at Arizona State University, Tucker can go when it comes to the mat game. On top of that, he moves around the squared circle with speed that belies his incredible size, like a runaway freight train barreling over anything and everything in his path.\r\n\r\nIn WWE, Tucker has joined forces with fellow big man and amateur standout Otis, and few teams can muster the power to compete with the duo known as Heavy Machinery. \r\n\r\nIn the WWE Draft, Tucker was drafted to Raw, while Otis stayed on SmackDown. Then at WWE Hell in a Cell, Tucker shocked the WWE Universe when he betrayed Otis by hitting him with the Money in the Bank briefcase. Not only did this allow Miz to defeat Otis and steal the contract away from him, but made it clear that Heavy Machinery had in fact broken down for good.","alterEgos":["Tucker"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1095,3230],"staffAttributes":{"bookingLogic":48,"storytelling":53,"productFit":77,"riskTaking":37,"matchLayout":55,"psychology":48,"workerManagement":77,"trainingIntensity":64,"technicalCoaching":45,"characterCoaching":50,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":50,"brandBuilding":54,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":15,"reactionSpeed":64,"consistency":67,"awareness":48,"judgement":60},"picture":"Tucker Knight.png"},{"id":2528,"name":"Otis","realName":"Otis","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":310,"height":175,"dateOfBirth":"1991-12-21T00:00:00.000Z","debut":"2015-08-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":44,"charisma":81,"micSkills":67,"condition":96,"hardcoreAbility":66,"injuryProne":100,"ability":73,"currentAbility":73,"potentialAbility":79,"morale":"fair","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Otis has arrived in WWE and declared that he’s hungry, which is unfortunate news for his competition.\r\n\r\nThanks to his penchant for putting up inhuman numbers and reps in the Performance Center’s weight room, the 330-pounder has made waves since his arrival at the WWE PC. A 455-pound floor press is a warm-up for Otis.\r\n\r\nBut pure power isn’t the only attribute the Wisconsin native brings to the squared circle. Otis was a standout amateur heavyweight wrestler at Colorado State University-Pueblo and a medalist in Greco-Roman wrestling at the Pan-American Games. He’s also trained extensively at the U.S. Olympic Training Center and studied under Gold Medalist Rulon Gardner.","alterEgos":["Dozer"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2528","wrestlerId":2528,"promotionId":64,"startDate":"2019-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1095,2342,3230,4071],"staffAttributes":{"bookingLogic":55,"storytelling":60,"productFit":100,"riskTaking":22,"matchLayout":61,"psychology":55,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":45,"characterCoaching":83,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":83,"brandBuilding":69,"socialMediaSavvy":77,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":73,"awareness":55,"judgement":73},"picture":"Otis.png"},{"id":2529,"name":"Mystique","realName":"Mystique","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":121,"height":160,"dateOfBirth":"1995-04-24T00:00:00.000Z","debut":"2013-02-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":37,"micSkills":48,"condition":97,"hardcoreAbility":61,"injuryProne":100,"ability":41,"currentAbility":41,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"Mystique is a retired Mexican luchadora who tends to stay behind the scenes in the wrestling world.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":42,"storytelling":50,"productFit":28,"riskTaking":21,"matchLayout":52,"psychology":42,"workerManagement":28,"t