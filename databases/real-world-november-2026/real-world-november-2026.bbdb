:0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[680,1364,1365,2131,2703],"staffAttributes":{"bookingLogic":64,"storytelling":69,"productFit":100,"riskTaking":18,"matchLayout":70,"psychology":64,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":57,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":66,"brandBuilding":25,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":66,"awareness":64,"judgement":78},"picture":"Dan Barry.png"},{"id":2109,"name":"Flash Morgan Webster","realName":"Flash Morgan Webster","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":156,"height":170,"dateOfBirth":"1990-04-13T00:00:00.000Z","debut":"2009-11-01T00:00:00.000Z","wage":37500,"popularity":17,"charisma":66,"micSkills":45,"condition":91,"hardcoreAbility":60,"injuryProne":100,"ability":51,"currentAbility":49,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Welsh competitor Flash Morgan Webster enjoys being the center of attention. Known as The MODfather of Professional Wrestling for his ’60s British style, Webster is hard to miss, and once you’ve seen him in the ring, he’s hard to forget.\r\n\r\nWebster has made aerial maneuvers his stock-in-trade, but in the fine tradition of British wrestling, he’s highly skilled in grappling, too.\r\n\r\nAfter appearing in WWE in 2016 for a Cruiserweight Classic qualifying match and the 2018 WWE UK Championship Tournament, Webster solidified himself as a force to be reckoned with when he captured the NXT UK Tag Team Championships with Mark Andrews at NXT UK TakeOver: Cardiff.","alterEgos":[],"birthplace":"Wales","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[792,1801,1849,2357,3734,3930,3931],"staffAttributes":{"bookingLogic":48,"storytelling":56,"productFit":88,"riskTaking":36,"matchLayout":58,"psychology":48,"workerManagement":88,"trainingIntensity":84,"technicalCoaching":51,"characterCoaching":53,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":53,"brandBuilding":29,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":18,"reactionSpeed":84,"consistency":76,"awareness":48,"judgement":64},"picture":"Morgan Webster.png"},{"id":2110,"name":"Zack Gibson","realName":"Zack Gibson","nickname":"","type":"wrestler","promotionId":49,"base":"UK","gender":"M","weight":220,"height":187,"dateOfBirth":"1990-08-08T00:00:00.000Z","debut":"2009-01-01T00:00:00.000Z","wage":24600,"wageType":"per-appearance","popularity":21,"charisma":50,"micSkills":50,"condition":92,"hardcoreAbility":45,"injuryProne":100,"ability":72,"currentAbility":69,"potentialAbility":75,"morale":"poor","presentation":"heel","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Zack Gibson is willing to do whatever it takes to get the win, which makes him a truly dangerous competitor. He prefers straightforward rugged substance over flash, and he enjoys telling fans exactly what he thinks of them — a trait that has led to him becoming one of the U.K.’s most despised grapplers. Gibson also proudly embodies his local Liverpool heritage: From being an ardent proponent of “Scouse Style” (Scouse being a Liverpool dialect), to naming his prized wrist-lock after the Anfield football stadium’s iconic Shankly Gates, Gibson considers himself “Liverpool’s No. 1.”","alterEgos":["Rip Fowler"],"birthplace":"Liverpool, Merseyside, England","managerId":0,"contractExpiryDate":"2026-11-07T00:00:00.000Z","contract":{"id":"tew-contract-2110","wrestlerId":2