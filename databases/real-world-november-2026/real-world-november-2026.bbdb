":"M","weight":190,"height":172,"dateOfBirth":"1993-06-14T00:00:00.000Z","debut":"2009-10-01T00:00:00.000Z","wage":48000,"wageType":"per-appearance","popularity":5,"charisma":74,"micSkills":70,"condition":88,"hardcoreAbility":91,"injuryProne":100,"ability":65,"currentAbility":65,"potentialAbility":72,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Esfinge is a masked Mexican luchador who works in America and Mexico. He is a Lightweight who is classed as using a Luchador style. He is best known for his work with CMLL. He is currently the Mexican National Light Heavyweight champion.","alterEgos":[],"birthplace":"Guadalajara, Jalisco, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2084","wrestlerId":2084,"promotionId":11,"startDate":"2009-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":48000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1725,3461],"staffAttributes":{"bookingLogic":63,"storytelling":67,"productFit":100,"riskTaking":25,"matchLayout":68,"psychology":63,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":63,"characterCoaching":55,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":55,"brandBuilding":68,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":66,"awareness":63,"judgement":78},"picture":"Esfinge.png"},{"id":2085,"name":"Dai Suzuki","realName":"Dai Suzuki","nickname":"","type":"manager","base":"Japan","gender":"M","weight":176,"height":160,"dateOfBirth":"1990-01-19T00:00:00.000Z","debut":"2014-11-01T00:00:00.000Z","wage":1000,"popularity":2,"charisma":18,"micSkills":23,"condition":96,"hardcoreAbility":51,"injuryProne":100,"ability":37,"currentAbility":35,"potentialAbility":35,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Dai Suzuki is a Japanese professional wrestler who began his career working for the DDT promotion in Japan.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":61,"productFit":100,"riskTaking":28,"matchLayout":62,"psychology":58,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":56,"characterCoaching":38,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":38,"brandBuilding":22,"socialMediaSavvy":31,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":63,"awareness":58,"judgement":75},"picture":"Dai Suzuki.png"},{"id":2086,"name":"Rayo Americano","realName":"Pete Dunne","nickname":"","type":"wrestler","promotionId":64,"base":"UK","gender":"M","weight":205,"height":175,"dateOfBirth":"1993-11-09T00:00:00.000Z","debut":"2005-05-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":38,"charisma":81,"micSkills":75,"condition":91,"hardcoreAbility":94,"injuryProne":100,"ability":76,"currentAbility":75,"potentialAbility":82,"morale":"fair","presentation":"heel","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"“The BruiserWeight” Pete Dunne has seen and done it all. He has survived Japanese dojos and the training regiments of Coventry, U.K., and lived and breathed wrestling to the point that he believes everything he does constitutes a portion of his training.\r\n\r\nWhile Dunne began as a “full of hope” high-flyer, he transformed into a vengeful brawler who will accept nothing less than complete success. After he held the UK Championship for an incredible 685 days — the longest title reign in modern history — few could dispute Dunne’s claim that he is the “standard-bearer” of NXT UK.\r\n\r\nWith a penchant for inflicting pain — not to mention, a habit of attacking anybody who stands between him and whatever prize is in his crosshairs — Dunne lives in such a perpetual state of intensity that people cross the street to avoid him. Across the ring, his opponents have no such option.","alterEgos":["Pete Dunne","Butch"],"birthplace":"Solihull, West Midlands, England","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2086","wrestlerId":2086,"promotionId":64,"startDate":"2017-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[728,966,967,1802,1966,3655,3885,4370],"staffAttributes":{"bookingLogic":77,"storytelling":79,"productFit":100,"riskTaking":17,"matchLayout":80,"psychology":77,"workerManagement":100,"trainingIntensity":86,"technicalCoaching":78,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":68,"brandBuilding":69,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":86,"consistency":78,"awareness":77,"judgement":86},"picture":"Rayo Americano.png"},{"id":2087,"name":"Mauro Ranallo","realName":"Mauro Ranallo","nickname":"","type":"commentator","promotionId":118,"base":"Canada","gender":"M","weight":172,"height":172,"dateOfBirth":"1969-12-21T00:00:00.000Z","debut":"1989-11-01T00:00:00.000Z","wage":10500,"wageType":"per-appearance","popularity":19,"charisma":66,"micSkills":88,"condition":100,"hardcoreAbility":78,"injuryProne":93,"ability":65,"currentAbility":37,"potentialAbility":39,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ranallo began his career as an announcer and manager at the age of 16, when he was offered a job with All-Star Wrestling (in Vancouver), a nationally televised wrestling show throughout Canada. After that program ended production and the promotion folded in 1989, Ranallo became a disc jockey for Abbotsford, British Columbia radio station CFVR (now CKQC-FM). Later, he provided commentary announcing duties for Muay Thai/Kickboxing events and King of the Cage mixed martial arts shows on TSN. From 1999 to 2000, he served as the commentator for the Stampede Wrestling TV show in Calgary. His color-commentator was the late Bad News Allen. He became most prominently known among MMA fans as the voice of PRIDE Fighting Championships PPV broadcasts in North America from 2003 until October 2006.","alterEgos":[],"birthplace":"Canada","managerId":0,"contractExpiryDate":"2026-10-19T00:00:00.000Z","contract":{"id":"tew-contract-2087","wrestlerId":2087,"promotionId":118,"startDate":"2024-10-19T00:00:00.000Z","endDate":"2026-10-19T00:00:00.000Z","wage":10500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":67,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":67,"brandBuilding":21,"socialMediaSavvy":60,"ruleKnowledge":0,"posit