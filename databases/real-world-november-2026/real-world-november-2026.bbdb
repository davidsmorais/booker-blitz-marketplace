tractExpiryDate":"2026-10-14T00:00:00.000Z","contract":{"id":"tew-contract-66","wrestlerId":66,"promotionId":45,"startDate":"2024-10-14T00:00:00.000Z","endDate":"2026-10-14T00:00:00.000Z","wage":38400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1103,1239,1253,1696,2144,2306],"staffAttributes":{"bookingLogic":54,"storytelling":59,"productFit":100,"riskTaking":25,"matchLayout":60,"psychology":54,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":53,"characterCoaching":55,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":55,"brandBuilding":55,"socialMediaSavvy":37,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":45,"awareness":54,"judgement":72},"picture":"Naofumi Yamamoto_alt5.png"},{"id":67,"name":"Nattie","realName":"Natalya","nickname":"","type":"wrestler","promotionId":65,"base":"Canada","gender":"F","weight":134,"height":162,"dateOfBirth":"1982-05-27T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":41000,"wageType":"monthly","popularity":40,"charisma":63,"micSkills":84,"condition":76,"hardcoreAbility":61,"injuryProne":100,"ability":67,"currentAbility":67,"potentialAbility":89,"morale":"fair","presentation":"heel","prestige":"mid","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Natalya is a Canadian wrestler who works in the USA, Canada, the British Isles, Japan, Europe and Oceania. She is a 5'5\", 134lb worker who is classed as using a Technician style. She uses the German Suplex and the Sharpshooter as her finishers. She is best known for her work with WWE, AAA and GCW. She is married to TJ Wilson.","alterEgos":["Natalya","Nattie Neidhart"],"birthplace":"Calgary, Alberta, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-67","wrestlerId":67,"promotionId":65,"startDate":"2011-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":41000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2443,2770],"staffAttributes":{"bookingLogic":80,"storytelling":82,"productFit":100,"riskTaking":13,"matchLayout":82,"psychology":80,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":70,"characterCoaching":48,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":87,"mediaHandling":48,"brandBuilding":54,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":65,"awareness":80,"judgement":88},"picture":"Nattie.png"},{"id":68,"name":"Nic Nemeth","realName":"Nic Nemeth","nickname":"","type":"wrestler","promotionId":28,"base":"USA","gender":"M","weight":218,"height":180,"dateOfBirth":"1980-07-27T00:00:00.000Z","debut":"2004-11-03T00:00:00.000Z","wage":41000,"wageType":"per-appearance","popularity":47,"charisma":100,"micSkills":80,"condition":77,"hardcoreAbility":100,"injuryProne":100,"ability":69,"currentAbility":69,"potentialAbility":81,"morale":"fair","presentation":"heel","prestige":"mid","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Nic Nemeth is an American wrestler who works in America, Canada and Japan. He is a Middleweight who is classed as using a Regular style. He is best known for his work with WWE, NJPW and TNA. He is currently the IWGP Global Heavyweight champion.","alterEgos":["Dolph Ziggler"],"birthplace":"Cleveland, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-68","wrestlerId":68,"promotionId":28,"startDate":"2024-01-13T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":41000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[271,1583,1745,1965,3986,3987],"staffAttributes":{"bookingLogic":76,"storytelling":78,"productFit":100,"riskTaking":20,"matchLayout":79,"psychology":76,"workerManagement":100,"trainingIntensity":88,"technicalCoaching":66,"characterCoaching":75,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":75,"brandBuilding":75,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":88,"consistency":76,"awareness":76,"judgement":86},"picture":"Nic Nemeth.png"},{"id":69,"name":"Epico Colón","realName":"Orlando Colón","nickname":"","type":"wrestler","promotionId":79,"base":"USA","gender":"M","weight":230,"height":180,"dateOfBirth":"1982-03-24T00:00:00.000Z","debut":"2005-01-01T00:00:00.000Z","wage":32800,"wageType":"per-appearance","popularity":16,"charisma":67,"micSkills":55,"condition":87,"hardcoreAbility":61,"injuryProne":100,"ability":61,"currentAbility":50,"potentialAbility":52,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Orlando Colón is a Puerto Rican professional wrestler. He is the son of José Colón, nephew of Carlos Colón, Sr. and the cousin of professional wrestlers Carly (Carlito), Eddie (Primo), & Stacy Colón. Colón began wrestling in the independent circuit of the United States, performing in Hybrid Pro Wrestling, a promotion based in Schoolcraft, Michigan. He was given a villainous persona, which noted his lineage as a member of the Colón family, as well as a gimmick of \"winning by any means necessary\", emphasizing his heel character. Colón debuted as the mystery opponent in a stipulation match that promoted the debut of “another member of the Colón family”. Shortly afterwards, he made his return to the company under a masked gimmick named “Fireblaze”. On the November 4 episode of SmackDown, Colón made his debut in WWE as a heel, under the Epico name but without the mask.","alterEgos":["Orlando Colón","Epico","Fernando"],"birthplace":"Puerto Rico","managerId":0,"contractExpiryDate":"2026-10-05T00:00:00.000Z","contract":{"id":"tew-contract-69","wrestlerId":69,"promotionId":79,"startDate":"2024-10-05T00:00:00.000Z","endDate":"2026-10-05T00:00:00.000Z","wage":32800,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1410,1587,3163],"staffAttributes":{"bookingLogic":57,"storytelling":63,"productFit":100,"riskTaking":30,"matchLayout":65,"psychology":57,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":55,"characterCoaching":50,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":50,"brandBuilding":47,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":62,"awareness":57,"judgement":74},"picture":"Epico_alt4.png"},{"id":70,"name":"Paul Heyman","realName":"Paul Heyman","nickname":"","type":"manager","promotionId":64,"base":"USA","gender":"M","weight":233,"height":177,"dateOfBirth":"1965-09-11T00:00:00.000Z","debut":"1987-01-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":63,"charisma":57,"micSkills":69,"condition":65,"hardcoreAbility":75,"injuryProne":27,"ability":67,"currentAbility":34,"potentialAbility":36,"morale":"good","presentation":"heel","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Paul Heyman is an American entertainment producer, most well-known for his former roles in professional wrestling as promoter, manager, and commentator. He is also an occasional actor in film. Heyman was the creative force behind the revolutionary promotion Extreme Championship Wrestling in the 1990s. He has also worked in Ted Turner's World Championship Wrestling, the American Wrestling Association and World Wrestling Entertainment, including WWE's ECW brand where he was recognized as the ECW Representative in front of the camera, and was the general manager and brand manager behind the scenes. Heyman began as a photographer and writer for third-party wrestling publications such as Pro Wrestling Illustrated. Heyman made his managerial debut on January 2, 1987, initially appearing on the Northeast independent circuit before moving to a more high-profile stint with Florida Championship Wrestling in February 1987. There, he became Paul E. Dangerously.","alterEgos":[],"birthplace":"The Bronx, New York City, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-70","wrestlerId":70,"promotionId":64,"startDate":"2017-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":85,"storytelling":59,"productFit":100,"riskTaking":100,"matchLayout":51,"psychology":85,"workerManagement":100,"trainingIntensity":6,"technicalCoaching":0,"characterCoaching":89,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":89,"brandBuilding":41,"socialMediaSavvy":93,"ruleKnowledge":0,"positioning":20,"reactionSpeed":6,"consistency":0,"awareness":85,"judgement":91},"picture":"Paul Heyman.png"},{"id":71,"name":"Paul Levesque","realName":"Paul Levesque","nickname":"","type":"businessperson","promotionId":64,"base":"USA","gender":"M","weight":255,"height":190,"dateOfBirth":"1969-07-27T00:00:00.000Z","debut":"1992-03-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":70,"charisma":82,"micSkills":62,"condition":56,"hardcoreAbility":76,"injuryProne":78,"ability":68,"currentAbility":39,"potentialAbility":39,"morale":"great","presentation":"face","prestige":"high","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"He’s The King of Kings, a nickname with no hint of exaggeration considering that Triple H is essentially WWE royalty.\r\n\r\nFrom his days as a Greenwich, Conn. snob, to his era-defining run as a co-founder of D-Generation X, to the unrelenting drive that made him an absolute squared circle institution, to shepherding future main-eventers Randy Orton and Batista toward WWE greatness in Evolution, Triple H hasn’t just existed on the cutting edge —  he’s been the one sharpening the blade.\r\n\r\nA 14-time World Champion, The Game has clashed with a litany of ring legends to seize the throne as The King of Kings. The Rock, “Stone Cold” Steve Austin, Ric Flair, Shawn Michaels, The Undertaker, John Cena and even WWE Chairman Vince McMahon — each mowed down by the sledgehammer-wielding fist of The Cerebral Assassin.","alterEgos":["Triple H"],"birthplace":"Nashua, New Hampshire, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-71","wrestlerId":71,"promotionId":64,"startDate":"1995-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1021,1550],"staffAttributes":{"bookingLogic":74,"storytelling":65,"productFit":75,"riskTaking":47,"matchLayout":20,"psychology":50,"workerManagement":53,"trainingIntensity":21,"technicalCoaching":51,"characterCoaching":24,"teaching":58,"diagnosis":41,"rehabilitation":45,"prevention":52,"mediaHandling":29,"brandBuilding":56,"socialMediaSavvy":42,"ruleKnowledge":37,"positioning":39,"reactionSpeed":40,"consistency":44,"awareness":50,"judgement":20},"picture":"Triple H_alt15.png"},{"id":72,"name":"PJ Black","realName":"PJ Black","nickname":"","type":"wrestler","base":"Other","gender":"M","weight":213,"height":182,"dateOfBirth":"1981-03-03T00:00:00.000Z","debut":"1997-01-01T00:00:00.000Z","wage":37500,"popularity":14,"charisma":78,"micSkills":73,"condition":74,"hardcoreAbility":68,"injuryProne":100,"ability":73,"currentAbility":59,"potentialAbility":61,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Since making his in-ring debut at 16 in 1997, PJ Black has earned a reputation for being one of the top high-flyers and risk-takers in the sport. After starting his career in his native South Africa and Europe, Black came to the United States in 2008 and signed with WWE, where he went on to become a three-time tag team champion and defeat some of the biggest stars in the industry.\r\n\r\nBlack, who made his ROH debut at Survival of the Fittest in November 2018 and signed with the company a few months later, has competed in 61 countries and 48 states. When he’s not flying around the ring, the “Darewolf” is a thrill-seeker who enjoys adrenaline-pumping activities such as jumping out of airplanes, surfing and doing dirt bike stunts.","alterEgos":["Justin Gabriel"],"birthplace":"South Africa","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1063,1321,2082],"staffAttributes":{"bookingLogic":60,"storytelling":67,"productFit":100,"riskTaking":22,"matchLayout":69,"psychology":60,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":61,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":64,"brandBuilding":60,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":59,"awareness":60,"judgement":76},"picture":"PJ Black_alt5.png"},{"id":73,"name":"Paul Wight","realName":"Paul Wight","nickname":"","type":"commentator","promotionId":76,"base":"USA","gender":"M","weight":396,"height":210,"dateOfBirth":"1972-02-08T00:00:00.000Z","debut":"1994-12-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":53,"charisma":20,"micSkills":33,"condition":57,"hardcoreAbility":24,"injuryProne":98,"ability":38,"currentAbility":24,"potentialAbility":26,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"From the moment he stomped into WWE in 1999, he ripped through the competition to amass a giant collection of titles, including the WWE Championship.\r\n\r\nWith accolades that stretch as far as his gigantic reach, Big Show is one of the most decorated and feared Superstars to ever step foot inside the squared circle. He is the first Superstar to capture the WWE, WCW and ECW Championships and won the Andre the Giant Memorial Battle Royal at WrestleMania 31.\r\n\r\nStill knocking heads more than two decades after his in-ring debut, Big Show remains a monstrous threat. Best of luck to anyone who crosses his path.","alterEgos":["Big Show"],"birthplace":"Aiken, South Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-73","wrestlerId":73,"promotionId":76,"startDate":"2021-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1129,1319,1320,1520,2701],"staffAttributes":{"bookingLogic":74,"storytelling":76,"productFit":100,"riskTaking":17,"matchLayout":77,"psychology":74,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":19,"characterCoaching":79,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":79,"brandBuilding":76,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":64,"awareness":74,"judgement":84},"picture":"Paul Wight.png"},{"id":74,"name":"Randy Orton","realName":"Randy Orton","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":250,"height":193,"dateOfBirth":"1980-04-01T00:00:00.000Z","debut":"2000-03-01T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":73,"charisma":91,"micSkills":100,"condition":68,"hardcoreAbility":100,"injuryProne":100,"ability":82,"currentAbility":82,"potentialAbility":94,"morale":"great","presentation":"heel","prestige":"high","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Randy Orton was born a WWE Superstar.\r\n\r\nEarly after he arrived in WWE, Triple H and Ric Flair mentored him, welcoming him into their elite faction, Evolution. Under their tutelage, the 24-year-old Orton became the youngest World Heavyweight Champion, and he only kept going from there. Not only did Orton cement himself as a “Legend Killer” by dispatching WWE’s most decorated in-ring veterans, he became the centerpiece of two more factions, Legacy and The Authority, all en route to unifying the WWE and World Heavyweight Titles to become the first WWE World Heavyweight Champion in history.\r\n\r\nWhich isn’t to say the two-time Royal Rumble Match winner is content with being known as a team player. You don’t get a name like The Apex Predator for being friendly, and Orton certainly does not play well with others. Friend and foe alike have felt the sting of his RKO or the boom of his dreaded punt, and well into his second decade as a WWE Superstar, there’s no telling what comes next.","alterEgos":[],"birthplace":"Knoxville, Tennessee, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-74","wrestlerId":74,"promotionId":64,"startDate":"2002-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1287,2479],"staffAttributes":{"bookingLogic":86,"storytelling":87,"productFit":100,"riskTaking":11,"matchLayout":88,"psychology":86,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":62,"characterCoaching":82,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":89,"mediaHandling":82,"brandBuilding":88,"socialMediaSavvy":79,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":62,"awareness":86,"judgement":92},"picture":"Randy Orton.png"},{"id":75,"name":"Rey Mysterio","realName":"Rey Mysterio","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":163,"height":160,"dateOfBirth":"1974-12-11T00:00:00.000Z","debut":"1989-04-01T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":65,"charisma":97,"micSkills":100,"condition":70,"hardcoreAbility":100,"injuryProne":100,"ability":70,"currentAbility":70,"potentialAbility":92,"morale":"great","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"He stands only 5-foot-6 and barely weighs 175 pounds, but a lack of size didn’t stop the incomparable Rey Mysterio from achieving giant dreams like capturing the WWE Championship or outlasting 29 other Superstars to win the Royal Rumble as the No. 2 entrant. Whether he was standing up to a dangerous giant like Kane or flying down from the top of a steel cage, The Ultimate Underdog is known for refusing to be intimidated inside ring.\r\n\r\nAfter taking a sabbatical from WWE, Mysterio made his jaw-dropping return as a surprise entrant in the 2018 Royal Rumble! Mysterio hasn't missed a beat since returning, as his edge-of-your seat matches against Andrade are already the stuff of legend. Now on Raw after the 2019 Superstar Shake-up, Mysterio has enjoyed a United States Title reign and had several thrilling matches against Andrade, Samoa Joe and even Brock Lesnar.","alterEgos":[],"birthplace":"Chula Vista, California, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-75","wrestlerId":75,"promotionId":64,"startDate":"2020-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1303,1422,1423,2341,2750,2775],"staffAttributes":{"bookingLogic":83,"storytelling":84,"productFit":100,"riskTaking":18,"matchLayout":84,"psychology":83,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":66,"characterCoaching":82,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":82,"brandBuilding":83,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":80,"awareness":83,"judgement":90},"picture":"Rey Mysterio.png"},{"id":76,"name":"R-Truth","realName":"Ron Killings","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":229,"height":182,"dateOfBirth":"1972-01-19T00:00:00.000Z","debut":"1997-03-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":49,"charisma":76,"micSkills":81,"condition":80,"hardcoreAbility":68,"injuryProne":100,"ability":52,"currentAbility":52,"potentialAbility":84,"morale":"fair","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"He was rowdy for a hot minute as K-Kwik during the Attitude Era. Then, after a WWE sabbatical, he came back stronger than ever as R-Truth. Then, when it seemed like he had his moment in the spotlight, Truth turned into a full-on maniac, ranting and raving against his invisible tormentor Little Jimmy and coming a hair away from a WWE World Heavyweight Championship. Then, Little Jimmy went away … only Truth came back again, winning a Tag Team Title with Kofi Kingston and heisting the Intercontinental Championship to set up a Ladder Match scramble at WrestleMania 31. Then, he danced his way to victory with Carmella in Mixed Match Challenge Season 2. Then, he captured his second United States Title. Then, he became one of the most entertaining and endearing 24/7 Champions in the title's young history. Then …  \r\n\r\nOK, you get the idea. Point is, you can never count R-Truth out. He’ll always come back, you’ll never expect it and you’ll certainly be glad that he did. Now that’s what’s up.","alterEgos":["Ron Killings"],"birthplace":"Charlotte, North Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-76","wrestlerId":76,"promotionId":64,"startDate":"2025-06-07T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[909,911,1081,1148,1380,2777],"staffAttributes":{"bookingLogic":76,"storytelling":76,"productFit":100,"riskTaking":14,"matchLayout":76,"psychology":76,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":50,"characterCoaching":87,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":86,"mediaHandling":87,"brandBuilding":68,"socialMediaSavvy":84,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":74,"awareness":76,"judgement":86},"picture":"R-Truth.png"},{"id":77,"name":"Ryback","realName":"Ryback","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":291,"height":187,"dateOfBirth":"1981-07-10T00:00:00.000Z","debut":"2004-01-01T00:00:00.000Z","wage":37500,"popularity":33,"charisma":62,"micSkills":64,"condition":69,"hardcoreAbility":31,"injuryProne":100,"ability":42,"currentAbility":34,"potentialAbility":76,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Crushing his opponents with palpable intensity, the 6-foot-3, 291-pound monster known as Ryback had the strength and focus of an android that was designed to annihilate.\r\n\r\nRyback approached every challenge with brute force and a no-nonsense demeanor that exuded supreme confidence in his abilities. Operating under the mantra of “start full, finish empty,” he didn’t just possess the skills to destroy a rival at any time. He carried himself as if that result was never in doubt and prepared himself immediately for an encore, hence his famous war cry of “Feed Me More.”\r\n\r\nThe behemoth proved his intimidating presence can make any competitor back down, from formidable toughmen like Mark Henry to living legends like John Cena. In 2015, after battling his way through WWE for three years, The Big Guy defeated five other competitors in an Elimination Chamber Match to earn his first title, the Intercontinental Championship.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1305],"staffAttributes":{"bookingLogic":45,"storytelling":51,"productFit":78,"riskTaking":49,"matchLayout":53,"psychology":45,"workerManagement":78,"trainingIntensity":58,"technicalCoaching":20,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":51,"mediaHandling":70,"brandBuilding":80,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":16,"reactionSpeed":58,"consistency":69,"awareness":45,"judgement":58},"picture":"Ryback_alt5.png"},{"id":79,"name":"Scott Armstrong","realName":"Scott Armstrong","nickname":"","type":"referee","base":"USA","gender":"M","weight":211,"height":182,"dateOfBirth":"1959-05-04T00:00:00.000Z","debut":"1983-01-01T00:00:00.000Z","wage":66000,"popularity":4,"charisma":69,"micSkills":88,"condition":81,"hardcoreAbility":69,"injuryProne":100,"ability":68,"currentAbility":31,"potentialAbility":31,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Scott Armstrong is a retired American wrestler who works as a referee and a road agent. He was one half of Southern Boys alongside Tracy Smothers. He is best known for his work with WWE, WCW and IMPACT. He is married to someone outside the wrestling business.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2825],"staffAttributes":{"bookingLogic":63,"storytelling":72,"productFit":100,"riskTaking":23,"matchLayout":75,"psychology":63,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":39,"characterCoaching":59,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":59,"brandBuilding":25,"socialMediaSavvy":53,"ruleKnowledge":76,"positioning":81,"reactionSpeed":71,"consistency":52,"awareness":63,"judgement":78},"picture":"Scott Armstrong_alt2.png"},{"id":81,"name":"Sgt. Slaughter","realName":"Sgt. Slaughter","nickname":"","type":"writer","base":"USA","gender":"M","weight":305,"height":195,"dateOfBirth":"1948-08-27T00:00:00.000Z","debut":"1972-01-01T00:00:00.000Z","wage":66000,"popularity":18,"charisma":79,"micSkills":82,"condition":73,"hardcoreAbility":100,"injuryProne":53,"ability":80,"currentAbility":36,"potentialAbility":36,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Robert Remus is a retired professional wrestler better known by the ring name Sgt. Slaughter. From the late 1970s to the early 1990s, Slaughter had success in the National Wrestling Alliance, American Wrestling Association, and World Wrestling Federation. In the 1980s, an alternate version of the Sgt. Slaughter character was incorporated into the G.I. Joe: A Real American Hero toy line as well as its animated series and comic books. Sgt. Slaughter held numerous regional titles early in his career and experienced his first major success in the National Wrestling Alliance (NWA) capturing the NWA World Tag Team Championship with Don Kernodle. During the late 1970s, Remus worked the American Wrestling Association (AWA) territory under a mask as Super Destroyer Mark II with managers Lord Alfred Hayes and Bobby Heenan. He is a 1 time WWF Champion.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3192],"staffAttributes":{"bookingLogic":74,"storytelling":78,"productFit":100,"riskTaking":42,"matchLayout":79,"psychology":74,"workerManagement":100,"trainingIntensity":23,"technicalCoaching":23,"characterCoaching":70,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":58,"mediaHandling":70,"brandBuilding":65,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":23,"consistency":14,"awareness":74,"judgement":84},"picture":"Sgt Slaughter.png"},{"id":82,"name":"Shawn Michaels","realName":"Shawn Michaels","nickname":"","type":"trainer","promotionId":65,"base":"USA","gender":"M","weight":225,"height":182,"dateOfBirth":"1965-07-22T00:00:00.000Z","debut":"1984-10-01T00:00:00.000Z","wage":20500,"wageType":"monthly","popularity":64,"charisma":80,"micSkills":86,"condition":62,"hardcoreAbility":100,"injuryProne":100,"ability":86,"currentAbility":44,"potentialAbility":44,"morale":"good","presentation":"face","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"A cocky, confident heartbreaker from San Antonio, Texas, HBK started off his career as one half of The Rockers and ended it in a classic match with The Undertaker at WrestleMania XXVI. Along the way, he won every major WWE title, two Royal Rumbles, entry into the WWE Hall of Fame and a reputation as The Icon, The Showstopper, The Main Event.\r\n\r\nHis days in the ring weren’t always glorious, though. After charming crowds as a Rocker in the ’90s, HBK infamously severed his partnership with Marty Jannetty by smashing his friend’s head through a window. And the notorious “Montreal Screwjob” of the 1997 Survivor Series involving his greatest rival, Bret “Hit Man” Hart, could have killed a lesser Superstar’s career. Instead, it only added to the allure of one of sports-entertainment’s most captivatingly flawed figures.","alterEgos":[],"birthplace":"Chandler, Arizona, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-82","wrestlerId":82,"promotionId":65,"startDate":"2018-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1021,1499,1549],"staffAttributes":{"bookingLogic":34,"storytelling":29,"productFit":49,"riskTaking":45,"matchLayout":28,"psychology":35,"workerManagement":53,"trainingIntensity":84,"technicalCoaching":84,"characterCoaching":53,"teaching":91,"diagnosis":43,"rehabilitation":36,"prevention":29,"mediaHandling":57,"brandBuilding":31,"socialMediaSavvy":34,"ruleKnowledge":45,"positioning":44,"reactionSpeed":60,"consistency":48,"awareness":22,"judgement":24},"picture":"Shawn Michaels_alt9.png"},{"id":83,"name":"Sheamus","realName":"Sheamus","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":266,"height":190,"dateOfBirth":"1978-01-28T00:00:00.000Z","debut":"2002-04-01T00:00:00.000Z","wage":37500,"popularity":59,"charisma":86,"micSkills":90,"condition":73,"hardcoreAbility":90,"injuryProne":100,"ability":63,"currentAbility":63,"potentialAbility":85,"morale":"good","presentation":"face","prestige":"mid","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"With a red-hot temper that matches his fiery head of hair, Sheamus never backs down from a fight and has never been in one he didn’t think he could win. Hailing from Dublin, the ginger-headed juggernaut brings to the ring a ferocious offensive style that harkens to his noble and heroic Celtic ancestors. Whether by upbringing or by birthright, this modern-day Irish warrior was fated for combat.\r\n\r\nAnd what's a warrior without spoils from his many conquests? Sheamus can lay claim to being a four-time WWE World Heavyweight Champion, the 2010 King of the Ring, a two-time United States Champion, the winner of the 2012 Royal Rumble Match — an honor which paved the way for him to defeat Daniel Bryan in 18 seconds at WrestleMania to win the World Heavyweight Title — and the winner of the 2015 Money in the Bank contract.","alterEgos":["Sheamus O'Shaunessy"],"birthplace":"Ireland","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1239,1316,3664],"staffAttributes":{"bookingLogic":77,"storytelling":79,"productFit":100,"riskTaking":37,"matchLayout":79,"psychology":77,"workerManagement":100,"trainingIntensity":80,"technicalCoaching":54,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":73,"brandBuilding":75,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":80,"consistency":85,"awareness":77,"judgement":86},"picture":"Sheamus_alt4.png"},{"id":84,"name":"Stephanie McMahon","realName":"Stephanie McMahon","nickname":"","type":"businessperson","promotionId":64,"base":"USA","gender":"F","weight":143,"height":170,"dateOfBirth":"1976-09-24T00:00:00.000Z","debut":"1998-06-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":53,"charisma":10,"micSkills":10,"condition":100,"hardcoreAbility":9,"injuryProne":100,"ability":29,"currentAbility":21,"potentialAbility":23,"morale":"good","presentation":"face","prestige":"mid","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Think sports-entertainment is a man’s world? Stephanie McMahon will make sure you think again.\r\n\r\nMr. McMahon’s only daughter, Stephanie has been bossing WWE’s most powerful men around since she was old enough to form coherent sentences. As one of the principal owners of WWE and the company's Chief Brand Officer, however, she does a lot more than just talk. She’s proven herself to be a force with which to be reckoned both in and out of the ring. After all, how many of CableFax’s \"Most Powerful Women in Cable” are also former Women’s Champions?\r\n\r\nBorn into the sports-entertainment industry, Stephanie first got in on the family business by modeling Rockers T-shirts in the WWE Shop catalog when she was still in middle school. By the time WWE’s “Attitude Era” had taken pop culture by storm, the youngest McMahon was caught up in a rivalry between her father’s Corporation and The Undertaker’s wicked Ministry of Darkness.","alterEgos":[],"birthplace":"Hartford, Connecticut, United States","managerId":0,"contractExpiryDate":"2026-04-07T00:00:00.000Z","contract":{"id":"tew-contract-84","wrestlerId":84,"promotionId":64,"startDate":"2024-04-07T00:00:00.000Z","endDate":"2026-04-07T00:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":69,"storytelling":54,"productFit":66,"riskTaking":60,"matchLayout":32,"psychology":57,"workerManagement":42,"trainingIntensity":27,"technicalCoaching":25,"characterCoaching":49,"teaching":33,"diagnosis":49,"rehabilitation":25,"prevention":60,"mediaHandling":50,"brandBuilding":41,"socialMediaSavvy":34,"ruleKnowledge":59,"positioning":54,"reactionSpeed":23,"consistency":31,"awareness":60,"judgement":55},"picture":"Stephanie McMahon.png"},{"id":85,"name":"Steve Austin","realName":"Steve Austin","nickname":"","type":"scout","base":"USA","gender":"M","weight":252,"height":185,"dateOfBirth":"1964-12-18T00:00:00.000Z","debut":"1989-03-01T00:00:00.000Z","wage":66000,"popularity":73,"charisma":64,"micSkills":77,"condition":48,"hardcoreAbility":94,"injuryProne":69,"ability":69,"currentAbility":34,"potentialAbility":34,"morale":"great","presentation":"face","prestige":"high","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Proudly raising his middle fingers in the faces of everyone who dared oppose him, \"Stone Cold\" Steve Austin was the blue-collar warrior for the common man. Clad in jeans and black leather often soaked in beer foam, Austin was defiant, brash and dared anyone to try and tell him what to do. When the signature sound of shattering glass erupted throughout the arena, everyone there knew that it was time to raise hell. And if you happened to be on the receiving end, well, you have our sympathies.\r\n\r\nTrained by \"Gentleman\" Chris Adams, Steve Austin broke into the wrestling business in Texas in 1990, as part of the USWA. After a year, he moved on to WCW, where he won the WCW Television Championship under the name \"Stunning\" Steve Austin. An elbow injury led to his firing from WCW, but Austin found a lifeboat in ECW, and, with the freedom afforded him by Paul Heyman, began crafting a voice that would lead to superstardom in WWE.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1550],"staffAttributes":{"bookingLogic":31,"storytelling":20,"productFit":48,"riskTaking":59,"matchLayout":33,"psychology":32,"workerManagement":53,"trainingIntensity":55,"technicalCoaching":29,"characterCoaching":27,"teaching":34,"diagnosis":35,"rehabilitation":43,"prevention":60,"mediaHandling":25,"brandBuilding":56,"socialMediaSavvy":53,"ruleKnowledge":23,"positioning":36,"reactionSpeed":34,"consistency":48,"awareness":50,"judgement":94},"picture":"Steve Austin_alt2.png"},{"id":86,"name":"Steve Lombardi","realName":"Steve Lombardi","nickname":"","type":"writer","base":"USA","gender":"M","weight":240,"height":180,"dateOfBirth":"1961-04-18T00:00:00.000Z","debut":"1983-01-01T00:00:00.000Z","wage":66000,"popularity":13,"charisma":95,"micSkills":89,"condition":53,"hardcoreAbility":100,"injuryProne":100,"ability":83,"currentAbility":38,"potentialAbility":38,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Steve Lombardi is an Italian American professional wrestler and road agent. He is probably most known for his Brooklyn Brawler character - and losing streak! Lombardi began his WWF career in late 1983, competing under his real name, primarily as an enhancement talent, until early 1989, when he was repackaged as The Brooklyn Brawler. The Brawler character was that of a street fighter, wearing battered jeans and a torn New York Yankees t-shirts. Lombardi was used in a number of gimmicks, often under a mask. In late 1993 early 1996, he briefly replaced Matt Borne as Doink the Clown until Ray Apollo was hired. He also regularly portrayed Kim Chee (Kamala's handler) during his 1986-87 and 1992 stints with the WWF and briefly in 1993 as a singles wrestler after Kamala left him for the newly ordained Reverend Slick. He still regularly used the Brooklyn Brawler gimmick during this period.","alterEgos":["Doink the Clown","Kim Chee","The Brooklyn Brawler"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":62,"storytelling":73,"productFit":100,"riskTaking":19,"matchLayout":77,"psychology":62,"workerManagement":100,"trainingIntensity":27,"technicalCoaching":24,"characterCoaching":57,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":57,"brandBuilding":18,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":27,"consistency":48,"awareness":62,"judgement":77},"picture":"Steve Lombardi.png"},{"id":87,"name":"Wade Barrett","realName":"Stu Bennett","nickname":"","type":"commentator","promotionId":64,"base":"UK","gender":"M","weight":246,"height":198,"dateOfBirth":"1980-08-10T00:00:00.000Z","debut":"2004-06-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":35,"charisma":50,"micSkills":23,"condition":76,"hardcoreAbility":37,"injuryProne":100,"ability":28,"currentAbility":22,"potentialAbility":22,"morale":"fair","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Trained in bare-knuckle brawling on the mean streets of Preston, England, Wade Barrett brought strength, arrogance and cunning to the ring in equal measure. He was imbued with confidence and eloquence, character traits that propelled the cocky young Brit to the top ranks in WWE.\r\n\r\nAfter coming to WWE prominence as the winner of WWE NXT season one, Barrett proved he was not content merely to share the spotlight with his fellow Superstars. He wanted total control, and he’s willing to do whatever it takes to get it. Whether as the firebrand leader of not one, but two insurgent squads, or a lone fighter intent on delivering “Bad News” in the most painful form imaginable, Barrett proved himself to be one of the tougher specimens to ever set foot in a ring.","alterEgos":["Stu Bennett","Lawrence Knight","Bad News Barrett","Stu Sanders"],"birthplace":"Penwortham, Lancashire, England","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-87","wrestlerId":87,"promotionId":64,"startDate":"2022-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1044],"staffAttributes":{"bookingLogic":63,"storytelling":71,"productFit":100,"riskTaking":23,"matchLayout":73,"psychology":63,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":49,"characterCoaching":77,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":77,"brandBuilding":72,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":83,"awareness":63,"judgement":78},"picture":"Wade Barrett.png"},{"id":89,"name":"Tanga Loa","realName":"Tanga Loa","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":220,"height":185,"dateOfBirth":"1983-05-07T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","wage":37500,"popularity":38,"charisma":63,"micSkills":70,"condition":69,"hardcoreAbility":43,"injuryProne":87,"ability":51,"currentAbility":51,"potentialAbility":74,"morale":"fair","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tanga Loa is an American wrestler who works in America, Canada and Japan. He is a Middleweight who is classed as using a Powerhouse style. He is one half of Guerrillas of Destiny alongside Tama Tonga. He is best known for his work with WWE, NJPW, CMLL, IMPACT, NXT and NJoA.","alterEgos":["Tonga Loa"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1086,1497,1586,3027,3674,3974],"staffAttributes":{"bookingLogic":52,"storytelling":54,"productFit":100,"riskTaking":27,"matchLayout":55,"psychology":52,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":35,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":54,"brandBuilding":58,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":62,"awareness":52,"judgement":71},"picture":"Tanga Loa_alt3.png"},{"id":90,"name":"Titus O'Neil","realName":"Titus O'Neil","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":270,"height":195,"dateOfBirth":"1977-04-29T00:00:00.000Z","debut":"2009-10-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":27,"charisma":51,"micSkills":43,"condition":73,"hardcoreAbility":40,"injuryProne":100,"ability":38,"currentAbility":28,"potentialAbility":28,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"One of the most imposing NXT Rookies on the show’s second season, “The Real Deal” saw his hard work paid off in early 2012, when then-General Manager John Laurinaitis formally placed O’Neil and his main man Darren Young on the SmackDown roster. Taking on the name of The Prime Time Players, Young and O’Neil set out to prove to the WWE Universe that they were worth the “millions of dollars” they said they were, capturing the Tag Team Championships in 2015 after resolving a conflict that had initially driven them apart.\r\n\r\nNot that the mind behind Titus Worldwide is simply a tag-team stalwart. The gridiron grappler has left his fair share of Superstars lying limp on the mat in singles competition as well, bringing the same intensity and passion to his charity commitments outside the ring. He even became the first-ever 24/7 Champion when the title was introduced in May 2019. A hell of a competitor and a hell of a humanitarian, it’s only a matter of time before the name on everyone’s lips i","alterEgos":["Titus"],"birthplace":"Boynton Beach, Florida, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-90","wrestlerId":90,"promotionId":64,"startDate":"2014-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1282,1719,1932],"staffAttributes":{"bookingLogic":42,"storytelling":47,"productFit":50,"riskTaking":39,"matchLayout":49,"psychology":42,"workerManagement":50,"trainingIntensity":59,"technicalCoaching":22,"characterCoaching":72,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":72,"brandBuilding":63,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":10,"reactionSpeed":59,"consistency":51,"awareness":42,"judgement":45},"picture":"Titus ONeil_alt2.png"},{"id":91,"name":"The Miz","realName":"The Miz","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":231,"height":182,"dateOfBirth":"1980-10-08T00:00:00.000Z","debut":"2003-01-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":51,"charisma":77,"micSkills":68,"condition":88,"hardcoreAbility":85,"injuryProne":100,"ability":63,"currentAbility":63,"potentialAbility":95,"morale":"good","presentation":"heel","prestige":"mid","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"First introduced to TV audiences as one of the seven strangers on “The Real World: Back to New York,” The Miz parlayed his reality TV fame into a legitimate WWE career.\r\n\r\nMiz’s first taste of WWE cred came alongside John Morrison, as the duo won the WWE Tag Team Championship and the attention of WWE Universe on their WWE.com web series, “The Dirt Sheet.” The team was split up thanks to the 2009 WWE Draft, and many expected Miz to fade into obscurity. He proved everyone wrong, though, by winning the United States Championship, the Unified Tag Team Championship and several high-profile matches.\r\n\r\nThen in July 2010, Miz’s career hit a turning point. By winning the Raw Money in the Bank Ladder Match, the Ohio native guaranteed himself a chance to capture his ultimate goal — the WWE Championship.","alterEgos":[],"birthplace":"Parma, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-91","wrestlerId":91,"promotionId":64,"startDate":"2005-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1319,1380,1466,1468,4267],"staffAttributes":{"bookingLogic":75,"storytelling":75,"productFit":100,"riskTaking":8,"matchLayout":75,"psychology":75,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":48,"characterCoaching":86,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":92,"mediaHandling":86,"brandBuilding":72,"socialMediaSavvy":80,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":88,"awareness":75,"judgement":85},"picture":"The Miz.png"},{"id":92,"name":"The Undertaker","realName":"The Undertaker","nickname":"","type":"scout","promotionId":64,"base":"USA","gender":"M","weight":309,"height":205,"dateOfBirth":"1965-03-24T00:00:00.000Z","debut":"1984-01-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":74,"charisma":100,"micSkills":88,"condition":36,"hardcoreAbility":83,"injuryProne":68,"ability":97,"currentAbility":49,"potentialAbility":49,"morale":"great","presentation":"face","prestige":"high","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"For three decades, The Undertaker loomed over the WWE landscape like a menacing shadow, spelling out doom for those who dared cross him. Imbued with seemingly mystical abilities and preternatural in-ring skill, The Deadman was a WWE great in a class by himself, and no list of legends would be complete without him.\r\n\r\nA multi-time WWE and World Heavyweight Champion, a six-time tag team titleholder and a Royal Rumble Match winner in 2007, Undertaker’s accomplishments in WWE have cemented his place among the greatest in the game. A true in-ring pioneer, he was part of many WWE firsts, including the first-ever Casket Match at Survivor Series 1992, the first-ever Buried Alive match in 1996 and the inaugural Hell in a Cell Match in October 1997.","alterEgos":[],"birthplace":"Houston, Texas, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-92","wrestlerId":92,"promotionId":64,"startDate":"1990-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1400,1520],"staffAttributes":{"bookingLogic":30,"storytelling":37,"productFit":25,"riskTaking":30,"matchLayout":31,"psychology":57,"workerManagement":59,"trainingIntensity":46,"technicalCoaching":26,"characterCoaching":58,"teaching":43,"diagnosis":32,"rehabilitation":21,"prevention":21,"mediaHandling":53,"brandBuilding":43,"socialMediaSavvy":20,"ruleKnowledge":22,"positioning":26,"reactionSpeed":35,"consistency":44,"awareness":57,"judgement":87},"picture":"Undertaker_alt7.png"},{"id":93,"name":"Theodore Long","realName":"Theodore Long","nickname":"","type":"manager","base":"USA","gender":"M","weight":161,"height":175,"dateOfBirth":"1947-09-15T00:00:00.000Z","debut":"1985-01-01T00:00:00.000Z","wage":66000,"popularity":28,"charisma":68,"micSkills":57,"condition":100,"hardcoreAbility":64,"injuryProne":83,"ability":57,"currentAbility":26,"potentialAbility":28,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Theodore R. \"Teddy\" Long is a former American professional wrestling referee and manager. Long started out as an errand boy for wrestlers Tommy Rich and Abdullah the Butcher. He eventually became a member of the ringcrew and was promoted to referee in the NWA's Jim Crockett Promotions in 1985 as Teddy Long. Shortly thereafter, Long began to turn into a villainous character when he started to bend the rules for heel wrestlers. On April 2, 1989 at Clash of the Champions VI in New Orleans, Long blatantly made a fast count allowing Mike Rotunda and \"Dr. Death\" Steve Williams to defeat the Road Warriors for the NWA World Tag Team Championship. After this match, the National Wrestling Alliance relieved Long of his refereeing duties. Long debuted in the WWF as a referee on the 21st December 1998 episode of Raw is War and stayed with that role until September 2002, when he was taken off the road.","alterEgos":["Teddy Long"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":60,"storytelling":42,"productFit":0,"riskTaking":100,"matchLayout":36,"psychology":60,"workerManagement":0,"trainingIntensity":30,"technicalCoaching":0,"characterCoaching":78,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":78,"brandBuilding":43,"socialMediaSavvy":70,"ruleKnowledge":67,"positioning":54,"reactionSpeed":30,"consistency":0,"awareness":60,"judgement":36},"picture":"Teddy Long_alt1.png"},{"id":94,"name":"Jinder Mahal","realName":"Jinder Mahal","nickname":"","type":"wrestler","base":"Canada","gender":"M","weight":238,"height":193,"dateOfBirth":"1986-07-19T00:00:00.000Z","debut":"2002-03-01T00:00:00.000Z","wage":37500,"popularity":38,"charisma":59,"micSkills":53,"condition":83,"hardcoreAbility":66,"injuryProne":100,"ability":54,"currentAbility":48,"potentialAbility":72,"morale":"fair","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jinder Mahal is a Canadian wrestler who works in the USA, Canada, Mexico, the British Isles, Europe, Oceania and India. He is a 6'5\", 238lb worker who is classed as using a Entertainer style. He uses the Karachi Valley Driver and the Sands of Time as his finishers. He is best known for his work with WWE, NXT, AAA, BLP and WXM.","alterEgos":["Raj Dhesi"],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[914,915,2758,3068],"staffAttributes":{"bookingLogic":58,"storytelling":59,"productFit":100,"riskTaking":28,"matchLayout":60,"psychology":58,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":38,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":62,"brandBuilding":70,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":80,"awareness":58,"judgement":75},"picture":"Jinder Mahal_alt10.png"},{"id":95,"name":"Tyson Kidd","realName":"TJ Wilson","nickname":"","type":"writer","promotionId":64,"base":"Canada","gender":"M","weight":205,"height":175,"dateOfBirth":"1980-07-11T00:00:00.000Z","debut":"1995-07-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":19,"charisma":100,"micSkills":78,"condition":50,"hardcoreAbility":82,"injuryProne":98,"ability":83,"currentAbility":66,"potentialAbility":66,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Theodore James (TJ) Wilson, sometimes spelled T.J. Wilson, is a Canadian professional wrestler. The final graduate of the Hart Dungeon, Wilson wrestled internationally in several promotions such as Stampede Wrestling in 1995 to 2007. As the Stampede Kid he completed several tours of Japan, competing at New Japan Pro Wrestling. Wilson signed with World Wrestling Entertainment in November 2006 at the age of 26, after receiving impressive reviews from former WWE trainer Bill DeMott. He moved to WWE developmental territory Deep South Wrestling (DSW) in February 2007 with fellow signee and girlfriend Nattie Neidhart. Wilson made his WWE television debut on the February 10, 2009, episode of ECW on Sci Fi managed by real-life girlfriend Natalya, under the name Tyson Kidd.","alterEgos":["TJ Wilson"],"birthplace":"Calgary, Alberta, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-95","wrestlerId":95,"promotionId":64,"startDate":"2011-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[993,1063,1437,1509,3190],"staffAttributes":{"bookingLogic":85,"storytelling":87,"productFit":100,"riskTaking":15,"matchLayout":87,"psychology":85,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":76,"characterCoaching":55,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":55,"brandBuilding":46,"socialMediaSavvy":39,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":76,"awareness":85,"judgement":91},"picture":"Tyson Kidd_alt3.png"},{"id":96,"name":"Trish Stratus","realName":"Trish Stratus","nickname":"","type":"wrestler","base":"Canada","gender":"F","weight":125,"height":162,"dateOfBirth":"1975-12-18T00:00:00.000Z","debut":"2000-03-01T00:00:00.000Z","wage":37500,"popularity":60,"charisma":86,"micSkills":68,"condition":74,"hardcoreAbility":65,"injuryProne":100,"ability":60,"currentAbility":60,"potentialAbility":92,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Patricia Anne Stratigias, better known as Trish Stratus, is a former fitness model, former professional wrestler and television personality from Canada. After beginning her career as a fitness model, Stratus began working for World Wrestling Entertainment. Early in her career, she was involved in sexually themed storylines. As Stratus spent more time in the ring, her wrestling skills and popularity strengthened. Because of this, she was a one-time WWE Hardcore Champion, three-time \"WWE Babe of the Year\" and was proclaimed \"Diva of the Decade\". After nearly seven years in the business, Stratus retired from wrestling on September 17, 2006 after winning her seventh WWE Women's Championship, the most in WWE history.\r\n\r\nAside from professional wrestling, Stratus modeled for and appeared on numerous magazine covers and has been involved in charity work. She has also been the host of several award and television shows, including Stratusphere in 2008.","alterEgos":[],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1546],"staffAttributes":{"bookingLogic":75,"storytelling":76,"productFit":100,"riskTaking":27,"matchLayout":77,"psychology":75,"workerManagement":100,"trainingIntensity":63,"technicalCoaching":53,"characterCoaching":79,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":79,"brandBuilding":83,"socialMediaSavvy":66,"ruleKnowledge":0,"positioning":20,"reactionSpeed":63,"consistency":63,"awareness":75,"judgement":85},"picture":"Trish Stratus_alt4.png"},{"id":97,"name":"Seth Rollins","realName":"Seth Rollins","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":216,"height":185,"dateOfBirth":"1986-05-28T00:00:00.000Z","debut":"2005-01-01T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":71,"charisma":87,"micSkills":82,"condition":75,"hardcoreAbility":94,"injuryProne":100,"ability":87,"currentAbility":87,"potentialAbility":100,"morale":"great","presentation":"face","prestige":"high","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"This is Seth Freaking Rollins. He’s really freaking good.\r\n\r\nDid you know that he beat Brock Lesnar for the Universal Title twice? Or that he’s the only man to cash in a Money in the Bank contract in the main event of WrestleMania? Or that he’s the only human being to ever hold the WWE Championship and United States Championship simultaneously?\r\n\r\nIf you didn't, it won’t be long until this hybrid athlete’s skills turn you into a believer. A veteran of the independent scene who sometimes seems more ninja than wrestler, Rollins set up shop as one of WWE’s on-the-spot history-makers from the second he walked in the door. From his reign as the first-ever NXT Champion to his vaunted time as The Architect of The Shield, Rollins’ first two years in WWE were a master class of evolution. Coincidentally enough, that’s the name of one of the factions he and his fellow Hounds of Justice managed to upend in their near-spotless two-year run throughout WWE’s ranks.","alterEgos":["Tyler Black"],"birthplace":"Davenport, Iowa, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-97","wrestlerId":97,"promotionId":64,"startDate":"2014-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1372,1503,2073,3450],"staffAttributes":{"bookingLogic":84,"storytelling":85,"productFit":100,"riskTaking":23,"matchLayout":85,"psychology":84,"workerManagement":100,"trainingIntensity":93,"technicalCoaching":75,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":78,"brandBuilding":78,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":93,"consistency":84,"awareness":84,"judgement":90},"picture":"Seth Rollins.png"},{"id":99,"name":"Alicia Fox","realName":"Alicia Fox","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":130,"height":172,"dateOfBirth":"1986-06-30T00:00:00.000Z","debut":"2006-07-01T00:00:00.000Z","wage":37500,"popularity":8,"charisma":40,"micSkills":63,"condition":81,"hardcoreAbility":35,"injuryProne":100,"ability":45,"currentAbility":40,"potentialAbility":44,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Victoria Crawford is an American model and professional wrestler best known by her ring name Alicia Fox. Crawford began her professional wrestling career in July 2006, where she signed a developmental contract with World Wrestling Entertainment, and was assigned to Ohio Valley Wrestling (OVW), WWE's developmental territory, where she won the OVW Women's Championship in October 2006. Crawford was later transferred to Florida Championship Wrestling (FCW) in September 2007. She soon debuted on the main roster in June 2008 with a wedding planner gimmick. As of 2013, she is the longest tenured diva currently in the WWE. In 2013, she joined forces with the charity Nothing But Nets to help fight against malaria.","alterEgos":["Vix Crow","Victoria Crawford"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":44,"storytelling":52,"productFit":50,"riskTaking":48,"matchLayout":55,"psychology":44,"workerManagement":50,"trainingIntensity":68,"technicalCoaching":48,"characterCoaching":72,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":52,"mediaHandling":72,"brandBuilding":52,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":10,"reactionSpeed":68,"consistency":60,"awareness":44,"judgement":46},"picture":"Alicia Fox_alt12.png"},{"id":100,"name":"Vince McMahon","realName":"Vince McMahon","nickname":"","type":"businessperson","base":"USA","gender":"M","weight":242,"height":185,"dateOfBirth":"1945-08-24T00:00:00.000Z","debut":"1971-01-01T00:00:00.000Z","wage":66000,"popularity":71,"charisma":100,"micSkills":90,"condition":38,"hardcoreAbility":100,"injuryProne":68,"ability":94,"currentAbility":43,"potentialAbility":45,"morale":"great","presentation":"face","prestige":"high","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Vince McMahon is an American man who tends to stay behind the scenes in the wrestling world. He is best known for his work with WWE. He is married to someone outside the wrestling business.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":68,"storytelling":81,"productFit":52,"riskTaking":40,"matchLayout":57,"psychology":45,"workerManagement":58,"trainingIntensity":20,"technicalCoaching":52,"characterCoaching":25,"teaching":40,"diagnosis":30,"rehabilitation":48,"prevention":45,"mediaHandling":21,"brandBuilding":35,"socialMediaSavvy":20,"ruleKnowledge":41,"positioning":31,"reactionSpeed":54,"consistency":25,"awareness":35,"judgement":39},"picture":"Vince McMahon_alt5.png"},{"id":102,"name":"Billy Gunn","realName":"Billy Gunn","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":266,"height":190,"dateOfBirth":"1963-11-01T00:00:00.000Z","debut":"1993-01-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":37,"charisma":82,"micSkills":65,"condition":66,"hardcoreAbility":80,"injuryProne":84,"ability":42,"currentAbility":42,"potentialAbility":74,"morale":"fair","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Billy Gunn can do it all.\r\n\r\nThe 6-foot-3, 260-pound phenomenon from Orlando, Fla. is a freakish athlete who can bust out a dropkick with textbook precision and hoist an opponent over his head with animal-like strength. He's charismatic, too. A cocky, in-your-face outlaw, Billy rocked with The Honky Tonk Man, threw a lasso as a Smoking Gunn and broke it down with D-Generation X en route to a whopping 11 Tag Team Title reigns and the 1999 King of the Ring crown.\r\n\r\nGunn’s career reached its peak when he returned to the tag division alongside Road Dogg. A fellow frustrated Superstar, the one-time Roadie convinced Rockabilly to abandon his outdated persona and embrace his inner outlaw. By themselves, the competitors were relative nobodies in WWE. Together, they became brash members of DX, five-time World Tag Team Champions and the most popular duo of WWE’s Attitude Era.","alterEgos":[],"birthplace":"Orlando, Florida, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-102","wrestlerId":102,"promotionId":76,"startDate":"2019-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1024,1103,1246,1320,1560,2072,3099],"staffAttributes":{"bookingLogic":73,"storytelling":76,"productFit":100,"riskTaking":15,"matchLayout":77,"psychology":73,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":42,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":58,"brandBuilding":67,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":54,"awareness":73,"judgement":84},"picture":"Billy Gunn.png"},{"id":103,"name":"Sean Waltman","realName":"Sean Waltman","nickname":"","type":"scout","base":"USA","gender":"M","weight":212,"height":182,"dateOfBirth":"1972-07-13T00:00:00.000Z","debut":"1992-03-01T00:00:00.000Z","wage":37500,"popularity":34,"charisma":48,"micSkills":66,"condition":73,"hardcoreAbility":75,"injuryProne":100,"ability":55,"currentAbility":35,"potentialAbility":67,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Sean Michael Waltman is an American professional wrestler. Waltman is best known for his appearances with the World Wrestling Federation under the ring names 1-2-3 Kid and X-Pac, World Championship Wrestling under the ring name Syxx and Total Nonstop Action Wrestling under the ring name Syxx-Pac. Waltman has wrestled on the independent circuit under both his real name and the ring name 6-Pac. He was also contracted to MTV's Wrestling Society X. Waltman was also part of the backstage group of wrestlers known as The Kliq. He is also known for his tumultuous relationship with fellow wrestler Chyna, with whom he made a sex tape. Waltman is the only wrestler in history to have held TNA X Division Championship, WCW Cruiserweight Championship & WWF Light Heavyweight Championship. He is considered one of the pioneers of high-risk, high-flying professional wrestling.","alterEgos":["1-2-3 Kid","Syxx","Syxx-Pac","X-Pac"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1024,1131,2799],"staffAttributes":{"bookingLogic":29,"storytelling":26,"productFit":28,"riskTaking":44,"matchLayout":46,"psychology":47,"workerManagement":45,"trainingIntensity":56,"technicalCoaching":41,"characterCoaching":33,"teaching":21,"diagnosis":41,"rehabilitation":27,"prevention":48,"mediaHandling":25,"brandBuilding":52,"socialMediaSavvy":52,"ruleKnowledge":42,"positioning":36,"reactionSpeed":51,"consistency":36,"awareness":40,"judgement":74},"picture":"Sean Waltman_alt3.png"},{"id":104,"name":"Chris Parks","realName":"Abyss","nickname":"","type":"writer","promotionId":64,"base":"USA","gender":"M","weight":350,"height":200,"dateOfBirth":"1973-10-04T00:00:00.000Z","debut":"1995-01-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":28,"charisma":96,"micSkills":100,"condition":51,"hardcoreAbility":94,"injuryProne":100,"ability":94,"currentAbility":61,"potentialAbility":61,"morale":"poor","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"Christopher J. \"Chris\" Parks, better known by his ring name \"The Monster\" Abyss, is an American professional wrestler. Chris Parks was trained by Roger Ruffin of the Northern Wrestling Federation (NWF). He won his debut match by disqualification. For the first few years of his career, Parks worked in the NWF as the Original Terminator, Chris Justice, and then Prince Justice. As Abyss in TNA, Parks became a former NWA World Heavyweight Champion, being the first of only two men to hold the title while competing under a mask. Abyss is the heaviest wrestler to hold the X Division Championship. He also captured the Television Championship once and the NWA World Tag Team Championship once with A.J. Styles. With having won all the required championships, Abyss was the fourth man to complete the Triple Crown Championship and the second to complete the Grand Slam Championship. Parks also currently makes appearances in TNA as Abyss' storyline brother Joseph Park.","alterEgos":["Abyss","Joseph Park"],"birthplace":"Washington, D.C., United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-104","wrestlerId":104,"promotionId":64,"startDate":"2019-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":80,"storytelling":80,"productFit":100,"riskTaking":28,"matchLayout":80,"psychology":80,"workerManagement":100,"trainingIntensity":59,"technicalCoaching":35,"characterCoaching":70,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":70,"brandBuilding":61,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":59,"consistency":65,"awareness":80,"judgement":88},"picture":"Chris Parks.png"},{"id":105,"name":"AJ Styles","realName":"AJ Styles","nickname":"","type":"scout","promotionId":64,"base":"USA","gender":"M","weight":218,"height":177,"dateOfBirth":"1977-06-02T00:00:00.000Z","debut":"1999-02-15T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":63,"charisma":82,"micSkills":92,"condition":75,"hardcoreAbility":100,"injuryProne":100,"ability":98,"currentAbility":72,"potentialAbility":72,"morale":"good","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"AJ Styles is a retired American wrestler who works primarily as a road agent. He is best known for his work with WWE, NJPW, WCW, TNA, NXT and ROH. He is married to someone outside the wrestling business. He has been voted Male Wrestler Of The Year two times.","alterEgos":[],"birthplace":"Jacksonville, North Carolina, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-105","wrestlerId":105,"promotionId":64,"startDate":"2016-01-24T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1056,1151,1339,1340,2391],"staffAttributes":{"bookingLogic":49,"storytelling":49,"productFit":24,"riskTaking":21,"matchLayout":36,"psychology":33,"workerManagement":43,"trainingIntensity":54,"technicalCoaching":22,"characterCoaching":55,"teaching":60,"diagnosis":31,"rehabilitation":52,"prevention":43,"mediaHandling":30,"brandBuilding":44,"socialMediaSavvy":50,"ruleKnowledge":37,"positioning":21,"reactionSpeed":23,"consistency":33,"awareness":43,"judgement":83},"picture":"AJ Styles_alt13.png"},{"id":106,"name":"Al Snow","realName":"Al Snow","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":235,"height":182,"dateOfBirth":"1963-07-18T00:00:00.000Z","debut":"1982-05-01T00:00:00.000Z","wage":37500,"popularity":9,"charisma":50,"micSkills":46,"condition":55,"hardcoreAbility":78,"injuryProne":100,"ability":48,"currentAbility":23,"potentialAbility":65,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Allen Ray Sarven is a retired professional wrestler and actor better known by his ring name of Al Snow. He is best known for his work in Extreme Championship Wrestling and World Wrestling Entertainment. After a tour of Japan, Sarven wrestled a match in Michigan against Sabu, an Extreme Championship Wrestling (ECW) regular, who suggested he try ECW. From 1995-1997, Snow was also running a wrestling gym called \"Body Slammers\" in Lima, Ohio hiring D'Lo Brown as an assistant trainer. Sarven began working for the World Wrestling Federation (WWF) when he signed a contract in August 1995. Sarven wrestled under numerous gimmicks in the WWF. Sarven found success back in ECW, billed once again as Al Snow in 1997. Sarven was then recalled to the WWF in 1998 where he continued his gimmick of talking to \"Head,\" creating some of the more memorable humorous skits of \"The Attitude Era\" including fighting himself in a hardcore match. In March 2010 Sarven received a tryout as an agent for TNA Wrestling.","alterEgos":["Avatar","Leif Cassidy","Shinobi"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1478,3355],"staffAttributes":{"bookingLogic":74,"storytelling":77,"productFit":100,"riskTaking":24,"matchLayout":78,"psychology":74,"workerManagement":100,"trainingIntensity":44,"technicalCoaching":38,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":70,"brandBuilding":48,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":44,"consistency":37,"awareness":74,"judgement":84},"picture":"Al Snow_alt1.png"},{"id":107,"name":"Alex Silva","realName":"Alex Silva","nickname":"","type":"wrestler","base":"Canada","gender":"M","weight":200,"height":180,"dateOfBirth":"1990-01-23T00:00:00.000Z","debut":"2004-02-01T00:00:00.000Z","wage":37500,"popularity":6,"charisma":38,"micSkills":34,"condition":86,"hardcoreAbility":36,"injuryProne":100,"ability":55,"currentAbility":53,"potentialAbility":59,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Alexandre Freitas is a is a Canadian/Portuguese professional wrestler. After being trained by his father, Freitas debuted in 2004 for Paul LeDuc's FLQ promotion. Initially, Freitas adopted the ring name Sean Simmons, but soon began wrestling under the name Alex Silva. Silva made his Ohio Valley Wrestling (OVW) debut on November 17, 2010. On December 11, Silva won the OVW Television Championship by defeating Mohamad Ali Vaez. His victory made him the youngest Television Champion in the promotion's history. On the April 26, 2012, episode of Impact Wrestling, Silva made his televised TNA debut in a losing effort to Robbie E as part of the TNA Gut Check. On the following week's episode, Al Snow, Bruce Prichard and Ric Flair voted to give Silva a TNA contract after he cut a promo and he became part of the official roster.","alterEgos":[],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[587,2821],"staffAttributes":{"bookingLogic":38,"storytelling":45,"productFit":60,"riskTaking":44,"matchLayout":47,"psychology":38,"workerManagement":60,"trainingIntensity":84,"technicalCoaching":44,"characterCoaching":36,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":36,"brandBuilding":51,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":12,"reactionSpeed":84,"consistency":49,"awareness":38,"judgement":47},"picture":"alex silva.png"},{"id":108,"name":"Madison Rayne","realName":"Madison Rayne","nickname":"","type":"trainer","promotionId":49,"base":"USA","gender":"F","weight":114,"height":157,"dateOfBirth":"1986-02-05T00:00:00.000Z","debut":"2005-05-01T00:00:00.000Z","wage":16400,"wageType":"per-appearance","popularity":20,"charisma":76,"micSkills":67,"condition":86,"hardcoreAbility":93,"injuryProne":100,"ability":71,"currentAbility":63,"potentialAbility":63,"morale":"poor","pr