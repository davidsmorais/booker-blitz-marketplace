d by Atsushi Kotoge and Daisuke Harada.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2569","wrestlerId":2569,"promotionId":45,"startDate":"2017-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":25600,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":62,"storytelling":68,"productFit":100,"riskTaking":22,"matchLayout":70,"psychology":62,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":62,"characterCoaching":74,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":74,"brandBuilding":42,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":84,"awareness":62,"judgement":77},"picture":"Tadasuke.png"},{"id":2571,"name":"India Sioux","realName":"India Sioux","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"F","weight":117,"height":157,"dateOfBirth":"1984-09-20T00:00:00.000Z","debut":"2004-04-01T00:00:00.000Z","wage":32000,"wageType":"per-appearance","popularity":2,"charisma":66,"micSkills":66,"condition":84,"hardcoreAbility":67,"injuryProne":87,"ability":47,"currentAbility":40,"potentialAbility":43,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"India Sioux is a masked Mexican luchadora who works exclusively in Mexico. She is a Small worker who is classed as using a Luchador style. She is best known for her work with CMLL.","alterEgos":[],"birthplace":"Nezahualcóyotl, Mexico","managerId":0,"contractExpiryDate":"2026-09-22T00:00:00.000Z","contract":{"id":"tew-contract-2571","wres