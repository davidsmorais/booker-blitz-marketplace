avvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":75,"awareness":63,"judgement":78},"picture":"Tyson Dux.png"},{"id":1612,"name":"Josh Alexander","realName":"Josh Alexander","nickname":"","type":"wrestler","promotionId":76,"base":"Canada","gender":"M","weight":240,"height":182,"dateOfBirth":"1987-05-29T00:00:00.000Z","debut":"2006-02-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":28,"charisma":74,"micSkills":73,"condition":83,"hardcoreAbility":94,"injuryProne":100,"ability":78,"currentAbility":78,"potentialAbility":82,"morale":"poor","presentation":"heel","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Josh Alexander is a Canadian wrestler who works in America, Canada and Oceania. He is a Middleweight who is classed as using a Technician style. He is one half of The North alongside Ethan Page. He is best known for his work with TNA, DEFY, EVOLVE, BLP, AAW, AIW, Smash, C4 and A1. He is married to someone outside the wrestling business.","alterEgos":[],"birthplace":"Bolton, Ontario, Canada","managerId":0,"contractExpiryDate":"2027-04-16T00:00:00.000Z","contract":{"id":"tew-contract-1612","wrestlerId":1612,"promotionId":76,"startDate":"2025-04-16T00:00:00.000Z","endDate":"2027-04-16T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"additionalContracts":[{"id":"tew-contract-1612-118","wrestlerId":1612,"promotionId":118,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":10500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1469,1867,2157,2278,2671,2672,2673,3332],"staffAttribu