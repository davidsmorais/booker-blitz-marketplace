and. Under the Freebird Rule, Jaggi held the IPW:UK Tag Team Championship with Castagnoli and Roudin for a record 12 months. After his marriage to Allison Danger in 2008, Jaggi followed Castagnoli to the United States. He made a surprise appearance at Chikara's “Three-Fisted Tales” show where he and Castagnoli reunited to form the \"heel\" stable BDK in 2009, and went on to win the 2010 King of Trios with fellow stablemate Tursas.","alterEgos":[],"birthplace":"Switzerland","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[419],"staffAttributes":{"bookingLogic":66,"storytelling":69,"productFit":100,"riskTaking":17,"matchLayout":70,"psychology":66,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":65,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":66,"brandBuilding":42,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":70,"awareness":66,"judgement":80},"picture":"Ares.png"},{"id":1534,"name":"Sidney Bakabella","realName":"Joey Eastman","nickname":"","type":"commentator","base":"USA","gender":"M","weight":206,"height":170,"dateOfBirth":"1981-05-13T00:00:00.000Z","debut":"2003-06-01T00:00:00.000Z","wage":1000,"popularity":0,"charisma":50,"micSkills":40,"condition":100,"hardcoreAbility":39,"injuryProne":93,"ability":55,"currentAbility":44,"potentialAbility":44,"morale":"broken","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Joey Eastman is a professional wrestling manager, announcer and occasional wrestler. He is known these days for portraying the character Sidney Bakabella.","alterEgos":["Joey Eastman"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jo