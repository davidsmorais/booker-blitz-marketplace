ral championships before taking her craft to the United States and eventually signing with WWE and joining the Performance Center. In short order, Hartwell has demonstrated that she possesses what it takes to be a major player for years to come, competing against some of the black-and-gold brand’s best. In what may prove to be a pivotal move for her trajectory, Hartwell worked to win the favor of veteran Candice LeRae in sometimes dastardly fashion, with The Poison Pixie eventually taking the younger prospect under her wing.","alterEgos":[],"birthplace":"Melbourne, Victoria, Australia","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3075","wrestlerId":3075,"promotionId":28,"startDate":"2025-04-28T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2330,2623,2827,2828,2829],"staffAttributes":{"bookingLogic":43,"storytelling":47,"productFit":45,"riskTaking":33,"matchLayout":48,"psychology":43,"workerManagement":45,"trainingIntensity":66,"technicalCoaching":46,"characterCoaching":72,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":72,"brandBuilding":71,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":9,"reactionSpeed":66,"consistency":61,"awareness":43,"judgement":44},"picture":"Indi Hartwell.png"},{"id":3076,"name":"Flammer","realName":"Lady Flammer","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"F","weight":130,"height":154,"dateOfBirth":"1999-11-09T00:00:00.000Z","debut":"2009-04-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":5,"charisma":63,"micSkills":53,"condition":100,"hardcoreAbility":68,"injuryProne":100,"ability":60,"currentAbility":59,"potentialAbility":79,"morale":"broken","presentation":"heel","prestige":"low"