lse,"retired":true,"dead":false,"inDevelopment":false,"story":"Scott D'Amore, a 1992 graduate of the Can-Am Wrestling School, is a retired Canadian wrestler who works as a manager and a road agent. He is best known for his work with IMPACT. He is the current owner of IMPACT.","alterEgos":[],"birthplace":"Canada","managerId":0,"contractExpiryDate":"2026-08-08T00:00:00.000Z","contract":{"id":"tew-contract-1163","wrestlerId":1163,"promotionId":118,"startDate":"2024-08-08T00:00:00.000Z","endDate":"2026-08-08T00:00:00.000Z","wage":10500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":76,"storytelling":79,"productFit":100,"riskTaking":38,"matchLayout":80,"psychology":76,"workerManagement":100,"trainingIntensity":29,"technicalCoaching":53,"characterCoaching":68,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":68,"brandBuilding":36,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":29,"consistency":39,"awareness":76,"judgement":86},"picture":"Scott D'Amore.png"},{"id":1165,"name":"Ice Cream Jr.","realName":"Ice Cream Jr.","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":207,"height":187,"dateOfBirth":"1984-10-19T00:00:00.000Z","debut":"2005-10-01T00:00:00.000Z","wage":37500,"popularity":0,"charisma":39,"micSkills":54,"condition":90,"hardcoreAbility":49,"injuryProne":100,"ability":58,"currentAbility":50,"potentialAbility":50,"morale":"broken","presentation":"face","prestige":"low","style":"comedy","cardPosition":"lower","finisher":"","finisherType":"counter","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"Ice Cream Jr. is one half of the CHIKARA tag team Los Ice Creams with El Hijo del Ice Cream. The duo were trained in Mexico by Bobby Lee. He has been wrestling on the indy scene since 2005.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":54,"storytelling":57,"productFit":100,"riskTaking":29,"matchLayout":58,"psychology":54,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":54,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":65,"brandBuilding":40,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":55,"awareness":54,"judgement":72},"picture":"Ice Cream Jr.png"},{"id":1167,"name":"Ryan Howe","realName":"Ryan Howe","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":220,"height":180,"dateOfBirth":"1987-08-23T00:00:00.000Z","debut":"2011-05-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":35,"micSkills":36,"condition":94,"hardcoreAbility":36,"injuryProne":100,"ability":49,"currentAbility":44,"potentialAbility":48,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Howe began working for Ohio Valley Wrestling (OVW) during May 2011. He has since been known for his musical gimmick being a rock guitar player. He won his first title in OVW on the August 8, 2012 edition of OVW TV, winning the OVW Television Championship by defeating Rob Terry and reigning champion Tony Gunn. He later dropped the title to Alex Silva in a match during the September 12 2012 edition of OVW TV. Howe was invited onto the televised programming of Total Nonstop Action Wrestling (TNA) during its July edition of the TNA Gutcheck. During the video promos for the competition, Howe described his musical background and how it led into his choice of entering professional wrestling.","alterEgos":["Diamond Steele"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2819],"staffAttributes":{"bookingLogic":38,"storytelling":42,"productFit":30,"riskTaking":29,"matchLayout":44,"psychology":38,"workerManagement":30,"trainingIntensity":77,"technicalCoaching":42,"characterCoaching":55,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":55,"brandBuilding":57,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":6,"reactionSpeed":77,"consistency":75,"awareness":38,"judgement":35},"picture":"Ryan Howe_alt.png"},{"id":1172,"name":"El Hijo del Santo","realName":"El Hijo del Santo","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":185,"height":167,"dateOfBirth":"1963-08-02T00:00:00.000Z","debut":"1982-02-01T00:00:00.000Z","wage":37500,"popularity":24,"charisma":60,"micSkills":68,"condition":53,"hardcoreAbility":58,"injuryProne":96,"ability":73,"currentAbility":35,"potentialAbility":35,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":true,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"El Hijo del Santo is a Mexican professional wrestler, political activist and one of the most successful stars in Lucha Libre. He is the youngest son of the legendary professional wrestler, film actor and Mexican folk hero El Santo. \"Santito\", as he is often called, was the only one of his father's 10 children to become a professional wrestler. He began wrestling without his father's consent in February 1982 as \"El Korak\" but he made his official debut as \"El Hijo del Santo\" in October of that year after he earned his college degree in Communication Science per his father's request.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2921,3164],"staffAttributes":{"bookingLogic":87,"storytelling":89,"productFit":100,"riskTaking":23,"matchLayout":89,"psychology":87,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":64,"characterCoaching":84,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":84,"brandBuilding":88,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":53,"awareness":87,"judgement":92},"picture":"Hijo del Santo.png"},{"id":1173,"name":"The Great Sasuke","realName":"The Great Sasuke","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":194,"height":172,"dateOfBirth":"1969-07-18T00:00:00.000Z","debut":"1990-03-01T00:00:00.000Z","wage":4166,"popularity":13,"charisma":64,"micSkills":76,"condition":55,"hardcoreAbility":53,"injuryProne":100,"ability":71,"currentAbility":41,"potentialAbility":43,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Masanori Murakawa is a Japanese professional wrestler, known by his ring name The Great Sasuke as well as a former Iwate Prefectural Assembly legislator. He has wrestled in Japan and in the United States in various wrestling promotions. He is said to have an incredible tolerance for pain, mainly in reference to the injuries he has had including a cracked skull. Sasuke still currently wrestles in Michinoku Pro Wrestling, although he left the running of the promotion to Shinzaki in 2003 to focus on his political career. On April 15, 2011, Sasuke returned to the United States to wrestle for Chikara in the 2011 King of Trios tournament, where he would represent Michinoku Pro with Dick Togo and Jinsei Shinzaki.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":81,"storytelling":85,"productFit":100,"riskTaking":28,"matchLayout":87,"psychology":81,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":62,"characterCoaching":43,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":43,"brandBuilding":62,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":49,"awareness":81,"judgement":89},"picture":"The Great Sasuke.png"},{"id":1175,"name":"Ryuji Ito","realName":"Ryuji Ito","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":209,"height":180,"dateOfBirth":"1976-04-08T00:00:00.000Z","debut":"1999-04-01T00:00:00.000Z","wage":4166,"popularity":5,"charisma":77,"micSkills":73,"condition":71,"hardcoreAbility":76,"injuryProne":100,"ability":59,"currentAbility":42,"potentialAbility":44,"morale":"broken","presentation":"face","prestige":"low","style":"hardcore","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ryuji Ito is a Japanese professional wrestler currently competing in Big Japan Pro Wrestling. He is well known for his death match style of wrestling. Ito, whose gimmick is reminiscent of the Mortal Kombat icon Liu Kang, has been known for competing in many deathmatches over the span of his career, including a Cage match variation which saw him defeat Kintaro Kanemura. Ito is perhaps most famous for participating in an infamous \"Lightube Lightsaber match\" in which he fought and defeated Abdullah Kobayashi. The match has since become a hit video among hardcore wrestling fans on the website YouTube.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1825],"staffAttributes":{"bookingLogic":69,"storytelling":72,"productFit":100,"riskTaking":38,"matchLayout":73,"psychology":69,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":54,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":54,"brandBuilding":58,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":73,"awareness":69,"judgement":81},"picture":"Ryuji Ito.png"},{"id":1176,"name":"Trevor Murdoch","realName":"Trevor Murdoch","nickname":"","type":"writer","base":"USA","gender":"M","weight":241,"height":190,"dateOfBirth":"1980-09-10T00:00:00.000Z","debut":"1999-01-01T00:00:00.000Z","wage":66000,"popularity":14,"charisma":91,"micSkills":81,"condition":65,"hardcoreAbility":100,"injuryProne":100,"ability":91,"currentAbility":72,"potentialAbility":72,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Trevor Murdoch is a retired American wrestler who works primarily as a road agent. He is best known for his work with WWE, NOAH, TNA, NWA, CWFH and IWA-MS. He is married to someone outside the wrestling business.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2820,3086,3831],"staffAttributes":{"bookingLogic":67,"storytelling":68,"productFit":100,"riskTaking":22,"matchLayout":68,"psychology":67,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":53,"characterCoaching":61,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":61,"brandBuilding":42,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":83,"awareness":67,"judgement":80},"picture":"Trevor Murdock.png"},{"id":1177,"name":"Austin Creed","realName":"Xavier Woods","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":205,"height":172,"dateOfBirth":"1986-09-04T00:00:00.000Z","debut":"2005-06-01T00:00:00.000Z","wage":4166,"wageType":"monthly","popularity":50,"charisma":88,"micSkills":84,"condition":85,"hardcoreAbility":80,"injuryProne":100,"ability":62,"currentAbility":62,"potentialAbility":76,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"It’s a New Day, yes it is! And, without a doubt, Xavier Woods is a huge part of it.\r\n\r\nA dynamic Superstar with plenty of brains — he's currently earning his Ph.D. in educational psychology in addition to his two bachelor's degrees in psychology and philosophy and a master's in psychology — Woods is far more intelligent than his off-key trombone bleating may let on. He's damn good in the ring, too, snatching multiple WWE Tag Team Championships alongside his New Day crew of Big E and Kofi Kingston.\r\n\r\nLegit pop-culture phenoms, The New Day proved their place in sports-entertainment history by setting the record for the longest Tag Team Championship reign in WWE history. They also released their own Booty-O’s cereal, hosted WrestleMania and brought some much-needed magic and wonder back to WWE.","alterEgos":["Austin Creed","Consequences Creed"],"birthplace":"Columbus, Georgia, United States","managerId":0,"contractExpiryDate":"2028-10-23T00:00:00.000Z","contract":{"id":"contract-bbdb-1177","wrestlerId":1177,"promotionId":76,"startDate":"2025-07-01T00:00:00.000Z","endDate":"2028-10-23T00:00:00.000Z","wage":4166,"wageType":"monthly","type":"exclusive","status":"active"},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1248,1249,2653,3660,4402],"staffAttributes":{"bookingLogic":69,"storytelling":72,"productFit":100,"riskTaking":20,"matchLayout":73,"psychology":69,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":58,"characterCoaching":83,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":83,"brandBuilding":67,"socialMediaSavvy":77,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":74,"awareness":69,"judgement":81},"picture":"Austin Creed.png"},{"id":1178,"name":"Kohei Sato","realName":"Kohei Sato","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":264,"height":190,"dateOfBirth":"1977-09-21T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":68,"micSkills":71,"condition":82,"hardcoreAbility":69,"injuryProne":100,"ability":60,"currentAbility":44,"potentialAbility":46,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"One of ZERO1's most consistent performers, Kohei Sato is veteran who is among ZERO1's top tag team wrestlers and has had some singles success. In April 2010 Sato finally broke through, defeating outsider Toshiaki Kawada for the title, bringing the belt back to ZERO1 and ending Kawada’s nearly 6 month reign as champion. In addition to 4 NWA Intercontinental Tag Team Title reigns he has also held the All-Japan All-Asia Tag Team Title, the WEW Tag Team Title, the NWA UN Heavyweight Title and the ZERO1-MAX US Openweight Title and was the 2004 Fire Festival winner. Before debuting in wrestling, Sato briefly competed in MMA. He fought twice for Shooto in 1999, winning both fights. He appeared at the inaugral W-1 event.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1730,2885,2886,2904,2905],"staffAttributes":{"bookingLogic":69,"storytelling":74,"productFit":100,"riskTaking":15,"matchLayout":75,"psychology":69,"workerManagement":100,"trainingIntensity":70,"technicalCoaching":67,"characterCoaching":35,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":85,"mediaHandling":35,"brandBuilding":54,"socialMediaSavvy":37,"ruleKnowledge":0,"positioning":20,"reactionSpeed":70,"consistency":63,"awareness":69,"judgement":81},"picture":"Kohei Sato.png"},{"id":1179,"name":"Ryouji Sai","realName":"Ryouji Sai","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":235,"height":185,"dateOfBirth":"1980-06-03T00:00:00.000Z","debut":"2001-09-01T00:00:00.000Z","wage":4166,"popularity":4,"charisma":60,"micSkills":52,"condition":78,"hardcoreAbility":79,"injuryProne":100,"ability":75,"currentAbility":59,"potentialAbility":61,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ryouji Sai is a 3rd Generation Zainichi Korean that was born in Osaka, Japan. At 15 years old, Ryouji attended the Sidmouth International School in Sidmouth, England. While in Europe he studied Martial Arts under Gerard Gordeau in the Netherlands. When he returned to Japan he joined Pro Wrestling ZERO-ONE, debuting on September 1, 2001 at the ZERO-ONE \"FIRE FESTIVAL 2001\" versus Igor Meindert. in a non-tournament match. From 2002 to 2004, he would be out of pro wrestling with an unknown ailment. Returning in 2004, he would begin to regularly team with Kohei Sato winning the NWA Intercontinental Tag Team Championship in 2005 and 2006. Ryoji twice finished as the runner-up in ZERO1 Fire Festival tournaments in both 2007 and 2006, losing to Masato Tanaka. He also regularly appeared for the HUSTLE wrestling promotion during Pro Wrestling ZERO1's working agreement with them.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2306,2885],"staffAttributes":{"bookingLogic":67,"storytelling":72,"productFit":100,"riskTaking":44,"matchLayout":73,"psychology":67,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":65,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":56,"brandBuilding":54,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":55,"awareness":67,"judgement":80},"picture":"Ryoji Sai.png"},{"id":1180,"name":"Taiyo Kea","realName":"Taiyo Kea","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":233,"height":182,"dateOfBirth":"1975-11-18T00:00:00.000Z","debut":"1994-11-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":64,"micSkills":69,"condition":72,"hardcoreAbility":48,"injuryProne":100,"ability":65,"currentAbility":45,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Maunakea Mossman is an American professional wrestler, better known under his stage name Taiyo Kea. Although he was born in Hawaii, he has spent nearly his entire career as a member of the Japan-based All Japan Pro Wrestling promotion. He is the only wrestler to have held the AJPW Triple Crown Heavyweight Championship, the AJPW Unified World Tag Team Championship and the AJPW World Junior Heavyweight Championship. Mossman was a Hawaiian state amateur champion, and was scouted by Giant Baba during a trip to the islands. Debuting in 1994 as a junior heavyweight, Mossman was pushed immediately, winning the AJPW World Junior Heavyweight Title in 1997.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3057],"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":24,"matchLayout":75,"psychology":68,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":62,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":62,"brandBuilding":60,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":71,"awareness":68,"judgement":81},"picture":"Taiyo Kea.png"},{"id":1181,"name":"Becky Lynch","realName":"Becky Lynch","nickname":"","type":"wrestler","promotionId":64,"base":"UK","gender":"F","weight":135,"height":165,"dateOfBirth":"1987-01-30T00:00:00.000Z","debut":"2002-11-01T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":71,"charisma":100,"micSkills":86,"condition":77,"hardcoreAbility":100,"injuryProne":100,"ability":84,"currentAbility":84,"potentialAbility":88,"morale":"great","presentation":"heel","prestige":"high","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Hardened by a career defined by betrayal, disappointment and underestimation, Becky Lynch decided to take her destiny into her own hands and force her way to the top of the mountain by throwing off anyone, friend or foe, who was blocking her path. The results speak for themselves. Lynch gave the Women’s division a shot in the arm in 2018 when she won her second SmackDown Women’s Championship, leading an invasion of Raw that left Ronda Rousey demoralized and humiliated — this despite Becky suffering a concussion in the process. The Man made her mark again by winning the 2019 Royal Rumble Match to earn a World Championship opportunity at WrestleMania 35. That opportunity eventually became the first women’s main event in WrestleMania history where The Man defeated Raw Women’s Champion Ronda Rousey and SmackDown Women’s Champion Charlotte Flair to claim both titles in their Winner Take All Match.","alterEgos":["Becky Knox"],"birthplace":"Limerick, Ireland","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1181","wrestlerId":1181,"promotionId":64,"startDate":"2025-01-07T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":80,"storytelling":81,"productFit":100,"riskTaking":22,"matchLayout":81,"psychology":80,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":72,"characterCoaching":88,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":88,"brandBuilding":88,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":73,"awareness":80,"judgement":88},"picture":"Becky Lynch.png"},{"id":1182,"name":"Adam Scherr","realName":"Adam Scherr","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":385,"height":200,"dateOfBirth":"1983-09-06T00:00:00.000Z","debut":"2014-12-01T00:00:00.000Z","wage":37500,"popularity":54,"charisma":74,"micSkills":75,"condition":71,"hardcoreAbility":76,"injuryProne":100,"ability":49,"currentAbility":49,"potentialAbility":82,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Adam Scherr, a 2014 graduate of the WWE Performance Center, is an American wrestler who works in America and Canada. He is a Big Heavyweight who is classed as using a Powerhouse style. He is best known for his work with WWE, NXT and ROH. He is dating someone outside the wrestling business.","alterEgos":["The Titan","Braun Strowman"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1526,3712],"staffAttributes":{"bookingLogic":61,"storytelling":60,"productFit":100,"riskTaking":22,"matchLayout":60,"psychology":61,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":19,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":73,"brandBuilding":86,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":76,"awareness":61,"judgement":77},"picture":"Braun Strowman_alt6.png","injury":{"type":"Knee Ligament Damage","daysToRecover":-4},"returnDate":"2026-04-08T00:00:00.000Z"},{"id":1185,"name":"Rikishi","realName":"Rikishi","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":425,"height":182,"dateOfBirth":"1965-10-11T00:00:00.000Z","debut":"1985-10-01T00:00:00.000Z","wage":37500,"popularity":15,"charisma":43,"micSkills":38,"condition":57,"hardcoreAbility":55,"injuryProne":81,"ability":51,"currentAbility":26,"potentialAbility":76,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Solofa Fatu Jr. is a Samoan American professional wrestler, best known under the ring name Rikishi (which means sumo wrestler in Japanese) with World Wrestling Entertainment (WWE), where he was a one time Intercontinental Champion, two time World Tag Team Champion, and one time WWE Tag Team Champion. Solofa Fatu, Jr. first got the fans attention in 1985 as he worked for Gino Brito and Dino Bravo’s “International Wrestling\" territory based in Montreal.","alterEgos":["Fatu","The Sultan"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2826],"staffAttributes":{"bookingLogic":69,"storytelling":71,"productFit":100,"riskTaking":26,"matchLayout":71,"psychology":69,"workerManagement":100,"trainingIntensity":35,"technicalCoaching":8,"characterCoaching":80,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":80,"brandBuilding":51,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":35,"consistency":57,"awareness":69,"judgement":81},"picture":"Rikishi.png"},{"id":1188,"name":"Santana Garrett","realName":"Santana Garrett","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":140,"height":162,"dateOfBirth":"1988-05-22T00:00:00.000Z","debut":"2009-08-01T00:00:00.000Z","wage":37500,"popularity":11,"charisma":58,"micSkills":46,"condition":90,"hardcoreAbility":39,"injuryProne":100,"ability":51,"currentAbility":47,"potentialAbility":62,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Santana Garrett is an American wrestler who works in America, Canada and Japan. She is a Small worker who is classed as using a Regular Wrestler style. Garrett began her career in Bruno Sassi's South Florida based Coastal Championship Wrestling on November 27, 2009 event, where she defeated Kimberly to win the CCW Ladies Championship in her debut match. Santana Garrett, as Santana G appeared in IWA Mid-South on March 26, where she faced Jessika Haze, in a winning effort. Garrett made her debut for Shimmer Women Athletes, on September 27, 2012 at Volume 50, where she competed against Mercedes Martinez in a losing effort. In mid-August 2019, it was announced that Garrett has been officially signed to a contract and will report to the Performance Center before she appears in the developmental company NXT.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[661,3107],"staffAttributes":{"bookingLogic":57,"storytelling":61,"productFit":100,"riskTaking":27,"matchLayout":62,"psychology":57,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":55,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":56,"brandBuilding":68,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":69,"awareness":57,"judgement":74},"picture":"Santana Garrett_alt4.png"},{"id":1191,"name":"Jimmy Korderas","realName":"Jimmy Korderas","nickname":"","type":"referee","base":"Canada","gender":"M","weight":209,"height":177,"dateOfBirth":"1962-03-19T00:00:00.000Z","debut":"1985-03-01T00:00:00.000Z","wage":66000,"popularity":9,"charisma":80,"micSkills":87,"condition":100,"hardcoreAbility":87,"injuryProne":80,"ability":79,"currentAbility":37,"potentialAbility":39,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Demetrius Korderas  better known by his referee name, Jim \"Jimmy\" Korderas is a Canadian professional wrestling referee who worked for World Wrestling Entertainment for over 22 years. On January 9, 2009, WWE released Korderas from his contract.  On May 12, 2012 Jim Korderas refereed a match at Ring of Honor's Internet Pay-Per View entitled Border Wars. He has also been known to do some announcing since leaving WWE.","alterEgos":[],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":19,"technicalCoaching":0,"characterCoaching":37,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":37,"brandBuilding":19,"socialMediaSavvy":15,"ruleKnowledge":83,"positioning":66,"reactionSpeed":19,"consistency":0,"awareness":0,"judgement":0},"picture":"Jimmy Korderas.png"},{"id":1192,"name":"Afa Jr.","realName":"Afa Jr.","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":253,"height":182,"dateOfBirth":"1984-10-06T00:00:00.000Z","debut":"1998-08-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":56,"micSkills":56,"condition":78,"hardcoreAbility":54,"injuryProne":100,"ability":44,"currentAbility":38,"potentialAbility":41,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Afa Anoa'i, Jr. is an American professional wrestler of Samoan descent. He is best known for his work in World Wrestling Entertainment, where he competed on its Raw brand under the ring name Manu. Anoa'i began training as a wrestler under his father, Afa, and brothers, Lloyd and Samula He made his debut on August 28, 1998 at the age of 13, winning a battle royal in Austria. In October 2006, Anoa'i received a try-out with World Wrestling Entertainment, held at the Deep South Wrestling development territory. Later that month, Anoa'i officially signed with WWE, going under his father's ring name, \"Afa\".  At Unforgiven 2008, Anoa'i made his debut on the full-time roster under the name \"Manu\". On April 18, 2009, Anoa'i returned to the independent circuit at a World Xtreme Wrestling (WXW) show.","alterEgos":["Manu"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[723],"staffAttributes":{"bookingLogic":50,"storytelling":54,"productFit":100,"riskTaking":32,"matchLayout":55,"psychology":50,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":44,"characterCoaching":55,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":68,"mediaHandling":55,"brandBuilding":55,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":56,"awareness":50,"judgement":70},"picture":"Afa Anoai Jr.png"},{"id":1193,"name":"Melina","realName":"Melina","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":121,"height":160,"dateOfBirth":"1979-03-09T00:00:00.000Z","debut":"2002-04-01T00:00:00.000Z","wage":37500,"popularity":23,"charisma":57,"micSkills":51,"condition":75,"hardcoreAbility":40,"injuryProne":100,"ability":55,"currentAbility":42,"potentialAbility":74,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Melina began her career as a fashion model, but the wrestling bug bit the Los Angeles native in 2000 when she began training at the School of Hard Knocks in San Bernardino, Calif. She continued to work various wrestling shows, honing her in-ring abilities.\r\n\r\nHer dream was finally realized in 2003 when WWE signed her in San Diego. Melina soon became known as a force to be reckoned with as a manager and then in the Divas division when she debuted on SmackDown as the manager of MNM (Mercury, Nitro and Melina). She credited the experience of training with both men and women for making her tougher and stronger. You simply must take the hits, she believed, and keep on going.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":62,"storytelling":66,"productFit":100,"riskTaking":27,"matchLayout":67,"psychology":62,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":51,"characterCoaching":72,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":72,"brandBuilding":63,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":66,"awareness":62,"judgement":77},"picture":"Melina Perez.png"},{"id":1194,"name":"Reby Sky","realName":"Reby Sky","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":114,"height":162,"dateOfBirth":"1986-08-06T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","wage":37500,"popularity":9,"charisma":48,"micSkills":19,"condition":94,"hardcoreAbility":51,"injuryProne":95,"ability":35,"currentAbility":31,"potentialAbility":35,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Reby Sky was an American wrestler who has since left the business. She is best known for her work with IMPACT and SHINE. She is married to Matt Hardy.","alterEgos":["Reby Hardy"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":38,"storytelling":40,"productFit":16,"riskTaking":38,"matchLayout":41,"psychology":38,"workerManagement":16,"trainingIntensity":48,"technicalCoaching":25,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":70,"brandBuilding":54,"socialMediaSavvy":63,"ruleKnowledge":0,"positioning":3,"reactionSpeed":48,"consistency":65,"awareness":38,"judgement":29},"picture":"Reby Sky.png"},{"id":1195,"name":"Thea Trinidad","realName":"Thea Trinidad","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":106,"height":152,"dateOfBirth":"1990-12-27T00:00:00.000Z","debut":"2010-02-01T00:00:00.000Z","wage":37500,"popularity":40,"charisma":35,"micSkills":29,"condition":100,"hardcoreAbility":50,"injuryProne":100,"ability":37,"currentAbility":35,"potentialAbility":61,"morale":"fair","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Thea Trinidad is an American wrestler who works exclusively in North America. She is a 5'1\", 106lb worker who is classed as using a High Flyer style. She uses the Cutter and the Moonsault as her finishers. She is best known for her work with WWE, TNA and NXT. She is currently the WWE Women's United States champion. She is married to Malakai Black. She was voted Female Manager Of The Year in 2017.","alterEgos":["Zelina Vega"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2784],"staffAttributes":{"bookingLogic":48,"storytelling":50,"productFit":53,"riskTaking":34,"matchLayout":50,"psychology":48,"workerManagement":53,"trainingIntensity":68,"technicalCoaching":29,"characterCoaching":79,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":79,"brandBuilding":68,"socialMediaSavvy":74,"ruleKnowledge":0,"positioning":11,"reactionSpeed":68,"consistency":63,"awareness":48,"judgement":50},"picture":"Rosita.png"},{"id":1196,"name":"Shawn Daivari","realName":"Shawn Daivari","nickname":"","type":"writer","promotionId":64,"base":"USA","gender":"M","weight":189,"height":175,"dateOfBirth":"1984-04-30T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":50000,"wageType":"per-appearance","popularity":9,"charisma":79,"micSkills":80,"condition":76,"hardcoreAbility":87,"injuryProne":100,"ability":88,"currentAbility":76,"potentialAbility":76,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Iranian American Dara Shawn Daivari lived the American dream. Signing a lucrative contract before his 21st birthday, winning championships around the world and gaining immense notoriety. However, this all left him unfulfilled and, ultimately a lost soul.\r\n\r\nIt wasn’t until Daivari journeyed abroad and discovered the black flag of CONTRA Unit. Reemerging a different man both physically with more muscularity than before and mentally, Daivari is on the frontlines of CONTRA’s war against the world, and specifically MLW.\r\n\r\nGuided early on by Adnan Al-Kaissie, Daivari has found what he believes is enlightenment through CONTRA. Fanatically loyal to Josef Samael, Daivari has sworn allegiance to CONTRA. A soldier in CONTRA’s war against MLW and a world of structure and perceived decadence, this foot soldier vows to be CONTRA’s greatest warrior.","alterEgos":["Daivari","Abdul Bashir"],"birthplace":"Minneapolis, Minnesota, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1196","wrestlerId":1196,"promotionId":64,"startDate":"2021-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[748,1502,2747],"staffAttributes":{"bookingLogic":73,"storytelling":74,"productFit":100,"riskTaking":17,"matchLayout":74,"psychology":73,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":57,"characterCoaching":54,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":54,"brandBuilding":54,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":71,"awareness":73,"judgement":84},"picture":"Shawn Daivari_alt3.png"},{"id":1198,"name":"Chris Stone","realName":"Chris Stone","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":214,"height":177,"dateOfBirth":"1975-01-22T00:00:00.000Z","debut":"1995-09-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":68,"micSkills":70,"condition":84,"hardcoreAbility":49,"injuryProne":100,"ability":60,"currentAbility":41,"potentialAbility":43,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Chris Stone was a long time CMLL undercarder, teaming with his brother Alan. The team reached a level of popularity, but never got much farther than their initial push and seemed to be eternally stuck in a midcard or lower position. The Stones jumped to AAA in 2005. Chris returned for a short stint back in CMLL, but redebuted in AAA in 2006, and has been a member of Guapos VIP ever since. Chris hasn't had the success (or amount of work) in AAA as his brother. There's a popular myth he may have been under Super Calo (Chris' other brother) mask during his first AAA stint, but there's no evidence to support this.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":28,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":53,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":56,"brandBuilding":53,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":77,"awareness":62,"judgement":77},"picture":"Chris Stone.png"},{"id":1200,"name":"Simon Dean","realName":"Simon Dean","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":216,"height":177,"dateOfBirth":"1972-06-05T00:00:00.000Z","debut":"1990-06-01T00:00:00.000Z","wage":37500,"popularity":7,"charisma":58,"micSkills":45,"condition":75,"hardcoreAbility":47,"injuryProne":95,"ability":68,"currentAbility":43,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Michael \"Mike\" Bucci is probably best known for his appearances in ECW as Nova, Super Nova and \"Hollywood\" Nova and WWE as Simon Dean ,he was also a member of the blue World order, He now wrestles the odd matches on the Indy Circuit. On August 8, 2010, Bucci took part in Total Nonstop Action Wrestling's ECW reunion show, Hardcore Justice, where he, as Hollywood Nova, accompanied Stevie Richards to the ring and later attacked Tommy Dreamer during his match with Raven.","alterEgos":["Nova","Hollywood Nova"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2665,2928,3296,3305,3306],"staffAttributes":{"bookingLogic":61,"storytelling":70,"productFit":100,"riskTaking":43,"matchLayout":73,"psychology":61,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":58,"characterCoaching":69,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":57,"mediaHandling":69,"brandBuilding":58,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":70,"awareness":61,"judgement":77},"picture":"Simon Dean.png"},{"id":1202,"name":"Mascarita Dorada","realName":"Mascarita Dorada","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":110,"height":132,"dateOfBirth":"1982-02-19T00:00:00.000Z","debut":"2000-01-01T00:00:00.000Z","wage":37500,"popularity":11,"charisma":44,"micSkills":68,"condition":81,"hardcoreAbility":54,"injuryProne":96,"ability":49,"currentAbility":41,"potentialAbility":43,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Mascarita Dorada is the ring name of a Mexican Luchador enmascarado, or masked professional wrestler, who worked in the Mini-Estrella division, comparable to the U.S. Midget professional wrestling division, currently signed with WWE under the name of El Torito (Spanish for The Little Bull). From 2000 until 2007 he worked under the name Mascarita Sagrada in Asistencia Asesoría y Administración (AAA), taking over after the original Mascarita Sagrada left AAA. In 2007 he moved from AAA to join Consejo Mundial de Lucha Libre (CMLL) he changed name to Mascarita Dorada. After leaving CMLL in 2011, he began wrestling for El Hijo del Santo under the ring name Mascarita Plateada, while also returning to AAA under the Mascarita Dorada ring name.","alterEgos":["El Torito","Mascarita Sagrada","Minihausen"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":59,"storytelling":66,"productFit":100,"riskTaking":31,"matchLayout":68,"psychology":59,"workerManagement":100,"trainingIntensity":64,"technicalCoaching":64,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":67,"brandBuilding":42,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":64,"consistency":56,"awareness":59,"judgement":75},"picture":"Mascarita Dorada.png"},{"id":1203,"name":"Swoggle","realName":"Swoggle","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":142,"height":132,"dateOfBirth":"1989-05-29T00:00:00.000Z","debut":"2004-05-01T00:00:00.000Z","wage":37500,"popularity":14,"charisma":22,"micSkills":39,"condition":75,"hardcoreAbility":40,"injuryProne":84,"ability":24,"currentAbility":23,"potentialAbility":38,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Debuting in 2006, Hornswoggle was first seen as a cackling fiend who capered out from under the ring to wreak havoc on the opponents of fellow countryman Fit Finlay. His madcap antics soon earned him an unprintable nickname from Michael Cole, one that stuck with him until his real name was revealed the following year.\r\n\r\nShortly after the disclosure of Hornswoggle’s name, the little man shocked the world when he defeated Jamie Noble for the Cruiserweight Championship. The title’s retirement in September 2007 meant that Hornswoggle was the last Superstar ever to reign as Cruiserweight Champion. In a short time, Hornswoggle locked horns with Superstars such as Chavo Guerrero and The Miz, rocked out with 3MB and was revealed to be the anonymous Raw General Manager. Not bad for a guy who could grow a beard before he was able to form a coherent sentence.","alterEgos":["Hornswoggle","The Big Deal","$hortstack"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1767,2682,3519],"staffAttributes":{"bookingLogic":35,"storytelling":40,"productFit":50,"riskTaking":38,"matchLayout":41,"psychology":35,"workerManagement":50,"trainingIntensity":50,"technicalCoaching":12,"characterCoaching":60,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":60,"brandBuilding":33,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":10,"reactionSpeed":50,"consistency":62,"awareness":35,"judgement":41},"picture":"Hornswoggle.png"},{"id":1204,"name":"Stevie Richards","realName":"Stevie Richards","nickname":"","type":"trainer","base":"USA","gender":"M","weight":230,"height":185,"dateOfBirth":"1971-10-09T00:00:00.000Z","debut":"1992-10-01T00:00:00.000Z","wage":66000,"popularity":7,"charisma":67,"micSkills":71,"condition":73,"hardcoreAbility":61,"injuryProne":100,"ability":57,"currentAbility":35,"potentialAbility":35,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Michael Stephen Manna  is an American professional wrestler and podcaster, better known by the ring name Stevie Richards. He currently works for Lucha Libre USA and previously wrestled for Extreme Championship Wrestling (ECW), World Wrestling Federation/Entertainment (WWF/WWE), Total Nonstop Action Wrestling (TNA), National Wrestling Alliance (NWA) and World Championship Wrestling (WCW). He has also made appearances for Ring Of Honor (ROH). He has held over 40 titles in his career, including the WWE Hardcore Championship 21 times, the ECW World Tag Team Championship twice and the NWA National Heavyweight Championship once.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[515,3267,3268,3307],"staffAttributes":{"bookingLogic":24,"storytelling":58,"productFit":52,"riskTaking":59,"matchLayout":24,"psychology":27,"workerManagement":35,"trainingIntensity":68,"technicalCoaching":81,"characterCoaching":61,"teaching":71,"diagnosis":43,"rehabilitation":37,"prevention":58,"mediaHandling":36,"brandBuilding":21,"socialMediaSavvy":59,"ruleKnowledge":49,"positioning":56,"reactionSpeed":23,"consistency":54,"awareness":35,"judgement":32},"picture":"Stevie Richards_alt3.png"},{"id":1205,"name":"Candice LeRae","realName":"Candice LeRae","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"F","weight":110,"height":154,"dateOfBirth":"1985-09-29T00:00:00.000Z","debut":"2002-09-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":24,"charisma":65,"micSkills":63,"condition":73,"hardcoreAbility":58,"injuryProne":100,"ability":61,"currentAbility":61,"potentialAbility":74,"morale":"poor","presentation":"heel","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The tough Superstar got her first taste of WWE when she competed as one of the top fan-favorites in the inaugural Mae Young Classic tournament, battling her way to the Quarterfinal Round.\r\n\r\nSigning with the WWE Performance Center in January 2018, she soon made her presence felt in NXT when she jumped the barricade during her husband Johnny Gargano’s NXT Title Match, taking out Andrade “Cien” Almas’ business manager Zelina Vega with a flurry of punches. LeRae also displayed her fighting spirit in the 2019 Women's Royal Rumble Match. \r\n\r\nWith a never-say-die attitude, an explosive and high-risk offensive arsenal and unrivaled grit, LeRae is primed to raise the level of competition within NXT’s Women’s division.","alterEgos":[],"birthplace":"Riverside, California, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1205","wrestlerId":1205,"promotionId":64,"startDate":"2022-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2330],"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":28,"matchLayout":70,"psychology":68,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":63,"characterCoaching":72,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":72,"brandBuilding":56,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":63,"awareness":68,"judgement":81},"picture":"Candice LeRae.png"},{"id":1208,"name":"Alexa Bliss","realName":"Alexa Bliss","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"F","weight":102,"height":152,"dateOfBirth":"1991-08-09T00:00:00.000Z","debut":"2013-09-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":56,"charisma":70,"micSkills":76,"condition":86,"hardcoreAbility":61,"injuryProne":100,"ability":70,"currentAbility":70,"potentialAbility":86,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"It almost doesn’t seem possible that so much bad attitude can fit into Alexa Bliss’ 5-foot-1 frame.\r\n\r\nSly, sassy and sporting a whole lot of ferocity, Alexa has been a driven competitor her entire life, participating in softball, track and kickboxing since her youth, excelling especially in gymnastics and eventually becoming a Division I cheerleader. Alexa even entered the world of competitive bodybuilding, where she became one of the youngest competitors to receive her IFBB Professional status.\r\n\r\nWhen she joined SmackDown, Alexa ascended to the top by becoming SmackDown Women's Champion, winning her first title by defeating Becky Lynch in a Tables Match. Then, weeks after joining Monday Night Raw in the Superstar Shake-up, Alexa Bliss made history at WWE Payback, reigning supreme over Bayley in a hard-fought contest to become the first Superstar to win both the SmackDown Women's Title and the Raw Women's Title.","alterEgos":["Lexi Cabrera"],"birthplace":"Columbus, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1208","wrestlerId":1208,"promotionId":64,"startDate":"2018-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1909,3632,4282],"staffAttributes":{"bookingLogic":67,"storytelling":68,"productFit":100,"riskTaking":20,"matchLayout":68,"psychology":67,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":52,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":85,"brandBuilding":78,"socialMediaSavvy":85,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":74,"awareness":67,"judgement":80},"picture":"Alexa Bliss.png"},{"id":1209,"name":"The Godfather","realName":"The Godfather","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":330,"height":195,"dateOfBirth":"1961-05-16T00:00:00.000Z","debut":"1989-05-01T00:00:00.000Z","wage":37500,"popularity":16,"charisma":36,"micSkills":49,"condition":75,"hardcoreAbility":58,"injuryProne":69,"ability":40,"currentAbility":18,"potentialAbility":20,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Charles Wright  is an American businessman and semi-retired professional wrestler. Wright first entered professional wrestling after being noticed tending bar by wrestlers during the filming of the movie Over the Top. The wrestlers involved gave him the advice that, with his large body type and unique (tattooed) look, he should try seeking out Larry Sharpe and his Monster Factory to get into the business. He is best known for his tenure with the World Wrestling Federation throughout the 1990s and early 2000s under the ring names Papa Shango, Kama, Kama Mustafa, The Godfather, and The Goodfather (when he joined Right to Censor). After leaving the wrestling business he moved to Las Vegas, where he currently manages the strip club Cheetah's.","alterEgos":["Kama","Papa Shango"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":56,"storytelling":60,"productFit":100,"riskTaking":33,"matchLayout":61,"psychology":56,"workerManagement":100,"trainingIntensity":34,"technicalCoaching":25,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":76,"brandBuilding":54,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":34,"consistency":43,"awareness":56,"judgement":74},"picture":"The Godfather.png"},{"id":1211,"name":"Jim Duggan","realName":"Jim Duggan","nickname":"","type":"scout","base":"USA","gender":"M","weight":264,"height":187,"dateOfBirth":"1954-01-14T00:00:00.000Z","debut":"1972-01-01T00:00:00.000Z","wage":66000,"popularity":8,"charisma":77,"micSkills":70,"condition":72,"hardcoreAbility":57,"injuryProne":77,"ability":64,"currentAbility":29,"potentialAbility":29,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"James Edward Duggan, Jr. better known by his ring name \"Hacksaw\" Jim Duggan, is an American professional wrestler. He is signed with World Wrestling Entertainment in a Legends contract. His best known character is that of an American patriot, which sees him use a 2x4 length of wood as a weapon, the battle cry \"Hooo!\" and the U-S-A! cheer. Duggan is a survivor of kidney cancer, an illness he was diagnosed with during his time with WCW. Duggan has claimed to have wrestled in all 50 American states and in Australia, Austria, the Bahamas, Belgium, Bermuda, Canada, the Dominican Republic, El Salvador, England, Scotland, Ireland, Wales, France, Germany, Guam, the Netherlands, Italy, Japan, Poland, Spain, and Switzerland. In the WWF, Duggan was the winner of the first ever Royal Rumble match in 1988.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3192],"staffAttributes":{"bookingLogic":45,"storytelling":53,"productFit":44,"riskTaking":41,"matchLayout":59,"psychology":36,"workerManagement":27,"trainingIntensity":46,"technicalCoaching":41,"characterCoaching":48,"teaching":46,"diagnosis":44,"rehabilitation":50,"prevention":40,"mediaHandling":55,"brandBuilding":28,"socialMediaSavvy":32,"ruleKnowledge":45,"positioning":22,"reactionSpeed":59,"consistency":20,"awareness":36,"judgement":86},"picture":"Jim Duggan.png"},{"id":1212,"name":"Mosh","realName":"Mosh","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":198,"height":175,"dateOfBirth":"1971-05-28T00:00:00.000Z","debut":"1989-05-01T00:00:00.000Z","wage":37500,"popularity":7,"charisma":46,"micSkills":57,"condition":62,"hardcoreAbility":45,"injuryProne":100,"ability":42,"currentAbility":26,"potentialAbility":28,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Charles \"Chaz\" Warrington  is an American professional wrestler. He is currently performing under the ring name Mosh as one-half of the tag team The Headbangers along with Thrasher. Warrington began training under Larry Sharpe and Glenn Ruth during the early 1990s. In 1993 he would make several appearances in the World Wrestling Federation as an enhancement talent (under the name Chaz Ware). In 1994, he teamed up with his co-trainer Glenn Ruth. He and Ruth, working as the masked team \"the Spiders\" lost to Axel and Ian Rotten in ECW. Wrestling under a variety of names and gimmicks.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[362,1438,3257],"staffAttributes":{"bookingLogic":49,"storytelling":54,"productFit":100,"riskTaking":31,"matchLayout":55,"psychology":49,"workerManagement":100,"trainingIntensity":53,"technicalCoaching":38,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":64,"brandBuilding":36,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":53,"consistency":60,"awareness":49,"judgement":69},"picture":"Mosh.png"},{"id":1213,"name":"Thrasher","realName":"Thrasher","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":244,"height":190,"dateOfBirth":"1969-06-13T00:00:00.000Z","debut":"1990-06-01T00:00:00.000Z","wage":37500,"popularity":7,"charisma":42,"micSkills":58,"condition":67,"hardcoreAbility":37,"injuryProne":100,"ability":53,"currentAbility":30,"potentialAbility":32,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Glenn Ruth  is an American professional wrestler, better known by his ring name, Thrasher. He is one-half of the tag team The Headbangers with Mosh. Ruth is best known for his appearances in the World Wrestling Federation between 1996 and 2000. Thrasher is a former NWA World Tag Team Champion and WWF World Tag Team Champion. After retiring in 2002, he returned to professional wrestling in 2011, reforming The Headbangers with Mosh and appearing on the independent circuit.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[362,1438],"staffAttributes":{"bookingLogic":49,"storytelling":54,"productFit":100,"riskTaking":27,"matchLayout":55,"psychology":49,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":39,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":58,"brandBuilding":36,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":60,"awareness":49,"judgement":69},"picture":"Thrasher.png"},{"id":1215,"name":"Joey Janela","realName":"Joey Janela","nickname":"","type":"wrestler","promotionId":77,"base":"USA","gender":"M","weight":183,"height":170,"dateOfBirth":"1989-07-03T00:00:00.000Z","debut":"2008-06-01T00:00:00.000Z","wage":26200,"wageType":"per-appearance","popularity":23,"charisma":36,"micSkills":54,"condition":79,"hardcoreAbility":67,"injuryProne":100,"ability":49,"currentAbility":46,"potentialAbility":51,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Joey Janela is an American wrestler who works in America, Canada, Mexico, the British Isles, Japan and Europe. He is a Lightweight who is classed as using a Daredevil style. He is best known for his work with AEW, DDT, PWG, MLW, GCW, The Crash, DEFY, EVOLVE, Beyond, PROGRESS, AAW, AIW, Smash, C4, A1, DTU and CZW. He is currently the GCW Extreme champion.","alterEgos":["Star Man"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1215","wrestlerId":1215,"promotionId":77,"startDate":"2015-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":26200,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2154,2510,2603],"staffAttributes":{"bookingLogic":53,"storytelling":56,"productFit":100,"riskTaking":35,"matchLayout":57,"psychology":53,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":44,"characterCoaching":72,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":72,"brandBuilding":48,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":68,"awareness":53,"judgement":72},"picture":"Joey Janela_alt1.png"},{"id":1216,"name":"Avery Good","realName":"Avery Good","nickname":"","type":"manager","base":"USA","gender":"M","weight":218,"height":182,"dateOfBirth":"1986-08-14T00:00:00.000Z","debut":"2007-02-01T00:00:00.000Z","wage":66000,"popularity":3,"charisma":65,"micSkills":53,"condition":90,"hardcoreAbility":69,"injuryProne":100,"ability":61,"currentAbility":54,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Dasher Hatfield is as embedded in the heart and soul of Chikara as guys like Mike Quackenbush, the Colony, Team FIST and Claudio Castagnoli. While he's still very green in the ring, he's got the rare quality to take a crowd in the palm of his hand and play them to perfection. Sure, they're only small crowds for now, but that kind of charisma translates into bigger crowds and better reactions with time. There is such an endearing quality about Dasher, especially in this latest and hopefully final permutation of the Create-a-Wrestler gimmick.","alterEgos":["Ultimo Breakfast","Moscow The Communist Bovine","Dasher Hatfield","A Very Good Pro Wrestler"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2634],"staffAttributes":{"bookingLogic":57,"storytelling":60,"productFit":100,"riskTaking":22,"matchLayout":61,"psychology":57,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":58,"characterCoaching":71,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":71,"brandBuilding":51,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":71,"awareness":57,"judgement":74},"picture":"Dasher Hatfield.png"},{"id":1217,"name":"Savannah Summers","realName":"Savannah Summers","nickname":"","type":"wrestler","base":"Australia","gender":"F","weight":125,"height":160,"dateOfBirth":"1987-11-15T00:00:00.000Z","debut":"2005-06-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":38,"micSkills":36,"condition":100,"hardcoreAbility":66,"injuryProne":95,"ability":52,"currentAbility":47,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Savannah is the first lady of Riot City Wrestling, and has been with RCW since its inception in 2006. In 2012 she became the first RCW Women’s Champion, proving that she is undoubtedly Riot City’s leading female wrestler. Her hard hitting in ring ability and technical high flying moves make her one of the most talented female wrestlers in Australia. Savannah has also been interviewed for various publications such as Dolly magazine, The Sunday Mail and also more recently for radio with ABC online. Initially starting out prior to RCW as a Valet, Savannah trained for 18 months before making her in ring debut against Sara Jay.","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":45,"storytelling":49,"productFit":40,"riskTaking":38,"matchLayout":50,"psychology":45,"workerManagement":40,"trainingIntensity":71,"technicalCoaching":56,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandlin