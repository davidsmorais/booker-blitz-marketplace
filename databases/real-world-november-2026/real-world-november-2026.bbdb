as a jobber in WCW. Tomas Mendoza began wrestling in 1982 after being taught by his father and his older brother Arturo. He was not given the Villano name on his debut, both his father and his older brothers wanted him to get a college degree and also earn some in ring experience before he would be allowed to use the Villano name.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":60,"storytelling":70,"productFit":100,"riskTaking":29,"matchLayout":73,"psychology":60,"workerManagement":100,"trainingIntensity":53,"technicalCoaching":54,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":56,"brandBuilding":33,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":20,"reactionSpeed":53,"consistency":77,"awareness":60,"judgement":76},"picture":"Villano IV.png"},{"id":2217,"name":"Zodiak","realName":"Zodiak","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":271,"height":185,"dateOfBirth":"1977-04-20T00:00:00.000Z","debut":"1998-03-01T00:00:00.000Z","wage":37500,"popularity":0,"charisma":45,"micSkills":47,"condition":84,"hardcoreAbility":44,"injuryProne":100,"ability":37,"currentAbility":27,"potentialAbility":29,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Zodiak is a masked American wrestler who works exclusively in America. He is a Heavyweight who is classed as using a Brawler style. He is one half of The Bomb Shelter alongside Joseph Schwartz. He is best known for his work with IWA-MS.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookin