dieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Beth Crist (née Vocke), is an American professional wrestler best known as Neveah. She currently performs for several Northern United States-based independent promotions as well as the all-female promotion SHIMMER Women Athletes. Vocke made her wrestling debut on December 1, 2005 under the ring name Nevaeh, where she lost to Hellena Heavenly in a match for Mad-Pro Wrestling. On April 26, 2008, Nevaeh made her debut for Shimmer Women Athletes at the Volume 17 tapings, where she and her rival Ashley Lane lost to The Experience. Because of the working agreement between Shimmer and Ring of Honor, Nevaeh made her ROH debut on March 1, 2009. On February 4, 2012, Nevaeh made her Combat Zone Wrestling debut with a victory over Kimber Lee. She is married to fellow professional wrestler and Ohio Is For Killers' stablemate Jake Crist.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1750,2293],"staffAttributes":{"bookingLogic":61,"storytelling":65,"productFit":40,"riskTaking":30,"matchLayout":67,"psychology":61,"workerManagement":40,"trainingIntensity":71,"technicalCoaching":57,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":66,"brandBuilding":45,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":8,"reactionSpeed":71,"consistency":81,"awareness":61,"judgement":53},"picture":"Nevaeh.png"},{"id":678,"name":"Jake Crist","realName":"Jake Crist","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":195,"height":170,"dateOfBirth":"1984-07-13T00:00:00.000Z","debut":"2003-01-01T00:00:00.000Z","wage":37500,"popularity":15,"charisma":55,"micSkills":58,"condition":85,"hardcoreAbility":50,"injuryProne":100,"ability":61,"currentAbility":61,"potentialAbility":74,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jake Crist is an American professional wrestler who competes on the independent circuit alongside his brother Dave as one half of the tag team The Irish Airborne. Crist, along with his brother, has appeared with numerous independent promotions, including Ring of Honor, Full Impact Pro, International Wrestling Cartel, and Heartland Wrestling Association. Both Dave and Jake were fans of professional wrestling growing up, favoring wrestling styles of a more extreme nature such as the Hardy Boyz in the Tables, Ladders, and Chairs match and the promotion Extreme Championship Wrestling. The two brothers along with other friends from high school began a backyard wrestling promotion. He is married to fellow wrestler Neveah.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[216,1109,1262,1263,1634,2911],"staffAttributes":{"bookingLogic":49,"storytelling":56,"productFit":100,"riskTaking":22,"matchLayout":59,"psychology":49,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":53,"characterCoaching":59,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":59,"brandBuilding":38,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":63,"awareness":49,"judgement":69},"picture":"Jake Crist_alt3.png"},{"id":679,"name":"Dave Crist","realName":"Dave Crist","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":198,"height":175,"dateOfBirth":"1982-11-10T00:00:00.000Z","debut":"2003-01-01T00:00:00.000Z","wage":37500,"popularity":11,"charisma":70,"micSkills":61,"condition":82,"hardcoreAbility":44,"injuryProne":100,"ability":60,"currentAbility":50,"potentialAbility":60,"morale":"broken","presentation":"fac