00:00:00.000Z","debut":"2005-01-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":63,"micSkills":65,"condition":100,"hardcoreAbility":63,"injuryProne":100,"ability":63,"currentAbility":56,"potentialAbility":60,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Matt Basso is one of the few wrestlers left from RCW’s inception in 2005. He came in to Riot City along side his brother, former ally Chris Basso.\r\nDetermined to make a name for himself, the Giant used his height + power advantage to become the first ever RCW Champion, a championship he later lost to Kash Kourageous. He had notable feuds with Kash Kourageous and Damon Mathews until he turned his back on Chris and the fans in 2007 which sparked a massive rivalry between the two brothers.\r\nMatt was able to capture the championship Gold for a second time after defeating Chris in front of a sell out crowd at Rites Of Passage 2009.\r\nMatt has held notable feuds with Voodoo, Jacko Lantern, and Rocky Menero.","alterEgos":["Grimm"],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3130],"staffAttributes":{"bookingLogic":59,"storytelling":61,"productFit":100,"riskTaking":22,"matchLayout":61,"psychology":59,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":60,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":73,"brandBuilding":56,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":64,"awareness":59,"judgement":75},"picture":"GD Grimm.png"},{"id":2022,"name":"Nick Armstrong","realName":"Nick Armstrong","nickname":"","type":"wrestler","base":"Australia","gender":"M","weight":176,"height":177,"dateOfBirth":"1989-09-13T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":66,"micSkills":61,"condition":100,"hardcoreAbility":64,"injuryProne":100,"ability":65,"currentAbility":61,"potentialAbility":66,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Hailing from Mount Gambier, South Australia, Nick Armstrong has wrestled across the country, most often as a tag team partner to his brother, Jett Armstrong.\r\n\r\nIn December 2014, at Battle for Supremacy, Nick Armstrong defeated Adam Brooks to become the Riot City Wrestling Champion.\r\n\r\nReceived further training under Lance Storm.","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":64,"productFit":67,"riskTaking":31,"matchLayout":66,"psychology":58,"workerManagement":67,"trainingIntensity":82,"technicalCoaching":56,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":64,"brandBuilding":47,"socialMediaSavvy":44,"ruleKnowledge":0,"positioning":13,"reactionSpeed":82,"consistency":80,"awareness":58,"judgement":62},"picture":"Nick Armstrong.png"},{"id":2023,"name":"Robbie Eagles","realName":"Robbie Eagles","nickname":"","type":"wrestler","promotionId":38,"base":"Australia","gender":"M","weight":176,"height":172,"dateOfBirth":"1990-02-13T00:00:00.000Z","debut":"2008-03-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":20,"charisma":64,"micSkills":79,"condition":100,"hardcoreAbility":81,"injuryProne":100,"ability":57,"currentAbility":54,"potentialAbility":70,"morale":"poor","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Robbie Eagles is one of the hottest young prospects to come out fo Australia’s burgeoning wrestling scene. Though he appeared on CHAOS’ radar after testing Will Ospreay Down Under, it was BULLET CLUB that wound up swooping in on the young man, recruiting him to team with Taiji Ishimori during the 2018 Super Junior Tag League. \r\n\r\nEagles showed why he is known as the ‘Sniper of the Skies’, as he used not only impressive high flying ability, but also remarkable submission skills. After returning to NJPW during Honor Rising 2019, he remained strong on everyone’s radars, and looks to be a threat to the junior heavyweight division at large. However, the arrival of El Phantasmo to NJPW in May 2019, threatened to overshadow Eagles and he grew increasingly more distant from the group as Phantasmo’s behavior clashed with Eagles’ sense of sportsmanship.","alterEgos":[],"birthplace":"Australia","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2023","wrestlerId":2023,"promotionId":38,"startDate":"2018-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1925,2092,2630,4078],"staffAttributes":{"bookingLogic":70,"storytelling":73,"productFit":100,"riskTaking":19,"matchLayout":74,"psychology":70,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":67,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":64,"brandBuilding":58,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":77,"awareness":70,"judgement":82},"picture":"Robbie Eagles.png"},{"id":2026,"name":"Tommy Hellfire","realN