evention":84,"mediaHandling":63,"brandBuilding":56,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":90,"awareness":76,"judgement":86},"picture":"Cheerleader Melissa_alt8.png"},{"id":653,"name":"Awesome Kong","realName":"Awesome Kong","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":273,"height":182,"dateOfBirth":"1977-09-04T00:00:00.000Z","debut":"2002-10-01T00:00:00.000Z","wage":37500,"popularity":31,"charisma":58,"micSkills":47,"condition":46,"hardcoreAbility":47,"injuryProne":93,"ability":60,"currentAbility":44,"potentialAbility":84,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Kia Stevensbetter known by her ring names Amazing Kong, Awesome Kong and Kharma, is an American professional wrestler. She is best known for her time at WWE and TNA as Kharma and Awesome Kong respectively. She is a five-time Women's Champion, having won the WWWA World Championship, NWA World Women's Championship and AWA Superstars of Wrestling World Women's Championship and a two-time TNA Knockout Champion. Her success is not limited to singles wrestling, as she frequently teamed with Aja Kong to form the tag team Double Kong who held tag team championships in four different promotions, along with winning the TNA Knockouts Tag Team Championship with Hamada. She was also ranked first in the inaugural list of Pro Wrestling Illustrated's Top 50 Females.","alterEgos":["Amazing Kong","Kharma"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2985,2986,3000],"staffAttributes":{"bookingLogic":70,"storytelling":73,"productFit":100,"riskTaking":25,"matchLayout":74,"psychology":70,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":31,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":63,"brandBuilding":70,"socialMediaSavvy":71,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":59,"awareness":70,"judgement":82},"picture":"Amazing Kong.png"},{"id":654,"name":"Ayako Hamada","realName":"Ayako Hamada","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":134,"height":160,"dateOfBirth":"1981-02-14T00:00:00.000Z","debut":"1998-08-01T00:00:00.000Z","wage":37500,"popularity":13,"charisma":83,"micSkills":78,"condition":71,"hardcoreAbility":68,"injuryProne":100,"ability":69,"currentAbility":56,"potentialAbility":68,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ayako Valentina Hamada Villareal is a female professional wrestler of mixed Japanese and Mexican descent, currently wrestling in the United States. She is best known for winning several notable titles in Japanese women's pro wrestling, including both the WWWA World Heavyweight Championship and AAAW Singles Championship in the early 2000s. She is a second generation wrestler, as her father is Gran Hamada. Her older sister Xóchitl Hamada is also a professional wrestler. Ayako Hamada, who was born and raised in Mexico, debuted at the age of seventeen against Candy Okutsu on August 9, 1998 for the Japanese Arsion promotion. On April 8, 2009, it was announced at a press conference that the April 19 Ito Dojo show would be Hamada's final match in Japan as she had signed with Total Nonstop Action Wrestling. On November 8, 2009, Hamada made her debut under her full name for Chicago based all female wrestling promotion Shimmer Women Athletes.","alterEgos":["Hamada"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3000,3001],"staffAttributes":{"bookingLogic":77,"storytelling":80,"productFit":100,"riskTaking":20,"matchLayout":81,"psychology":77,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":76,"characterCoaching":66,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":66,"brandBuilding":52,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":73,"awareness":77,"judgement":86},"picture":"Ayako Hamada_alt2.png"},{"id":655,"name":"Asuka","realName":"Kana","nickname":"","type":"wrestler","promotionId":64,"base":"Japan","gender":"F","weight":136,"height":157,"dateOfBirth":"1981-09-26T00:00:00.000Z","debut":"2004-06-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":56,"charisma":74,"micSkills":70,"condition":78,"hardcoreAbility":85,"injuryProne":100,"ability":71,"currentAbility":71,"potentialAbility":83,"morale":"good","presentation":"heel","prestige":"mid","style":"all rounder","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Nobody is ready for Asuka. And The Empress of Tomorrow proved that by not being pinned or submitted from her debut in NXT in October 2015 until WrestleMania 34 in April 2018.\r\n\r\nMarching to the ring in a traditional noh mask and kaleidoscopic battle gear and looking every bit the victor before the opening bell even rings, Asuka has used her perfect technique and wicked intentions to take down everybody from Becky Lynch to Bayley (whom Asuka unseated as NXT Women’s Champion). All the while, the fierce Japanese Superstar has worn an intimidating smile on her face, seemingly finding joy in stretching out her overmatched opponents. She even displayed an ability to work well with others, melding with The Miz to win the first season of WWE's Mixed Match Challenge.\r\n\r\nHer undefeated streak came to an end at the hands of Charlotte Flair at WrestleMania 34, but Asuka persevered and finally captured the SmackDown Women’s Title at WWE TLC after defeating Flair and Becky Lynch.","alterEgos":["Kana"],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-655","wrestlerId":655,"promotionId":64,"startDate":"2015-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1128,1891,2760,3632],"staffAttributes":{"bookingLogic":78,"storytelling":82,"productFit":100,"riskTaking":33,"matchLayout":84,"psychology":78,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":74,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":85,"brandBuilding":80,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":86,"awareness":78,"judgement":87},"picture":"Asuka.png"},{"id":656,"name":"Madison Eagles","realName":"Madison Eagles","nickname":"","type":"trainer","base":"Australia","gender":"F","weight":155,"height":182,"dateOfBirth":"1984-06-04T00:00:00.000Z","debut":"2001-11-01T00:00:00.000Z","wage":1000,"popularity":5,"charisma":82,"micSkills":100,"condition":71,"hardcoreAbility":71,"injuryProne":100,"ability":83,"currentAbility":71,"potentialAbility":71,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Madison Eagles is a retired Australian wrestler who works primarily as a road agent. She was one half of Green Nation alongside Mick Moretti. She is best known for her work with PWA.","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[773,1276,2090],"staffAttributes":{"bookingLogic":22,"storytelling":51,"productFit":36,"riskTaking":31,"matchLayout":58,"psychology":26,"workerManagement":27,"trainingIntensity":62,"technicalCoaching":76,"characterCoaching":88,"teaching":77,"diagnosis":60,"rehabilitation":60,"prevention":38,"mediaHandling":22,"brandBuilding":22,"socialMediaSavvy":24,"ruleKnowledge":58,"positioning":36,"reactionSpeed":26,"consistency":48,"awareness":44,"judgement":29},"picture":"Madison Eagles_alt2.png"},{"id":657,"name":"Mercedes Martinez","realName":"Mercedes Martinez","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":147,"height":167,"dateOfBirth":"1980-11-17T00:00:00.000Z","debut":"2000-11-01T00:00:00.000Z","wage":4166,"popularity":24,"charisma":75,"micSkills":79,"condition":87,"hardcoreAbility":56,"injuryProne":100,"ability":64,"currentAbility":51,"potentialAbility":53,"morale":"poor","presentation":"heel","prestige":"low","style":"submission","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Like the automobile she shares a name with, Mercedes Martinez is known the world over as one of the very best. A grim-faced brawler with distinctive sleeves of tattoos, Martinez has been a fixture in the industry since 2004, serving as both the foundation and centerpieces of various women’s divisions across several independent promotions.\r\n\r\nMartinez first appeared on WWE fans’ radar as an entrant in the 2017 and 2018 Mae Young Classic tournaments, where she squared up against the likes of Shayna Baszler, Princesa Sugehit and Meiko Satomura. With towns and accomplishments beyond counting under her belt, Martinez has built the kind of career that is the envy and respect of anyone who wishes to call themselves a professional wrestler, and that’s before she got to NXT. Imagine what she’ll do now that she’s here.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":78,"storytelling":79,"productFit":100,"riskTaking":21,"matchLayout":80,"psychology":78,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":65,"characterCoaching":60,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":60,"brandBuilding":62,"socialMediaSavvy":50,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":85,"awareness":78,"judgement":87},"picture":"Mercedes Martinez_alt7.png"},{"id":658,"name":"Saraya Knight","realName":"Saraya Knight","nickname":"","type":"wrestler","base":"UK","gender":"F","weight":132,"height":167,"dateOfBirth":"1971-10-19T00:00:00.000Z","debut":"1990-10-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":52,"micSkills":50,"condition":69,"hardcoreAbility":51,"injuryProne":100,"ability":69,"currentAbility":42,"potentialAbility":44,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Saraya Knight is an English wrestler who works in America, Canada, the British Isles and Europe. She is a Small worker who is classed as using a Brawler style. She is best known for her work with GWF, SHIMMER, AAW, SHINE, EVE and TNT. She is married to Ricky Knight.","alterEgos":["Sweet Saraya"],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1146,1294],"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":23,"matchLayout":75,"psychology":68,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":57,"characterCoaching":65,"teaching":20,"d