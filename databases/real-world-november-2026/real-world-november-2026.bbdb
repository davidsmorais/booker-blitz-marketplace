vacious ring performer...and now North American and European fans are looking forward to seeing more of this lady in their own arenas. Shazza McKenzie: ready to breakout across wrestling rings world-wide!","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2098],"staffAttributes":{"bookingLogic":55,"storytelling":56,"productFit":100,"riskTaking":33,"matchLayout":56,"psychology":55,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":49,"characterCoaching":50,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":50,"brandBuilding":40,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":63,"awareness":55,"judgement":73},"picture":"Shazza McKenzie.png"},{"id":2769,"name":"Jake Lindo","realName":"Jake Lindo","nickname":"","type":"wrestler","base":"Australia","gender":"M","weight":194,"height":177,"dateOfBirth":"1991-03-17T00:00:00.000Z","debut":"2009-06-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":58,"micSkills":43,"condition":100,"hardcoreAbility":43,"injuryProne":100,"ability":46,"currentAbility":45,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jake Lindo is an Australian wrestler who works exclusively in Australia. He is a Lightweight who is classed as using a Cruiserweight style.","alterEgos":[],"birthplace":"Australia","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":59,"storytelling":65,"productFit":77,"riskTaking":27,"matchLayout":67,"psychology":59,"workerManagement":77,"trainingIntensity":71,"technicalCoaching":45,"characterCoaching":34,"teaching":20