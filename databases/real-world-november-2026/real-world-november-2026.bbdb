74,"productFit":100,"riskTaking":23,"matchLayout":76,"psychology":70,"workerManagement":100,"trainingIntensity":86,"technicalCoaching":80,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":58,"brandBuilding":63,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":86,"consistency":83,"awareness":70,"judgement":82},"picture":"Takuya Nomura.png"},{"id":2443,"name":"Super Tiger","realName":"Super Tiger","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":209,"height":177,"dateOfBirth":"1977-07-20T00:00:00.000Z","debut":"2007-03-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":43,"micSkills":66,"condition":68,"hardcoreAbility":71,"injuryProne":100,"ability":62,"currentAbility":45,"potentialAbility":47,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Yuji Sakuragi is a Japanese mixed martial artist, kickboxer and professional wrestler, currently associated with Real Japan Pro Wrestling's team Seikendo. He is known for his Kyokushin Karate background and his ability to score KO wins. Sakuragi wrestles under the name of Super Tiger, being the second incarnation of the name used by his trainer Satoru Sayama.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":56,"storytelling":64,"productFit":100,"riskTaking":30,"matchLayout":66,"psychology":56,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":71,"characterCoaching":34,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":34,"brandBuilding":50,"socialMediaSavvy":25,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":56,"awareness":56,"judgement":74},"picture":"Super Tiger.png"},{"id":2444,"name":"Joseph Conners","realName":"Joseph Conners","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":196,"height":182,"dateOfBirth":"1987-05-28T00:00:00.000Z","debut":"2006-11-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":45,"micSkills":66,"condition":88,"hardcoreAbility":67,"injuryProne":100,"ability":60,"currentAbility":54,"potentialAbility":58,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Fueled by a tremendous passion and intensity, Joseph Conners showed incredible potential from the first time he stepped into the ring, always ready to put his body on the line and risk it all to achieve his dreams inside the squared circle.\r\n\r\nDespite this promise, though, he would soon grow bitter. He was convinced that while he had once been regarded as one of NXT UK’s “shiny new toys,” he had since been cast aside. In response, he reached the conclusion that he had been “fed a lie” and took to sitting in dark rooms to pontificate on the hypocrisy of his situation as he grew more and more resentful.","alterEgos":[],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":54,"storytelling":58,"productFit":100,"riskTaking":25,"matchLayout":60,"psychology":54,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":53,"characterCoaching":59,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":59,"brandBuilding":59,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":62,"awareness":54,"judgement":72},"picture":"Joseph Connors.png"},{"id":2446,"name":"Jack Starz","realName":"Jack Starz","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":172,"height":165,"dateOfBirth":"1991-06-03T00:00:00.000Z","debut":"2012-10-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":65,"micSkills":59,"condition":95,"hardcoreAbility":72,"injuryProne":90,"ability":57,"currentAbility":55,"potentialAbility":61,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jack, with his endless drive and pursuit for greatness in the wrestling world is ready to break out and make a name for himself. Equipped with a past of martial arts and submission wrestling, the british wrestling style has fit hand in hand to make him a lethal grappler in the ring. Though he isn't a giant in the ring, he has adapted his speed and explosive power to dissect his opponents piece by piece.","alterEgos":[],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3537],"staffAttributes":{"bookingLogic":42,"storytelling":49,"productFit":25,"riskTaking":34,"matchLayout":51,"psychology":42,"workerManagement":25,"trainingIntensity":78,"technicalCoaching":55,"characterCoaching":46,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":46,"brandBuilding":31,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":5,"reactionSpeed":78,"consistency":49,"awareness":42,"judgement":35},"picture":"Jack Starz.png"},{"id":2448,"name":"James Drake","realName":"James Drake","nickname":"","type":"wrestler","promotionId":49,"base":"UK","gender":"M","weight":178,"height":177,"dateOfBirth":"1993-03-04T00:00:00.000Z","debut":"2010-01-01T00:00:00.000Z","wage":24600,"wageType":"per-appearance","popularity":21,"charisma":60,"micSkills":67,"condition":94,"hardcoreAbility":59,"injuryProne":98,"ability":63,"currentAbility":63,"potentialAbility":80,"morale":"poor","presentation":"heel","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"James Drake is as cold and as calculating as they come. Beginning his wrestling training at age 13, he now looks to transform his experience into championship gold in the turbulent world of NXT. Known for his aggressive brawling style, Drake joined forces with Liverpool’s No. 1 Zack Gibson to create an absolutely brutal tandem. Together, the Grizzled Young Veterans made it clear that they are on a mission to capture tag team glory. And at NXT UK TakeOver: Blackpool, that's exactly what they did,  Moustache Mountain in the finals of a tournament to crown the first-ever NXT UK Tag Team Champions.","alterEgos":["Jagger Reid"],"birthplace":"England","managerId":0,"contractExpiryDate":"2026-11-07T00:00:00.000Z","contract":{"id":"tew-contract-2448","wrestlerId":2448,"promotionId":49,"startDate":"2024-11-07T00:00:00.000Z","endDate":"2026-11-07T00:00:00.000Z","wage":24600,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1854,2061,2358,3932,3933,3934,3935,3957,4035,4075,4077,4176],"staffAttributes":{"bookingLogic":61,"storytelling":65,"productFit":100,"riskTaking":34,"matchLayout":66,"psychology":61,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":62,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":62,"brandBuilding":51,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":81,"awareness":61,"judgement":77},"picture":"James Drake.png","additionalContracts":[{"id":"tew-contract-2448-76","wrestlerId":2448,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-2448-118","wrestlerId":2448,"promotionId":118,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":10500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW","MLP"]},{"id":2449,"name":"Sam Gradwell","realName":"Sam Gradwell","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":209,"height":182,"dateOfBirth":"1991-06-01T00:00:00.000Z","debut":"2009-02-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":65,"micSkills":65,"condition":100,"hardcoreAbility":39,"injuryProne":100,"ability":65,"currentAbility":63,"potentialAbility":69,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Something about Gradwell’s ever-present scowl and antagonistic stare tells even the unacquainted that he’s the last man on Earth you’d want to fight. Gradwell has not enjoyed a life of comfort, and adversity may well be his oldest friend. As a youth, the Blackpool native assumed the role of caregiver for his siblings when their home life turned sour; amid the turmoil, wrestling provided an escape.\r\n\r\nNow a world-traveled veteran, Gradwell continues to find solace inside the squared circle. His idea of amusement is instilling a sense of fear and helplessness in opponents — a “dose of reality,” as he terms it. The chip on Gradwell’s shoulder got even bigger after an injury forced him out of action for nearly two years following an impressive performance in the inaugural WWE United Kingdom Championship Tournament. Back in the ring and ready to dish out punishment, there’s no telling just how much devastation this thunderstorm of a Blackpool bruiser will leave in his wake.","alterEgos":[],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":54,"storytelling":57,"productFit":31,"riskTaking":38,"matchLayout":58,"psychology":54,"workerManagement":31,"trainingIntensity":74,"technicalCoaching":49,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":67,"brandBuilding":55,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":6,"reactionSpeed":74,"consistency":71,"awareness":54,"judgement":45},"picture":"Sam Gradwell.png"},{"id":2450,"name":"JD McDonagh","realName":"Jordan Devlin","nickname":"","type":"wrestler","promotionId":64,"base":"UK","gender":"M","weight":183,"height":175,"dateOfBirth":"1990-03-15T00:00:00.000Z","debut":"2006-05-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":41,"charisma":73,"micSkills":84,"condition":90,"hardcoreAbility":74,"injuryProne":100,"ability":79,"currentAbility":75,"potentialAbility":81,"morale":"fair","presentation":"heel","prestige":"mid","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Like many competitors hailing from Ireland, Jordan Devlin brings a physical, in-your-face intensity to the squared circle. He began his training at age 12 under the tutelage of Paul Tracey and Finn Bálor, picking up his relentless work ethic from the first Universal Champion.\r\n\r\nDevlin originally planned on pursuing amateur wrestling, but as soon as he saw the squared circle, he never looked back, adding to his arsenal a hard-hitting offense he picked up in a Japanese dojo.\r\n\r\nCited by WWE Hall of Famer Shawn Michaels as one of the most promising Superstars around, The Irish Ace lived up to his considerable hype when he captured the NXT Cruiserweight Championship at WWE Worlds Collide.","alterEgos":["Jordan Devlin"],"birthplace":"Bray, County Wicklow, Ireland","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2450","wrestlerId":2450,"promotionId":64,"startDate":"2023-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2841,3287,4072],"staffAttributes":{"bookingLogic":74,"storytelling":77,"productFit":100,"riskTaking":18,"matchLayout":78,"psychology":74,"workerManagement":100,"trainingIntensity":85,"technicalCoaching":76,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":68,"brandBuilding":45,"socialMediaSavvy":65,"ruleKnowledge":0,"positioning":20,"reactionSpeed":85,"consistency":77,"awareness":74,"judgement":84},"picture":"JD McDonagh.png"},{"id":2451,"name":"Roy Johnson","realName":"Roy Johnson","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":205,"height":180,"dateOfBirth":"1992-10-12T00:00:00.000Z","debut":"2015-03-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":57,"micSkills":54,"condition":98,"hardcoreAbility":64,"injuryProne":96,"ability":49,"currentAbility":48,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Rory Harris-Williams, better known by his ring name Roy Johnson, is an English wrestler and powerlifter who works exclusively in the British Isles. He is a Lightweight who is classed as using a Regular Wrestler style. The self-proclaimed “most wavy guy in sports-entertainment.” Entering the mat game with a powerlifting background – in which he captured both a European Title and a British Open Championship – it's no wonder Johnson believes that technical wrestling isn’t necessary for his success. “Why tie someone up,” he explains, “when you can pick them up and slam them to the ground?” He has a point. Once Johnson gets a hold of you, there’s simply no escape.","alterEgos":[],"birthplace":"England","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":59,"storytelling":62,"productFit":20,"riskTaking":31,"matchLayout":63,"psychology":59,"workerManagement":20,"trainingIntensity":58,"technicalCoaching":47,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":58,"brandBuilding":54,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":4,"reactionSpeed":58,"consistency":62,"awareness":59,"judgement":43},"picture":"Roy Johnson.png"},{"id":2454,"name":"Saxon Huxley","realName":"Saxon Huxley","nickname":"","type":"wrestler","promotionId":45,"base":"UK","gender":"M","weight":220,"height":187,"dateOfBirth":"1988-02-01T00:00:00.000Z","debut":"2010-08-01T00:00:00.000Z","wage":25600,"wageType":"per-appearance","popularity":5,"charisma":59,"micSkills":38,"condition":100,"hardcoreAbility":59,"injuryProne":100,"ability":56,"currentAbility":52,"potentialAbility":57,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Saxon Huxley is an English wrestler who works in the British Isles and Japan. He is a 6'3\", 220lb worker who is classed as using a Brawler style. He uses the Desolation Peak and the Shattered Illusions as his finishers. He is best known for his work with NOAH, NXT UK, CWFH, PROGRESS and SWE.","alterEgos":[],"birthplace":"England","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2454","wrestlerId":2454,"promotionId":45,"startDate":"2023-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":25600,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2848],"staffAttributes":{"bookingLogic":47,"storytelling":50,"productFit":44,"riskTaking":27,"matchLayout":51,"psychology":47,"workerManagement":44,"trainingIntensity":63,"technicalCoaching":35,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":51,"brandBuilding":53,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":9,"reactionSpeed":63,"consistency":57,"awareness":47,"judgement":46},"picture":"Saxon Huxley.png"},{"id":2456,"name":"Tucker","realName":"Tucker","nickname":"","type":"wrestler","base":"Other","gender":"M","weight":196,"height":170,"dateOfBirth":"1990-04-05T00:00:00.000Z","debut":"2006-02-01T00:00:00.000Z","wage":1500,"popularity":1,"charisma":62,"micSkills":63,"condition":82,"hardcoreAbility":52,"injuryProne":100,"ability":65,"currentAbility":62,"potentialAbility":68,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tucker is a Northern Irish wrestler who works in the British Isles and Europe. He is a 5'8\", 196lb worker who is classed as using a Regular style. He uses the Tuck-Fast as his finisher. He is best known for his work with NXT UK, OTT, BZW and SWE.","alterEgos":[],"birthplace":"Unknown","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":49,"storytelling":56