},"teams":[],"staffAttributes":{"bookingLogic":51,"storytelling":58,"productFit":40,"riskTaking":36,"matchLayout":60,"psychology":51,"workerManagement":40,"trainingIntensity":75,"technicalCoaching":53,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":67,"brandBuilding":31,"socialMediaSavvy":61,"ruleKnowledge":0,"positioning":8,"reactionSpeed":75,"consistency":72,"awareness":51,"judgement":47},"picture":"Ultimate Spider.png"},{"id":1762,"name":"GOSAMARU","realName":"GOSAMARU","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":209,"height":175,"dateOfBirth":"1982-11-13T00:00:00.000Z","debut":"2007-12-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":43,"micSkills":39,"condition":82,"hardcoreAbility":71,"injuryProne":100,"ability":43,"currentAbility":36,"potentialAbility":38,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Masato Inaba is a Japanese wrestler who goes by the name Golden Pine in Okinawa Pro.  Inabe debuted in El Dorado in late 2007. After working less than a year in the lower part of the card, he resigned from El Dorado, joining Okinawa Pro wrestling with the comedy gimmick of Golden Pine.","alterEgos":["Golden Pine"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1096],"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":25,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":57,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":65,"brandBuilding":38,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":61,"awareness":56,"judgement":74},"picture":"GOSAMARU.png"},{"id":1763,"name":"Tatsuhito Takaiwa","realName":"Tatsuhito Takaiwa","nickname":"","type":"wrestler","base":"Other","gender":"M","weight":207,"height":175,"dateOfBirth":"1972-07-05T00:00:00.000Z","debut":"1992-07-01T00:00:00.000Z","wage":4166,"popularity":5,"charisma":70,"micSkills":64,"condition":67,"hardcoreAbility":52,"injuryProne":100,"ability":62,"currentAbility":39,"potentialAbility":41,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tatsuhito Takaiwa is a Zainichi-Korean professional wrestler. Takaiwa is one of the more well-traveled junior heavyweights in Japan, having wrestled for New Japan, and Zero1, as well as making special appearances in All Japan and NOAH. He formed a successful tag team with Shinjiro Otani during the 1990s and won the IWGP Jr Heavyweight Tag Titles in 1998 and 1999. He's a former holder of the Zero-One International Jr. Heavyweight Title, IWGP Jr. Heavyweight Title and a former holder of the Pro Wrestling Noah GHC Jr. Heavyweight Title, and the AWA World Jr. Heavyweight Title. On February 15, 2009, Takaiwa debuted as the fifth Black Tiger, breaking the Black Tiger tradition of foreigners under the mask, by attacking Tiger Mask IV. On June 20, 2009, at Dominion 6.20 Tiger Mask defeated him in a mask vs. mask match and afterwards Takaiwa revealed his identity by removing his mask.","alterEgos":["Black Tiger V"],"birthplace":"South Korea","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2954,2955,2956],"staffAttributes":{"bookingLogic":72,"storytelling":76,"productFit":100,"riskTaking":23,"matchLayout":78,"psychology":72,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":67,"characterCoaching":53,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":53,"brandBuilding":38,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":61,"awareness":72,"judgement":83},"picture":"Tatsuhito Takaiwa.png"},{"id":1764,"name":"Aki Kanbayashi","realName":"Aki Kanbayashi","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":154,"height":152,"dateOfBirth":"1976-09-02T00:00:00.000Z","debut":"1995-10-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":52,"micSkills":64,"condition":62,"hardcoreAbility":70,"injuryProne":100,"ability":47,"currentAbility":33,"potentialAbility":35,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Aki Kambayashi is a Japanese professional wrestler who has been around since the mid 90's. She spent the early part of her career with the FMW promotion under her real name, and the name Miss Mongol, a name she would continue using for most of her career.","alterEgos":["Miss Mongol","La Malcriada"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":59,"storytelling":66,"productFit":100,"riskTaking":26,"matchLayout":68,"psychology":59,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":54,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":54,"brandBuilding":36,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":67,"awareness":59,"judgement":75},"picture":"Aki Kambayashi.png"},{"id":1765,"name":"Alex Lee","realName":"Alex Lee","nickname":"","type":"wrestler","base":"Other","gender":"F","weight":154,"height":167,"dateOfBirth":"1985-06-24T00:00:00.000Z","debut":"2010-06-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":53,"micSkills":54,"condition":85,"hardcoreAbility":43,"injuryProne":100,"ability":36,"currentAbility":32,"potentialAbility":35,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Irena Janjic s a former WWE Diva, who worked in its developmental area Florida Championship Wrestling. In the spring of 2010 she moved to Canada to train with Lance Storm at his Storm Wrestling Academy and graduated from it in May 2010. Janjic returned to her independent wrestling origins, working under the ring name of Alex Lee. She began wrestling in Japanese shows beginning in 2012. Her first show appearance was for REINA X World on June 24 at REINA X World #2 in a tag match, teaming with Kaji Tomato in a losing effort against Kikutaro and La Comandante.","alterEgos":["Leah West","Irena Janjic"],"birthplace":"Unknown","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1700,1715,1716],"staffAttributes":{"bookingLogic":43,"storytelling":46,"productFit":100,"riskTaking":29,"matchLayout":47,"psychology":43,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":40,"characterCoaching":48,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":71,"mediaHandling":48,"brandBuilding":53,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":56,"awareness":43,"judgement":66},"picture":"Alex Lee.png"},{"id":1766,"name":"Cat Power","realName":"Cat Power","nickname":"","type":"wrestler","base":"Canada","gender":"F","weight":150,"height":175,"dateOfBirth":"1987-10-31T00:00:00.000Z","debut":"2006-07-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":43,"micSkills":58,"condition":93,"hardcoreAbility":63,"injuryProne":100,"ability":49,"currentAbility":44,"potentialAbility":48,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Catherine Power is a Canadian wrestler, better known by her ring names, Cat Power and Haley Rogers. She has worked for the promotions Blood Sweat and Ears, Border City Wrestling, Pro Wrestling Xtreme, Shimmer Women Athletes, and Women's Extreme Wrestling. Power decided to become a professional wrestler after attending World Wrestling Federation's WrestleMania 18 in 2002 in Toronto. On March 25, 2015, Power made her Japanese debut for the Reina Joshi Puroresu promotion, teaming with Kana and Yuko Miyamoto in a six-person tag team match, where they were defeated by Hikaru Shida, Shiro Koshinaka and Zeus.","alterEgos":[],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":53,"storytelling":59,"productFit":100,"riskTaking":40,"matchLayout":61,"psychology":53,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":54,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":63,"brandBuilding":42,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":66,"awareness":53,"judgement":72},"picture":"Cat Power.png"},{"id":1767,"name":"Dump Matsumoto","realName":"Dump Matsumoto","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":220,"height":160,"dateOfBirth":"1960-11-11T00:00:00.000Z","debut":"1988-02-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":60,"micSkills":55,"condition":68,"hardcoreAbility":58,"injuryProne":69,"ability":48,"currentAbility":22,"potentialAbility":24,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kaoru Matsumoto  is a semi-retired Japanese professional wrestler, known by her ringname Dump Matsumoto, who competed in All Japan Women's Pro-Wrestling as one of the leading female wrestlers during the 1980s. The longtime leader of the stable Gokuaku Domei—which included Crane Yu, Condor Saito and Bull Nakano—she was one of the main rivals of the popular tag team Crush Gals. Their long running feud would become extremely popular in Japan during the 1980s, with their televised matches resulting in some of the highest rated in Japanese television as well as the promotion regularly selling out arenas.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3372,3373],"staffAttributes":{"bookingLogic":77,"storytelling":79,"productFit":100,"riskTaking":30,"matchLayout":80,"psychology":77,"workerManagement":100,"trainingIntensity":46,"technicalCoaching":47,"characterCoaching":77,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":77,"brandBuilding":58,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":46,"consistency":56,"awareness":77,"judgement":86},"picture":"Dump Matsumoto.png"},{"id":1768,"name":"Goya Kong","realName":"Goya Kong","nickname":"","type":"wrestler","base":"Mexico","gender":"F","weight":209,"height":177,"dateOfBirth":"1987-05-04T00:00:00.000Z","debut":"2006-11-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":48,"micSkills":50,"condition":84,"hardcoreAbility":63,"injuryProne":100,"ability":52,"currentAbility":47,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Goya Kong is the ring name of Gloria Alvarado Nava, a Mexican luchadora currently working for the Mexican professional wrestling promotion Consejo Mundial de Lucha Libre (CMLL) portraying a tecnica. She is a third generation Luchadora, part of the Alvarado wrestling family as she is the granddaughter of Shadito Cruz and the daughter of José Alvarado Nieves, who works under the ring name Brazo de Plata. She has several brothers and a sister who are also active wrestlers along with a number of uncles and cousins.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":94,"riskTaking":47,"matchLayout":64,"psychology":58,"workerManagement":94,"trainingIntensity":69,"technicalCoaching":24,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":53,"mediaHandling":51,"brandBuilding":49,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":19,"reactionSpeed":69,"consistency":67,"awareness":58,"judgement":72},"picture":"Goya Kong.png"},{"id":1769,"name":"Kagetsu","realName":"Kagetsu","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":136,"height":157,"dateOfBirth":"1992-06-24T00:00:00.000Z","debut":"2008-07-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":74,"micSkills":66,"condition":76,"hardcoreAbility":79,"injuryProne":100,"ability":64,"currentAbility":63,"potentialAbility":63,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Kagetsu is a Japanese professional wrestler trained by Meiko Satomura. He began his career wrestling under his (presumed) real name, Yukari Ishino in 2008 for the SENDAI promotion. Kagetsu has a background in judo, which can be seen in his style. In May 2022, he came out as transgender.","alterEgos":["Yu Ishino"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1261],"staffAttributes":{"bookingLogic":78,"storytelling":80,"productFit":100,"riskTaking":19,"matchLayout":80,"psychology":78,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":69,"characterCoaching":79,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":79,"brandBuilding":72,"socialMediaSavvy":72,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":68,"awareness":78,"judgement":87},"picture":"Kagetsu_alt2.png"},{"id":1770,"name":"La Pidita","realName":"Kaho Kobayashi","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":117,"height":149,"dateOfBirth":"1992-05-12T00:00:00.000Z","debut":"2013-06-01T00:00:00.000Z","wage":4166,"popularity":6,"charisma":68,"micSkills":49,"condition":97,"hardcoreAbility":51,"injuryProne":100,"ability":66,"currentAbility":65,"potentialAbility":72,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kaho Kobayashi is a female Japanese wrestler who was trained by the WNC promotion, most notably under TAJIRI. She has a background in gymnastics and breakdance, which have helped in her performances.","alterEgos":["Kaho Kobayashi"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1709,1712],"staffAttributes":{"bookingLogic":61,"storytelling":65,"productFit":100,"riskTaking":25,"matchLayout":66,"psychology":61,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":62,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":73,"brandBuilding":63,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":67,"awareness":61,"judgement":77},"picture":"Kaho Kobayashi.png"},{"id":1771,"name":"Makoto","realName":"Makoto","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":132,"height":165,"dateOfBirth":"1989-09-26T00:00:00.000Z","debut":"2006-07-01T00:00:00.000Z","wage":4166,"popularity":3,"charisma":50,"micSkills":54,"condition":93,"hardcoreAbility":57,"injuryProne":100,"ability":52,"currentAbility":49,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Makoto is a Japanese professional wrestler. Trained by Emi Sakura, Makoto made her debut for her Ice Ribbon promotion in July 2006. During the next five years, Makoto went on to win Ice Ribbon's top title, the ICE×60 Championship, once and the International Ribbon Tag Team Championship twice, before transferring over to the Smash promotion in August 2011. She remained with Smash until March 2012, when the promotion folded. The following month, Makoto was announced as part of the roster of the new Wrestling New Classic (WNC) promotion. In March 2013, Makoto became the second WNC Women's Champion. In January 2014, Makoto made Reina Joshi Puroresu her second home promotion in addition to WNC. Reina became her primary home promotion after WNC shut down in June 2014. She is a former two-time Reina World Tag Team Champion.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3423],"staffAttributes":{"bookingLogic":67,"storytelling":72,"productFit":100,"riskTaking":26,"matchLayout":73,"psychology":67,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":71,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":67,"brandBuilding":54,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":87,"awareness":67,"judgement":80},"picture":"Makoto.png"},{"id":1772,"name":"Mika Iida","realName":"Mika Iida","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":110,"height":152,"dateOfBirth":"1992-03-23T00:00:00.000Z","debut":"2010-11-01T00:00:00.000Z","wage":37500,"popularity":0,"charisma":41,"micSkills":63,"condition":93,"hardcoreAbility":53,"injuryProne":100,"ability":46,"currentAbility":45,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Mika Iida was the last new wrestler to ever come out of NEO. In perhaps an odd bit of timing, she did not join the promotion until after it’s closing was announced on May 5, although it also coincided with her graduating from high school. She started training almost immediately for her debut, which came about 6 months after she began training in wrestling.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":44,"storytelling":50,"productFit":40,"riskTaking":44,"matchLayout":52,"psychology":44,"workerManagement":40,"trainingIntensity":71,"technicalCoaching":56,"characterCoaching":49,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":56,"mediaHandling":49,"brandBuilding":34,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":8,"reactionSpeed":71,"consistency":72,"awareness":44,"judgement":42},"picture":"Mika Iida.png"},{"id":1773,"name":"Riho","realName":"Riho","nickname":"","type":"wrestler","promo