dcoreAbility":74,"injuryProne":100,"ability":62,"currentAbility":55,"potentialAbility":59,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Yuka Yasukawa is a Japanese professional wrestler, better known for her work with World Wonder Ring of Stardom where she is known as Act Yasukawa. During the main event at Queens Shout 2015, Act Yasukawa had her orbital bone smashed by Yoshiko, who turned their match into a shoot and began targetting the eye that Act had medical issues with. No one knows why, other than the 2 women have serious heat. This caused Act to need surgery. Act has held the Wonder of Stardom title on 2 occasions, as well as being a former Artist of Stardom co-holder.","alterEgos":["Act Yasukawa","Wild Bunny"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[4198],"staffAttributes":{"bookingLogic":65,"storytelling":67,"productFit":55,"riskTaking":34,"matchLayout":68,"psychology":65,"workerManagement":55,"trainingIntensity":72,"technicalCoaching":61,"characterCoaching":79,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":66,"mediaHandling":79,"brandBuilding":75,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":11,"reactionSpeed":72,"consistency":54,"awareness":65,"judgement":61},"picture":"Act Yasukawa.png"},{"id":1788,"name":"AZM","realName":"AZM","nickname":"","type":"wrestler","promotionId":61,"base":"Japan","gender":"F","weight":121,"height":152,"dateOfBirth":"2002-10-01T00:00:00.000Z","debut":"2014-07-06T00:00:00.000Z","wage":41000,"wageType":"monthly","popularity":19,"charisma":58,"micSkills":59,"condition":89,"hardcoreAbility":68,"injuryProne":100,"ability":60,"currentAbility":56,"potentialAbility":69,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"AZM, who graduated from Stardom Dojo on 01 January 2011, is a Japanese wrestler who works exclusively in Japan. She is a 5'1\", 117lb worker who is classed as using a Technician Flyer style. She uses the Diving Crossbody and the Fast Brain Buster as her finishers. She is best known for her work with NJPW, Stardom and Marvelous. She is currently the NJPW STRONG Women's champion and an Artist of Stardom champion. She is the protege of Kagetsu.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1788","wrestlerId":1788,"promotionId":61,"startDate":"2013-10-06T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":41000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2445,3616,4310],"staffAttributes":{"bookingLogic":68,"storytelling":71,"productFit":100,"riskTaking":17,"matchLayout":72,"psychology":68,"workerManagement":100,"trainingIntensity":76,"technicalCoaching":72,"characterCoaching":80,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":80,"brandBuilding":68,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":76,"consistency":76,"awareness":68,"judgement":81},"picture":"Azumi.png"},{"id":1789,"name":"KAIRI","realName":"KAIRI","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":114,"height":152,"dateOfBirth":"1988-09-23T00:00:00.000Z","debut":"2012-01-01T00:00:00.000Z","wage":37500,"popularity":47,"charisma":69,"micSkills":75,"condition":82,"hardcoreAbility":64,"injuryProne":100,"ability":67,"currentAbility":67,"potentialAbility":82,"morale":"fair","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Given her jet-setting and worldwide accomplishments, it’s no surprise that Kairi found her way to WWE, joining NXT in summer 2017 and immediately announcing her participation in the inaugural Mae Young Classic. Over the five rounds, The Pirate Princess outlasted the competition — a stiff field of 31 other global sensations — and notched a milestone by winning the tournament with a career-defining victory against former UFC fighter Shayna Baszler in the Finale. History repeated itself almost a year later, when Sane defeated Baszler to capture the NXT Women’s Championship at NXT TakeOver: Brooklyn IV. Shortly thereafter, Sane set sail for uncharted waters by joining the SmackDown LIVE roster in the 2019 Superstar Shake-up and immediately forming The Kabuki Warriors with Asuka. Sane and Asuka captured the WWE Women's Tag Team Titles from Alexa Bliss and Nikki Cross at WWE Hell in a Cell 2019 when The Empress of Tomorrow used the green mist against Cross.","alterEgos":["Kairi Sane","Kairi Hojo"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1891,2508,2759,3514],"staffAttributes":{"bookingLogic":82,"storytelling":83,"productFit":100,"riskTaking":39,"matchLayout":83,"psychology":82,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":79,"characterCoaching":76,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":61,"mediaHandling":76,"brandBuilding":78,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":68,"awareness":82,"judgement":89},"picture":"Kairi Hojo_alt17.png"},{"id":1790,"name":"Koguma","realName":"Koguma","nickname":"","type":"wrestler","promotionId":61,"base":"Japan","gender":"F","weight":132,"height":147,"dateOfBirth