17 he made his debut for Impact Wrestling.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2573","wrestlerId":2573,"promotionId":49,"startDate":"2023-06-16T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":16400,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1777],"staffAttributes":{"bookingLogic":64,"storytelling":68,"productFit":100,"riskTaking":23,"matchLayout":69,"psychology":64,"workerManagement":100,"trainingIntensity":55,"technicalCoaching":48,"characterCoaching":62,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":62,"brandBuilding":47,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":74,"awareness":64,"judgement":78},"picture":"Kevin Matthews.png"},{"id":2574,"name":"Sangre Imperial","realName":"Sangre Imperial","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":187,"height":175,"dateOfBirth":"1993-12-24T00:00:00.000Z","debut":"2011-04-01T00:00:00.000Z","wage":32000,"wageType":"per-appearance","popularity":3,"charisma":43,"micSkills":44,"condition":91,"hardcoreAbility":44,"injuryProne":100,"ability":58,"currentAbility":57,"potentialAbility":64,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Sangre Imperial is an independent wrestler around Mexico City. Took the Súper Ciudadano gimmick on June 15, 2013, wrestling his debut match against El Patán for Toryumon during the DragonMania VIII event. Patan and Ciudadano have since faced off just about every Toryumon Mexico show; both characters only appear on those shows. Súper Ciudadano is a wrestler who represents the Consejo Ciudadano de Seguridad Pública y Procuración de Justicia del Distrito Federal (Distrito Federal's Citizens Council For Public Security And Justice Procuratory) in order to avoid the bullying in Mexican schools. He earned the third place in Students Category at 2014 CMLL Bodybuilding Contest. The man behind the mask is a former medical student with seven years of training in wrestling at the time of his debut.","alterEgos":[],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2574","wrestlerId":2574,"promotionId":11,"startDate":"2016-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":46,"storytelling":54,"productFit":42,"riskTaking":33,"matchLayout":57,"psychology":46,"workerManagement":42,"trainingIntensity":82,"technicalCoaching":53,"characterCoaching":40,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":40,"brandBuilding":45,"socialMediaSavvy":31,"ruleKnowledge":0,"positioning":8,"reactionSpeed":82,"consistency":71,"awareness":46,"judgement":44},"picture":"Sangre Imperial.png"},{"id":2575,"name":"Brandi Lauren","realName":"Brandi Lauren","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":135,"height":170,"dateOfBirth":"1996-09-26T00:00:00.000Z","debut":"2016-03-01T00:00:00.000Z","wage":37500,"popularity":12,"charisma":58,"micSkills":33,"condition":99,"hardcoreAbility":41,"injuryProne":100,"ability":54,"currentAbility":54,"potentialAbility":73,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":fal