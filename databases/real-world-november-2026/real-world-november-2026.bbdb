],"jobs":[],"titles":[]},"teams":[2308,4355],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":36,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":58,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":56,"brandBuilding":38,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":63,"awareness":58,"judgement":75},"picture":"Robbie X.png"},{"id":2409,"name":"Angel","realName":"Garza Jr.","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":211,"height":177,"dateOfBirth":"1992-09-23T00:00:00.000Z","debut":"2008-11-01T00:00:00.000Z","wage":41000,"wageType":"monthly","popularity":30,"charisma":74,"micSkills":81,"condition":94,"hardcoreAbility":85,"injuryProne":100,"ability":62,"currentAbility":62,"potentialAbility":69,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Blessed with movie-star good looks, a spectacular sports-entertainment pedigree and machismo to spare, Angel Garza is an attention-getter to the nth degree.\r\n\r\nThe third-generation luchador, who hails from Mexico’s famed Garza wrestling dynasty, broke into the sport at age 15 and hasn’t looked back since. After spending a decade conquering the competition in his homeland, Garza was signed to NXT in 2019, joining a roster that already included his cousin Humberto Carrillo. Following in the footsteps of his forefathers — such as his late uncle, former WCW Superstar Hector Garza — Angel Garza proudly embodies the traditions of lucha libre, employing a silky-smooth style of combat that emphasizes attacks from the sky.\r\n\r\nIn short, Garza’s good and he knows it. He’s not bashful about praising his own abilities or even his cosmetic appeal.","alterEgos":["Garza Jr.","El Hijo del Ninja","Angel Garza"],"birthplace":"Monterrey, Nuevo León, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2409","wrestlerId":2409,"promotionId":5,"startDate":"2024-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":41000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1067,2060,2365,2785,3878],"staffAttributes":{"bookingLogic":58,"storytelling":65,"productFit":100,"riskTaking":22,"matchLayout":67,"psychology":58,"workerManagement":100,"trainingIntensity":72,"technicalCoaching":58,"characterCoaching":74,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":74,"brandBuilding":69,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":72,"consistency":70,"awareness":58,"judgement":75},"picture":"Angel.png"},{"id":2410,"name":"Gringo Loco","realName":"Gringo Loco","nickname":"","type":"wrestler","promotionId":77,"base":"USA","gender":"M","weight":253,"height":167,"dateOfBirth":"1985-07-20T00:00:00.000Z","debut":"2000-03-01T00:00:00.000Z","wage":19700,"wageType":"per-appearance","popularity":9,"charisma":93,"micSkills":91,"condition":75,"hardcoreAbility":68,"injuryProne":100,"ability":65,"currentAbility":65,"potentialAbility":68,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Gringo Loco took MLW by storm in late 2018. Winning fans and league officials over with his versatility blending lucha libre with brawling, Loco has become one of the more exciting newcomers in MLW in some time. Loco has competed in Mexico for AAA among other groups on and off for the last several years. A cunning veteran, this resourceful wrestler mixes aspects of being a rudo and tecnico into his in-ring game. Referring to himself as the “base god” because of his ability to use his body as a gravitational base to counter his high flying opponents to his advantage, Gringo Loco can go with the best of them. Now, Gringo Loco looks to show the world he is truly major league.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2410","wrestlerId":2410,"promotionId":77,"startDate":"2018-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":19700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3532],"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":27,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":48,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":64,"brandBuilding":36,"socialMediaSavvy":53,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":76,"awareness":62,"judgement":77},"picture":"Gringo Loco.png"},{"id":2411,"name":"Dave the Clown","realName":"Dave the Clown","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":191,"height":170,"dateOfBirth":"1984-09-26T00:00:00.000Z","debut":"2012-02-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":7,"charisma":41,"micSkills":32,"condition":95,"hardcoreAbility":30,"injuryProne":100,"ability":51,"currentAbility":44,"potentialAbility":47,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":fa