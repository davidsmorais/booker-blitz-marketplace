":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Elaban was one of four children, and has two sisters Natasha and Kiana and a brother named Cody. Elaban graduated in 2007 from James Bowie High School in Austin, Texas where she played volleyball as a middle blocker and right-side for three seasons. She attended Concordia University Texas during 2010 where she played volleyball as a middle blocker and right-side. While in Concordia University Texas, Elaban majored in Communications. Elaban joined the WWE in 2017 and made her debut in NXT during the house show on October 7, in a battle royal won by Vanessa Borne. Two weeks later, Elaban wrestled in a Halloween Costume Battle Royal won by Shayna Baszler.","alterEgos":["Jessi Kamea"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":35,"storytelling":39,"productFit":29,"riskTaking":40,"matchLayout":40,"psychology":35,"workerManagement":29,"trainingIntensity":62,"technicalCoaching":32,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":60,"mediaHandling":58,"brandBuilding":53,"socialMediaSavvy":46,"ruleKnowledge":0,"positioning":6,"reactionSpeed":62,"consistency":50,"awareness":35,"judgement":33},"picture":"Jessie Elaban.png"},{"id":3078,"name":"Matt Gatlin","realName":"Matt Gatlin","nickname":"","type":"wrestler","base":"UK","gender":"M","weight":208,"height":170,"dateOfBirth":"1995-01-29T00:00:00.000Z","debut":"2016-01-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":38,"micSkills":40,"condition":90,"hardcoreAbility":60,"injuryProne":100,"ability":45,"currentAbility":45,"potentialAbility":53,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"ma