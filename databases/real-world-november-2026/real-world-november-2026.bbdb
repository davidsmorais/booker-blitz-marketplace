losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[929,930,1258,1259,1347,1356,1375,1524,3017],"staffAttributes":{"bookingLogic":64,"storytelling":70,"productFit":100,"riskTaking":27,"matchLayout":72,"psychology":64,"workerManagement":100,"trainingIntensity":84,"technicalCoaching":78,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":54,"brandBuilding":64,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":20,"reactionSpeed":84,"consistency":80,"awareness":64,"judgement":78},"picture":"Davey Richards_alt3.png"},{"id":244,"name":"Delirious","realName":"Delirious","nickname":"","type":"trainer","promotionId":28,"base":"USA","gender":"M","weight":200,"height":175,"dateOfBirth":"1980-12-19T00:00:00.000Z","debut":"2001-07-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":11,"charisma":75,"micSkills":75,"condition":84,"hardcoreAbility":76,"injuryProne":100,"ability":76,"currentAbility":60,"potentialAbility":62,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"“Bah bah bah … bah bah … bah … BAHHHHH!”\r\n\r\nIn other words, welcome to the Edge of Sanity, where Delirious resides when he’s not busy tearing up the wrestling ring with a style as unpredictable and chaotic as the language -- or is it languages? -- flowing from his mouth. The unorthodox masked madman made his Ring of Honor debut in 2004 and quickly gained a cult following despite not winning his first match in ROH until two years later.\r\n\r\nDelirious went on to win the 2006 Survival of the Fittest and become a top challenger for the ROH World Championship. Delirious’ appearances in ROH have been sporadic in recent years, but the one thing that has remained certain about Delirious is that absolutely nothing is for certain.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-244","wrestlerId":244,"promotionId":28,"startDate":"2022-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2637,2649],"staffAttributes":{"bookingLogic":29,"storytelling":22,"productFit":59,"riskTaking":26,"matchLayout":51,"psychology":34,"workerManagement":41,"trainingIntensity":68,"technicalCoaching":74,"characterCoaching":50,"teaching":78,"diagnosis":32,"rehabilitation":21,"prevention":51,"mediaHandling":34,"brandBuilding":51,"socialMediaSavvy":20,"ruleKnowledge":40,"positioning":32,"reactionSpeed":55,"consistency":31,"awareness":46,"judgement":53},"picture":"Delirious_alt1.png"},{"id":245,"name":"Eddie Edwards","realName":"Eddie Edwards","nickname":"","type":"wrestler","promotionId":28,"base":"USA","gender":"M","weight":214,"height":180,"dateOfBirth":"1983-12-30T00:00:00.000Z","debut":"2002-01-01T00:00:00.000Z","wage":30700,"wageType":"per-appearance","popularity":29,"charisma":100,"micSkills":79,"condition":76,"hardcoreAbility":100,"injuryProne":100,"ability":75,"currentAbility":75,"potentialAbility":78,"morale":"poor","presentation":"heel","prestige":"low","style":"submission","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Eddie Edwards is an American wrestler who works in America, Canada and Japan. He is a Middleweight who is classed as using a Impactful style. He is best known for his work with AAA, NOAH, IMPACT, PWG, ROH, ZERO1, RevPro, WRESTLE-1, Beyond, AAW, C4 and CZW. He is married to Alexxis Nevaeh. He was one half of the Tag Team Of The Year in 2009.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-245","wrestlerId":245,"promotionId":28,"startDate":"2014-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[929,930,1033,1375,1524,2664,4001],"staffAttributes":{"bookingLogic":72,"storytelling":76,"productFit":100,"riskTaking":24,"matchLayout":77,"psychology":72,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":77,"characterCoaching":55,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":55,"brandBuilding":52,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":82,"awareness":72,"judgement":83},"picture":"Eddie Edwards.png"},{"id":247,"name":"Fit Finlay","realName":"Fit Finlay","nickname":"","type":"trainer","promotionId":64,"base":"Other","gender":"M","weight":233,"height":175,"dateOfBirth":"1958-01-31T00:00:00.000Z","debut":"1974-01-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":31,"charisma":95,"micSkills":92,"condition":62,"hardcoreAbility":95,"injuryProne":87,"ability":92,"currentAbility":42,"potentialAbility":42,"morale":"poor","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"His name is Finlay, and he loves to fight. That was the tough-as-nails Northern Irishman’s mantra throughout his sports-entertainment career. After demolishing opponents across Europe for 20 years, Fit Finlay first invaded the United States in 1996, blindsiding Lord Steven Regal on WCW Saturday Night and declaring that he was out for revenge for 400 years of oppression against his people by the British. That ignited a brutal rivalry that saw them scuffle in arenas throughout the country and even in a vicious Parking Lot Brawl that is remembered to this day. Though Finlay left active competition in 2010, there’s always a chance that the surly Superstar will get the itch to put up his dukes and start brawling with any and all comers.","alterEgos":["Finlay"],"birthplace":"Carrickfergus, County Antrim, Northern Ireland","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-247","wrestlerId":247,"promotionId":64,"startDate":"2020-11-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[169,2682],"staffAttributes":{"bookingLogic":31,"storytelling":50,"productFit":60,"riskTaking":21,"matchLayout":57,"psychology":33,"workerManagement":37,"trainingIntensity":58,"technicalCoaching":41,"characterCoaching":62,"teaching":95,"diagnosis":37,"rehabilitation":37,"prevention":41,"mediaHandling":53,"brandBuilding":54,"socialMediaSavvy":57,"ruleKnowledge":59,"positioning":50,"reactionSpeed":51,"consistency":40,"awareness":41,"judgement":56},"picture":"Fit Finlay.png"},{"id":250,"name":"Homicide","realName":"Homicide","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":220,"height":175,"dateOfBirth":"1977-03-20T00:00:00.000Z","debut":"1993-03-01T00:00:00.000Z","wage":37500,"popularity":16,"charisma":56,"micSkills":74,"condition":69,"hardcoreAbility":64,"injuryProne":100,"ability":75,"currentAbility":55,"potentialAbility":75,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Homicide is an American wrestler who works in America and Canada. He is a Lightweight who is classed as using a Brawler style. He is one half of Strong Style Thugz alongside Eddie Kingston. He is best known for his work with IMPACT, BJW, NJoA, NWA, ROH, MLW, GCW, ZERO1 and AAW. He is married to someone outside the wrestling business. He was one half of the Tag Team Of The Year in 2006. He is part of the GCW Hall Of Fame.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[144,1152,1267,1657,1928,2651],"staffAttributes":{"bookingLogic":68,"storytelling":73,"productFit":100,"riskTaking":27,"matchLayout":74,"psychology":68,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":58,"characterCoaching":73,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":73,"brandBuilding":52,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":80,"awareness":68,"judgement":81},"picture":"Homicide_alt2.png"},{"id":252,"name":"Jay Lethal","realName":"Jay Lethal","nickname":"","type":"wrestler","promotionId":49,"base":"USA","gender":"M","weight":213,"height":175,"dateOfBirth":"1985-04-29T00:00:00.000Z","debut":"2001-12-01T00:00:00.000Z","wage":32800,"wageType":"per-appearance","popularity":32,"charisma":58,"micSkills":77,"condition":75,"hardcoreAbility":57,"injuryProne":100,"ability":68,"currentAbility":60,"potentialAbility":83,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Jay Lethal has come to be known as “The Franchise” in Ring of Honor, and with good reason. Lethal, who made his debut with ROH as a teenager in 2003, is the only man to have held the ROH World and ROH World Television Titles simultaneously, as well as the only man to have won all three singles titles in ROH (including the Pure Title, which was subsequently merged with the world title). No one has held the ROH World Television Title longer than Lethal, and his 427-day reign as ROH World Champion is the fourth-longest. Lethal also has won the Honor Rumble (2011) and Survival of the Fittest (2012).\r\n\r\nBeyond that impressive list of accomplishments, Lethal continues to be the measuring stick in ROH. A victory over Lethal not only is a major achievement, but it’s also career-defining.","alterEgos":[],"birthplace":"Elizabeth, New Jersey, United States","managerId":0,"contractExpiryDate":"2026-12-20T00:00:00.000Z","contract":{"id":"tew-contract-252","wrestlerId":252,"promotionId":49,"startDate":"2024-12-20T00:00:00.000Z","endDate":"2026-12-20T00:00:00.000Z","wage":32800,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[113,1172,1972,2652,2653],"staffAttributes":{"bookingLogic":76,"storytelling":79,"productFit":100,"riskTaking":17,"matchLayout":80,"psychology":76,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":69,"characterCoaching":71,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":71,"brandBuilding":54,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":79,"awareness":76,"judgement":86},"picture":"Jay Lethal.png","additionalContracts":[{"id":"tew-contract-252-76","wrestlerId":252,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},{"id":"tew-contract-252-118","wrestlerId":252,"promotionId":118,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":10500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW","MLP"]},{"id":253,"name":"Jim Cornette","realName":"Jim Cornette","nickname":"","type":"writer","base":"USA","gender":"M","weight":231,"height":180,"dateOfBirth":"1961-09-17T00:00:00.000Z","debut":"1982-01-01T00:00:00.000Z","wage":66000,"popularity":27,"charisma":78,"micSkills":87,"condition":89,"hardcoreAbility":91,"injuryProne":45,"ability":76,"currentAbility":35,"potentialAbility":37,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"James Mark \"Jim\" Cornette is an American professional wrestling manager, commentator, promoter, and booker. Cornette is the former \"Commissioner\" of Ring of Honor and is formerly a road agent for Total Nonstop Action Wrestling. As a manager and creative writer, he has worked for Jim Crockett Promotions, World Championship Wrestling and the World Wrestling Federation, and from 1991 to 1995, was the owner of Smoky Mountain Wrestling. A firm believer in \"old-school\" territorial wrestling, Cornette began the Smoky Mountain Wrestling (SMW) promotion in 1991. SMW promoted shows in Tennessee, Kentucky, West Virginia, Georgia, and the Carolinas. By this point, however, the nature of wrestling in the United States had already changed irrevocably, leading Cornette to seek a working relationship with the WWF in 1993. This did not change the new national perception that regional promotions were \"minor league\". The move also did not help the federation's finances, and Cornette closed SMW's doors.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":33,"storytelling":34,"productFit":26,"riskTaking":25,"matchLayout":92,"psychology":74,"workerManagement":53,"trainingIntensity":47,"technicalCoaching":22,"characterCoaching":56,"teaching":27,"diagnosis":60,"rehabilitation":54,"prevention":25,"mediaHandling":39,"brandBuilding":39,"socialMediaSavvy":48,"ruleKnowledge":48,"positioning":29,"reactionSpeed":37,"consistency":43,"awareness":42,"judgement":41},"picture":"Jim Cornette_alt1.png"},{"id":254,"name":"Jimmy Jacobs","realName":"Jimmy Jacobs","nickname":"","type":"manager","promotionId":118,"base":"USA","gender":"M","weight":180,"height":167,"dateOfBirth":"1984-02-17T00:00:00.000Z","debut":"1999-05-01T00:00:00.000Z","wage":10500,"wageType":"per-appearance","popularity":17,"charisma":62,"micSkills":50,"condition":63,"hardcoreAbility":59,"injuryProne":100,"ability":53,"currentAbility":46,"potentialAbility":49,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Jimmy Jacobs is an American wrestler who works in America and Canada. He is a Small worker who is classed as using a Daredevil style. He is best known for his work with IMPACT, NXT, ROH, AAW and IWA-MS. He is the current booker of IMPACT.","alterEgos":["Zombie Princess"],"birthplace":"United States","managerId":0,"contractExpiryDate":"2027-06-01T00:00:00.000Z","contract":{"id":"tew-contract-254","wrestlerId":254,"promotionId":118,"startDate":"2025-06-01T00:00:00.000Z","endDate":"2027-06-01T00:00:00.000Z","wage":10500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1006,1372,1426,1565],"staffAttributes":{"bookingLogic":76,"storytelling":77,"productFit":100,"riskTaking":38,"matchLayout":77,"psychology":76,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":45,"characterCoaching":76,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":76,"brandBuilding":52,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":67,"awareness":76,"judgement":86},"picture":"Jimmy Jacobs_alt1.png"},{"id":256,"name":"Kevin Kelly","realName":"Kevin Kelly","nickname":"","type":"commentator","base":"USA","gender":"M","weight":240,"height":175,"dateOfBirth":"1967-05-09T00:00:00.000Z","debut":"1992-01-01T00:00:00.000Z","wage":66000,"popularity":10,"charisma":46,"micSkills":60,"condition":100,"hardcoreAbility":48,"injuryProne":53,"ability":65,"currentAbility":35,"potentialAbility":37,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kevin Kelly is an American man who works primarily as an announcer. He is best known for his work with WWE, NJPW, AEW and ROH. He has been voted Announcer Of The Year four times.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":11,"storytelling":9,"productFit":0,"riskTaking":99,"matchLayout":8,"psychology":11,"workerManagement":0,"trainingIntensity":1,"technicalCoaching":0,"characterCoaching":34,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":1,"mediaHandling":34,"brandBuilding":16,"socialMediaSavvy":31,"ruleKnowledge":0,"positioning":0,"reactionSpeed":1,"consistency":2,"awareness":11,"judgement":7},"picture":"Kevin Kelly_alt1.png"},{"id":257,"name":"Kevin Owens","realName":"Kevin Steen","nickname":"","type":"wrestler","promotionId":64,"base":"Canada","gender":"M","weight":264,"height":177,"dateOfBirth":"1984-05-07T00:00:00.000Z","debut":"2000-05-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":61,"charisma":78,"micSkills":88,"condition":82,"hardcoreAbility":66,"injuryProne":100,"ability":75,"currentAbility":75,"potentialAbility":88,"morale":"good","presentation":"heel","prestige":"mid","style":"striker","cardPosition":"mid","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kevin Owens is an outspoken, Quebec-born brawler who bolts around the ring with equal parts grace and bad intentions. \r\n\r\nLauded by The Rock and possessing what WWE Hall of Famer “Stone Cold” Steve Austin described as a “hell of an arsenal,” Owens earned many accolades in North America and abroad.\r\n\r\nKO became a man of the people when he engaged in an epic struggle with Shane McMahon, and Owens prevailed when he defeated Shane-O-Mac in a Ladder Match during the premiere of Friday Night SmackDown to earn the right to fire his rival! Owens kept rolling when he was selected by Raw in the 2019 WWE Draft, immediately engaging in a heated rivalry with Seth Rollins and defeating him at WrestleMania in a match that saw KO come crashing down on Rollins after taking an awe-inspiring leap from the top of the WrestleMania sign!\r\n\r\nNow that he's back on SmackDown as a result of the 2020 WWE Draft, KO will be looking to dole out Stunners and fight his way to the top of the blue brand.","alterEgos":["Kevin Steen"],"birthplace":"Saint-Jean-sur-Richelieu, Quebec, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-257","wrestlerId":257,"promotionId":64,"startDate":"2014-08-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1040,1114,1256,1330,1360,1744,2761,3450],"staffAttributes":{"bookingLogic":81,"storytelling":82,"productFit":100,"riskTaking":20,"matchLayout":82,"psychology":81,"workerManagement":100,"trainingIntensity":79,"technicalCoaching":64,"characterCoaching":83,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":83,"brandBuilding":58,"socialMediaSavvy":85,"ruleKnowledge":0,"positioning":20,"reactionSpeed":79,"consistency":83,"awareness":81,"judgement":89},"picture":"Kevin Owens.png"},{"id":258,"name":"Kyle O'Reilly","realName":"Kyle O'Reilly","nickname":"","type":"wrestler","promotionId":76,"base":"Canada","gender":"M","weight":200,"height":177,"dateOfBirth":"1987-03-01T00:00:00.000Z","debut":"2005-10-01T00:00:00.000Z","wage":60000,"wageType":"monthly","popularity":37,"charisma":79,"micSkills":91,"condition":75,"hardcoreAbility":87,"injuryProne":100,"ability":70,"currentAbility":70,"potentialAbility":74,"morale":"fair","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kyle O’Reilly wants to shock the system of NXT, and with Roderick Strong, Adam Cole and Bobby Fish as his allies, he’s well on his way to reaching that goal. O’Reilly, Strong, Cole and Fish constitute the alliance known as The Undisputed ERA, a lawless outfit that has wreaked havoc in NXT since their emergence in August 2017. Employing a wolf pack mentality, the group has attacked everyone from Drew McIntyre to SAnitY, destabilizing the entire black-and-yellow-brand in the process. Causing carnage, however, isn’t a new trait for O’Reilly. Even prior to joining NXT, he carved out a niche as one of the ring’s most well-versed and dangerous competitors. With a background that spans Brazilian jiu-jitsu, kickboxing and other martial arts, O’Reilly is equally equipped to trade strikes as he is to cinch in submission holds. O’Reilly also formed championship tag team combinations with both Cole and Fish before exposing NXT to The Undisputed ERA.","alterEgos":[],"birthplace":"Delta, British Columbia, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-258","wrestlerId":258,"promotionId":76,"startDate":"2021-12-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1062,1288,1289,1356,1635,1762,3429,4175],"staffAttributes":{"bookingLogic":72,"storytelling":75,"productFit":100,"riskTaking":20,"matchLayout":76,"psychology":72,"workerManagement":100,"trainingIntensity":87,"technicalCoaching":77,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":65,"brandBuilding":47,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":87,"consistency":82,"awareness":72,"judgement":83},"picture":"Kyle O'Reilly.png"},{"id":260,"name":"Maria Kanellis","realName":"Maria Kanellis","nickname":"","type":"manager","base":"USA","gender":"F","weight":120,"height":167,"dateOfBirth":"1982-02-25T00:00:00.000Z","debut":"2004-11-01T00:00:00.000Z","wage":66000,"popularity":29,"charisma":47,"micSkills":40,"condition":89,"hardcoreAbility":33,"injuryProne":100,"ability":59,"currentAbility":49,"potentialAbility":49,"morale":"poor","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Maria Kanellis is a retired American wrestler who works as a manager and an on-screen personality. She is best known for her work with WWE, AEW, IMPACT and ROH. She is married to Mike Bennett. She is the protege of Paul Heyman.","alterEgos":["Maria Kanellis-Bennett"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":45,"storytelling":47,"productFit":47,"riskTaking":22,"matchLayout":48,"psychology":45,"workerManagement":47,"trainingIntensity":58,"technicalCoaching":27,"characterCoaching":76,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":76,"brandBuilding":67,"socialMediaSavvy":69,"ruleKnowledge":0,"positioning":9,"reactionSpeed":58,"consistency":61,"awareness":45,"judgement":46},"picture":"Maria Kanellis_alt10.png"},{"id":261,"name":"Mark Briscoe","realName":"Mark Briscoe","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":229,"height":180,"dateOfBirth":"1985-01-18T00:00:00.000Z","debut":"2000-05-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":38,"charisma":100,"micSkills":97,"condition":75,"hardcoreAbility":100,"injuryProne":100,"ability":72,"currentAbility":72,"potentialAbility":85,"morale":"fair","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Mark Briscoe is an American wrestler who works in the USA, Canada and Japan. He is a 6'0\", 229lb worker who is classed as using a Daredevil style. He uses the Cut-Throat Driver, the Froggy Bow and the Jay Driller as his finishers. He is one half of The Briscoes alongside Jay Briscoe. He is best known for his work with AEW and ROH. He is currently the AEW TNT champion. He was one half of the Male Tag Team Of The Year in 2007. He is part of the ROH Hall Of Fame (with partner Jay Briscoe).","alterEgos":[],"birthplace":"Laurel, Delaware, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-261","wrestlerId":261,"promotionId":76,"startDate":"2023-02-15T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000