,"base":"USA","gender":"M","weight":187,"height":175,"dateOfBirth":"1991-03-30T00:00:00.000Z","debut":"2010-05-22T00:00:00.000Z","wage":37500,"popularity":2,"charisma":39,"micSkills":46,"condition":100,"hardcoreAbility":49,"injuryProne":100,"ability":47,"currentAbility":45,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"hardcore","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Reed Bentley is an American wrestler who works in the USA and Canada. He is a 5'10\", 187lb worker who is classed as using a Hardcore style. He uses the Back Senton and the Italian Leatherface as his finishers. He is one half of The Rejects alongside John Wayne Murdoch. He is best known for his work with GCW, Beyond, AAW, IWA-MS, ICW NHB and CZW.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2535,2998],"staffAttributes":{"bookingLogic":54,"storytelling":56,"productFit":100,"riskTaking":33,"matchLayout":57,"psychology":54,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":33,"characterCoaching":59,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":59,"brandBuilding":29,"socialMediaSavvy":52,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":75,"awareness":54,"judgement":72},"picture":"Reed Bentley.png"},{"id":2287,"name":"Herzog","realName":"Herzog","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":268,"height":193,"dateOfBirth":"1989-01-02T00:00:00.000Z","debut":"2009-04-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":39,"micSkills":63,"condition":83,"hardcoreAbility":47,"injuryProne":100,"ability":43,"currentAbility":40,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":