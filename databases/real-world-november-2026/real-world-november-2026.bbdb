th The Midnight Express (Bobby Eaton and Dennis Condrey) in the USWA/CWA, and the feud carried over into the National Wrestling Alliance. In February 2017, WWE played a video package of the Rock n' Roll Express and the announcement of their hall of fame induction set for pre-WrestleMania.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1907,1929],"staffAttributes":{"bookingLogic":74,"storytelling":77,"productFit":100,"riskTaking":20,"matchLayout":78,"psychology":74,"workerManagement":100,"trainingIntensity":50,"technicalCoaching":42,"characterCoaching":35,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":35,"brandBuilding":33,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":50,"consistency":49,"awareness":74,"judgement":84},"picture":"Robert Gibson.png"},{"id":3165,"name":"Arianna Grace","realName":"Bianca Carelli","nickname":"","type":"wrestler","promotionId":65,"base":"Canada","gender":"F","weight":138,"height":167,"dateOfBirth":"1997-06-29T00:00:00.000Z","debut":"2018-06-01T00:00:00.000Z","wage":20500,"wageType":"monthly","popularity":7,"charisma":32,"micSkills":43,"condition":100,"hardcoreAbility":41,"injuryProne":100,"ability":47,"currentAbility":47,"potentialAbility":56,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":true,"story":"Bianca Carelli is a Canadian wrestler who works exclusively in North America. She is a Small worker who is classed as using a Technician style. Carelli, a former pageant contestant and Miss Teen Ontario-World winner in 2013, has been training at the Wrestling Factory in London, Ontario under the supervision of Cruiserweight Classic participant, Tyson Dux. She is a second generati