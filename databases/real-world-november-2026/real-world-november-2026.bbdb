realName":"Lance Archer","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":264,"height":195,"dateOfBirth":"1977-02-28T00:00:00.000Z","debut":"2000-07-01T00:00:00.000Z","wage":60000,"wageType":"per-appearance","popularity":36,"charisma":63,"micSkills":78,"condition":69,"hardcoreAbility":75,"injuryProne":100,"ability":54,"currentAbility":54,"potentialAbility":76,"morale":"fair","presentation":"heel","prestige":"low","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Lance Archer is an American wrestler who works in America, Canada, the British Isles and Japan. He is a Heavyweight who is classed as using a Powerhouse style. He is one half of Killer Elite Squad alongside Davey Boy Smith Jr.. He is best known for his work with WWE, NJPW, AEW, IMPACT, NOAH, NJoA, AJPW and DEFY. He is married to someone outside the wrestling business.","alterEgos":["Dallas","Vance Archer"],"birthplace":"Hearne, Texas, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-321","wrestlerId":321,"promotionId":76,"startDate":"2020-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":60000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[816,1136,1138,1299,2660,3783,4059],"staffAttributes":{"bookingLogic":59,"storytelling":62,"productFit":100,"riskTaking":22,"matchLayout":63,"psychology":59,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":40,"characterCoaching":69,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":69,"brandBuilding":73,"socialMediaSavvy":57,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":67,"awareness":59,"judgement":75},"picture":"Lance Archer.png"},{"id":322,"name":"Wataru Inoue","realName":"Wataru Inoue","nickname":"","type":"scout","promotionId":38,"base":"Japan","gender":"M","weight":207,"height":177,"dateOfBirth":"1973-07-27T00:00:00.000Z","debut":"1999-10-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":8,"charisma":72,"micSkills":93,"condition":65,"hardcoreAbility":69,"injuryProne":100,"ability":84,"currentAbility":55,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Wataru Inoue is a Japanese professional wrestler currently working for New Japan Pro Wrestling. An understudy to Yuji Nagata, has shown very little growth since joining New Japan in 04. Inoue made his debut in 1999 on the Japanese independent circuit, then climbed the ladder to get to New Japan Pro Wrestling in 2004. He aligned himself with New Japan Junior Seikigun, a face stable created in order to counteract Jushin Liger's Control Terrorism Unit in the latter half of 2005. Inoue was injured February 2007 and did not return until July of the same year where he & his mentor Koji Kanemoto lost an IWGP Jr. Tag Team Title Match against Kai En Tai. Has grown stale, many have hopes that he'll be given a chance to go on a excursion soon.","alterEgos":[],"birthplace":"Tokyo, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-322","wrestlerId":322,"promotionId":38,"startDate":"1998-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3046,3047],"staffAttributes":{"bookingLogic":58,"storytelling":37,"productFit":44,"riskTaking":22,"matchLayout":40,"psychology":57,"workerManagement":28,"trainingIntensity":29,"technicalCoaching":54,"characterCoaching":59,"teaching":56,"diagnosis":60,"rehabilitation":39,"prevention":26,"mediaHandling":51,"brandBuilding":47,"socialMediaSavvy":38,"ruleKnowledge":37,"positioning":60,"reactionSpeed":58,"consistency":52,"awareness":49,"judgement":62},"picture":"Wataru Inoue_alt2.png"},{"id":324,"name":"Junji Hirata","realName":"Junji Hirata","nickname":"","type":"writer","promotionId":38,"base":"Japan","gender":"M","weight":254,"height":180,"dateOfBirth":"1956-12-20T00:00:00.000Z","debut":"1978-08-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":5,"charisma":85,"micSkills":100,"condition":76,"hardcoreAbility":84,"injuryProne":100,"ability":99,"currentAbility":45,"potentialAbility":45,"morale":"broken","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Junji Hirata is a Japanese professional wrestler also known by the ring name Super Strong Machine. Hirata made his debut in New Japan on August 26, 1978 against Yoshiaki Fujiwara. In November 1982, he left on an overseas training expedition to Mexico, and later Canada, where in Stu Hart's Stampede Wrestling he would create the famous Super Strong Machine persona, as well as use a First Nations gimmick as Sonny Two Rivers. In the fall of 1986, the World Wrestling Federation introduced a stable of wrestlers called The Machines -- \"The Giant Machine\" (André the Giant), \"Big Machine\" (Blackjack Mulligan), and \"Super Machine\" (Bill Eadie) -- based on Junji Hirata's popular Super Strong Machine gimmick. In December 1994, he finally unmasked, dropping the Super Strong Machine character and wrestling under his real name. He revived the Super Strong Machine persona for the first time in six years in October 2000.","al