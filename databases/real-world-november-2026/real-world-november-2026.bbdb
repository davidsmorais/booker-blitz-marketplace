randBuilding":33,"socialMediaSavvy":40,"ruleKnowledge":0,"positioning":20,"reactionSpeed":55,"consistency":44,"awareness":40,"judgement":64},"picture":"Jack Jester.png"},{"id":520,"name":"Dralistico","realName":"Dralistico","nickname":"","type":"wrestler","promotionId":76,"base":"Mexico","gender":"M","weight":167,"height":172,"dateOfBirth":"1992-09-15T00:00:00.000Z","debut":"2010-01-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":22,"charisma":61,"micSkills":67,"condition":91,"hardcoreAbility":69,"injuryProne":100,"ability":64,"currentAbility":64,"potentialAbility":81,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"He is one of the characters with a great reputation within Mexican Wrestling, possessor of one of the most representative images of this sport both inside and outside our borders.\r\n\r\nOriginally from Tala Jalisco, his first steps in this sport were led by his uncles, the Pit Bulls in his homeland. Soon he decided to pack suitcases and make the trip to Mexico City to seek an opportunity in the World Wrestling Council. This opportunity led him to become as part of The 2011 Generation, a group of promising young people and thus began his adventure in the In Search of an Idol tournament under the name of Dragon Lee.","alterEgos":["Místico"],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-520","wrestlerId":520,"promotionId":76,"startDate":"2022-12-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[982,3161,3533],"staffAttributes":{"bookingLogic":