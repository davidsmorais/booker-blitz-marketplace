xclusively in America. He is a Lightweight who is classed as using a Entertainer style. He is best known for his work with ROH, CHIKARA and CZW.","alterEgos":["Jasper Tippins"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1595,1596,1597],"staffAttributes":{"bookingLogic":40,"storytelling":48,"productFit":20,"riskTaking":45,"matchLayout":50,"psychology":40,"workerManagement":20,"trainingIntensity":66,"technicalCoaching":53,"characterCoaching":47,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":55,"mediaHandling":47,"brandBuilding":33,"socialMediaSavvy":42,"ruleKnowledge":0,"positioning":4,"reactionSpeed":66,"consistency":61,"awareness":40,"judgement":32},"picture":"Joey Keys.png"},{"id":2653,"name":"Robby","realName":"Robby","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":200,"height":182,"dateOfBirth":"1993-07-07T00:00:00.000Z","debut":"2015-02-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":62,"micSkills":44,"condition":100,"hardcoreAbility":59,"injuryProne":93,"ability":48,"currentAbility":47,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Robby is an American wrestler who works exclusively in America. He is a Lightweight who is classed as using a Entertainer style. He is best known for his work with CHIKARA and CZW.","alterEgos":["Donald Kluger","Robert Locke"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1595,1596,1597],"staffAttributes":{"bookingLogic":44,"storytelling":51,"productFit":20,"riskTaking":46,"matchLayout":53,"psychology":44,"workerManagement":20,"trainingIntensity":66,"technicalCoaching":53,"cha