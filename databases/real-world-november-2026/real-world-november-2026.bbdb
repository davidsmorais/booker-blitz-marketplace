ace","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Exhilarating one moment, sinister the next, Lita was a Diva who always kept the WWE Universe on their toes. Whether she was flying high with The Hardy Boyz or shocking censors alongside Edge, the four-time Women's Champion knew how to elicit a reaction around the world.\r\n\r\nLita made her WWE debut in 2000 alongside Essa Rios and quickly led him to the Light Heavyweight Championship that February, though the pair would split a few months later. Lita then hooked up with The Hardy Boyz to form Team Xtreme, beginning a partnership that would last nearly five years.","alterEgos":["Lita"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":67,"storytelling":67,"productFit":100,"riskTaking":53,"matchLayout":67,"psychology":67,"workerManagement":100,"trainingIntensity":54,"technicalCoaching":20,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":47,"mediaHandling":70,"brandBuilding":75,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":54,"consistency":40,"awareness":67,"judgement":80},"picture":"Lita_alt7.png"},{"id":1398,"name":"Blue Panther Jr.","realName":"Blue Panther Jr.","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":220,"height":177,"dateOfBirth":"1997-05-08T00:00:00.000Z","debut":"2013-12-01T00:00:00.000Z","wage":64000,"wageType":"per-appearance","popularity":11,"charisma":65,"micSkills":73,"condition":96,"hardcoreAbility":77,"injuryProne":100,"ability":73,"currentAbility":73,"potentialAbility":82,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aer