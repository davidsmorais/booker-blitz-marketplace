n":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Arturo Ruas has all but perfected the technique of grappling. That’s what happens when one spends an entire lifetime in the fighting game. Although Ruas never competed inside the squared circle before joining the WWE Performance Center in 2016, his vast experience in practically every other combat sport made him a can’t-miss prospect to NXT scouts and officials. For 17 years, Ruas was an unbeaten freestyle wrestling champion in his home country of Brazil. He’s a black belt in jiu-jitsu, well-versed in capoeira (a traditional form of Brazilian fighting) and hails from a legendary family of Aikido martial artists, making him one of the most dangerously skilled individuals walking the earth.","alterEgos":["Arturo Ruas"],"birthplace":"Brazil","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2545,2546],"staffAttributes":{"bookingLogic":43,"storytelling":49,"productFit":36,"riskTaking":30,"matchLayout":51,"psychology":43,"workerManagement":36,"trainingIntensity":74,"technicalCoaching":69,"characterCoaching":38,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":38,"brandBuilding":67,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":7,"reactionSpeed":74,"consistency":67,"awareness":43,"judgement":40},"picture":"Adrian Jaoude.png"},{"id":2828,"name":"Darby Allin","realName":"Darby Allin","nickname":"","type":"wrestler","promotionId":76,"base":"USA","gender":"M","weight":172,"height":170,"dateOfBirth":"1993-01-07T00:00:00.000Z","debut":"2015-11-01T00:00:00.000Z","wage":60000,"wageType":"monthly","popularity":44,"charisma":78,"micSkills":82,"condition":84,"hardcoreAbility":63,"injuryProne":100,"ability":78,"currentAbility":78,"potentialAbility":85,"morale":"fair","presentation":"face","prestige":"mid","style":"high