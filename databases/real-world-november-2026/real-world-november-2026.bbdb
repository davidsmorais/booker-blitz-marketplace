154lb worker who is classed as using a High Flyer style. He uses the Dropkick as his finisher. He is best known for his work with NJPW and Dragon Gate. He is the protege of Dragon Kid.","alterEgos":["DIA"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3387],"staffAttributes":{"bookingLogic":62,"storytelling":66,"productFit":100,"riskTaking":31,"matchLayout":68,"psychology":62,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":63,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":54,"brandBuilding":51,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":73,"awareness":62,"judgement":77},"picture":"Dragon Dia_alt.png"},{"id":3163,"name":"Ricky Morton","realName":"Ricky Morton","nickname":"","type":"wrestler","promotionId":79,"base":"USA","gender":"M","weight":227,"height":177,"dateOfBirth":"1956-09-21T00:00:00.000Z","debut":"1979-10-01T00:00:00.000Z","wage":24600,"wageType":"per-appearance","popularity":5,"charisma":56,"micSkills":57,"condition":63,"hardcoreAbility":69,"injuryProne":100,"ability":49,"currentAbility":22,"potentialAbility":24,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ricky Morton is an American wrestler who works in America and Canada. He is a Middleweight who is classed as using a Technician style. He has regular tag teams with Robert Gibson (The Rock 'n' Roll Express) and Kerry Morton (The Mortons). He is best known for his work with WWE, WCW, NJPW, IMPACT, ECW, AJPW, NWA, GCW and IWA-MS. He is married to someone outside the wrestling business. He is in the Hall Of Fame for WWE (with Robert Gibson) and NWA (with Robert Gibson).","alterEgos":[],"birthp