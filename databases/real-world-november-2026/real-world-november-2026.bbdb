},{"id":1630,"name":"Lil' Cholo","realName":"Lil' Cholo","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":207,"height":167,"dateOfBirth":"1982-12-23T00:00:00.000Z","debut":"2001-01-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":68,"micSkills":48,"condition":83,"hardcoreAbility":44,"injuryProne":100,"ability":58,"currentAbility":48,"potentialAbility":50,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Lil' Cholo is an american professional wrestler who has wrestled across the United States, appearing for promotions such as CZW and PWG among others. He is also known for his time with Lucha Underground as Cisco, a member of Big Rycks stable alongside Cortez Castro (Ricky Reyes).","alterEgos":["Cisco","Mala Suerte"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[476,1413,1620,1621,3166,3638],"staffAttributes":{"bookingLogic":47,"storytelling":55,"productFit":60,"riskTaking":37,"matchLayout":57,"psychology":47,"workerManagement":60,"trainingIntensity":83,"technicalCoaching":59,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":58,"brandBuilding":45,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":12,"reactionSpeed":83,"consistency":73,"awareness":47,"judgement":52},"picture":"Lil Cholo.png"},{"id":1631,"name":"Tom Hannifan","realName":"Tom Hannifan","nickname":"","type":"commentator","promotionId":28,"base":"USA","gender":"M","weight":207,"height":180,"dateOfBirth":"1989-05-19T00:00:00.000Z","debut":"2012-09-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":10,"charisma":72,"micSkills":48,"condition":100,"hardcoreAbility":48,"injuryProne":0,"ability":53,"currentAbility":50,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tom Phillips has described himself as “lucky and proud to be part of WWE.” With a Broadcast Journalism degree from Penn State University, Phillips spent time calling basketball games for the Big Ten Network while in college. Drawn to WWE during The Attitude Era, Phillips grew up watching “Stone Cold” Steve Austin, in addition to his hometown-based ECW. Since making his NXT debut in September 2012, Phillips can be heard broadcasting alongside WWE Superstars William Regal, Brad Maddox and Alex Riley. Taking his love of WWE to the forefront, Phillips now gets to call the action of the NXT Superstars and Divas who will pave the wave of the future for years to come. He is also an announcer on \"WWE Superstars\" and conducts backstage interviews for the WWE App.","alterEgos":["Tom Phillips"],"birthplace":"Philadelphia, Pennsylvania, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1631","wrestlerId":1631,"promotionId":28,"startDate":"2022-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":63,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":63,"brandBuilding":45,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Tom Hannifan.png"},{"id":1632,"name":"Tsukushi","realName":"Tsukushi","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":97,"height":142,"dateOfBirth":"1997-09-06T00:00:00.000Z","debut":"2010-01-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":52,"micSkills":52,"condition":84,"hardcoreAbility":43,"injuryProne":100,"ability":56,"currentAbility":56,"potentialAbility":56,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Tsukushi  is a Japanese professional wrestler. Trained by Emi Sakura, Tsukushi made her debut for her Ice Ribbon promotion in January 2010 as part of a trial series with Kurumi. After winning the fan voting, Tsukushi was made an official part of Ice Ribbon's roster the following March and she has since wrestled regularly for the promotion.","alterEgos":["Tsukushi Haruka"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2067,2475,2924],"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":30,"matchLayout":68,"psychology":62,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":68,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":68,"brandBuilding":55,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":73,"awareness":62,"judgement":77},"picture":"Tsukushi.png"},{"id":1634,"name":"Tzuki","realName":"Tzuki","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":88,"height":106,"dateOfBirth":"1973-12-31T00:00:00.000Z","debut":"1987-11-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":40,"micSkills":31,"condition":64,"hardcoreAbility":17,"injuryProne":89,"ability":35,"currentAbility":23,"potentialAbility":23,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"Tzuki is a Mexican Luchador enmascarado, or masked professional wrestler, who works as a Mini-Estrella or \"Mini\" division in Mexico. Throughout his career Tzuki has worked under various ring names, most notably Máscarita Sagrada, Jr., Mini Rey Misterio Jr. and Max Mini. Tzuki has worked for (AAA), the World Wrestling Federation (WWF) and a variety of special appearances for independent promotions all over Mexico, the United States, Europe and Japan and currently works for Consejo Mundial de Lucha Libre (CMLL). Tsuky's real name is not a matter of public record, as is often the case with masked wrestlers in Mexico where their private lives are kept a secret from the wrestling fans.","alterEgos":["Mascarita Sagrada Jr.","Max Mini"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":47,"storytelling":56,"productFit":100,"riskTaking":56,"matchLayout":59,"psychology":47,"workerManagement":100,"trainingIntensity":43,"technicalCoaching":17,"characterCoaching":43,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":44,"mediaHandling":43,"brandBuilding":24,"socialMediaSavvy":43,"ruleKnowledge":0,"positioning":20,"reactionSpeed":43,"consistency":47,"awareness":47,"judgement":68},"picture":"Tzuki.png"},{"id":1635,"name":"Bárbaro Cavernario","realName":"Bárbaro Cavernario","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":196,"height":170,"dateOfBirth":"1993-11-06T00:00:00.000Z","debut":"2008-01-01T00:00:00.000Z","wage":64000,"wageType":"per-appearance","popularity":17,"charisma":87,"micSkills":69,"condition":88,"hardcoreAbility":80,"injuryPro