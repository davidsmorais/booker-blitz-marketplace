ut":"2006-09-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":5,"charisma":45,"micSkills":43,"condition":93,"hardcoreAbility":60,"injuryProne":100,"ability":43,"currentAbility":40,"potentialAbility":40,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"RJ City is a Canadian actor and wrestler who works exclusively in North America. He is a Lightweight who is classed as using a Regular Wrestler style. He leaves no medium untouched. He can be seen as 'Gildar' in the kids show 'Splatalot' airing on Nickelodeon, BBC and in over 100 countries worldwide. He has also made appearances on the Disney Channel, ABC Spark and Teletoon as well as starring alongside Kevin Nash and Robert Maillet in 'Monster Brawl'. As 'RJ City', his professional wrestling exploits have lead him across an ever-growing list of cities in North America including an East Coast tour with Hulk Hogan and a feature in Maxim Magazine. He also became the first man in history to sing an Ethel Merman song in a wrestling ring.","alterEgos":[],"birthplace":"Richmond Hill, Ontario, Canada","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3059","wrestlerId":3059,"promotionId":76,"startDate":"2022-03-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2862,3280],"staffAttributes":{"bookingLogic":54,"storytelling":21,"productFit":33,"riskTaking":41,"matchLayout":22,"psychology":35,"workerManagement":45,"trainingIntensity":58,"technicalCoaching":56,"characterCoaching":32,"teaching":41,"diagnosis":40,"rehabilitation":57,"preventi