panese professional mixed martial artist and professional wrestler, also occasional Film actor and judoka, who is currently signed with Dramatic Dream Team and has fought and competed for World Victory Road, DREAM, Pancrase, Pro Wrestling Wave, S-Cup, Shooto, Union Pro, Kaientai Dojo, Dradition, LEGEND The Pro-Wrestling and K-1. Sakaguchi is known for his fight with Nigerian K-1 kickboxer, Film actor and male model Andy Ologun. Yukio is the son of former judoka and professional wrestling legend Seiji Sakaguchi and the older brother of former Urawa Red Diamonds player turned actor Kenji Sakaguchi. In 2009 Yukio was featured in Kamui Gaiden; the film was a box office hit in Japan and the Netherlands.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2379],"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":27,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":69,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":68,"brandBuilding":72,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":77,"awareness":63,"judgement":78},"picture":"Yukio Sakaguchi.png"},{"id":1479,"name":"Aja Kong","realName":"Aja Kong","nickname":"","type":"wrestler","base":"Japan","gender":"F","weight":227,"height":162,"dateOfBirth":"1970-09-25T00:00:00.000Z","debut":"1986-06-01T00:00:00.000Z","wage":37500,"popularity":19,"charisma":56,"micSkills":69,"condition":55,"hardcoreAbility":50,"injuryProne":100,"ability":64,"currentAbility":38,"potentialAbility":90,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Erika Shishido  is a professional wrestler, better known by the stage name Aja Kong, and the founder of the ARSION all-women professional wrestling promotion. Shishido has won several championships in both singles and tag team divisions throughout her career, primarily while with All Japan Women's Pro-Wrestling. Shishido was trained by AJW, and graduated as part of their class of 1986. She made her debut that summer, and immediately joined Dump Matsumoto's heel stable Gokuaku Domei. Aja wrestles for Mayumi Ozaki's promotion, Oz Academy. She has previously held the promotion's championship title and is currently leading the Jungle Jack 21 stable, which includes AKINO and Tomoka Nakagawa.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1711,2985,2986],"staffAttributes":{"bookingLogic":86,"storytelling":86,"productFit":100,"riskTaking":27,"matchLayout":86,"psychology":86,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":51,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":70,"brandBuilding":68,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":64,"awareness":86,"judgement":92},"picture":"Aja Kong.png"},{"id":1481,"name":"Dick Togo","realName":"Dick Togo","nickname":"","type":"wrestler","promotionId":38,"base":"Japan","gender":"M","weight":198,"height":167,"dateOfBirth":"1969-08-17T00:00:00.000Z","debut":"1991-06-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":14,"charisma":86,"micSkills":59,"condition":69,"hardcoreAbility":79,"injuryProne":100,"ability":75,"currentAbility":43,"potentialAbility":45,"morale":"broken","presentation":"heel","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Dick Togo is a Japanese wrestler who works in America and Japan. He is a Lightweight who is classed as using a Technician style. He is best known for his work with NJPW and DDT. He is married to someone outside the wrestling business.","alterEgos":[],"birthplace":"Odate, Akita, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1481","wrestlerId":1481,"promotionId":38,"startDate":"2020-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":84,"storytelling":85,"productFit":100,"riskTaking":20,"matchLayout":86,"psychology":84,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":64,"characterCoaching":65,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":65,"brandBuilding":48,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":72,"awareness":84,"judgement":90},"picture":"Dick Togo.png"},{"id":1482,"name":"Minoru Fujita","realName":"Minoru Fujita","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":196,"height":175,"dateOfBirth":"1977-09-05T00:00:00.000Z","debut":"1997-04-01T00:00:00.000Z","wage":4166,"popularity":4,"charisma":45,"micSkills":57,"condition":72,"hardcoreAbility":38,"injuryProne":100,"ability":62,"currentAbility":45,"potentialAbility":47,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":true,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Minoru Fujita is a Japanese professional wrestler contracted to Pro Wrestling Zero1, where he is a former AWA World Junior Heavyweight Champion, having won a tournament final against Takuya Sugawara. Fujita started in Big Japan Pro Wrestling as a protégé of its top junior heavyweight, Yoshihiro Tajiri. When Tajiri, who was Big Japan junior heavyweight champion, quit the company and gave up the title, Fujita had a decision match against Katsumi Usuda from the Battlarts promotion but ended up losing.","alterEgos":["HERO!"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1104,1826,2470,2897],"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":26,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":60,"characterCoaching":60,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":60,"brandBuilding":56,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":70,"awareness":62,"judgement":77},"picture":"Minoru Fujita.png"},{"id":1484,"name":"Guerrero de la Muerte","realName":"Guerrero de la Muerte","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":198,"height":170,"dateOfBirth":"1966-12-24T00:00:00.000Z","debut":"1991-12-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":64,"micSkills":64,"condition":76,"hardcoreAbility":53,"injuryProne":99,"ability":58,"currentAbility":30,"potentialAbility":30,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Luis Demetrio Enriquez is a Mexican professional wrestler better known under his ring name, Toxico. He is most notable for his work with the CMLL promotion where he held their Welterweight Title. He is also the cousin of the late Antonio Pena. He is not the only person in Mexico to use the name, but he is probably the more famous of the people usuing it.","alterEgos":["Toxico"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3261],"staffAttributes":{"bookingLogic":64,"storytelling":71,"productFit":100,"riskTaking":30,"matchLayout":73,"psychology":64,"workerManagement":100,"trainingIntensity":51,"technicalCoaching":51,"characterCoaching":78,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":78,"brandBuilding":62,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":20,"reactionSpeed":51,"consistency":53,"awareness":64,"judgement":78},"picture":"Guerrero de la Muerte.png"},{"id":1490,"name":"Amigo Suzuki","realName":"Amigo Suzuki","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":220,"height":167,"dateOfBirth":"1973-03-23T00:00:00.000Z","debut":"2002-08-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":67,"micSkills":68,"condition":78,"hardcoreAbility":45,"injuryProne":100,"ability":54,"currentAbility":35,"potentialAbility":37,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Amigo Suzuki is a Japanese wrestler known for his work with Toryumon and CHIKARA on the independant scene. Suzuki debuted in Toryumon Mexico in 2004 as Chuichiro Arai , (kayfabe) brother of Kenichiro and Koichiro Arai. In 2009, Suzuki joined Secret Base , a company formed by several other wrestlers from Toryumon.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":54,"storytelling":62,"productFit":100,"riskTaking":21,"matchLayout":64,"psychology":54,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":66,"characterCoaching":44,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":44,"brandBuilding":28,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":64,"awareness":54,"judgement":72},"picture":"Amigo Suzuki.png"},{"id":1491,"name":"Shoichi Funaki","realName":"Shoichi Funaki","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":178,"height":167,"dateOfBirth":"1968-08-24T00:00:00.000Z","debut":"1990-08-01T00:00:00.000Z","wage":37500,"popularity":10,"charisma":59,"micSkills":50,"condition":73,"hardcoreAbility":52,"injuryProne":95,"ability":50,"currentAbility":28,"potentialAbility":70,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Shoichi Funaki is a Japanese/American professional wrestler. Funaki started as a shoot style wrestler in Yoshiaki Fujiwara's Pro Wrestling Fujiwara Gumi promotion and moved to its successor promotion, Battlarts. He later found the lucha libre style more to his liking, so he moved to the Great Sasuke's promotion, Michinoku Pro Wrestling. In that promotion, he joined with Taka Michinoku, Dick Togo, Men's Teioh and Shiryu in the Kai En Tai stable. Funaki also wrestled in the Universal Wrestling Association (UWA) where he won the UWA World Middleweight Championship from El Pantera on March 19, 1997, in Japan. In March 1998, Funaki, along with Teioh and Togo, joined the World Wrestling Federation.","alterEgos":["Funaki"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3293,3294],"staffAttributes":{"bookingLogic":55,"storytelling":64,"productFit":100,"riskTaking":38,"matchLayout":67,"psychology":55,"workerManagement":100,"trainingIntensity":56,"technicalCoaching":62,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":51,"brandBuilding":31,"socialMediaSavvy":51,"ruleKnowledge":0,"positioning":20,"reactionSpeed":56,"consistency":41,"awareness":55,"judgement":73},"picture":"Funaki.png"},{"id":1492,"name":"Thomas Santell","realName":"Thomas Santell","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":231,"height":182,"dateOfBirth":"1980-12-13T00:00:00.000Z","debut":"2001-09-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":65,"micSkills":42,"condition":77,"hardcoreAbility":49,"injuryProne":100,"ability":47,"currentAbility":37,"potentialAbility":39,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Thomas Santell is an American wrestler who works in America, Canada and Japan. He is a Lightweight who is classed as using a Regular Wrestler style. He made his debut in late 2001 under the name Antonio Thomas, and quickly became a mainstay on the New England independent circuit. Over the next few years, he wrestled for several promotions, including New England Championship Wrestling, Chaotic Wrestling, and the Eastern Wrestling Alliance (EWA). Thomas then began teaming with his long-time friend Romeo Roselli, who was wrestling as Johnny Heartbreaker, and the pair formed a tag team called The Heartbreakers. In July 2004, Thomas signed a developmental contract with World Wrestling Entertainment (WWE) and was sent to Ohio Valley Wrestling (OVW). After his release from WWE, Thomas returned to working on the New England independent circuit.","alterEgos":["Antonio Thomas"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2132,2753,2903],"staffAttributes":{"bookingLogic":57,"storytelling":62,"productFit":100,"riskTaking":24,"matchLayout":63,"psychology":57,"workerManagement":100,"trainingIntensity":60,"technicalCoaching":56,"characterCoaching":72,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":72,"brandBuilding":44,"socialMediaSavvy":71,"ruleKnowledge":0,"positioning":20,"reactionSpeed":60,"consistency":69,"awareness":57,"judgement":74},"picture":"Thomas Santell.png"},{"id":1503,"name":"Sheldon Goldberg","realName":"Sheldon Goldberg","nickname":"","type":"commentator","base":"USA","gender":"M","weight":161,"height":162,"dateOfBirth":"1960-10-19T00:00:00.000Z","debut":"1994-01-01T00:00:00.000Z","wage":66000,"popularity":1,"charisma":69,"micSkills":68,"condition":100,"hardcoreAbility":69,"injuryProne":0,"ability":63,"currentAbility":29,"potentialAbility":31,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Sheldon Goldberg has over 35 years experience in Journalism, Radio, television and staged entertainment.  Formerly worked with Paul Heyman in bringing Michinoku Pro from Japan over seas to the U.S.  A former contributer to WOW magazine, aswell as being a former Disc-Jockey, Goldberg founded New England Championship Wrestling in 2000.  Is a co-hoster and producer of PWInsider Radio PodCast.  This New England Pro Wrestling Hall of Fame inductee appeared in A&E's \"Unreal Story of Professional Wrestling\" special and made an appearance at WWF's Wrestlemania XIV.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":55,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"