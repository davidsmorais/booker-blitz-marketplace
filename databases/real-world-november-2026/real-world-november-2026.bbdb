176,"height":167,"dateOfBirth":"1985-02-06T00:00:00.000Z","debut":"2008-07-01T00:00:00.000Z","wage":4166,"popularity":5,"charisma":48,"micSkills":54,"condition":84,"hardcoreAbility":77,"injuryProne":100,"ability":67,"currentAbility":59,"potentialAbility":62,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"upper","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Keisuke Ishii is a member of the DDT roster, and a part of the group known as Team Dream Futures alongside Shigehiro Irie and Soma Takao. The duo of Ishii and Irie have also appeared for AJP and are slowly making names for themselves.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1358],"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":24,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":64,"characterCoaching":43,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":43,"brandBuilding":44,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":73,"awareness":56,"judgement":74},"picture":"Keisuke Ishii.png"},{"id":1221,"name":"Kyohei Wada","realName":"Kyohei Wada","nickname":"","type":"referee","promotionId":3,"base":"Japan","gender":"M","weight":180,"height":162,"dateOfBirth":"1954-11-20T00:00:00.000Z","debut":"1972-11-01T00:00:00.000Z","wage":25600,"wageType":"per-appearance","popularity":3,"charisma":82,"micSkills":89,"condition":55,"hardcoreAbility":98,"injuryProne":45,"ability":92,"currentAbility":42,"potentialAbility":44,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kyohei Wada is the main referee in All-Japan and has more than 35 years’ experience as a referee. He made his debut in the NWA in 1974 and has received commendations from the annual Tokyo Sports Grand Prix for his work. He also does some front office work and is also an avid skier in his free time. Wada decided to leave All-Japan in June 2011 due in part to his role in the promotion diminishing over the previous 2 years. He will remain active as a referee though, and be something of a freelancer when it comes to working with various promotions.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1221","wrestlerId":1221,"promotionId":3,"startDate":"2013-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":25600,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":78,"storytelling":76,"productFit":100,"riskTaking":100,"matchLayout":76,"psychology":78,"workerManagement":100,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":14,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":14,"brandBuilding":13,"socialMediaSavvy":9,"ruleKnowledge":84,"positioning":87,"reactionSpeed":0,"consistency":58,"awareness":78,"judgement":87},"picture":"Kyohei Wada.png"},{"id":1222,"name":"Daiki Inaba","realName":"Daiki Inaba","nickname":"","type":"wrestler","promotionId":45,"base":"Japan","gender":"M","weight":181,"height":170,"dateOfBirth":"1988-02-28T00:00:00.000Z","debut":"2013-05-01T00:00:00.000Z","wage":25600,"wageType":"monthly","popularity":4,"charisma":56,"micSkills":74,"condition":84,"hardcoreAbility":78,"injuryProne":100,"ability":53,"currentAbility":49,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Inaba has a history of training in judo from back when he was in school. He was accepted to the All Japan Pro-Wrestling dojo after he passed an audition that took place in January of 2012. He would remain under training for almost a year and a half and would embark on his first overseas expedition in April of 2013 as he went to Canada. While he was in Japan he would make his professional debut in the Altantice Grand Prix Wrestling against Bobby Sharp on May 24, 2013. Inaba would compete in Canada with face paint much like his mentor Keiji Mutoh, Great Muta, did back when he competed in North America. Inaba was noted as being more than ready for his debut and gained a bit of notoriety amongst some of his peers, namely the man he debuted against in Bobby Sharp and even Rene Dupree.","alterEgos":[],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1222","wrestlerId":1222,"promotionId":45,"startDate":"2020-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":25600,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":60,"storytelling":64,"productFit":100,"riskTaking":19,"matchLayout":65,"psychology":60,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":62,"characterCoaching":42,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":81,"mediaHandling":42,"brandBuilding":49,"socialMediaSavvy":36,"ruleKnowledge":1,"positioning":21,"reactionSpeed":82,"consistency":75,"awareness":60,"judgement":76},"picture":"Daiki Inaba.png","injury":{"type":"Dislocated Hip","daysToRecover":-4},"returnDate":"2026-04-08T00:00:00.000Z"},{"id":1223,"name":"Kikutaro","realName":"Kikutaro","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":231,"height":165,"dateOfBirth":"1976-11-17T00:00:00.000Z","debut":"1994-05-01T00:00:00.000Z","wage":4166,"popularity":13,"charisma":51,"micSkills":46,"condition":67,"hardcoreAbility":79,"injuryProne":100,"ability":56,"currentAbility":40,"potentialAbility":42,"morale":"broken","presentation":"face","prestige":"low","style":"comedy","cardPosition":"upper","finisher":"","finisherType":"counter","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Mitsunobu Kikuzawa better known by his wrestling persona Kikutaro and formerly Ebessan, is a freelance Japanese professional wrestler primarily competing for Kensuke Office and Osaka Pro Wrestling. Kikuzawa has also made appearances in North America, competing in promotions such as Ring of Honor and Pro Wrestling Guerrilla. Kikuzawa started his wrestling career in 1994, wrestling under his birth name for Japanese hardcore wrestling promotions including FMW and W*ING. He was only a jobber and never made much of a name for himself at this stage in his career. In 2009, he gave away his Ebessan character to a regular Osaka Pro wrestler. He now competes freelance as his sole character, Kikutaro.","alterEgos":["Ebessan"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":73,"storytelling":75,"productFit":100,"riskTaking":17,"matchLayout":76,"psychology":73,"workerManagement":100,"trainingIntensity":62,"technicalCoaching":52,"characterCoaching":82,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":83,"mediaHandling":82,"brandBuilding":38,"socialMediaSavvy":75,"ruleKnowledge":0,"positioning":20,"reactionSpeed":62,"consistency":61,"awareness":73,"judgement":84},"picture":"Kikutaro.png"},{"id":1225,"name":"Sarah Rowe","realName":"Sarah Rowe","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":139,"height":165,"dateOfBirth":"1993-09-10T00:00:00.000Z","debut":"2011-11-01T00:00:00.000Z","wage":37500,"popularity":26,"charisma":69,"micSkills":42,"condition":91,"hardcoreAbility":35,"injuryProne":100,"ability":52,"currentAbility":51,"potentialAbility":61,"morale":"poor","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Sarah Rowe is an American wrestler who works in America, Mexico, the British Isles and Japan. She is a Small worker who is classed as using a Brawler style. She is best known for her work with WWE, NXT, Sendai Girls, SHIMMER, SHINE, AIW and CHIKARA. She is married to Raymond Rowe.","alterEgos":["Sarah Logan","Crazy Mary Dobson","Valhalla"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":54,"storytelling":55,"productFit":100,"riskTaking":45,"matchLayout":56,"psychology":54,"workerManagement":100,"trainingIntensity":58,"technicalCoaching":44,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":55,"mediaHandling":68,"brandBuilding":45,"socialMediaSavvy":59,"ruleKnowledge":0,"positioning":20,"reactionSpeed":58,"consistency":65,"awareness":54,"judgement":72},"picture":"Mary Dobson.png"},{"id":1226,"name":"Daichi Hashimoto","realName":"Daichi Hashimoto","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":220,"height":177,"dateOfBirth":"1992-04-13T00:00:00.000Z","debut":"2011-03-01T00:00:00.000Z","wage":4166,"popularity":5,"charisma":50,"micSkills":76,"condition":86,"hardcoreAbility":81,"injuryProne":100,"ability":54,"currentAbility":53,"potentialAbility":60,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"mid","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"A Japanese professional wrestler, who wrestles for Pro Wrestling Zero1. He is the son of the late Shinya Hashimoto. The oldest of three children, Daichi Hashimoto grew up around full-contact sports, as his father Shinya was a legendary pro wrestler, alongside his \"uncles\" Masahiro Chono and Keiji Mutoh. Since the sixth grade, Daichi took up karate, and was part of his middle school's MMA school, Blue Sky. When his father died in July 2005, Daichi decided he wanted to become a professional wrestler. In September 2009, he took part in his father's 25th Anniversary show, hosted by Pro Wrestling Zero1. He competed in an exhibition kickboxing match against Satoru Kobayashi. After nearly a year and a half of training, Daichi Hashimoto finally made his debut on March 6, 2011, at Pro Wrestling Zero1's 10th Anniversary show, where he wrestled Masahiro Chono in a losing effort.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1731,1736,2405,2406],"staffAttributes":{"bookingLogic":63,"storytelling":68,"productFit":100,"riskTaking":20,"matchLayout":69,"psychology":63,"workerManagement":100,"trainingIntensity":81,"technicalCoaching":68,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":54,"brandBuilding":61,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":81,"consistency":51,"awareness":63,"judgement":78},"picture":"Daichi Hashimoto.png"},{"id":1228,"name":"Tim Donst","realName":"Tim Donst","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":240,"height":175,"dateOfBirth":"1987-10-17T00:00:00.000Z","debut":"2007-04-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":59,"micSkills":74,"condition":71,"hardcoreAbility":61,"injuryProne":100,"ability":73,"currentAbility":66,"potentialAbility":70,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Timothy \"Tim\" Donst  is an American professional wrestler, performing primarily in Chikara, where he is a former Young Lions Cup holder. He is known for his amateur wrestling background, which became the focal point of his gimmick. Donst started out his career by training in Chikara's training facility under the tutelage of Claudio Castagnoli and Mike Quackenbush. He made his debut in 2007 at Rey de Voladores in a trios match, which had his team end up on the losing end. This would continue for a while, as he would lose to many more opponents, slowly building some steam, before the match got him noticed against Eddie Kingston, who dished out vicious punishment that Donst would survive through, and keep coming back, but still lost.","alterEgos":["Vökoder"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":58,"storytelling":62,"productFit":100,"riskTaking":31,"matchLayout":64,"psychology":58,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":66,"characterCoaching":69,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":69,"brandBuilding":38,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":62,"awareness":58,"judgement":75},"picture":"Tim Donst.png"},{"id":1230,"name":"Chris Raaber","realName":"Chris Raaber","nickname":"","type":"wrestler","base":"Germany","gender":"M","weight":251,"height":190,"dateOfBirth":"1981-09-06T00:00:00.000Z","debut":"1998-05-01T00:00:00.000Z","wage":37500,"populari