r":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Youngest son of Blue Panther and brother of Blue Panther Jr. Blue Panther Jr. (then known as  Black Panther) and Cachorro were presented to the media on the 35th Anniversary Show of wrestling carreer of their father Blue Panther. Cachorro made his wrestling debut on January 1, 2014 in the Arena Mexico, taking unsuccessful part in La Copa Junior 2014.","alterEgos":[],"birthplace":"Torreón, Coahuila, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1399","wrestlerId":1399,"promotionId":11,"startDate":"2014-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":48000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":56,"storytelling":61,"productFit":100,"riskTaking":24,"matchLayout":63,"psychology":56,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":61,"characterCoaching":46,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":46,"brandBuilding":51,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":44,"awareness":56,"judgement":74},"picture":"Black Panther.png"},{"id":1400,"name":"Carta Brava Jr.","realName":"Carta Brava Jr.","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":181,"height":165,"dateOfBirth":"1987-01-18T00:00:00.000Z","debut":"2007-07-07T00:00:00.000Z","wage":4166,"popularity":4,"charisma":72,"micSkills":52,"condition":86,"hardcoreAbility":59,"injuryProne":100,"ability":65,"currentAbility":59,"potentialAbility":63,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"The former Antaris, who took over the Carta Brava identity. He's the more successful of two Carta Brava Jr.'s active and bickering over the name, and the one who started making AAA appearances in 2013. Everyone expects this Carta to eventually receive a new identity in AAA, which might finally end the argument.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":21,"matchLayout":71,"psychology":68,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":56,"characterCoaching":58,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":58,"brandBuilding":45,"socialMediaSavvy":55,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":73,"awareness":68,"judgement":81},"picture":"Carta Brava Jr.png"},{"id":1401,"name":"Cerebro Negro","realName":"Cerebro Negro","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":180,"height":167,"dateOfBirth":"1973-09-30T00:00:00.000Z","debut":"1991-05-30T00:00:00.000Z","wage":3000,"popularity":2,"charisma":65,"micSkills":78,"condition":70,"hardcoreAbility":77,"injuryProne":100,"ability":67,"currentAbility":44,"potentialAbility":46,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Long time IWRG luchador, now one of the core regulars in the promotion. Notable feuds with Mike Segura, Black Terry and Dr. Cerebro. Most recently teamed up with the last two as part of the techinical-rudo trio Los Terribles Cerebros. Periodically disappears from IWRG over conflicts of where else he's working (and allowed to work); disappeared from IWRG in May of 2011 for this sort of reason. Touring small arenas around the exterior of Mexico city, like Arena Aficion and Arena Queretaro, while also working for IWL.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3757,3758],"staffAttributes":{"bookingLogic":76,"storytelling":78,"productFit":100,"riskTaking":27,"matchLayout":79,"psychology":76,"workerManagement":100,"trainingIntensity":68,"technicalCoaching":62,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":68,"brandBuilding":48,"socialMediaSavvy":62,"ruleKnowledge":0,"positioning":20,"reactionSpeed":68,"consistency":71,"awareness":76,"judgement":86},"picture":"Cerebro Negro.png"},{"id":1402,"name":"CJ Perry","realName":"CJ Perry","nickname":"","type":"manager","base":"USA","gender":"F","weight":114,"height":167,"dateOfBirth":"1985-03-24T00:00:00.000Z","debut":"2013-10-01T00:00:00.000Z","wage":66000,"popularity":40,"charisma":56,"micSkills":47,"condition":100,"hardcoreAbility":67,"injuryProne":100,"ability":56,"currentAbility":49,"potentialAbility":49,"morale":"fair","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Born into a wealthy Russian family, Lana’s neighbors were ex-presidents, diplomats and other powerful political figures. Fulfilling her desire to pursue a stateside education, Lana attended Florida State University, where she not only learned English, but also majored in Foreign Affairs, Business and Social Media Marketing.\r\n\r\nEncouraged by her parents to discover an investment hobby, Lana invested her knowledge and business acumen into Rusev. Living by the philosophy that no mountain is too high to climb, Lana has used her cunning to conquer WWE.\r\n\r\nFollowing Rusev’s impressive debut in the 2014 Royal Rumble Match, Lana put The Bulgarian Brute on full display. Helping deliver their message of superiority to the WWE Universe, Lana also pledged her heart along with her service, accepting Rusev’s marriage proposal in 2015. While she’s occasionally mixed it up as an in-ring competitor on SmackDown LIVE, Lana has also been instrumental in leading Rusev to three United States Championships.","alterEgos":["Lana"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2442],"staffAttributes":{"bookingLogic":37,"storytelling":39,"productFit":45,"riskTaking":36,"matchLayout":40,"psychology":37,"workerManagement":45,"trainingIntensity":64,"technicalCoaching":29,"characterCoaching":74,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":74,"brandBuilding":65,"socialMediaSavvy":78,"ruleKnowledge":0,"positioning":9,"reactionSpeed":64,"consistency":60,"awareness":37,"judgement":40},"picture":"Lana.png"},{"id":1406,"name":"Abismo Negro Jr.","realName":"Abismo Negro Jr.","nickname":"","type":"wrestler","promotionId":5,"base":"Mexico","gender":"M","weight":191,"height":172,"dateOfBirth":"1990-09-26T00:00:00.000Z","debut":"2006-09-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":7,"charisma":51,"micSkills":74,"condition":85,"hardcoreAbility":74,"injuryProne":100,"ability":64,"currentAbility":64,"potentialAbility":80,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Abismo Negro Jr. is a masked Mexican luchador who works in the USA and Mexico. He is a 5'9\", 191lb worker who is classed as using a Luchador style. He uses the Styles Clash as his finisher. He is best known for his work with AAA, IWRG, The Crash and DTU.","alterEgos":["Eterno"],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1406","wrestlerId":1406,"promotionId":5,"startDate":"2019-05-02T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[743,2871],"staffAttributes":{"bookingLogic":64,"storytelling":67,"productFit":100,"riskTaking":26,"matchLayout":68,"psychology":64,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":56,"characterCoaching":63,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":63,"brandBuilding":66,"socialMediaSavvy":48,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":74,"awareness":64,"judgement":78},"picture":"Abismo Negro Jr..png"},{"id":1409,"name":"IYO SKY","realName":"Io Shirai","nickname":"","type":"wrestler","promotionId":64,"base":"Japan","gender":"F","weight":121,"height":152,"dateOfBirth":"1990-05-08T00:00:00.000Z","debut":"2007-03-01T00:00:00.000Z","wage":100000,"wageType":"monthly","popularity":65,"charisma":88,"micSkills":71,"condition":83,"hardcoreAbility":78,"injuryProne":100,"ability":87,"currentAbility":87,"potentialAbility":93,"morale":"great","presentation":"face","prestige":"mid","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"There are plenty of high-flying Superstars, but there’s only one Genius of the Sky. An aerial artist without peer, Io Shirai touched down in NXT in the summer of 2018, after she was announced to great fanfare as a new signee at a WWE Live Event in Tokyo. For Shirai, who was thrice named the top women's wrestler of the year by national Japanese newspaper Tokyo Sports before joining NXT, her mission is clear: Having ascended the mountaintop in her native country, Shirai wants to conquer new frontiers and prove that she’s not only the best wrestler in her homeland, but in the entire world. Moonsaults, hurricanranas and springboard dropkicks are Shirai’s stock-in-trade, and you’d expect nothing less from a Superstar who cites Rey Mysterio as her greatest inspiration. The WWE Universe saw Shirai’s gravity-defying antics up-close for the first time in the 2018 Mae Young Classic, where The Genius of the Sky soared all the way to the tournament final at WWE Evolution.","alterEgos":["Io Shirai"],"birthplace":"Kamakura, Kanagawa, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1409","wrestlerId":1409,"promotionId":64,"startDate":"2022-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":100000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[397,1533,2807,4309],"staffAttributes":{"bookingLogic":80,"storytelling":82,"productFit":100,"riskTaking":24,"matchLayout":83,"psychology":80,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":78,"characterCoaching":79,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":79,"brandBuilding":81,"socialMediaSavvy":68,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":74,"awareness":80,"judgement":88},"picture":"IYO SKY.png"},{"id":1410,"name":"Jaki Numazawa","realName":"Jaki Numazawa","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":220,"height":172,"dateOfBirth":"1977-06-07T00:00:00.000Z","debut":"2000-11-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":45,"micSkills":36,"condition":55,"hardcoreAbility":66,"injuryProne":100,"ability":43,"currentAbility":31,"potentialAbility":33,"morale":"broken","presen