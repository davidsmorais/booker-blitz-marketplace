6,"micSkills":61,"condition":90,"hardcoreAbility":53,"injuryProne":100,"ability":67,"currentAbility":62,"potentialAbility":67,"morale":"broken","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Zicky Dice is an American wrestler who works exclusively in America. He is a Lightweight who is classed as using a Regular Wrestler style. He wrestled freestyle from the age of 6 until his Sophmore year. He is also a two-time national champion in freestyle Greco-Roman, as well as a National Champion in Sambo. He was a member of the band Heart to Heart from 2009, gaining a decent fanbase that included Seth Rollins. It would be Rollins who Zicky reached out to to train him, and eventually enrolled in the Black & Brave wrestling school.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":54,"storytelling":59,"productFit":49,"riskTaking":27,"matchLayout":61,"psychology":54,"workerManagement":49,"trainingIntensity":68,"technicalCoaching":57,"characterCoaching":74,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":74,"brandBuilding":57,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":10,"reactionSpeed":68,"consistency":78,"awareness":54,"judgement":52},"picture":"Zicky Dice.png"},{"id":3285,"name":"Kid Lykos II","realName":"Kid Lykos II","nickname":"","type":"wrestler","promotionId":44,"base":"UK","gender":"M","weight":210,"height":170,"dateOfBirth":"2002-07-08T00:00:00.000Z","debut":"2017-12-01T00:00:00.000Z","wage":15700,"wageType":"per-appearance","popularity":5,"charisma":42,"micSkills":48,"condition":100,"hardcoreAbility":49,"injuryProne":100,"ability":53,"currentAbility":49,"potentialAbility":62,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Kid Lykos II is a masked English wrestler who works in the British Isles and Europe. He is a Lightweight who is classed as using a High Flyer style. He has regular tag teams with Kid Lykos (Lykos Gym) and Nico Angelo (Lykos Gym II). He is best known for his work with RevPro, NORTH, PROGRESS and TNT.","alterEgos":["Joe Nelson"],"birthplace":"England","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3285","wrestlerId":3285,"promotionId":44,"startDate":"2021-02-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":15700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1960,2194,2364,2399,2400,2628,2952,3527,4369],"staffAttributes":{"bookingLogic":44,"storytelling":50,"productFit":68,"riskTaking":28,"matchLayout":52,"psychology":44,"workerManagement":68,"trainingIntensity":71,"technicalCoaching":54,"characterCoaching":54,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":54,"brandBuilding":45,"socialMediaSavvy":41,"ruleKnowledge":0,"positioning":14,"reactionSpeed":71,"consistency":66,"awareness":44,"judgement":54},"picture":"Kid Lykos II.png","additionalContracts":[{"id":"tew-contract-3285-45","wrestlerId":3285,"promotionId":45,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":25600,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["NOAH"]},{"id":3286,"name":"Dulce Gardenia","realName":"Dulce Gardenia","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":179,"height":175,"dateOfBirth":"1992-01-30T00:00:00.000Z","debut":"2013-01-01T00:00:00.000Z","wage":48000,"wageType":"per-appearance","popularity":7,"charisma":48,"micSkills":63,"condition":83,"hardcoreAbility":77,"injuryProne":100,"ability":61,"currentAbility":60,"potentialAbility":67,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Dulce Gardenia is a Mexican luchador who works exclusively in Mexico. He is a Lightweight who is classed as using a Luchador style. Initially trained under Kaín in Torreón, he made his in-ring debut in 2013. He took the ring name \"Dulce Gardenia\" (\"Sweet Gardenia\") in part as a tribute to Dizy Gardenia, one of the original exótico characters in the 1940's. Márquez was scheduled to wrestle Silver King during a tour of the United Kingdom, under the ring name \"Charro del Mysterio\", but missed the flight due to issues with his visa documentation, and ended up missing the UK tour where Silver King would die during a match. Gardenia made his CMLL in-ring on June 25, 2019 as he teamed up with Drone and Fuego to defeat the trio of Misterioso Jr., Pólvora and Virus. Most impressive though is that Gardenia is a single father of three.","alterEgos":[],"birthplace":"Vado del Río Nazas, Coahuila, Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-3286","wrestlerId":3286,"promotionId":11,"startDate":"2019-06-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":48000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":55,"storytelling":60,"productFit":67,"riskTaking":26,"matchLayout":61,"psychology":55,"workerM