0,"consistency":0,"awareness":0,"judgement":0},"picture":"Nikkan Lee.png"},{"id":1731,"name":"Yuji Shindo","realName":"Yuji Shindo","nickname":"","type":"referee","base":"Japan","gender":"M","weight":154,"height":165,"dateOfBirth":"1983-02-19T00:00:00.000Z","debut":"2008-02-01T00:00:00.000Z","wage":1500,"popularity":1,"charisma":52,"micSkills":37,"condition":100,"hardcoreAbility":32,"injuryProne":47,"ability":49,"currentAbility":41,"potentialAbility":44,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Yuji Shindo is the current ring announcer in Big Japan, and some sites list him as a referee. A former baseball player and bowler, the 26-year-old Shindo began working for Big Japan in February 2008.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":35,"technicalCoaching":0,"characterCoaching":30,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":30,"brandBuilding":31,"socialMediaSavvy":30,"ruleKnowledge":46,"positioning":37,"reactionSpeed":35,"consistency":0,"awareness":0,"judgement":0},"picture":"Yuji Shindo.png"},{"id":1732,"name":"Ryuji Yamakawa","realName":"Ryuji Yamakawa","nickname":"","type":"writer","base":"Japan","gender":"M","weight":198,"height":175,"dateOfBirth":"1970-04-02T00:00:00.000Z","debut":"1994-10-01T00:00:00.000Z","wage":1000,"popularity":4,"charisma":77,"micSkills":93,"condition":58,"hardcoreAbility":83,"injuryProne":100,"ability":83,"currentAbility":49,"potentialAbility":49,"morale":"broken","presentation":"heel","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Ryuji Yamakawa is a Japanese professional wrestler. He has spent most of his career wrestling on the Japanese indy scene, mainly for Big Japan Pro Wrestling where he has spent many years, and spilled many pints of blood!","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":75,"storytelling":76,"productFit":100,"riskTaking":50,"matchLayout":77,"psychology":75,"workerManagement":100,"trainingIntensity":46,"technicalCoaching":40,"characterCoaching":43,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":50,"mediaHandling":43,"brandBuilding":24,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":20,"reactionSpeed":46,"consistency":54,"awareness":75,"judgement":85},"picture":"Ryuji Yamakawa.png"},{"id":1733,"name":"Yuko Miyamoto","realName":"Yuko Miyamoto","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":205,"height":172,"dateOfBirth":"1982-05-25T00:00:00.000Z","debut":"2003-08-01T00:00:00.000Z","wage":4166,"popularity":7,"charisma":56,"micSkills":66,"condition":78,"hardcoreAbility":45,"injuryProne":100,"ability":69,"currentAbility":57,"potentialAbility":59,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"upper","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Miyamoto debuted for WMF on August 2nd, 2003 before later joining Onryo's 666 promotion. After leaving 666, Miyamoto began freelancing and found himself in DDT, where he was part of a short lived Axe Bombers unit led by Takao Omori. From there he went to Big Japan, where Mammoth Sasaki took him under his wing and helped him adapt to the death match style. In 2007, Miyamoto slowly became one of the crowd favorites and could become one of the major wrestlers in the promotion if his current momentum continues.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1576,2456,2457,2458,2907,2908,2909,2910],"staffAttributes":{"bookingLogic":72,"storytelling":75,"productFit":100,"riskTaking":30,"matchLayout":76,"psychology":72,"workerManagement":100,"trainingIntensity":73,"technicalCoaching":66,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":70,"mediaHandling":56,"brandBuilding":48,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":73,"consistency":83,"awareness":72,"judgement":83},"picture":"Yuko Miyamoto.png"},{"id":1734,"name":"Shuji Ishikawa","realName":"Shuji Ishikawa","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":287,"height":193,"dateOfBirth":"1975-09-25T00:00:00.000Z","debut":"2004-06-01T00:00:00.000Z","wage":4166,"popularity":5,"charisma":61,"micSkills":71,"condition":76,"hardcoreAbility":74,"injuryProne":100,"ability":62,"currentAbility":43,"potentialAbility":45,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"mid","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Ishikawa debuted in DDT in 2003; a promising rookie and one of the heaviest young Japanese indy wrestlers, he officially joined Pro Wrestling Union in 2005, continuing to participate to all the major DDT shows. In 2007 Ishikawa suddenly stepped up to a main-eventer role by becoming the leader of the HWO (Hawaiian World Order) unit as Koo, a masked “monster heel” who would soon capture the KO-D championship. One year later Ishikawa would return to his original character, showing remarkable improvements in his fighting skills, both as a shoot-style wrestler in FUTEN/BattlARTS and as an hardcore wrestler in BJW.","alterEgos":[],"birthplace":"Japan","managerId":0,"additionalContracts":[{"id":"tew-contract-1734-45","wrestlerId":1734,"promotionId":45,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":25600,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1695,1730,2886],"staffAttributes":{"bookingLogic":79,"storytelling":81,"productFit":100,"riskTaking":24,"matchLayout":82,"psychology":79,"workerManagement":100,"trainingIntensity":78,"technicalCoaching":53,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":76,"mediaHandling":70,"brandBuilding":62,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":20,"reactionSpeed":78,"consistency":80,"awareness":79,"judgement":87},"picture":"Shuji Ishikawa.png","alsoWorksFor":["NOAH"]},{"id":1735,"name":"Hi69","realName":"Hi69","nickname":"","type":"wrestler","promotionId":45,"base":"Japan","gender":"M","weight":218,"height":172,"dateOfBirth":"1981-12-13T00:00:00.000Z","debut":"2000-11-01T00:00:00.000Z","wage":25600,"wageType":"per-appearance","popularity":4,"charisma":58,"micSkills":51,"condition":72,"hardcoreAbility":52,"injuryProne":100,"ability":66,"currentAbility":53,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Hiroki got his start in Puerto Rico and would a part of the first graduating class of TAKA Michinoku’s KAIENTAI DOJO. He would make his debut as Hi69 (hi-ro-ki) in Puerto Rico against Yasu Urano. On July 3, 2004 Hi69 would win the first ever “STRONGEST-K TOUR FINAL” to become the first ever CHAMPION OF STRONGEST-K after he defeated Kengo Mashimo. Hi69 would resign from K-DOJO on April 5, 2006 as he would move on to Kintaro Kanemura’s Apache Army. He would begin working with Takashi Sasaki as well in the process. On October 11, 2007, Hi69 would suffer a career threatening injury against Tomohiro Ishii at New Japan Pro-Wrestling’s LOCK UP show. Hi69 would land awkwardly from a Powerbomb/Frankensteiner attempt and he would suffer a fracture as well as a dislocation to his thoracic vertebrae. After undergoing an expensive medical procedure Hi69 would begin recuperate and begin rehab.","alterEgos":["Nio"],"birthplace":"Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1735","wrestlerId":1735,"promotionId":45,"startDate":"2017-07-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":25600,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1726,2008],"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":23,"matchLayout":71,"psychology":68,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":61,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":77,"mediaHandling":68,"brandBuilding":48,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":75,"awareness":68,"judgement":81},"picture":"Hi69.png"},{"id":1736,"name":"Madusa","realName":"Madusa","nickname":"","type":"manager","base":"USA","gender":"F","weight":150,"height":175,"dateOfBirth":"1963-02-09T00:00:00.000Z","debut":"1984-01-01T00:00:00.000Z","wage":66000,"popularity":12,"charisma":27,"micSkills":30,"condition":62,"hardcoreAbility":30,"injuryProne":92,"ability":36,"currentAbility":17,"potentialAbility":17,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Debra Miceli is an American Monster truck driver and former professional wrestler. She is best known under her ring names Madusa (shortened from Made in the USA) or Alundra Blayze. Her early career was spent in the American Wrestling Association, where she once held the AWA World Women's Championship. In 1988, Miceli was the first woman to be awarded Pro Wrestling Illustrated's Rookie of the Year. The following year, she signed a contract with All Japan Women's Pro-Wrestling, making her the first foreign wrestler to do so. In December 1995, Miceli signed with WCW, and as part of a storyline by booker Eric Bischoff, showed up on WCW Monday Nitro on December 18, where she threw the WWF Women's Title belt into a trash can. She later admitted that she regretted the action and would not have done it had Bischoff not coerced her.","alterEgos":["Alundra Blayze"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":74,"storytelling":75,"productFit":100,"riskTaking":27,"matchLayout":75,"psychology":74,"workerManagement":100,"trainingIntensity":57,"technicalCoaching":42,"characterCoaching":52,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":73,"mediaHandling":52,"brandBuilding":54,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":57,"consistency":54,"awareness":74,"judgement":84},"picture":"Madusa_alt.png"},{"id":1738,"name":"Brahman Kei","realName":"Brahman Kei","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":176,"height":167,"dateOfBirth":"1977-07-05T00:00:00.000Z","debut":"2001-12-01T00:00:00.000Z","wage":4166,"popularity":3,"charisma":42,"micSkills":48,"condition":75,"hardcoreAbility":74,"injuryProne":100,"ability":46,"currentAbility":34,"potentialAbility":36,"morale":"broken","presentation":"face","prestige":"low","style":"comedy","cardPosition":"mid","finisher":"","finisherType":"counter","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kei Sato and Shu Sato are identical twins, and wrestlers for the Big Japan Pro Wrestling promotion. They are former UWA World Tag Team Champions and WEW Hardcore Tag Team Champions and former three-time Tohoku Tag Team Champions. They have also been in El Dorado Wrestling as co-leaders of the HELL DEMONS faction. Shu is the reigning Tohoku Junior Heavyweight Champion, while Kei holds the Tohoku Tag Team Championship with The Great Sasuke. The twin brothers originally debuted as the masked Syachihoko Machines. In 2002 on T2P's last show, they unmasked and went to the Toryumon X promotion. They joined up with Taiji Ishimori and became known as the Sailor Boys. n 2015, the Brahmans began working for the Freedoms promotion under masks and the ring names El Hijo del Winger Uno and El Hijo del Winger Dos, winning the King of Freedom World Tag Team Championship on January 29, 2015.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1394,1395,2462,2463],"staffAttributes":{"bookingLogic":59,"storytelling":65,"productFit":100,"riskTaking":37,"matchLayout":67,"psychology":59,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":44,"characterCoaching":68,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":63,"mediaHandling":68,"brandBuilding":21,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":78,"awareness":59,"judgement":75},"picture":"Kei Sato.png"},{"id":1740,"name":"Brahman Shu","realName":"Brahman Shu","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":176,"height":167,"dateOfBirth":"1977-07-05T00:00:00.000Z","debut":"2001-12-01T00:00:00.000Z","wage":4166,"popularity":3,"charisma":62,"micSkills":46,"condition":76,"hardcoreAbility":46,"injuryProne":100,"ability":55,"currentAbility":40,"potentialAbility":42,"morale":"broken","presentation":"face","prestige":"low","style":"comedy","cardPosition":"mid","finisher":"","finisherType":"counter","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Kei Sato and Shu Sato are identical twins, and wrestlers for the Big Japan Pro Wrestling promotion. They are former UWA World Tag Team Champions and WEW Hardcore Tag Team Champions and former three-time Tohoku Tag Team Champions. They have also been in El Dorado Wrestling as co-leaders of the HELL DEMONS faction. Shu is the reigning Tohoku Junior Heavyweight Champion, while Kei holds the Tohoku Tag Team Championship with The Great Sasuke. The twin brothers originally debuted as the masked Syachihoko Machines. In 2002 on T2P's last show, they unmasked and went to the Toryumon X promotion. They joined up with Taiji Ishimori and became known as the Sailor Boys. n 2015, the Brahmans began working for the Freedoms promotion under masks and the ring names El Hijo del Winger Uno and El Hijo del Winger Dos, winning the King of Freedom World Tag Team Championship on January 29, 2015.","alterEgos":["Shu Sato"],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1394,1395,2462,2463],"staffAttributes":{"bookingLogic":62,"storytelling":67,"productFit":100,"riskTaking":18,"matchLayout":69,"psychology":62,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":48,"characterCoaching":70,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":70,"brandBuilding":16,"socialMediaSavvy":73,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":72,"awareness":62,"judgement":77},"picture":"Shu Sato.png"},{"id":1741,"name":"Tessa Blanchard","realName":"Tessa Blanchard","nickname":"","type":"wrestler","promotionId":11,"base":"USA","gender":"F","weight":125,"height":162,"dateOfBirth":"1995-07-26T00:00:00.000Z","debut":"2014-06-01T00:00:00.000Z","wage":64000,"wageType":"per-appearance","popularity":29,"charisma":54,"micSkills":60,"condition":98,"hardcoreAbility":69,"injuryProne":100,"ability":75,"currentAbility":75,"potentialAbility":83,"morale":"poor","presentation":"heel","prestige":"low","style":"technical","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Tessa Blanchard is a supremely talented American wrestler and the daughter of Four Horsemen legend Tully Blanchard. She made history in 2019 when she became the first woman to hold a men's World Championship in a nationally televised promotion when she won the Impact World Championship from Sami Callihan. Despite her obvious skill and star potential, her career has been derailed by allegations of bullying and racism, compounded by attitude problems which saw her stripped of the Impact World Championship.","alterEgos":[],"birthplace":"Charlotte, North Carolina, United States","managerId":0,"contractExpiryDate":"2027-10-10T00:00:00.000Z","contract":{"id":"tew-contract-1741","wrestlerId":1741,"promotionId":11,"startDate":"2025-10-10T00:00:00.000Z","endDate":"2027-10-10T00:00:00.000Z","wage":64000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1236,2828,2829],"staffAttributes":{"bookingLogic":66,"storytelling":71,"productFit":100,"riskTaking":18,"matchLayout":72,"psychology":66,"workerManagement":100,"trainingIntensity":83,"technicalCoaching":69,"characterCoaching":69,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":69,"brandBuilding":85,"socialMediaSavvy":56,"ruleKnowledge":0,"positioning":20,"reactionSpeed":83,"consistency":73,"awareness":66,"judgement":80},"picture":"Tessa Blanchard_alt8.png","additionalContracts":[{"id":"tew-contract-1741-68","wrestlerId":1741,"promotionId":68,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["MLW"]},{"id":1742,"name":"The Blue Meanie","realName":"The Blue Meanie","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":295,"height":182,"dateOfBirth":"1973-05-18T00:00:00.000Z","debut":"1994-03-01T00:00:00.000Z","wage":37500,"popularity":5,"charisma":42,"micSkills":51,"condition":73,"hardcoreAbility":42,"injuryProne":80,"ability":36,"currentAbility":23,"potentialAbility":25,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Brian Daniel Heffron etter known by the ring name The Blue Meanie, is an American professional wrestler and actor. He is best known for his appearances with ECW from 1995 to 2000 and WWE from 1998 to 2005. Heffron started wrestling in the Midwest out of Al Snow's Bodyslammers Pro Wrestling Gym in Lima, Ohio in March 1994. He continued to wrestle in various independent wrestling promotions throughout the Mid-Atlantic and Midwest regions until 1996. Heffron was noticed by Raven and Stevie Richards at a Steel City Wrestling show in Pittsburgh, Pennsylvania, and was asked by Raven to become Richards' sidekick in ECW. He went on to become The Blue Meanie, taking his name and persona from the villain of the 1968 animated film Yellow Submarine. Heffron, under his Blue Meanie name, currently wrestles and is a trainer at The Monster Factory.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[515,3305,3306,3307],"staffAttributes":{"bookingLogic":59,"storytelling":64,"productFit":100,"riskTaking":62,"matchLayout":65,"psychology":59,"workerManagement":100,"trainingIntensity":47,"technicalCoaching":26,"characterCoaching":74,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":38,"mediaHandling":74,"brandBuilding":28,"socialMediaSavvy":67,"ruleKnowledge":0,"positioning":20,"reactionSpeed":47,"consistency":33,"awareness":59,"judgement":75},"picture":"The Blue Meanie.png"},{"id":1744,"name":"Will Ferrara","realName":"Will Ferrara","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":178,"height":172,"dateOfBirth":"1992-06-30T00:00:00.000Z","debut":"2011-01-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":38,"micSkills":46,"condition":100,"hardcoreAbility":63,"injuryProne":100,"ability":48,"currentAbility":47,"potentialAbility":54,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Will Ferrara  is an American professional wrestler currently signed to Ring of Honor. Ferrara joined the Ring of Honor training school in August of 2012, after establishing a connection through their facebook page. He describes his experience in the training seminars as having completely changed his outlook on wrestling. From that point on, he knew he found the best training outlet for his developing career. During the following year, he made his ROH debut on September 6 during Night #1 of ROH Road to Greatness.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1683],"staffAttributes":{"bookingLogic":54,"storytelling":59,"productFit":71,"riskTaking":21,"matchLayout":60,"psychology":54,"workerManagement":71,"trainingIntensity":77,"technicalCoaching":54,"characterCoaching":35,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":79,"mediaHandling":35,"brandBuilding":35,"socialMediaSavvy":35,"ruleKnowledge":0,"positioning":14,"reactionSpeed":77,"consistency":76,"awareness":54,"judgement":61},"picture":"Will Ferrara.png"},{"id":1745,"name":"Mahabali Shera","realName":"Mahabali Shera","nickname":"","type":"wrestler","base":"Other","gender":"M","weight":242,"height":190,"dateOfBirth":"1990-05-02T00:00:00.000Z","debut":"2011-01-01T00:00:00.000Z","wage":37500,"popularity":8,"charisma":43,"micSkills":68,"condition":93,"hardcoreAbility":47,"injuryProne":100,"ability":48,"currentAbility":48,"potentialAbility":74,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"","finisherType":"strike","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Mahabali Shera is an Indian wrestler who works in the USA, Canada and India. He is a 6'4\", 242lb worker who is classed as using a Brawler style. He uses the Sky High and the Veera Bomb as his finishers. He is best known for his work with TNA and NXT.","alterEgos":["Shera"],"birthplace":"India","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1083,2515],"staffAttributes":{"bookingLogic":38,"storytelling":42,"productFit":64,"riskTaking":28,"matchLayout":43,"psychology":38,"workerManagement":64,"trainingIntensity":61,"technicalCoaching":23,"characterCoaching":48,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":48,"brandBuilding":69,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":13,"reactionSpeed":61,"consistency":47,"awareness":38,"judgement":48},"picture":"Mahabali Shera_alt2.png"},{"id":1746,"name":"LA Knight","realName":"Eli Drake","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"M","weight":229,"height":182,"dateOfBirth":"1982-11-01T00:00:00.000Z","debut":"2003-03-01T00:00:00.000Z","wage":75000,"wageType":"monthly","popularity":61,"charisma":91,"micSkills":76,"condition":89,"hardcoreAbility":65,"injuryProne":100,"ability":77,"currentAbility":77,"potentialAbility":79,"morale":"good","presentation":"face","prestige":"mid","style":"powerhouse","cardPosition":"mid","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Let LA Knight talk to ya: He has come to NXT to change the game on the black-and-gold brand.\r\n\r\nOne of NXT’s biggest free agent signings in recent history, Knight made a big splash immediately. Making a surprise appearance at NXT TakeOver: Vengeance Day, Knight had a confident message for the NXT Universe signed on the dotted line to officially join the NXT roster.\r\n\r\nKnight has already promised big things on the black-and-gold brand, and why not? He’s tasted success in a variety of independent promotions, capturing championships in both singles and tag team competition.","alterEgos":["Eli Drake"],"birthplace":"Hagerstown, Maryland, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1746","wrestlerId":1746,"promotionId":64,"startDate":"2022-04-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":75000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[883,1497,2001],"staffAttributes":{"bookingLogic":68,"storytelling":70,"productFit":100,"riskTaking":16,"matchLayout":71,"psychology":68,"workerManagement":100,"trainingIntensity":71,"technicalCoaching":55,"characterCoaching":86,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":84,"mediaHandling":86,"brandBuilding":83,"socialMediaSavvy":79,"ruleKnowledge":0,"positioning":20,"reactionSpeed":71,"consistency":78,"awareness":68,"judgement":81},"picture":"LA Knight.png"},{"id":1747,"name":"Robert Rodriguez","realName":"Robert Rodriguez","nickname":"","type":"writer","base":"USA","gender":"M","weight":174,"height":182,"dateOfBirth":"1968-06-20T00:00:00.000Z","debut":"2014-10-01T00:00:00.000Z","wage":66000,"popularity":1,"charisma":9,"micSkills":0,"condition":100,"hardcoreAbility":16,"injuryProne":0,"ability":0,"currentAbility":0,"potentialAbility":2,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Robert Anthony Rodríguez s an American film director, screenwriter, producer, cinematographer, editor cartoonist and musician. He shoots and produces many of his films in Mexico and his native Texas. He has directed successful and groundbreaking film sagas such as the Mexico Trilogy, From Dusk till Dawn and the 2014 TV series,[3] and the Spy Kids films, as well as The Faculty, The Adventures of Sharkboy and Lavagirl in 3-D, Sin City, Planet Terror, and Machete. He is a friend and frequent collaborator of filmmaker Quentin Tarantino. In December 2013, Rodriguez launched his own cable TV channel, El Rey.","alterEgos":[],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":0,"storytelling":0,"productFit":0,"riskTaking":100,"matchLayout":0,"psychology":0,"workerManagement":0,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":42,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":42,"brandBuilding":0,"socialMediaSavvy":49,"ruleKnowledge":0,"positioning":0,"reactionSpeed":0,"consistency":0,"awareness":0,"judgement":0},"picture":"Robert Rodriguez.png"},{"id":1748,"name":"John Gaburick","realName":"John Gaburick","nickname":"","type":"writer","promotionId":64,"base":"USA","gender":"M","weight":212,"height":170,"dateOfBirth":"1966-04-22T00:00:00.000Z","debut":"1998-04-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":1,"charisma":76,"micSkills":70,"condition":100,"hardcoreAbility":61,"injuryProne":0,"ability":81,"currentAbility":42,"potentialAbility":44,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Prior to joining TNA Entertainment, Gaburick spent the past 13 years in production at WWE. While there, he was awarded the PROMAX/BDA Brandbuilder of the Year Award and guided all image and brand-building media campaigns, as well as network documentary programming. Additionally, he spent 10 years as Operations Manager for National Business Archives in Jessup, Maryland. He earned a Bachelor of Arts from Towson University in Towson, Maryland and is a proud member of The Towson University Athletic Hall of Fame.","alterEgos":[],"birthplace":"United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-1748","wrestlerId":1748,"promotionId":64,"startDate":"2020-05-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":61,"storytelling":43,"productFit":100,"riskTaking":100,"matchLayout":37,"psychology":61,"workerManagement":100,"trainingIntensity":0,"technicalCoaching":0,"characterCoaching":12,"teaching":40,"diagnosis":50,"rehabilitation":50,"prevention":0,"mediaHandling":12,"brandBuilding":18,"socialMediaSavvy":15,"ruleKnowledge":0,"positioning":20,"reactionSpeed":0,"consistency":0,"awareness":61,"judgement":77},"picture":"John Gaburick.png"},{"id":1749,"name":"Aliyah","realName":"Aliyah","nickname":"","type":"wrestler","base":"Canada","gender":"F","weight":112,"height":157,"dateOfBirth":"1994-11-23T00:00:00.000Z","debut":"2013-01-01T00:00:00.000Z","wage":37500,"popularity":14,"charisma":42,"micSkills":53,"condition":97,"hardcoreAbility":54,"injuryProne":100,"ability":34,"currentAbility":34,"potentialAbility":34,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Young, bold and boundlessly athletic, Aliyah welcomes the spotlight, perhaps because she’s no stranger to it. The WWE Universe has tracked her journey to Superstardom, beginning with appearances on the WWE Network original series Breaking Ground (where cameras documented Aliyah’s days training in the Performance Center) and extending to her first steps inside the NXT ring as a competitor.\r\n\r\nAliyah knew her future was in sports-entertainment the moment she saw Beth Phoenix and Mickie James battle on Raw in her hometown of Toronto. But Aliyah’s path to the squared circle was an indirect one that started with circus training as a teenager, which allowed her to increase her flexibility and master her body movement — qualities that pay dividends inside the ring and spell trouble for her opponents.","alterEgos":["Nhooph Al-Areebi"],"birthplace":"Canada","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2757,3499],"staffAttributes":{"bookingLogic":39,"storytelling":44,"productFit":73,"riskTaking":34,"matchLayout":46,"psychology":39,"workerManagement":73,"trainingIntensity":57,"technicalCoaching":37,"characterCoaching":52,"t