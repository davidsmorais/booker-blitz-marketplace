y.","alterEgos":[],"birthplace":"Toledo, Ohio, United States","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2699","wrestlerId":2699,"promotionId":28,"startDate":"2021-01-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":30700,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2620,2621,2684,2685,2686,3772,3959],"staffAttributes":{"bookingLogic":54,"storytelling":59,"productFit":100,"riskTaking":28,"matchLayout":61,"psychology":54,"workerManagement":100,"trainingIntensity":82,"technicalCoaching":56,"characterCoaching":64,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":72,"mediaHandling":64,"brandBuilding":59,"socialMediaSavvy":54,"ruleKnowledge":0,"positioning":20,"reactionSpeed":82,"consistency":76,"awareness":54,"judgement":72},"picture":"Trey Miguel.png"},{"id":2700,"name":"Facade","realName":"Facade","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":187,"height":180,"dateOfBirth":"1986-12-20T00:00:00.000Z","debut":"2006-10-01T00:00:00.000Z","wage":4166,"popularity":3,"charisma":48,"micSkills":49,"condition":82,"hardcoreAbility":42,"injuryProne":100,"ability":41,"currentAbility":36,"potentialAbility":40,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"mid","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Michael Cichowicz is an American professional wrestler better known by the ring names Michael Facade and simply Facade. He is readily recognizable for his flamboyant ring attire, including decorative bandanas, masking his face, or bright, neon-rimmed sunglasses and neon shirts.","alterEgos":["Michael Facade"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1624,1885,2809,3330,4319,4320],"staffAttributes":{"bookingLogic":42,"storytelling":50,"productFit":100,"riskTaking":42,"matchLayout":52,"psychology":42,"workerManagement":100,"trainingIntensity":69,"technicalCoaching":43,"characterCoaching":69,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":58,"mediaHandling":69,"brandBuilding":56,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":20,"reactionSpeed":69,"consistency":66,"awareness":42,"judgement":65},"picture":"Facade.png"},{"id":2701,"name":"Riddick Moss","realName":"Riddick Moss","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":245,"height":187,"dateOfBirth":"1989-10-10T00:00:00.000Z","debut":"2014-12-01T00:00:00.000Z","wage":37500,"popularity":27,"charisma":47,"micSkills":48,"condition":100,"hardcoreAbility":55,"injuryProne":100,"ability":43,"currentAbility":40,"potentialAbility":65,"morale":"poor","presentation":"face","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Riddick Moss is a better athlete than you are, and he’s all too happy to let you know it.\r\n\r\nA stud competitor his entire life, Moss instilled fear into opposing squads on the gridiron as a linebacker for the University of Minnesota Golden Gophers. Choosing to employ his genetic gifts in a new arena, he traded his football cleats for wrestling boots after being recruited into the WWE Performance Center.\r\n\r\nWhether in the ring or in the gym, Riddy Mo craves a platform on which to show the WWE Universe what a truly elite athlete looks like. Moss’ power and explosiveness make him a dangerous Superstar inside the squared circle, and they’ve also earned him multiple wins in the annual WWE Performance Center Combine.","alterEgos":["Mike Rallis"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3067],"staffAttributes":{"bookingLogic":46,"storytelling":48,"productFit":67,"riskTaking":36,"matchLayout":49,"psychology":46,"workerManagement":67,"trainingIntensity":64,"technicalCoaching":32,"characterCoaching":44,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":64,"mediaHandling":44,"brandBuilding":73,"socialMediaSavvy":34,"ruleKnowledge":0,"positioning":13,"reactionSpeed":64,"consistency":63,"awareness":46,"judgement":54},"picture":"Riddick Moss_alt4.png"},{"id":2702,"name":"LEONA","realName":"LEONA","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":198,"height":170,"dateOfBirth":"1993-07-07T00:00:00.000Z","debut":"2013-11-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":56,"micSkills":53,"condition":96,"hardcoreAbility":53,"injuryProne":100,"ability":46,"currentAbility":45,"potentialAbility":52,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Leona Fujinami is a Japanese wrestler who works exclusively in Japan. He is a Lightweight who is classed as using a Puroresu Style style. He is the son of NJPW legend and WWE Hall of Famer, Tatsumi Fujinami.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":48,"storytelling":55,"productFit":45,"riskTaking":22,"matchLayout":58,"psychology":48,"workerManagement":45,"trainingIntensity":73,"technicalCoaching":59,"characterCoaching":35,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":78,"mediaHandling":35,"brandBuilding":44,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":9,"reactionSpeed":73,"consistency":60,"awareness":48,"judgement":47},"picture":"Leona Fujinami.png"},{"id":2704,"name":"Raquel Rodriguez","realName":"Victoria Gonzalez","nickname":"","type":"wrestler","promotionId":64,"base":"USA","gender":"F","weight":176,"height":180,"dateOfBirth":"1991-01-12T00:00:00.000Z","debut":"2014-09-01T00:00:00.000Z","wage":50000,"wageType":"monthly","popularity":39,"charisma":78,"micSkills":68,"condition":99,"hardcoreAbility":74,"injuryProne":100,"ability":75,"currentAbility":75,"potentialAbility":91,"morale":"fair","presentation":"heel","prestige":"low","style":"powerhouse","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Standing 6-feet tall, with muscles rippling throughout, the towering Texan does what she wants, when she wants, and there’s little anyone can do to stop her. As the daughter of longtime wrestler Ricky “Desperado” González, Raquel was all but certain to be a future Superstar. That moment finally arrived in 2017, when she appeared on the WWE Universe’s radar for the first time as a competitor in the inaugural Mae Young Classic Tournament.\r\n\r\nThat González — a demure youngster, still a newcomer to the WWE Performance Center — bears little resemblance to the enforcer the NXT Universe knows her as today. Her change in attitude is largely due to her association with Dakota Kai, a partnership that came into view at TakeOver: Portland when González helped Kai defeat bitter rival Tegan Nox.\r\n\r\n","alterEgos":["Victoria Gonzalez"],"birthplace":"San José, Costa Rica","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-2704","wrestlerId":2704,"promotionId":64,"startDate":"2016-10-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":50000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[2806,4112],"staffAttributes":{"bookingLogic":58,"storytelling":61,"productFit":64,"riskTaking":26,"matchLayout":62,"psychology":58,"workerManagement":64,"trainingIntensity":75,"technicalCoaching":46,"characterCoaching":56,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":74,"mediaHandling":56,"brandBuilding":78,"socialMediaSavvy":45,"ruleKnowledge":0,"positioning":13,"reactionSpeed":75,"consistency":77,"awareness":58,"judgement":60},"picture":"Raquel Rodriguez.png"},{"id":2705,"name":"Zeda Zhang","realName":"Zeda Zhang","nickname":"","type":"wrestler","base":"USA","gender":"F","weight":128,"height":157,"dateOfBirth":"1987-07-01T00:00:00.000Z","debut":"2017-06-01T00:00:00.000Z","wage":37500,"popularity":1,"charisma":68,"micSkills":60,"condition":100,"hardcoreAbility":53,"injuryProne":100,"ability":56,"currentAbility":51,"potentialAbility":55,"morale":"broken","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Julia Ho is a model, singer, mixed martial artist and professional wrestler. Ho is has worked as a professional model and singer. She also became an undefeated mixed martial artist, holding a 2-0 record.","alterEgos":["Zeda"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[],"staffAttributes":{"bookingLogic":47,"storytelling":52,"productFit":26,"riskTaking":33,"matchLayout":54,"psychology":47,"workerManagement":26,"trainingIntensity":82,"technicalCoaching":62,"characterCoaching":62,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":67,"mediaHandling":62,"brandBuilding":73,"socialMediaSavvy":47,"ruleKnowledge":0,"positioning":5,"reactionSpeed":82,"consistency":78,"awareness":47,"judgement":39},"picture":"Zeda.png"},{"id":2706,"name":"Léi Ying Lee","realName":"Xia Li","nickname":"","type":"wrestler","promotionId":28,"base":"Other","gender":"F","weight":136,"height":160,"dateOfBirth":"1988-07-28T00:00:00.000Z","debut":"2016-01-01T00:00:00.000Z","wage":20500,"wageType":"per-appearance","popularity":20,"charisma":54,"micSkills":61,"condition":98,"hardcoreAbility":66,"injuryProne":100,"ability":62,"currentAbility":62,"potentialAbility":67,"morale":"poor","presentation":"face","prestige":"low","style":"submission","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"As the first Chinese woman to ever compete in a WWE ring, Xia Li is no stranger to breaking down barriers. Recruited to the WWE Performance Center in January 2017, after she had impressed talent scouts at a tryout in Shanghai, Li made her debut mere months later, competing in the inaugural Mae Young Classic tournament. Although she had precious little experience inside the ring at the time, Li didn’t fold under the immense pressure. \r\n\r\nSince then, Li has checked off one career milestone after another, from competing in the second-ever Women’s Royal Rumble Match to becoming a Superstar to watch in the NXT Women’s division. Her quick ascent might not be surprising, considering her extensive martial arts background (Li was a top-flight fighter in the Chinese martial art of wushu when WWE came calling) or her tireless work ethic in the WWE Performance Center (which has earned props from the likes of Sasha Banks).","alterEgos":["Xia Li","Xia Zhao"],"birthplace":"Chongqing, Sichuan, China","managerId":0,"contractExpiryDate":"2026-09-06T00:00:00.000Z","contract":{"id":"tew-contract-2706","wrestlerId":2706,"promotionId":28,"startDate":"2024-09-06T00:00:00.000Z","endDate":"2026-09-06T00:00:00.000Z","wage":20500,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"w