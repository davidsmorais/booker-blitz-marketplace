,"productFit":100,"riskTaking":35,"matchLayout":58,"psychology":48,"workerManagement":100,"trainingIntensity":75,"technicalCoaching":60,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":65,"mediaHandling":51,"brandBuilding":55,"socialMediaSavvy":28,"ruleKnowledge":0,"positioning":20,"reactionSpeed":75,"consistency":70,"awareness":48,"judgement":69},"picture":"Angélico.png","additionalContracts":[{"id":"tew-contract-447-76","wrestlerId":447,"promotionId":76,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["AEW"]},{"id":448,"name":"Argenis","realName":"Argenis","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":179,"height":177,"dateOfBirth":"1986-08-13T00:00:00.000Z","debut":"2006-08-01T00:00:00.000Z","wage":37500,"popularity":6,"charisma":46,"micSkills":69,"condition":84,"hardcoreAbility":48,"injuryProne":100,"ability":54,"currentAbility":48,"potentialAbility":52,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Argenis is a Mexican luchador enmascarado, or masked professional wrestler. Argenis made his professional wrestling debut in 2006, working as \"Dr. Karonte, Jr.\", named after his father. He would also work as \"Hijo del Dr. Karonte\", neither gimmick led to much success. By 2007 he began working for Consejo Mundial de Lucha Libre (CMLL) as a Rudo (Heel or \"Bad guy\") After he left CMLL he complained to several magazines that he felt that his brother Místico should have asked CMLL to give him more opportunities. In June 2011, Argenis' brother Astro Boy II joined AAA and Real Fuerza Aérea under the new ring name Argos. On February 10, 2012, Argos turned on Argenis and Real Fuerza Aérea to join rudo group El Consejo.","alterEgos":["Barrio Negro"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1028],"staffAttributes":{"bookingLogic":56,"storytelling":62,"productFit":100,"riskTaking":25,"matchLayout":64,"psychology":56,"workerManagement":100,"trainingIntensity":74,"technicalCoaching":61,"characterCoaching":51,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":75,"mediaHandling":51,"brandBuilding":48,"socialMediaSavvy":38,"ruleKnowledge":0,"positioning":20,"reactionSpeed":74,"consistency":73,"awareness":56,"judgement":74},"picture":"Argenis.png"},{"id":449,"name":"Dr. Karonte I","realName":"Argos","nickname":"","type":"wrestler","promotionId":11,"base":"Mexico","gender":"M","weight":189,"height":170,"dateOfBirth":"1985-10-14T00:00:00.000Z","debut":"2002-06-01T00:00:00.000Z","wage":32000,"wageType":"per-appearance","popularity":3,"charisma":73,"micSkills":50,"condition":86,"hardcoreAbility":69,"injuryProne":100,"ability":69,"currentAbility":60,"potentialAbility":63,"morale":"broken","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Early in his career, he and Mistico worked together as Los Astro Boys I y II. After Mistico left CMLL to join WWE, Astro Boy left CMLL five months later to join AAA (where his other, less famous, brother Argenis occasionally appears in the openers.) Astro Boy switched to the name Argos; it's possible he actually switched back to that name, as there was an Argos around CMLL briefly before Astro Boy's debut. Argos' new mask resembles his brother's Sin Cara's mask. Argos joined Real Fuerza Aérea AAA, taking the vacant spot in the trio after Super Fly betrayed the group. On February 10, 2012, Argos turned on Argenis and Real Fuerza Aérea to join rudo group El Consejo - he also changed his mask.","alterEgos":["Argos","Astro Boy II"],"birthplace":"Mexico","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-449","wrestlerId":449,"promotionId":11,"startDate":"2022-01-04T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":32000,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1176],"staffAttributes":{"bookingLogic":71,"storytelling":73,"productFit":70,"riskTaking":55,"matchLayout":73,"psychology":71,"workerManagement":70,"trainingIntensity":80,"technicalCoaching":67,"characterCoaching":39,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":45,"mediaHandling":39,"brandBuilding":52,"socialMediaSavvy":36,"ruleKnowledge":0,"positioning":14,"reactionSpeed":80,"consistency":73,"awareness":71,"judgement":71},"picture":"Dr Karonte I.png"},{"id":450,"name":"Billy Boy","realName":"Billy Boy","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":163,"height":165,"dateOfBirth":"1977-06-09T00:00:00.000Z","debut":"1997-07-01T00:00:00.000Z","wage":37500,"popularity":3,"charisma":68,"micSkills":63,"condition":71,"hardcoreAbility":53,"injuryProne":81,"ability":57,"currentAbility":42,"potentialAbility":44,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Billy Boy is the ring name of Mexican Luchador or professional wrestler José Roberto Islas García. José Islas began his professional wrestling career in 1997 under the ring name “Fighterman”, a stripper gimmick aimed primarily at female fans. In 2001 his gimmick was modified to Billy Boy and he was made part of a group called Los Barrio Boys along with Alan (formerly known as \"Spice Boy\" Jimmy Boy) and Decnnis. In 2004 AAA owner Antonio Peña decided to \"repackage\" Billy Boy, giving him a full-body suit and a mask, turning him into the enmascarado character \"Alfa\". Billy Boy's run as Alfa was very short lived and it was never publicly acknowledged at the time that it was Billy Boy under the mask. As Alfa he gained Gran Apache's respect, leading Apache to stating that Alfa would make a good husband for Faby Apache. Following the statement Billy Boy unmasked to the surprise of everyone, reuniting with Faby Apache and Marvin, though the ruse did not please Gran Apache.","alterEgos":["Billy el Malo"],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1177],"staffAttributes":{"bookingLogic":66,"storytelling":69,"productFit":100,"riskTaking":18,"matchLayout":70,"psychology":66,"workerManagement":100,"trainingIntensity":65,"technicalCoaching":58,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":82,"mediaHandling":67,"brandBuilding":47,"socialMediaSavvy":64,"ruleKnowledge":0,"positioning":20,"reactionSpeed":65,"consistency":67,"awareness":66,"judgement":80},"picture":"Billy El Malo.png"},{"id":451,"name":"Crazy Boy","realName":"Crazy Boy","nickname":"","type":"wrestler","base":"Mexico","gender":"M","weight":203,"height":172,"dateOfBirth":"1978-03-30T00:00:00.000Z","debut":"1997-03-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":46,"micSkills":42,"condition":82,"hardcoreAbility":56,"injuryProne":100,"ability":51,"currentAbility":38,"potentialAbility":40,"morale":"broken","presentation":"face","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"Crazy Boy is a Mexican professional wrestler who is best known in Lucha Libre and is the cousin of Super Crazy. Around the turn of the millennium, Crazy Boy worked extensively in Naucalpan, Mexico State, for the then recently created International Wrestling Revolution Group (IWRG). In IWRG he formed a \"suicidal\" trio with Star Boy and Súper Boy who all used a high flying, high risk wrestling style. Crazy Boy's stint in CMLL ended in a messy way, with Crazy pulling himself out from an Arena Mexico show (which would have been his first CMLL one there), claiming an injury from a just completed Japanese tour, only to show up as surprise in AAA days later.","alterEgos":[],"birthplace":"Mexico","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1199,1200,3313],"staffAttributes":{"bookingLogic":54,"storytelling":60,"productFit":100,"riskTaking":51,"matchLayout":62,"psychology":54,"workerManagement":100,"trainingIntensity":67,"technicalCoaching":58,"characterCoaching":48,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":49,"mediaHandling":48,"brandBuilding":45,"socialMediaSavvy":29,"ruleKnowledge":0,"positioning":20,"reactionSpeed":67,"consistency":63,"awareness":54,"judgement":72},"picture":"Crazy Boy.png"},{"id":453,"name":"The Beast Mortos","realName":"The Beast Mortos","nickname":"","type":"wrestler","promotionId":76,"base":"Mexico","gender":"M","weight":198,"height":175,"dateOfBirth":"1987-03-11T00:00:00.000Z","debut":"2005-11-01T00:00:00.000Z","wage":40000,"wageType":"per-appearance","popularity":26,"charisma":58,"micSkills":66,"condition":85,"hardcoreAbility":78,"injuryProne":100,"ability":67,"currentAbility":67,"potentialAbility":71,"morale":"poor","presentation":"heel","prestige":"low","style":"high flyer","cardPosition":"lower","finisher":"","finisherType":"aerial","character":"","acceptsIndieBookings":false,"masked":true,"retired":false,"dead":false,"inDevelopment":false,"story":"The Beast Mortos is a masked Mexican luchador who 