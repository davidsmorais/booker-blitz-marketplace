017 graduate of the WWE Performance Center, is an American wrestler who works exclusively in North America. He is a Middleweight who is classed as using a Regular Wrestler style. Bugenhagen was born in Franklin, Wisconsin. In high school he was a two-time wrestling champion, Bugenhagen attended the University of Wisconsin where he majored in Kinesiology and History. He competed on the Badgers wrestling team as a heavyweight and served the team as its strength and conditioning coach during 2012. Bugenhagen was also a four-year letter-winner in college and ranked among the top ten U.S. amateur wrestlers in 2011. Bugenhagen debuted on October 19, 2017 in a match lost to Lars Sullivan.","alterEgos":["Rick Boogs"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[3354],"staffAttributes":{"bookingLogic":49,"storytelling":53,"productFit":15,"riskTaking":31,"matchLayout":55,"psychology":49,"workerManagement":15,"trainingIntensity":74,"technicalCoaching":53,"characterCoaching":83,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":69,"mediaHandling":83,"brandBuilding":76,"socialMediaSavvy":71,"ruleKnowledge":0,"positioning":3,"reactionSpeed":74,"consistency":64,"awareness":49,"judgement":35},"picture":"Eric Bugenhagen_alt3.png"},{"id":3266,"name":"Darrick Moore","realName":"Darrick Moore","nickname":"","type":"referee","base":"USA","gender":"M","weight":213,"height":170,"dateOfBirth":"1985-01-07T00:00:00.000Z","debut":"2012-01-01T00:00:00.000Z","wage":66000,"popularity":0,"charisma":80,"micSkills":55,"condition":100,"hardcoreAbility":57,"injuryProne":96,"ability":64,"currentAbility":56,"potentialAbility":59,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Darrick Moore is