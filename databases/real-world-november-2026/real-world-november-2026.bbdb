.png"},{"id":1759,"name":"BLANK","realName":"BLANK","nickname":"","type":"wrestler","base":"USA","gender":"M","weight":205,"height":177,"dateOfBirth":"1990-08-14T00:00:00.000Z","debut":"2014-10-01T00:00:00.000Z","wage":37500,"popularity":2,"charisma":64,"micSkills":50,"condition":100,"hardcoreAbility":60,"injuryProne":99,"ability":53,"currentAbility":51,"potentialAbility":51,"morale":"broken","presentation":"face","prestige":"low","style":"technical","cardPosition":"lower","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":true,"retired":true,"dead":false,"inDevelopment":false,"story":"BLANK is a masked American wrestler who works in America and Canada. He is a Lightweight who is classed as using a Regular style. He is best known for his work with Beyond, AIW and CHIKARA.","alterEgos":["Logan Easton LaRoux","St. Jaxon DuPont"],"birthplace":"United States","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1722,2186,2383],"staffAttributes":{"bookingLogic":44,"storytelling":50,"productFit":39,"riskTaking":38,"matchLayout":52,"psychology":44,"workerManagement":39,"trainingIntensity":72,"technicalCoaching":53,"characterCoaching":67,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":62,"mediaHandling":67,"brandBuilding":35,"socialMediaSavvy":58,"ruleKnowledge":0,"positioning":8,"reactionSpeed":72,"consistency":58,"awareness":44,"judgement":42},"picture":"Blank.png"},{"id":1760,"name":"The Bodyguard","realName":"The Bodyguard","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":209,"height":172,"dateOfBirth":"1968-06-30T00:00:00.000Z","debut":"2009-01-01T00:00:00.000Z","wage":37500,"popularity":4,"charisma":37,"micSkills":52,"condition":66,"hardcoreAbility":37,"injuryProne":100,"ability":59,"currentAbility":33,"potentialAbility":35,"morale":"broken","presentation":"face","prestige":"low","style":"striker","cardPosition":"lower","finisher":"",