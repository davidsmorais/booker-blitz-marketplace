eed":70,"consistency":77,"awareness":84,"judgement":90},"picture":"Satoshi Kojima.png","additionalContracts":[{"id":"tew-contract-315-68","wrestlerId":315,"promotionId":68,"startDate":"2026-10-01T00:00:00.000Z","endDate":"2027-10-01T00:00:00.000Z","wage":13100,"wageType":"per-appearance","type":"non-exclusive","status":"active","bookingsPerMonth":4,"autoRenew":false}],"alsoWorksFor":["MLW"]},{"id":316,"name":"Minoru Suzuki","realName":"Minoru Suzuki","nickname":"","type":"wrestler","base":"Japan","gender":"M","weight":224,"height":175,"dateOfBirth":"1968-07-17T00:00:00.000Z","debut":"1988-01-01T00:00:00.000Z","wage":4166,"popularity":32,"charisma":77,"micSkills":91,"condition":69,"hardcoreAbility":98,"injuryProne":100,"ability":47,"currentAbility":47,"potentialAbility":79,"morale":"poor","presentation":"heel","prestige":"low","style":"submission","cardPosition":"upper","finisher":"","finisherType":"submission","character":"","acceptsIndieBookings":false,"masked":false,"retired":false,"dead":false,"inDevelopment":false,"story":"Minoru Suzuki, a 1988 graduate of the New Japan Dojo, is a Japanese wrestler who works in America, the British Isles, Japan and Europe. He is a Middleweight who is classed as using a MMA Crossover style. He is best known for his work with NJPW, AEW, NOAH, AJPW, ROH, GCW and RevPro. He is currently a NEVER Openweight 6-Man Tag Team champion. He was voted Veteran Wrestler Of The Year in 2015. Outside of wrestling he is a former MMA fighter.","alterEgos":[],"birthplace":"Japan","managerId":0,"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1088,2224,2733,2734,2735,2736],"staffAttributes":{"bookingLogic":78,"storytelling":82,"productFit":100,"riskTaking":20,"matchLayout":84,"psychology":78,"workerManagement":100,"trainingIntensity":77,"technicalCoaching":74,"characterCoaching":85,"teaching":20,"diagnosis":50,"rehabilitation":50,"prevention":80,"mediaHandling":85,"brandBuilding":66,"socialMediaSavvy":70,"ruleKnowledge":0,"positioning":20,"reactionSpeed":77,"consistency":58,"awareness":78,"judgement":87},"picture":"Minoru Suzuki_alt1.png"},{"id":317,"name":"Manabu Nakanishi","realName":"Manabu Nakanishi","nickname":"","type":"writer","promotionId":38,"base":"Japan","gender":"M","weight":264,"height":182,"dateOfBirth":"1967-01-22T00:00:00.000Z","debut":"1992-10-01T00:00:00.000Z","wage":40000,"wageType":"monthly","popularity":11,"charisma":79,"micSkills":95,"condition":59,"hardcoreAbility":86,"injuryProne":83,"ability":98,"currentAbility":53,"potentialAbility":53,"morale":"broken","presentation":"face","prestige":"low","style":"all rounder","cardPosition":"lower","finisher":"","finisherType":"power","character":"","acceptsIndieBookings":false,"masked":false,"retired":true,"dead":false,"inDevelopment":false,"story":"Manabu Nakanishi  is a Japanese professional wrestler and former amateur wrestler who competed in the 1992 Summer Olympics in Barcelona, Spain. Nakanishi debuted for New Japan Pro Wrestling in October 1992. His in-ring style was very basic early in his career. After winning the Young Lions Cup in 1995, in order to hone his skills and bulk up, he went on an excursion to North America and joined World Championship Wrestling (WCW), under the name Kurasawa. As Kurasawa in WCW, he was a member of the Stud Stable led by Colonel Robert Parker. When Nakanishi came back to New Japan in September 1996, he appeared more confident and stronger. With his new change in attitude and in-ring style, he found instant success.","alterEgos":[],"birthplace":"Kyoto, Kyoto, Japan","managerId":0,"contractExpiryDate":"2026-03-31T23:00:00.000Z","contract":{"id":"tew-contract-317","wrestlerId":317,"promotionId":38,"startDate":"1996-09-01T00:00:00.000Z","endDate":"2026-03-31T23:00:00.000Z","wage":40000,"wageType":"monthly","type":"exclusive","status":"active","autoRenew":false},"record":{"wins":0,"losses":0,"draws":0},"history":{"matches":[],"jobs":[],"titles":[]},"teams":[1216,140